data Token :=
  | Num(Int)
  | Sym(Str)

data ParseError :=
  | Expected(Str)
  | Trailing(List[Token])

procedure accept(in s: Str, ref ts: List[Token]) :=
  match ts
    case Sym(t) :: us =>
      if t == s
        assign ts := us
      else
        raise Expected(s)
      end
    case _ =>
      raise Expected(s)
  end

procedure number(out n: Int, ref ts: List[Token]) :=
  match ts
    case Num(m) :: us =>
      assign n := m, ts := us
    case _ =>
      raise Expected("number")
  end

// (n), where the parentheses are optional
procedure atom(out n: Int, ref ts: List[Token]) :=
  try
    call number(out n, ref ts)
  catch
    case Expected(_) =>
      call   accept(in "(", ref ts)
      call   atom(out n, ref ts)
      call   accept(in ")", ref ts)
  end

procedure parse(in ts: List[Token], out n: Int) :=
  local  rest: List[Token]
  assign rest := ts
  call   atom(out n, ref rest)
  if rest != Nil
    raise Trailing(rest)
  end

// the result, or 0 if ts is not a number
procedure value(in ts: List[Token], out n: Int) :=
  try
    call parse(in ts, out n)
  catch
    case Expected(_) =>
      assign n := 0
    case Trailing(_) =>
      assign n := 0
  end

data Fail :=
  | Fail

// the cells of refs keep their assignments before the exception
procedure count(ref k: Int) :=
  assign k := k + 1
  raise  Fail

test parse_errors :=
  local  n: Int, e: Str, k: Int
  call   parse(in [Sym("("), Sym("("), Num(3), Sym(")"), Sym(")")], out n)
  assert n == 3
  try
    call   parse(in [Sym("("), Num(3)], out n)
    assert false
  catch
    case Expected(s) =>
      assign e := s
    case Trailing(_) =>
      assert false
  end
  assert e == ")"
  try
    call   parse(in [Num(1), Num(2)], out n)
    assert false
  catch
    case Trailing(ts) =>
      assert ts == [Num(2)]
  end
  call   value(in [Sym(")")], out n)
  assert n == 0
  assign k := 0
  try
    call count(ref k)
  catch
    case Fail =>
      skip
  end
  assert k == 1

// an exception that no case matches is raised further
test unmatched_raised_further :=
  local e: Str
  try
    try
      raise Expected("x")
    catch
      case Expected("y") =>
        assign e := "y"
    end
  catch
    case Expected(s) =>
      assign e := s
  end
  assert e == "x"

// exceptions of any type, which cases catch only if the types agree, while _ catches all
test any_type :=
  local n: Int, s: Str
  try
    raise 42
  catch
    case k =>
      assign n := k
  end
  assert n == 42
  try
    try
      raise Some(1)
    catch
      case Some(t) =>
        assign s := t
    end
  catch
    case Some(k) =>
      assign n := k + 1
  end
  assert n == 2
  try
    raise "x"
  catch
    case _ =>
      assign s := "caught"
  end
  assert s == "caught"
