data Token :=
  case Num(num: Int)
  case Sym(op: Str)

data ParseError :=
  case Expected(what: Str)
  case Trailing(toks: List[Token])

procedure accept(in s: Str, ref ts: List[Token]) :=
  match ts
    case [Sym(op); us] =>
      if op == s
        assign ts := us
      else
        raise Expected(s)
      end
    case _ =>
      raise Expected(s)
  end

procedure number(out n: Int, ref ts: List[Token]) :=
  match ts
    case [Num(num); us] =>
      assign n := num, ts := us
    case _ =>
      raise Expected("number")
  end

// (n), where the parentheses are optional
procedure atom(out n: Int, ref ts: List[Token]) :=
  try
    call number(out n, ref ts)
  catch
    case Expected(_) =>
      call   accept(in "(", ref ts)
      call   atom(out n, ref ts)
      call   accept(in ")", ref ts)
  end

procedure parse(in ts: List[Token], out n: Int) :=
  local rest := ts

  call atom(out n, ref rest)
  if rest != Nil
    raise Trailing(rest)
  end

// the result, or 0 if ts is not a number
procedure value(in ts: List[Token], out n: Int) :=
  try
    call parse(in ts, out n)
  catch
    case Expected(_) =>
      assign n := 0
    case Trailing(_) =>
      assign n := 0
  end

data Fail :=
  case Fail

// the assignment to k does not reach the caller, which gets refs and outs only when a procedure returns
procedure count(ref k: Int) :=
  assign k := k + 1
  raise  Fail

test parse_errors() :=
  local n: Int, e: Str, k: Int

  call   parse(in [Sym("("), Sym("("), Num(3), Sym(")"), Sym(")")], out n)
  assert n == 3
  try
    call   parse(in [Sym("("), Num(3)], out n)
    assert false
  catch
    case Expected(what) =>
      assign e := what
    case Trailing(_) =>
      assert false
  end
  assert e == ")"
  try
    call   parse(in [Num(1), Num(2)], out n)
    assert false
  catch
    case Trailing(toks) =>
      assert toks == [Num(2)]
  end
  call   value(in [Sym(")")], out n)
  assert n == 0
  assign k := 0
  try
    call count(ref k)
  catch
    case Fail =>
      skip
  end
  assert k == 0

// handlers see the variables as they were before the try, also when compiled with optimizations
test restored_by_raise() :=
  local k := 0, n := 0

  try
    assign k := 1
    while n < 3
      assign n := n + 1
    end
    call   count(ref k)
  catch
    case Fail =>
      assign k := k + 10
  end
  assert (k, n) == (10, 0)

procedure half(out r: Int) :=
  assign r := 1
  raise  Fail

procedure through(ref z: Int) :=
  call half(out z)

// outs and refs assigned before an exception do not reach the caller
test atomic_outs_and_refs() :=
  local x := 0, y := 5

  try
    call through(ref x)
  catch
    case Fail =>
      skip
  end
  try
    call half(out y)
  catch
    case Fail =>
      skip
  end
  assert (x, y) == (0, 5)

// an exception that no case matches is raised further
test unmatched_raised_further() :=
  local e: Str

  try
    try
      raise Expected("x")
    catch
      case Expected("y") =>
        assign e := "y"
    end
  catch
    case Expected(what) =>
      assign e := what
  end
  assert e == "x"

// exceptions of any type, which cases catch only if the types agree, while _ catches all
test any_type() :=
  local n: Int, s: Str

  try
    raise 42
  catch
    case k =>
      assign n := k
  end
  assert n == 42
  try
    try
      raise Some(1)
    catch
      case Some(t) =>
        assign s := t
    end
  catch
    case Some(k) =>
      assign n := k + 1
  end
  assert n == 2
  try
    raise "x"
  catch
    case _ =>
      assign s := "caught"
  end
  assert s == "caught"

// handlers apply if their guards hold
test guarded_handlers() :=
  local n: Int

  try
    raise 2
  catch
    case k if k < 2 =>
      assign n := 0
    case k =>
      assign n := k
  end
  assert n == 2

// raise is also an expression of any type, such that functions can raise exceptions, which statements catch
data NotDigit :=
  case NotDigit(char: Char)

function digit(c: Char): Int :=
  if is_digit(c) then ord(c) - ord('0') else raise NotDigit(c)

function digits(cs: List[Char]): Int :=
  match cs
    case Nil => 0
    case [c; rest] => digit(c) + 10 * digits(rest)
  end

test raise_in_functions() :=
  local n := 0, bad := ' '

  assign n := digits(['1', '2'])

  try
    assign n := digits(['1', 'x'])
  catch
    case NotDigit(char) =>
      assign bad := char
  end

  assert n == 21 and bad == 'x'

data Shape :=
  case Circle(label: Str, radius: Int)
  case Box(label: Str)

// builtins and accessors of fields raise exceptions of the prelude
procedure failure(in k: Int, out m: Str) :=
  local x := 0

  assign m := "none"

  try
    match k
      case 0 =>
        assign x := 1 / 0
      case 1 =>
        assign x := 1 % 0
      case 2 =>
        assign x := ord(at(2, "ab"))
      case 3 =>
        assign x := size(slice("ab", 1, 3))
      case 4 =>
        assign x := size(slice("ab", 2, 1))
      case 5 =>
        assign x := ord(chr(-1))
      case _ =>
        assign x := Box("b").radius
    end
  catch
    case DivisionByZero =>
      assign m := "division"
    case OutOfBounds(index, count) =>
      assign m := show(index) ++ " of " ++ show(count)
    case NoCharacter(code) =>
      assign m := show(code)
    case MissingField(field) =>
      assign m := field
  end

  if m == "none"
    assign m := show(x)
  end

test builtin_exceptions() :=
  local m: Str

  call   failure(in 0, out m)
  assert m == "division"
  call   failure(in 1, out m)
  assert m == "division"
  call   failure(in 2, out m)
  assert m == "2 of 2"
  call   failure(in 3, out m)
  assert m == "3 of 2"
  call   failure(in 4, out m)
  assert m == "2 of 2"
  call   failure(in 5, out m)
  assert m == "-1"
  call   failure(in 6, out m)
  assert m == "Shape.radius"
  assert slice("ab", 0, 2) == "ab" and slice("ab", 2, 2) == ""
