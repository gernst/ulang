function range(n: Int): List[Int] :=
  if n == 0 then Nil else [n; range(n - 1)]

function head[A](xs: List[A]): Option[A] :=
  match xs
    case [x; _] => Some(x)
    case _ => None
  end

function nested(xs: List[Option[Int]]): Int :=
  match xs
    case [Some(1), None; _] => 1
    case _ => 0
  end

function word(x: Int): Str :=
  match x
    case 0 => "zero"
    case _ => "other"
  end

function flip(b: Bool): Int :=
  match b
    case true => 0
    case false => 1
  end

function unit(u: ()): Int :=
  match u
    case () => 0
  end

test ranges() :=
  assert range(3) == [3, 2, 1]
  assert size(range(3)) == 3
  assert [x * x for x in range(3)] == [9, 4, 1]
  assert head(range(2)) == Some(2)
  assert head(Nil) == None
  assert nested([Some(1), None]) == 1
  assert nested(Nil) == 0
  assert word(0) == "zero"
  assert word(7) == "other"
  assert flip(false) == 1
  assert unit(()) == 0
  assert (range(2) != Nil)

// [...] is notation for the List of the prelude, with the constructors Nil and Cons
test list_notation() :=
  assert [1, 2, 3] == Cons(1, Cons(2, Cons(3, Nil)))
  assert [] == Nil
  assert [[1], []] == Cons(Cons(1, Nil), Cons(Nil, Nil))
  assert [1] ++ [2, 3] ++ [] == [1, 2, 3]
  assert size([1, 2] ++ [3]) == 3

test comprehensions() :=
  assert [x * x for x in [1, 2, 3]] == [1, 4, 9]
  assert [x for x in [1, 2, 3, 4] if x % 2 == 0] == [2, 4]
  assert [(x, y) for x in [1, 2], y in [true, false]] == [(1, true), (1, false), (2, true), (2, false)]
  assert [(x, y) for x in range(3), y in range(x) if x + y == 4] == [(3, 1), (2, 2)]
  assert [x for x in []] == []
  assert [[y for y in range(x)] for x in [1, 2]] == [[1], [2, 1]]

// association lists, where the first pair of a key counts
test association_lists() :=
  local m := [("b", 2), ("a", 1), ("a", 3)]

  assert get("a", m) == Some(1) and get("b", m) == Some(2) and get("c", m) == None

// mutually recursive datatypes, and a type definition before the datatype it uses
data Tree[A] :=
  | Node(A, Forest[A])

data Forest[A] :=
  | Leaf
  | Grow(Tree[A], Forest[A])

type Pair[A] :=
  Tuple[A, A]

data Tuple[A, B] :=
  | Tuple(A, B)

function size[A](t: Tree[A]): Int :=
  match t
    case Node(_, f) => 1 + sizes(f)
  end

function sizes[A](f: Forest[A]): Int :=
  match f
    case Leaf => 0
    case Grow(t, g) => size(t) + sizes(g)
  end

function swap[A](p: Pair[A]): Pair[A] :=
  match p
    case Tuple(x, y) => Tuple(y, x)
  end

test mutual_recursion() :=
  assert size(Node(1, Grow(Node(2, Leaf), Grow(Node(3, Leaf), Leaf)))) == 3
  assert swap(Tuple(1, 2)) == Tuple(2, 1)

// the natural numbers of Peano
data Nat :=
  | Zero
  | Succ(Nat)

function add(m: Nat, n: Nat): Nat :=
  match m
    case Zero => n
    case Succ(k) => Succ(add(k, n))
  end

function even(n: Nat): Bool :=
  match n
    case Zero => true
    case Succ(Zero) => false
    case Succ(Succ(m)) => even(m)
  end

function int(n: Nat): Int :=
  match n
    case Zero => 0
    case Succ(m) => 1 + int(m)
  end

test nat() :=
  assert int(add(Succ(Succ(Zero)), Succ(Zero))) == 3
  assert even(add(Succ(Zero), Succ(Zero)))
  assert even(Succ(Succ(Succ(Zero)))) == false

// cases apply if their guards hold, and else is the last case
function sign(n: Int): Int :=
  match n
    case m if m < 0 => -1
    case 0 => 0
    case _ => 1
  end

test guards() :=
  local s: Str

  assert sign(-5) == -1 and sign(0) == 0 and sign(7) == 1
  match [1, 2]
    case [x; _] if x > 1 =>
      assign s := "big"
    case [x; _] if x == 1 =>
      assign s := "one"
    case _ =>
      assign s := "other"
  end
  assert s == "one"

// [a, b] is Cons(a, Cons(b, Nil)) and [a, b; c] is Cons(a, Cons(b, c)), in patterns and expressions
function sum_pairs(xs: List[Int]): Int :=
  match xs
    case [] => 0
    case [x] => x
    case [x, y; rest] => x * y + sum_pairs(rest)
  end

test list_patterns() :=
  assert sum_pairs([1, 2, 3, 4, 5]) == 19
  assert sum_pairs([]) == 0
  assert [1; [2, 3]] == [1, 2, 3]
  assert [1, 2; [3]] == Cons(1, Cons(2, Cons(3, Nil)))

// compare orders values of a type, constructors by their declaration and then by their fields
test comparisons() :=
  assert compare(1, 2) == -1 and compare(2, 1) == 1 and compare(3, 3) == 0
  assert compare("ab", "b") == -1 and compare('b', 'a') == 1 and compare(false, true) == -1
  assert compare((1, "b"), (1, "a")) == 1 and compare((), ()) == 0
  assert compare(None, Some(0)) == -1 and compare(Some(2), Some(1)) == 1
  assert compare(Zero, Succ(Zero)) == -1 and compare([1, 2], [1]) == 1 and compare([1], [1, 2]) == -1
  assert compare(100000000000000000000, 99999999999999999999) == 1 and compare(-100000000000000000000, 1) == -1
