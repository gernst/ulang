// the order and equality that the module of an abstract type declares with compare and ==, which builtins use for its
// values everywhere, also inside other values and in generic code, the order of a datatype with visible constructors,
// and the shows that datatypes declare

import set
import map
import fractions

// sets of the same elements, built in different orders, which have different trees
function ab(): Set[Int] :=
  set([1, 2])

function ba(): Set[Int] :=
  set([2, 1])

// a map whose key is a set
function keyed(): Map[Set[Int], Str] :=
  put(ab(), "x", empty())

test sets_in_values() :=
  assert [ab()] == [ba()] and (ab(), 1) == (ba(), 1) and Some(ab()) == Some(ba())
  assert compare([ab()], [ba()]) == 0 and compare(ab(), set([1, 3])) == -1

test generic_code() :=
  assert contains(ba(), [ab()]) and get(ba(), [(ab(), "x")]) == Some("x")
  assert size(set([ab(), ba()])) == 1
  assert get(ba(), keyed()) == Some("x") and contains(ba(), keyed())

test declared_order() :=
  assert fraction(1, 2) == half(1) and half(2) != fraction(3, 2)
  assert compare(half(1), fraction(2, 3)) == -1 and contains(fraction(2, 4), [half(3), half(1)])
  assert list(set([fraction(1, 2), half(1), fraction(2, 2)])) == [fraction(1, 2), fraction(2, 2)]

// < and the comparisons of the prelude follow compare, for any type
test comparisons() :=
  assert "ab" < "b" and not ("b" < "ab") and (1, "b") < (2, "a") and [1, 2] < [1, 3] and None < Some(0)
  assert "a" <= "a" and "b" > "a" and "a" >= "a" and not ('b' <= 'a')
  assert ab() <= ba() and not (ab() < ba()) and ab() < set([1, 3])
  assert half(1) < fraction(2, 3) and fraction(2, 4) <= half(1) and half(3) > fraction(1, 1)
  assert V(2, 0) < V(1, 10) and V(1, 10) < V(1, 9) and list({V(1, 0), V(2, 1), V(2, 0)}) == [V(2, 1), V(2, 0), V(1, 0)]
  assert V(1, 2) == V(1, 2) and get(V(1, 2), {V(1, 2) => "x"}) == Some("x")
  assert 100000000000000000000 < 100000000000000000001 and -100000000000000000000 < 3 and not (3 < 2)

// versions, newest first, whose constructor is visible, so that their order must agree with the structural equality
data Version :=
  case V(major: Int, minor: Int)

function compare(a: Version, b: Version): Int :=
  compare((b.major, b.minor), (a.major, a.minor))

// show gives the text of a value, with strings in quotes, where a datatype may declare its own show, which the builtin
// then uses for its values, also inside other values and in generic code, as for the shows of the library

data Color :=
  case Red
  case Green

data Pair[A, B] :=
  case Pair(first: A, second: B)

// a show of a generic datatype, which shows its components by the builtin
function show[A, B](p: Pair[A, B]): Str :=
  match p
    case Pair(first, second) => "<" ++ show(first) ++ " | " ++ show(second) ++ ">"
  end

function texts[A](xs: List[A]): List[Str] :=
  [show(x) for x in xs]

test builtin_show() :=
  assert show(1) == "1" and show(-12) == "-12" and show(true) == "true"
  assert show("a\"b") == "\"a\\\"b\"" and show('c') == "'c'"
  assert show([1, 2]) == "[1, 2]" and show((1, "x")) == "(1, \"x\")" and show(Some(Red)) == "Some(Red)"
  assert show(Nil) == "[]" and show([Green; Nil]) == "[Green]"

test declared_show() :=
  assert show(Pair(1, "a")) == "<1 | \"a\">"
  assert show([Pair(1, Red), Pair(2, Green)]) == "[<1 | Red>, <2 | Green>]"
  assert show((Some(Pair('x', Nil)), Red)) == "(Some(<'x' | []>), Red)"
  assert texts([Pair(true, false)]) == ["<true | false>"]
  assert show(Pair(Pair(1, 2), [Pair(3, 'x')])) == "<<1 | 2> | [<3 | 'x'>]>"

test library_shows() :=
  local s := {3, 1, 2}, m := {"b" => [1], "a" => []}, e: Set[Int] := {}

  assert show(s) == "{1, 2, 3}" and show(e) == "{}" and show(m) == "{\"a\" => [], \"b\" => [1]}"
  assert show([Some(s)]) == "[Some({1, 2, 3})]" and show(Pair(m, e)) == "<{\"a\" => [], \"b\" => [1]} | {}>"
