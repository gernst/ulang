data Nat = zero | succ(Nat)

function add(m: Nat, n: Nat): Nat =
  match m
    case zero => n
    case succ(k) => succ(add(k, n))
  end

function even(n: Nat): Bool =
  match n
    case zero => true
    case succ(zero) => false
    case succ(succ(m)) => even(m)
  end

function int(n: Nat): Int =
  match n
    case zero => 0
    case succ(m) => 1 + int(m)
  end

test int(add(succ(succ(zero)), succ(zero))) == 3
test even(add(succ(zero), succ(zero))) == true
test even(succ(succ(succ(zero)))) == false
