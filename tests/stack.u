// a module, imported by import.u and peek.u
infix right 7 <+

data Stack[A] :=
  | Empty
  | Push(A, Stack[A])

function <+[A](x: A, s: Stack[A]): Stack[A] :=
  Push(x, s)

function top[A](s: Stack[A]): Option[A] :=
  match s
    case Empty => None
    case Push(x, _) => Some(x)
  end

test stack :=
  assert top(1 <+ Empty) == Some(1)
