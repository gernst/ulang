// named fields of constructors, whose accessors e.f are resolved by the type of e

data Point :=
  | Point(x: Int, y: Int)

// label is a field of both constructors, and radius only of circles, whose accessor is partial
data Shape :=
  | Circle(label: Str, center: Point, radius: Int)
  | Box(label: Str, corner: Point, Point)

data Pair[A, B] :=
  | Pair(left: A, right: B)

function area(s: Shape): Int :=
  match s
    case Circle(_, _, r) => 3 * r * r
    case Box(_, a, b) => (b.x - a.x) * (b.y - a.y)
  end

test fields() :=
  local  p := Point(1, 2), c := Circle("c", Point(0, 0), 2), b := Box("b", Point(1, 1), Point(3, 4))
  assert p.x == 1 and p.y == 2
  assert c.label == "c" and b.label == "b" and c.radius == 2 and c.center.y == 0
  assert area(b) == 6 and b.corner.x == 1

// the type of p is known only once the lambda is applied, until when its accessor stays open
test unknown_type() :=
  local  v := (lambda p => p.x)(Point(1, 2))
  assert v == 1

test generic_fields() :=
  local  q := Pair(1, "one")
  assert q.left == 1 and q.right == "one" and Pair(q, true).left.right == "one"

test updates() :=
  local  p := Point(1, 2), c := Circle("c", Point(0, 0), 2), b := Box("b", Point(1, 1), Point(3, 4)), m := ""
  assert (p with x := 3) == Point(3, 2) and (p with y := 0, x := p.y + 3) == Point(5, 0)
  assert (c with radius := 3) == Circle("c", Point(0, 0), 3) and (b with label := "a", corner := p) == Box("a", p, Point(3, 4))
  assert (c with center := (c.center with x := 1)).center == Point(1, 0)
  assert (Pair(1, "one") with right := "two") == Pair(1, "two")

  try
    assign b := b with radius := 1
  catch
    case MissingField(f) =>
      assign m := f
  end
  assert m == "Shape.radius"
