// the names list, set, map, and array are ordinary names, while List, Set, Map, and Array before ( are the forms

function map[A, B](f: A -> B, xs: List[A]): List[B] :=
  List(for x in xs yield f(x))

function set(n: Int): Set[Int] :=
  Set(n)

test lowercase() :=
  local list := List(1, 2), array := Array(3)
  assert map(lambda x => x + 1, list) == List(2, 3)
  assert set(1) == Set(1) and size(array) == 1
