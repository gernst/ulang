// export sections: importers see the exported declarations with the notations, but not the private ones, whose names
// may repeat in other modules, and abstract types are compared only through their modules, where comparing a type
// whose module declares no order raises Unordered, and comparing one without an equality either raises Incomparable

import exported
import counter

export

// pairs of an abstract type of this module, which declares neither an order nor an equality
type Pair

function pair(a: Int, b: Int): Pair

implementation

data Pair :=
  | Pair(Int, Int)

function pair(a: Int, b: Int): Pair :=
  Pair(a, b)

test exported_declarations() :=
  local c := start()

  call   bump(ref c)
  assert count(next(c)) == 2 and 2 ** 3 ** 2 == 512 and level(Green(3)) == 3 and level(Red) == 0

// the helper of counter, since that of exported is private, although it has the same type
test private_names() :=
  assert helper(1) == 2 and next(1) == 2

// annotations by imported abstract types, whose constructors have the names of their types
function counted(c: Counter): Int :=
  count(c)

test abstract_annotations() :=
  local t: Tally := tally([1, 2])

  assert counted(next(start())) == 1 and t == tally([3])

test exported_fields() :=
  assert Green(3).level == 3 and (Green(3) with level := 4) == Green(4)

test equality_without_order() :=
  local r := ""

  assert tally([1, 2]) == tally([3]) and tally([1]) != tally([2]) and contains(tally([4]), [tally([1, 3])])

  try
    assign r := show(compare(tally([1]), tally([2])))
  catch
    case Unordered(t) =>
      assign r := t
  end

  assert r == "exported.Tally"

test incomparable() :=
  local r := ""

  try
    assign r := if start() == start() then "equal" else "unequal"
  catch
    case Incomparable(t) =>
      assign r := t
  end

  assert r == "exported.Counter"

// also in the module of the type, and inside other values
test incomparable_inside() :=
  local r := ""

  try
    assign r := if [Pair(1, 2)] == [pair(1, 2)] then "equal" else "unequal"
  catch
    case Incomparable(t) =>
      assign r := t
  end

  assert r == "exports.Pair"
