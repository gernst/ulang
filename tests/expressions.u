// arithmetic and precedence
test
  assert 1 + 2 * 3 - 4 / 2 == 5;
  assert -2 * -3 == 6;
  assert 7 % 3 == 1;
  assert -7 % 3 == -1;
  assert (not 1 < 2 or 1 + 1 == 2 and true);
  assert (not true and false) == false;
  assert (1 < 2) == (2 > 1);
end

// let binds in parallel
test
  assert (let x, y = 1, 2 in x + y * 3) == 7;
  assert (let x, y = 1, 2 in let x, y = y, x in x - y) == 1;
end

test
  assert (if not 1 < 2 then 0 else 1) == 1;
end

test
  assert (fun (f) => f(f(1)))(fun (x) => x * 2) == 4;
  assert (fun (f: Int -> Int) => f(1))(fun (x: Int) => x) == 1;
end

test
  assert "a" == "a";
  assert () == ();
  assert (1 != 2);
end

// and, or are not strict
test
  assert (false and 1 / 0 == 0) == false;
  assert (true or 1 / 0 == 0);
end
