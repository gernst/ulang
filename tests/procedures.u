procedure sum(in n: Int, out s: Int) :=
  local i: Int

  assign i := 0, s := 0

  while i < n
    assign i := i + 1, s := s + i
  end

procedure total(in xs: List[Int], out s: Int) :=
  local ys: List[Int]

  assign s := 0, ys := xs

  while ys != Nil
    match ys
      case [y; zs] =>
        assign s := s + y
        assign ys := zs
      case Nil => skip
    end
  end

procedure swap[A](ref x: A, y: A) :=
  assign x := y, y := x

procedure inc(ref x: Int) :=
  assign x := x + 1

procedure main(out a: Int, b: Int, c: Int) :=
  local f: Int -> Int

  assign a := 1, b := 2
  call   swap(ref a, b)
  call   inc(ref a)
  call   sum(in a, out c)
  assign f := lambda x => x + a
  if a > b
    assign c := f(c)
  else if a == b
    skip
  else
    assign c := 0
  end

procedure capture(out r: Int) :=
  local i := 1, f := lambda x => x + i

  assign i := 10
  assign r := f(0)

test procedures() :=
  local a: Int, b: Int, c: Int

  call   sum(in 10, out c)
  assert c == 45
  call   total(in [1, 2, 3], out c)
  assert c == 6
  assign a := 1, b := 2
  call   swap(ref a, b)
  assert (a, b) == (2, 1)
  call   inc(ref a)
  assert a == 3
  call   main(out a, b, c)
  assert (a, b, c) == (3, 1, 6)

// closures capture values, not variables
test closures_capture_values() :=
  local r: Int

  call   capture(out r)
  assert r == 1

test sums() :=
  local x: Int, y: Int

  call   sum(in 4, out x)
  assign y := x * 2
  assert (x, y) == (6, 12)

// the bodies of cases may declare variables, like those of if and while
test locals_in_cases() :=
  local n: Int

  match Some(3)
    case Some(m) =>
      local  k := m * 2
      assign n := k + 1
    case None =>
      assign n := 0
  end
  assert n == 7
  try
    raise "x"
  catch
    case s =>
      local  t := s
      assert t == "x"
  end

// procedures as values of the types (in A, out B, ref C), named or as lambdas
procedure double(in x: Int, out y: Int) :=
  assign y := 2 * x

procedure twice(in p: (in Int, out Int), x: Int, out z: Int) :=
  local y: Int

  call p(in x, out y)
  call p(in y, out z)

procedure each[A](in p: (in A, ref Int), xs: List[A], ref n: Int) :=
  match xs
    case [] =>
      skip
    case [x; rest] =>
      call p(in x, ref n)
      call each(in p, rest, ref n)
  end

function step(by_two: Bool): (in Int, out Int) :=
  if by_two then double else lambda in x, out y => assign y := x + 1 end

test procedure_values() :=
  local  z: Int, n := 0, k := 10, p := step(false)

  call   twice(in double, 3, out z)
  assert z == 12
  call   twice(in lambda in x, out y => assign y := x + k end, 1, out z)
  assert z == 21
  call   each(in lambda in s, ref m => assign m := m + size(s) end, ["a", "bc"], ref n)
  assert n == 3
  call   p(in 1, out z)
  assert z == 2
  call   twice(in step(true), 1, out z)
  assert z == 4
