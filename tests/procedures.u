procedure sum(in n: Int, out s: Int) :=
  local i: Int

  assign i := 0, s := 0

  while i < n
    assign i := i + 1, s := s + i
  end

procedure total(in xs: List[Int], out s: Int) :=
  local ys: List[Int]

  assign s := 0, ys := xs

  while ys != Nil
    match ys
      case [y; zs] =>
        assign s := s + y
        assign ys := zs
      case Nil => skip
    end
  end

procedure swap[A](ref x: A, y: A) :=
  assign x := y, y := x

procedure inc(ref x: Int) :=
  assign x := x + 1

procedure main(out a: Int, b: Int, c: Int) :=
  local f: Int -> Int

  assign a := 1, b := 2
  call   swap(ref a, b)
  call   inc(ref a)
  call   sum(in a, out c)
  assign f := lambda x => x + a
  if a > b
    assign c := f(c)
  else if a == b
    skip
  else
    assign c := 0
  end

procedure capture(out r: Int) :=
  local i := 1, f := lambda x => x + i

  assign i := 10
  assign r := f(0)

test procedures :=
  local a: Int, b: Int, c: Int

  call   sum(in 10, out c)
  assert c == 45
  call   total(in [1, 2, 3], out c)
  assert c == 6
  assign a := 1, b := 2
  call   swap(ref a, b)
  assert (a, b) == (2, 1)
  call   inc(ref a)
  assert a == 3
  call   main(out a, b, c)
  assert (a, b, c) == (3, 1, 6)

// closures capture values, not variables
test closures_capture_values :=
  local r: Int

  call   capture(out r)
  assert r == 1

run sums :=
  local x: Int, y: Int, z: Int

  call   sum(in 4, out x)
  assign y := x * 2

// the bodies of cases may declare variables, like those of if and while
test locals_in_cases :=
  local n: Int

  match Some(3)
    case Some(m) =>
      local  k := m * 2
      assign n := k + 1
    case None =>
      assign n := 0
  end
  assert n == 7
  try
    raise "x"
  catch
    case s =>
      local  t := s
      assert t == "x"
  end
