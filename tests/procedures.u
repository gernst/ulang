procedure sum(n: Int; s: Int)
  local i: Int;
  i, s := 0, 0;
  while i < n do
    i, s := i + 1, s + i;
  end
end

procedure total(xs: List[Int]; s: Int)
  local ys: List[Int];
  s, ys := 0, xs;
  while ys != nil do
    match ys
      case y :: zs =>
        s := s + y;
        ys := zs;
      case nil => skip;
    end
  end
end

procedure swap[A](;; x: A, y: A)
  x, y := y, x;
end

procedure inc(;; x: Int)
  x := x + 1;
end

procedure main(; a: Int, b: Int, c: Int)
  local f: Int -> Int;
  a, b := 1, 2;
  call swap(;; a, b);
  call inc(;; a);
  call sum(a; c);
  f := lambda x => x + a;
  if a > b then
    c := f(c);
  else if a == b then
    skip;
  else
    c := 0;
  end
end

procedure capture(; r: Int)
  local i: Int, f: Int -> Int;
  i := 1;
  f := lambda x => x + i;
  i := 10;
  r := f(0);
end

test
  local a: Int, b: Int, c: Int;
  call sum(10; c);
  assert c == 45;
  call total([1, 2, 3]; c);
  assert c == 6;
  a, b := 1, 2;
  call swap(;; a, b);
  assert (a, b) == (2, 1);
  call inc(;; a);
  assert a == 3;
  call main(; a, b, c);
  assert (a, b, c) == (3, 1, 6);
end

// closures capture values, not variables
test
  local r: Int;
  call capture(; r);
  assert r == 1;
end

run
  local x: Int, y: Int, z: Int;
  call sum(4; x);
  y := x * 2;
end
