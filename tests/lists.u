// [...] is notation for the List of the prelude, whose constructor :: is an operator
test list_notation :=
  assert [1, 2, 3] == 1 :: 2 :: 3 :: Nil
  assert [] == Nil
  assert [[1], []] == (1 :: Nil) :: Nil :: Nil
  assert [1] ++ [2, 3] ++ [] == [1, 2, 3]
  assert length([1, 2] ++ [3]) == 3

eval [1, 2, 3]

function range(n: Int): List[Int] :=
  if n == 0 then [] else n :: range(n - 1)

test comprehensions :=
  assert [x * x for x in [1, 2, 3]] == [1, 4, 9]
  assert [x for x in [1, 2, 3, 4] if x % 2 == 0] == [2, 4]
  assert [(x, y) for x in [1, 2], y in [true, false]] == [(1, true), (1, false), (2, true), (2, false)]
  assert [(x, y) for x in range(3), y in range(x) if x + y == 4] == [(3, 1), (2, 2)]
  assert [x for x in []] == []
  assert [[y for y in range(x)] for x in [1, 2]] == [[1], [2, 1]]

// association lists
test association_lists :=
  local  m: List[Str * Int]
  assign m := update("b", 2, update("a", 1, Nil))
  assert m == [("b", 2), ("a", 1)]
  assert lookup("a", m) == Some(1)
  assert lookup("c", m) == None
  assign m := update("a", 3, m)
  assert m == [("a", 3), ("b", 2)]
  assert lookup("a", [("a", 1), ("a", 2)]) == Some(1)
  assert remove("a", [("a", 1), ("b", 2), ("a", 3)]) == [("b", 2)]
  assert keys(m) == ["a", "b"]
  assert values(m) == [3, 2]
