// [...] is notation for the List of the prelude
test
  assert [1, 2, 3] == cons(1, cons(2, cons(3, nil)));
  assert [] == nil;
  assert [[1], []] == cons(cons(1, nil), cons(nil, nil));
end

eval [1, 2, 3]

function range(n: Int): List[Int] =
  if n == 0 then [] else cons(n, range(n - 1))

test
  assert [x * x for x in [1, 2, 3]] == [1, 4, 9];
  assert [x for x in [1, 2, 3, 4] if x % 2 == 0] == [2, 4];
  assert [(x, y) for x in [1, 2], y in [true, false]] == [(1, true), (1, false), (2, true), (2, false)];
  assert [(x, y) for x in range(3), y in range(x) if x + y == 4] == [(3, 1), (2, 2)];
  assert [x for x: Int in []] == [];
  assert [[y for y in range(x)] for x in [1, 2]] == [[1], [2, 1]];
end
