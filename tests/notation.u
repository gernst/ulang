// operators are declared before their use, and defined as functions
infix right 7 ++
infix left 9 **

function ++[A](xs: List[A], ys: List[A]): List[A] =
  match xs
    case nil => ys
    case cons(x, zs) => cons(x, zs ++ ys)
  end

function **(m: Int, n: Int): Int =
  if n == 0 then 1 else m * m ** (n - 1)

// types use the same operators, -> associates to the right
function curry(f: (Int, Int) -> Int): Int -> Int -> Int =
  lambda x => lambda y => f(x, y)

// functions are overloaded by their number of arguments
function size(xs: List[Int]): Int =
  match xs
    case nil => 0
    case cons(_, ys) => 1 + size(ys)
  end

function size(xs: List[Int], ys: List[Int]): Int =
  size(xs) + size(ys)

test
  assert [1] ++ [2] ++ [3] == [1, 2, 3];
  assert 2 ** 3 + 1 == 9;
  assert 2 * 3 ** 2 == 18;
  assert -2 * -3 == 6;
  assert curry(lambda a, b => a - b)(5)(3) == 2;
  assert false ==> false;
  assert not (true ==> false);
  assert size([1, 2]) == 2;
  assert size([1], [2, 3]) == 3;
end
