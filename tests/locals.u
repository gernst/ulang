// locals with initial values, whose types are inferred

procedure total(in xs: List[Int], out t: Int) :=
  local rest := xs, sum := 0

  while rest != Nil
    match rest
      case [x; more] =>
        assign sum := sum + x, rest := more
      case Nil =>
        skip
    end
  end

  assign t := sum

// the initial values are assigned in order, so each may refer to the locals before it
test initialized_locals() :=
  local a := 1, b := a + 1, c: Int := b * 2, s := "x", t: Int

  call   total(in [a, b, c], out t)
  assert (a, b, c, s, t) == (1, 2, 4, "x", 7)

test inferred_types() :=
  local xs := [Some(1), None], m := get("a", [("a", true)])

  assert size(xs) == 2 and m == Some(true)

data Fail :=
  | Fail

// the outs of sign are assigned on every path, where a path that raises does not continue
procedure sign(in n: Int, out s: Int) :=
  if n < 0
    assign s := -1
  else if n == 0
    raise  Fail
  else
    assign s := 1
  end

procedure first(in xs: List[Int], out x: Int) :=
  match xs
    case [y; _] =>
      assign x := y
    case Nil =>
      raise Fail
  end

// a variable may be read where it is assigned on every path to the read
test definite_assignment() :=
  local a: Int, b: Int, c: Int, d: Int

  call   sign(in -5, out a)
  call   first(in [7, 8], out b)

  try
    call   sign(in 0, out c)
  catch
    case Fail =>
      assign c := 0
  end

  if a < 0
    assign d := 1
  else
    assign d := 2
  end
  assert (a, b, c, d) == (-1, 7, 0, 1)
