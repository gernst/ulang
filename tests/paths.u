// imports of packages by their paths from the root of the project, of two modules with the same file name, which are
// distinct modules, and an importer sees the exports of all members of a package

import "tests/paths"
import "tests/paths/nested"

// two datatypes Expr, each of its own module
test both_syntaxes() :=
  assert show(expr_int(3)) == "ELit(3)"
  assert show(int_expr(3)) == "EConst(3)"

// two members of an imported package, of which one uses the other
test all_members() :=
  assert inner_twice(3) == 6 and base_double(4) == 8
