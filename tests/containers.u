// the interface that lists, sets, maps, arrays, and strings share: conversions named after the type they convert into,
// ++ and -- of two of a kind, where -- of a map takes a set of keys, and {x; s} and {k => v; m}, which add to a set or map

import set
import map
import array

test conversions() :=
  assert list(set([3, 1, 2, 1])) == [1, 2, 3] and set(list({2, 1})) == {1, 2}
  assert list(map([(2, "b"), (1, "a"), (2, "c")])) == [(1, "a"), (2, "c")] and map(list({1 => "a"})) == {1 => "a"}
  assert list(array([1, 2])) == [1, 2] and list("ab") == ['a', 'b'] and str(['a', 'b']) == "ab"

test operators() :=
  assert {1, 2} ++ {2, 3} == {1, 2, 3} and {1, 2, 3} -- {2} == {1, 3} and intersect({1, 2}, {2, 3}) == {2}
  assert {1 => "a", 2 => "b"} ++ {2 => "c"} == {1 => "a", 2 => "c"} and {1 => "a", 2 => "b"} -- {1} == {2 => "b"}
  assert [1, 2, 3, 2] -- [2] == [1, 3] and [1] ++ [2, 3] -- [3] == [1, 2] and [1, 2] -- [2] ++ [2] == [1]
  assert remove(2, {1, 2, 3}) == {1, 3} and remove(4, {1}) == {1} and size(remove(1, {1})) == 0

test predicates() :=
  assert exists({1, 2}, lambda x => x > 1) and not forall({1, 2}, lambda x => x > 1)
  assert exists({1 => "a"}, lambda k, v => v == "a") and forall({1 => "a", 2 => "b"}, lambda k, v => k > 0)
  assert exists(|1, 2|, lambda x => x == 2) and forall(|1, 2|, lambda x => x > 0) and not exists(array([]), lambda x => x == 1)

test notation() :=
  local s := {2}, m := {1 => "a"}

  assert {1; s} == {1, 2} and {3, 1; s} == {1, 2, 3} and {2; s} == s
  assert {2 => "b"; m} == {1 => "a", 2 => "b"} and {1 => "x"; m} == {1 => "x"} and {1 => "y", 1 => "z"; m} == {1 => "z"}
