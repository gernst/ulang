// containers: the interface that lists, sets, maps, arrays, and strings share, conversions named after the type they
// convert into, ++ and -- of two of a kind, where -- of a map takes a set of keys, and {x; s} and {k => v; m}, which add
// to a set or map, and the literals and comprehensions of lists, sets, and maps

import set
import map
import array

test conversions() :=
  assert list(set([3, 1, 2, 1])) == [1, 2, 3] and set(list({2, 1})) == {1, 2}
  assert list(map([(2, "b"), (1, "a"), (2, "c")])) == [(1, "a"), (2, "c")] and map(list({1 => "a"})) == {1 => "a"}
  assert list(array([1, 2])) == [1, 2] and list("ab") == ['a', 'b'] and str(['a', 'b']) == "ab"

test operators() :=
  assert {1, 2} ++ {2, 3} == {1, 2, 3} and {1, 2, 3} -- {2} == {1, 3} and intersect({1, 2}, {2, 3}) == {2}
  assert {1 => "a", 2 => "b"} ++ {2 => "c"} == {1 => "a", 2 => "c"} and {1 => "a", 2 => "b"} -- {1} == {2 => "b"}
  assert [1, 2, 3, 2] -- [2] == [1, 3] and [1] ++ [2, 3] -- [3] == [1, 2] and [1, 2] -- [2] ++ [2] == [1]
  assert remove(2, {1, 2, 3}) == {1, 3} and remove(4, {1}) == {1} and size(remove(1, {1})) == 0

test predicates() :=
  assert exists({1, 2}, lambda x => x > 1) and not forall({1, 2}, lambda x => x > 1)
  assert exists({1 => "a"}, lambda k, v => v == "a") and forall({1 => "a", 2 => "b"}, lambda k, v => k > 0)
  assert exists(|1, 2|, lambda x => x == 2) and forall(|1, 2|, lambda x => x > 0) and not exists(array([]), lambda x => x == 1)

test notation() :=
  local s := {2}, m := {1 => "a"}

  assert {1; s} == {1, 2} and {3, 1; s} == {1, 2, 3} and {2; s} == s
  assert {2 => "b"; m} == {1 => "a", 2 => "b"} and {1 => "x"; m} == {1 => "x"} and {1 => "y", 1 => "z"; m} == {1 => "z"}

// literals {a, b} of sets and {k => v} of maps, which need the modules set and map

function vowels(): Set[Char] :=
  {'a', 'e', 'i', 'o', 'u'}

test literals() :=
  local  m := {"one" => {1}, "two" => {1, 2}}, n := {1 + 1 => "two", 3 => "three"}
  assert contains('e', vowels()) and not contains('b', vowels())
  assert [list(s) for k => s in m] == [[1], [1, 2]] and get("three", m) == None
  assert list(n) == [(2, "two"), (3, "three")]

// a literal is the fold of its elements, unrolled, where the last entry of a key counts
test unrolled() :=
  local none: Map[Int, Str] := {}

  assert list({3, 1, 3, 2}) == [1, 2, 3]
  assert list({1 => "a", 2 => "b", 1 => "c"}) == [(1, "c"), (2, "b")]
  assert {1, 2} == insert(1, insert(2, empty())) and {1 => "a"} == put(1, "a", none)

// {} is empty() of the module that its type determines, which a local empty does not hide
test empty_literal() :=
  local s: Set[Int] := {}, empty := 0

  assert size(s) == 0 and insert(1, {}) == {1} and empty == 0

test set_map_comprehensions() :=
  local  s := {1, 2, 3}, m := {"a" => 1, "b" => 2}
  assert list({x * x for x in s if x != 2}) == [1, 9] and list({x + y for x in s, y in {10, 20}}) == [11, 12, 13, 21, 22, 23]
  assert list({k ++ "!" => v + 1 for k => v in m}) == [("a!", 2), ("b!", 3)] and list({k => v for k => v in m if v > 1}) == [("b", 2)]
  assert list({k ++ l => v * w for k => v in m, l => w in {k => v}}) == [("aa", 1), ("bb", 4)]

// comprehensions are folds over the containers of their generators, x in c over lists and sets, and k => v in m over maps

test kinds() :=
  local xs := [3, 1, 2, 1], s := {3, 1, 2}, m := {1 => "a", 2 => "b"}

  assert [x * 10 for x in xs if x > 1] == [30, 20] and [x for x in s] == [1, 2, 3]
  assert {x for x in xs} == s and size({x for x in xs if x != 3}) == 2
  assert {v => k for k => v in m} == {"a" => 1, "b" => 2} and [k for k => v in m] == [1, 2] and {v for k => v in m} == {"a", "b"}

// each generator sees the variables of those before it, and the condition all of them
test nested() :=
  assert [(x, y) for x in [1, 2, 3], y in [x, 3] if x < y] == [(1, 3), (2, 3)]
  assert {x + y for x in {1, 2}, y in [10, 20]} == {11, 12, 21, 22}
  assert {k => v + w for k => v in {1 => 10, 2 => 20}, j => w in {1 => 1} if j == k} == {1 => 11}

// the last entry of a key counts, as in a literal
test map_order() :=
  assert {x % 2 => x for x in [1, 2, 3, 4]} == {0 => 4, 1 => 3}

// the folds of the translation are those of the containers, which a local foldr does not hide
test locals() :=
  local foldr := 0, foldl := 1, acc := 5

  assert [x + acc + foldr for x in [1, 2]] == [6, 7] and {k => v + foldl for k => v in {1 => 1}} == {1 => 2}

// several generators over lists and arrays, which compiled code runs as nested loops that build the result in order
test fused() :=
  local xss := [[1, 2], [], [3]], a := |10, 20|

  assert [x for xs in xss, x in xs] == [1, 2, 3] and [x for xs in xss, x in xs if x > 1] == [2, 3]
  assert [(x, y) for x in [1, 2], y in a] == [(1, 10), (1, 20), (2, 10), (2, 20)]
  assert [x + y for x in a, y in a if x < y] == [30] and [x * 2 for x in a] == [20, 40]
  assert |x for xs in xss, x in xs| == |1, 2, 3| and |(x, y) for x in a, y in [x, x + 1]| == |(10, 10), (10, 11), (20, 20), (20, 21)|
  assert |x for xs in xss, x in xs if x > 5| == || and size(|y for x in a, y in [1, 2, 3, 4, 5, 6, 7, 8, 9]|) == 18
  assert [x for x in {2, 1}, y in [0]] == [1, 2] and [[y for y in xs] for xs in xss] == xss

function countdown(n: Int): List[Int] :=
  if n == 0 then Nil else [n; countdown(n - 1)]

// [...] is notation for the List of the prelude, with the constructors Nil and Cons
test list_notation() :=
  assert [1, 2, 3] == Cons(1, Cons(2, Cons(3, Nil)))
  assert [] == Nil
  assert [[1], []] == Cons(Cons(1, Nil), Cons(Nil, Nil))
  assert [1] ++ [2, 3] ++ [] == [1, 2, 3]
  assert size([1, 2] ++ [3]) == 3

test list_comprehensions() :=
  assert [x * x for x in [1, 2, 3]] == [1, 4, 9]
  assert [x for x in [1, 2, 3, 4] if x % 2 == 0] == [2, 4]
  assert [(x, y) for x in [1, 2], y in [true, false]] == [(1, true), (1, false), (2, true), (2, false)]
  assert [(x, y) for x in countdown(3), y in countdown(x) if x + y == 4] == [(3, 1), (2, 2)]
  assert [x for x in []] == []
  assert [[y for y in countdown(x)] for x in [1, 2]] == [[1], [2, 1]]
