// a member of the package tests/siblings, with even.u

export

infix left 10 <*>

// the odd number 2 * half + 1
data Odd :=
  case Odd(half: Int)

function is_odd(n: Int): Bool

function <*>(a: Odd, b: Odd): Odd

function size(o: Odd): Int

implementation

function is_odd(n: Int): Bool :=
  if n == 0 then false else is_even(n - 1)

function <*>(a: Odd, b: Odd): Odd :=
  Odd(2 * a.half * b.half + a.half + b.half)

function size(o: Odd): Int :=
  2 * o.half + 1

test odd_sees_even() :=
  assert is_odd(3) and not is_odd(4) and size(Even(1) <+> Even(2)) == 6
