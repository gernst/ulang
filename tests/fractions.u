// a module for tests/orders.u: fractions as an abstract type, ordered and equal by their values, where half(n) is n / 2,
// and an equality that compare implies

export

type Fraction

function fraction(n: Int, d: Int): Fraction
function half(n: Int): Fraction
function compare(a: Fraction, b: Fraction): Int

implementation

data Fraction :=
  case Fraction(num: Int, den: Int)
  case Half(num: Int)

function fraction(n: Int, d: Int): Fraction :=
  Fraction(n, d)

function half(n: Int): Fraction :=
  Half(n)

function value(f: Fraction): Int * Int :=
  match f
    case Fraction(num, den) => (num, den)
    case Half(num) => (num, 2)
  end

function compare(a: Fraction, b: Fraction): Int :=
  match (value(a), value(b))
    case ((n, d), (m, e)) => compare(n * e, m * d)
  end

test values() :=
  assert Fraction(1, 2) == Half(1) and compare(Half(1), Fraction(1, 1)) == -1
