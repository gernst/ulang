// a module for tests/modules/modules.u, in a package of its own, since tests/modules/exported.u has a private helper of
// the same name and type, whose uses would otherwise also see this one

export

function helper(n: Int): Int

function next(n: Int): Int

implementation

function helper(n: Int): Int :=
  n + 1

function next(n: Int): Int :=
  helper(n)
