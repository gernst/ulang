// a module for tests/errors/modules/ambiguous-name/ambiguous-name.u, which exports a helper of the same name and type
// as the other one, for tests/errors/modules/own-name.u, which declares one of its own, and for the misplaced imports of
// tests/errors/modules/import-after-declaration.u and tests/errors/modules/import-after-export/import-after-export.u

export

function helper(n: Int): Int

implementation

function helper(n: Int): Int :=
  n + 1
