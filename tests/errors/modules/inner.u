// a module for tests/errors/modules/transitive-name.u, transitive-notation.u, and transitive-field.u, whose exports wrapper.u sees,
// but not the modules that import wrapper.u

export

infix left 5 <+>

data Cell :=
  | Cell(contents: Int)

function <+>(m: Int, n: Int): Int
function twice(n: Int): Int

implementation

function <+>(m: Int, n: Int): Int :=
  m + n

function twice(n: Int): Int :=
  n <+> n
