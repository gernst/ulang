// [...] is notation for the List of the prelude, {...} builds a Set
test
  assert [1, 2, 3] == cons(1, cons(2, cons(3, nil)));
  assert [] == nil;
  assert [[1], []] == cons(cons(1, nil), cons(nil, nil));
  assert {1, 2} == {2, 1, 2};
  assert {1, 2} != {1, 3};
  assert {[1], [1]} == {[1]};
  assert {(1, true)} == {(1, true)};
end

eval [1, 2, 3]
eval {2, 1, 2}
