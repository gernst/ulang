// characters, escapes, and the builtins on strings and characters
test characters :=
  assert ord('a') == 97
  assert chr(98) == 'b'
  assert chars("ab") == ['a', 'b']
  assert string(['h', 'i']) == "hi"
  assert chars("\"\\\n\t") == ['"', '\\', '\n', '\t']
  assert '\'' != '"'

function vowel(c: Char): Bool :=
  match c
    case 'a' => true
    case 'e' => true
    else false
  end

test char_patterns :=
  assert vowel('a') and not vowel('b')

test string_functions :=
  assert "ab" ^ "c" == "abc"
  assert str_size("hello") == 5
  assert str_join(", ", ["a", "b", "c"]) == "a, b, c"
  assert str_join(", ", []) == ""
  assert str_slice("hello", 1, 3) == "el"
  assert str_split("a,b,,c", ',') == ["a", "b", "", "c"]
  assert str_show(42) == "42" and str_show(-7) == "-7" and str_show(0) == "0"
  assert str_number("123") == Some(123) and str_number("-5") == Some(-5)
  assert str_number("1a") == None and str_number("") == None
  assert is_digit('7') and is_letter('Q') and is_space(' ')
