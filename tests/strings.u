// characters, escapes, the builtins chars, string, ord, and chr, and the library module str
import str

test characters :=
  assert ord('a') == 97
  assert chr(98) == 'b'
  assert chars("ab") == ['a', 'b']
  assert string(['h', 'i']) == "hi"
  assert chars("\"\\\n\t") == ['"', '\\', '\n', '\t']
  assert '\'' != '"'

function vowel(c: Char): Bool :=
  match c
    case 'a' => true
    case 'e' => true
    else false
  end

test char_patterns :=
  assert vowel('a') and not vowel('b')

test library :=
  assert "ab" ^ "c" == "abc"
  assert size("hello") == 5
  assert join(", ", ["a", "b", "c"]) == "a, b, c"
  assert join(", ", []) == ""
  assert slice("hello", 1, 3) == "el"
  assert split("a,b,,c", ',') == ["a", "b", "", "c"]
  assert show(42) == "42" and show(-7) == "-7" and show(0) == "0"
  assert number("123") == Some(123) and number("-5") == Some(-5)
  assert number("1a") == None and number("") == None
  assert is_digit('7') and is_letter('Q') and is_space(' ')
