// the recursive functions of ulang/ and of the library whose termination the prover does not prove, so that the rule of
// style that code that may not terminate is a procedure is checked also where no lemma reaches the code; the program is
// the driver ulang/ulang.u, which imports every package of ulang/

import "ulang/syntax"
import "ulang/parse"
import "ulang/check"
import "ulang/prove"

procedure main() :=
  local source: Source, q: Prog, open: List[Str] := List()
  call parse_file(in "ulang/ulang.u", out source)
  call require_parsed(in source)
  call check_program(in source, out q)
  match translate(q, q.main)
    case Translation(decls, _) =>
      assign open := List(for t in terminations(decls, Set(for k => d in decls.defs if d.recursive yield k)) for site in take(1, t.open) yield value_or(first(site.caller).module, "") ++ "." ++ first(site.caller).base ++ ": " ++ print_open_call(site))
  end
  for line in open do
    call os_println(in line)
  end
  call os_println(in show(size(open)) ++ " recursive functions whose termination is not proven")
