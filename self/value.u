// the values of the interpreter of self/run.u

import syntax
import map
import array

export

data Value :=
  | Lit(lit: Val)
  | Obj(constr: Name, args: List[Value])
  // arrays of array.u by arrays of the interpreter of this program
  | Arr(elems: Array[Value])
  | Clos(env: Map[Name, Value], formals: List[Var], body: Expr)
  | Fn(name: Name, arity: Int)
  | Con(name: Name)
  | Prim(name: Name)
  // procedures as values, declared ones by their names, and lambdas with the values of the variables around them
  | Proc(name: Name)
  | ProcClos(env: Map[Name, Value], ins: List[Var], outs: List[Var], refs: List[Var], stmt: Stmt)

function list_value(vs: List[Value]): Value
function list_elements(v: Value): Option[List[Value]]

implementation

function list_value(vs: List[Value]): Value :=
  match vs
    case Nil => Obj(nil_name(), Nil)
    case [v; rest] => Obj(cons_name(), [v, list_value(rest)])
  end

function list_elements(v: Value): Option[List[Value]] :=
  match v
    case Obj(constr, Nil) if constr == nil_name() => Some(Nil)
    case Obj(constr, [w, ws]) if constr == cons_name() =>
      match list_elements(ws)
        case Some(us) => Some([w; us])
        case None => None
      end
    case _ => None
  end
