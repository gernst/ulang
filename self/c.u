// the part of C that compiled ulang programs need, as datatypes, and a printer to C source code,
// where the runtime defines the type u_value of all ulang values in a header, which is not part of the syntax

export

data CType :=
  | CtVoid
  | CtInt
  | CtNamed(Str)
  | CtPtr(CType)

// operators are their C symbols, e.g. "+" or "==", and unary ones include "!", "-", "*", and "&"
data CExpr :=
  | CeVar(Str)
  | CeNum(Int)
  | CeStr(Str)
  | CeCall(CExpr, List[CExpr])
  | CeUnary(Str, CExpr)
  | CeBinary(Str, CExpr, CExpr)
  | CeIndex(CExpr, CExpr)
  | CeArrow(CExpr, Str)
  | CeCast(CType, CExpr)
  | CeCond(CExpr, CExpr, CExpr)
  // the initializer {a, b} of a struct
  | CeInit(List[CExpr])

data CStmt :=
  | CsExpr(CExpr)
  | CsDecl(CType, Str, Option[CExpr])
  | CsAssign(CExpr, CExpr)
  | CsIf(CExpr, List[CStmt], List[CStmt])
  | CsWhile(CExpr, List[CStmt])
  | CsReturn(Option[CExpr])
  | CsBlock(List[CStmt])

data CDecl :=
  | CdInclude(Str)
  | CdPrototype(CType, Str, List[CType * Str])
  | CdFunction(CType, Str, List[CType * Str], List[CStmt])
  | CdGlobal(CType, Str, Option[CExpr])

data CFile :=
  | CFile(List[CDecl])

function show_file(f: CFile): Str
function c_call(f: Str, args: List[CExpr]): CExpr

implementation

function show_type(t: CType): Str :=
  match t
    case CtVoid => "void"
    case CtInt => "int"
    case CtNamed(n) => n
    case CtPtr(CtPtr(u)) => show_type(CtPtr(u)) ++ "*"
    case CtPtr(u) => show_type(u) ++ " *"
  end

// a declaration of x with type t, without a space after a pointer
function show_typed(t: CType, x: Str): Str :=
  match t
    case CtPtr(_) => show_type(t) ++ x
    case _ => show_type(t) ++ " " ++ x
  end

// subexpressions are in parentheses unless they are atomic, which avoids the precedences of C
function show_expr(e: CExpr): Str :=
  match e
    case CeVar(x) => x
    case CeNum(n) => show(n)
    // the escapes of C strings are those of ulang
    case CeStr(s) => quote(s)
    case CeCall(f, args) => show_operand(f) ++ "(" ++ join(", ", [show_expr(a) for a in args]) ++ ")"
    case CeUnary(o, a) => o ++ show_operand(a)
    case CeBinary(o, a, b) => show_operand(a) ++ " " ++ o ++ " " ++ show_operand(b)
    case CeIndex(a, i) => show_operand(a) ++ "[" ++ show_expr(i) ++ "]"
    case CeArrow(a, f) => show_operand(a) ++ "->" ++ f
    case CeCast(t, a) => "(" ++ show_type(t) ++ ")" ++ show_operand(a)
    case CeCond(c, a, b) => show_operand(c) ++ " ? " ++ show_operand(a) ++ " : " ++ show_operand(b)
    case CeInit(es) => "{" ++ join(", ", [show_expr(a) for a in es]) ++ "}"
  end

function show_operand(e: CExpr): Str :=
  match e
    case CeVar(_) => show_expr(e)
    case CeNum(n) if n >= 0 => show_expr(e)
    case CeStr(_) => show_expr(e)
    case CeCall(_, _) => show_expr(e)
    case CeIndex(_, _) => show_expr(e)
    case CeArrow(_, _) => show_expr(e)
    case _ => "(" ++ show_expr(e) ++ ")"
  end

// the lines of a statement, indented by ind
function show_stmt(ind: Str, s: CStmt): List[Str] :=
  match s
    case CsExpr(e) => [ind ++ show_expr(e) ++ ";"]
    case CsDecl(t, x, None) => [ind ++ show_typed(t, x) ++ ";"]
    case CsDecl(t, x, Some(e)) => [ind ++ show_typed(t, x) ++ " = " ++ show_expr(e) ++ ";"]
    case CsAssign(a, e) => [ind ++ show_expr(a) ++ " = " ++ show_expr(e) ++ ";"]
    case CsIf(c, l, []) => [ind ++ "if (" ++ show_expr(c) ++ ") {"] ++ show_stmts(ind ++ "  ", l) ++ [ind ++ "}"]
    case CsIf(c, l, r) =>
      [ind ++ "if (" ++ show_expr(c) ++ ") {"] ++ show_stmts(ind ++ "  ", l) ++ [ind ++ "} else {"] ++ show_stmts(ind ++ "  ", r) ++ [ind ++ "}"]
    case CsWhile(c, b) => [ind ++ "while (" ++ show_expr(c) ++ ") {"] ++ show_stmts(ind ++ "  ", b) ++ [ind ++ "}"]
    case CsReturn(None) => [ind ++ "return;"]
    case CsReturn(Some(e)) => [ind ++ "return " ++ show_expr(e) ++ ";"]
    case CsBlock(b) => [ind ++ "{"] ++ show_stmts(ind ++ "  ", b) ++ [ind ++ "}"]
  end

function show_stmts(ind: Str, ss: List[CStmt]): List[Str] :=
  [l for s in ss, l in show_stmt(ind, s)]

function show_params(ps: List[CType * Str]): Str :=
  match ps
    case [] => "void"
    case _ => join(", ", [show_param(p) for p in ps])
  end

function show_param(p: CType * Str): Str :=
  match p
    case (t, x) => show_typed(t, x)
  end

function show_decl(d: CDecl): List[Str] :=
  match d
    case CdInclude(h) => ["#include " ++ quote(h)]
    case CdPrototype(t, f, ps) => [show_typed(t, f) ++ "(" ++ show_params(ps) ++ ");"]
    case CdFunction(t, f, ps, b) => [show_typed(t, f) ++ "(" ++ show_params(ps) ++ ") {"] ++ show_stmts("  ", b) ++ ["}"]
    case CdGlobal(t, x, None) => [show_typed(t, x) ++ ";"]
    case CdGlobal(t, x, Some(e)) => [show_typed(t, x) ++ " = " ++ show_expr(e) ++ ";"]
  end

// the source code of a file, with an empty line between declarations
function show_file(f: CFile): Str :=
  match f
    case CFile(ds) => join("\n\n", [join("\n", show_decl(d)) for d in ds]) ++ "\n"
  end

// a function of the runtime, which compiled code calls
function c_call(f: Str, args: List[CExpr]): CExpr :=
  CeCall(CeVar(f), args)

test print_c() :=
  local v := CtNamed("value"), f := 

    CFile(
      [
        CdInclude("ulang.h"),
        CdFunction(
          v,
          "fact",
          [(v, "n")],
          [
            CsIf(c_call("is_zero", [CeVar("n")]), [CsReturn(Some(c_call("make_int", [CeNum(1)])))], []),
            CsDecl(v, "m", Some(c_call("fact", [c_call("sub", [CeVar("n"), c_call("make_int", [CeNum(1)])])]))),
            CsReturn(Some(c_call("mul", [CeVar("n"), CeVar("m")])))
          ]
        ),
        CdFunction(CtInt, "main", [], [CsExpr(c_call("print", [c_call("fact", [c_call("make_int", [CeNum(5)])])])), CsReturn(Some(CeNum(0)))])
      ]
    )
  assert show_file(f) ==
    "#include \"ulang.h\"\n\nvalue fact(value n) {\n  if (is_zero(n)) {\n    return make_int(1);\n  }\n  value m = fact(sub(n, make_int(1)));\n  return mul(n, m);\n}\n\nint main(void) {\n  print(fact(make_int(5)));\n  return 0;\n}\n"
  assert show_expr(CeBinary("+", CeBinary("*", CeVar("a"), CeNum(2)), CeUnary("-", CeVar("b")))) == "(a * 2) + (-b)"
  assert show_expr(CeStr("a\"b\n")) == "\"a\\\"b\\n\""
  assert show_stmt("", CsIf(CeVar("c"), [CsReturn(None)], [CsExpr(c_call("f", []))])) == ["if (c) {", "  return;", "} else {", "  f();", "}"]
