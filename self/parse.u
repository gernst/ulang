// the parser of ulang/src/ulang/Parser.scala, which parses the tokens of self/lex.u into programs of self/syntax.u,
// where notations apply to the commands after them, and imports inline the declarations of modules,
// read from the directory of the parsed file, or else from the library

import syntax
import lex
import os
import set

data ParseError :=
  | ParseError(Str, Int)

// the notations in their order, and the set of their operators, which the parser asks for at every name
data Notations :=
  | Notations(cmds: List[Cmd], ops: Set[Id])

// the type parameters in scope, which distinguish TParam from TSort, and the notations declared so far
data Scope :=
  | Scope(params: List[Id], notations: Notations)

function keywords(): Set[Id] :=
  {
    "_", "assert", "assign", "call", "case", "catch", "data", "else", "end", "eval", "false", "for", "function", "if", "import",
    "in", "infix", "lambda", "let", "local", "match", "out", "postfix", "prefix", "procedure", "raise", "ref", "run", "skip",
    "test", "then", "true", "type", "try", "while", "with"
  }

function is_keyword(n: Id): Bool :=
  member(n, keywords())

// symbols with a fixed meaning, which cannot be operators
function is_reserved(s: Str): Bool :=
  contains(s, ["=", "=>", ":=", ":", "|"])

// notations

function prefix_prec(ns: List[Cmd], op: Id): Option[Int] :=
  match ns
    case Nil => None
    case [CNotation(FPrefix, p, ops); _] if contains(op, ops) => Some(p)
    case [_; more] => prefix_prec(more, op)
  end

function postfix_prec(ns: List[Cmd], op: Id): Option[Int] :=
  match ns
    case Nil => None
    case [CNotation(FPostfix, p, ops); _] if contains(op, ops) => Some(p)
    case [_; more] => postfix_prec(more, op)
  end

function infix_of(ns: List[Cmd], op: Id): Option[Fixity * Int] :=
  match ns
    case Nil => None
    case [CNotation(f, p, ops); _] if contains(op, ops) and f != FPrefix and f != FPostfix => Some((f, p))
    case [_; more] => infix_of(more, op)
  end

function declared(ns: Notations, op: Id): Bool :=
  member(op, ns.ops)

function no_notations(): Notations :=
  Notations(Nil, empty_set())

function with_notations(ns: Notations, cs: List[Cmd]): Notations :=
  Notations(ns.cmds ++ cs, insert_all(operators_of(cs), ns.ops))

function operators_of(cs: List[Cmd]): List[Id] :=
  match cs
    case Nil => Nil
    case [CNotation(_, _, ops); more] => ops ++ operators_of(more)
    case [_; more] => operators_of(more)
  end

// tokens

function head_token(ts: List[Token * Int]): Token :=
  match ts
    case [(t, _); _] => t
    else TEnd
  end

function second_token(ts: List[Token * Int]): Token :=
  match ts
    case [_, (t, _); _] => t
    else TEnd
  end

function head_offset(ts: List[Token * Int]): Int :=
  match ts
    case [(_, i); _] => i
    else 0
  end

function at_keyword(ts: List[Token * Int], w: Str): Bool :=
  head_token(ts) == TName(w)

function at_punct(ts: List[Token * Int], c: Char): Bool :=
  head_token(ts) == TPunct(c)

function describe(t: Token): Str :=
  match t
    case TName(n) => n
    case TSym(s) => s
    case TPunct(c) => string([c])
    case TNum(n) => str_show(n)
    case TStr(s) => str_quote(s)
    case TChar(c) => "'" ^ string([c]) ^ "'"
    case TEnd => "end of input"
  end

// a name that may be declared as an operator, as a name and an operator are
function operator_at(ns: Notations, ts: List[Token * Int]): Option[Id] :=
  match head_token(ts)
    case TSym(s) if not is_reserved(s) => Some(s)
    case TName(n) if declared(ns, n) => Some(n)
    else None
  end

procedure advance(ref ts: List[Token * Int]) :=
  match ts
    case [_; more] =>
      assign ts := more
    else
      skip
  end

procedure expect(in t: Token, ref ts: List[Token * Int]) :=
  if head_token(ts) == t
    call advance(ref ts)
  else
    raise ParseError(describe(t) ^ " expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
  end

procedure keyword(in w: Str, ref ts: List[Token * Int]) :=
  call expect(in TName(w), ref ts)

// a name that is not a keyword
procedure parse_name(out n: Id, ref ts: List[Token * Int]) :=
  match head_token(ts)
    case TName(m) if not is_keyword(m) =>
      assign n := m
      call   advance(ref ts)
    else
      raise ParseError("name expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
  end

// a name that is not declared as an operator
procedure parse_plain(in sc: Scope, out n: Id, ref ts: List[Token * Int]) :=
  match head_token(ts)
    case TName(m) if declared(sc.notations, m) =>
      raise ParseError("operator " ^ m ^ " is not a name", head_offset(ts))
    else
      call parse_name(out n, ref ts)
  end

// a name or a symbol that is not reserved
procedure parse_name_or_symbol(out n: Id, ref ts: List[Token * Int]) :=
  match head_token(ts)
    case TSym(s) if not is_reserved(s) =>
      assign n := s
      call   advance(ref ts)
    else
      call parse_name(out n, ref ts)
  end

// precedence climbing as Resolve in ulang/src/ulang/Parser.scala, where prefix operators bind their operand with their own precedence

// operands and operators, which remember their offsets for errors
data Item[A] :=
  | Operand(A)
  | Operator(Id, Int)

// the notations, and how to apply prefix, postfix, and infix operators
data Ops[A] :=
  | Ops(notations: Notations, prefix_op: (Id, A) -> A, postfix_op: (Id, A) -> A, infix_op: (Id, A, A) -> A)

// the operand of all items, where at is the offset after them
procedure resolve_items[A](in items: List[Item[A]], o: Ops[A], at: Int, out a: A) :=
  local rest: List[Item[A]]

  call climb(in items, 0, o, at, out a, rest)
  match rest
    case Nil =>
      skip
    case [Operator(op, i); _] =>
      raise ParseError("unexpected operator " ^ op, i)
    else
      raise ParseError("missing operator", at)
  end

procedure climb[A](in items: List[Item[A]], min: Int, o: Ops[A], at: Int, out a: A, rest: List[Item[A]]) :=
  local lhs: A, more: List[Item[A]]

  call   operand(in items, o, at, out lhs, more)
  call   climb_loop(in lhs, more, min, o, at, out a, rest)

procedure operand[A](in items: List[Item[A]], o: Ops[A], at: Int, out a: A, rest: List[Item[A]]) :=
  local b: A

  match items
    case [Operand(x); more] =>
      assign a := x, rest := more
    case [Operator(op, i); more] =>
      match prefix_prec(o.notations.cmds, op)
        case Some(p) =>
          call   climb(in more, p, o, at, out b, rest)
          assign a := o.prefix_op(op, b)
        case None if declared(o.notations, op) =>
          raise ParseError(op ^ " is not a prefix operator", i)
        case None =>
          raise ParseError("undeclared operator " ^ op, i)
      end
    case Nil =>
      raise ParseError("missing operand", at)
  end

procedure climb_loop[A](in lhs: A, items: List[Item[A]], min: Int, o: Ops[A], at: Int, out a: A, rest: List[Item[A]]) :=
  local rhs: A, more: List[Item[A]]

  match items
    case [Operator(op, i); tail] =>
      match (postfix_prec(o.notations.cmds, op), infix_of(o.notations.cmds, op))
        case (Some(p), _) if p >= min =>
          call climb_loop(in o.postfix_op(op, lhs), tail, min, o, at, out a, rest)

        case (_, Some((f, p))) if p >= min =>
          call climb(in tail, if f == FRight then p else p + 1, o, at, out rhs, more)
          call nonassociative(in op, f, p, more, o.notations.cmds)
          call climb_loop(in o.infix_op(op, lhs, rhs), more, min, o, at, out a, rest)

        case _ if not declared(o.notations, op) =>
          raise ParseError("undeclared operator " ^ op, i)

        else
          assign a := lhs, rest := items
      end
    else
      assign a := lhs, rest := items
  end

procedure nonassociative[A](in op: Id, f: Fixity, p: Int, rest: List[Item[A]], ns: List[Cmd]) :=
  match rest
    case [Operator(next, i); _] if f == FInfix and is_prec(infix_of(ns, next), p) =>
      raise ParseError("operator " ^ op ^ " is not associative", i)
    else
      skip
  end

function is_prec(fp: Option[Fixity * Int], p: Int): Bool :=
  match fp
    case Some((_, q)) => q == p
    else false
  end

// types, whose operands are lists, since only the arguments of a function are written (A, B),
// and the components of a tuple type A * B * C are collected in TSort("(product)", _), such that (A * B) * C stays nested

function type_one(ts: List[Type]): Type :=
  match ts
    case [TSort(Name(None, "(product)"), cs)] => TTuple(cs)
    case [t] => t
    case Nil => TTuple(Nil)
    else TSort(unqualified("(invalid)"), ts)
  end

function type_components(ts: List[Type]): List[Type] :=
  match ts
    case [TSort(Name(None, "(product)"), cs)] => cs
    else [type_one(ts)]
  end

function type_prefix(op: Id, t: List[Type]): List[Type] :=
  [TSort(unqualified(op), [type_one(t)])]

function type_infix(op: Id, l: List[Type], r: List[Type]): List[Type] :=
  if op == "->" then
    [TFun([type_one([t]) for t in l], type_one(r))]
  else if op == "*" then
    [TSort(unqualified("(product)"), type_components(l) ++ type_components(r))]
  else
    [TSort(unqualified(op), [type_one(l), type_one(r)])]

function has_invalid(t: Type): Bool :=
  match t
    case TSort(Name(None, "(invalid)"), _) => true
    case TSort(_, ts) => any_invalid(ts)
    case TFun(ts, r) => any_invalid(ts) or has_invalid(r)
    case TTuple(ts) => any_invalid(ts)
    else false
  end

function any_invalid(ts: List[Type]): Bool :=
  match ts
    case Nil => false
    case [t; more] => has_invalid(t) or any_invalid(more)
  end

function starts_type(ns: Notations, t: Token): Bool :=
  match t
    case TName(n) => not is_keyword(n) and not declared(ns, n)
    case TPunct('(') => true
    else false
  end

procedure parse_type(in sc: Scope, out t: Type, ref ts: List[Token * Int]) :=
  local start := head_offset(ts), items: List[Item[List[Type]]], r: List[Type]

  call   type_items(in sc, out items, ref ts)
  call   resolve_items(in items, Ops(sc.notations, type_prefix, type_prefix, type_infix), head_offset(ts), out r)
  assign t := type_one(r)

  if has_invalid(t)
    raise ParseError("tuple types are written A * B", start)
  end

procedure type_items(in sc: Scope, out items: List[Item[List[Type]]], ref ts: List[Token * Int]) :=
  local rev: List[Item[List[Type]]] := Nil, next := true, go := true, b: List[Type]

  while go
    match operator_at(sc.notations, ts)
      case Some(op) =>
        assign rev := [Operator(op, head_offset(ts)); rev], next := true
        call   advance(ref ts)
      case None if next and starts_type(sc.notations, head_token(ts)) =>
        call   type_basic(in sc, out b, ref ts)
        assign rev := [Operand(b); rev], next := false
      else
        assign go := false
    end
  end

  match rev
    case Nil =>
      raise ParseError("type expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
    else
      assign items := reverse(rev)
  end

// a type, a type in parentheses, the arguments (A, B) of a function, or ()
procedure type_basic(in sc: Scope, out r: List[Type], ref ts: List[Token * Int]) :=
  local n: Id, args: List[Type]

  if at_punct(ts, '(')
    call advance(ref ts)
    call type_list(in sc, ')', out r, ref ts)
  else
    call parse_plain(in sc, out n, ref ts)

    if at_punct(ts, '[')
      call   advance(ref ts)
      call   type_list(in sc, ']', out args, ref ts)
      assign r := [TSort(unqualified(n), args)]
    else if contains(n, sc.params)
      assign r := [TParam(n)]
    else
      assign r := [TSort(unqualified(n), Nil)]
    end
  end

// types separated by commas until close, which may be empty only for )
procedure type_list(in sc: Scope, close: Char, out r: List[Type], ref ts: List[Token * Int]) :=
  local rev: List[Type] := Nil, t: Type

  if close == ')' and at_punct(ts, close)
    call advance(ref ts)
  else
    call   parse_type(in sc, out t, ref ts)
    assign rev := [t]

    while at_punct(ts, ',')
      call   advance(ref ts)
      call   parse_type(in sc, out t, ref ts)
      assign rev := [t; rev]
    end

    call expect(in TPunct(close), ref ts)
  end

  assign r := reverse(rev)

// expressions

function expr_op1(op: Id, a: Expr): Expr :=
  EApp(EVar(Var(unqualified(op), THole)), [a])

// -n for a number n is the negative literal, in patterns and expressions, and otherwise a prefix operator is applied
function expr_prefix(op: Id, a: Expr): Expr :=
  match a
    case ELit(VInt(n)) if op == "-" => ELit(VInt(0 - n))
    else expr_op1(op, a)
  end

function expr_op2(op: Id, a: Expr, b: Expr): Expr :=
  EApp(EVar(Var(unqualified(op), THole)), [a, b])

function cons_exprs(es: List[Expr], rest: Expr): Expr :=
  match es
    case Nil => rest
    case [e; more] => expr_op2("Cons", e, cons_exprs(more, rest))
  end

function starts_expr(ns: Notations, t: Token): Bool :=
  match t
    case TName(n) => contains(n, ["let", "if", "lambda", "match", "true", "false"]) or not is_keyword(n) and not declared(ns, n)
    case TNum(_) => true
    case TStr(_) => true
    case TChar(_) => true
    case TPunct(c) => c == '(' or c == '[' or c == '{'
    else false
  end

// raise e is a whole expression, not an operand, such that a statement raise after an expression starts a statement
procedure parse_expr(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  if at_keyword(ts, "raise")
    call   advance(ref ts)
    call   parse_expr(in sc, out e, ref ts)
    assign e := ERaise(e, THole)
  else
    call operators(in sc, out e, ref ts)

    if at_keyword(ts, "with")
      call advance(ref ts)
      call parse_update(in sc, ref e, ts)

      while at_update(ts)
        call advance(ref ts)
        call parse_update(in sc, ref e, ts)
      end
    end
  end

// f := a in e with f := a, which applies the updater T.f:= to e and a, as the checker resolves it by the type of e
procedure parse_update(in sc: Scope, ref e: Expr, ts: List[Token * Int]) :=
  local f: Id, a: Expr

  call   parse_name(out f, ref ts)
  call   expect(in TSym(":="), ref ts)
  call   operators(in sc, out a, ref ts)
  assign e := EApp(EVar(Var(unqualified("." ^ f ^ ":="), THole)), [e, a])

// a comma before another update
function at_update(ts: List[Token * Int]): Bool :=
  match ts
    case [(TPunct(','), _), (TName(_), _), (TSym(":="), _); _] => true
    else false
  end

procedure operators(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local items: List[Item[Expr]]

  call   expr_items(in sc, out items, ref ts)
  call   resolve_items(in items, Ops(sc.notations, expr_prefix, expr_op1, expr_op2), head_offset(ts), out e)

// operands and operators, where an operand follows only an operator, since let, if, and lambda extend as far to the right as possible
procedure expr_items(in sc: Scope, out items: List[Item[Expr]], ref ts: List[Token * Int]) :=
  local rev: List[Item[Expr]] := Nil, next := true, go := true, e: Expr

  while go
    match operator_at(sc.notations, ts)
      case Some(op) =>
        assign rev := [Operator(op, head_offset(ts)); rev], next := true
        call   advance(ref ts)
      case None if next and starts_expr(sc.notations, head_token(ts)) =>
        call   parse_app(in sc, out e, ref ts)
        assign rev := [Operand(e); rev], next := false
      else
        assign go := false
    end
  end

  match rev
    case Nil =>
      raise ParseError("expression expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
    else
      assign items := reverse(rev)
  end

// expressions separated by commas, at least one
procedure parse_exprs(in sc: Scope, out es: List[Expr], ref ts: List[Token * Int]) :=
  local e: Expr, rev: List[Expr]

  call   parse_expr(in sc, out e, ref ts)
  assign rev := [e]

  while at_punct(ts, ',')
    call   advance(ref ts)
    call   parse_expr(in sc, out e, ref ts)
    assign rev := [e; rev]
  end

  assign es := reverse(rev)

// expressions separated by commas until close, which may be empty
procedure expr_list(in sc: Scope, close: Char, out es: List[Expr], ref ts: List[Token * Int]) :=
  if at_punct(ts, close)
    call   advance(ref ts)
    assign es := Nil
  else
    call parse_exprs(in sc, out es, ref ts)
    call expect(in TPunct(close), ref ts)
  end

// f(x) and e.f, which reads the field f of e, as the checker resolves it by the type of e
procedure parse_app(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local args: List[Expr], f: Id

  call parse_atom(in sc, out e, ref ts)

  while at_punct(ts, '(') or at_punct(ts, '.')
    if at_punct(ts, '(')
      call   advance(ref ts)
      call   expr_list(in sc, ')', out args, ref ts)
      assign e := EApp(e, args)
    else
      call   advance(ref ts)
      call   parse_name(out f, ref ts)
      assign e := EApp(EVar(Var(unqualified("." ^ f), THole)), [e])
    end
  end

procedure parse_atom(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local a: Expr, l: Expr, r: Expr, cs: List[Branch[Expr]], es: List[Expr]

  match head_token(ts)
    case TName("let") =>
      call parse_let(in sc, out e, ref ts)

    case TName("if") =>
      call   advance(ref ts)
      call   parse_expr(in sc, out a, ref ts)
      call   keyword(in "then", ref ts)
      call   parse_expr(in sc, out l, ref ts)
      call   keyword(in "else", ref ts)
      call   parse_expr(in sc, out r, ref ts)
      assign e := EIte(a, l, r)

    case TName("lambda") =>
      call parse_lambda(in sc, out e, ref ts)

    case TName("match") =>
      call   advance(ref ts)
      call   parse_expr(in sc, out a, ref ts)
      call   parse_expr_cases(in sc, out cs, ref ts)
      assign e := EMatch(a, cs)

    case TName("true") =>
      call   advance(ref ts)
      assign e := ELit(VBool(true))

    case TName("false") =>
      call   advance(ref ts)
      assign e := ELit(VBool(false))

    case TNum(n) =>
      call   advance(ref ts)
      assign e := ELit(VInt(n))

    case TStr(s) =>
      call   advance(ref ts)
      assign e := ELit(VStr(s))

    case TChar(c) =>
      call   advance(ref ts)
      assign e := ELit(VChar(c))

    case TPunct('(') =>
      call advance(ref ts)
      call expr_list(in sc, ')', out es, ref ts)
      match es
        case [x] =>
          assign e := x
        else
          assign e := ETuple(es)
      end

    case TPunct('[') =>
      call parse_brackets(in sc, out e, ref ts)

    case TPunct('{') =>
      call parse_braces(in sc, out e, ref ts)

    case TName(n) if not is_keyword(n) and not declared(sc.notations, n) =>
      call   advance(ref ts)
      assign e := EVar(Var(unqualified(n), THole))

    else
      raise ParseError("expression expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
  end

// the variables of patterns that are all variables
function pattern_vars(ps: List[Pat]): Option[List[Var]] :=
  match ps
    case Nil => Some(Nil)
    case [PVar(x); more] =>
      match pattern_vars(more)
        case Some(xs) => Some([x; xs])
        case None => None
      end
    else None
  end

// let x := e, y := f in b binds variables in parallel, other patterns are matched against the tuple of values
procedure parse_let(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local p: Pat, a: Expr, b: Expr, ps: List[Pat], es: List[Expr]

  call   advance(ref ts)
  call   parse_pattern(in sc, out p, ref ts)
  call   expect(in TSym(":="), ref ts)
  call   parse_expr(in sc, out a, ref ts)
  assign ps := [p], es := [a]

  while at_punct(ts, ',')
    call   advance(ref ts)
    call   parse_pattern(in sc, out p, ref ts)
    call   expect(in TSym(":="), ref ts)
    call   parse_expr(in sc, out a, ref ts)
    assign ps := [p; ps], es := [a; es]
  end

  call   keyword(in "in", ref ts)
  call   parse_expr(in sc, out b, ref ts)
  assign ps := reverse(ps), es := reverse(es)

  match (pattern_vars(ps), ps, es)
    case (Some(xs), _, _) =>
      assign e := ELet(zip(xs, es), b)
    case (None, [q], [c]) =>
      assign e := EMatch(c, [Branch(q, None, b)])
    else
      assign e := EMatch(ETuple(es), [Branch(PTuple(ps), None, b)])
  end

procedure parse_lambda(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local x: Id, xs: List[Var], b: Expr

  call   advance(ref ts)
  assign xs := Nil

  if head_token(ts) != TSym("=>")
    call   parse_plain(in sc, out x, ref ts)
    assign xs := [Var(unqualified(x), THole)]

    while at_punct(ts, ',')
      call   advance(ref ts)
      call   parse_plain(in sc, out x, ref ts)
      assign xs := [Var(unqualified(x), THole); xs]
    end
  end

  call   expect(in TSym("=>"), ref ts)
  call   parse_expr(in sc, out b, ref ts)
  assign e := ELam(reverse(xs), b)

// [a, b] is a :: b :: Nil, [a, b; c] is a :: b :: c, and [result for x in xs, y in ys if test], where if test is optional
// {a, b} is the set from_list([a, b]) and {k => v, l => w} the map put_all([(k, v), (l, w)], empty()),
// by the functions of the modules set and map, and {e for x in s if c} and {k => v for k1 => v1 in m if c} their comprehensions
procedure parse_braces(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local at := head_offset(ts), k: Expr, v: Expr, entries: Bool, rev: List[Expr]

  call   advance(ref ts)
  call   parse_expr(in sc, out k, ref ts)
  assign entries := head_token(ts) == TSym("=>")

  if entries
    call advance(ref ts)
    call parse_expr(in sc, out v, ref ts)
  end

  if at_keyword(ts, "for") and entries
    call advance(ref ts)
    call map_comprehension(in sc, k, v, out e, ref ts)
  else if at_keyword(ts, "for")
    call advance(ref ts)
    call set_comprehension(in sc, k, out e, ref ts)
  else
    assign rev := [if entries then ETuple([k, v]) else k]

    while at_punct(ts, ',')
      call   advance(ref ts)
      call   parse_expr(in sc, out k, ref ts)

      if entries != (head_token(ts) == TSym("=>"))
        raise ParseError("a literal {...} has either elements a or entries k => v", at)
      end

      if entries
        call   advance(ref ts)
        call   parse_expr(in sc, out v, ref ts)
        assign rev := [ETuple([k, v]); rev]
      else
        assign rev := [k; rev]
      end
    end

    assign e :=
      if entries then in_library("map", "put_all", [cons_exprs(reverse(rev), nil_expr()), in_library("map", "empty", [])])
      else in_library("set", "from_list", [cons_exprs(reverse(rev), nil_expr())])
  end

  call expect(in TPunct('}'), ref ts)

function nil_expr(): Expr :=
  EVar(Var(unqualified("Nil"), THole))

function in_library(m: Id, f: Id, args: List[Expr]): Expr :=
  EApp(EVar(Var(Name(Some(m), f), THole)), args)

procedure set_comprehension(in sc: Scope, r: Expr, out e: Expr, ref ts: List[Token * Int]) :=
  local x: Id, l: Expr, xs: List[Var] := Nil, ls: List[Expr] := Nil, c := ELit(VBool(true))

  call   parse_plain(in sc, out x, ref ts)
  call   keyword(in "in", ref ts)
  call   parse_expr(in sc, out l, ref ts)
  assign xs := [Var(unqualified(x), THole)], ls := [in_library("set", "elements", [l])]

  while at_punct(ts, ',')
    call   advance(ref ts)
    call   parse_plain(in sc, out x, ref ts)
    call   keyword(in "in", ref ts)
    call   parse_expr(in sc, out l, ref ts)
    assign xs := [Var(unqualified(x), THole); xs], ls := [in_library("set", "elements", [l]); ls]
  end

  if at_keyword(ts, "if")
    call advance(ref ts)
    call parse_expr(in sc, out c, ref ts)
  end

  assign e := in_library("set", "from_list", [EComp(r, reverse(xs), reverse(ls), c)])

// maps range over the entries of maps, each bound to a hidden variable whose key and value are matched
procedure map_comprehension(in sc: Scope, k: Expr, v: Expr, out e: Expr, ref ts: List[Token * Int]) :=
  local gs: List[Id * Id * Id] := Nil, ls: List[Expr] := Nil, c := ELit(VBool(true))

  call map_generator(in sc, ref gs, ls, ts)

  while at_punct(ts, ',')
    call advance(ref ts)
    call map_generator(in sc, ref gs, ls, ts)
  end

  if at_keyword(ts, "if")
    call   advance(ref ts)
    call   parse_expr(in sc, out c, ref ts)
    assign c := unpack(reverse(gs), c)
  end

  assign e := in_library("map", "put_all", [
    EComp(unpack(reverse(gs), ETuple([k, v])), reverse(hidden_vars(gs)), reverse(ls), c),
    in_library("map", "empty", [])
  ])

// k => v in m, whose map m sees the keys and values of the generators gs before, which are in reverse order
procedure map_generator(in sc: Scope, ref gs: List[Id * Id * Id], ls: List[Expr], ts: List[Token * Int]) :=
  local a: Id, b: Id, m: Expr

  call   parse_plain(in sc, out a, ref ts)
  call   expect(in TSym("=>"), ref ts)
  call   parse_plain(in sc, out b, ref ts)
  call   keyword(in "in", ref ts)
  call   parse_expr(in sc, out m, ref ts)
  assign ls := [in_library("map", "entries", [unpack(reverse(gs), m)]); ls]
  assign gs := [(a, b, "(entry " ^ str_show(length(gs) + 1) ^ ")"); gs]

function hidden_vars(gs: List[Id * Id * Id]): List[Var] :=
  match gs
    case Nil => Nil
    case [(_, _, h); rest] => [Var(unqualified(h), THole); hidden_vars(rest)]
  end

// e where the key and value of each hidden variable are bound
function unpack(gs: List[Id * Id * Id], e: Expr): Expr :=
  match gs
    case Nil => e
    case [(k, v, h); rest] =>
      EMatch(EVar(Var(unqualified(h), THole)), [Branch(PTuple([PVar(Var(unqualified(k), THole)), PVar(Var(unqualified(v), THole))]), None, unpack(rest, e))])
  end

procedure parse_brackets(in sc: Scope, out e: Expr, ref ts: List[Token * Int]) :=
  local first: Expr, es: List[Expr], rest: Expr, x: Id, xs: List[Var], l: Expr, lists: List[Expr], c: Expr

  call advance(ref ts)

  if at_punct(ts, ']')
    call   advance(ref ts)
    assign e := EVar(Var(unqualified("Nil"), THole))
  else
    call parse_expr(in sc, out first, ref ts)

    if at_keyword(ts, "for")
      call   advance(ref ts)
      call   parse_plain(in sc, out x, ref ts)
      call   keyword(in "in", ref ts)
      call   parse_expr(in sc, out l, ref ts)
      assign xs := [Var(unqualified(x), THole)], lists := [l]

      while at_punct(ts, ',')
        call   advance(ref ts)
        call   parse_plain(in sc, out x, ref ts)
        call   keyword(in "in", ref ts)
        call   parse_expr(in sc, out l, ref ts)
        assign xs := [Var(unqualified(x), THole); xs], lists := [l; lists]
      end

      assign c := ELit(VBool(true))

      if at_keyword(ts, "if")
        call advance(ref ts)
        call parse_expr(in sc, out c, ref ts)
      end

      call   expect(in TPunct(']'), ref ts)
      assign e := EComp(first, reverse(xs), reverse(lists), c)
    else
      assign es := [first]

      while at_punct(ts, ',')
        call   advance(ref ts)
        call   parse_expr(in sc, out first, ref ts)
        assign es := [first; es]
      end

      assign rest := EVar(Var(unqualified("Nil"), THole))

      if at_punct(ts, ';')
        call advance(ref ts)
        call parse_expr(in sc, out rest, ref ts)
      end

      call   expect(in TPunct(']'), ref ts)
      assign e := cons_exprs(reverse(es), rest)
    end
  end

procedure parse_guard(in sc: Scope, out g: Option[Expr], ref ts: List[Token * Int]) :=
  local e: Expr

  if at_keyword(ts, "if")
    call   advance(ref ts)
    call   parse_expr(in sc, out e, ref ts)
    assign g := Some(e)
  else
    assign g := None
  end

// case p if g => b, where else b is the last case _ => b
procedure parse_expr_cases(in sc: Scope, out cs: List[Branch[Expr]], ref ts: List[Token * Int]) :=
  local rev: List[Branch[Expr]] := Nil, p: Pat, g: Option[Expr], b: Expr

  while at_keyword(ts, "case")
    call   advance(ref ts)
    call   parse_pattern(in sc, out p, ref ts)
    call   parse_guard(in sc, out g, ref ts)
    call   expect(in TSym("=>"), ref ts)
    call   parse_expr(in sc, out b, ref ts)
    assign rev := [Branch(p, g, b); rev]
  end

  if at_keyword(ts, "else")
    call   advance(ref ts)
    call   parse_expr(in sc, out b, ref ts)
    assign rev := [Branch(PWild, None, b); rev]
    call   last_case(ref ts)
  end

  call   keyword(in "end", ref ts)
  assign cs := reverse(rev)

procedure last_case(ref ts: List[Token * Int]) :=
  if at_keyword(ts, "case")
    raise ParseError("else must be the last case", head_offset(ts))
  end

// patterns, where operators are constructors

function pat_op1(op: Id, p: Pat): Pat :=
  PApp(unqualified(op), [p])

function pat_prefix(op: Id, p: Pat): Pat :=
  match p
    case PLit(VInt(n)) if op == "-" => PLit(VInt(0 - n))
    else pat_op1(op, p)
  end

function pat_op2(op: Id, l: Pat, r: Pat): Pat :=
  PApp(unqualified(op), [l, r])

function cons_pats(ps: List[Pat], rest: Pat): Pat :=
  match ps
    case Nil => rest
    case [p; more] => PApp(unqualified("Cons"), [p, cons_pats(more, rest)])
  end

function starts_pattern(ns: Notations, t: Token): Bool :=
  match t
    case TName(n) => contains(n, ["_", "true", "false"]) or not is_keyword(n) and not declared(ns, n)
    case TNum(_) => true
    case TStr(_) => true
    case TChar(_) => true
    case TPunct(c) => c == '(' or c == '['
    else false
  end

procedure parse_pattern(in sc: Scope, out p: Pat, ref ts: List[Token * Int]) :=
  local items: List[Item[Pat]]

  call   pattern_items(in sc, out items, ref ts)
  call   resolve_items(in items, Ops(sc.notations, pat_prefix, pat_op1, pat_op2), head_offset(ts), out p)

procedure pattern_items(in sc: Scope, out items: List[Item[Pat]], ref ts: List[Token * Int]) :=
  local rev: List[Item[Pat]] := Nil, next := true, go := true, p: Pat

  while go
    match operator_at(sc.notations, ts)
      case Some(op) =>
        assign rev := [Operator(op, head_offset(ts)); rev], next := true
        call   advance(ref ts)
      case None if next and starts_pattern(sc.notations, head_token(ts)) =>
        call   pattern_simple(in sc, out p, ref ts)
        assign rev := [Operand(p); rev], next := false
      else
        assign go := false
    end
  end

  match rev
    case Nil =>
      raise ParseError("pattern expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
    else
      assign items := reverse(rev)
  end

// patterns separated by commas until close, which may be empty
procedure pattern_list(in sc: Scope, close: Char, out ps: List[Pat], ref ts: List[Token * Int]) :=
  local rev: List[Pat] := Nil, p: Pat

  if at_punct(ts, close)
    call advance(ref ts)
  else
    call   parse_pattern(in sc, out p, ref ts)
    assign rev := [p]

    while at_punct(ts, ',')
      call   advance(ref ts)
      call   parse_pattern(in sc, out p, ref ts)
      assign rev := [p; rev]
    end

    call expect(in TPunct(close), ref ts)
  end

  assign ps := reverse(rev)

procedure pattern_simple(in sc: Scope, out p: Pat, ref ts: List[Token * Int]) :=
  local n: Id, ps: List[Pat], rest: Pat

  match head_token(ts)
    case TName("_") =>
      call   advance(ref ts)
      assign p := PWild

    case TName("true") =>
      call   advance(ref ts)
      assign p := PLit(VBool(true))

    case TName("false") =>
      call   advance(ref ts)
      assign p := PLit(VBool(false))

    case TNum(k) =>
      call   advance(ref ts)
      assign p := PLit(VInt(k))

    case TStr(s) =>
      call   advance(ref ts)
      assign p := PLit(VStr(s))

    case TChar(c) =>
      call   advance(ref ts)
      assign p := PLit(VChar(c))

    case TPunct('(') =>
      call advance(ref ts)
      call pattern_list(in sc, ')', out ps, ref ts)
      match ps
        case [q] =>
          assign p := q
        else
          assign p := PTuple(ps)
      end

    case TPunct('[') =>
      call advance(ref ts)

      if at_punct(ts, ']')
        call   advance(ref ts)
        assign p := PApp(unqualified("Nil"), Nil)
      else
        call   parse_pattern(in sc, out p, ref ts)
        assign ps := [p]

        while at_punct(ts, ',')
          call   advance(ref ts)
          call   parse_pattern(in sc, out p, ref ts)
          assign ps := [p; ps]
        end

        assign rest := PApp(unqualified("Nil"), Nil)

        if at_punct(ts, ';')
          call advance(ref ts)
          call parse_pattern(in sc, out rest, ref ts)
        end

        call   expect(in TPunct(']'), ref ts)
        assign p := cons_pats(reverse(ps), rest)
      end

    else
      call parse_plain(in sc, out n, ref ts)

      if at_punct(ts, '(')
        call   advance(ref ts)
        call   pattern_list(in sc, ')', out ps, ref ts)
        assign p := PApp(unqualified(n), ps)
      else
        assign p := PVar(Var(unqualified(n), THole))
      end
  end

// statements

function starts_stmt(t: Token): Bool :=
  match t
    case TName(n) => contains(n, ["skip", "if", "while", "call", "match", "assert", "assign", "raise", "try"])
    else false
  end

function handlers(cs: List[Branch[Stmt]]): List[Handler] :=
  match cs
    case Nil => Nil
    case [Branch(p, g, b); more] => [Handler(THole, p, g, b); handlers(more)]
  end

// the body of an if, while, case, or procedure, which may declare variables first
// where local x := e initializes x by an assignment at the start of the block, in order, such that its type can be inferred
procedure parse_body(in sc: Scope, out b: Stmt, ref ts: List[Token * Int]) :=
  local xs: List[Var] := Nil, inits: List[Stmt] := Nil, rev: List[Stmt] := Nil, s: Stmt

  while at_keyword(ts, "local")
    call   advance(ref ts)
    call   parse_local(in sc, ref xs, inits, ts)

    while at_punct(ts, ',')
      call   advance(ref ts)
      call   parse_local(in sc, ref xs, inits, ts)
    end
  end

  while starts_stmt(head_token(ts))
    call   parse_stmt(in sc, out s, ref ts)
    assign rev := [s; rev]
  end

  assign b := SBlock(xs, inits ++ reverse(rev))

// x: T, x := e, or x: T := e, where the checker requires a type or an initial value
procedure parse_local(in sc: Scope, ref xs: List[Var], inits: List[Stmt], ts: List[Token * Int]) :=
  local n: Id, t: Type, e: Expr

  call   parse_plain(in sc, out n, ref ts)
  assign t := THole

  if head_token(ts) == TSym(":")
    call advance(ref ts)
    call parse_type(in sc, out t, ref ts)
  end

  if head_token(ts) == TSym(":=")
    call   advance(ref ts)
    call   parse_expr(in sc, out e, ref ts)
    assign inits := inits ++ [SAssign([(Var(unqualified(n), THole), e)])]
  end

  assign xs := xs ++ [Var(unqualified(n), t)]

procedure parse_stmt(in sc: Scope, out s: Stmt, ref ts: List[Token * Int]) :=
  local e: Expr, b: Stmt, cs: List[Branch[Stmt]]

  match head_token(ts)
    case TName("skip") =>
      call   advance(ref ts)
      assign s := SSkip

    case TName("if") =>
      call parse_if(in sc, out s, ref ts)

    case TName("while") =>
      call   advance(ref ts)
      call   parse_expr(in sc, out e, ref ts)
      call   parse_body(in sc, out b, ref ts)
      call   keyword(in "end", ref ts)
      assign s := SWhile(e, b)

    case TName("call") =>
      call parse_call(in sc, out s, ref ts)

    case TName("match") =>
      call   advance(ref ts)
      call   parse_expr(in sc, out e, ref ts)
      call   parse_stmt_cases(in sc, out cs, ref ts)
      assign s := SMatch(e, cs)

    case TName("assert") =>
      call   advance(ref ts)
      call   parse_expr(in sc, out e, ref ts)
      assign s := SAssert(e)

    case TName("assign") =>
      call parse_assign(in sc, out s, ref ts)

    case TName("raise") =>
      call   advance(ref ts)
      call   parse_expr(in sc, out e, ref ts)
      assign s := SRaise(e, THole)

    case TName("try") =>
      call   advance(ref ts)
      call   parse_body(in sc, out b, ref ts)
      call   keyword(in "catch", ref ts)
      call   parse_stmt_cases(in sc, out cs, ref ts)
      assign s := STry(b, handlers(cs))

    else
      raise ParseError("statement expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
  end

// the bodies start with a keyword, which ends the condition, and an if after else ends the whole chain
procedure parse_if(in sc: Scope, out s: Stmt, ref ts: List[Token * Int]) :=
  local c: Expr, l: Stmt, r: Stmt

  call   advance(ref ts)
  call   parse_expr(in sc, out c, ref ts)
  call   parse_body(in sc, out l, ref ts)

  if not at_keyword(ts, "else")
    call   keyword(in "end", ref ts)
    assign r := SSkip
  else if second_token(ts) == TName("if")
    call advance(ref ts)
    call parse_if(in sc, out r, ref ts)
  else
    call advance(ref ts)
    call parse_body(in sc, out r, ref ts)
    call keyword(in "end", ref ts)
  end

  assign s := SIf(c, l, r)

procedure parse_assign(in sc: Scope, out s: Stmt, ref ts: List[Token * Int]) :=
  local x: Id, e: Expr, rev: List[Var * Expr]

  call   advance(ref ts)
  call   parse_plain(in sc, out x, ref ts)
  call   expect(in TSym(":="), ref ts)
  call   parse_expr(in sc, out e, ref ts)
  assign rev := [(Var(unqualified(x), THole), e)]

  while at_punct(ts, ',')
    call   advance(ref ts)
    call   parse_plain(in sc, out x, ref ts)
    call   expect(in TSym(":="), ref ts)
    call   parse_expr(in sc, out e, ref ts)
    assign rev := [(Var(unqualified(x), THole), e); rev]
  end

  assign s := SAssign(reverse(rev))

procedure parse_stmt_cases(in sc: Scope, out cs: List[Branch[Stmt]], ref ts: List[Token * Int]) :=
  local rev: List[Branch[Stmt]] := Nil, p: Pat, g: Option[Expr], b: Stmt

  while at_keyword(ts, "case")
    call   advance(ref ts)
    call   parse_pattern(in sc, out p, ref ts)
    call   parse_guard(in sc, out g, ref ts)
    call   expect(in TSym("=>"), ref ts)
    call   parse_body(in sc, out b, ref ts)
    assign rev := [Branch(p, g, b); rev]
  end

  if at_keyword(ts, "else")
    call   advance(ref ts)
    call   parse_body(in sc, out b, ref ts)
    assign rev := [Branch(PWild, None, b); rev]
    call   last_case(ref ts)
  end

  call   keyword(in "end", ref ts)
  assign cs := reverse(rev)

// the next section starts with keyword w, after a comma unless it is the first section
function section_at(ts: List[Token * Int], w: Str, first: Bool): Bool :=
  if first then at_keyword(ts, w) else at_punct(ts, ',') and second_token(ts) == TName(w)

// a comma before another item of a section, not before the keyword of the next section
function item_follows(ts: List[Token * Int]): Bool :=
  at_punct(ts, ',') and second_token(ts) != TName("out") and second_token(ts) != TName("ref")

// call p(in ins, out outs, ref refs), where each section starts with its keyword, and empty sections are omitted
procedure parse_call(in sc: Scope, out s: Stmt, ref ts: List[Token * Int]) :=
  local p: Id, e: Expr, ins: List[Expr], outs: List[Var], refs: List[Var], first: Bool

  call   advance(ref ts)
  call   parse_name(out p, ref ts)
  call   expect(in TPunct('('), ref ts)
  assign ins := Nil, outs := Nil, refs := Nil, first := true

  if at_keyword(ts, "in")
    call   advance(ref ts)
    call   parse_expr(in sc, out e, ref ts)
    assign ins := [e], first := false

    while item_follows(ts)
      call   advance(ref ts)
      call   parse_expr(in sc, out e, ref ts)
      assign ins := [e; ins]
    end
  end

  if section_at(ts, "out", first)
    call   skip_comma(in first, ref ts)
    call   parse_variables(in sc, out outs, ref ts)
    assign first := false
  end

  if section_at(ts, "ref", first)
    call skip_comma(in first, ref ts)
    call parse_variables(in sc, out refs, ref ts)
  end

  call   expect(in TPunct(')'), ref ts)
  assign s := SCall(unqualified(p), reverse(ins), outs, refs)

// the comma before a section unless it is the first, and the keyword of the section
procedure skip_comma(in first: Bool, ref ts: List[Token * Int]) :=
  if not first
    call advance(ref ts)
  end

  call advance(ref ts)

procedure parse_variables(in sc: Scope, out xs: List[Var], ref ts: List[Token * Int]) :=
  local x: Id, rev: List[Var]

  call   parse_plain(in sc, out x, ref ts)
  assign rev := [Var(unqualified(x), THole)]

  while item_follows(ts)
    call   advance(ref ts)
    call   parse_plain(in sc, out x, ref ts)
    assign rev := [Var(unqualified(x), THole); rev]
  end

  assign xs := reverse(rev)

// only parameters and locals have type annotations
procedure parse_formal(in sc: Scope, out x: Var, ref ts: List[Token * Int]) :=
  local n: Id, t: Type

  call   parse_plain(in sc, out n, ref ts)
  assign t := THole

  if head_token(ts) == TSym(":")
    call advance(ref ts)
    call parse_type(in sc, out t, ref ts)
  end

  assign x := Var(unqualified(n), t)

// formals separated by commas, at least one, up to the keyword of the next section
procedure parse_formals1(in sc: Scope, out xs: List[Var], ref ts: List[Token * Int]) :=
  local x: Var, rev: List[Var]

  call   parse_formal(in sc, out x, ref ts)
  assign rev := [x]

  while item_follows(ts)
    call   advance(ref ts)
    call   parse_formal(in sc, out x, ref ts)
    assign rev := [x; rev]
  end

  assign xs := reverse(rev)

// formals in parentheses, which may be empty
procedure parse_formals(in sc: Scope, out xs: List[Var], ref ts: List[Token * Int]) :=
  call expect(in TPunct('('), ref ts)

  if at_punct(ts, ')')
    assign xs := Nil
  else
    call parse_formals1(in sc, out xs, ref ts)
  end

  call expect(in TPunct(')'), ref ts)

// commands

function declarations(cs: List[Cmd]): List[Cmd] :=
  match cs
    case Nil => Nil
    case [CEval(_); more] => declarations(more)
    case [CRun(_, _); more] => declarations(more)
    case [CTest(_, _); more] => declarations(more)
    case [c; more] => [c; declarations(more)]
  end

function notations_of(cs: List[Cmd]): List[Cmd] :=
  [c for c in cs if is_notation(c)]

function is_notation(c: Cmd): Bool :=
  match c
    case CNotation(_, _, _) => true
    else false
  end

// the notations so far, the modules loaded so far with their own notations, the modules being parsed, which cannot be imported,
// the notations of the prelude, which modules are parsed with, or None while parsing the prelude,
// whose modules are parsed with its notations so far, and the directory of the parsed file, whose modules hide the library
data Context :=
  | Context(notations: Notations, modules: List[Id * List[Cmd]], loading: List[Id], base: Option[Notations], dir: Option[Str])

function with_commands(cx: Context, cs: List[Cmd]): Context :=
  cx with notations := with_notations(cx.notations, cs)

function with_module(cx: Context, c: Cmd): Context :=
  cx with modules := modules_of(c) ++ cx.modules

// module c and the modules it loads, with their own notations
function modules_of(c: Cmd): List[Id * List[Cmd]] :=
  match c
    case CModule(n, cs) => [(n, notations_of(cs)); concat([modules_of(d) for d in cs])]
    else Nil
  end

function own_notations(cx: Context, n: Id): List[Cmd] :=
  match lookup(n, cx.modules)
    case Some(ns) => ns
    case None => Nil
  end

// the type parameters [A, B] of a declaration, if any
procedure type_params(out ps: List[Id], ref ts: List[Token * Int]) :=
  local rev: List[Id] := Nil, n: Id

  if at_punct(ts, '[')
    call   advance(ref ts)
    call   parse_name(out n, ref ts)
    assign rev := [n]

    while at_punct(ts, ',')
      call   advance(ref ts)
      call   parse_name(out n, ref ts)
      assign rev := [n; rev]
    end

    call expect(in TPunct(']'), ref ts)
  end

  assign ps := reverse(rev)

procedure parse_notation(out c: Cmd, ref ts: List[Token * Int]) :=
  local f := FInfix, p: Int, ops: List[Id], go: Bool

  match head_token(ts)
    case TName("prefix") =>
      assign f := FPrefix
    case TName("postfix") =>
      assign f := FPostfix
    else
      match second_token(ts)
        case TName("left") =>
          assign f := FLeft
          call   advance(ref ts)
        case TName("right") =>
          assign f := FRight
          call   advance(ref ts)
        else
          skip
      end
  end
  call advance(ref ts)

  match head_token(ts)
    case TNum(n) =>
      assign p := n
      call   advance(ref ts)
    else
      raise ParseError("precedence expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
  end
  assign ops := Nil, go := true

  while go
    match head_token(ts)
      case TSym(s) if not is_reserved(s) =>
        assign ops := [s; ops]
        call   advance(ref ts)
      case TName(n) if not is_keyword(n) =>
        assign ops := [n; ops]
        call   advance(ref ts)
      else
        assign go := false
    end
  end

  match ops
    case Nil =>
      raise ParseError("operator expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
    else
      assign c := CNotation(f, p, reverse(ops))
  end

// C or C(T, U), where the arguments may be named fields, as in C(name: T, rest: U)
procedure constructor(in sc: Scope, out k: Constr, fs: List[Option[Id]], ref ts: List[Token * Int]) :=
  local n: Id, args: List[Type], t: Type, f: Option[Id]

  call   parse_name_or_symbol(out n, ref ts)
  assign args := Nil, fs := Nil

  if at_punct(ts, '(')
    call advance(ref ts)

    if not at_punct(ts, ')')
      call   field(in sc, out f, t, ref ts)
      assign args := [t], fs := [f]

      while at_punct(ts, ',')
        call   advance(ref ts)
        call   field(in sc, out f, t, ref ts)
        assign args := [t; args], fs := [f; fs]
      end
    end

    call expect(in TPunct(')'), ref ts)
  end

  assign k := Constr(unqualified(n), reverse(args)), fs := reverse(fs)

  match repeated(field_names(fs))
    case Some(f) =>
      raise ParseError("repeated field " ^ f ^ " of " ^ n, head_offset(ts))
    case None =>
      skip
  end

// a type of a constructor, which may be named
procedure field(in sc: Scope, out f: Option[Id], t: Type, ref ts: List[Token * Int]) :=
  match (head_token(ts), second_token(ts))
    case (TName(n), TSym(":")) if not is_keyword(n) =>
      call   advance(ref ts)
      call   advance(ref ts)
      assign f := Some(n)
    else
      assign f := None
  end

  call parse_type(in sc, out t, ref ts)

// data T[A] := | C(A) | D, where the first | is optional
// with the accessors T.f of its named fields f
procedure parse_data(in ns: Notations, out cs: List[Cmd], ref ts: List[Token * Int]) :=
  local n: Id, ps: List[Id], k: Constr, fs: List[Option[Id]], rev: List[Constr * List[Option[Id]]]

  call   advance(ref ts)
  call   parse_name(out n, ref ts)
  call   type_params(out ps, ref ts)
  call   expect(in TSym(":="), ref ts)

  if head_token(ts) == TSym("|")
    call advance(ref ts)
  end

  call   constructor(in Scope(ps, ns), out k, fs, ref ts)
  assign rev := [(k, fs)]

  while head_token(ts) == TSym("|")
    call   advance(ref ts)
    call   constructor(in Scope(ps, ns), out k, fs, ref ts)
    assign rev := [(k, fs); rev]
  end

  match differing(fields_of(reverse(rev)))
    case Some(f) =>
      raise ParseError("field " ^ f ^ " of " ^ n ^ " has different types", head_offset(ts))
    case None =>
      skip
  end

  assign cs := [CData(unqualified(n), ps, firsts(reverse(rev))); accessors(n, ps, reverse(rev)) ++ updaters(n, ps, reverse(rev))]

function field_names(fs: List[Option[Id]]): List[Id] :=
  match fs
    case Nil => Nil
    case [Some(f); rest] => [f; field_names(rest)]
    case [None; rest] => field_names(rest)
  end

// a field with different types in different constructors, if any
function differing(fs: List[Id * (Name * Int * Int * Type)]): Option[Id] :=
  match fs
    case Nil => None
    case [(f, (_, _, _, t)); rest] => if contains(true, [type_of_field(e) != t for e in fields_named(f, rest)]) then Some(f) else differing(rest)
  end

function type_of_field(e: Id * (Name * Int * Int * Type)): Type :=
  match e
    case (_, (_, _, _, t)) => t
  end

function fields_named(f: Id, fs: List[Id * (Name * Int * Int * Type)]): List[Id * (Name * Int * Int * Type)] :=
  match fs
    case Nil => Nil
    case [(g, d); rest] => if g == f then [(g, d); fields_named(f, rest)] else fields_named(f, rest)
  end

// the fields of the constructors with each constructor, the position of the field, its number of arguments, and its type
function fields_of(ks: List[Constr * List[Option[Id]]]): List[Id * (Name * Int * Int * Type)] :=
  match ks
    case Nil => Nil
    case [(Constr(k, args), fs); rest] => named_fields(k, length(args), zip(fs, args), 0) ++ fields_of(rest)
  end

function named_fields(k: Name, n: Int, fs: List[Option[Id] * Type], i: Int): List[Id * (Name * Int * Int * Type)] :=
  match fs
    case Nil => Nil
    case [(Some(f), t); rest] => [(f, (k, i, n, t)); named_fields(k, n, rest, i + 1)]
    case [(None, _); rest] => named_fields(k, n, rest, i + 1)
  end

// the accessor T.f of each field f, which is partial if f is not a field of all constructors
function accessors(t: Id, ps: List[Id], ks: List[Constr * List[Option[Id]]]): List[Cmd] :=
  let fs := fields_of(ks) in
    [accessor(t, ps, f, fields_named(f, fs), length(ks)) for f in distinct(firsts(fs))]

function accessor(t: Id, ps: List[Id], f: Id, es: List[Id * (Name * Int * Int * Type)], n: Int): Cmd :=
  let x := Var(unqualified("x"), THole), owner := TSort(unqualified(t), [TParam(p) for p in ps]) in
    CFun(
      unqualified(t ^ "." ^ f),
      ps,
      [[Var(unqualified("x"), owner)]],
      field_type(es),
      EMatch(EVar(x), [field_case(e) for e in es] ++ (if length(es) == n then [] else [missing_field(t, f)]))
    )

function field_type(es: List[Id * (Name * Int * Int * Type)]): Type :=
  match es
    case [(_, (_, _, _, t)); _] => t
    else THole
  end

// case C(_, y, _) => y, where y is the field at its position
function field_case(e: Id * (Name * Int * Int * Type)): Branch[Expr] :=
  match e
    case (_, (k, i, n, _)) =>
      Branch(PApp(k, [if j == i then PVar(Var(unqualified("y"), THole)) else PWild for j in positions(n)]), None, EVar(Var(unqualified("y"), THole)))
  end

function missing_field(t: Id, f: Id): Branch[Expr] :=
  Branch(PWild, None, ERaise(EApp(EVar(Var(unqualified("MissingField"), THole)), [ELit(VStr(t ^ "." ^ f))]), THole))

// the updater T.f:= of each field f, where x with f := y is C(a0, y, a2) for x = C(a0, _, a2)
function updaters(t: Id, ps: List[Id], ks: List[Constr * List[Option[Id]]]): List[Cmd] :=
  let fs := fields_of(ks) in
    [updater(t, ps, f, fields_named(f, fs), length(ks)) for f in distinct(firsts(fs))]

function updater(t: Id, ps: List[Id], f: Id, es: List[Id * (Name * Int * Int * Type)], n: Int): Cmd :=
  let x := Var(unqualified("x"), THole), owner := TSort(unqualified(t), [TParam(p) for p in ps]) in
    CFun(
      unqualified(t ^ "." ^ f ^ ":="),
      ps,
      [[Var(unqualified("x"), owner), Var(unqualified("y"), field_type(es))]],
      owner,
      EMatch(EVar(x), [update_case(e) for e in es] ++ (if length(es) == n then [] else [missing_field(t, f)]))
    )

// case C(a0, _, a2) => C(a0, y, a2), where y replaces the field at its position
function update_case(e: Id * (Name * Int * Int * Type)): Branch[Expr] :=
  match e
    case (_, (k, i, n, _)) =>
      Branch(
        PApp(k, [if j == i then PWild else PVar(Var(unqualified("a" ^ str_show(j)), THole)) for j in positions(n)]),
        None,
        EApp(EVar(Var(k, THole)), [EVar(Var(unqualified(if j == i then "y" else "a" ^ str_show(j)), THole)) for j in positions(n)])
      )
  end

function positions(n: Int): List[Int] :=
  positions_from(0, n)

function positions_from(i: Int, n: Int): List[Int] :=
  if i == n then Nil else [i; positions_from(i + 1, n)]

procedure parse_function(in ns: Notations, out c: Cmd, ref ts: List[Token * Int]) :=
  local n: Id, ps: List[Id], xs: List[Var], xss: List[List[Var]], r: Type, b: Expr

  call   advance(ref ts)
  call   parse_name_or_symbol(out n, ref ts)
  call   type_params(out ps, ref ts)
  call   parse_formals(in Scope(ps, ns), out xs, ref ts)
  assign xss := [xs]

  while at_punct(ts, '(')
    call   parse_formals(in Scope(ps, ns), out xs, ref ts)
    assign xss := [xs; xss]
  end

  call   expect(in TSym(":"), ref ts)
  call   parse_type(in Scope(ps, ns), out r, ref ts)
  call   expect(in TSym(":="), ref ts)
  call   parse_expr(in Scope(ps, ns), out b, ref ts)
  assign c := CFun(unqualified(n), ps, reverse(xss), r, b)

procedure parse_procedure(in ns: Notations, out c: Cmd, ref ts: List[Token * Int]) :=
  local n: Id, ps: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], first: Bool, b: Stmt

  call   advance(ref ts)
  call   parse_name(out n, ref ts)
  call   type_params(out ps, ref ts)
  call   expect(in TPunct('('), ref ts)
  assign ins := Nil, outs := Nil, refs := Nil, first := true

  if at_keyword(ts, "in")
    call   advance(ref ts)
    call   parse_formals1(in Scope(ps, ns), out ins, ref ts)
    assign first := false
  end

  if section_at(ts, "out", first)
    call   skip_comma(in first, ref ts)
    call   parse_formals1(in Scope(ps, ns), out outs, ref ts)
    assign first := false
  end

  if section_at(ts, "ref", first)
    call skip_comma(in first, ref ts)
    call parse_formals1(in Scope(ps, ns), out refs, ref ts)
  end

  call   expect(in TPunct(')'), ref ts)
  call   expect(in TSym(":="), ref ts)
  call   parse_body(in Scope(ps, ns), out b, ref ts)
  assign c := CProc(unqualified(n), ps, ins, outs, refs, b)

// the commands of one declaration, where an import is the marker CImport(n), preceded by module n at its first import
procedure parse_command(in cx: Context, out cs: List[Cmd], ref ts: List[Token * Int]) :=
  local ns := cx.notations, n: Id, ps: List[Id], t: Type, c: Cmd, e: Expr, b: Stmt, at: Int

  match head_token(ts)
    case TName("import") =>
      assign at := head_offset(ts)
      call   advance(ref ts)
      call   parse_name(out n, ref ts)

      if contains(n, keys(cx.modules))
        assign cs := [CImport(n)]
      else
        call   load_module(in n, cx, at, out cs)
        assign cs := [CModule(n, declarations(cs)), CImport(n)]
      end

    case TName(w) if contains(w, ["prefix", "postfix", "infix"]) =>
      call   parse_notation(out c, ref ts)
      assign cs := [c]

    case TName("type") =>
      call   advance(ref ts)
      call   parse_name(out n, ref ts)
      call   type_params(out ps, ref ts)
      call   expect(in TSym(":="), ref ts)
      call   parse_type(in Scope(ps, ns), out t, ref ts)
      assign cs := [CSort(unqualified(n), ps, t)]

    case TName("data") =>
      call parse_data(in ns, out cs, ref ts)

    case TName("function") =>
      call   parse_function(in ns, out c, ref ts)
      assign cs := [c]

    case TName("procedure") =>
      call   parse_procedure(in ns, out c, ref ts)
      assign cs := [c]

    case TName("eval") =>
      call   advance(ref ts)
      call   parse_expr(in Scope(Nil, ns), out e, ref ts)
      assign cs := [CEval(e)]

    case TName("run") =>
      call   advance(ref ts)
      call   parse_name(out n, ref ts)
      call   expect(in TSym(":="), ref ts)
      call   parse_body(in Scope(Nil, ns), out b, ref ts)
      assign cs := [CRun(n, b)]

    case TName("test") =>
      call   advance(ref ts)
      call   parse_name(out n, ref ts)
      call   expect(in TSym(":="), ref ts)
      call   parse_body(in Scope(Nil, ns), out b, ref ts)
      assign cs := [CTest(n, b)]

    else
      raise ParseError("declaration expected but " ^ describe(head_token(ts)) ^ " found", head_offset(ts))
  end

// the context after the commands cs, where an import brings the own notations of the module
procedure declare_all(in cs: List[Cmd], ref cx: Context) :=
  match cs
    case Nil =>
      skip

    case [CNotation(f, p, ops); more] =>
      assign cx := with_commands(cx, [CNotation(f, p, ops)])
      call   declare_all(in more, ref cx)

    case [CModule(n, ds); more] =>
      assign cx := with_module(cx, CModule(n, ds))
      call   declare_all(in more, ref cx)

    case [CImport(n); more] =>
      assign cx := with_commands(cx, own_notations(cx, n))
      call   declare_all(in more, ref cx)

    case [_; more] =>
      call declare_all(in more, ref cx)
  end

// notations apply to the commands after them
procedure parse_commands(out cs: List[Cmd], ref cx: Context, ts: List[Token * Int]) :=
  local rev: List[Cmd] := Nil, more: List[Cmd]

  while head_token(ts) != TEnd
    call   parse_command(in cx, out more, ref ts)
    call   declare_all(in more, ref cx)
    assign rev := reverse_onto(more, rev)
  end

  assign cs := reverse(rev)

// modules are files in the directory of the parsed file, or in the library
procedure module_text(in n: Id, dir: Option[Str], at: Int, out text: Str) :=
  match dir
    case Some(d) =>
      try
        call os_read(in d ^ "/" ^ n ^ ".u", out text)
      catch
        case OsError(_) =>
          call library_text(in n, at, out text)
      end
    case None =>
      call library_text(in n, at, out text)
  end

procedure library_text(in n: Id, at: Int, out text: Str) :=
  try
    call os_library(in n, out text)
  catch
    case OsError(_) =>
      raise ParseError("unknown module " ^ n, at)
  end

// the commands of module n, parsed with the notations of the prelude and of its own imports, since imports are not transitive
procedure load_module(in n: Id, cx: Context, at: Int, out cs: List[Cmd]) :=
  local text: Str, mts: List[Token * Int], mcx: Context

  if contains(n, cx.loading)
    raise ParseError("cyclic import of " ^ n, at)
  end

  call   module_text(in n, cx.dir, at, out text)
  assign mcx := cx with notations := base_notations(cx), loading := [n; cx.loading]

  try
    call lex(in text, out mts)
    call parse_commands(out cs, ref mcx, mts)
  catch
    case LexError(m, i) =>
      raise ParseError(m ^ " in " ^ n, i)
    case ParseError(m, i) =>
      raise ParseError(m ^ " in " ^ n, i)
  end

function base_notations(cx: Context): Notations :=
  match cx.base
    case Some(b) => b
    case None => cx.notations
  end

// the program text in the context cx, e.g., after the prelude
procedure parse_text(in text: Str, cx: Context, out p: Program) :=
  local ts: List[Token * Int], cs: List[Cmd], after := cx

  try
    call lex(in text, out ts)
  catch
    case LexError(m, i) =>
      raise ParseError(m, i)
  end

  call   parse_commands(out cs, ref after, ts)
  assign p := Program(cs)

// the module of name, which is parsed after the prelude pre with its notations and modules, and reads modules from dir, or else the library
procedure module_after(in name: Id, pre: Program, dir: Option[Str], text: Str, out p: Program) :=
  local cx := Context(no_notations(), Nil, Nil, None, None)

  call declare_all(in pre.cmds, ref cx)
  call parse_text(in text, cx with loading := [name], base := Some(cx.notations), dir := dir, out p)

// the prelude, or another module of the library parsed after the prelude, as library gives them
procedure parse_library(in n: Id, out p: Program) :=
  local text: Str, pre: Program

  call library_text(in n, 0, out text)

  if n == "prelude"
    call parse_text(in text, Context(no_notations(), Nil, ["prelude"], None, None), out p)
  else
    call parse_library(in "prelude", out pre)
    call module_after(in n, pre, None, text, out p)
  end

function last_part(xs: List[Str]): Str :=
  match xs
    case [x] => x
    case [_; more] => last_part(more)
    else ""
  end

// the name of a file without its directory and .u
function base_name(path: Str): Str :=
  let f := last_part(str_split(path, '/')) in
    if str_size(f) >= 2 and str_slice(f, str_size(f) - 2, str_size(f)) == ".u" then str_slice(f, 0, str_size(f) - 2) else f

function dir_name(path: Str): Str :=
  let parts := str_split(path, '/') in if length(parts) == 1 then "." else str_join("/", take(length(parts) - 1, parts))

// a file after the prelude pre, as read gives it
procedure parse_file_after(in path: Str, pre: Program, out p: Program) :=
  local text: Str

  call   os_read(in path, out text)
  call   module_after(in base_name(path), pre, Some(dir_name(path)), text, out p)

procedure parse_file(in path: Str, out p: Program) :=
  local pre: Program

  call   parse_library(in "prelude", out pre)
  call   parse_file_after(in path, pre, out p)

// the commands agree one by one, shown with path if they do not
procedure same_commands(in path: Str, cs: List[Cmd], ds: List[Cmd]) :=
  match (cs, ds)
    case ([c; more], [d; rest]) =>
      assert (path, c) == (path, d)
      call   same_commands(in path, more, rest)
    else
      assert (path, length(cs)) == (path, length(ds))
  end

// the files parse as read parses them
procedure same_parses(in paths: List[Str], pre: Program) :=
  local p: Program, q: Program

  match paths
    case Nil =>
      skip
    case [path; more] =>
      call read(in path, out p)
      call parse_file_after(in path, pre, out q)
      call same_commands(in path, p.cmds, q.cmds)
      call same_parses(in more, pre)
  end

procedure parse_failures(in paths: List[Str], pre: Program) :=
  local p: Program, failed: Bool

  match paths
    case Nil =>
      skip
    case [path; more] =>
      assign failed := false

      try
        call parse_file_after(in path, pre, out p)
      catch
        case ParseError(_, _) =>
          assign failed := true
      end
      assert (path, failed) == (path, true)
      call   parse_failures(in more, pre)
  end

test parse_library_modules :=
  local p: Program, q: Program

  call   library(in "prelude", out p)
  call   parse_library(in "prelude", out q)
  call   same_commands(in "prelude", p.cmds, q.cmds)
  call   library(in "list", out p)
  call   parse_library(in "list", out q)
  call   same_commands(in "list", p.cmds, q.cmds)
  call   library(in "os", out p)
  call   parse_library(in "os", out q)
  call   same_commands(in "os", p.cmds, q.cmds)

test parse_files :=
  local pre: Program

  call   parse_library(in "prelude", out pre)
  call   same_parses(in [
    "../tests/counter.u",
    "../tests/datatypes.u",
    "../tests/doubler.u",
    "../tests/exceptions.u",
    "../tests/expressions.u",
    "../tests/fields.u",
    "../tests/files.u",
    "../tests/functions.u",
    "../tests/literals.u",
    "../tests/locals.u",
    "../tests/modules.u",
    "../tests/procedures.u",
    "../tests/stack.u",
    "../tests/strings.u",
    "c.u",
    "check.u",
    "compile.u",
    "ctx.u",
    "lex.u",
    "parse.u",
    "read.u",
    "run.u",
    "syntax.u"
  ], pre)

test parse_error_files :=
  local pre: Program

  call   parse_library(in "prelude", out pre)
  call   same_parses(in [
    "../tests/errors/add-bool.u",
    "../tests/errors/ambiguous-name.u",
    "../tests/errors/alias-arity.u",
    "../tests/errors/assertion.u",
    "../tests/errors/assign-input.u",
    "../tests/errors/assign-pattern-variable.u",
    "../tests/errors/assign-twice.u",
    "../tests/errors/assign-type.u",
    "../tests/errors/call-aliasing.u",
    "../tests/errors/call-arity.u",
    "../tests/errors/call-output-type.u",
    "../tests/errors/case-types.u",
    "../tests/errors/catch-unknown-type.u",
    "../tests/errors/comprehension-list.u",
    "../tests/errors/comprehension-test.u",
    "../tests/errors/constructor-clash.u",
    "../tests/errors/curried-duplicate.u",
    "../tests/errors/curried-missing-type.u",
    "../tests/errors/data-arity.u",
    "../tests/errors/data-unknown-param.u",
    "../tests/errors/division-by-zero.u",
    "../tests/errors/duplicate-constructor.u",
    "../tests/errors/duplicate-let.u",
    "../tests/errors/duplicate-run.u",
    "../tests/errors/duplicate-type-parameter.u",
    "../tests/errors/empty-match.u",
    "../tests/errors/empty-tuple-argument.u",
    "../tests/errors/field-of-unknown-type.u",
    "../tests/errors/guard-not-exhaustive.u",
    "../tests/errors/guard-type.u",
    "../tests/errors/if-condition.u",
    "../tests/errors/if-statement-condition.u",
    "../tests/errors/inner.u",
    "../tests/errors/lambda-monomorphic.u",
    "../tests/errors/left.u",
    "../tests/errors/let-rigid.u",
    "../tests/errors/list-display.u",
    "../tests/errors/list-type.u",
    "../tests/errors/local-scope.u",
    "../tests/errors/missing-cons.u",
    "../tests/errors/missing-false.u",
    "../tests/errors/missing-field.u",
    "../tests/errors/missing-int.u",
    "../tests/errors/missing-local-type.u",
    "../tests/errors/missing-nested-zero.u",
    "../tests/errors/missing-nil.u",
    "../tests/errors/missing-output-type.u",
    "../tests/errors/missing-pair-case.u",
    "../tests/errors/missing-parameter-type.u",
    "../tests/errors/missing-some-literal.u",
    "../tests/errors/missing-some.u",
    "../tests/errors/missing-statement-case.u",
    "../tests/errors/missing-successor.u",
    "../tests/errors/overload-arity.u",
    "../tests/errors/overload-same-arity.u",
    "../tests/errors/overload-unapplied.u",
    "../tests/errors/pair-type.u",
    "../tests/errors/pattern-arity.u",
    "../tests/errors/pattern-duplicate.u",
    "../tests/errors/pattern-type.u",
    "../tests/errors/raise-type-parameter.u",
    "../tests/errors/raise-uncaught.u",
    "../tests/errors/raise-unknown-type.u",
    "../tests/errors/rigid-param.u",
    "../tests/errors/rigid-params.u",
    "../tests/errors/right.u",
    "../tests/errors/sort-arity.u",
    "../tests/errors/string-display.u",
    "../tests/errors/test-types.u",
    "../tests/errors/too-many-arguments.u",
    "../tests/errors/transitive-name.u",
    "../tests/errors/unassigned-output.u",
    "../tests/errors/uninitialized.u",
    "../tests/errors/unit.u",
    "../tests/errors/unknown-constructor.u",
    "../tests/errors/unknown-field.u",
