// the parser of ulang, which parses the tokens of self/lex.u into programs of self/syntax.u,
// where notations apply to the commands after them, and imports inline the declarations of modules,
// read from the directory of the parsed file, or else from the library

import syntax
import lex
import os
import set
import map

export

data ParseError :=
  | ParseError(Str, Int)

procedure parse_library(in name: Id, out program: Program)
function last_part(xs: List[Str]): Str
function base_name(path: Str): Str
function dir_name(path: Str): Str
procedure parse_file_after(in path: Str, pre: Program, out program: Program)
procedure parse_text_after(in path: Str, pre: Program, text: Str, out program: Program)

// the commands of text in the context ctx, which reads no files unless text imports modules
procedure parse_text(in text: Str, ctx: Context, out program: Program)

// the precedences of the prefix and postfix operators declared so far, and the fixities and precedences of the infix ones
data Notations :=
  | Notations(prefix_ops: Map[Id, Int], postfix_ops: Map[Id, Int], infix_ops: Map[Id, Fixity * Int])

// the notations so far, the modules loaded so far with their own notations, the modules being parsed, which cannot be imported,
// the notations of the prelude, which modules are parsed with, or None while parsing the prelude,
// whose modules are parsed with its notations so far, and the directory of the parsed file, whose modules hide the library
data Context :=
  | Context(notations: Notations, modules: Map[Id, List[Cmd]], loading: List[Id], base: Option[Notations], dir: Option[Str])

function empty_context(): Context
function declare_commands(ctx: Context, cmds: List[Cmd]): Context
function prefix_prec(notations: Notations, op: Id): Option[Int]
function postfix_prec(notations: Notations, op: Id): Option[Int]
function infix_of(notations: Notations, op: Id): Option[Fixity * Int]

implementation

function keywords(): Set[Id] :=
  {
    "_", "assert", "assign", "call", "case", "catch", "data", "else", "end", "export", "false", "for", "function", "if",
    "implementation", "import", "in", "infix", "lambda", "let", "local", "match", "out", "postfix", "prefix",
    "procedure", "raise", "ref", "skip", "test", "then", "true", "type", "try", "while", "with"
  }

// symbols with a fixed meaning, which cannot be operators
function reserved(): Set[Str] :=
  {"=", "=>", ":=", ":", "|"}

// the operands of types, expressions, and patterns, and how operators apply to them

function type_ops(): Ops[List[Type]] :=
  Ops("type", starts_type, parse_type_atom, type_apply)

function expr_ops(): Ops[Expr] :=
  Ops("expression", starts_expr, parse_app, expr_apply)

function pat_ops(): Ops[Pat] :=
  Ops("pattern", starts_pattern, parse_pattern_atom, pat_apply)

// notations

function prefix_prec(notations: Notations, op: Id): Option[Int] :=
  get(op, notations.prefix_ops)

function postfix_prec(notations: Notations, op: Id): Option[Int] :=
  get(op, notations.postfix_ops)

function infix_of(notations: Notations, op: Id): Option[Fixity * Int] :=
  get(op, notations.infix_ops)

function is_operator(notations: Notations, op: Id): Bool :=
  contains(op, notations.prefix_ops) or contains(op, notations.postfix_ops) or contains(op, notations.infix_ops)

function empty_notations(): Notations :=
  Notations(empty(), empty(), empty())

function with_notations(notations: Notations, cmds: List[Cmd]): Notations :=
  match cmds
    case Nil => notations
    case [CNotation(f, prec, ops); more] => with_notations(with_operators(notations, f, prec, ops), more)
    case [_; more] => with_notations(notations, more)
  end

function with_operators(notations: Notations, f: Fixity, prec: Int, ops: List[Id]): Notations :=
  match (f, ops)
    case (_, Nil) => notations
    case (FPrefix, [op; more]) => with_operators(notations with prefix_ops := put(op, prec, notations.prefix_ops), f, prec, more)
    case (FPostfix, [op; more]) => with_operators(notations with postfix_ops := put(op, prec, notations.postfix_ops), f, prec, more)
    case (_, [op; more]) => with_operators(notations with infix_ops := put(op, (f, prec), notations.infix_ops), f, prec, more)
  end

// the notation of op of the kind of f, if any
function notation_of(notations: Notations, f: Fixity, op: Id): Option[Fixity * Int] :=
  match (f, prefix_prec(notations, op), postfix_prec(notations, op))
    case (FPrefix, Some(prec), _) => Some((FPrefix, prec))
    case (FPrefix, None, _) => None
    case (FPostfix, _, Some(prec)) => Some((FPostfix, prec))
    case (FPostfix, _, None) => None
    case _ => infix_of(notations, op)
  end

// an operator of the notations cmds that already has a notation of the same kind, where imports may repeat it as it is
function duplicate(notations: Notations, cmds: List[Cmd], imported: Bool): Option[Id] :=
  match cmds
    case Nil => None
    case [CNotation(f, prec, ops); more] =>
      match [op for op in ops if is_duplicate(notations, f, prec, op, imported)]
        case [op; _] => Some(op)
        case Nil => duplicate(notations, more, imported)
      end
    case [_; more] => duplicate(notations, more, imported)
  end

function is_duplicate(notations: Notations, f: Fixity, prec: Int, op: Id, imported: Bool): Bool :=
  match notation_of(notations, f, op)
    case Some(old) => not imported or old != (f, prec)
    case None => false
  end

procedure check_duplicates(in notations: Notations, cmds: List[Cmd], imported: Bool, offset: Int) :=
  match duplicate(notations, cmds, imported)
    case Some(op) if imported =>
      raise ParseError("imported operator " ++ op ++ " is declared differently", offset)
    case Some(op) =>
      raise ParseError("operator " ++ op ++ " is already declared", offset)
    case None =>
      skip
  end

// tokens

function head_token(toks: Tokens): Token :=
  match toks
    case [(tok, _); _] => tok
    case _ => TEnd
  end

function second_token(toks: Tokens): Token :=
  match toks
    case [_, (tok, _); _] => tok
    case _ => TEnd
  end

function head_offset(toks: Tokens): Int :=
  match toks
    case [(_, i); _] => i
    case _ => 0
  end

function at_keyword(toks: Tokens, w: Str): Bool :=
  head_token(toks) == TName(w)

function at_punct(toks: Tokens, c: Char): Bool :=
  head_token(toks) == TPunct(c)

function at_comma(toks: Tokens): Bool :=
  at_punct(toks, ',')

function at_bar(toks: Tokens): Bool :=
  head_token(toks) == TSym("|")

function at_mode(toks: Tokens): Bool :=
  at_keyword(toks, "in") or at_keyword(toks, "out") or at_keyword(toks, "ref")

// a comma before another update
function at_update(toks: Tokens): Bool :=
  match toks
    case [(TPunct(','), _), (TName(_), _), (TSym(":="), _); _] => true
    case _ => false
  end

function show_token(tok: Token): Str :=
  match tok
    case TName(name) => name
    case TSym(s) => s
    case TPunct(c) => string([c])
    case TNum(n) => show(n)
    case TStr(s) => str_quote(s)
    case TChar(c) => "'" ++ string([c]) ++ "'"
    case TEnd => "end of input"
  end

// the error that what is expected but the next token is found
function expected(what: Str, toks: Tokens): ParseError :=
  ParseError(what ++ " expected but " ++ show_token(head_token(toks)) ++ " found", head_offset(toks))

// the value of a literal token
function literal_at(toks: Tokens): Option[Val] :=
  match head_token(toks)
    case TName("true") => Some(VBool(true))
    case TName("false") => Some(VBool(false))
    case TNum(n) => Some(VInt(n))
    case TStr(s) => Some(VStr(s))
    case TChar(c) => Some(VChar(c))
    case _ => None
  end

// a name that may be declared as an operator, as a name and an operator are
function operator_at(notations: Notations, toks: Tokens): Option[Id] :=
  match head_token(toks)
    case TSym(s) if not contains(s, reserved()) => Some(s)
    case TName(name) if is_operator(notations, name) => Some(name)
    case _ => None
  end

procedure advance(ref toks: Tokens) :=
  match toks
    case [_; more] =>
      assign toks := more
    case _ =>
      skip
  end

procedure expect(in tok: Token, ref toks: Tokens) :=
  if head_token(toks) == tok
    call advance(ref toks)
  else
    raise expected(show_token(tok), toks)
  end

// a name that is not a keyword
procedure parse_name(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TName(m) if not contains(m, keywords()) =>
      assign name := m
      call   advance(ref toks)
    case _ =>
      raise expected("name", toks)
  end

// a name that is not declared as an operator
procedure parse_plain_name(in notations: Notations, params: List[Id], out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TName(m) if is_operator(notations, m) =>
      raise ParseError("operator " ++ m ++ " is not a name", head_offset(toks))
    case _ =>
      call parse_name(out name, ref toks)
  end

// a name or a symbol that is not reserved
procedure parse_name_or_symbol(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TSym(s) if not contains(s, reserved()) =>
      assign name := s
      call   advance(ref toks)
    case _ =>
      call parse_name(out name, ref toks)
  end

// lists, whose items are parsed by procedures, as are those of sections

// items, at least one, separated by the tokens that more finds
procedure parse_separated[A](
  in  notations: Notations,
      params: List[Id],
      item: (in Notations, List[Id], out A, ref Tokens),
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, rev: List[A]

  call   item(in notations, params, out x, ref toks)
  assign rev := [x]

  while more(toks)
    call   advance(ref toks)
    call   item(in notations, params, out x, ref toks)
    assign rev := [x; rev]
  end

  assign xs := reverse(rev)

// items, at least one, without separators, as long as more holds
procedure parse_repeated[A](
  in  notations: Notations,
      params: List[Id],
      item: (in Notations, List[Id], out A, ref Tokens),
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, rev: List[A]

  call   item(in notations, params, out x, ref toks)
  assign rev := [x]

  while more(toks)
    call   item(in notations, params, out x, ref toks)
    assign rev := [x; rev]
  end

  assign xs := reverse(rev)

// items separated by commas until close, which may be empty
procedure parse_enclosed[A](
  in  notations: Notations,
      params: List[Id],
      item: (in Notations, List[Id], out A, ref Tokens),
      close: Char,
  out xs: List[A],
  ref toks: Tokens
) :=
  if at_punct(toks, close)
    assign xs := Nil
  else
    call parse_separated(in notations, params, item, at_comma, out xs, ref toks)
  end

  call expect(in TPunct(close), ref toks)

// an item after tok, if tok is next
procedure parse_optional[A](
  in  notations: Notations,
      params: List[Id],
      tok: Token,
      item: (in Notations, List[Id], out A, ref Tokens),
  out x: Option[A],
  ref toks: Tokens
) :=
  local a: A

  if head_token(toks) == tok
    call   advance(ref toks)
    call   item(in notations, params, out a, ref toks)
    assign x := Some(a)
  else
    assign x := None
  end

function or_default[A](x: Option[A], default: A): A :=
  match x
    case Some(a) => a
    case None => default
  end

// the items a, b of a display [a, b], and the rest c of [a, b; c], read with brackets
procedure parse_display[A](
  in  notations: Notations,
      params: List[Id],
      item: (in Notations, List[Id], out A, ref Tokens),
  out items: List[A],
      rest: Option[A],
  ref toks: Tokens
) :=
  call parse_separated(in notations, params, item, at_comma, out items, ref toks)
  call parse_optional(in notations, params, TPunct(';'), item, out rest, ref toks)

// the items in front of rest by cons, as displays build lists
function cons_all[A](cons: (A, A) -> A, items: List[A], rest: A): A :=
  match items
    case Nil => rest
    case [a; more] => cons(a, cons_all(cons, more, rest))
  end

// precedence climbing over the tokens, as Mixfix of easyparse in cuvee, where prefix operators bind their operand
// with their own precedence, and a left associative operator is applied to all operands of a chain at once

// what an operand is called in errors, where it starts, how it is parsed, and how operators apply to operands,
// to the one of a prefix or postfix operator, and to the two or more of an infix operator
data Ops[A] :=
  | Ops(
    what: Str,
    starts: (Notations, Token) -> Bool,
    operand: (in Notations, List[Id], out A, ref Tokens),
    apply: (Fixity, Id, Int, List[A]) -> A
  )

// operands and operators, where an operator that cannot be applied is an error
procedure parse_operators[A](in notations: Notations, params: List[Id], ops: Ops[A], out a: A, ref toks: Tokens) :=
  call climb(in notations, params, ops, 0, out a, ref toks)

  match operator_at(notations, toks)
    case Some(op) =>
      raise ParseError("unexpected operator " ++ op, head_offset(toks))
    case None =>
      skip
  end

// an operand and the operators after it of precedence min or above
procedure climb[A](in notations: Notations, params: List[Id], ops: Ops[A], min: Int, out a: A, ref toks: Tokens) :=
  local lhs: A

  call climb_operand(in notations, params, ops, out lhs, ref toks)
  call climb_rest(in notations, params, ops, min, lhs, out a, ref toks)

// an operand, or a prefix operator applied to an operand
procedure climb_operand[A](in notations: Notations, params: List[Id], ops: Ops[A], out a: A, ref toks: Tokens) :=
  local offset := head_offset(toks), operand := ops.operand, b: A

  match operator_at(notations, toks)
    case Some(op) =>
      match prefix_prec(notations, op)
        case Some(prec) =>
          call   advance(ref toks)
          call   climb(in notations, params, ops, prec, out b, ref toks)
          assign a := ops.apply(FPrefix, op, offset, [b])
        case None if is_operator(notations, op) =>
          raise ParseError(op ++ " is not a prefix operator", offset)
        case None =>
          raise ParseError("undeclared operator " ++ op, offset)
      end
    case None if ops.starts(notations, head_token(toks)) =>
      call operand(in notations, params, out a, ref toks)
    case None =>
      raise expected(ops.what, toks)
  end

// lhs and the operators after it of precedence min or above
procedure climb_rest[A](in notations: Notations, params: List[Id], ops: Ops[A], min: Int, lhs: A, out a: A, ref toks: Tokens) :=
  local offset := head_offset(toks), args: List[A]

  match operator_at(notations, toks)
    case Some(op) =>
      match (postfix_prec(notations, op), infix_of(notations, op))
        case (Some(prec), _) if prec >= min =>
          call advance(ref toks)
          call climb_rest(in notations, params, ops, min, ops.apply(FPostfix, op, offset, [lhs]), out a, ref toks)

        case (_, Some((f, prec))) if prec >= min =>
          call advance(ref toks)
          call climb_infix(in notations, params, ops, op, f, prec, out args, ref toks)
          call climb_rest(in notations, params, ops, min, ops.apply(f, op, offset, [lhs; args]), out a, ref toks)

        case _ if not is_operator(notations, op) =>
          raise ParseError("undeclared operator " ++ op, offset)

        case _ =>
          assign a := lhs
      end
    case None =>
      assign a := lhs
  end

// the operands after the infix operator op, where a right associative op takes the operators of its own precedence,
// a left associative op takes further operands after more occurrences of op, and a non-associative op only one
procedure climb_infix[A](
  in  notations: Notations,
      params: List[Id],
      ops: Ops[A],
      op: Id,
      f: Fixity,
      prec: Int,
  out args: List[A],
  ref toks: Tokens
) :=
  local next := if f == FRight then prec else prec + 1

  call parse_separated(
    in notations, params,
      lambda in ns, params, out b, ref ts => call climb(in ns, params, ops, next, out b, ref ts) end,
      lambda ts => f == FLeft and operator_at(notations, ts) == Some(op),
    out args,
    ref toks
  )

  match operator_at(notations, toks)
    case Some(other) if f == FInfix and is_prec(infix_of(notations, other), prec) =>
      raise ParseError("operator " ++ op ++ " is not associative", head_offset(toks))
    case _ =>
      skip
  end

function is_prec(fp: Option[Fixity * Int], prec: Int): Bool :=
  match fp
    case Some((_, q)) => q == prec
    case _ => false
  end

// types, whose operands are lists of types, since the arguments of a function are written (A, B),
// and where a chain A * B * C is one tuple type, while (A * B) * C stays nested

// the type of an operand, which is a list of other than one type only as the arguments of a function
function as_type(types: List[Type], offset: Int): Type :=
  match types
    case [typ] => typ
    case Nil => TTuple(Nil)
    case _ => raise ParseError("tuple types are written A * B", offset)
  end

function type_apply(f: Fixity, op: Id, offset: Int, args: List[List[Type]]): List[Type] :=
  match args
    case [a] => [TSort(unqualified(op), [as_type(a, offset)])]
    case _ if op == "*" => [TTuple([as_type(a, offset) for a in args])]
    case [a; more] => type_infix(op, offset, a, more)
    case Nil => Nil
  end

// lhs and the operands rs, applied from the left
function type_infix(op: Id, offset: Int, lhs: List[Type], rs: List[List[Type]]): List[Type] :=
  match rs
    case Nil => lhs
    case [r; more] if op == "->" => type_infix(op, offset, [TFun(lhs, as_type(r, offset))], more)
    case [r; more] => type_infix(op, offset, [TSort(unqualified(op), [as_type(lhs, offset), as_type(r, offset)])], more)
  end

function starts_type(notations: Notations, tok: Token): Bool :=
  match tok
    case TName(name) => not contains(name, keywords()) and not is_operator(notations, name)
    case TPunct('(') => true
    case _ => false
  end

procedure parse_type(in notations: Notations, params: List[Id], out typ: Type, ref toks: Tokens) :=
  local start := head_offset(toks), r: List[Type]

  call   parse_operators(in notations, params, type_ops(), out r, ref toks)
  assign typ := as_type(r, start)

// a type, a type in parentheses, the arguments (A, B) of a function, or (), where params are the type parameters in scope,
// which distinguish TParam from TSort
procedure parse_type_atom(in notations: Notations, params: List[Id], out r: List[Type], ref toks: Tokens) :=
  local name: Id, args: List[Type], ins: List[Type], outs: List[Type], refs: List[Type]

  if at_punct(toks, '(') and contains(second_token(toks), [TName("in"), TName("out"), TName("ref")])
    call   advance(ref toks)
    call   parse_sections(in notations, params, parse_type, parse_type, out ins, outs, refs, ref toks)
    call   expect(in TPunct(')'), ref toks)
    assign r := [TProc(ins, outs, refs)]
  else if at_punct(toks, '(')
    call advance(ref toks)
    call parse_enclosed(in notations, params, parse_type, ')', out r, ref toks)
  else
    call parse_plain_name(in notations, params, out name, ref toks)

    if at_punct(toks, '[')
      call   advance(ref toks)
      call   parse_separated(in notations, params, parse_type, at_comma, out args, ref toks)
      call   expect(in TPunct(']'), ref toks)
      assign r := [TSort(unqualified(name), args)]
    else if contains(name, params)
      assign r := [TParam(name)]
    else
      assign r := [TSort(unqualified(name), Nil)]
    end
  end

// expressions

function expr_call(op: Id, args: List[Expr]): Expr :=
  EApp(EVar(Var(unqualified(op), THole)), args)

// -n for a number n is the negative literal, in patterns and expressions, and otherwise an operator is applied
function expr_apply(f: Fixity, op: Id, offset: Int, args: List[Expr]): Expr :=
  match args
    case [ELit(VInt(n))] if f == FPrefix and op == "-" => ELit(VInt(0 - n))
    case [a] => expr_call(op, [a])
    case [a; more] => expr_infix(op, a, more)
    case Nil => expr_call(op, Nil)
  end

// lhs and the operands rs, applied from the left
function expr_infix(op: Id, lhs: Expr, rs: List[Expr]): Expr :=
  match rs
    case Nil => lhs
    case [r; more] => expr_infix(op, expr_call(op, [lhs, r]), more)
  end

function expr_cons(a: Expr, b: Expr): Expr :=
  expr_call("Cons", [a, b])

function starts_expr(notations: Notations, tok: Token): Bool :=
  match tok
    case TName(name) => contains(name, ["let", "if", "lambda", "match", "true", "false"]) or not contains(name, keywords()) and not is_operator(notations, name)
    case TNum(_) => true
    case TStr(_) => true
    case TChar(_) => true
    case TPunct(c) => c == '(' or c == '[' or c == '{'
    case _ => false
  end

// raise e is a whole expression, not an operand, such that a statement raise after an expression starts a statement
procedure parse_expr(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local updates: List[Id * Expr]

  if at_keyword(toks, "raise")
    call   advance(ref toks)
    call   parse_expr(in notations, params, out expr, ref toks)
    assign expr := ERaise(expr, THole)
  else
    call parse_operators(in notations, params, expr_ops(), out expr, ref toks)

    if at_keyword(toks, "with")
      call   advance(ref toks)
      call   parse_separated(in notations, params, parse_update, at_update, out updates, ref toks)
      assign expr := apply_updates(expr, updates)
    end
  end

// f := a in e with f := a
procedure parse_update(in notations: Notations, params: List[Id], out update: Id * Expr, ref toks: Tokens) :=
  local f: Id, a: Expr

  call   parse_name(out f, ref toks)
  call   expect(in TSym(":="), ref toks)
  call   parse_operators(in notations, params, expr_ops(), out a, ref toks)
  assign update := (f, a)

// e with the updates in order, each of which applies the updater T.f:= to e and a, as the checker resolves it by the type of e
function apply_updates(expr: Expr, updates: List[Id * Expr]): Expr :=
  match updates
    case Nil => expr
    case [(f, a); more] => apply_updates(EApp(EVar(Var(unqualified("." ++ f ++ ":="), THole)), [expr, a]), more)
  end

// f(x) and e.f, which reads the field f of e, as the checker resolves it by the type of e
procedure parse_app(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local args: List[Expr], f: Id

  call parse_expr_atom(in notations, params, out expr, ref toks)

  while at_punct(toks, '(') or at_punct(toks, '.')
    if at_punct(toks, '(')
      call   advance(ref toks)
      call   parse_enclosed(in notations, params, parse_expr, ')', out args, ref toks)
      assign expr := EApp(expr, args)
    else
      call   advance(ref toks)
      call   parse_name(out f, ref toks)
      assign expr := EApp(EVar(Var(unqualified("." ++ f), THole)), [expr])
    end
  end

procedure parse_expr_atom(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local a: Expr, l: Expr, r: Expr, cases: List[Branch[Expr]], exprs: List[Expr]

  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign expr := ELit(v)

    case (_, TName("let")) =>
      call parse_let(in notations, params, out expr, ref toks)

    case (_, TName("if")) =>
      call   advance(ref toks)
      call   parse_expr(in notations, params, out a, ref toks)
      call   expect(in TName("then"), ref toks)
      call   parse_expr(in notations, params, out l, ref toks)
      call   expect(in TName("else"), ref toks)
      call   parse_expr(in notations, params, out r, ref toks)
      assign expr := EIte(a, l, r)

    case (_, TName("lambda")) =>
      call parse_lambda(in notations, params, out expr, ref toks)

    case (_, TName("match")) =>
      call   advance(ref toks)
      call   parse_expr(in notations, params, out a, ref toks)
      call   parse_cases(in notations, params, parse_expr, out cases, ref toks)
      assign expr := EMatch(a, cases)

    case (_, TPunct('(')) =>
      call advance(ref toks)
      call parse_enclosed(in notations, params, parse_expr, ')', out exprs, ref toks)
      match exprs
        case [inner] =>
          assign expr := inner
        case _ =>
          assign expr := ETuple(exprs)
      end

    case (_, TPunct('[')) =>
      call parse_list(in notations, params, out expr, ref toks)

    case (_, TPunct('{')) =>
      call parse_set_or_map(in notations, params, out expr, ref toks)

    case (_, TName(name)) if not contains(name, keywords()) and not is_operator(notations, name) =>
      call   advance(ref toks)
      assign expr := EVar(Var(unqualified(name), THole))

    case _ =>
      raise expected("expression", toks)
  end

// the variables of patterns that are all variables
function pattern_vars(pats: List[Pat]): Option[List[Var]] :=
  match pats
    case Nil => Some(Nil)
    case [PVar(x); more] =>
      match pattern_vars(more)
        case Some(xs) => Some([x; xs])
        case None => None
      end
    case _ => None
  end

// let x := e, y := f in body binds variables in parallel, other patterns are matched against the tuple of values
procedure parse_let(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local bindings: List[Pat * Expr], body: Expr, pats: List[Pat], exprs: List[Expr]

  call   advance(ref toks)
  call   parse_separated(in notations, params, parse_binding, at_comma, out bindings, ref toks)
  call   expect(in TName("in"), ref toks)
  call   parse_expr(in notations, params, out body, ref toks)
  assign pats := firsts(bindings), exprs := seconds(bindings)

  match (pattern_vars(pats), pats, exprs)
    case (Some(xs), _, _) =>
      assign expr := ELet(zip(xs, exprs), body)
    case (None, [pat], [c]) =>
      assign expr := EMatch(c, [Branch(pat, None, body)])
    case _ =>
      assign expr := EMatch(ETuple(exprs), [Branch(PTuple(pats), None, body)])
  end

// p := e
procedure parse_binding(in notations: Notations, params: List[Id], out binding: Pat * Expr, ref toks: Tokens) :=
  local pat: Pat, expr: Expr

  call   parse_pattern(in notations, params, out pat, ref toks)
  call   expect(in TSym(":="), ref toks)
  call   parse_expr(in notations, params, out expr, ref toks)
  assign binding := (pat, expr)

// lambda x, y => e is a function, and lambda in x, out y, ref z => body end a procedure, told apart by the modes
procedure parse_lambda(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local ins: List[Var], outs: List[Var], refs: List[Var], body: Stmt, xs: List[Var], inner: Expr

  call advance(ref toks)

  if at_mode(toks)
    call   parse_sections(in notations, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
    call   expect(in TSym("=>"), ref toks)
    call   parse_body(in notations, params, out body, ref toks)
    call   expect(in TName("end"), ref toks)
    assign expr := EProc(ins, outs, refs, body)
  else if head_token(toks) == TSym("=>")
    call   expect(in TSym("=>"), ref toks)
    call   parse_expr(in notations, params, out inner, ref toks)
    assign expr := ELam(Nil, inner)
  else
    call   parse_separated(in notations, params, parse_variable, at_comma, out xs, ref toks)
    call   expect(in TSym("=>"), ref toks)
    call   parse_expr(in notations, params, out inner, ref toks)
    assign expr := ELam(xs, inner)
  end

// a literal is the fold of its elements unrolled, {a, b} the set insert(a, insert(b, empty())) and {k => v, l => w} the map
// put(l, w, put(k, v, empty())), where the last entry of a key counts, by insert, put, and empty of the imported modules,
// which are set and map, and {e for x in c if q} and {k => v for k1 => v1 in m if q} are their comprehensions, while {} is
// empty() of the module that its type determines
procedure parse_set_or_map(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local offset := head_offset(toks)

  call advance(ref toks)

  if at_punct(toks, '}')
    assign expr := declared_app("empty", [])
  else
    call parse_set_or_map_elements(in notations, params, offset, out expr, ref toks)
  end

  call expect(in TPunct('}'), ref toks)

// the elements or entries of a literal, or its comprehension, after {
procedure parse_set_or_map_elements(in notations: Notations, params: List[Id], offset: Int, out expr: Expr, ref toks: Tokens) :=
  local elements: List[Expr * Option[Expr]], rest: Option[Expr * Option[Expr]]

  call   parse_display(in notations, params, parse_element, out elements, rest, ref toks)

  match elements
    case _ if rest != None =>
      raise ParseError("a literal {...} has no rest after ;", offset)

    case [(k, Some(v))] if at_keyword(toks, "for") =>
      call advance(ref toks)
      call parse_map_comprehension(in notations, params, k, v, out expr, ref toks)

    case [(k, None)] if at_keyword(toks, "for") =>
      call advance(ref toks)
      call parse_set_comprehension(in notations, params, k, out expr, ref toks)

    case _ =>
      match split_elements(elements)
        case ([_; _], [_; _]) =>
          raise ParseError("a literal {...} has either elements a or entries k => v", offset)
        case (Nil, pairs) =>
          assign expr := foldl(pairs, declared_app("empty", []), put_entry)
        case (xs, _) =>
          assign expr := foldr(xs, declared_app("empty", []), lambda a, s => declared_app("insert", [a, s]))
      end
  end

// an element a, or an entry k => v
procedure parse_element(in notations: Notations, params: List[Id], out element: Expr * Option[Expr], ref toks: Tokens) :=
  local k: Expr, v: Option[Expr]

  call   parse_expr(in notations, params, out k, ref toks)
  call   parse_optional(in notations, params, TSym("=>"), parse_expr, out v, ref toks)
  assign element := (k, v)

// the elements a and the entries k => v, each in their order
function split_elements(elements: List[Expr * Option[Expr]]): List[Expr] * List[Expr * Expr] :=
  match elements
    case Nil =>
      (Nil, Nil)
    case [(a, None); more] =>
      match split_elements(more)
        case (xs, pairs) => ([a; xs], pairs)
      end
    case [(k, Some(v)); more] =>
      match split_elements(more)
        case (xs, pairs) => (xs, [(k, v); pairs])
      end
  end

// m with the entry k => v put into it
function put_entry(m: Expr, pair: Expr * Expr): Expr :=
  match pair
    case (k, v) => declared_app("put", [k, v, m])
  end

function nil_expr(): Expr :=
  EVar(Var(unqualified("Nil"), THole))

// comprehensions are folds over the containers of their generators, by the foldr or foldl of the module of each container,
// whose functions put the result into the accumulator, nested for several generators, where each generator sees the variables
// of those before it

// a name of a declaration that a translation introduces, which locals do not hide, see overloads of self/check.u,
// and which resolves through the imports of the module
function declared(f: Id): Expr :=
  EVar(Var(Name(Some("*"), f), THole))

function declared_app(f: Id, args: List[Expr]): Expr :=
  EApp(declared(f), args)

// the accumulator of the folds of comprehensions, which users cannot name
function acc_var(): Var :=
  Var(unqualified("(acc)"), THole)

// the folds of the generators, each the variables it binds and its container, into init, where add puts the result into the
// accumulator if the condition holds, by foldr, whose functions take the accumulator last, or foldl, which takes it first
function comprehension_folds(fold: Id, generators: List[List[Var] * Expr], init: Expr, add: Expr, cond: Option[Expr]): Expr :=
  match generators
    case Nil =>
      match cond
        case Some(c) => EIte(c, add, EVar(acc_var()))
        case None => add
      end
    case [(xs, c); more] =>
      let inner := comprehension_folds(fold, more, EVar(acc_var()), add, cond) in
        EApp(declared(fold), [c, init, ELam(if fold == "foldr" then xs ++ [acc_var()] else [acc_var(); xs], inner)])
  end

// a set by insert, in any order
procedure parse_set_comprehension(in notations: Notations, params: List[Id], r: Expr, out expr: Expr, ref toks: Tokens) :=
  local generators: List[List[Var] * Expr], cond: Option[Expr]

  call   parse_separated(in notations, params, parse_generator, at_comma, out generators, ref toks)
  call   parse_optional(in notations, params, TName("if"), parse_expr, out cond, ref toks)
  assign expr := comprehension_folds("foldr", generators, declared_app("empty", []), declared_app("insert", [r, EVar(acc_var())]), cond)

// x in c over a list or set, or k => v in m over a map, whose fold takes the key and value as two arguments
procedure parse_generator(in notations: Notations, params: List[Id], out generator: List[Var] * Expr, ref toks: Tokens) :=
  local x: Var, y: Option[Var], c: Expr

  call   parse_variable(in notations, params, out x, ref toks)
  call   parse_optional(in notations, params, TSym("=>"), parse_variable, out y, ref toks)
  call   expect(in TName("in"), ref toks)
  call   parse_expr(in notations, params, out c, ref toks)
  assign generator := ([x; option_list(y)], c)

function option_list[A](o: Option[A]): List[A] :=
  match o
    case Some(a) => [a]
    case None => Nil
  end

// a map by put in the order of the generators, by foldl, so that the last entry of a key counts, as in a literal
procedure parse_map_comprehension(in notations: Notations, params: List[Id], k: Expr, v: Expr, out expr: Expr, ref toks: Tokens) :=
  local generators: List[List[Var] * Expr], cond: Option[Expr]

  call   parse_separated(in notations, params, parse_generator, at_comma, out generators, ref toks)
  call   parse_optional(in notations, params, TName("if"), parse_expr, out cond, ref toks)
  assign expr := comprehension_folds("foldl", generators, declared_app("empty", []), declared_app("put", [k, v, EVar(acc_var())]), cond)

// [a, b] is a :: b :: Nil, [a, b; c] is a :: b :: c, and [result for x in xs, y in ys if test], where if test is optional
procedure parse_list(in notations: Notations, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local exprs: List[Expr], rest: Option[Expr], generators: List[List[Var] * Expr], cond: Option[Expr]

  call advance(ref toks)

  if at_punct(toks, ']')
    assign expr := nil_expr()
  else
    call parse_display(in notations, params, parse_expr, out exprs, rest, ref toks)

    match (exprs, rest)
      case ([first], None) if at_keyword(toks, "for") =>
        call   advance(ref toks)
        call   parse_separated(in notations, params, parse_generator, at_comma, out generators, ref toks)
        call   parse_optional(in notations, params, TName("if"), parse_expr, out cond, ref toks)
        assign expr := comprehension_folds("foldr", generators, nil_expr(), expr_cons(first, EVar(acc_var())), cond)

      case _ =>
        assign expr := cons_all(expr_cons, exprs, or_default(rest, nil_expr()))
    end
  end

  call expect(in TPunct(']'), ref toks)

// case p if g => b, up to end
procedure parse_cases[B](
  in  notations: Notations,
      params: List[Id],
      body: (in Notations, List[Id], out B, ref Tokens),
  out cases: List[Branch[B]],
  ref toks: Tokens
) :=
  local rev: List[Branch[B]] := Nil, pat: Pat, g: Option[Expr], b: B

  while at_keyword(toks, "case")
    call   advance(ref toks)
    call   parse_pattern(in notations, params, out pat, ref toks)
    call   parse_optional(in notations, params, TName("if"), parse_expr, out g, ref toks)
    call   expect(in TSym("=>"), ref toks)
    call   body(in notations, params, out b, ref toks)
    assign rev := [Branch(pat, g, b); rev]
  end

  call   expect(in TName("end"), ref toks)
  assign cases := reverse(rev)

// patterns, where operators are constructors

function pat_apply(f: Fixity, op: Id, offset: Int, args: List[Pat]): Pat :=
  match args
    case [PLit(VInt(n))] if f == FPrefix and op == "-" => PLit(VInt(0 - n))
    case [pat] => PApp(unqualified(op), [pat])
    case [pat; more] => pat_infix(op, pat, more)
    case Nil => PApp(unqualified(op), Nil)
  end

// lhs and the operands rs, applied from the left
function pat_infix(op: Id, lhs: Pat, rs: List[Pat]): Pat :=
  match rs
    case Nil => lhs
    case [r; more] => pat_infix(op, PApp(unqualified(op), [lhs, r]), more)
  end

function pat_cons(a: Pat, b: Pat): Pat :=
  PApp(unqualified("Cons"), [a, b])

function pat_nil(): Pat :=
  PApp(unqualified("Nil"), Nil)

function starts_pattern(notations: Notations, tok: Token): Bool :=
  match tok
    case TName(name) => contains(name, ["_", "true", "false"]) or not contains(name, keywords()) and not is_operator(notations, name)
    case TNum(_) => true
    case TStr(_) => true
    case TChar(_) => true
    case TPunct(c) => c == '(' or c == '['
    case _ => false
  end

procedure parse_pattern(in notations: Notations, params: List[Id], out pat: Pat, ref toks: Tokens) :=
  call parse_operators(in notations, params, pat_ops(), out pat, ref toks)

procedure parse_pattern_atom(in notations: Notations, params: List[Id], out pat: Pat, ref toks: Tokens) :=
  local name: Id, pats: List[Pat], rest: Option[Pat]

  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign pat := PLit(v)

    case (_, TName("_")) =>
      call   advance(ref toks)
      assign pat := PWild

    case (_, TPunct('(')) =>
      call advance(ref toks)
      call parse_enclosed(in notations, params, parse_pattern, ')', out pats, ref toks)
      match pats
        case [inner] =>
          assign pat := inner
        case _ =>
          assign pat := PTuple(pats)
      end

    case (_, TPunct('[')) =>
      call advance(ref toks)

      if at_punct(toks, ']')
        assign pat := pat_nil()
      else
        call   parse_display(in notations, params, parse_pattern, out pats, rest, ref toks)
        assign pat := cons_all(pat_cons, pats, or_default(rest, pat_nil()))
      end

      call expect(in TPunct(']'), ref toks)

    case _ =>
      call parse_plain_name(in notations, params, out name, ref toks)

      if at_punct(toks, '(')
        call   advance(ref toks)
        call   parse_enclosed(in notations, params, parse_pattern, ')', out pats, ref toks)
        assign pat := PApp(unqualified(name), pats)
      else
        assign pat := PVar(Var(unqualified(name), THole))
      end
  end

// statements

function starts_stmt(tok: Token): Bool :=
  match tok
    case TName(name) => contains(name, ["skip", "if", "while", "call", "match", "assert", "assign", "raise", "try"])
    case _ => false
  end

function handlers(cases: List[Branch[Stmt]]): List[Handler] :=
  match cases
    case Nil => Nil
    case [Branch(pat, g, b); more] => [Handler(THole, pat, g, b); handlers(more)]
  end

// the body of an if, while, case, or procedure, which may declare variables first
// where local x := e initializes x by an assignment at the start of the block, in order, such that its type can be inferred
procedure parse_body(in notations: Notations, params: List[Id], out body: Stmt, ref toks: Tokens) :=
  local xs: List[Var] := Nil, inits: List[Stmt] := Nil, decls: List[Var * List[Stmt]], rev: List[Stmt] := Nil, s: Stmt

  while at_keyword(toks, "local")
    call   advance(ref toks)
    call   parse_separated(in notations, params, parse_local, at_comma, out decls, ref toks)
    assign xs := xs ++ firsts(decls), inits := inits ++ concat(seconds(decls))
  end

  while starts_stmt(head_token(toks))
    call   parse_stmt(in notations, params, out s, ref toks)
    assign rev := [s; rev]
  end

  assign body := SBlock(xs, inits ++ reverse(rev))

// x: T, x := e, or x: T := e, where the checker requires a type or an initial value
procedure parse_local(in notations: Notations, params: List[Id], out decl: Var * List[Stmt], ref toks: Tokens) :=
  local x: Var, init: Option[Expr]

  call parse_formal(in notations, params, out x, ref toks)
  call parse_optional(in notations, params, TSym(":="), parse_expr, out init, ref toks)

  match init
    case Some(expr) =>
      assign decl := (x, [SAssign([(Var(x.name, THole), expr)])])
    case None =>
      assign decl := (x, Nil)
  end

procedure parse_stmt(in notations: Notations, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local expr: Expr, body: Stmt, cases: List[Branch[Stmt]]

  match head_token(toks)
    case TName("skip") =>
      call   advance(ref toks)
      assign s := SSkip

    case TName("if") =>
      call parse_if(in notations, params, out s, ref toks)

    case TName("while") =>
      call   advance(ref toks)
      call   parse_expr(in notations, params, out expr, ref toks)
      call   parse_body(in notations, params, out body, ref toks)
      call   expect(in TName("end"), ref toks)
      assign s := SWhile(expr, body)

    case TName("call") =>
      call parse_call(in notations, params, out s, ref toks)

    case TName("match") =>
      call   advance(ref toks)
      call   parse_expr(in notations, params, out expr, ref toks)
      call   parse_cases(in notations, params, parse_body, out cases, ref toks)
      assign s := SMatch(expr, cases)

    case TName("assert") =>
      call   advance(ref toks)
      call   parse_expr(in notations, params, out expr, ref toks)
      assign s := SAssert(expr)

    case TName("assign") =>
      call parse_assign(in notations, params, out s, ref toks)

    case TName("raise") =>
      call   advance(ref toks)
      call   parse_expr(in notations, params, out expr, ref toks)
      assign s := SRaise(expr, THole)

    case TName("try") =>
      call   advance(ref toks)
      call   parse_body(in notations, params, out body, ref toks)
      call   expect(in TName("catch"), ref toks)
      call   parse_cases(in notations, params, parse_body, out cases, ref toks)
      assign s := STry(body, handlers(cases))

    case _ =>
      raise expected("statement", toks)
  end

// the bodies start with a keyword, which ends the condition, and an if after else ends the whole chain
procedure parse_if(in notations: Notations, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local cond: Expr, l: Stmt, r: Stmt

  call   advance(ref toks)
  call   parse_expr(in notations, params, out cond, ref toks)
  call   parse_body(in notations, params, out l, ref toks)

  if not at_keyword(toks, "else")
    call   expect(in TName("end"), ref toks)
    assign r := SSkip
  else if second_token(toks) == TName("if")
    call advance(ref toks)
    call parse_if(in notations, params, out r, ref toks)
  else
    call advance(ref toks)
    call parse_body(in notations, params, out r, ref toks)
    call expect(in TName("end"), ref toks)
  end

  assign s := SIf(cond, l, r)

procedure parse_assign(in notations: Notations, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local assignments: List[Var * Expr]

  call   advance(ref toks)
  call   parse_separated(in notations, params, parse_assignment, at_comma, out assignments, ref toks)
  assign s := SAssign(assignments)

// x := e
procedure parse_assignment(in notations: Notations, params: List[Id], out assignment: Var * Expr, ref toks: Tokens) :=
  local x: Var, expr: Expr

  call   parse_variable(in notations, params, out x, ref toks)
  call   expect(in TSym(":="), ref toks)
  call   parse_expr(in notations, params, out expr, ref toks)
  assign assignment := (x, expr)

// the next section starts with keyword w, after a comma unless it is the first section
function section_starts(toks: Tokens, w: Str, first: Bool): Bool :=
  if first then at_keyword(toks, w) else at_punct(toks, ',') and second_token(toks) == TName(w)

// a comma before another item of a section, not before the keyword of the next section
function section_continues(toks: Tokens): Bool :=
  at_punct(toks, ',') and second_token(toks) != TName("out") and second_token(toks) != TName("ref")

// call p(in ins, out outs, ref refs)
procedure parse_call(in notations: Notations, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local p: Id, ins: List[Expr], outs: List[Var], refs: List[Var]

  call   advance(ref toks)
  call   parse_name(out p, ref toks)
  call   expect(in TPunct('('), ref toks)
  call   parse_sections(in notations, params, parse_expr, parse_variable, out ins, outs, refs, ref toks)
  call   expect(in TPunct(')'), ref toks)
  assign s := SCall(unqualified(p), ins, outs, refs)

// in ins, out outs, ref refs of calls, declarations, lambdas, and types, where each section starts with its keyword,
// and empty sections are omitted
procedure parse_sections[A, B](
  in  notations: Notations,
      params: List[Id],
      item_in: (in Notations, List[Id], out A, ref Tokens),
      item: (in Notations, List[Id], out B, ref Tokens),
  out ins: List[A],
      outs: List[B],
      refs: List[B],
  ref toks: Tokens
) :=
  local first := true

  assign ins := Nil, outs := Nil, refs := Nil

  if at_keyword(toks, "in")
    call   advance(ref toks)
    call   parse_separated(in notations, params, item_in, section_continues, out ins, ref toks)
    assign first := false
  end

  if section_starts(toks, "out", first)
    call   skip_section_start(in first, ref toks)
    call   parse_separated(in notations, params, item, section_continues, out outs, ref toks)
    assign first := false
  end

  if section_starts(toks, "ref", first)
    call skip_section_start(in first, ref toks)
    call parse_separated(in notations, params, item, section_continues, out refs, ref toks)
  end

// the comma before a section unless it is the first, and the keyword of the section
procedure skip_section_start(in first: Bool, ref toks: Tokens) :=
  if not first
    call advance(ref toks)
  end

  call advance(ref toks)

procedure parse_variable(in notations: Notations, params: List[Id], out x: Var, ref toks: Tokens) :=
  local name: Id

  call   parse_plain_name(in notations, params, out name, ref toks)
  assign x := Var(unqualified(name), THole)

// only parameters and locals have type annotations
procedure parse_formal(in notations: Notations, params: List[Id], out x: Var, ref toks: Tokens) :=
  local name: Id, typ: Option[Type]

  call   parse_plain_name(in notations, params, out name, ref toks)
  call   parse_optional(in notations, params, TSym(":"), parse_type, out typ, ref toks)
  assign x := Var(unqualified(name), or_default(typ, THole))

// formals in parentheses, which may be empty
procedure parse_formals(in notations: Notations, params: List[Id], out xs: List[Var], ref toks: Tokens) :=
  call expect(in TPunct('('), ref toks)
  call parse_enclosed(in notations, params, parse_formal, ')', out xs, ref toks)

// commands

function declarations(cmds: List[Cmd]): List[Cmd] :=
  match cmds
    case Nil => Nil
    case [CTest(_, _, _); more] => declarations(more)
    case [cmd; more] => [cmd; declarations(more)]
  end

function is_notation(cmd: Cmd): Bool :=
  match cmd
    case CNotation(_, _, _) => true
    case _ => false
  end

function empty_context(): Context :=
  Context(empty_notations(), empty(), Nil, None, None)

function with_commands(ctx: Context, cmds: List[Cmd]): Context :=
  ctx with notations := with_notations(ctx.notations, cmds)

function with_module(ctx: Context, cmd: Cmd): Context :=
  ctx with modules := put_all(modules_of(cmd), ctx.modules)

// module cmd and the modules it loads, with their own notations, which a module without an export section keeps private
function modules_of(cmd: Cmd): List[Id * List[Cmd]] :=
  match cmd
    case CModule(name, cmds) =>
      let own := if contains(CExport, cmds) then [d for d in cmds if is_notation(d)] else Nil in
        [(name, own); concat([modules_of(d) for d in cmds])]
    case _ => Nil
  end

function own_notations(ctx: Context, name: Id): List[Cmd] :=
  match get(name, ctx.modules)
    case Some(ns) => ns
    case None => Nil
  end

// the type parameters [A, B] of a declaration, if any
procedure parse_params(in notations: Notations, out params: List[Id], ref toks: Tokens) :=
  if at_punct(toks, '[')
    call advance(ref toks)
    call parse_separated(in notations, Nil, parse_param, at_comma, out params, ref toks)
    call expect(in TPunct(']'), ref toks)
  else
    assign params := Nil
  end

procedure parse_param(in notations: Notations, params: List[Id], out name: Id, ref toks: Tokens) :=
  call parse_name(out name, ref toks)

procedure parse_notation(in notations: Notations, out cmd: Cmd, ref toks: Tokens) :=
  local f := FInfix, prec: Int, ops: List[Id]

  match head_token(toks)
    case TName("prefix") =>
      assign f := FPrefix
    case TName("postfix") =>
      assign f := FPostfix
    case _ =>
      match second_token(toks)
        case TName("left") =>
          assign f := FLeft
          call   advance(ref toks)
        case TName("right") =>
          assign f := FRight
          call   advance(ref toks)
        case _ =>
          skip
      end
  end
  call advance(ref toks)

  match head_token(toks)
    case TNum(n) =>
      assign prec := n
      call   advance(ref toks)
    case _ =>
      raise expected("precedence", toks)
  end

  call   parse_repeated(in notations, Nil, parse_operator, at_operator, out ops, ref toks)
  assign cmd := CNotation(f, prec, ops)

// a symbol that is not reserved, or a name that is not a keyword, as operators are declared
function at_operator(toks: Tokens): Bool :=
  match head_token(toks)
    case TSym(s) => not contains(s, reserved())
    case TName(name) => not contains(name, keywords())
    case _ => false
  end

procedure parse_operator(in notations: Notations, params: List[Id], out op: Id, ref toks: Tokens) :=
  if at_operator(toks)
    assign op := show_token(head_token(toks))
    call   advance(ref toks)
  else
    raise expected("operator", toks)
  end

// C or C(T, U), where the arguments may be named fields, as in C(name: T, rest: U)
procedure parse_constr(in notations: Notations, params: List[Id], out constr: Constr * List[Option[Id]], ref toks: Tokens) :=
  local name: Id, args: List[Option[Id] * Type] := Nil

  call parse_name_or_symbol(out name, ref toks)

  if at_punct(toks, '(')
    call advance(ref toks)
    call parse_enclosed(in notations, params, parse_field, ')', out args, ref toks)
  end

  assign constr := (Constr(unqualified(name), seconds(args)), firsts(args))

  match repeated(field_names(firsts(args)))
    case Some(f) =>
      raise ParseError("repeated field " ++ f ++ " of " ++ name, head_offset(toks))
    case None =>
      skip
  end

// a type of a constructor, which may be named
procedure parse_field(in notations: Notations, params: List[Id], out arg: Option[Id] * Type, ref toks: Tokens) :=
  local f: Option[Id], typ: Type

  match (head_token(toks), second_token(toks))
    case (TName(name), TSym(":")) if not contains(name, keywords()) =>
      call   advance(ref toks)
      call   advance(ref toks)
      assign f := Some(name)
    case _ =>
      assign f := None
  end

  call   parse_type(in notations, params, out typ, ref toks)
  assign arg := (f, typ)

// data T[A] := | C(A) | D, where the first | is optional
// with the accessors T.f of its named fields f
procedure parse_data(in notations: Notations, out cmds: List[Cmd], ref toks: Tokens) :=
  local name: Id, params: List[Id], constrs: List[Constr * List[Option[Id]]]

  call   advance(ref toks)
  call   parse_name(out name, ref toks)
  call   parse_params(in notations, out params, ref toks)
  call   expect(in TSym(":="), ref toks)

  if head_token(toks) == TSym("|")
    call advance(ref toks)
  end

  call parse_separated(in notations, params, parse_constr, at_bar, out constrs, ref toks)

  match differing(fields_of(constrs))
    case Some(f) =>
      raise ParseError("field " ++ f ++ " of " ++ name ++ " has different types", head_offset(toks))
    case None =>
      skip
  end

  assign cmds := [CData(unqualified(name), params, firsts(constrs)); accessors(name, params, constrs) ++ updaters(name, params, constrs)]

function field_names(fields: List[Option[Id]]): List[Id] :=
  match fields
    case Nil => Nil
    case [Some(f); rest] => [f; field_names(rest)]
    case [None; rest] => field_names(rest)
  end

// a field with different types in different constructors, if any
function differing(fields: List[Id * (Name * Int * Int * Type)]): Option[Id] :=
  match fields
    case Nil => None
    case [(f, (_, _, _, t)); rest] => if exists(fields_named(f, rest), lambda e => type_of_field(e) != t) then Some(f) else differing(rest)
  end

function type_of_field(field: Id * (Name * Int * Int * Type)): Type :=
  match field
    case (_, (_, _, _, t)) => t
  end

function fields_named(f: Id, fields: List[Id * (Name * Int * Int * Type)]): List[Id * (Name * Int * Int * Type)] :=
  match fields
    case Nil => Nil
    case [(g, d); rest] => if g == f then [(g, d); fields_named(f, rest)] else fields_named(f, rest)
  end

// the fields of the constructors with each constructor, the position of the field, its number of arguments, and its type
function fields_of(constrs: List[Constr * List[Option[Id]]]): List[Id * (Name * Int * Int * Type)] :=
  match constrs
    case Nil => Nil
    case [(Constr(k, args), fs); rest] => named_fields(k, size(args), zip(fs, args), 0) ++ fields_of(rest)
  end

function named_fields(k: Name, n: Int, fields: List[Option[Id] * Type], i: Int): List[Id * (Name * Int * Int * Type)] :=
  match fields
    case Nil => Nil
    case [(Some(f), t); rest] => [(f, (k, i, n, t)); named_fields(k, n, rest, i + 1)]
    case [(None, _); rest] => named_fields(k, n, rest, i + 1)
  end

// the accessor T.f of each field f, which is partial if f is not a field of all constructors
function accessors(t: Id, params: List[Id], constrs: List[Constr * List[Option[Id]]]): List[Cmd] :=
  let fs := fields_of(constrs) in
    [accessor(t, params, f, fields_named(f, fs), size(constrs)) for f in distinct(firsts(fs))]

function accessor(t: Id, params: List[Id], f: Id, fields: List[Id * (Name * Int * Int * Type)], n: Int): Cmd :=
  let x := Var(unqualified("x"), THole), owner := TSort(unqualified(t), [TParam(p) for p in params]) in
    CFun(
      unqualified(t ++ "." ++ f),
      params,
      [[Var(unqualified("x"), owner)]],
      field_type(fields),
      EMatch(EVar(x), [field_case(field) for field in fields] ++ (if size(fields) == n then [] else [missing_field(t, f)]))
    )

function field_type(fields: List[Id * (Name * Int * Int * Type)]): Type :=
  match fields
    case [(_, (_, _, _, t)); _] => t
    case _ => THole
  end

// case C(_, y, _) => y, where y is the field at its position
function field_case(field: Id * (Name * Int * Int * Type)): Branch[Expr] :=
  match field
    case (_, (k, i, n, _)) =>
      Branch(PApp(k, [if j == i then PVar(Var(unqualified("y"), THole)) else PWild for j in positions(n)]), None, EVar(Var(unqualified("y"), THole)))
  end

function missing_field(t: Id, f: Id): Branch[Expr] :=
  Branch(PWild, None, ERaise(EApp(EVar(Var(unqualified("MissingField"), THole)), [ELit(VStr(t ++ "." ++ f))]), THole))

// the updater T.f:= of each field f, where x with f := y is C(a0, y, a2) for x = C(a0, _, a2)
function updaters(t: Id, params: List[Id], constrs: List[Constr * List[Option[Id]]]): List[Cmd] :=
  let fs := fields_of(constrs) in
    [updater(t, params, f, fields_named(f, fs), size(constrs)) for f in distinct(firsts(fs))]

function updater(t: Id, params: List[Id], f: Id, fields: List[Id * (Name * Int * Int * Type)], n: Int): Cmd :=
  let x := Var(unqualified("x"), THole), owner := TSort(unqualified(t), [TParam(p) for p in params]) in
    CFun(
      unqualified(t ++ "." ++ f ++ ":="),
      params,
      [[Var(unqualified("x"), owner), Var(unqualified("y"), field_type(fields))]],
      owner,
      EMatch(EVar(x), [update_case(field) for field in fields] ++ (if size(fields) == n then [] else [missing_field(t, f)]))
    )

// case C(a0, _, a2) => C(a0, y, a2), where y replaces the field at its position
function update_case(field: Id * (Name * Int * Int * Type)): Branch[Expr] :=
  match field
    case (_, (k, i, n, _)) =>
      Branch(
        PApp(k, [if j == i then PWild else PVar(Var(unqualified("a" ++ show(j)), THole)) for j in positions(n)]),
        None,
        EApp(EVar(Var(k, THole)), [EVar(Var(unqualified(if j == i then "y" else "a" ++ show(j)), THole)) for j in positions(n)])
      )
  end

function positions(n: Int): List[Int] :=
  positions_from(0, n)

function positions_from(i: Int, n: Int): List[Int] :=
  if i == n then Nil else [i; positions_from(i + 1, n)]

procedure parse_function(in notations: Notations, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], xss: List[List[Var]], r: Type, body: Expr

  call   advance(ref toks)
  call   parse_name_or_symbol(out name, ref toks)
  call   parse_params(in notations, out params, ref toks)
  call   parse_repeated(in notations, params, parse_formals, lambda ts => at_punct(ts, '('), out xss, ref toks)

  call   expect(in TSym(":"), ref toks)
  call   parse_type(in notations, params, out r, ref toks)

  // a signature in an export section has no body
  if head_token(toks) == TSym(":=")
    call   advance(ref toks)
    call   parse_expr(in notations, params, out body, ref toks)
    assign cmd := CFun(unqualified(name), params, xss, r, body)
  else
    assign cmd := CFunSig(unqualified(name), params, xss, r)
  end

procedure parse_procedure(in notations: Notations, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], body: Stmt

  call   advance(ref toks)
  call   parse_name(out name, ref toks)
  call   parse_params(in notations, out params, ref toks)
  call   expect(in TPunct('('), ref toks)
  call   parse_sections(in notations, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
  call   expect(in TPunct(')'), ref toks)

  if head_token(toks) == TSym(":=")
    call   advance(ref toks)
    call   parse_body(in notations, params, out body, ref toks)
    assign cmd := CProc(unqualified(name), params, ins, outs, refs, body)
  else
    assign cmd := CProcSig(unqualified(name), params, ins, outs, refs)
  end

// the commands of one declaration, where an import is the marker CImport(n), preceded by module n at its first import
procedure parse_command(in ctx: Context, out cmds: List[Cmd], ref toks: Tokens) :=
  local notations := ctx.notations, name: Id, params: List[Id], typ: Type, cmd: Cmd, body: Stmt, xs: List[Var], offset: Int

  match head_token(toks)
    case TName("import") =>
      assign offset := head_offset(toks)
      call   advance(ref toks)
      call   parse_name(out name, ref toks)

      if contains(name, ctx.modules)
        call   check_duplicates(in notations, own_notations(ctx, name), true, offset)
        assign cmds := [CImport(name)]
      else
        call   load_module(in name, ctx, offset, out cmds)
        call   check_duplicates(in notations, cmds, true, offset)
        assign cmds := [CModule(name, declarations(cmds)), CImport(name)]
      end

    case TName(w) if contains(w, ["prefix", "postfix", "infix"]) =>
      assign offset := head_offset(toks)
      call   parse_notation(in notations, out cmd, ref toks)
      call   check_duplicates(in notations, [cmd], false, offset)
      assign cmds := [cmd]

    case TName("type") =>
      call   advance(ref toks)
      call   parse_name(out name, ref toks)
      call   parse_params(in notations, out params, ref toks)

      // an abstract type in an export section has no definition
      if head_token(toks) == TSym(":=")
        call   advance(ref toks)
        call   parse_type(in notations, params, out typ, ref toks)
        assign cmds := [CSort(unqualified(name), params, typ)]
      else
        assign cmds := [CAbstract(unqualified(name), params)]
      end

    case TName("data") =>
      call parse_data(in notations, out cmds, ref toks)

    case TName("function") =>
      call   parse_function(in notations, out cmd, ref toks)
      assign cmds := [cmd]

    case TName("procedure") =>
      call   parse_procedure(in notations, out cmd, ref toks)
      assign cmds := [cmd]

    case TName("test") =>
      call   advance(ref toks)
      call   parse_name(out name, ref toks)
      call   parse_formals(in notations, Nil, out xs, ref toks)
      call   expect(in TSym(":="), ref toks)
      call   parse_body(in notations, Nil, out body, ref toks)
      assign cmds := [CTest(name, xs, body)]

    case _ =>
      raise expected("declaration", toks)
  end

// the context after the commands cmds, where an import brings the own notations of the module
function declare_commands(ctx: Context, cmds: List[Cmd]): Context :=
  match cmds
    case Nil =>
      ctx
    case [CNotation(f, prec, ops); more] =>
      declare_commands(with_commands(ctx, [CNotation(f, prec, ops)]), more)
    case [CModule(n, ds); more] =>
      declare_commands(with_module(ctx, CModule(n, ds)), more)
    case [CImport(n); more] =>
      declare_commands(with_commands(ctx, own_notations(ctx, n)), more)
    case [_; more] =>
      declare_commands(ctx, more)
  end

// where a module is: at its imports, which come first, in its export section or its implementation section, or in a module
// without sections, whose declarations are all exported
data Section :=
  | Opening
  | InExport
  | InImplementation
  | NoSections

// notations apply to the commands after them
procedure parse_commands(out cmds: List[Cmd], ref ctx: Context, toks: Tokens) :=
  local rev: List[Cmd] := Nil, more: List[Cmd], section := Opening, offset: Int

  while head_token(toks) != TEnd
    assign offset := head_offset(toks)

    match head_token(toks)
      case TName("export") =>
        if section == InExport or section == InImplementation
          raise ParseError("a module has one export section", offset)
        else if section != Opening
          raise ParseError("export comes first, after the imports", offset)
        end

        call   advance(ref toks)
        assign more := [CExport], section := InExport

      case TName("implementation") =>
        if section != InExport
          raise ParseError("implementation follows export", offset)
        end

        call   advance(ref toks)
        assign more := [CImplementation], section := InImplementation

      case TName("import") if section == InExport or section == InImplementation =>
        raise ParseError("imports come before export", offset)

      case _ =>
        call   parse_command(in ctx, out more, ref toks)
        call   enter_section(in more, offset, ref section)
    end

    assign ctx := declare_commands(ctx, more), rev := reverse_onto(more, rev)
  end

  assign cmds := reverse(rev)

// the section after the commands of one declaration, which must belong to the section
procedure enter_section(in cmds: List[Cmd], offset: Int, ref section: Section) :=
  match (cmds, section)
    case ([CNotation(_, _, _); _], InImplementation) =>
      raise ParseError("notations belong to the export section", offset)
    case ([CFunSig(_, _, _, _); _], s) if s != InExport =>
      raise ParseError("signatures belong to the export section", offset)
    case ([CProcSig(_, _, _, _, _); _], s) if s != InExport =>
      raise ParseError("signatures belong to the export section", offset)
    case ([CAbstract(_, _); _], s) if s != InExport =>
      raise ParseError("types without a definition belong to the export section", offset)
    case ([CFun(_, _, _, _, _); _], InExport) =>
      raise ParseError("definitions belong to the implementation section", offset)
    case ([CProc(_, _, _, _, _, _); _], InExport) =>
      raise ParseError("definitions belong to the implementation section", offset)
    case ([CTest(_, _, _); _], InExport) =>
      raise ParseError("tests belong to the implementation section", offset)
    case ([CModule(_, _); _], _) =>
      skip
    case ([CImport(_); _], _) =>
      skip
    case (_, Opening) =>
      assign section := NoSections
    case _ =>
      skip
  end

// modules are files in the directory of the parsed file, or in the library
procedure module_text(in name: Id, dir: Option[Str], offset: Int, out text: Str) :=
  match dir
    case Some(d) =>
      try
        call os_read(in d ++ "/" ++ name ++ ".u", out text)
      catch
        case OsError(_) =>
          call library_text(in name, offset, out text)
      end
    case None =>
      call library_text(in name, offset, out text)
  end

procedure library_text(in name: Id, offset: Int, out text: Str) :=
  try
    call os_library(in name, out text)
  catch
    case OsError(_) =>
      raise ParseError("unknown module " ++ name, offset)
  end

// the commands of module n, parsed with the notations of the prelude and of its own imports, since imports are not transitive
procedure load_module(in name: Id, ctx: Context, offset: Int, out cmds: List[Cmd]) :=
  local text: Str, module_toks: Tokens, module_ctx: Context

  if contains(name, ctx.loading)
    raise ParseError("cyclic import of " ++ name, offset)
  end

  call   module_text(in name, ctx.dir, offset, out text)
  assign module_ctx := ctx with notations := base_notations(ctx), loading := [name; ctx.loading]

  try
    call lex(in text, out module_toks)
    call parse_commands(out cmds, ref module_ctx, module_toks)
  catch
    case LexError(m, i) =>
      raise ParseError(m ++ " in " ++ name, i)
    case ParseError(m, i) =>
      raise ParseError(m ++ " in " ++ name, i)
  end

function base_notations(ctx: Context): Notations :=
  match ctx.base
    case Some(b) => b
    case None => ctx.notations
  end

// the program text in the context ctx, e.g., after the prelude
procedure parse_text(in text: Str, ctx: Context, out program: Program) :=
  local toks: Tokens, cmds: List[Cmd], after := ctx

  try
    call lex(in text, out toks)
  catch
    case LexError(m, i) =>
      raise ParseError(m, i)
  end

  call   parse_commands(out cmds, ref after, toks)
  assign program := Program(cmds)

// the module of name, which is parsed after the prelude pre with its notations and modules, and reads modules from dir, or else the library,
// where a module that the prelude imports declares its own notations again
procedure parse_module_after(in name: Id, pre: Program, dir: Option[Str], text: Str, out program: Program) :=
  local ctx := declare_commands(empty_context(), [cmd for cmd in pre.cmds if cmd != CImport(name)])

  call parse_text(in text, ctx with loading := [name], base := Some(ctx.notations), dir := dir, out program)

// the prelude, or another module of the library parsed after the prelude, as library gives them
procedure parse_library(in name: Id, out program: Program) :=
  local text: Str, pre: Program

  call library_text(in name, 0, out text)

  if name == "prelude"
    call parse_text(in text, empty_context() with loading := ["prelude"], out program)
  else
    call parse_library(in "prelude", out pre)
    call parse_module_after(in name, pre, None, text, out program)
  end

function last_part(xs: List[Str]): Str :=
  match xs
    case [x] => x
    case [_; more] => last_part(more)
    case _ => ""
  end

// the name of a file without its directory and .u
function base_name(path: Str): Str :=
  let f := last_part(str_split(path, '/')) in
    if str_size(f) >= 2 and str_slice(f, str_size(f) - 2, str_size(f)) == ".u" then str_slice(f, 0, str_size(f) - 2) else f

function dir_name(path: Str): Str :=
  let parts := str_split(path, '/') in if size(parts) == 1 then "." else str_join("/", take(size(parts) - 1, parts))

// a file after the prelude pre, as read gives it
procedure parse_file_after(in path: Str, pre: Program, out program: Program) :=
  local text: Str

  call os_read(in path, out text)
  call parse_text_after(in path, pre, text, out program)

// text as the file at path after the prelude pre, where the prelude itself comes after the empty program
procedure parse_text_after(in path: Str, pre: Program, text: Str, out program: Program) :=
  if pre.cmds == Nil
    call parse_text(in text, empty_context() with loading := [base_name(path)], dir := Some(dir_name(path)), out program)
  else
    call parse_module_after(in base_name(path), pre, Some(dir_name(path)), text, out program)
  end

procedure parse_file(in path: Str, out program: Program) :=
  local pre: Program

  call   parse_library(in "prelude", out pre)
  call   parse_file_after(in path, pre, out program)
