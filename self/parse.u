// the parser of ulang, which parses the tokens of self/lex.u into programs of self/syntax.u,
// where notation apply to the commands after them, and imports inline the declarations of modules,
// read from the directory of the parsed file, or else from the library

import syntax
import lex
import format
import os
import set
import map

export

data ParseError :=
  | ParseError(Str, Pos)
  // an error of an imported module at its position in that module
  | ImportError(Id, Str, Pos)

function module_name(path: Str): Str

// the modules of the file at path, in load order, each after the modules it imports, with the module of the file last,
// where imports are read from the directory of the file, or else from the library, and implicit ones from the library
procedure parse_file(in path: Str, out mods: List[Mod])
procedure parse_file_text(in path: Str, text: Str, out mods: List[Mod])

// the module of text without implicit imports, which reads no files unless text imports modules
procedure parse_text(in text: Str, out own: Mod)

implementation

// the operands of types, expressions, and patterns, and how operators apply to them

function type_ops(): Ops[List[Type]] :=
  Ops("type", starts_type, parse_type_atom, type_apply)

function expr_ops(): Ops[Expr] :=
  Ops("expression", starts_expr, parse_app, expr_apply)

function pat_ops(): Ops[Pat] :=
  Ops("pattern", starts_pattern, parse_pattern_atom, pat_apply)

// notation

// an operator of the notation cmds that already has a notation of the same kind
function duplicate(notation: Notation, cmds: List[Cmd]): Option[Id] :=
  match cmds
    case Nil => None
    case [CNotation(f, _, ops); more] =>
      match [op for op in ops if notation_of(notation, f, op) != None]
        case [op; _] => Some(op)
        case Nil => duplicate(notation, more)
      end
    case [_; more] => duplicate(notation, more)
  end

// an operator of the notation of an imported module with another notation of the same kind, where imports may repeat a
// notation as it is
function redeclared(notation: Notation, imported: Notation): Option[Id] :=
  match [op for op => prec in imported.prefix_ops if differs(prefix_prec(notation, op), prec)] ++
      [op for op => prec in imported.postfix_ops if differs(postfix_prec(notation, op), prec)] ++
      [op for op => fp in imported.infix_ops if differs(infix_of(notation, op), fp)]
    case [op; _] => Some(op)
    case Nil => None
  end

function differs[A](old: Option[A], a: A): Bool :=
  old != None and old != Some(a)

procedure check_duplicates(in notation: Notation, cmds: List[Cmd], pos: Pos) :=
  match duplicate(notation, cmds)
    case Some(op) =>
      raise ParseError("operator " ++ op ++ " is already declared", pos)
    case None =>
      skip
  end

procedure check_imported(in notation: Notation, imported: Notation, pos: Pos) :=
  match redeclared(notation, imported)
    case Some(op) =>
      raise ParseError("imported operator " ++ op ++ " is declared differently", pos)
    case None =>
      skip
  end

// tokens

function head_token(toks: Tokens): Token :=
  match toks
    case [(_, tok); _] => tok
    case _ => TEnd
  end

function second_token(toks: Tokens): Token :=
  match toks
    case [_, (_, tok); _] => tok
    case _ => TEnd
  end

function head_pos(toks: Tokens): Pos :=
  match toks
    case [(p, _); _] => p
    case _ => Pos(0, 0)
  end

function at_kw(toks: Tokens, w: Str): Bool :=
  head_token(toks) == TKw(w)

function at_comma(toks: Tokens): Bool :=
  at_kw(toks, ",")

function at_bar(toks: Tokens): Bool :=
  head_token(toks) == TKw("|")

function at_mode(toks: Tokens): Bool :=
  at_kw(toks, "in") or at_kw(toks, "out") or at_kw(toks, "ref")

// a comma before another update
function at_update(toks: Tokens): Bool :=
  match toks
    case [(_, TKw(",")), (_, TName(_)), (_, TKw(":=")); _] => true
    case _ => false
  end

function format_token(tok: Token): Str :=
  match tok
    case TName(name) => name
    case TOp(s) => s
    case TKw(w) => w
    case TNum(n) => show(n)
    case TStr(s) => quote(s)
    case TChar(c) => "'" ++ str([c]) ++ "'"
    case TEnd => "end of input"
  end

// the error that what is expected but the next token is found, where a keyword is not a name
function expected(what: Str, toks: Tokens): ParseError :=
  match head_token(toks)
    case TKw(w) if is_keyword(w) and (what == "name" or what == "pattern") =>
      ParseError("keyword " ++ w ++ " is not a name", head_pos(toks))
    case tok =>
      ParseError(what ++ " expected but " ++ format_token(tok) ++ " found", head_pos(toks))
  end

// the value of a literal token
function literal_at(toks: Tokens): Option[Val] :=
  match head_token(toks)
    case TKw("true") => Some(VBool(true))
    case TKw("false") => Some(VBool(false))
    case TNum(n) => Some(VInt(n))
    case TStr(s) => Some(VStr(s))
    case TChar(c) => Some(VChar(c))
    case _ => None
  end

// an operator, or a name that the notation in effect declares as one
function operator_at(notation: Notation, toks: Tokens): Option[Id] :=
  match head_token(toks)
    case TOp(s) => Some(s)
    case TName(name) if is_operator(notation, name) => Some(name)
    case _ => None
  end

procedure advance(ref toks: Tokens) :=
  match toks
    case [_; more] =>
      assign toks := more
    case _ =>
      skip
  end

procedure expect(in tok: Token, ref toks: Tokens) :=
  if head_token(toks) == tok
    call advance(ref toks)
  else
    raise expected(format_token(tok), toks)
  end

procedure parse_name(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TName(m) =>
      assign name := m
      call   advance(ref toks)
    case _ =>
      raise expected("name", toks)
  end

// a name that is not declared as an operator
procedure parse_plain_name(in notation: Notation, params: List[Id], out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TName(m) if is_operator(notation, m) =>
      raise ParseError("operator " ++ m ++ " is not a name", head_pos(toks))
    case _ =>
      call parse_name(out name, ref toks)
  end

// a name or an operator
procedure parse_name_or_op(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TOp(s) =>
      assign name := s
      call   advance(ref toks)
    case _ =>
      call parse_name(out name, ref toks)
  end

// lists, whose items are parsed by procedures, as are those of sections

// items, at least one, separated by the tokens that more finds
procedure parse_separated[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, rev: List[A]

  call   item(in notation, params, out x, ref toks)
  assign rev := [x]

  while more(toks)
    call   advance(ref toks)
    call   item(in notation, params, out x, ref toks)
    assign rev := [x; rev]
  end

  assign xs := reverse(rev)

// items, at least one, without separators, as long as more holds
procedure parse_repeated[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, rev: List[A]

  call   item(in notation, params, out x, ref toks)
  assign rev := [x]

  while more(toks)
    call   item(in notation, params, out x, ref toks)
    assign rev := [x; rev]
  end

  assign xs := reverse(rev)

// items separated by commas until close, which may be empty
procedure parse_enclosed[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
      close: Str,
  out xs: List[A],
  ref toks: Tokens
) :=
  if at_kw(toks, close)
    assign xs := Nil
  else
    call parse_separated(in notation, params, item, at_comma, out xs, ref toks)
  end

  call expect(in TKw(close), ref toks)

// an item after tok, if tok is next
procedure parse_optional[A](
  in  notation: Notation,
      params: List[Id],
      tok: Token,
      item: (in Notation, List[Id], out A, ref Tokens),
  out x: Option[A],
  ref toks: Tokens
) :=
  local a: A

  if head_token(toks) == tok
    call   advance(ref toks)
    call   item(in notation, params, out a, ref toks)
    assign x := Some(a)
  else
    assign x := None
  end

function or_default[A](x: Option[A], default: A): A :=
  match x
    case Some(a) => a
    case None => default
  end

// the items a, b of a display [a, b], and the rest c of [a, b; c], read with brackets
procedure parse_display[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
  out items: List[A],
      rest: Option[A],
  ref toks: Tokens
) :=
  call parse_separated(in notation, params, item, at_comma, out items, ref toks)
  call parse_optional(in notation, params, TKw(";"), item, out rest, ref toks)

// the items in front of rest by cons, as displays build lists
function cons_all[A](cons: (A, A) -> A, items: List[A], rest: A): A :=
  match items
    case Nil => rest
    case [a; more] => cons(a, cons_all(cons, more, rest))
  end

// precedence climbing over the tokens, as Mixfix of easyparse in cuvee, where prefix operators bind their operand
// with their own precedence, and a left associative operator is applied to all operands of a chain at once

// what an operand is called in errors, where it starts, how it is parsed, and how operators apply to operands,
// to the one of a prefix or postfix operator, and to the two or more of an infix operator
data Ops[A] :=
  | Ops(
    what: Str,
    starts: (Notation, Token) -> Bool,
    operand: (in Notation, List[Id], out A, ref Tokens),
    apply: (Fixity, Id, Pos, List[A]) -> A
  )

// operands and operators, where an operator that cannot be applied is an error
procedure parse_operators[A](in notation: Notation, params: List[Id], ops: Ops[A], out a: A, ref toks: Tokens) :=
  call climb(in notation, params, ops, 0, out a, ref toks)

  match operator_at(notation, toks)
    case Some(op) =>
      raise ParseError("unexpected operator " ++ op, head_pos(toks))
    case None =>
      skip
  end

// an operand and the operators after it of precedence min or above
procedure climb[A](in notation: Notation, params: List[Id], ops: Ops[A], min: Int, out a: A, ref toks: Tokens) :=
  local lhs: A

  call climb_operand(in notation, params, ops, out lhs, ref toks)
  call climb_rest(in notation, params, ops, min, lhs, out a, ref toks)

// an operand, or a prefix operator applied to an operand
procedure climb_operand[A](in notation: Notation, params: List[Id], ops: Ops[A], out a: A, ref toks: Tokens) :=
  local pos := head_pos(toks), operand := ops.operand, b: A

  match operator_at(notation, toks)
    case Some(op) =>
      match prefix_prec(notation, op)
        case Some(prec) =>
          call   advance(ref toks)
          call   climb(in notation, params, ops, prec, out b, ref toks)
          assign a := ops.apply(FPrefix, op, pos, [b])
        case None if is_operator(notation, op) =>
          raise ParseError(op ++ " is not a prefix operator", pos)
        case None =>
          raise ParseError("undeclared operator " ++ op, pos)
      end
    case None if ops.starts(notation, head_token(toks)) =>
      call operand(in notation, params, out a, ref toks)
    case None =>
      raise expected(ops.what, toks)
  end

// lhs and the operators after it of precedence min or above
procedure climb_rest[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      min: Int,
      lhs: A,
  out a: A,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), args: List[A]

  match operator_at(notation, toks)
    case Some(op) =>
      match (postfix_prec(notation, op), infix_of(notation, op))
        case (Some(prec), _) if prec >= min =>
          call advance(ref toks)
          call climb_rest(in notation, params, ops, min, ops.apply(FPostfix, op, pos, [lhs]), out a, ref toks)

        case (_, Some((f, prec))) if prec >= min =>
          call advance(ref toks)
          call climb_infix(in notation, params, ops, op, f, prec, out args, ref toks)
          call climb_rest(in notation, params, ops, min, ops.apply(f, op, pos, [lhs; args]), out a, ref toks)

        case _ if not is_operator(notation, op) =>
          raise ParseError("undeclared operator " ++ op, pos)

        case _ =>
          assign a := lhs
      end
    case None =>
      assign a := lhs
  end

// the operands after the infix operator op, where a right associative op takes the operators of its own precedence,
// a left associative op takes further operands after more occurrences of op, and a non-associative op only one
procedure climb_infix[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      op: Id,
      f: Fixity,
      prec: Int,
  out args: List[A],
  ref toks: Tokens
) :=
  local next := if f == FRight then prec else prec + 1

  call parse_separated(
    in notation, params,
      lambda in ns, params, out b, ref ts => call climb(in ns, params, ops, next, out b, ref ts) end,
      lambda ts => f == FLeft and operator_at(notation, ts) == Some(op),
    out args,
    ref toks
  )

  match operator_at(notation, toks)
    case Some(other) if f == FInfix and is_prec(infix_of(notation, other), prec) =>
      raise ParseError("operator " ++ op ++ " is not associative", head_pos(toks))
    case _ =>
      skip
  end

function is_prec(fp: Option[Fixity * Int], prec: Int): Bool :=
  match fp
    case Some((_, q)) => q == prec
    case _ => false
  end

// types, whose operands are lists of types, since the arguments of a function are written (A, B),
// and where a chain A * B * C is one tuple type, while (A * B) * C stays nested

// the type of an operand, which is a list of other than one type only as the arguments of a function
function as_type(types: List[Type], pos: Pos): Type :=
  match types
    case [typ] => typ
    case Nil => TTuple(Nil)
    case _ => raise ParseError("tuple types are written A * B", pos)
  end

function type_apply(f: Fixity, op: Id, pos: Pos, args: List[List[Type]]): List[Type] :=
  match args
    case [a] => [TSort(unqualified(op), [as_type(a, pos)])]
    case _ if op == "*" => [TTuple([as_type(a, pos) for a in args])]
    case [a; more] => type_infix(op, pos, a, more)
    case Nil => Nil
  end

// lhs and the operands rs, applied from the left
function type_infix(op: Id, pos: Pos, lhs: List[Type], rs: List[List[Type]]): List[Type] :=
  match rs
    case Nil => lhs
    case [r; more] if op == "->" => type_infix(op, pos, [TFun(lhs, as_type(r, pos))], more)
    case [r; more] => type_infix(op, pos, [TSort(unqualified(op), [as_type(lhs, pos), as_type(r, pos)])], more)
  end

function starts_type(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) => not is_operator(notation, name)
    case TKw("(") => true
    case _ => false
  end

procedure parse_type(in notation: Notation, params: List[Id], out typ: Type, ref toks: Tokens) :=
  local start := head_pos(toks), r: List[Type]

  call   parse_operators(in notation, params, type_ops(), out r, ref toks)
  assign typ := as_type(r, start)

// a type, a type in parentheses, the arguments (A, B) of a function, or (), where params are the type parameters in scope,
// which distinguish TParam from TSort
procedure parse_type_atom(in notation: Notation, params: List[Id], out r: List[Type], ref toks: Tokens) :=
  local name: Id, args: List[Type], ins: List[Type], outs: List[Type], refs: List[Type]

  if at_kw(toks, "(") and contains(second_token(toks), [TKw("in"), TKw("out"), TKw("ref")])
    call   advance(ref toks)
    call   parse_sections(in notation, params, parse_type, parse_type, out ins, outs, refs, ref toks)
    call   expect(in TKw(")"), ref toks)
    assign r := [TProc(ins, outs, refs)]
  else if at_kw(toks, "(")
    call advance(ref toks)
    call parse_enclosed(in notation, params, parse_type, ")", out r, ref toks)
  else
    call parse_plain_name(in notation, params, out name, ref toks)

    if at_kw(toks, "[")
      call   advance(ref toks)
      call   parse_separated(in notation, params, parse_type, at_comma, out args, ref toks)
      call   expect(in TKw("]"), ref toks)
      assign r := [TSort(unqualified(name), args)]
    else if contains(name, params)
      assign r := [TParam(name)]
    else
      assign r := [TSort(unqualified(name), Nil)]
    end
  end

// expressions

// -n for a number n is the negative literal, in patterns and expressions, and otherwise an operator is applied
function expr_apply(f: Fixity, op: Id, pos: Pos, args: List[Expr]): Expr :=
  match args
    case [ELit(VInt(n))] if f == FPrefix and op == "-" => ELit(VInt(0 - n))
    case [a] => expr_app(op, [a])
    case [a; more] => expr_infix(op, a, more)
    case Nil => expr_app(op, Nil)
  end

// lhs and the operands rs, applied from the left
function expr_infix(op: Id, lhs: Expr, rs: List[Expr]): Expr :=
  match rs
    case Nil => lhs
    case [r; more] => expr_infix(op, expr_app(op, [lhs, r]), more)
  end

function expr_cons(a: Expr, b: Expr): Expr :=
  expr_app("Cons", [a, b])

function starts_expr(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) => not is_operator(notation, name)
    case TKw(w) => contains(w, ["let", "if", "lambda", "match", "true", "false", "(", "[", "{", "|"])
    case TNum(_) => true
    case TStr(_) => true
    case TChar(_) => true
    case _ => false
  end

// raise e is a whole expression, not an operand, such that a statement raise after an expression starts a statement
procedure parse_expr(in notation: Notation, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local updates: List[Id * Expr]

  if at_kw(toks, "raise")
    call   advance(ref toks)
    call   parse_expr(in notation, params, out expr, ref toks)
    assign expr := ERaise(expr, THole)
  else
    call parse_operators(in notation, params, expr_ops(), out expr, ref toks)

    if at_kw(toks, "with")
      call   advance(ref toks)
      call   parse_separated(in notation, params, parse_update, at_update, out updates, ref toks)
      assign expr := apply_updates(expr, updates)
    end
  end

// f := a in e with f := a
procedure parse_update(in notation: Notation, params: List[Id], out update: Id * Expr, ref toks: Tokens) :=
  local f: Id, a: Expr

  call   parse_name(out f, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_operators(in notation, params, expr_ops(), out a, ref toks)
  assign update := (f, a)

// e with the updates in order, each of which applies the updater T.f:= to e and a, as the checker resolves it by the type of e
function apply_updates(expr: Expr, updates: List[Id * Expr]): Expr :=
  match updates
    case Nil => expr
    case [(f, a); more] => apply_updates(expr_app("." ++ f ++ ":=", [expr, a]), more)
  end

// f(x) and e.f, which reads the field f of e, as the checker resolves it by the type of e
procedure parse_app(in notation: Notation, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local args: List[Expr], f: Id

  call parse_expr_atom(in notation, params, out expr, ref toks)

  while at_kw(toks, "(") or at_kw(toks, ".")
    if at_kw(toks, "(")
      call   advance(ref toks)
      call   parse_enclosed(in notation, params, parse_expr, ")", out args, ref toks)
      assign expr := EApp(expr, args)
    else
      call   advance(ref toks)
      call   parse_name(out f, ref toks)
      assign expr := expr_app("." ++ f, [expr])
    end
  end

procedure parse_expr_atom(in notation: Notation, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local a: Expr, l: Expr, r: Expr, cases: List[Branch[Expr]], exprs: List[Expr]

  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign expr := ELit(v)

    case (_, TKw("let")) =>
      call parse_let(in notation, params, out expr, ref toks)

    case (_, TKw("if")) =>
      call   advance(ref toks)
      call   parse_expr(in notation, params, out a, ref toks)
      call   expect(in TKw("then"), ref toks)
      call   parse_expr(in notation, params, out l, ref toks)
      call   expect(in TKw("else"), ref toks)
      call   parse_expr(in notation, params, out r, ref toks)
      assign expr := EIte(a, l, r)

    case (_, TKw("lambda")) =>
      call parse_lambda(in notation, params, out expr, ref toks)

    case (_, TKw("match")) =>
      call   advance(ref toks)
      call   parse_expr(in notation, params, out a, ref toks)
      call   parse_cases(in notation, params, parse_expr, out cases, ref toks)
      assign expr := EMatch(a, cases)

    case (_, TKw("(")) =>
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_expr, ")", out exprs, ref toks)
      match exprs
        case [inner] =>
          assign expr := inner
        case _ =>
          assign expr := ETuple(exprs)
      end

    case (_, TKw("[")) =>
      call parse_list(in notation, params, "]", out expr, ref toks)

    // |a, b| and |e for x in c if q| are the arrays of the elements of the list or the comprehension, where a | that starts
    // an operand opens an array and a | after an operand closes it, | |1|, |2| |
    case (_, TKw("|")) =>
      call   parse_list(in notation, params, "|", out a, ref toks)
      assign expr := declared_app("array", [a])

    case (_, TKw("{")) =>
      call parse_set_or_map(in notation, params, out expr, ref toks)

    case (_, TName(name)) if not is_operator(notation, name) =>
      call   advance(ref toks)
      assign expr := expr_var(name)

    case _ =>
      raise expected("expression", toks)
  end

// the variables of patterns that are all variables
function pattern_vars(pats: List[Pat]): Option[List[Var]] :=
  match pats
    case Nil => Some(Nil)
    case [PVar(x); more] =>
      match pattern_vars(more)
        case Some(xs) => Some([x; xs])
        case None => None
      end
    case _ => None
  end

// let x := e, y := f in body binds variables in parallel, other patterns are matched against the tuple of values
procedure parse_let(in notation: Notation, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local bindings: List[Pat * Expr], body: Expr, pats: List[Pat], exprs: List[Expr]

  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_binding, at_comma, out bindings, ref toks)
  call   expect(in TKw("in"), ref toks)
  call   parse_expr(in notation, params, out body, ref toks)
  assign pats := firsts(bindings), exprs := seconds(bindings)

  match (pattern_vars(pats), pats, exprs)
    case (Some(xs), _, _) =>
      assign expr := ELet(zip(xs, exprs), body)
    case (None, [pat], [c]) =>
      assign expr := EMatch(c, [Branch(pat, None, body)])
    case _ =>
      assign expr := EMatch(ETuple(exprs), [Branch(PTuple(pats), None, body)])
  end

// p := e
procedure parse_binding(in notation: Notation, params: List[Id], out binding: Pat * Expr, ref toks: Tokens) :=
  local pat: Pat, expr: Expr

  call   parse_pattern(in notation, params, out pat, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_expr(in notation, params, out expr, ref toks)
  assign binding := (pat, expr)

// lambda x, y => e is a function, and lambda in x, out y, ref z => body end a procedure, told apart by the modes
procedure parse_lambda(in notation: Notation, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local ins: List[Var], outs: List[Var], refs: List[Var], body: Stmt, xs: List[Var], inner: Expr

  call advance(ref toks)

  if at_mode(toks)
    call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   parse_body(in notation, params, out body, ref toks)
    call   expect(in TKw("end"), ref toks)
    assign expr := EProc(ins, outs, refs, body)
  else if head_token(toks) == TKw("=>")
    call   expect(in TKw("=>"), ref toks)
    call   parse_expr(in notation, params, out inner, ref toks)
    assign expr := ELam(Nil, inner)
  else
    call   parse_separated(in notation, params, parse_variable, at_comma, out xs, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   parse_expr(in notation, params, out inner, ref toks)
    assign expr := ELam(xs, inner)
  end

// a literal is the fold of its elements unrolled, {a, b} the set insert(a, insert(b, empty())) and {k => v, l => w} the map
// put(l, w, put(k, v, empty())), where the last entry of a key counts, by insert, put, and empty of the imported modules,
// which are set and map, and {e for x in c if q} and {k => v for k1 => v1 in m if q} are their comprehensions, while {} is
// empty() of the module that its type determines
procedure parse_set_or_map(in notation: Notation, params: List[Id], out expr: Expr, ref toks: Tokens) :=
  local pos := head_pos(toks)

  call advance(ref toks)

  if at_kw(toks, "}")
    assign expr := declared_app("empty", [])
  else
    call parse_set_or_map_elements(in notation, params, pos, out expr, ref toks)
  end

  call expect(in TKw("}"), ref toks)

// the elements or entries of a literal, or its comprehension, after {, where {a, b; s} adds a and b to s, and
// {k => v; m} puts k => v into m
procedure parse_set_or_map_elements(
  in  notation: Notation,
      params: List[Id],
      pos: Pos,
  out expr: Expr,
  ref toks: Tokens
) :=
  local elements: List[Expr * Option[Expr]], rest: Option[Expr * Option[Expr]]

  call   parse_display(in notation, params, parse_element, out elements, rest, ref toks)

  match (elements, rest)
    case (_, Some((_, Some(_)))) =>
      raise ParseError("the rest of a literal {...} after ; is a set or a map, not an entry", pos)

    case ([(k, Some(v))], None) if at_kw(toks, "for") =>
      call parse_comprehension(
        in notation, params,
          "foldl", declared_app("empty", []), declared_app("put", [k, v, EVar(acc_var())]),
        out expr,
        ref toks
      )

    case ([(k, None)], None) if at_kw(toks, "for") =>
      call parse_comprehension(
        in notation, params,
          "foldr", declared_app("empty", []), declared_app("insert", [k, EVar(acc_var())]),
        out expr,
        ref toks
      )

    case _ =>
      match split_elements(elements)
        case ([_; _], [_; _]) =>
          raise ParseError("a literal {...} has either elements a or entries k => v", pos)
        case (Nil, pairs) =>
          assign expr := foldl(pairs, rest_of(rest), put_entry)
        case (xs, _) =>
          assign expr := foldr(xs, rest_of(rest), lambda a, s => declared_app("insert", [a, s]))
      end
  end

// the set or map after ; that the elements or entries are added to, or else the empty one
function rest_of(rest: Option[Expr * Option[Expr]]): Expr :=
  match rest
    case Some((r, _)) => r
    case None => declared_app("empty", [])
  end

// an element a, or an entry k => v
procedure parse_element(
  in  notation: Notation,
      params: List[Id],
  out element: Expr * Option[Expr],
  ref toks: Tokens
) :=
  local k: Expr, v: Option[Expr]

  call   parse_expr(in notation, params, out k, ref toks)
  call   parse_optional(in notation, params, TKw("=>"), parse_expr, out v, ref toks)
  assign element := (k, v)

// the elements a and the entries k => v, each in their order
function split_elements(elements: List[Expr * Option[Expr]]): List[Expr] * List[Expr * Expr] :=
  match elements
    case Nil =>
      (Nil, Nil)
    case [(a, None); more] =>
      match split_elements(more)
        case (xs, pairs) => ([a; xs], pairs)
      end
    case [(k, Some(v)); more] =>
      match split_elements(more)
        case (xs, pairs) => (xs, [(k, v); pairs])
      end
  end

// m with the entry k => v put into it
function put_entry(m: Expr, pair: Expr * Expr): Expr :=
  match pair
    case (k, v) => declared_app("put", [k, v, m])
  end

function nil_expr(): Expr :=
  expr_var("Nil")

// comprehensions are folds over the containers of their generators, by the foldr or foldl of the module of each container,
// whose functions put the result into the accumulator, nested for several generators, where each generator sees the variables
// of those before it

// a name of a declaration that a translation introduces, which locals do not hide, see overloads of self/check.u,
// and which resolves through the imports of the module
function declared(f: Id): Expr :=
  EVar(Var(Name(Some("*"), f), THole))

function declared_app(f: Id, args: List[Expr]): Expr :=
  EApp(declared(f), args)

// the accumulator of the folds of comprehensions, which users cannot name
function acc_var(): Var :=
  Var(unqualified("(acc)"), THole)

// the folds of the generators, each the variables it binds and its container, into init, where add puts the result into the
// accumulator if the condition holds, by foldr, whose functions take the accumulator last, or foldl, which takes it first
function comprehension_folds(
  fold: Id,
  generators: List[List[Var] * Expr],
  init: Expr,
  add: Expr,
  cond: Option[Expr]
): Expr :=
  match generators
    case Nil =>
      match cond
        case Some(c) => EIte(c, add, EVar(acc_var()))
        case None => add
      end
    case [(xs, c); more] =>
      let inner := comprehension_folds(fold, more, EVar(acc_var()), add, cond) in
        EApp(declared(fold), [c, init, ELam(if fold == "foldr" then xs ++ [acc_var()] else [acc_var(); xs], inner)])
  end

// the generators and the condition after for, as folds by fold into init, where add puts the result into the accumulator:
// a list by foldr and Cons, a set by foldr and insert, in any order, and a map by foldl and put in the order of the
// generators, so that the last entry of a key counts, as in a literal
procedure parse_comprehension(
  in  notation: Notation,
      params: List[Id],
      fold: Id,
      init: Expr,
      add: Expr,
  out expr: Expr,
  ref toks: Tokens
) :=
  local generators: List[List[Var] * Expr], cond: Option[Expr]

  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_generator, at_comma, out generators, ref toks)
  call   parse_optional(in notation, params, TKw("if"), parse_expr, out cond, ref toks)
  assign expr := comprehension_folds(fold, generators, init, add, cond)

// x in c over a list or set, or k => v in m over a map, whose fold takes the key and value as two arguments
procedure parse_generator(
  in  notation: Notation,
      params: List[Id],
  out generator: List[Var] * Expr,
  ref toks: Tokens
) :=
  local x: Var, y: Option[Var], c: Expr

  call   parse_variable(in notation, params, out x, ref toks)
  call   parse_optional(in notation, params, TKw("=>"), parse_variable, out y, ref toks)
  call   expect(in TKw("in"), ref toks)
  call   parse_expr(in notation, params, out c, ref toks)
  assign generator := ([x; option_list(y)], c)

function option_list[A](o: Option[A]): List[A] :=
  match o
    case Some(a) => [a]
    case None => Nil
  end

// the | after the | that opens an array opens an element, ||1|, |2||, if an operand other than | starts after it, and else
// closes an empty array, ||, so that an array whose first element starts with | needs parentheses, |(||)|
function opens_inner(notation: Notation, toks: Tokens): Bool :=
  second_token(toks) != TKw("|") and starts_expr(notation, second_token(toks))

// [a, b] is a :: b :: Nil, [a, b; c] is a :: b :: c, and [result for x in xs, y in ys if test], where if test is optional,
// up to close, which is ] of a list and | of an array, which has no rest
procedure parse_list(in notation: Notation, params: List[Id], close: Str, out expr: Expr, ref toks: Tokens) :=
  local exprs: List[Expr], rest: Option[Expr]

  call advance(ref toks)

  if at_kw(toks, close) and not (close == "|" and opens_inner(notation, toks))
    assign expr := nil_expr()
  else
    call parse_display(in notation, params, parse_expr, out exprs, rest, ref toks)

    match (exprs, rest)
      case ([first], None) if at_kw(toks, "for") =>
        call parse_comprehension(in notation, params, "foldr", nil_expr(), expr_cons(first, EVar(acc_var())), out expr, ref toks)

      case (_, Some(_)) if close == "|" =>
        raise ParseError("arrays have no rest", head_pos(toks))

      case _ =>
        assign expr := cons_all(expr_cons, exprs, or_default(rest, nil_expr()))
    end
  end

  call expect(in TKw(close), ref toks)

// case p if g => b, up to end
procedure parse_cases[B](
  in  notation: Notation,
      params: List[Id],
      body: (in Notation, List[Id], out B, ref Tokens),
  out cases: List[Branch[B]],
  ref toks: Tokens
) :=
  local rev: List[Branch[B]] := Nil, pat: Pat, g: Option[Expr], b: B

  while at_kw(toks, "case")
    call   advance(ref toks)
    call   parse_pattern(in notation, params, out pat, ref toks)
    call   parse_optional(in notation, params, TKw("if"), parse_expr, out g, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   body(in notation, params, out b, ref toks)
    assign rev := [Branch(pat, g, b); rev]
  end

  call   expect(in TKw("end"), ref toks)
  assign cases := reverse(rev)

// patterns, where operators are constructors

function pat_apply(f: Fixity, op: Id, pos: Pos, args: List[Pat]): Pat :=
  match args
    case [PLit(VInt(n))] if f == FPrefix and op == "-" => PLit(VInt(0 - n))
    case [pat] => PApp(unqualified(op), [pat])
    case [pat; more] => pat_infix(op, pat, more)
    case Nil => PApp(unqualified(op), Nil)
  end

// lhs and the operands rs, applied from the left
function pat_infix(op: Id, lhs: Pat, rs: List[Pat]): Pat :=
  match rs
    case Nil => lhs
    case [r; more] => pat_infix(op, PApp(unqualified(op), [lhs, r]), more)
  end

function pat_cons(a: Pat, b: Pat): Pat :=
  PApp(unqualified("Cons"), [a, b])

function pat_nil(): Pat :=
  PApp(unqualified("Nil"), Nil)

function starts_pattern(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) => not is_operator(notation, name)
    case TKw(w) => contains(w, ["_", "true", "false", "(", "["])
    case TNum(_) => true
    case TStr(_) => true
    case TChar(_) => true
    case _ => false
  end

procedure parse_pattern(in notation: Notation, params: List[Id], out pat: Pat, ref toks: Tokens) :=
  call parse_operators(in notation, params, pat_ops(), out pat, ref toks)

procedure parse_pattern_atom(in notation: Notation, params: List[Id], out pat: Pat, ref toks: Tokens) :=
  local name: Id, pats: List[Pat], rest: Option[Pat]

  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign pat := PLit(v)

    case (_, TKw("_")) =>
      call   advance(ref toks)
      assign pat := PWild

    case (_, TKw("(")) =>
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_pattern, ")", out pats, ref toks)
      match pats
        case [inner] =>
          assign pat := inner
        case _ =>
          assign pat := PTuple(pats)
      end

    case (_, TKw("[")) =>
      call advance(ref toks)

      if at_kw(toks, "]")
        assign pat := pat_nil()
      else
        call   parse_display(in notation, params, parse_pattern, out pats, rest, ref toks)
        assign pat := cons_all(pat_cons, pats, or_default(rest, pat_nil()))
      end

      call expect(in TKw("]"), ref toks)

    case _ =>
      call parse_plain_name(in notation, params, out name, ref toks)

      if at_kw(toks, "(")
        call   advance(ref toks)
        call   parse_enclosed(in notation, params, parse_pattern, ")", out pats, ref toks)
        assign pat := PApp(unqualified(name), pats)
      else
        assign pat := pat_var(name)
      end
  end

// statements

function starts_stmt(tok: Token): Bool :=
  match tok
    case TKw(w) => contains(w, ["skip", "if", "while", "call", "match", "assert", "assign", "raise", "try"])
    case _ => false
  end

function handlers(cases: List[Branch[Stmt]]): List[Handler] :=
  match cases
    case Nil => Nil
    case [Branch(pat, g, b); more] => [Handler(THole, pat, g, b); handlers(more)]
  end

// the body of an if, while, case, or procedure, which may declare variables first
// where local x := e initializes x by an assignment at the start of the block, in order, such that its type can be inferred
procedure parse_body(in notation: Notation, params: List[Id], out body: Stmt, ref toks: Tokens) :=
  local xs: List[Var] := Nil, inits: List[Stmt] := Nil, decls: List[Var * List[Stmt]], rev: List[Stmt] := Nil, s: Stmt

  while at_kw(toks, "local")
    call   advance(ref toks)
    call   parse_separated(in notation, params, parse_local, at_comma, out decls, ref toks)
    assign xs := xs ++ firsts(decls), inits := inits ++ concat(seconds(decls))
  end

  while starts_stmt(head_token(toks))
    call   parse_stmt(in notation, params, out s, ref toks)
    assign rev := [s; rev]
  end

  assign body := SBlock(xs, inits ++ reverse(rev))

// x: T, x := e, or x: T := e, where the checker requires a type or an initial value
procedure parse_local(in notation: Notation, params: List[Id], out decl: Var * List[Stmt], ref toks: Tokens) :=
  local x: Var, init: Option[Expr]

  call parse_formal(in notation, params, out x, ref toks)
  call parse_optional(in notation, params, TKw(":="), parse_expr, out init, ref toks)

  match init
    case Some(expr) =>
      assign decl := (x, [SAssign([(Var(x.name, THole), expr)])])
    case None =>
      assign decl := (x, Nil)
  end

procedure parse_stmt(in notation: Notation, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local expr: Expr, body: Stmt, cases: List[Branch[Stmt]]

  match head_token(toks)
    case TKw("skip") =>
      call   advance(ref toks)
      assign s := SSkip

    case TKw("if") =>
      call parse_if(in notation, params, out s, ref toks)

    case TKw("while") =>
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   parse_body(in notation, params, out body, ref toks)
      call   expect(in TKw("end"), ref toks)
      assign s := SWhile(expr, body)

    case TKw("call") =>
      call parse_call(in notation, params, out s, ref toks)

    case TKw("match") =>
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   parse_cases(in notation, params, parse_body, out cases, ref toks)
      assign s := SMatch(expr, cases)

    case TKw("assert") =>
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      assign s := SAssert(expr)

    case TKw("assign") =>
      call parse_assign(in notation, params, out s, ref toks)

    case TKw("raise") =>
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      assign s := SRaise(expr, THole)

    case TKw("try") =>
      call   advance(ref toks)
      call   parse_body(in notation, params, out body, ref toks)
      call   expect(in TKw("catch"), ref toks)
      call   parse_cases(in notation, params, parse_body, out cases, ref toks)
      assign s := STry(body, handlers(cases))

    case _ =>
      raise expected("statement", toks)
  end

// the bodies start with a keyword, which ends the condition, and an if after else ends the whole chain
procedure parse_if(in notation: Notation, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local cond: Expr, l: Stmt, r: Stmt

  call   advance(ref toks)
  call   parse_expr(in notation, params, out cond, ref toks)
  call   parse_body(in notation, params, out l, ref toks)

  if not at_kw(toks, "else")
    call   expect(in TKw("end"), ref toks)
    assign r := SSkip
  else if second_token(toks) == TKw("if")
    call advance(ref toks)
    call parse_if(in notation, params, out r, ref toks)
  else
    call advance(ref toks)
    call parse_body(in notation, params, out r, ref toks)
    call expect(in TKw("end"), ref toks)
  end

  assign s := SIf(cond, l, r)

procedure parse_assign(in notation: Notation, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local assignments: List[Var * Expr]

  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_assignment, at_comma, out assignments, ref toks)
  assign s := SAssign(assignments)

// x := e
procedure parse_assignment(in notation: Notation, params: List[Id], out assignment: Var * Expr, ref toks: Tokens) :=
  local x: Var, expr: Expr

  call   parse_variable(in notation, params, out x, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_expr(in notation, params, out expr, ref toks)
  assign assignment := (x, expr)

// the next section starts with keyword w, after a comma unless it is the first section
function section_starts(toks: Tokens, w: Str, first: Bool): Bool :=
  if first then at_kw(toks, w) else at_kw(toks, ",") and second_token(toks) == TKw(w)

// a comma before another item of a section, not before the keyword of the next section
function section_continues(toks: Tokens): Bool :=
  at_kw(toks, ",") and second_token(toks) != TKw("out") and second_token(toks) != TKw("ref")

// call p(in ins, out outs, ref refs)
procedure parse_call(in notation: Notation, params: List[Id], out s: Stmt, ref toks: Tokens) :=
  local p: Id, ins: List[Expr], outs: List[Var], refs: List[Var]

  call   advance(ref toks)
  call   parse_name(out p, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_expr, parse_variable, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  assign s := SCall(unqualified(p), ins, outs, refs)

// in ins, out outs, ref refs of calls, declarations, lambdas, and types, where each section starts with its keyword,
// and empty sections are omitted
procedure parse_sections[A, B](
  in  notation: Notation,
      params: List[Id],
      item_in: (in Notation, List[Id], out A, ref Tokens),
      item: (in Notation, List[Id], out B, ref Tokens),
  out ins: List[A],
      outs: List[B],
      refs: List[B],
  ref toks: Tokens
) :=
  local first := true

  assign ins := Nil, outs := Nil, refs := Nil

  if at_kw(toks, "in")
    call   advance(ref toks)
    call   parse_separated(in notation, params, item_in, section_continues, out ins, ref toks)
    assign first := false
  end

  if section_starts(toks, "out", first)
    call   skip_section_start(in first, ref toks)
    call   parse_separated(in notation, params, item, section_continues, out outs, ref toks)
    assign first := false
  end

  if section_starts(toks, "ref", first)
    call skip_section_start(in first, ref toks)
    call parse_separated(in notation, params, item, section_continues, out refs, ref toks)
  end

// the comma before a section unless it is the first, and the keyword of the section
procedure skip_section_start(in first: Bool, ref toks: Tokens) :=
  if not first
    call advance(ref toks)
  end

  call advance(ref toks)

procedure parse_variable(in notation: Notation, params: List[Id], out x: Var, ref toks: Tokens) :=
  local name: Id

  call   parse_plain_name(in notation, params, out name, ref toks)
  assign x := Var(unqualified(name), THole)

// only parameters and locals have type annotations
procedure parse_formal(in notation: Notation, params: List[Id], out x: Var, ref toks: Tokens) :=
  local name: Id, typ: Option[Type]

  call   parse_plain_name(in notation, params, out name, ref toks)
  call   parse_optional(in notation, params, TKw(":"), parse_type, out typ, ref toks)
  assign x := Var(unqualified(name), or_default(typ, THole))

// formals in parentheses, which may be empty
procedure parse_formals(in notation: Notation, params: List[Id], out xs: List[Var], ref toks: Tokens) :=
  call expect(in TKw("("), ref toks)
  call parse_enclosed(in notation, params, parse_formal, ")", out xs, ref toks)

// commands

// the module d without its tests, as an import loads it
function without_tests_of(d: Mod): Mod :=
  d with implemented := untested(d.implemented)

function untested(cmds: List[Pos * Cmd]): List[Pos * Cmd] :=
  match cmds
    case Nil => Nil
    case [(_, CTest(_, _, _)); more] => untested(more)
    case [c; more] => [c; untested(more)]
  end

// the type parameters [A, B] of a declaration, if any
procedure parse_params(in notation: Notation, out params: List[Id], ref toks: Tokens) :=
  if at_kw(toks, "[")
    call advance(ref toks)
    call parse_separated(in notation, Nil, parse_param, at_comma, out params, ref toks)
    call expect(in TKw("]"), ref toks)
  else
    assign params := Nil
  end

procedure parse_param(in notation: Notation, params: List[Id], out name: Id, ref toks: Tokens) :=
  call parse_name(out name, ref toks)

procedure parse_notation(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local f := FInfix, prec: Int, ops: List[Id]

  match head_token(toks)
    case TKw("prefix") =>
      assign f := FPrefix
    case TKw("postfix") =>
      assign f := FPostfix
    case _ =>
      match second_token(toks)
        case TName("left") =>
          assign f := FLeft
          call   advance(ref toks)
        case TName("right") =>
          assign f := FRight
          call   advance(ref toks)
        case _ =>
          skip
      end
  end
  call advance(ref toks)

  match head_token(toks)
    case TNum(n) =>
      assign prec := n
      call   advance(ref toks)
    case _ =>
      raise expected("precedence", toks)
  end

  call   parse_repeated(in notation, Nil, parse_operator, at_operator, out ops, ref toks)
  assign cmd := CNotation(f, prec, ops)

// an operator or a name, as operators are declared
function at_operator(toks: Tokens): Bool :=
  match head_token(toks)
    case TOp(_) => true
    case TName(_) => true
    case _ => false
  end

procedure parse_operator(in notation: Notation, params: List[Id], out op: Id, ref toks: Tokens) :=
  if at_operator(toks)
    assign op := format_token(head_token(toks))
    call   advance(ref toks)
  else
    raise expected("operator", toks)
  end

// C or C(T, U), where the arguments may be named fields, as in C(name: T, rest: U)
procedure parse_constr(
  in  notation: Notation,
      params: List[Id],
  out constr: Constr * List[Option[Id]],
  ref toks: Tokens
) :=
  local name: Id, args: List[Option[Id] * Type] := Nil

  call parse_name_or_op(out name, ref toks)

  if at_kw(toks, "(")
    call advance(ref toks)
    call parse_enclosed(in notation, params, parse_field, ")", out args, ref toks)
  end

  assign constr := (Constr(unqualified(name), seconds(args)), firsts(args))

  match repeated(field_names(firsts(args)))
    case Some(f) =>
      raise ParseError("repeated field " ++ f ++ " of " ++ name, head_pos(toks))
    case None =>
      skip
  end

// a type of a constructor, which may be named
procedure parse_field(in notation: Notation, params: List[Id], out arg: Option[Id] * Type, ref toks: Tokens) :=
  local f: Option[Id], typ: Type

  match (head_token(toks), second_token(toks))
    case (TName(name), TKw(":")) =>
      call   advance(ref toks)
      call   advance(ref toks)
      assign f := Some(name)
    case _ =>
      assign f := None
  end

  call   parse_type(in notation, params, out typ, ref toks)
  assign arg := (f, typ)

// data T[A] := | C(A) | D, where the first | is optional
// with the accessors T.f and the updaters T.f:= of its named fields f
procedure parse_data(in notation: Notation, out cmds: List[Cmd], ref toks: Tokens) :=
  local name: Id, params: List[Id], constrs: List[Constr * List[Option[Id]]]

  call   advance(ref toks)
  call   parse_name(out name, ref toks)
  call   parse_params(in notation, out params, ref toks)
  call   expect(in TKw(":="), ref toks)

  if at_bar(toks)
    call advance(ref toks)
  end

  call parse_separated(in notation, params, parse_constr, at_bar, out constrs, ref toks)

  match differing_field(fields_of(constrs))
    case Some(f) =>
      raise ParseError("field " ++ f ++ " of " ++ name ++ " has different types", head_pos(toks))
    case None =>
      skip
  end

  assign cmds := [CData(unqualified(name), params, firsts(constrs)); field_functions(name, params, constrs)]

function field_names(fields: List[Option[Id]]): List[Id] :=
  match fields
    case Nil => Nil
    case [Some(f); rest] => [f; field_names(rest)]
    case [None; rest] => field_names(rest)
  end

// a field with different types in different constructors, if any
function differing_field(fields: List[Id * (Name * Int * Int * Type)]): Option[Id] :=
  match fields
    case Nil => None
    case [(f, (_, _, _, t)); rest] => if exists(fields_named(f, rest), lambda e => type_of_field(e) != t) then Some(f) else differing_field(rest)
  end

function type_of_field(field: Id * (Name * Int * Int * Type)): Type :=
  match field
    case (_, (_, _, _, t)) => t
  end

function fields_named(f: Id, fields: List[Id * (Name * Int * Int * Type)]): List[Id * (Name * Int * Int * Type)] :=
  match fields
    case Nil => Nil
    case [(g, d); rest] => if g == f then [(g, d); fields_named(f, rest)] else fields_named(f, rest)
  end

// the fields of the constructors with each constructor, the position of the field, its number of arguments, and its type
function fields_of(constrs: List[Constr * List[Option[Id]]]): List[Id * (Name * Int * Int * Type)] :=
  match constrs
    case Nil => Nil
    case [(Constr(k, args), fs); rest] => named_fields(k, size(args), zip(fs, args), 0) ++ fields_of(rest)
  end

function named_fields(k: Name, n: Int, fields: List[Option[Id] * Type], i: Int): List[Id * (Name * Int * Int * Type)] :=
  match fields
    case Nil => Nil
    case [(Some(f), t); rest] => [(f, (k, i, n, t)); named_fields(k, n, rest, i + 1)]
    case [(None, _); rest] => named_fields(k, n, rest, i + 1)
  end

// the accessor T.f and the updater T.f:= of each field f, which are partial if f is not a field of all constructors
function field_functions(t: Id, params: List[Id], constrs: List[Constr * List[Option[Id]]]): List[Cmd] :=
  let fs := fields_of(constrs), n := size(constrs) in
    let names := distinct(firsts(fs)) in
      [accessor(t, params, f, fields_named(f, fs), n) for f in names] ++ [updater(t, params, f, fields_named(f, fs), n) for f in names]

function accessor(t: Id, params: List[Id], f: Id, fields: List[Id * (Name * Int * Int * Type)], n: Int): Cmd :=
  CFun(
    unqualified(t ++ "." ++ f),
    params,
    [[Var(unqualified("x"), owner_type(t, params))]],
    field_type(fields),
    field_match(t, f, [field_case(field) for field in fields], n)
  )

// x with f := y is C(a0, y, a2) for x = C(a0, _, a2)
function updater(t: Id, params: List[Id], f: Id, fields: List[Id * (Name * Int * Int * Type)], n: Int): Cmd :=
  CFun(
    unqualified(t ++ "." ++ f ++ ":="),
    params,
    [[Var(unqualified("x"), owner_type(t, params)), Var(unqualified("y"), field_type(fields))]],
    owner_type(t, params),
    field_match(t, f, [update_case(field) for field in fields], n)
  )

function owner_type(t: Id, params: List[Id]): Type :=
  TSort(unqualified(t), [TParam(p) for p in params])

// the match of x by the cases of the constructors with the field f, and MissingField for the others of the n constructors
function field_match(t: Id, f: Id, cases: List[Branch[Expr]], n: Int): Expr :=
  EMatch(expr_var("x"), if size(cases) == n then cases else cases ++ [missing_field(t, f)])

function field_type(fields: List[Id * (Name * Int * Int * Type)]): Type :=
  match fields
    case [field; _] => type_of_field(field)
    case Nil => THole
  end

// case C(_, y, _) => y, where y is the field at its position
function field_case(field: Id * (Name * Int * Int * Type)): Branch[Expr] :=
  match field
    case (_, (k, i, n, _)) =>
      Branch(PApp(k, [if j == i then pat_var("y") else PWild for j in positions(n)]), None, expr_var("y"))
  end

function missing_field(t: Id, f: Id): Branch[Expr] :=
  Branch(PWild, None, ERaise(expr_app("MissingField", [ELit(VStr(t ++ "." ++ f))]), THole))

// case C(a0, _, a2) => C(a0, y, a2), where y replaces the field at its position
function update_case(field: Id * (Name * Int * Int * Type)): Branch[Expr] :=
  match field
    case (_, (k, i, n, _)) =>
      Branch(
        PApp(k, [if j == i then PWild else pat_var("a" ++ show(j)) for j in positions(n)]),
        None,
        EApp(EVar(Var(k, THole)), [expr_var(if j == i then "y" else "a" ++ show(j)) for j in positions(n)])
      )
  end

function positions(n: Int): List[Int] :=
  positions_from(0, n)

function positions_from(i: Int, n: Int): List[Int] :=
  if i == n then Nil else [i; positions_from(i + 1, n)]

procedure parse_function(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], xss: List[List[Var]], r: Type, body: Expr

  call   advance(ref toks)
  call   parse_name_or_op(out name, ref toks)
  call   parse_params(in notation, out params, ref toks)
  call   parse_repeated(in notation, params, parse_formals, lambda ts => at_kw(ts, "("), out xss, ref toks)

  call   expect(in TKw(":"), ref toks)
  call   parse_type(in notation, params, out r, ref toks)

  // a signature in an export section has no body
  if head_token(toks) == TKw(":=")
    call   advance(ref toks)
    call   parse_expr(in notation, params, out body, ref toks)
    assign cmd := CFun(unqualified(name), params, xss, r, body)
  else
    assign cmd := CFunSig(unqualified(name), params, xss, r)
  end

procedure parse_procedure(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], body: Stmt

  call   advance(ref toks)
  call   parse_name(out name, ref toks)
  call   parse_params(in notation, out params, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)

  if head_token(toks) == TKw(":=")
    call   advance(ref toks)
    call   parse_body(in notation, params, out body, ref toks)
    assign cmd := CProc(unqualified(name), params, ins, outs, refs, body)
  else
    assign cmd := CProcSig(unqualified(name), params, ins, outs, refs)
  end

// the commands of one declaration
procedure parse_command(in notation: Notation, out cmds: List[Cmd], ref toks: Tokens) :=
  local name: Id, params: List[Id], typ: Type, cmd: Cmd, body: Stmt, xs: List[Var], pos: Pos

  match head_token(toks)
    case TKw(w) if contains(w, ["prefix", "postfix", "infix"]) =>
      assign pos := head_pos(toks)
      call   parse_notation(in notation, out cmd, ref toks)
      call   check_duplicates(in notation, [cmd], pos)
      assign cmds := [cmd]

    case TKw("type") =>
      call   advance(ref toks)
      call   parse_name(out name, ref toks)
      call   parse_params(in notation, out params, ref toks)

      // an abstract type in an export section has no definition
      if head_token(toks) == TKw(":=")
        call   advance(ref toks)
        call   parse_type(in notation, params, out typ, ref toks)
        assign cmds := [CSort(unqualified(name), params, typ)]
      else
        assign cmds := [CAbstract(unqualified(name), params)]
      end

    case TKw("data") =>
      call parse_data(in notation, out cmds, ref toks)

    case TKw("function") =>
      call   parse_function(in notation, out cmd, ref toks)
      assign cmds := [cmd]

    case TKw("procedure") =>
      call   parse_procedure(in notation, out cmd, ref toks)
      assign cmds := [cmd]

    case TKw("test") =>
      call   advance(ref toks)
      call   parse_name(out name, ref toks)
      call   parse_formals(in notation, Nil, out xs, ref toks)
      call   expect(in TKw(":="), ref toks)
      call   parse_body(in notation, Nil, out body, ref toks)
      assign cmds := [CTest(name, xs, body)]

    case _ =>
      raise expected("declaration", toks)
  end

// the module name of mods, the modules loaded so far
function loaded_mod(name: Id, mods: List[Mod]): Option[Mod] :=
  match mods
    case Nil => None
    case [d; rest] => if d.name == name then Some(d) else loaded_mod(name, rest)
  end

// the notation with the one that module name of mods exports, which must not declare an operator differently
procedure import_notation(in name: Id, mods: List[Mod], pos: Pos, ref notation: Notation) :=
  match loaded_mod(name, mods)
    case Some(d) =>
      call   check_imported(in notation, exported_notation(d), pos)
      assign notation := union_notation(notation, exported_notation(d))
    case None =>
      skip
  end

// module name loaded into mods, the modules loaded so far in load order, unless it is loaded already, after the modules it
// imports, where dir is the directory whose modules hide the library, and loading are the modules being parsed
procedure import_module(in name: Id, dir: Option[Str], loading: List[Id], pos: Pos, ref mods: List[Mod]) :=
  if loaded_mod(name, mods) == None
    call load_module(in name, dir, loading, pos, ref mods)
  end

procedure import_all(in names: List[Id], dir: Option[Str], loading: List[Id], ref mods: List[Mod]) :=
  match names
    case Nil =>
      skip
    case [name; rest] =>
      call import_module(in name, dir, loading, Pos(1, 1), ref mods)
      call import_all(in rest, dir, loading, ref mods)
  end

procedure import_notations(in names: List[Id], mods: List[Mod], ref notation: Notation) :=
  match names
    case Nil =>
      skip
    case [name; rest] =>
      call import_notation(in name, mods, Pos(1, 1), ref notation)
      call import_notations(in rest, mods, ref notation)
  end

// where a module is: at its imports, which come first, in its export section, its builtin section, or its implementation
// section, or in a module without sections
data Section :=
  | Opening
  | InExport
  | InBuiltin
  | InImplementation
  | NoSections

// the module name of the tokens toks, which starts with the notation of its implicit imports, after the modules that its imports load
// into mods, where notations apply to the commands after them, imports come first, and each command has the position where
// it starts
procedure parse_mod(
  in  name: Id,
      implicit: List[Id],
      dir: Option[Str],
      loading: List[Id],
  out own: Mod,
  ref mods: List[Mod],
      toks: Tokens
) :=
  local imports: List[Id] := Nil, notation := empty_notation(), plain: List[Pos * Cmd] := Nil,
    exported: List[Pos * Cmd] := Nil, builtins: List[Pos * Cmd] := Nil, implemented: List[Pos * Cmd] := Nil, more: List[Cmd],
    section := Opening, pos: Pos, imported: Id, placed: List[Pos * Cmd]

  call import_all(in implicit, None, loading, ref mods)
  call import_notations(in implicit, mods, ref notation)

  while head_token(toks) != TEnd
    assign pos := head_pos(toks), more := Nil

    match head_token(toks)
      case TKw("export") =>
        if section == InExport or section == InBuiltin or section == InImplementation
          raise ParseError("a module has one export section", pos)
        else if section != Opening
          raise ParseError("export comes first, after the imports", pos)
        end

        call   advance(ref toks)
        assign section := InExport

      case TKw("builtin") =>
        if section != InExport
          raise ParseError("builtin follows export", pos)
        end

        call   advance(ref toks)
        assign section := InBuiltin

      case TKw("implementation") =>
        if section != InExport and section != InBuiltin
          raise ParseError("implementation follows export", pos)
        end

        call   advance(ref toks)
        assign section := InImplementation

      case TKw("import") if section == NoSections =>
        raise ParseError("imports come first", pos)

      case TKw("import") if section != Opening =>
        raise ParseError("imports come before export", pos)

      case TKw("import") =>
        call   advance(ref toks)
        call   parse_name(out imported, ref toks)
        call   import_module(in imported, dir, loading, pos, ref mods)
        call   import_notation(in imported, mods, pos, ref notation)
        assign imports := imports ++ [imported]

      case _ =>
        call   parse_command(in notation, out more, ref toks)
        call   enter_section(in more, pos, ref section)
        assign notation := with_notation(notation, more)
    end

    assign placed := [(pos, c) for c in more]

    match section
      case InExport =>
        assign exported := reverse_onto(placed, exported)
      case InBuiltin =>
        assign builtins := reverse_onto(placed, builtins)
      case InImplementation =>
        assign implemented := reverse_onto(placed, implemented)
      case _ =>
        assign plain := reverse_onto(placed, plain)
    end
  end

  // a module without sections has all its commands implemented
  assign own := Mod(name, imports, reverse(exported), reverse(builtins), reverse(implemented) ++ reverse(plain))

// the section after the commands of one declaration, which must belong to the section
procedure enter_section(in cmds: List[Cmd], pos: Pos, ref section: Section) :=
  match (cmds, section)
    case ([CFunSig(_, _, _, _); _], InBuiltin) =>
      skip
    case ([CProcSig(_, _, _, _, _); _], InBuiltin) =>
      skip
    case ([CAbstract(_, _); _], InBuiltin) =>
      skip
    case (_, InBuiltin) =>
      raise ParseError("builtin sections have signatures and types without a definition only", pos)
    case ([CNotation(_, _, _); _], InImplementation) =>
      raise ParseError("notations belong to the export section", pos)
    case ([CFunSig(_, _, _, _); _], s) if s != InExport =>
      raise ParseError("signatures belong to the export section", pos)
    case ([CProcSig(_, _, _, _, _); _], s) if s != InExport =>
      raise ParseError("signatures belong to the export section", pos)
    case ([CAbstract(_, _); _], s) if s != InExport =>
      raise ParseError("types without a definition belong to the export or builtin section", pos)
    case ([CFun(_, _, _, _, _); _], InExport) =>
      raise ParseError("definitions belong to the implementation section", pos)
    case ([CProc(_, _, _, _, _, _); _], InExport) =>
      raise ParseError("definitions belong to the implementation section", pos)
    case ([CTest(_, _, _); _], InExport) =>
      raise ParseError("tests belong to the implementation section", pos)
    case (_, Opening) =>
      assign section := NoSections
    case _ =>
      skip
  end

// modules are files in the directory of the parsed file, or in the library
procedure module_text(in name: Id, dir: Option[Str], pos: Pos, out text: Str) :=
  match dir
    case Some(d) =>
      try
        call os_read(in os_join(d, name ++ ".u"), out text)
      catch
        case OsError(_) =>
          call library_text(in name, pos, out text)
      end
    case None =>
      call library_text(in name, pos, out text)
  end

procedure library_text(in name: Id, pos: Pos, out text: Str) :=
  try
    call os_library(in name, out text)
  catch
    case OsError(_) =>
      raise ParseError("unknown module " ++ name, pos)
  end

// module name without its tests, after the modules it loads, parsed with the notation of its implicit and its own imports,
// since imports are not transitive
procedure load_module(in name: Id, dir: Option[Str], loading: List[Id], pos: Pos, ref mods: List[Mod]) :=
  local text: Str, toks: Tokens, own: Mod

  if contains(name, loading)
    raise ParseError("cyclic import of " ++ name, pos)
  end

  call module_text(in name, dir, pos, out text)

  try
    call lex(in text, out toks)
    call parse_mod(in name, implicit_imports(name), dir, [name; loading], out own, ref mods, toks)
  catch
    case LexError(m, p) =>
      raise ImportError(name, m, p)
    case ParseError(m, p) =>
      raise ImportError(name, m, p)
  end

  assign mods := mods ++ [without_tests_of(own)]

procedure lex_text(in text: Str, out toks: Tokens) :=
  try
    call lex(in text, out toks)
  catch
    case LexError(m, p) =>
      raise ParseError(m, p)
  end

procedure parse_file_text(in path: Str, text: Str, out mods: List[Mod]) :=
  local toks: Tokens, own: Mod, name := module_name(path)

  call   lex_text(in text, out toks)
  assign mods := Nil
  call   parse_mod(in name, implicit_imports(name), Some(os_dirname(path)), [name], out own, ref mods, toks)
  assign mods := mods ++ [own]

procedure parse_file(in path: Str, out mods: List[Mod]) :=
  local text: Str

  call os_read(in path, out text)
  call parse_file_text(in path, text, out mods)

procedure parse_text(in text: Str, out own: Mod) :=
  local toks: Tokens, mods: List[Mod] := Nil

  call lex_text(in text, out toks)
  call parse_mod(in "main", Nil, None, ["main"], out own, ref mods, toks)

// the module of the file at path, its name without its directory and .u
function module_name(path: Str): Str :=
  let f := os_basename(path) in
    if size(f) >= 2 and slice(f, size(f) - 2, size(f)) == ".u" then slice(f, 0, size(f) - 2) else f

// the parser, tested by the trees of single constructs, parsed with their own notation from the empty context, which reads no
// files, and by printing a program in the layout of the printer back as it is

function test_notation(): Str :=
  "infix right 8 ++\ninfix 6 ==\ninfix left 9 + -\ninfix left 10 *\nprefix 5 not\nprefix 11 -\n"

// the body of a function that is e
procedure parsed(in e: Str, out body: Expr) :=
  local d: Mod

  call   parse_text(in test_notation() ++ "function f(): Int :=\n  " ++ e, out d)
  assign body := ELit(VUnit)

  match reverse(commands_of(d))
    case [CFun(_, _, _, _, b); _] =>
      assign body := b
    case _ =>
      skip
  end

test parsed_operators() :=
  local expr: Expr, a := expr_var("a"), b := expr_var("b"), c := expr_var("c")

  call   parsed(in "a - b - c", out expr)
  assert expr == expr_app("-", [expr_app("-", [a, b]), c])
  call   parsed(in "a ++ b ++ c", out expr)
  assert expr == expr_app("++", [a, expr_app("++", [b, c])])
  call   parsed(in "a + b * c - a", out expr)
  assert expr == expr_app("-", [expr_app("+", [a, expr_app("*", [b, c])]), a])
  call   parsed(in "not a == b", out expr)
  assert expr == expr_app("not", [expr_app("==", [a, b])])
  call   parsed(in "-a * b", out expr)
  assert expr == expr_app("*", [expr_app("-", [a]), b])
  call   parsed(in "a - -1", out expr)
  assert expr == expr_app("-", [a, expr_int(-1)])
  call   parsed(in "- -a", out expr)
  assert expr == expr_app("-", [expr_app("-", [a])])
  call   parsed(in "-a.f", out expr)
  assert expr == expr_app("-", [expr_app(".f", [a])])
  call   parsed(in "a with f := 1, g := b.f", out expr)
  assert expr == expr_app(".g:=", [expr_app(".f:=", [a, expr_int(1)]), expr_app(".f", [b])])

test parsed_displays() :=
  local expr: Expr, a := expr_var("a"), b := expr_var("b"), c := expr_var("c")

  call   parsed(in "[a, b; c]", out expr)
  assert expr == expr_app("Cons", [a, expr_app("Cons", [b, c])])
  call   parsed(in "match a case [x, -1; _] => x end", out expr)
  assert expr == EMatch(a, [Branch(PApp(unqualified("Cons"), [pat_var("x"), PApp(unqualified("Cons"), [PLit(VInt(-1)), PWild])]), None, expr_var("x"))])
  call   parsed(in "{a, b}", out expr)
  assert expr == declared_app("insert", [a, declared_app("insert", [b, declared_app("empty", [])])])
  call   parsed(in "{a => b, a => c}", out expr)
  assert expr == declared_app("put", [a, c, declared_app("put", [a, b, declared_app("empty", [])])])
  call   parsed(in "{}", out expr)
  assert expr == declared_app("empty", [])

// the folds of comprehensions, with the accumulator last for foldr and first for foldl, nested for several generators
test parsed_comprehensions() :=
  local expr: Expr, x := Var(unqualified("x"), THole), y := Var(unqualified("y"), THole), acc := EVar(acc_var())
  local cons := expr_app("Cons", [expr_app("*", [EVar(x), EVar(y)]), acc])

  call   parsed(in "[x * y for x in a, y in b if x]", out expr)
  assert expr == declared_app("foldr", [expr_var("a"), expr_var("Nil"), ELam([x, acc_var()], declared_app("foldr", [expr_var("b"), acc, ELam([y, acc_var()], EIte(EVar(x), cons, acc))]))])
  call   parsed(in "{y => x for x => y in a}", out expr)
  assert expr == declared_app("foldl", [expr_var("a"), declared_app("empty", []), ELam([acc_var(), x, y], declared_app("put", [EVar(y), EVar(x), acc]))])

// a program in the layout of the printer, with the translations of locals, else if, fields, and updates, is printed back
test printed_back() :=
  local d: Mod, text := "infix left 9 +\n\ndata R :=\n  | R(f: Int, g: Int)\n\nprocedure p(in r: R, out n: Int) :=\n  local s := (r with f := 1), k: Int\n  if s.f + r.g\n    assign n := 1\n  else if r.f\n    assign k := 2, n := k\n  else\n    skip\n  end\n"

  call   parse_text(in text, out d)
  assert format_program([d]) == text
