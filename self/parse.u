    "../tests/errors/overload-same-arity.u",
    "../tests/errors/overload-unapplied.u",
    "../tests/errors/pair-type.u",
    "../tests/errors/pattern-arity.u",
    "../tests/errors/pattern-duplicate.u",
    "../tests/errors/pattern-type.u",
    "../tests/errors/procedure-modes.u",
    "../tests/errors/raise-type-parameter.u",
    "../tests/errors/raise-uncaught.u",
    "../tests/errors/raise-unknown-type.u",
    "../tests/errors/rigid-param.u",
    "../tests/errors/rigid-params.u",
    "../tests/errors/right.u",
    "../tests/errors/sort-arity.u",
    "../tests/errors/string-display.u",
    "../tests/errors/test-types.u",
    "../tests/errors/too-many-arguments.u",
    "../tests/errors/transitive-name.u",
    "../tests/errors/unassigned-output.u",
    "../tests/errors/uninitialized.u",
    "../tests/errors/unit.u",
    "../tests/errors/unknown-constructor.u",
    "../tests/errors/unknown-field.u",
    "../tests/errors/unknown-field-update.u",
    "../tests/errors/unknown-procedure.u",
    "../tests/errors/unknown-sort-generic.u",
    "../tests/errors/unknown-sort.u",
    "../tests/errors/unknown-variable.u",
    "../tests/errors/unreachable-after-wildcard.u",
    "../tests/errors/unreachable-covered.u",
    "../tests/errors/unreachable-wildcard.u",
    "../tests/errors/unreachable-literal.u",
    "../tests/errors/unreachable-repeated.u",
    "../tests/errors/wrapper.u"
  ], pre)
  call parse_failures(in [
    "../tests/errors/argument-list.u",
    "../tests/errors/broken.u",
    "../tests/errors/cycle.u",
    "../tests/errors/field-types.u",
    "../tests/errors/import-error.u",
    "../tests/errors/keyword-name.u",
    "../tests/errors/list-without-elements.u",
    "../tests/errors/mixed-literal.u",
    "../tests/errors/not-associative.u",
    "../tests/errors/not-prefix.u",
    "../tests/errors/operator-before-declaration.u",
    "../tests/errors/repeated-field.u",
    "../tests/errors/string-escape.u",
    "../tests/errors/undeclared-operator.u",
    "../tests/errors/unknown-module.u",
    "../tests/errors/transitive-notation.u",
    "../tests/errors/wildcard-name.u"
  ], pre)
