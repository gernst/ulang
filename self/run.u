// the interpreter of ulang/src/ulang/Run.scala, which runs programs of self/syntax.u that self/check.u has checked,
// where the variables of statements refer to cells of a heap that is passed by reference,
// and errors are values of RuntimeError, while the exceptions of the program are values of Thrown

import syntax

import check

import os

data Value :=
  | Lit(Val)
  | Obj(Name, List[Value])
  | Clos(List[Name * Value], List[Var], Expr)
  | Fn(Name, Int)
  | Con(Name)
  | Prim(Name)

type Bindings :=
  List[Name * Value]

data ProcDef :=
  | ProcDef(List[Var], List[Var], List[Var], Stmt)

// the functions by name and number of arguments, the procedures, the constructors with their numbers of arguments,
// and the constructors with their positions in their declarations, which order values
data Prog :=
  | Prog(List[(Name * Int) * (List[List[Var]] * Expr)], List[Name * ProcDef], List[Name * Int], List[Name * Int])

// the cells by address, which are unassigned initially, and the next address
data Heap :=
  | Heap(List[Int * Option[Value]], Int)

// the cells of variables
type Store :=
  List[Name * Int]

data RuntimeError :=
  | Uninitialized(Name)
  | NotFunction(Value)
  | Unspecified(Name, List[Value])
  | NoCase(Value)
  | DivisionByZero
  | CompareFunctions
  | NotList(Value)
  | AssertionFailed
  | AssertionUnequal(Value, Value)
  | UnassignedOutput(Name, Name)
  | UnknownProc(Name)

// an exception of the program with its type
data Thrown :=
  | Thrown(Value, Type)

// the values of evals and the assigned variables of runs
data Output :=
  | Evaluated(Value)
  | Ran(Bindings)

function funs_in(p: Prog): List[(Name * Int) * (List[List[Var]] * Expr)] :=
  match p
    case Prog(f, _, _, _) => f
  end

function procs_in(p: Prog): List[Name * ProcDef] :=
  match p
    case Prog(_, d, _, _) => d
  end

function constrs_in(p: Prog): List[Name * Int] :=
  match p
    case Prog(_, _, k, _) => k
  end

function position_of(p: Prog, k: Name): Int :=
  match p
    case Prog(_, _, _, ps) =>
      match lookup(k, ps)
        case Some(i) => i
        case None => 0
      end
  end

function load(q: Program): Prog :=
  match q
    case Program(cs) => Prog(fun_defs(cs), proc_defs(cs), constr_defs(cs), constr_positions(cs))
  end

// functions are overloaded by the number of arguments of their first list of parameters
function fun_defs(cs: List[Cmd]): List[(Name * Int) * (List[List[Var]] * Expr)] :=
  match cs
    case Nil => Nil
    case [CFun(n, _, xss, _, b); rest] => [((n, length(first_list(xss))), (xss, b)); fun_defs(rest)]
    case [_; rest] => fun_defs(rest)
  end

function proc_defs(cs: List[Cmd]): List[Name * ProcDef] :=
  match cs
    case Nil => Nil
    case [CProc(n, _, ins, outs, refs, b); rest] => [(n, ProcDef(ins, outs, refs, b)); proc_defs(rest)]
    case [_; rest] => proc_defs(rest)
  end

function constr_positions(cs: List[Cmd]): List[Name * Int] :=
  match cs
    case Nil => Nil
    case [CData(_, _, ks); rest] => zip([constr_name(k) for k in ks], numbers_from(0, length(ks))) ++ constr_positions(rest)
    case [_; rest] => constr_positions(rest)
  end

function numbers_from(i: Int, n: Int): List[Int] :=
  if n == 0 then Nil else [i; numbers_from(i + 1, n - 1)]

function constr_defs(cs: List[Cmd]): List[Name * Int] :=
  match cs
    case Nil => Nil
    case [CData(_, _, ks); rest] => [constr_arity(k) for k in ks] ++ constr_defs(rest)
    case [_; rest] => constr_defs(rest)
  end

function constr_arity(k: Constr): Name * Int :=
  match k
    case Constr(n, ts) => (n, length(ts))
  end

function is_builtin(n: Name): Bool :=
  match n
    case Name(None, b) => contains(b, ["+", "-", "*", "/", "%", "<", "==", "chars", "string", "ord", "chr", "^", "str_size", "str_join", "str_slice", "str_split", "compare", "str_get", "str_contains", "str_compare", "str_show", "str_quote", "str_number", "is_digit", "is_letter", "is_space"])
    else false
  end

function is_function(v: Value): Bool :=
  match v
    case Lit(_) => false
    case Obj(_, _) => false
    else true
  end

function truth(v: Value): Bool :=
  v == Lit(VBool(true))

function list_value(vs: List[Value]): Value :=
  match vs
    case Nil => Obj(nil_name(), Nil)
    case [v; rest] => Obj(cons_name(), [v, list_value(rest)])
  end

function elements(v: Value): Option[List[Value]] :=
  match v
    case Obj(n, Nil) if n == nil_name() => Some(Nil)
    case Obj(n, [w, ws]) if n == cons_name() =>
      match elements(ws)
        case Some(us) => Some([w; us])
        case None => None
      end
    else None
  end

function lambdas(xss: List[List[Var]], b: Expr): Expr :=
  match xss
    case Nil => b
    case [xs; rest] => ELam(xs, lambdas(rest, b))
  end

function str_values(vs: List[Value]): List[Str] :=
  match vs
    case [Lit(VStr(s)); rest] => [s; str_values(rest)]
    else Nil
  end

function char_values(vs: List[Value]): List[Char] :=
  match vs
    case [Lit(VChar(c)); rest] => [c; char_values(rest)]
    else Nil
  end

function bind_values(xs: List[Var], vs: List[Value]): Bindings :=
  zip(names(xs), vs)

function matches(p: Pat, v: Value): Option[Bindings] :=
  match (p, v)
    case (PWild, _) => Some(Nil)
    case (PLit(l), _) => if v == Lit(l) then Some(Nil) else None
    case (PVar(Var(n, _)), _) => Some([(n, v)])
    case (PApp(c, ps), Obj(d, vs)) => if c == d then matches_all(ps, vs) else None
    case (PApp(_, _), _) => None
    case (PTuple(ps), Obj(n, vs)) if n == tuple_name() => matches_all(ps, vs)
    case (PTuple(_), _) => None
  end

function matches_all(ps: List[Pat], vs: List[Value]): Option[Bindings] :=
  match (ps, vs)
    case (Nil, Nil) => Some(Nil)
    case ([p; ps1], [v; vs1]) =>
      match matches(p, v)
        case Some(bs) =>
          match matches_all(ps1, vs1)
            case Some(cs) => Some(bs ++ cs)
            case None => None
          end
        case None => None
      end
    else None
  end


function read_cell(h: Heap, a: Int): Option[Value] :=
  match h
    case Heap(cells, _) =>
      match lookup(a, cells)
        case Some(c) => c
        case None => None
      end
  end

function address_of(store: Store, n: Name): Int :=
  match lookup(n, store)
    case Some(a) => a
    case None => -1
  end

// the values of the assigned variables, where unassigned cells hide the variables of the same name further out
function values_of(store: Store, h: Heap): Bindings :=
  assigned(store, h, Nil)

function assigned(store: Store, h: Heap, seen: List[Name]): Bindings :=
  match store
    case Nil => Nil
    case [(n, a); rest] =>
      if contains(n, seen) then
        assigned(rest, h, seen)
      else
        match read_cell(h, a)
          case Some(v) => [(n, v); assigned(rest, h, [n; seen])]
          case None => assigned(rest, h, [n; seen])
        end
  end

procedure alloc(in c: Option[Value], out a: Int, ref h: Heap) :=
  match h
    case Heap(cells, n) =>
      assign a := n, h := Heap([(n, c); cells], n + 1)
  end

procedure write_cell(in a: Int, v: Value, ref h: Heap) :=
  match h
    case Heap(cells, n) =>
      assign h := Heap(update(a, Some(v), cells), n)
  end

procedure alloc_vars(in xs: List[Var], out store: Store, ref h: Heap) :=
  local a: Int, rest: Store
  match xs
    case Nil =>
      assign store := Nil
    case [x; more] =>
      call   alloc(in None, out a, ref h)
      call   alloc_vars(in more, out rest, ref h)
      assign store := [(name(x), a); rest]
  end

procedure alloc_bindings(in bs: Bindings, out store: Store, ref h: Heap) :=
  local a: Int, rest: Store
  match bs
    case Nil =>
      assign store := Nil
    case [(n, v); more] =>
      call   alloc(in Some(v), out a, ref h)
      call   alloc_bindings(in more, out rest, ref h)
      assign store := [(n, a); rest]
  end

procedure write_vars(in store: Store, xs: List[Var], vs: List[Value], ref h: Heap) :=
  match (xs, vs)
    case ([x; xs1], [v; vs1]) =>
      call   write_cell(in address_of(store, name(x)), v, ref h)
      call   write_vars(in store, xs1, vs1, ref h)
    else
      skip
  end

procedure read_outs(in p: Name, outs: Store, h: Heap, out vs: List[Value]) :=
  local rest: List[Value]
  match outs
    case Nil =>
      assign vs := Nil
    case [(n, a); more] =>
      match read_cell(h, a)
        case Some(v) =>
          call   read_outs(in p, more, h, out rest)
          assign vs := [v; rest]
        case None =>
          raise UnassignedOutput(n, p)
      end
  end

procedure evaluate(in p: Prog, env: Bindings, e: Expr, out v: Value) :=
  local w: Value, vs: List[Value], envs: List[Bindings], sel: Option[Expr * Bindings]
  match e
    case ELit(l) =>
      assign v := Lit(l)
    case EVar(Var(n, t)) =>
      call variable_value(in p, env, n, t, out v)
    case EApp(f, args) =>
      call apply_expr(in p, env, f, args, out v)
    case ELam(xs, body) =>
      assign v := Clos(env, xs, body)
    // the variables are bound in parallel
    case ELet(bound, body) =>
      call   evaluate_all(in p, env, seconds(bound), out vs)
      call   evaluate(in p, bind_values(firsts(bound), vs) ++ env, body, out v)
    case EIte(cond, left, right) =>
      call evaluate(in p, env, cond, out w)
      if truth(w)
        call evaluate(in p, env, left, out v)
      else
        call evaluate(in p, env, right, out v)
      end
    case EMatch(arg, cases) =>
      call   evaluate(in p, env, arg, out w)
      call   select(in p, env, w, cases, out sel)
      match sel
        case Some((body, bs)) =>
          call evaluate(in p, bs ++ env, body, out v)
        case None =>
          raise NoCase(w)
      end
    case EComp(result, xs, lists, cond) =>
      call   combinations(in p, env, xs, lists, out envs)
      call   comprehension(in p, envs, result, cond, out vs)
      assign v := list_value(vs)
    // tuples are objects of the constructor ,
    case ETuple(items) =>
      call   evaluate_all(in p, env, items, out vs)
      assign v := Obj(tuple_name(), vs)
  end

procedure evaluate_all(in p: Prog, env: Bindings, es: List[Expr], out vs: List[Value]) :=
  local v: Value, rest: List[Value]
  match es
    case Nil =>
      assign vs := Nil
    case [e; more] =>
      call   evaluate(in p, env, e, out v)
      call   evaluate_all(in p, env, more, out rest)
      assign vs := [v; rest]
  end

procedure variable_value(in p: Prog, env: Bindings, n: Name, t: Type, out v: Value) :=
  match lookup(n, env)
    case Some(w) =>
      assign v := w
    case None =>
      match lookup((n, arity(t)), funs_in(p))
        case Some(_) =>
          assign v := Fn(n, arity(t))
        case None =>
          match lookup(n, constrs_in(p))
            case Some(k) =>
              if k == 0
                assign v := Obj(n, Nil)
              else
                assign v := Con(n)
              end
            case None =>
              if is_builtin(n)
                assign v := Prim(n)
              else
                raise Uninitialized(n)
              end
          end
      end
  end

// and, or are not strict and therefore not builtins
procedure apply_expr(in p: Prog, env: Bindings, f: Expr, args: List[Expr], out v: Value) :=
  local a: Value, g: Value, vs: List[Value]
  match (f, args)
    case (EVar(Var(Name(None, "and"), _)), [l, r]) =>
      call evaluate(in p, env, l, out a)
      if truth(a)
        call evaluate(in p, env, r, out v)
      else
        assign v := a
      end
    case (EVar(Var(Name(None, "or"), _)), [l, r]) =>
      call evaluate(in p, env, l, out a)
      if truth(a)
        assign v := a
      else
        call evaluate(in p, env, r, out v)
      end
    else
      call   evaluate(in p, env, f, out g)
      call   evaluate_all(in p, env, args, out vs)
      call   apply_value(in p, g, vs, out v)
  end

procedure apply_value(in p: Prog, f: Value, vs: List[Value], out v: Value) :=
  local k: Int
  match f
    case Clos(env, xs, body) =>
      call evaluate(in p, bind_values(xs, vs) ++ env, body, out v)
    case Fn(n, k) =>
      match lookup((n, k), funs_in(p))
        case Some(([xs], body)) =>
          call evaluate(in p, bind_values(xs, vs), body, out v)
        // further lists of parameters are closures over the arguments so far
        case Some(([xs, ys; rest], body)) =>
          assign v := Clos(bind_values(xs, vs), ys, lambdas(rest, body))
        case Some((Nil, _)) =>
          raise Uninitialized(n)
        case None =>
          raise Uninitialized(n)
      end
    case Con(n) =>
      assign v := Obj(n, vs)
    case Prim(n) =>
      match (base(n), vs)
        case ("compare", [a, b]) =>
          call   compare_values(in p, a, b, out k)
          assign v := Lit(VInt(k))
        else
          call primitive(in n, vs, out v)
      end
    else
      raise NotFunction(f)
  end

procedure primitive(in n: Name, vs: List[Value], out v: Value) :=
  local r: Bool
  match (base(n), vs)
    case ("+", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a + b))
    case ("-", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a - b))
    case ("*", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a * b))
    case ("/", [Lit(VInt(_)), Lit(VInt(0))]) =>
      raise DivisionByZero
    case ("/", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a / b))
    case ("%", [Lit(VInt(_)), Lit(VInt(0))]) =>
      raise DivisionByZero
    case ("%", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a % b))
    case ("<", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VBool(a < b))
    case ("==", [a, b]) =>
      call   equal(in a, b, out r)
      assign v := Lit(VBool(r))
    // strings are converted with the builtins of the interpreter of this program
    case ("chars", [Lit(VStr(s))]) =>
      assign v := list_value([Lit(VChar(c)) for c in chars(s)])
    case ("string", [w]) =>
      match elements(w)
        case Some(ws) =>
          assign v := Lit(VStr(string(char_values(ws))))
        else
          raise NotList(w)
      end
    case ("ord", [Lit(VChar(c))]) =>
      assign v := Lit(VInt(ord(c)))
    case ("chr", [Lit(VInt(k))]) =>
      assign v := Lit(VChar(chr(k)))
    case ("^", [Lit(VStr(s)), Lit(VStr(t))]) =>
      assign v := Lit(VStr(s ^ t))
    case ("str_size", [Lit(VStr(s))]) =>
      assign v := Lit(VInt(str_size(s)))
    case ("str_join", [Lit(VStr(sep)), w]) =>
      match elements(w)
        case Some(ws) =>
          assign v := Lit(VStr(str_join(sep, str_values(ws))))
        else
          raise NotList(w)
      end
    case ("str_slice", [Lit(VStr(s)), Lit(VInt(i)), Lit(VInt(j))]) =>
      assign v := Lit(VStr(str_slice(s, i, j)))
    case ("str_split", [Lit(VStr(s)), Lit(VChar(c))]) =>
      assign v := list_value([Lit(VStr(part)) for part in str_split(s, c)])
    case ("str_get", [Lit(VStr(s)), Lit(VInt(i))]) =>
      assign v := Lit(VChar(str_get(s, i)))
    case ("str_contains", [Lit(VStr(s)), Lit(VChar(c))]) =>
      assign v := Lit(VBool(str_contains(s, c)))
    case ("str_compare", [Lit(VStr(s)), Lit(VStr(t))]) =>
      assign v := Lit(VInt(str_compare(s, t)))
    case ("str_show", [Lit(VInt(k))]) =>
      assign v := Lit(VStr(str_show(k)))
    case ("str_quote", [Lit(VStr(s))]) =>
      assign v := Lit(VStr(str_quote(s)))
    case ("str_number", [Lit(VStr(s))]) =>
      match str_number(s)
        case Some(k) =>
          assign v := Obj(some_name(), [Lit(VInt(k))])
        case None =>
          assign v := Obj(none_name(), Nil)
      end
    case ("is_digit", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_digit(c)))
    case ("is_letter", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_letter(c)))
    case ("is_space", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_space(c)))
    else
      raise Unspecified(n, vs)
  end

procedure equal(in a: Value, b: Value, out r: Bool) :=
  if is_function(a) or is_function(b)
    raise CompareFunctions
  end
  match (a, b)
    case (Obj(c, xs), Obj(d, ys)) =>
      if c == d and length(xs) == length(ys)
        call equal_all(in xs, ys, out r)
      else
        assign r := false
      end
    else
      assign r := a == b
  end

// -1, 0, or 1 for values of the same type, where constructors are ordered by their declaration and then by their fields
procedure compare_values(in p: Prog, a: Value, b: Value, out r: Int) :=
  if is_function(a) or is_function(b)
    raise CompareFunctions
  end

  match (a, b)
    case (Lit(VInt(x)), Lit(VInt(y))) =>
      assign r := order(x, y)
    case (Lit(VChar(x)), Lit(VChar(y))) =>
      assign r := order(ord(x), ord(y))
    case (Lit(VBool(x)), Lit(VBool(y))) =>
      assign r := order(if x then 1 else 0, if y then 1 else 0)
    case (Lit(VStr(x)), Lit(VStr(y))) =>
      assign r := str_compare(x, y)
    case (Obj(c, xs), Obj(d, ys)) =>
      if c == d
        call compare_all(in p, xs, ys, out r)
      else
        assign r := order(position_of(p, c), position_of(p, d))
      end
    else
      assign r := 0
  end

procedure compare_all(in p: Prog, xs: List[Value], ys: List[Value], out r: Int) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call compare_values(in p, x, y, out r)

      if r == 0
        call compare_all(in p, xs1, ys1, out r)
      end
    else
      assign r := order(length(xs), length(ys))
  end

function order(x: Int, y: Int): Int :=
  if x < y then -1 else if y < x then 1 else 0

procedure equal_all(in xs: List[Value], ys: List[Value], out r: Bool) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call equal(in x, y, out r)
      if r
        call equal_all(in xs1, ys1, out r)
      end
    else
      assign r := true
  end

// env extended by all combinations of elements of lists
procedure combinations(in p: Prog, env: Bindings, xs: List[Var], lists: List[Expr], out envs: List[Bindings]) :=
  local l: Value
  match (xs, lists)
    case ([x; ys], [e; more]) =>
      call evaluate(in p, env, e, out l)
      match elements(l)
        case Some(vs) =>
          call extend(in p, env, x, vs, ys, more, out envs)
        case None =>
          raise NotList(l)
      end
    else
      assign envs := [env]
  end

procedure extend(in p: Prog, env: Bindings, x: Var, vs: List[Value], ys: List[Var], lists: List[Expr], out envs: List[Bindings]) :=
  local first: List[Bindings], rest: List[Bindings]
  match vs
    case Nil =>
      assign envs := Nil
    case [v; more] =>
      call   combinations(in p, [(name(x), v); env], ys, lists, out first)
      call   extend(in p, env, x, more, ys, lists, out rest)
      assign envs := first ++ rest
  end

procedure comprehension(in p: Prog, envs: List[Bindings], result: Expr, cond: Expr, out vs: List[Value]) :=
  local b: Value, r: Value, rest: List[Value]
  match envs
    case Nil =>
      assign vs := Nil
    case [env; more] =>
      call evaluate(in p, env, cond, out b)
      if truth(b)
        call   evaluate(in p, env, result, out r)
        call   comprehension(in p, more, result, cond, out rest)
        assign vs := [r; rest]
      else
        call comprehension(in p, more, result, cond, out vs)
      end
  end

procedure exec(in p: Prog, store: Store, x: Stmt, ref h: Heap) :=
  local v: Value, w: Value, vs: List[Value], r: Bool, inner: Store, sel: Option[Stmt * Bindings]
  match x
    case SSkip =>
      skip
    // the variables are assigned in parallel
    case SAssign(pairs) =>
      call   evaluate_all(in p, values_of(store, h), seconds(pairs), out vs)
      call   write_vars(in store, firsts(pairs), vs, ref h)
    case SBlock(locals, body) =>
      call   alloc_vars(in locals, out inner, ref h)
      call   exec_all(in p, inner ++ store, body, ref h)
    case SIf(cond, left, right) =>
      call evaluate(in p, values_of(store, h), cond, out v)
      if truth(v)
        call exec(in p, store, left, ref h)
      else
        call exec(in p, store, right, ref h)
      end
    case SWhile(cond, body) =>
      call evaluate(in p, values_of(store, h), cond, out v)

      while truth(v)
        call   exec(in p, store, body, ref h)
        call   evaluate(in p, values_of(store, h), cond, out v)
      end
    case SCall(n, ins, outs, refs) =>
      call   evaluate_all(in p, values_of(store, h), ins, out vs)
      call   invoke(in p, n, vs, [address_of(store, name(y)) for y in refs], out vs, ref h)
      call   write_vars(in store, outs, vs, ref h)
    case SMatch(arg, cases) =>
      call   evaluate(in p, values_of(store, h), arg, out v)
      call   select(in p, values_of(store, h), v, cases, out sel)
      match sel
        case Some((body, bs)) =>
          call   alloc_bindings(in bs, out inner, ref h)
          call   exec(in p, inner ++ store, body, ref h)
        case None =>
          raise NoCase(v)
      end
    // assertions of equations show both sides when they fail
    case SAssert(EApp(EVar(Var(Name(None, "=="), _)), [lhs, rhs])) =>
      call   evaluate(in p, values_of(store, h), lhs, out v)
      call   evaluate(in p, values_of(store, h), rhs, out w)
      call   equal(in v, w, out r)
      if not r
        raise AssertionUnequal(v, w)
      end
    case SAssert(cond) =>
      call evaluate(in p, values_of(store, h), cond, out v)
      if not truth(v)
        raise AssertionFailed
      end
    case SRaise(arg, t) =>
      call   evaluate(in p, values_of(store, h), arg, out v)
      raise  Thrown(v, t)
    case STry(body, handlers) =>
      try
        call exec(in p, store, body, ref h)
      catch
        case Thrown(u, t) =>
          call handle(in p, store, handlers, u, t, ref h)
      end
  end

procedure exec_all(in p: Prog, store: Store, xs: List[Stmt], ref h: Heap) :=
  match xs
    case Nil =>
      skip
    case [x; more] =>
      call   exec(in p, store, x, ref h)
      call   exec_all(in p, store, more, ref h)
  end

// the first case whose pattern matches v and whose guard holds
procedure select[A](in p: Prog, env: Bindings, v: Value, cases: List[Branch[A]], out sel: Option[A * Bindings]) :=
  local ok: Bool
  match cases
    case Nil =>
      assign sel := None
    case [Branch(q, g, b); rest] =>
      match matches(q, v)
        case Some(bs) =>
          call   holds(in p, bs ++ env, g, out ok)
          if ok
            assign sel := Some((b, bs))
          else
            call select(in p, env, v, rest, out sel)
          end
        case None =>
          call select(in p, env, v, rest, out sel)
      end
  end

procedure holds(in p: Prog, env: Bindings, g: Option[Expr], out ok: Bool) :=
  local w: Value
  match g
    case Some(e) =>
      call   evaluate(in p, env, e, out w)
      assign ok := truth(w)
    case None =>
      assign ok := true
  end

// the first handler of v of type t whose guard holds, where _ handles exceptions of any type, or else raises v again
procedure handle(in p: Prog, store: Store, hs: List[Handler], v: Value, t: Type, ref h: Heap) :=
  local inner: Store, ok: Bool
  match hs
    case Nil =>
      raise Thrown(v, t)
    case [Handler(_, PWild, g, body); rest] =>
      call holds(in p, values_of(store, h), g, out ok)
      if ok
        call exec(in p, store, body, ref h)
      else
        call handle(in p, store, rest, v, t, ref h)
      end
    // the type is compared first, since the pattern and the guard assume it
    case [Handler(u, q, g, body); rest] =>
      assign ok := false
      if u == t
        match matches(q, v)
          case Some(bs) =>
            call holds(in p, bs ++ values_of(store, h), g, out ok)
            if ok
              call   alloc_bindings(in bs, out inner, ref h)
              call   exec(in p, inner ++ store, body, ref h)
            end
          else
            skip
        end
      end
      if not ok
        call handle(in p, store, rest, v, t, ref h)
      end
  end

procedure invoke(in p: Prog, n: Name, ins: List[Value], refs: List[Int], out outs: List[Value], ref h: Heap) :=
  local in_cells: Store, out_cells: Store
  match lookup(n, procs_in(p))
    case Some(ProcDef(xs, ys, zs, body)) =>
      call   alloc_bindings(in bind_values(xs, ins), out in_cells, ref h)
      call   alloc_vars(in ys, out out_cells, ref h)
      call   exec(in p, in_cells ++ out_cells ++ zip(names(zs), refs), body, ref h)
      call   read_outs(in n, out_cells, h, out outs)
    case None =>
      call os_proc(in n, ins, out outs)
  end

// the procedures of the library os are those of the interpreter of this program, whose OsError the program can catch
procedure os_proc(in n: Name, ins: List[Value], out outs: List[Value]) :=
  local text: Str, args: List[Str]
  try
    match (base(n), ins)
      case ("os_args", []) =>
        call   os_args(out args)
        assign outs := [list_value([Lit(VStr(a)) for a in args])]
      case ("os_read", [Lit(VStr(path))]) =>
        call   os_read(in path, out text)
        assign outs := [Lit(VStr(text))]
      case ("os_write", [Lit(VStr(path)), Lit(VStr(t))]) =>
        call   os_write(in path, t)
        assign outs := Nil
      case ("os_library", [Lit(VStr(name))]) =>
        call   os_library(in name, out text)
        assign outs := [Lit(VStr(text))]
      else
        raise UnknownProc(n)
    end
  catch
    case OsError(m) =>
      raise Thrown(Obj(os_error_name(), [Lit(VStr(m))]), TSort(os_error_name(), Nil))
  end

// executes a block and returns the assigned values of its variables
procedure results(in p: Prog, body: Stmt, out bs: Bindings, ref h: Heap) :=
  local store: Store
  match body
    case SBlock(locals, stmts) =>
      call   alloc_vars(in locals, out store, ref h)
      call   exec_all(in p, store, stmts, ref h)
      assign bs := values_of(store, h)
    else
      call   exec(in p, Nil, body, ref h)
      assign bs := Nil
  end

procedure outputs(in p: Prog, cs: List[Cmd], out os: List[Output], ref h: Heap) :=
  local v: Value, bs: Bindings, rest: List[Output]
  match cs
    case Nil =>
      assign os := Nil
    case [CEval(e); more] =>
      call   evaluate(in p, Nil, e, out v)
      call   outputs(in p, more, out rest, ref h)
      assign os := [Evaluated(v); rest]
    case [CRun(_, body); more] =>
      call   results(in p, body, out bs, ref h)
      call   outputs(in p, more, out rest, ref h)
      assign os := [Ran(bs); rest]
    case [CTest(_, body); more] =>
      call   exec(in p, Nil, body, ref h)
      call   outputs(in p, more, out os, ref h)
    case [_; more] =>
      call outputs(in p, more, out os, ref h)
  end

// the outputs of a checked program, failed assertions are errors
procedure run_program(in q: Program, out os: List[Output]) :=
  local  h: Heap
  assign h := Heap(Nil, 0)
  call   outputs(in load(q), cmds_of(q), out os, ref h)

function cmds_of(q: Program): List[Cmd] :=
  match q
    case Program(cs) => cs
  end

// checks and runs the commands
procedure check_and_run(in cs: List[Cmd], out os: List[Output]) :=
  local  q: Program
  call   check_program(in Program(cs), "main", out q)
  call   run_program(in q, out os)

function int(n: Int): Value :=
  Lit(VInt(n))

test expressions :=
  local  os: List[Output]
  call   check_and_run(in lists() ++
    [
      CEval(ap("len", [ap("Cons", [num(1), ap("Cons", [num(2), ev("Nil")])])])),
      // let f = lambda x => x * x in f(3) + f(4)
      CEval(ELet([(Var(unqualified("f"), THole), ELam([Var(unqualified("x"), THole)], ap("*", [ev("x"), ev("x")])))], ap("+", [ap("f", [num(3)]), ap("f", [num(4)])]))),
      // [x * y for x in [1, 2], y in [x, 3] if x < y]
      CEval(
        EComp(
          ap("*", [ev("x"), ev("y")]),
          [Var(unqualified("x"), THole), Var(unqualified("y"), THole)],
          [ap("Cons", [num(1), ap("Cons", [num(2), ev("Nil")])]), ap("Cons", [ev("x"), ap("Cons", [num(3), ev("Nil")])])],
          ap("<", [ev("x"), ev("y")])
        )
      ),
      // false and 1 / 0 == 0
      CEval(ap("and", [ELit(VBool(false)), ap("==", [ap("/", [num(1), num(0)]), num(0)])]))
    ], out os)
  assert
    os ==
    [
      Evaluated(int(2)),
      Evaluated(int(25)),
      Evaluated(list_value([int(3), int(6)])),
      Evaluated(Lit(VBool(false)))
    ]

// procedure sum(in n: Int, out s: Int) with a loop, and procedure count(ref k: Int) raising Fail after an increment
function procedures(): List[Cmd] :=
  [
    CData(unqualified("Fail"), Nil, [Constr(unqualified("Fail"), [tint()])]),
    CProc(
      unqualified("sum"),
      Nil,
      [Var(unqualified("n"), tint())],
      [Var(unqualified("s"), tint())],
      Nil,
      SBlock(
        [Var(unqualified("i"), tint())],
        [
          SAssign([(Var(unqualified("s"), THole), num(0)), (Var(unqualified("i"), THole), num(0))]),
          SWhile(
            ap("<", [ev("i"), ev("n")]),
            SBlock(Nil, [SAssign([(Var(unqualified("i"), THole), ap("+", [ev("i"), num(1)])), (Var(unqualified("s"), THole), ap("+", [ev("s"), ap("+", [ev("i"), num(1)])]))])])
          )
        ]
      )
    ),
    CProc(
      unqualified("count"),
      Nil,
      Nil,
      Nil,
      [Var(unqualified("k"), tint())],
      SBlock(Nil, [SAssign([(Var(unqualified("k"), THole), ap("+", [ev("k"), num(1)]))]), SRaise(ap("Fail", [ev("k")]), THole)])
    )
  ]

test procedures :=
  local  os: List[Output]
  call   check_and_run(in procedures() ++
    [
      CRun("sum", SBlock([Var(unqualified("s"), tint())], [SCall(unqualified("sum"), [num(4)], [Var(unqualified("s"), THole)], Nil)])),
      // the assignment to k before the exception remains, and the handler for Fail binds its argument
      CRun(
        "count",
        SBlock(
          [Var(unqualified("k"), tint()), Var(unqualified("m"), tint())],
          [
            SAssign([(Var(unqualified("k"), THole), num(1))]),
            STry(
              SBlock(Nil, [SCall(unqualified("count"), Nil, Nil, [Var(unqualified("k"), THole)])]),
              [Handler(THole, PApp(unqualified("Fail"), [pv("j")]), None, SBlock(Nil, [SAssign([(Var(unqualified("m"), THole), ev("j"))])]))]
            )
          ]
        )
      )
    ], out os)
  assert os == [Ran([(unqualified("s"), int(10))]), Ran([(unqualified("k"), int(2)), (unqualified("m"), int(2))])]

test errors :=
  local os: List[Output]
  try
    call   check_and_run(in procedures() ++ [CTest("t", SBlock(Nil, [SRaise(ap("Fail", [num(1)]), THole)]))], out os)
    assert false
  catch
    case Thrown(v, t) =>
      assert v == Obj(Name(Some("main"), "Fail"), [int(1)])
      assert t == TSort(Name(Some("main"), "Fail"), Nil)
  end
  try
    call   check_and_run(in [CTest("t", SBlock(Nil, [SAssert(ap("==", [num(1), num(2)]))]))], out os)
    assert false
  catch
    case AssertionUnequal(a, b) =>
      assert (a, b) == (int(1), int(2))
  end
  try
    call   check_and_run(in [CEval(ap("/", [num(1), num(0)]))], out os)
    assert false
  catch
    case DivisionByZero =>
      skip
  end

// add(a: Int)(b: Int): Int := a + b, applied partially
test curried :=
  local  os: List[Output]
  call   check_and_run(
    in [
      CFun(unqualified("add"), Nil, [[Var(unqualified("a"), tint())], [Var(unqualified("b"), tint())]], tint(), ap("+", [ev("a"), ev("b")])),
      CEval(EApp(ap("add", [num(1)]), [num(2)]))
    ],
    out os
  )
  assert os == [Evaluated(int(3))]

// match (1, true, 3) case (_, _, z) => z end, a flat tuple
test tuples :=
  local  os: List[Output]
  call   check_and_run(in [CEval(EMatch(ETuple([num(1), ELit(VBool(true)), num(3)]), [Branch(PTuple([PWild, PWild, pv("z")]), None, ev("z"))]))], out os)
  assert os == [Evaluated(int(3))]

// a handler for integers skips a string without evaluating its guard, so the string is raised further
test handler_types :=
  local  os: List[Output]
  try
    call   check_and_run(in [CTest("t", STry(SRaise(ELit(VStr("x")), THole), [Handler(THole, pv("k"), Some(ap("<", [ev("k"), num(2)])), SSkip)]))], out os)
    assert false
  catch
    case Thrown(v, _) =>
      assert v == Lit(VStr("x"))
  end
