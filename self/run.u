// the interpreter of ulang/src/ulang/Run.scala, which runs programs of self/syntax.u that self/check.u has checked,
// where the variables of statements refer to cells of a heap that is passed by reference,
// and errors are values of RuntimeError, while the exceptions of the program are values of Thrown

import syntax
import value
import print

import check

import os
import set
import map

type Bindings :=
  List[Name * Value]

data ProcDef :=
  | ProcDef(List[Var], List[Var], List[Var], Stmt)

// the functions by name and number of arguments, the procedures, the constructors with their numbers of arguments,
// and the constructors with their positions in their declarations, which order values
data Prog :=
  | Prog(
    funs: List[(Name * Int) * (List[List[Var]] * Expr)],
    procs: List[Name * ProcDef],
    constrs: List[Name * Int],
    positions: List[Name * Int],
    computing: List[Name]
  )

// the cells by address, which are unassigned initially, the next address, the values of functions without parameters,
// and the lines that os_print and os_show printed so far, the last first
data Heap :=
  | Heap(cells: Map[Int, Option[Value]], next: Int, values: List[Name * Value], printed: List[Str])

// the cells of variables
type Store :=
  List[Name * Int]

data RuntimeError :=
  | Uninitialized(Name)
  | NotFunction(Value)
  | Unspecified(Name, List[Value])
  | NoCase(Value)
  | CompareFunctions
  | NotList(Value)
  | AssertionFailed
  | AssertionUnequal(Value, Value)
  | UnassignedOutput(Name, Name)
  | UnknownProc(Name)
  | NotProc(Value)
  | RecursiveInitialization(Name)

// an exception of the program with its type
data Thrown :=
  | Thrown(Value, Type)

// the values of evals and the assigned variables of runs
function position_of(p: Prog, k: Name): Int :=
  match lookup(k, p.positions)
    case Some(i) => i
    case None => 0
  end

function load(q: Program): Prog :=
  match q
    case Program(cs) => Prog(fun_defs(cs), proc_defs(cs), constr_defs(cs), constr_positions(cs), Nil)
  end

// functions are overloaded by the number of arguments of their first list of parameters
function fun_defs(cs: List[Cmd]): List[(Name * Int) * (List[List[Var]] * Expr)] :=
  match cs
    case Nil => Nil
    case [CFun(n, _, xss, _, b); rest] => [((n, length(first_list(xss))), (xss, b)); fun_defs(rest)]
    case [_; rest] => fun_defs(rest)
  end

function proc_defs(cs: List[Cmd]): List[Name * ProcDef] :=
  match cs
    case Nil => Nil
    case [CProc(n, _, ins, outs, refs, b); rest] => [(n, ProcDef(ins, outs, refs, b)); proc_defs(rest)]
    case [_; rest] => proc_defs(rest)
  end

function constr_positions(cs: List[Cmd]): List[Name * Int] :=
  match cs
    case Nil => Nil
    case [CData(_, _, ks); rest] => zip([k.name for k in ks], numbers_from(0, length(ks))) ++ constr_positions(rest)
    case [_; rest] => constr_positions(rest)
  end

function numbers_from(i: Int, n: Int): List[Int] :=
  if n == 0 then Nil else [i; numbers_from(i + 1, n - 1)]

function constr_defs(cs: List[Cmd]): List[Name * Int] :=
  match cs
    case Nil => Nil
    case [CData(_, _, ks); rest] => [constr_arity(k) for k in ks] ++ constr_defs(rest)
    case [_; rest] => constr_defs(rest)
  end

function constr_arity(k: Constr): Name * Int :=
  match k
    case Constr(n, ts) => (n, length(ts))
  end

function builtin_names(): Set[Id] :=
  {
    "+", "-", "*", "/", "%", "<", "==", "chars", "string", "ord", "chr", "^", "str_size", "str_join", "str_slice", "str_split", "compare",
    "str_get", "str_contains", "str_compare", "str_show", "str_quote", "str_number", "is_digit", "is_letter", "is_space"
  }

function is_builtin(n: Name): Bool :=
  match n
    case Name(None, b) => member(b, builtin_names())
    else false
  end

function is_function(v: Value): Bool :=
  match v
    case Lit(_) => false
    case Obj(_, _) => false
    else true
  end

function truth(v: Value): Bool :=
  v == Lit(VBool(true))

function lambdas(xss: List[List[Var]], b: Expr): Expr :=
  match xss
    case Nil => b
    case [xs; rest] => ELam(xs, lambdas(rest, b))
  end

function str_values(vs: List[Value]): List[Str] :=
  match vs
    case [Lit(VStr(s)); rest] => [s; str_values(rest)]
    else Nil
  end

function char_values(vs: List[Value]): List[Char] :=
  match vs
    case [Lit(VChar(c)); rest] => [c; char_values(rest)]
    else Nil
  end

function bind_values(xs: List[Var], vs: List[Value]): Bindings :=
  zip(names(xs), vs)

function matches(p: Pat, v: Value): Option[Bindings] :=
  match (p, v)
    case (PWild, _) => Some(Nil)
    case (PLit(l), _) => if v == Lit(l) then Some(Nil) else None
    case (PVar(Var(n, _)), _) => Some([(n, v)])
    case (PApp(c, ps), Obj(d, vs)) => if c == d then matches_all(ps, vs) else None
    case (PApp(_, _), _) => None
    case (PTuple(ps), Obj(n, vs)) if n == tuple_name() => matches_all(ps, vs)
    case (PTuple(_), _) => None
  end

function matches_all(ps: List[Pat], vs: List[Value]): Option[Bindings] :=
  match (ps, vs)
    case (Nil, Nil) => Some(Nil)
    case ([p; ps1], [v; vs1]) =>
      match matches(p, v)
        case Some(bs) =>
          match matches_all(ps1, vs1)
            case Some(cs) => Some(bs ++ cs)
            case None => None
          end
        case None => None
      end
    else None
  end


function read_cell(h: Heap, a: Int): Option[Value] :=
  match get(a, h.cells)
    case Some(c) => c
    case None => None
  end

function address_of(store: Store, n: Name): Int :=
  match lookup(n, store)
    case Some(a) => a
    case None => -1
  end

// the values of the assigned variables, where unassigned cells hide the variables of the same name further out
function values_of(store: Store, h: Heap): Bindings :=
  assigned(store, h, Nil)

function assigned(store: Store, h: Heap, seen: List[Name]): Bindings :=
  match store
    case Nil => Nil
    case [(n, a); rest] =>
      if contains(n, seen) then
        assigned(rest, h, seen)
      else
        match read_cell(h, a)
          case Some(v) => [(n, v); assigned(rest, h, [n; seen])]
          case None => assigned(rest, h, [n; seen])
        end
  end

procedure alloc(in c: Option[Value], out a: Int, ref h: Heap) :=
  assign a := h.next, h := h with cells := put(h.next, c, h.cells), next := h.next + 1

procedure write_cell(in a: Int, v: Value, ref h: Heap) :=
  assign h := h with cells := put(a, Some(v), h.cells)

procedure alloc_vars(in xs: List[Var], out store: Store, ref h: Heap) :=
  local a: Int, rest: Store

  match xs
    case Nil =>
      assign store := Nil
    case [x; more] =>
      call   alloc(in None, out a, ref h)
      call   alloc_vars(in more, out rest, ref h)
      assign store := [(x.name, a); rest]
  end

procedure alloc_bindings(in bs: Bindings, out store: Store, ref h: Heap) :=
  local a: Int, rest: Store

  match bs
    case Nil =>
      assign store := Nil
    case [(n, v); more] =>
      call   alloc(in Some(v), out a, ref h)
      call   alloc_bindings(in more, out rest, ref h)
      assign store := [(n, a); rest]
  end

procedure write_vars(in store: Store, xs: List[Var], vs: List[Value], ref h: Heap) :=
  match (xs, vs)
    case ([x; xs1], [v; vs1]) =>
      call   write_cell(in address_of(store, x.name), v, ref h)
      call   write_vars(in store, xs1, vs1, ref h)
    else
      skip
  end

procedure read_outs(in p: Name, outs: Store, h: Heap, out vs: List[Value]) :=
  local rest: List[Value]

  match outs
    case Nil =>
      assign vs := Nil
    case [(n, a); more] =>
      match read_cell(h, a)
        case Some(v) =>
          call   read_outs(in p, more, h, out rest)
          assign vs := [v; rest]
        case None =>
          raise UnassignedOutput(n, p)
      end
  end

procedure evaluate(in p: Prog, env: Bindings, e: Expr, out v: Value, ref h: Heap) :=
  local w: Value, vs: List[Value], envs: List[Bindings], sel: Option[Expr * Bindings]

  match e
    case ELit(l) =>
      assign v := Lit(l)

    case EVar(Var(n, t)) =>
      assign v := variable_value(p, env, n, t)

    case EApp(f, args) =>
      call apply_expr(in p, env, f, args, out v, ref h)

    case ELam(xs, body) =>
      assign v := Clos(env, xs, body)

    case EProc(xs, ys, zs, body) =>
      assign v := ProcClos(env, xs, ys, zs, body)
    // the variables are bound in parallel

    case ELet(bound, body) =>
      call   evaluate_all(in p, env, seconds(bound), out vs, ref h)
      call   evaluate(in p, bind_values(firsts(bound), vs) ++ env, body, out v, ref h)

    case EIte(cond, left, right) =>
      call evaluate(in p, env, cond, out w, ref h)
      if truth(w)
        call evaluate(in p, env, left, out v, ref h)
      else
        call evaluate(in p, env, right, out v, ref h)
      end

    case EMatch(arg, cases) =>
      call   evaluate(in p, env, arg, out w, ref h)
      call   select(in p, env, w, cases, out sel, ref h)
      match sel
        case Some((body, bs)) =>
          call evaluate(in p, bs ++ env, body, out v, ref h)
        case None =>
          raise NoCase(w)
      end

    case EComp(result, xs, lists, cond) =>
      call   combinations(in p, env, xs, lists, out envs, ref h)
      call   comprehension(in p, envs, result, cond, out vs, ref h)
      assign v := list_value(vs)
    // tuples are objects of the constructor ,

    case ETuple(items) =>
      call   evaluate_all(in p, env, items, out vs, ref h)
      assign v := Obj(tuple_name(), vs)

    case ERaise(arg, t) =>
      call evaluate(in p, env, arg, out v, ref h)
      raise Thrown(v, t)
  end

procedure evaluate_all(in p: Prog, env: Bindings, es: List[Expr], out vs: List[Value], ref h: Heap) :=
  local v: Value, rest: List[Value]

  match es
    case Nil =>
      assign vs := Nil
    case [e; more] =>
      call   evaluate(in p, env, e, out v, ref h)
      call   evaluate_all(in p, env, more, out rest, ref h)
      assign vs := [v; rest]
  end

function variable_value(p: Prog, env: Bindings, n: Name, t: Type): Value :=
  match lookup(n, env)
    case Some(w) => w
    case None =>
      match lookup((n, arity(t)), p.funs)
        case Some(_) => Fn(n, arity(t))
        case None =>
          match lookup(n, p.constrs)
            case Some(k) => if k == 0 then Obj(n, Nil) else Con(n)
            case None if has_key(n, p.procs) => Proc(n)
            case None => if is_builtin(n) then Prim(n) else raise Uninitialized(n)
          end
      end
  end

// and, or are not strict and therefore not builtins
procedure apply_expr(in p: Prog, env: Bindings, f: Expr, args: List[Expr], out v: Value, ref h: Heap) :=
  local a: Value, g: Value, vs: List[Value]

  match (f, args)
    case (EVar(Var(Name(None, "and"), _)), [l, r]) =>
      call evaluate(in p, env, l, out a, ref h)
      if truth(a)
        call evaluate(in p, env, r, out v, ref h)
      else
        assign v := a
      end
    case (EVar(Var(Name(None, "or"), _)), [l, r]) =>
      call evaluate(in p, env, l, out a, ref h)
      if truth(a)
        assign v := a
      else
        call evaluate(in p, env, r, out v, ref h)
      end
    else
      call   evaluate(in p, env, f, out g, ref h)
      call   evaluate_all(in p, env, args, out vs, ref h)
      call   apply_value(in p, g, vs, out v, ref h)
  end

procedure apply_value(in p: Prog, f: Value, vs: List[Value], out v: Value, ref h: Heap) :=
  local k: Int

  match f
    case Clos(env, xs, body) =>
      call evaluate(in p, bind_values(xs, vs) ++ env, body, out v, ref h)

    case Fn(n, k) =>
      match lookup((n, k), p.funs)
        case Some(([Nil], body)) =>
          call cached(in p, n, body, out v, ref h)

        case Some(([xs], body)) =>
          call evaluate(in p, bind_values(xs, vs), body, out v, ref h)
        // further lists of parameters are closures over the arguments so far

        case Some(([xs, ys; rest], body)) =>
          assign v := Clos(bind_values(xs, vs), ys, lambdas(rest, body))

        case Some((Nil, _)) =>
          raise Uninitialized(n)

        case None =>
          raise Uninitialized(n)
      end

    case Con(n) =>
      assign v := Obj(n, vs)

    case Prim(n) =>
      match (n.base, vs)
        case ("compare", [a, b]) =>
          call   compare_values(in p, a, b, out k)
          assign v := Lit(VInt(k))
        else
          call primitive(in n, vs, out v)
      end

    else
      raise NotFunction(f)
  end

// the value of a function without parameters, which is computed once, since expressions are deterministic,
// where p.computing are the functions whose values are being computed, which detects a value that needs itself,
// and which an exception leaves, unlike the heap, such that the next call computes the value again
procedure cached(in p: Prog, n: Name, body: Expr, out v: Value, ref h: Heap) :=
  match lookup(n, h.values)
    case Some(w) =>
      assign v := w
    case None if contains(n, p.computing) =>
      raise RecursiveInitialization(n)
    case None =>
      call   evaluate(in (p with computing := [n; p.computing]), Nil, body, out v, ref h)
      assign h := h with values := [(n, v); h.values]
  end

// an exception of a builtin, of a type of the prelude
function failure(n: Name, args: List[Value]): Thrown :=
  Thrown(Obj(n, args), TSort(n, Nil))

procedure primitive(in n: Name, vs: List[Value], out v: Value) :=
  local r: Bool

  match (n.base, vs)
    case ("+", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a + b))

    case ("-", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a - b))

    case ("*", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a * b))

    case ("/", [Lit(VInt(_)), Lit(VInt(0))]) =>
      raise failure(division_by_zero_name(), Nil)

    case ("/", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a / b))

    case ("%", [Lit(VInt(_)), Lit(VInt(0))]) =>
      raise failure(division_by_zero_name(), Nil)

    case ("%", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a % b))

    case ("<", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VBool(a < b))

    case ("==", [a, b]) =>
      call   equal(in a, b, out r)
      assign v := Lit(VBool(r))
    // strings are converted with the builtins of the interpreter of this program

    case ("chars", [Lit(VStr(s))]) =>
      assign v := list_value([Lit(VChar(c)) for c in chars(s)])

    case ("string", [w]) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := Lit(VStr(string(char_values(ws))))
        else
          raise NotList(w)
      end

    case ("ord", [Lit(VChar(c))]) =>
      assign v := Lit(VInt(ord(c)))

    case ("chr", [Lit(VInt(k))]) =>
      if k < 0 or k > 65535
        raise failure(no_character_name(), [Lit(VInt(k))])
      end

      assign v := Lit(VChar(chr(k)))

    case ("^", [Lit(VStr(s)), Lit(VStr(t))]) =>
      assign v := Lit(VStr(s ^ t))

    case ("str_size", [Lit(VStr(s))]) =>
      assign v := Lit(VInt(str_size(s)))

    case ("str_join", [Lit(VStr(sep)), w]) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := Lit(VStr(str_join(sep, str_values(ws))))
        else
          raise NotList(w)
      end

    // from i up to but excluding j, where i <= j are indices of s or its end
    case ("str_slice", [Lit(VStr(s)), Lit(VInt(i)), Lit(VInt(j))]) =>
      if i < 0 or i > str_size(s) or i > j
        raise failure(no_index_name(), [Lit(VStr(s)), Lit(VInt(i))])
      else if j > str_size(s)
        raise failure(no_index_name(), [Lit(VStr(s)), Lit(VInt(j))])
      end

      assign v := Lit(VStr(str_slice(s, i, j)))

    case ("str_split", [Lit(VStr(s)), Lit(VChar(c))]) =>
      assign v := list_value([Lit(VStr(part)) for part in str_split(s, c)])

    case ("str_get", [Lit(VStr(s)), Lit(VInt(i))]) =>
      if i < 0 or i >= str_size(s)
        raise failure(no_index_name(), [Lit(VStr(s)), Lit(VInt(i))])
      end

      assign v := Lit(VChar(str_get(s, i)))

    case ("str_contains", [Lit(VStr(s)), Lit(VChar(c))]) =>
      assign v := Lit(VBool(str_contains(s, c)))

    case ("str_compare", [Lit(VStr(s)), Lit(VStr(t))]) =>
      assign v := Lit(VInt(str_compare(s, t)))

    case ("str_show", [Lit(VInt(k))]) =>
      assign v := Lit(VStr(str_show(k)))

    case ("str_quote", [Lit(VStr(s))]) =>
      assign v := Lit(VStr(str_quote(s)))

    case ("str_number", [Lit(VStr(s))]) =>
      match str_number(s)
        case Some(k) =>
          assign v := Obj(some_name(), [Lit(VInt(k))])
        case None =>
          assign v := Obj(none_name(), Nil)
      end

    case ("is_digit", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_digit(c)))

    case ("is_letter", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_letter(c)))

    case ("is_space", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_space(c)))

    else
      raise Unspecified(n, vs)
  end

procedure equal(in a: Value, b: Value, out r: Bool) :=
  if is_function(a) or is_function(b)
    raise CompareFunctions
  end
  match (a, b)
    case (Obj(c, xs), Obj(d, ys)) =>
      if c == d and length(xs) == length(ys)
        call equal_all(in xs, ys, out r)
      else
        assign r := false
      end
    else
      assign r := a == b
  end

// -1, 0, or 1 for values of the same type, where constructors are ordered by their declaration and then by their fields
procedure compare_values(in p: Prog, a: Value, b: Value, out r: Int) :=
  if is_function(a) or is_function(b)
    raise CompareFunctions
  end

  match (a, b)
    case (Lit(VInt(x)), Lit(VInt(y))) =>
      assign r := order(x, y)

    case (Lit(VChar(x)), Lit(VChar(y))) =>
      assign r := order(ord(x), ord(y))

    case (Lit(VBool(x)), Lit(VBool(y))) =>
      assign r := order(if x then 1 else 0, if y then 1 else 0)

    case (Lit(VStr(x)), Lit(VStr(y))) =>
      assign r := str_compare(x, y)

    case (Obj(c, xs), Obj(d, ys)) =>
      if c == d
        call compare_all(in p, xs, ys, out r)
      else
        assign r := order(position_of(p, c), position_of(p, d))
      end

    else
      assign r := 0
  end

procedure compare_all(in p: Prog, xs: List[Value], ys: List[Value], out r: Int) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call compare_values(in p, x, y, out r)

      if r == 0
        call compare_all(in p, xs1, ys1, out r)
      end
    else
      assign r := order(length(xs), length(ys))
  end

function order(x: Int, y: Int): Int :=
  if x < y then -1 else if y < x then 1 else 0

procedure equal_all(in xs: List[Value], ys: List[Value], out r: Bool) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call equal(in x, y, out r)
      if r
        call equal_all(in xs1, ys1, out r)
      end
    else
      assign r := true
  end

// env extended by all combinations of elements of lists
procedure combinations(in p: Prog, env: Bindings, xs: List[Var], lists: List[Expr], out envs: List[Bindings], ref h: Heap) :=
  local l: Value

  match (xs, lists)
    case ([x; ys], [e; more]) =>
      call evaluate(in p, env, e, out l, ref h)
      match list_elements(l)
        case Some(vs) =>
          call extend(in p, env, x, vs, ys, more, out envs, ref h)
        case None =>
          raise NotList(l)
      end
    else
      assign envs := [env]
  end

procedure extend(in p: Prog, env: Bindings, x: Var, vs: List[Value], ys: List[Var], lists: List[Expr], out envs: List[Bindings], ref h: Heap) :=
  local first: List[Bindings], rest: List[Bindings]

  match vs
    case Nil =>
      assign envs := Nil
    case [v; more] =>
      call   combinations(in p, [(x.name, v); env], ys, lists, out first, ref h)
      call   extend(in p, env, x, more, ys, lists, out rest, ref h)
      assign envs := first ++ rest
  end

procedure comprehension(in p: Prog, envs: List[Bindings], result: Expr, cond: Expr, out vs: List[Value], ref h: Heap) :=
  local b: Value, r: Value, rest: List[Value]

  match envs
    case Nil =>
      assign vs := Nil
    case [env; more] =>
      call evaluate(in p, env, cond, out b, ref h)
      if truth(b)
        call   evaluate(in p, env, result, out r, ref h)
        call   comprehension(in p, more, result, cond, out rest, ref h)
        assign vs := [r; rest]
      else
        call comprehension(in p, more, result, cond, out vs, ref h)
      end
  end

procedure exec(in p: Prog, store: Store, x: Stmt, ref h: Heap) :=
  local v: Value, w: Value, vs: List[Value], r: Bool, inner: Store, sel: Option[Stmt * Bindings]

  match x
    case SSkip =>
      skip
    // the variables are assigned in parallel

    case SAssign(pairs) =>
      call   evaluate_all(in p, values_of(store, h), seconds(pairs), out vs, ref h)
      call   write_vars(in store, firsts(pairs), vs, ref h)

    case SBlock(locals, body) =>
      call   alloc_vars(in locals, out inner, ref h)
      call   exec_all(in p, inner ++ store, body, ref h)

    case SIf(cond, left, right) =>
      call evaluate(in p, values_of(store, h), cond, out v, ref h)
      if truth(v)
        call exec(in p, store, left, ref h)
      else
        call exec(in p, store, right, ref h)
      end

    case SWhile(cond, body) =>
      call evaluate(in p, values_of(store, h), cond, out v, ref h)

      while truth(v)
        call   exec(in p, store, body, ref h)
        call   evaluate(in p, values_of(store, h), cond, out v, ref h)
      end

    // a variable of a procedure type hides the procedures of that name
    case SCall(n, ins, outs, refs) =>
      call evaluate_all(in p, values_of(store, h), ins, out vs, ref h)

      match lookup(n, values_of(store, h))
        case Some(f) =>
          call invoke_value(in p, f, vs, [address_of(store, y.name) for y in refs], out vs, ref h)
        case None =>
          call invoke(in p, n, vs, [address_of(store, y.name) for y in refs], out vs, ref h)
      end

      call write_vars(in store, outs, vs, ref h)

    case SMatch(arg, cases) =>
      call   evaluate(in p, values_of(store, h), arg, out v, ref h)
      call   select(in p, values_of(store, h), v, cases, out sel, ref h)
      match sel
        case Some((body, bs)) =>
          call   alloc_bindings(in bs, out inner, ref h)
          call   exec(in p, inner ++ store, body, ref h)
        case None =>
          raise NoCase(v)
      end
    // assertions of equations show both sides when they fail

    case SAssert(EApp(EVar(Var(Name(None, "=="), _)), [lhs, rhs])) =>
      call   evaluate(in p, values_of(store, h), lhs, out v, ref h)
      call   evaluate(in p, values_of(store, h), rhs, out w, ref h)
      call   equal(in v, w, out r)
      if not r
        raise AssertionUnequal(v, w)
      end

    case SAssert(cond) =>
      call evaluate(in p, values_of(store, h), cond, out v, ref h)
      if not truth(v)
        raise AssertionFailed
      end

    case SRaise(arg, t) =>
      call   evaluate(in p, values_of(store, h), arg, out v, ref h)
      raise  Thrown(v, t)

    case STry(body, handlers) =>
      try
        call exec(in p, store, body, ref h)
      catch
        case Thrown(u, t) =>
          call handle(in p, store, handlers, u, t, ref h)
      end
  end

procedure exec_all(in p: Prog, store: Store, xs: List[Stmt], ref h: Heap) :=
  match xs
    case Nil =>
      skip
    case [x; more] =>
      call   exec(in p, store, x, ref h)
      call   exec_all(in p, store, more, ref h)
  end

// the first case whose pattern matches v and whose guard holds
procedure select[A](in p: Prog, env: Bindings, v: Value, cases: List[Branch[A]], out sel: Option[A * Bindings], ref h: Heap) :=
  local ok: Bool

  match cases
    case Nil =>
      assign sel := None
    case [Branch(q, g, b); rest] =>
      match matches(q, v)
        case Some(bs) =>
          call holds(in p, bs ++ env, g, out ok, ref h)
          if ok
            assign sel := Some((b, bs))
          else
            call select(in p, env, v, rest, out sel, ref h)
          end
        case None =>
          call select(in p, env, v, rest, out sel, ref h)
      end
  end

procedure holds(in p: Prog, env: Bindings, g: Option[Expr], out ok: Bool, ref h: Heap) :=
  local w: Value

  match g
    case Some(e) =>
      call   evaluate(in p, env, e, out w, ref h)
      assign ok := truth(w)
    case None =>
      assign ok := true
  end

// the first handler of v of type t whose guard holds, where _ handles exceptions of any type, or else raises v again
procedure handle(in p: Prog, store: Store, hs: List[Handler], v: Value, t: Type, ref h: Heap) :=
  local inner: Store, ok: Bool

  match hs
    case Nil =>
      raise Thrown(v, t)
    case [Handler(_, PWild, g, body); rest] =>
      call holds(in p, values_of(store, h), g, out ok, ref h)
      if ok
        call exec(in p, store, body, ref h)
      else
        call handle(in p, store, rest, v, t, ref h)
      end
    // the type is compared first, since the pattern and the guard assume it
    case [Handler(u, q, g, body); rest] =>
      assign ok := false
      if u == t
        match matches(q, v)
          case Some(bs) =>
            call holds(in p, bs ++ values_of(store, h), g, out ok, ref h)
            if ok
              call   alloc_bindings(in bs, out inner, ref h)
              call   exec(in p, inner ++ store, body, ref h)
            end
          else
            skip
        end
      end
      if not ok
        call handle(in p, store, rest, v, t, ref h)
      end
  end

procedure invoke(in p: Prog, n: Name, ins: List[Value], refs: List[Int], out outs: List[Value], ref h: Heap) :=
  local in_cells: Store, out_cells: Store

  match lookup(n, p.procs)
    case Some(ProcDef(xs, ys, zs, body)) =>
      call   alloc_bindings(in bind_values(xs, ins), out in_cells, ref h)
      call   alloc_vars(in ys, out out_cells, ref h)
      call   exec(in p, in_cells ++ out_cells ++ zip(names(zs), refs), body, ref h)
      call   read_outs(in n, out_cells, h, out outs)
    case None if n.base == "os_show" =>
      assign outs := Nil, h := h with printed := reverse([show_value(v) for v in ins]) ++ h.printed
    case None if n.base == "os_print" =>
      assign outs := Nil, h := h with printed := reverse([text_of(v) for v in ins]) ++ h.printed
    case None =>
      call os_proc(in n, ins, out outs)
  end

// the variables around a lambda get cells of their own, which the checker does not let it assign
procedure invoke_value(in p: Prog, f: Value, ins: List[Value], refs: List[Int], out outs: List[Value], ref h: Heap) :=
  local around: Store, in_cells: Store, out_cells: Store

  match f
    case Proc(n) =>
      call invoke(in p, n, ins, refs, out outs, ref h)
    case ProcClos(env, xs, ys, zs, body) =>
      call   alloc_bindings(in env, out around, ref h)
      call   alloc_bindings(in bind_values(xs, ins), out in_cells, ref h)
      call   alloc_vars(in ys, out out_cells, ref h)
      call   exec(in p, in_cells ++ out_cells ++ zip(names(zs), refs) ++ around, body, ref h)
      call   read_outs(in unqualified("lambda"), out_cells, h, out outs)
    else
      raise NotProc(f)
  end

// the procedures of the library os are those of the interpreter of this program, whose OsError the program can catch
procedure os_proc(in n: Name, ins: List[Value], out outs: List[Value]) :=
  local text: Str, args: List[Str]

  try
    match (n.base, ins)
      case ("os_args", []) =>
        call   os_args(out args)
        assign outs := [list_value([Lit(VStr(a)) for a in args])]

      case ("os_read", [Lit(VStr(path))]) =>
        call   os_read(in path, out text)
        assign outs := [Lit(VStr(text))]

      case ("os_write", [Lit(VStr(path)), Lit(VStr(t))]) =>
        call   os_write(in path, t)
        assign outs := Nil

      case ("os_library", [Lit(VStr(name))]) =>
        call   os_library(in name, out text)
        assign outs := [Lit(VStr(text))]

      else
        raise UnknownProc(n)
    end
  catch
    case OsError(m) =>
      raise Thrown(Obj(os_error_name(), [Lit(VStr(m))]), TSort(os_error_name(), Nil))
  end

// runs the runs and tests of cs
procedure run_all(in p: Prog, cs: List[Cmd], ref h: Heap) :=
  match cs
    case Nil =>
      skip
    case [CRun(_, body); more] =>
      call exec(in p, Nil, body, ref h)
      call run_all(in p, more, ref h)
    case [CTest(_, body); more] =>
      call exec(in p, Nil, body, ref h)
      call run_all(in p, more, ref h)
    case [_; more] =>
      call run_all(in p, more, ref h)
  end

// the lines that a checked program printed, where failed assertions are errors
procedure run_program(in q: Program, out vs: List[Str]) :=
  local h := Heap(empty(), 0, Nil, Nil)

  call   run_all(in load(q), q.cmds, ref h)
  assign vs := reverse(h.printed)

// checks and runs the commands
procedure check_and_run(in cs: List[Cmd], out vs: List[Str]) :=
  local q: Program

  call   check_program(in Program(cs), "main", out q)
  call   run_program(in q, out vs)

// the module os of the library, which declares OsError and thereby enables os_show
function os_module(): List[Cmd] :=
  [CModule("os", [CData(unqualified("OsError"), Nil, [Constr(unqualified("OsError"), [tstr()])])]), CImport("os")]

// the run n that shows e, which needs os_module
function printing(n: Id, e: Expr): Cmd :=
  CRun(n, SBlock(Nil, [SCall(unqualified("os_show"), [e], Nil, Nil)]))

// a run that assigns e to a local variable
function assigning(e: Expr): Cmd :=
  CRun("a", SBlock([hole_var("v")], [SAssign([(hole_var("v"), e)])]))

function int(n: Int): Value :=
  Lit(VInt(n))

test expressions :=
  local os: List[Str]

  call check_and_run(in os_module() ++ lists() ++
    [
      printing("p1", ap("len", [ap("Cons", [num(1), ap("Cons", [num(2), ev("Nil")])])])),
      // let f = lambda x => x * x in f(3) + f(4)
      printing("p2", ELet([(Var(unqualified("f"), THole), ELam([Var(unqualified("x"), THole)], ap("*", [ev("x"), ev("x")])))], ap("+", [ap("f", [num(3)]), ap("f", [num(4)])]))),
      // [x * y for x in [1, 2], y in [x, 3] if x < y]
      printing("p3", 
        EComp(
          ap("*", [ev("x"), ev("y")]),
          [Var(unqualified("x"), THole), Var(unqualified("y"), THole)],
          [ap("Cons", [num(1), ap("Cons", [num(2), ev("Nil")])]), ap("Cons", [ev("x"), ap("Cons", [num(3), ev("Nil")])])],
          ap("<", [ev("x"), ev("y")])
        )
      ),
      // false and 1 / 0 == 0
      printing("p4", ap("and", [ELit(VBool(false)), ap("==", [ap("/", [num(1), num(0)]), num(0)])]))
    ], out os)
  assert
    os ==
    [
      "2",
      "25",
      "[3, 6]",
      "false"
    ]

// procedure sum(in n: Int, out s: Int) with a loop, and procedure count(ref k: Int) raising Fail after an increment
function procedures(): List[Cmd] :=
  [
    CData(unqualified("Fail"), Nil, [Constr(unqualified("Fail"), [tint()])]),
    CProc(
      unqualified("sum"),
      Nil,
      [Var(unqualified("n"), tint())],
      [Var(unqualified("s"), tint())],
      Nil,
      SBlock(
        [Var(unqualified("i"), tint())],
        [
          SAssign([(Var(unqualified("s"), THole), num(0)), (Var(unqualified("i"), THole), num(0))]),
          SWhile(
            ap("<", [ev("i"), ev("n")]),
            SBlock(Nil, [SAssign([(Var(unqualified("i"), THole), ap("+", [ev("i"), num(1)])), (Var(unqualified("s"), THole), ap("+", [ev("s"), ap("+", [ev("i"), num(1)])]))])])
          )
        ]
      )
    ),
    CProc(
      unqualified("count"),
      Nil,
      Nil,
      Nil,
      [Var(unqualified("k"), tint())],
      SBlock(Nil, [SAssign([(Var(unqualified("k"), THole), ap("+", [ev("k"), num(1)]))]), SRaise(ap("Fail", [ev("k")]), THole)])
    )
  ]

test procedures :=
  local os: List[Str]

  call check_and_run(in os_module() ++ procedures() ++
    [
      CRun("sum", SBlock([Var(unqualified("s"), tint())], [SCall(unqualified("sum"), [num(4)], [Var(unqualified("s"), THole)], Nil), print_var("s")])),
      // the assignment to k before the exception remains, and the handler for Fail binds its argument
      CRun(
        "count",
        SBlock(
          [Var(unqualified("k"), tint()), Var(unqualified("m"), tint())],
          [
            SAssign([(Var(unqualified("k"), THole), num(1))]),
            STry(
              SBlock(Nil, [SCall(unqualified("count"), Nil, Nil, [Var(unqualified("k"), THole)])]),
              [Handler(THole, PApp(unqualified("Fail"), [pv("j")]), None, SBlock(Nil, [SAssign([(Var(unqualified("m"), THole), ev("j"))])]))]
            ),
            print_var("k"),
            print_var("m")
          ]
        )
      )
    ], out os)
  assert os == ["10", "2", "2"]

// os_show in a module that imports os
test printing :=
  local os: List[Str]

  call check_and_run(in os_module() ++
    [
      CRun("r", SBlock([Var(unqualified("x"), tint())], [SAssign([(hole_var("x"), num(1))]), SCall(unqualified("os_show"), [ev("x")], Nil, Nil)]))
    ], out os)
  assert os == ["1"]

// a declared procedure and a lambda that captures k, called through variables
test procedure_values :=
  local os: List[Str]

  call check_and_run(in os_module() ++ procedures() ++
    [
      CRun(
        "values",
        SBlock(
          [Var(unqualified("s"), tint()), Var(unqualified("t"), tint())],
          [
            SBlock(
              [hole_var("f"), hole_var("k"), hole_var("g")],
              [
                SAssign([(hole_var("f"), ev("sum"))]),
                SAssign([(hole_var("k"), num(10))]),
                SAssign([(hole_var("g"), EProc([hole_var("n")], [hole_var("r")], Nil, SBlock(Nil, [SAssign([(hole_var("r"), ap("+", [ev("n"), ev("k")]))])])))]),
                SCall(unqualified("f"), [num(4)], [hole_var("s")], Nil),
                SCall(unqualified("g"), [num(4)], [hole_var("t")], Nil)
              ]
            ),
            print_var("s"),
            print_var("t")
          ]
        )
      )
    ], out os)
  assert os == ["10", "14"]

function hole_var(n: Id): Var :=
  Var(unqualified(n), THole)

function print_var(n: Id): Stmt :=
  SCall(unqualified("os_show"), [ev(n)], Nil, Nil)

test errors :=
  local os: List[Str]

  try
    call   check_and_run(in procedures() ++ [CTest("t", SBlock(Nil, [SRaise(ap("Fail", [num(1)]), THole)]))], out os)
    assert false
  catch
    case Thrown(v, t) =>
      assert v == Obj(Name(Some("main"), "Fail"), [int(1)])
      assert t == TSort(Name(Some("main"), "Fail"), Nil)
  end
  try
    call   check_and_run(in [CTest("t", SBlock(Nil, [SAssert(ap("==", [num(1), num(2)]))]))], out os)
    assert false
  catch
    case AssertionUnequal(a, b) =>
      assert (a, b) == (int(1), int(2))
  end
  try
    call   check_and_run(in [assigning(ap("/", [num(1), num(0)]))], out os)
    assert false
  catch
    case Thrown(Obj(n, _), _) if n == division_by_zero_name() =>
      skip
  end
  // loop() := loop() + 1 needs its own value
  try
    call   check_and_run(in [CFun(unqualified("loop"), Nil, [Nil], tint(), ap("+", [ap("loop", []), num(1)])), assigning(ap("loop", []))], out os)
    assert false
  catch
    case RecursiveInitialization(n) =>
      assert n.base == "loop"
  end

// add(a: Int)(b: Int): Int := a + b, applied partially
test curried :=
  local os: List[Str]

  call check_and_run(
    in os_module() ++ [
      CFun(unqualified("add"), Nil, [[Var(unqualified("a"), tint())], [Var(unqualified("b"), tint())]], tint(), ap("+", [ev("a"), ev("b")])),
      printing("p", EApp(ap("add", [num(1)]), [num(2)]))
    ],
    out os
  )
  assert os == ["3"]

// match (1, true, 3) case (_, _, z) => z end, a flat tuple
test tuples :=
  local os: List[Str]

  call   check_and_run(in os_module() ++ [printing("p", EMatch(ETuple([num(1), ELit(VBool(true)), num(3)]), [Branch(PTuple([PWild, PWild, pv("z")]), None, ev("z"))]))], out os)
  assert os == ["3"]

// a handler for integers skips a string without evaluating its guard, so the string is raised further
test handler_types :=
  local os: List[Str]

  try
    call   check_and_run(in [CTest("t", STry(SRaise(ELit(VStr("x")), THole), [Handler(THole, pv("k"), Some(ap("<", [ev("k"), num(2)])), SSkip)]))], out os)
    assert false
  catch
    case Thrown(v, _) =>
      assert v == Lit(VStr("x"))
  end
