// the interpreter of ulang, which runs programs of self/syntax.u that self/check.u has checked,
// where statements update the values of the variables in scope, which a call passes to a procedure and back,
// and errors are values of RuntimeError, while the exceptions of the program are values of Thrown

import syntax
import value
import print

import check
import defs

import os
import set
import map
import array

export

// the state of a run: the definitions of the program, the functions without parameters whose values are being computed,
// and the arguments of the program
data Run :=
  | Run(defs: Defs, computing: List[Name], args: List[Str])

data RuntimeError :=
  | Uninitialized(Name)
  | NotFunction(Value)
  | Unspecified(Name, List[Value])
  // the errors that compiled code reports as well, with the values as show gives them
  | NoCase(Str)
  | CompareFunctions
  | NotList(Value)
  | AssertionFailed
  | AssertionUnequal(Str, Str)
  | Uncaught(Str)
  | UnassignedOutput(Name, Name)
  | UnknownProc(Name)
  | NotProc(Value)
  | RecursiveInitialization(Name)

// an exception of the program with its type
data Thrown :=
  | Thrown(Value, Type)

function load(q: Prog): Run
procedure run_proc(in run: Run, n: Name, ref cache: Map[Name, Value])
procedure run_cmd(in run: Run, cmd: Cmd, ref cache: Map[Name, Value])

implementation

// the values of the variables in scope, where a variable without a value is not in the map
type Bindings :=
  Map[Name, Value]

// the position of constructor k in its declaration, which orders values of different constructors
function position_of(run: Run, k: Name): Int :=
  match get(k, run.defs.constrs)
    case Some((_, i, _)) => i
    case None => 0
  end

// the function of the map fs, by datatype, that orders, equates, or shows the values of the datatype of constructor k
function declared_for(run: Run, k: Name, fs: Map[Name, Name]): Option[Name] :=
  match get(k, run.defs.constrs)
    case Some((_, _, t)) => get(t, fs)
    case None => None
  end

function load(q: Prog): Run :=
  Run(defs_of(q), Nil, Nil)

// the builtins without a module, and the functions of the builtin sections of the prelude, str, and array
function builtin_names(): Set[Name] :=
  from_list(
    [unqualified(b) for b in ["<", "==", "compare", "show"]] ++
    [Name(Some("prelude"), b) for b in ["+", "-", "*", "/", "%", "++"]] ++
    [Name(Some("str"), b) for b in ["chars", "string", "ord", "chr", "is_digit", "is_letter", "is_space", "size", "at", "contains", "slice", "join", "split", "quote", "number"]] ++
    [Name(Some("array"), b) for b in ["array", "list", "size", "at", "put", "slice", "foldr", "foldl"]]
  )

function is_builtin(n: Name): Bool :=
  contains(n, builtin_names())

function is_function(v: Value): Bool :=
  match v
    case Lit(_) => false
    case Obj(_, _) => false
    case Arr(_) => false
    case _ => true
  end

function truth(v: Value): Bool :=
  v == Lit(VBool(true))

function lambdas(xss: List[List[Var]], b: Expr): Expr :=
  match xss
    case Nil => b
    case [xs; rest] => ELam(xs, lambdas(rest, b))
  end

function str_values(vs: List[Value]): List[Str] :=
  match vs
    case [Lit(VStr(s)); rest] => [s; str_values(rest)]
    case _ => Nil
  end

function char_values(vs: List[Value]): List[Char] :=
  match vs
    case [Lit(VChar(c)); rest] => [c; char_values(rest)]
    case _ => Nil
  end

// env where the variables xs have the values vs
function bind_all(xs: List[Var], vs: List[Value], env: Bindings): Bindings :=
  match (xs, vs)
    case ([x; xs1], [v; vs1]) => bind_all(xs1, vs1, put(x.name, v, env))
    case _ => env
  end

// env where the variables of p have the parts of v that they match, if p matches v
function match_into(pat: Pat, v: Value, env: Bindings): Option[Bindings] :=
  match (pat, v)
    case (PWild, _) => Some(env)
    case (PLit(l), _) => if v == Lit(l) then Some(env) else None
    case (PVar(Var(n, _)), _) => Some(put(n, v, env))
    case (PApp(c, ps), Obj(d, vs)) => if c == d then match_all_into(ps, vs, env) else None
    case (PApp(_, _), _) => None
    case (PTuple(ps), Obj(n, vs)) if n == tuple_name() => match_all_into(ps, vs, env)
    case (PTuple(_), _) => None
  end

function match_all_into(pats: List[Pat], vs: List[Value], env: Bindings): Option[Bindings] :=
  match (pats, vs)
    case (Nil, Nil) => Some(env)
    case ([p; ps1], [v; vs1]) =>
      match match_into(p, v, env)
        case Some(inner) => match_all_into(ps1, vs1, inner)
        case None => None
      end
    case _ => None
  end

function pattern_vars(pat: Pat): List[Name] :=
  match pat
    case PVar(Var(n, _)) => [n]
    case PApp(_, ps) => concat([pattern_vars(q) for q in ps])
    case PTuple(ps) => concat([pattern_vars(q) for q in ps])
    case _ => []
  end

procedure evaluate(in run: Run, env: Bindings, expr: Expr, out v: Value, ref cache: Map[Name, Value]) :=
  local w: Value, vs: List[Value], sel: Option[Expr * Bindings * List[Name]], s: Str

  match expr
    case ELit(l) =>
      assign v := Lit(l)

    case EVar(Var(n, t)) =>
      assign v := variable_value(run, env, n, t)

    case EApp(f, args) =>
      call apply_expr(in run, env, f, args, out v, ref cache)

    case ELam(xs, body) =>
      assign v := Clos(env, xs, body)

    case EProc(xs, ys, zs, body) =>
      assign v := ProcClos(env, xs, ys, zs, body)
    // the variables are bound in parallel

    case ELet(bound, body) =>
      call   evaluate_all(in run, env, seconds(bound), out vs, ref cache)
      call   evaluate(in run, bind_all(firsts(bound), vs, env), body, out v, ref cache)

    case EIte(cond, left, right) =>
      call evaluate(in run, env, cond, out w, ref cache)
      if truth(w)
        call evaluate(in run, env, left, out v, ref cache)
      else
        call evaluate(in run, env, right, out v, ref cache)
      end

    case EMatch(arg, cases) =>
      call   evaluate(in run, env, arg, out w, ref cache)
      call   select(in run, env, w, cases, out sel, ref cache)
      match sel
        case Some((body, inner, _)) =>
          call evaluate(in run, inner, body, out v, ref cache)
        case None =>
          call  show_in(in run, w, out s, ref cache)
          raise NoCase(s)
      end

    // tuples are objects of the constructor ,

    case ETuple(items) =>
      call   evaluate_all(in run, env, items, out vs, ref cache)
      assign v := Obj(tuple_name(), vs)

    case ERaise(arg, t) =>
      call evaluate(in run, env, arg, out v, ref cache)
      raise Thrown(v, t)
  end

procedure evaluate_all(in run: Run, env: Bindings, exprs: List[Expr], out vs: List[Value], ref cache: Map[Name, Value]) :=
  local v: Value, rest: List[Value]

  match exprs
    case Nil =>
      assign vs := Nil
    case [e; more] =>
      call   evaluate(in run, env, e, out v, ref cache)
      call   evaluate_all(in run, env, more, out rest, ref cache)
      assign vs := [v; rest]
  end

// unqualified names are local variables or builtins without a module, since the checker qualifies the names of declarations
function variable_value(run: Run, env: Bindings, n: Name, t: Type): Value :=
  match (get(n, env), n.module)
    case (Some(w), _) => w
    case (None, None) => if is_builtin(n) then Prim(n) else raise Uninitialized(n)
    case (None, Some(_)) =>
      match get((n, arity(t)), run.defs.funs)
        case Some(_) => Fn(n, arity(t))
        case None =>
          match get(n, run.defs.constrs)
            case Some((k, _, _)) => if k == 0 then Obj(n, Nil) else Con(n)
            case None if contains(n, run.defs.procs) => Proc(n)
            case None if is_builtin(n) => Prim(n)
            case None => raise Uninitialized(n)
          end
      end
  end

// and, or are not strict and therefore not builtins
procedure apply_expr(
  in  run: Run,
      env: Bindings,
      f: Expr,
      args: List[Expr],
  out v: Value,
  ref cache: Map[Name, Value]
) :=
  local a: Value, g: Value, vs: List[Value]

  match (f, args)
    case (EVar(Var(Name(None, "and"), _)), [l, r]) =>
      call evaluate(in run, env, l, out a, ref cache)
      if truth(a)
        call evaluate(in run, env, r, out v, ref cache)
      else
        assign v := a
      end
    case (EVar(Var(Name(None, "or"), _)), [l, r]) =>
      call evaluate(in run, env, l, out a, ref cache)
      if truth(a)
        assign v := a
      else
        call evaluate(in run, env, r, out v, ref cache)
      end
    case _ =>
      call   evaluate(in run, env, f, out g, ref cache)
      call   evaluate_all(in run, env, args, out vs, ref cache)
      call   apply_value(in run, g, vs, out v, ref cache)
  end

procedure apply_value(in run: Run, f: Value, vs: List[Value], out v: Value, ref cache: Map[Name, Value]) :=
  local k: Int, r: Bool, s: Str

  match f
    case Clos(env, xs, body) =>
      call evaluate(in run, bind_all(xs, vs, env), body, out v, ref cache)

    case Fn(n, k) =>
      match get((n, k), run.defs.funs)
        case Some(([Nil], body)) =>
          call cached(in run, n, body, out v, ref cache)

        case Some(([xs], body)) =>
          call evaluate(in run, bind_all(xs, vs, empty()), body, out v, ref cache)
        // further lists of parameters are closures over the arguments so far

        case Some(([xs, ys; rest], body)) =>
          assign v := Clos(bind_all(xs, vs, empty()), ys, lambdas(rest, body))

        case Some((Nil, _)) =>
          raise Uninitialized(n)

        case None =>
          raise Uninitialized(n)
      end

    case Con(n) =>
      assign v := Obj(n, vs)

    case Prim(n) =>
      match (show_name(n), vs)
        case ("compare", [a, b]) =>
          call   compare_values(in run, a, b, out k, ref cache)
          assign v := Lit(VInt(k))
        case ("==", [a, b]) =>
          call   equal(in run, a, b, out r, ref cache)
          assign v := Lit(VBool(r))
        case ("show", [a]) =>
          call   show_in(in run, a, out s, ref cache)
          assign v := Lit(VStr(s))
        // integers directly, and other values by their order
        case ("<", [Lit(VInt(a)), Lit(VInt(b))]) =>
          assign v := Lit(VBool(a < b))
        case ("<", [a, b]) =>
          call   compare_values(in run, a, b, out k, ref cache)
          assign v := Lit(VBool(k < 0))
        // the folds of arrays call f, from the last element and from the first
        case ("array.foldr", [Arr(a), acc, g]) =>
          assign k := size(a), v := acc
          while k > 0
            assign k := k - 1
            call   apply_value(in run, g, [at(k, a), v], out v, ref cache)
          end
        case ("array.foldl", [Arr(a), acc, g]) =>
          assign k := 0, v := acc
          while k < size(a)
            call   apply_value(in run, g, [v, at(k, a)], out v, ref cache)
            assign k := k + 1
          end
        case _ =>
          call primitive(in n, vs, out v)
      end

    case _ =>
      raise NotFunction(f)
  end

// the value of a function without parameters, which is computed once, since expressions are deterministic,
// where run.computing are the functions whose values are being computed, which detects a value that needs itself,
// and which an exception leaves, unlike the cache, such that the next call computes the value again
procedure cached(in run: Run, n: Name, body: Expr, out v: Value, ref cache: Map[Name, Value]) :=
  match get(n, cache)
    case Some(w) =>
      assign v := w
    case None if contains(n, run.computing) =>
      raise RecursiveInitialization(n)
    case None =>
      call   evaluate(in (run with computing := [n; run.computing]), empty(), body, out v, ref cache)
      assign cache := put(n, v, cache)
  end

// an exception of a builtin, of a type of the prelude
function failure(n: Name, args: List[Value]): Thrown :=
  Thrown(Obj(n, args), TSort(n, Nil))

procedure primitive(in n: Name, vs: List[Value], out v: Value) :=
  local r: Bool

  match (show_name(n), vs)
    case ("prelude.+", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a + b))

    case ("prelude.-", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a - b))

    case ("prelude.*", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a * b))

    case ("prelude./", [Lit(VInt(_)), Lit(VInt(0))]) =>
      raise failure(division_by_zero_name(), Nil)

    case ("prelude./", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a / b))

    case ("prelude.%", [Lit(VInt(_)), Lit(VInt(0))]) =>
      raise failure(division_by_zero_name(), Nil)

    case ("prelude.%", [Lit(VInt(a)), Lit(VInt(b))]) =>
      assign v := Lit(VInt(a % b))

    // strings are converted with the builtins of the interpreter of this program

    case ("str.chars", [Lit(VStr(s))]) =>
      assign v := list_value([Lit(VChar(c)) for c in chars(s)])

    case ("str.string", [w]) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := Lit(VStr(string(char_values(ws))))
        case _ =>
          raise NotList(w)
      end

    case ("str.ord", [Lit(VChar(c))]) =>
      assign v := Lit(VInt(ord(c)))

    case ("str.chr", [Lit(VInt(k))]) =>
      if k < 0 or k > 65535
        raise failure(no_character_name(), [Lit(VInt(k))])
      end

      assign v := Lit(VChar(chr(k)))

    case ("prelude.++", [Lit(VStr(s)), Lit(VStr(t))]) =>
      assign v := Lit(VStr(s ++ t))

    // the functions of the builtin section of str.u

    case ("str.size", [Lit(VStr(s))]) =>
      assign v := Lit(VInt(size(s)))

    case ("str.join", [Lit(VStr(sep)), w]) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := Lit(VStr(join(sep, str_values(ws))))
        case _ =>
          raise NotList(w)
      end

    // from i up to but excluding j, where i <= j are indices of s or its end
    case ("str.slice", [Lit(VStr(s)), Lit(VInt(i)), Lit(VInt(j))]) =>
      if i < 0 or i > size(s) or i > j
        raise failure(no_index_name(), [Lit(VStr(s)), Lit(VInt(i))])
      else if j > size(s)
        raise failure(no_index_name(), [Lit(VStr(s)), Lit(VInt(j))])
      end

      assign v := Lit(VStr(slice(s, i, j)))

    case ("str.split", [Lit(VStr(s)), Lit(VChar(c))]) =>
      assign v := list_value([Lit(VStr(part)) for part in split(s, c)])

    case ("str.at", [Lit(VInt(i)), Lit(VStr(s))]) =>
      if i < 0 or i >= size(s)
        raise failure(no_index_name(), [Lit(VStr(s)), Lit(VInt(i))])
      end

      assign v := Lit(VChar(at(i, s)))

    case ("str.contains", [Lit(VChar(c)), Lit(VStr(s))]) =>
      assign v := Lit(VBool(contains(c, s)))

    case ("str.quote", [Lit(VStr(s))]) =>
      assign v := Lit(VStr(quote(s)))

    case ("str.number", [Lit(VStr(s))]) =>
      match number(s)
        case Some(k) =>
          assign v := Obj(some_name(), [Lit(VInt(k))])
        case None =>
          assign v := Obj(none_name(), Nil)
      end

    case ("str.is_digit", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_digit(c)))

    case ("str.is_letter", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_letter(c)))

    case ("str.is_space", [Lit(VChar(c))]) =>
      assign v := Lit(VBool(is_space(c)))

    // the functions of the builtin section of array.u, by arrays of the interpreter of this program

    case ("array.array", [w]) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := Arr(array(ws))
        case _ =>
          raise NotList(w)
      end

    case ("array.list", [Arr(a)]) =>
      assign v := list_value(list(a))

    case ("array.size", [Arr(a)]) =>
      assign v := Lit(VInt(size(a)))

    case ("array.at", [Lit(VInt(i)), Arr(a)]) =>
      if i < 0 or i >= size(a)
        raise failure(out_of_bounds_name(), [Lit(VInt(i)), Lit(VInt(size(a)))])
      end

      assign v := at(i, a)

    case ("array.put", [Lit(VInt(i)), x, Arr(a)]) =>
      if i < 0 or i >= size(a)
        raise failure(out_of_bounds_name(), [Lit(VInt(i)), Lit(VInt(size(a)))])
      end

      assign v := Arr(put(i, x, a))

    case ("array.slice", [Arr(a), Lit(VInt(i)), Lit(VInt(j))]) =>
      if i < 0 or i > size(a) or i > j
        raise failure(out_of_bounds_name(), [Lit(VInt(i)), Lit(VInt(size(a)))])
      else if j > size(a)
        raise failure(out_of_bounds_name(), [Lit(VInt(j)), Lit(VInt(size(a)))])
      end

      assign v := Arr(slice(a, i, j))

    case _ =>
      raise Unspecified(n, vs)
  end

// values of datatypes with declared equalities or orders are compared by them, and others structurally
procedure equal(in run: Run, a: Value, b: Value, out r: Bool, ref cache: Map[Name, Value]) :=
  local v: Value, k: Int

  if is_function(a) or is_function(b)
    raise CompareFunctions
  end
  match (a, b)
    case (Obj(c, xs), Obj(d, ys)) =>
      match (declared_for(run, c, run.defs.equalities), declared_for(run, c, run.defs.orders))
        case (Some(f), _) =>
          call   apply_value(in run, Fn(f, 2), [a, b], out v, ref cache)
          assign r := truth(v)
        case (None, Some(_)) =>
          call   compare_values(in run, a, b, out k, ref cache)
          assign r := k == 0
        case (None, None) =>
          if c == d and size(xs) == size(ys)
            call equal_all(in run, xs, ys, out r, ref cache)
          else
            assign r := false
          end
      end
    case (Arr(xs), Arr(ys)) =>
      if size(xs) == size(ys)
        call equal_all(in run, list(xs), list(ys), out r, ref cache)
      else
        assign r := false
      end
    case _ =>
      assign r := a == b
  end

// -1, 0, or 1 for values of the same type, by the declared orders of datatypes, or else structurally, where
// constructors are ordered by their declaration and then by their fields
procedure compare_values(in run: Run, a: Value, b: Value, out r: Int, ref cache: Map[Name, Value]) :=
  local v: Value

  if is_function(a) or is_function(b)
    raise CompareFunctions
  end

  match (a, b)
    case (Lit(VInt(x)), Lit(VInt(y))) =>
      assign r := order(x, y)

    case (Lit(VChar(x)), Lit(VChar(y))) =>
      assign r := order(ord(x), ord(y))

    case (Lit(VBool(x)), Lit(VBool(y))) =>
      assign r := order(if x then 1 else 0, if y then 1 else 0)

    case (Lit(VStr(x)), Lit(VStr(y))) =>
      assign r := compare(x, y)

    case (Obj(c, xs), Obj(d, ys)) =>
      match declared_for(run, c, run.defs.orders)
        case Some(f) =>
          call apply_value(in run, Fn(f, 2), [a, b], out v, ref cache)
          match v
            case Lit(VInt(k)) =>
              assign r := k
            case _ =>
              raise NotFunction(v)
          end
        case None =>
          if c == d
            call compare_all(in run, xs, ys, out r, ref cache)
          else
            assign r := order(position_of(run, c), position_of(run, d))
          end
      end

    // arrays by their elements and then by their size, as lists
    case (Arr(xs), Arr(ys)) =>
      call compare_all(in run, list(xs), list(ys), out r, ref cache)

    case _ =>
      assign r := 0
  end

procedure compare_all(in run: Run, xs: List[Value], ys: List[Value], out r: Int, ref cache: Map[Name, Value]) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call compare_values(in run, x, y, out r, ref cache)

      if r == 0
        call compare_all(in run, xs1, ys1, out r, ref cache)
      end
    case _ =>
      assign r := order(size(xs), size(ys))
  end

// the text of a value as show_value of print.u gives it, where the values of datatypes with declared shows are shown by them,
// also inside other values, as lists, options, sets, and maps of the library are
procedure show_in(in run: Run, v: Value, out s: Str, ref cache: Map[Name, Value]) :=
  local w: Value, texts: List[Str]

  match v
    case Obj(c, _) if declared_for(run, c, run.defs.shows) != None =>
      match declared_for(run, c, run.defs.shows)
        case Some(f) =>
          call apply_value(in run, Fn(f, 1), [v], out w, ref cache)
          assign s := text_of(w)
        case None =>
          assign s := show_value(v)
      end
    case Obj(n, vs) if n == tuple_name() =>
      call   show_all(in run, vs, out texts, ref cache)
      assign s := "(" ++ join(", ", texts) ++ ")"
    case Obj(n, Nil) =>
      assign s := n.base
    case Obj(n, vs) =>
      call   show_all(in run, vs, out texts, ref cache)
      assign s := n.base ++ "(" ++ join(", ", texts) ++ ")"
    case Arr(a) =>
      call   show_all(in run, list(a), out texts, ref cache)
      assign s := "array([" ++ join(", ", texts) ++ "])"
    case _ =>
      assign s := show_value(v)
  end

procedure show_all(in run: Run, vs: List[Value], out texts: List[Str], ref cache: Map[Name, Value]) :=
  local s: Str, rest: List[Str]

  match vs
    case Nil =>
      assign texts := Nil
    case [v; more] =>
      call   show_in(in run, v, out s, ref cache)
      call   show_all(in run, more, out rest, ref cache)
      assign texts := [s; rest]
  end

function order(x: Int, y: Int): Int :=
  if x < y then -1 else if y < x then 1 else 0

procedure equal_all(in run: Run, xs: List[Value], ys: List[Value], out r: Bool, ref cache: Map[Name, Value]) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call equal(in run, x, y, out r, ref cache)
      if r
        call equal_all(in run, xs1, ys1, out r, ref cache)
      end
    case _ =>
      assign r := true
  end

// x updates the values of the variables in scope
procedure exec(in run: Run, x: Stmt, ref env: Bindings, cache: Map[Name, Value]) :=
  local v: Value, w: Value, vs: List[Value], r: Bool, sel: Option[Stmt * Bindings * List[Name]], s: Str, t: Str

  match x
    case SSkip =>
      skip
    // the variables are assigned in parallel

    case SAssign(pairs) =>
      call   evaluate_all(in run, env, seconds(pairs), out vs, ref cache)
      assign env := put_all(zip(names(firsts(pairs)), vs), env)

    case SBlock(locals, body) =>
      call scoped(in run, names(locals), remove_all(names(locals), env), body, ref env, cache)

    case SIf(cond, left, right) =>
      call evaluate(in run, env, cond, out v, ref cache)
      if truth(v)
        call exec(in run, left, ref env, cache)
      else
        call exec(in run, right, ref env, cache)
      end

    case SWhile(cond, body) =>
      call evaluate(in run, env, cond, out v, ref cache)

      while truth(v)
        call   exec(in run, body, ref env, cache)
        call   evaluate(in run, env, cond, out v, ref cache)
      end

    // a variable of a procedure type hides the procedures of that name
    case SCall(n, ins, outs, refs) =>
      call evaluate_all(in run, env, ins, out vs, ref cache)

      match get(n, env)
        case Some(f) =>
          call invoke_value(in run, f, vs, names(refs), out vs, ref env, cache)
        case None =>
          call invoke(in run, n, vs, names(refs), out vs, ref env, cache)
      end

      assign env := put_all(zip(names(outs), vs), env)

    case SMatch(arg, cases) =>
      call   evaluate(in run, env, arg, out v, ref cache)
      call   select(in run, env, v, cases, out sel, ref cache)
      match sel
        case Some((body, inner, ns)) =>
          call scoped(in run, ns, inner, [body], ref env, cache)
        case None =>
          call  show_in(in run, v, out s, ref cache)
          raise NoCase(s)
      end
    // assertions of equations show both sides when they fail

    case SAssert(EApp(EVar(Var(Name(None, "=="), _)), [lhs, rhs])) =>
      call   evaluate(in run, env, lhs, out v, ref cache)
      call   evaluate(in run, env, rhs, out w, ref cache)
      call   equal(in run, v, w, out r, ref cache)
      if not r
        call  show_in(in run, v, out s, ref cache)
        call  show_in(in run, w, out t, ref cache)
        raise AssertionUnequal(s, t)
      end

    case SAssert(cond) =>
      call evaluate(in run, env, cond, out v, ref cache)
      if not truth(v)
        raise AssertionFailed
      end

    case SRaise(arg, t) =>
      call   evaluate(in run, env, arg, out v, ref cache)
      raise  Thrown(v, t)

    case STry(body, handlers) =>
      try
        call exec(in run, body, ref env, cache)
      catch
        case Thrown(u, t) =>
          call handle(in run, handlers, u, t, ref env, cache)
      end
  end

procedure exec_all(in run: Run, xs: List[Stmt], ref env: Bindings, cache: Map[Name, Value]) :=
  match xs
    case Nil =>
      skip
    case [x; more] =>
      call exec(in run, x, ref env, cache)
      call exec_all(in run, more, ref env, cache)
  end

// runs the statements xs from inner in the scope of the variables names, whose values inner gives,
// where the variables of the same names outside the scope get their values back afterwards, also after an exception
procedure scoped(
  in  run: Run,
      names: List[Name],
      inner: Bindings,
      xs: List[Stmt],
  ref env: Bindings,
      cache: Map[Name, Value]
) :=
  local outer := env

  assign env := inner

  try
    call exec_all(in run, xs, ref env, cache)
  catch
    case Thrown(v, t) =>
      assign env := restored(names, outer, env)
      raise  Thrown(v, t)
  end

  assign env := restored(names, outer, env)

// env where the variables names have their values in outer, or none
function restored(names: List[Name], outer: Bindings, env: Bindings): Bindings :=
  match names
    case Nil => env
    case [n; rest] =>
      match get(n, outer)
        case Some(v) => restored(rest, outer, put(n, v, env))
        case None => restored(rest, outer, remove(n, env))
      end
  end

// the first case whose pattern matches v and whose guard holds, with env and the variables that the pattern binds
procedure select[A](
  in  run: Run,
      env: Bindings,
      v: Value,
      cases: List[Branch[A]],
  out sel: Option[A * Bindings * List[Name]],
  ref cache: Map[Name, Value]
) :=
  local ok: Bool

  match cases
    case Nil =>
      assign sel := None
    case [Branch(q, g, b); rest] =>
      match match_into(q, v, env)
        case Some(inner) =>
          call holds(in run, inner, g, out ok, ref cache)
          if ok
            assign sel := Some((b, inner, pattern_vars(q)))
          else
            call select(in run, env, v, rest, out sel, ref cache)
          end
        case None =>
          call select(in run, env, v, rest, out sel, ref cache)
      end
  end

procedure holds(in run: Run, env: Bindings, g: Option[Expr], out ok: Bool, ref cache: Map[Name, Value]) :=
  local w: Value

  match g
    case Some(e) =>
      call   evaluate(in run, env, e, out w, ref cache)
      assign ok := truth(w)
    case None =>
      assign ok := true
  end

// the first handler of v of type t whose guard holds, where _ handles exceptions of any type, or else raises v again
procedure handle(in run: Run, hs: List[Handler], v: Value, t: Type, ref env: Bindings, cache: Map[Name, Value]) :=
  local ok: Bool

  match hs
    case Nil =>
      raise Thrown(v, t)
    case [Handler(_, PWild, g, body); rest] =>
      call holds(in run, env, g, out ok, ref cache)
      if ok
        call exec(in run, body, ref env, cache)
      else
        call handle(in run, rest, v, t, ref env, cache)
      end
    // the type is compared first, since the pattern and the guard assume it
    case [Handler(u, q, g, body); rest] =>
      assign ok := false
      if u == t
        match match_into(q, v, env)
          case Some(inner) =>
            call holds(in run, inner, g, out ok, ref cache)
            if ok
              call scoped(in run, pattern_vars(q), inner, [body], ref env, cache)
            end
          case _ =>
            skip
        end
      end
      if not ok
        call handle(in run, rest, v, t, ref env, cache)
      end
  end

// calls the procedure n with the values ins of its ins, where the variables refs of the caller in env are its refs,
// which get their values back when it returns, and the values outs of its outs
procedure invoke(
  in  run: Run,
      n: Name,
      ins: List[Value],
      refs: List[Name],
  out outs: List[Value],
  ref env: Bindings,
      cache: Map[Name, Value]
) :=
  match get(n, run.defs.procs)
    case Some((xs, ys, zs, body)) =>
      call run_body(in run, n, empty(), xs, ys, zs, body, ins, refs, out outs, ref env, cache)
    case None if show_name(n) == "os.os_print" =>
      assign outs := Nil
      call   print_all(in [text_of(v) for v in ins])
    case None if show_name(n) == "os.os_args" =>
      assign outs := [list_value([Lit(VStr(a)) for a in run.args])]
    case None =>
      call os_proc(in n, ins, out outs)
  end

// a lambda sees the values of the variables around it, which the checker does not let it assign
procedure invoke_value(
  in  run: Run,
      f: Value,
      ins: List[Value],
      refs: List[Name],
  out outs: List[Value],
  ref env: Bindings,
      cache: Map[Name, Value]
) :=
  match f
    case Proc(n) =>
      call invoke(in run, n, ins, refs, out outs, ref env, cache)
    case ProcClos(around, xs, ys, zs, body) =>
      call run_body(in run, unqualified("lambda"), around, xs, ys, zs, body, ins, refs, out outs, ref env, cache)
    case _ =>
      raise NotProc(f)
  end

// the body of procedure n with the ins xs, outs ys, and refs zs, whose variables start from around,
// where the caller gets the outs and refs only when the body returns, so that an exception leaves its variables as they were
procedure run_body(
  in  run: Run,
      n: Name,
      around: Bindings,
      xs: List[Var],
      ys: List[Var],
      zs: List[Var],
      body: Stmt,
      ins: List[Value],
      refs: List[Name],
  out outs: List[Value],
  ref env: Bindings,
      cache: Map[Name, Value]
) :=
  local inner := bind_all(xs, ins, put_all(values_in(zip(names(zs), refs), env), remove_all(names(ys ++ zs), around)))

  call exec(in run, body, ref inner, cache)

  assign outs := read_outs(n, names(ys), inner)
  assign env := put_all(values_in(zip(refs, names(zs)), inner), env)

// the pairs of the names a and the values of the names b in env, for those that have values
function values_in(ps: List[Name * Name], env: Bindings): List[Name * Value] :=
  match ps
    case Nil => Nil
    case [(a, b); rest] =>
      match get(b, env)
        case Some(v) => [(a, v); values_in(rest, env)]
        case None => values_in(rest, env)
      end
  end

// the values of the outs of procedure p, which must be assigned
function read_outs(p: Name, ys: List[Name], env: Bindings): List[Value] :=
  match ys
    case Nil => Nil
    case [y; rest] =>
      match get(y, env)
        case Some(v) => [v; read_outs(p, rest, env)]
        case None => raise UnassignedOutput(y, p)
      end
  end

procedure print_all(in lines: List[Str]) :=
  match lines
    case Nil =>
      skip
    case [line; rest] =>
      call os_print(in line)
      call print_all(in rest)
  end

// the procedures of the library os are those of the interpreter of this program, whose OsError the program can catch
procedure os_proc(in n: Name, ins: List[Value], out outs: List[Value]) :=
  local text: Str, entries: List[Str * Bool], yes: Bool

  try
    match (show_name(n), ins)
      case ("os.os_read", [Lit(VStr(path))]) =>
        call   os_read(in path, out text)
        assign outs := [Lit(VStr(text))]

      case ("os.os_write", [Lit(VStr(path)), Lit(VStr(t))]) =>
        call   os_write(in path, t)
        assign outs := Nil

      case ("os.os_library", [Lit(VStr(name))]) =>
        call   os_library(in name, out text)
        assign outs := [Lit(VStr(text))]

      case ("os.os_list", [Lit(VStr(dir))]) =>
        call   os_list(in dir, out entries)
        assign outs := [list_value(entry_values(entries))]

      case ("os.os_is_dir", [Lit(VStr(path))]) =>
        call   os_is_dir(in path, out yes)
        assign outs := [Lit(VBool(yes))]

      case ("os.os_cwd", []) =>
        call   os_cwd(out text)
        assign outs := [Lit(VStr(text))]

      case ("os.os_chdir", [Lit(VStr(dir))]) =>
        call   os_chdir(in dir)
        assign outs := Nil

      case ("os.os_print_error", [Lit(VStr(t))]) =>
        call   os_print_error(in t)
        assign outs := Nil

      // os_exit does not return
      case ("os.os_exit", [Lit(VInt(k))]) =>
        call   os_exit(in k)
        assign outs := Nil

      case _ =>
        raise UnknownProc(n)
    end
  catch
    case OsError(m) =>
      raise Thrown(Obj(os_error_name(), [Lit(VStr(m))]), TSort(os_error_name(), Nil))
  end

// the entries of a directory as values of the program
function entry_values(entries: List[Str * Bool]): List[Value] :=
  match entries
    case Nil => Nil
    case [(name, dir); rest] => [Obj(tuple_name(), [Lit(VStr(name)), Lit(VBool(dir))]); entry_values(rest)]
  end

// calls the procedure n without parameters
procedure run_proc(in run: Run, n: Name, ref cache: Map[Name, Value]) :=
  local env: Bindings := empty(), outs: List[Value]

  try
    call invoke(in run, n, Nil, Nil, out outs, ref env, cache)
  catch
    case Thrown(v, _) =>
      call uncaught(in run, v, ref cache)
  end

// runs the test c
procedure run_cmd(in run: Run, cmd: Cmd, ref cache: Map[Name, Value]) :=
  local env: Bindings := empty()

  try
    match cmd
      case CTest(_, _, body) =>
        call exec(in run, body, ref env, cache)
      case _ =>
        skip
    end
  catch
    case Thrown(v, _) =>
      call uncaught(in run, v, ref cache)
  end

// an exception of the program that no handler catches, as the error with its text
procedure uncaught(in run: Run, v: Value, ref cache: Map[Name, Value]) :=
  local s: Str

  call  show_in(in run, v, out s, ref cache)
  raise Uncaught(s)

// runs the tests of cs
procedure run_all(in run: Run, cmds: List[Cmd], ref cache: Map[Name, Value]) :=
  match cmds
    case Nil =>
      skip
    case [c; more] =>
      call run_cmd(in run, c, ref cache)
      call run_all(in run, more, ref cache)
  end

// runs the tests of a checked program, where failed assertions are errors
procedure run_program(in q: Prog) :=
  local cache: Map[Name, Value] := empty()

  call run_all(in load(q), q.cmds, ref cache)

// checks the commands, after len of a module that imports lists, and runs their tests
procedure check_and_run(in cmds: List[Cmd]) :=
  local q: Prog

  call check_program(in with_lists(cmds), out q)
  call run_program(in q)

// the test n that asserts that e equals expected
function asserting(n: Id, expr: Expr, expected: Expr): Cmd :=
  CTest(n, Nil, SBlock(Nil, [SAssert(expr_app("==", [expr, expected]))]))

// a test that assigns e to a local variable
function assigning(expr: Expr): Cmd :=
  CTest("a", Nil, SBlock([hole_var("v")], [SAssign([(hole_var("v"), expr)])]))

function int(n: Int): Value :=
  Lit(VInt(n))

test expressions() :=
  call check_and_run(
    in [
      asserting("p1", expr_app("len", [expr_app("Cons", [expr_int(1), expr_app("Cons", [expr_int(2), expr_var("Nil")])])]), expr_int(2)),
      // let f = lambda x => x * x in f(3) + f(4)
      asserting("p2", ELet([(Var(unqualified("f"), THole), ELam([Var(unqualified("x"), THole)], expr_app("*", [expr_var("x"), expr_var("x")])))], expr_app("+", [expr_app("f", [expr_int(3)]), expr_app("f", [expr_int(4)])])), expr_int(25)),
      // false and 1 / 0 == 0
      asserting("p4", expr_app("and", [ELit(VBool(false)), expr_app("==", [expr_app("/", [expr_int(1), expr_int(0)]), expr_int(0)])]), ELit(VBool(false)))
    ]
  )

// procedure sum(in n: Int, out s: Int) with a loop, and procedure size(ref k: Int) raising Fail after an increment
function procedures(): List[Cmd] :=
  [
    CData(unqualified("Fail"), Nil, [Constr(unqualified("Fail"), [type_int()])]),
    CProc(
      unqualified("sum"),
      Nil,
      [Var(unqualified("n"), type_int())],
      [Var(unqualified("s"), type_int())],
      Nil,
      SBlock(
        [Var(unqualified("i"), type_int())],
        [
          SAssign([(Var(unqualified("s"), THole), expr_int(0)), (Var(unqualified("i"), THole), expr_int(0))]),
          SWhile(
            expr_app("<", [expr_var("i"), expr_var("n")]),
            SBlock(Nil, [SAssign([(Var(unqualified("i"), THole), expr_app("+", [expr_var("i"), expr_int(1)])), (Var(unqualified("s"), THole), expr_app("+", [expr_var("s"), expr_app("+", [expr_var("i"), expr_int(1)])]))])])
          )
        ]
      )
    ),
    CProc(
      unqualified("count"),
      Nil,
      Nil,
      Nil,
      [Var(unqualified("k"), type_int())],
      SBlock(Nil, [SAssign([(Var(unqualified("k"), THole), expr_app("+", [expr_var("k"), expr_int(1)]))]), SRaise(expr_app("Fail", [expr_var("k")]), THole)])
    )
  ]

test procedures() :=
  call check_and_run(in procedures() ++
    [
      CTest("sum", Nil, SBlock([Var(unqualified("s"), type_int())], [SCall(unqualified("sum"), [expr_int(4)], [Var(unqualified("s"), THole)], Nil), equals("s", 10)])),
      // the assignment to k does not reach the caller, since count raises, and the handler for Fail binds its argument
      CTest(
        "count",
        Nil,
        SBlock(
          [Var(unqualified("k"), type_int()), Var(unqualified("m"), type_int())],
          [
            SAssign([(Var(unqualified("k"), THole), expr_int(1)), (Var(unqualified("m"), THole), expr_int(0))]),
            STry(
              SBlock(Nil, [SCall(unqualified("count"), Nil, Nil, [Var(unqualified("k"), THole)])]),
              [Handler(THole, PApp(unqualified("Fail"), [pat_var("j")]), None, SBlock(Nil, [SAssign([(Var(unqualified("m"), THole), expr_var("j"))])]))]
            ),
            equals("k", 1),
            equals("m", 2)
          ]
        )
      )
    ])

// a declared procedure and a lambda that captures k, called through variables
test procedure_values() :=
  call check_and_run(in procedures() ++
    [
      CTest(
        "values",
        Nil,
        SBlock(
          [Var(unqualified("s"), type_int()), Var(unqualified("t"), type_int())],
          [
            SBlock(
              [hole_var("f"), hole_var("k"), hole_var("g")],
              [
                SAssign([(hole_var("f"), expr_var("sum"))]),
                SAssign([(hole_var("k"), expr_int(10))]),
                SAssign([(hole_var("g"), EProc([hole_var("n")], [hole_var("r")], Nil, SBlock(Nil, [SAssign([(hole_var("r"), expr_app("+", [expr_var("n"), expr_var("k")]))])])))]),
                SCall(unqualified("f"), [expr_int(4)], [hole_var("s")], Nil),
                SCall(unqualified("g"), [expr_int(4)], [hole_var("t")], Nil)
              ]
            ),
            equals("s", 10),
            equals("t", 14)
          ]
        )
      )
    ])

function hole_var(n: Id): Var :=
  Var(unqualified(n), THole)

// the assertion that the variable n equals k
function equals(n: Id, k: Int): Stmt :=
  SAssert(expr_app("==", [expr_var(n), expr_int(k)]))

test errors() :=
  try
    call   check_and_run(in procedures() ++ [CTest("t", Nil, SBlock(Nil, [SRaise(expr_app("Fail", [expr_int(1)]), THole)]))])
    assert false
  catch
    case Uncaught(s) =>
      assert s == "Fail(1)"
  end
  try
    call   check_and_run(in [CTest("t", Nil, SBlock(Nil, [SAssert(expr_app("==", [expr_int(1), expr_int(2)]))]))])
    assert false
  catch
    case AssertionUnequal(a, b) =>
      assert (a, b) == ("1", "2")
  end
  try
    call   check_and_run(in [assigning(expr_app("/", [expr_int(1), expr_int(0)]))])
    assert false
  catch
    case Uncaught(s) =>
      assert s == "DivisionByZero"
  end
  // loop() := loop() + 1 needs its own value
  try
    call   check_and_run(in [CFun(unqualified("loop"), Nil, [Nil], type_int(), expr_app("+", [expr_app("loop", []), expr_int(1)])), assigning(expr_app("loop", []))])
    assert false
  catch
    case RecursiveInitialization(n) =>
      assert n.base == "loop"
  end

// add(a: Int)(b: Int): Int := a + b, applied partially
test curried() :=
  call check_and_run(
    in [
      CFun(unqualified("add"), Nil, [[Var(unqualified("a"), type_int())], [Var(unqualified("b"), type_int())]], type_int(), expr_app("+", [expr_var("a"), expr_var("b")])),
      asserting("p", EApp(expr_app("add", [expr_int(1)]), [expr_int(2)]), expr_int(3))
    ]
  )

// match (1, true, 3) case (_, _, z) => z end, a flat tuple
test tuples() :=
  call check_and_run(in [asserting("p", EMatch(ETuple([expr_int(1), ELit(VBool(true)), expr_int(3)]), [Branch(PTuple([PWild, PWild, pat_var("z")]), None, expr_var("z"))]), expr_int(3))])

// a handler for integers skips a string without evaluating its guard, so the string is raised further
test handler_types() :=
  try
    call   check_and_run(in [CTest("t", Nil, STry(SRaise(ELit(VStr("x")), THole), [Handler(THole, pat_var("k"), Some(expr_app("<", [expr_var("k"), expr_int(2)])), SSkip)]))])
    assert false
  catch
    case Uncaught(s) =>
      assert s == "\"x\""
  end
