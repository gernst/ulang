// a compiler from programs of self/syntax.u, which self/check.u has checked, to C in the syntax of self/c.u,
// whose code calls the runtime in self/runtime, where every value has the C type u_value

import "syntax.u"
import "builtins.u"
import "check.u"
import "defs.u"
import "error.u"
import "format.u"
import "c.u"
import "parse.u"
import "os.u"
import "map.u"
import "set.u"
import "buffer.u"

export

data CompileError :=
  case Unsupported(what: Str)
  case UnknownEntry(name: Name)

procedure compile_file(in source: Str, entry: Id, target: Str)
function is_entry(cmd: Cmd, n: Name): Bool

implementation

// the variables in scope with the C expressions they are accessed through
type Vars :=
  List[Name * CExpr]

data Gen :=
  case Gen(count: Int, lifted: List[CDecl])

function value_type(): CType :=
  CtNamed("u_value")

function value_ptr(): CType :=
  CtPtr(CtNamed("u_value"))

// names of ulang with their modules as names of C, where other characters than letters, digits, and _ are their codes
function mangle(n: Name): Str :=
  str(list(for c in chars(format_name(n)) for d in mangle_char(c) yield d))

function mangle_char(c: Char): List[Char] :=
  if is_letter(c) or is_digit(c) or c == '_' then list(c) else chars("_" ++ show(ord(c)) ++ "_")

function fun_name(n: Name, k: Int): Str :=
  "f_" ++ mangle(n) ++ "_" ++ show(k)

// the C function of procedure n, which the runtime defines for those of the builtin section of os
function proc_name(n: Name): Str :=
  if n.module == Some("os") and contains(n.base, native_procs()) then "p_" ++ n.base else "p_" ++ mangle(n)

// the procedures of the builtin section of os
function native_procs(): Set[Id] :=
  set("os_args", "os_read", "os_write", "os_library", "os_print", "os_print_error", "os_exit", "os_list", "os_is_dir", "os_cwd", "os_chdir")

function var_name(n: Name): Str :=
  "v_" ++ mangle(n)

function ref_name(n: Name): Str :=
  "r_" ++ mangle(n)

// the functions of the runtime for the builtins with their numbers of arguments, without a module, and of the builtin
// sections of the prelude, str.u, and array.u by their qualified names
function builtin_functions(): Map[Name, Str * Int] :=
  map(
    Name(Some("prelude"), "+") => ("u_add", 2),
    Name(Some("prelude"), "-") => ("u_sub", 2),
    Name(Some("prelude"), "*") => ("u_mul", 2),
    Name(Some("prelude"), "/") => ("u_div", 2),
    Name(Some("prelude"), "%") => ("u_mod", 2),
    unqualified("<") => ("u_lt", 2),
    unqualified("==") => ("u_eq", 2),
    unqualified("compare") => ("u_compare", 2),
    unqualified("show") => ("u_show", 1),
    Name(Some("str"), "chars") => ("u_chars", 1),
    Name(Some("str"), "str") => ("u_string", 1),
    Name(Some("str"), "ord") => ("u_ord", 1),
    Name(Some("str"), "chr") => ("u_chr", 1),
    Name(Some("prelude"), "++") => ("u_concat", 2),
    Name(Some("str"), "is_digit") => ("u_is_digit", 1),
    Name(Some("str"), "is_letter") => ("u_is_letter", 1),
    Name(Some("str"), "is_space") => ("u_is_space", 1),
    Name(Some("str"), "size") => ("u_size", 1),
    Name(Some("str"), "at") => ("u_at", 2),
    Name(Some("str"), "contains") => ("u_contains", 2),
    Name(Some("str"), "slice") => ("u_slice", 3),
    Name(Some("str"), "join") => ("u_join", 2),
    Name(Some("str"), "split") => ("u_split", 2),
    Name(Some("str"), "quote") => ("u_quote", 1),
    Name(Some("str"), "number") => ("u_number", 1),
    Name(Some("array"), "from_list") => ("u_array", 1),
    Name(Some("array"), "size") => ("u_array_size", 1),
    Name(Some("array"), "at") => ("u_array_at", 2),
    Name(Some("array"), "slice") => ("u_array_slice", 3),
    Name(Some("array"), "foldr") => ("u_array_foldr", 3),
    Name(Some("array"), "foldl") => ("u_array_foldl", 3)
  )

// the descriptor of constructor n, which the runtime compares by its address
function descriptor(n: Name): CExpr :=
  CeUnary("&", CeVar(descriptor_name(n)))

// the shared value of constructor n without arguments
function unit_value(n: Name): CExpr :=
  CeUnary("&", CeVar("o_" ++ mangle(n)))

// the datatypes and constructors whose descriptors the runtime defines, of OsError, which its builtins create also in
// programs that do not import os, while each program defines those of the prelude and its modules, which it always has
function runtime_constructors(): Set[Name] :=
  set(os_error_name())

function runtime_types(): Set[Name] :=
  set(os_error_name())

function type_name(t: Name): Str :=
  "t_" ++ mangle(t)

// the descriptor of constructor n at position i of its declaration, of datatype t
function descriptor_decl(n: Name, i: Int, t: Name): CDecl :=
  CdGlobal(CtNamed("const struct u_name"), descriptor_name(n), Some(CeInit(descriptor_fields(n, i, t))))

function descriptor_name(n: Name): Str :=
  "n_" ++ mangle(n)

function descriptor_fields(n: Name, i: Int, t: Name): List[CExpr] :=
  match n
    case Name(Some(m), base) => list(CeStr(m), CeStr(base), CeNum(i), CeUnary("&", CeVar(type_name(t))))
    case Name(None, base) => list(CeVar("NULL"), CeStr(base), CeNum(i), CeUnary("&", CeVar(type_name(t))))
  end

// the shared value of constructor n without arguments, of datatype t
function unit_decl(n: Name, t: Name): CDecl :=
  CdGlobal(CtNamed("struct u_object"), "o_" ++ mangle(n), Some(unit_init(n, t)))

function unit_init(n: Name, t: Name): CExpr :=
  c_call("U_UNIT", list(CeVar(descriptor_name(n)), CeVar(type_name(t))))

// the descriptors of the datatypes of cs and their constructors that the runtime does not define, and the values of
// the constructors without arguments, where the descriptor of a datatype points to the functions compare, ==, and show
// that its module declares, and otherwise to the structural ones of the runtime
function descriptor_decls(defs: Defs, cmds: List[Cmd]): List[CDecl] :=
  data_decls(cmds, defs) ++ field_table_decls(defs)

function field_table_decls(defs: Defs): List[CDecl] :=
  list(for e in list(for x in defs.fields) for d in field_decls(e) yield d)

// the positions of the field of an accessor T.f in each constructor of T, by their index of struct u_name, and the
// name T.f, which MissingField carries, both shared by the updater T.f:=
function field_decls(e: (Name * Int) * List[Int]): List[CDecl] :=
  match e
    case ((n, 1), ps) =>
      list(table_decl(n, ps), field_text_decl(n))
    case _ => list()
  end

function table_decl(n: Name, ps: List[Int]): CDecl :=
  CdGlobal(CtNamed("static const int"), table_name(n) ++ "[]", Some(CeInit(list(for p in ps yield CeNum(p)))))

function field_text_decl(n: Name): CDecl :=
  CdGlobal(CtNamed("static struct u_object"), field_text_name(n), Some(c_call("U_LIT", list(CeStr(field_of(n))))))

function positions_of(defs: Defs, n: Name, k: Int): List[Int] :=
  value_or(get((n, k), defs.fields), list())

function table_name(n: Name): Str :=
  "x_" ++ mangle(Name(n.module, field_of(n)))

function field_text_name(n: Name): Str :=
  "lf_" ++ mangle(Name(n.module, field_of(n)))

// the field of the accessor or the updater n of the value of a, where y is the new value of an updater, directly if the
// field has the same position in every constructor, and else by the table of its positions
function field_call(n: Name, ps: List[Int], rs: List[CExpr]): CExpr :=
  match (rs, distinct(ps))
    case (list(a), list(p)) if p >= 0 =>
      c_call("u_field", list(a, CeNum(p)))
    case (list(a), _) =>
      c_call("u_select", list(a, CeVar(table_name(n)), CeUnary("&", CeVar(field_text_name(n)))))
    case (list(a, y), _) =>
      c_call("u_update", list(a, CeVar(table_name(n)), CeUnary("&", CeVar(field_text_name(n))), y))
    case _ =>
      raise Unsupported("the field " ++ format_name(n))
  end

function data_decls(cmds: List[Cmd], defs: Defs): List[CDecl] :=
  match cmds
    case list() =>
      list()
    case list(CData(name, _, constrs); rest) =>
      type_decls(name, defs) ++ constructor_decls(name, constrs, 0) ++ data_decls(rest, defs)
    case list(_; rest) =>
      data_decls(rest, defs)
  end

function type_decls(t: Name, defs: Defs): List[CDecl] :=
  if contains(t, runtime_types()) then list() else list(type_decl(t, defs))

function type_decl(t: Name, defs: Defs): CDecl :=
  CdGlobal(CtNamed("const struct u_type"), type_name(t), Some(type_init(t, defs)))

function type_init(t: Name, defs: Defs): CExpr :=
  CeInit(list(CeStr(format_name(t)), compare_ref(t, defs), equals_ref(t, defs), show_ref(t, defs)))

function compare_ref(t: Name, defs: Defs): CExpr :=
  CeVar(declared_or(get(t, defs.orders), 2, "u_con_compare"))

function equals_ref(t: Name, defs: Defs): CExpr :=
  CeVar(declared_or(get(t, defs.equalities), 2, "u_equals_by_compare"))

function show_ref(t: Name, defs: Defs): CExpr :=
  CeVar(declared_or(get(t, defs.shows), 1, "u_con_show"))

// the C function of a declared function f with n parameters, or else the function of the runtime
function declared_or(f: Option[Name], n: Int, default: Str): Str :=
  match f
    case Some(g) => fun_name(g, n)
    case None => default
  end

function constructor_decls(t: Name, ks: List[Constr], i: Int): List[CDecl] :=
  match ks
    case list() => list()
    case list(k; rest) if contains(k.name, runtime_constructors()) => constructor_decls(t, rest, i + 1)
    case list(Constr(_, name, list()); rest) => list(descriptor_decl(name, i, t), unit_decl(name, t); constructor_decls(t, rest, i + 1))
    case list(Constr(_, name, _); rest) => list(descriptor_decl(name, i, t); constructor_decls(t, rest, i + 1))
  end

function in_scope(xs: List[Name]): Vars :=
  list(for x in xs yield (x, CeVar(var_name(x))))

function var_expr(env: Vars, x: Name): CExpr :=
  match get(x, env)
    case Some(c) => c
    case _ => CeVar(var_name(x))
  end

function address(c: CExpr): CExpr :=
  CeUnary("&", c)

// outs and refs are locals of a procedure, which start as NULL and as the value of the caller, and which go back to the caller
// only when it returns, so that an exception leaves the variables of the caller as they were
function copy_in(outs: List[Name], refs: List[Name]): List[CStmt] :=
  list(for x in outs yield declare_null(x)) ++ list(for x in refs yield declare_from_ref(x))

function declare_null(x: Name): CStmt :=
  CsDecl(value_type(), var_name(x), Some(CeVar("NULL")))

function declare_from_ref(x: Name): CStmt :=
  CsDecl(value_type(), var_name(x), Some(CeUnary("*", CeVar(ref_name(x)))))

function copy_out(xs: List[Name]): List[CStmt] :=
  list(for x in xs yield CsAssign(CeUnary("*", CeVar(ref_name(x))), CeVar(var_name(x))))

function type_keys(types: List[Type]): Str :=
  join(", ", list(for a in types yield type_key(a)))

// types as names of exceptions, which handlers compare
function type_key(t: Type): Str :=
  match t
    case TSort(name, list()) => format_name(name)
    case TSort(name, args) => format_name(name) ++ "[" ++ join(", ", list(for a in args yield type_key(a))) ++ "]"
    case TFun(args, res) => "(" ++ join(", ", list(for a in args yield type_key(a))) ++ ") -> " ++ type_key(res)
    case TProc(ins, outs, refs) => "(in " ++ type_keys(ins) ++ ", out " ++ type_keys(outs) ++ ", ref " ++ type_keys(refs) ++ ")"
    case TTuple(types) => "(" ++ join(" * ", list(for a in types yield type_key(a))) ++ ")"
    case _ => "?"
  end

function is_global_fun(defs: Defs, n: Name, k: Int): Bool :=
  contains((n, k), defs.funs)

function fields_count(defs: Defs, n: Name): Option[Int] :=
  match get(n, defs.constrs)
    case Some((k, _, _)) => Some(k)
    case None => None
  end

// the procedures with their numbers of ins and of outs and refs
function proc_arities(defs: Defs): List[Name * (Int * Int)] :=
  list(for n => d in defs.procs yield (n, proc_arity(d)))

function proc_arity(d: List[Var] * List[Var] * List[Var] * Stmt): Int * Int :=
  match d
    case (ins, outs, refs, _) => (size(ins), size(outs) + size(refs))
  end

function constr_arities(defs: Defs): List[Name * Int] :=
  list(for n => d in defs.constrs yield (n, constr_arity(d)))

function constr_arity(d: Int * Int * Name): Int :=
  match d
    case (k, _, _) => k
  end

function index(a: Str, i: Int): CExpr :=
  CeIndex(CeVar(a), CeNum(i))

function field(v: CExpr, i: Int): CExpr :=
  c_call("u_field", list(v, CeNum(i)))

function truth(v: CExpr): CExpr :=
  c_call("u_truth", list(v))

function conjunction(cs: List[CExpr]): CExpr :=
  match cs
    case list() => CeNum(1)
    case list(d) => d
    case list(d; rest) => CeBinary("&&", d, conjunction(rest))
  end

function int_value(num: Int): CExpr :=
  if is_small(num) then c_call("u_mk_int", list(CeNum(num))) else c_call("u_mk_int_str", list(CeStr(show(num))))

function is_small(num: Int): Bool :=
  -1000000000000000000 < num and num < 1000000000000000000

function literal_value(l: Lit): CExpr :=
  match l
    case LUnit => c_call("u_mk_tuple", list(CeNum(0)))
    case LBool(bool) => c_call("u_mk_bool", list(CeNum(if bool then 1 else 0)))
    case LInt(num) => int_value(num)
    case LStr(text) => c_call("u_mk_lit", list(CeStr(text)))
    case LChar(char) => c_call("u_mk_char", list(CeNum(ord(char))))
  end

// the tests that v matches pat, in an order that checks a constructor before its fields
function pattern_tests(pat: Pat, v: CExpr): List[CExpr] :=
  match pat
    case PLit(lit) => list(c_call("u_equals", list(v, literal_value(lit))))
    case PApp(constr, pats) => list(c_call("u_is_con", list(v, descriptor(constr)))) ++ field_tests(numbered(pats), v)
    case PTuple(pats) => field_tests(numbered(pats), v)
    case _ => list()
  end

function field_tests(ps: List[Pat * Int], v: CExpr): List[CExpr] :=
  list(for (p, i) in ps for t in pattern_tests(p, field(v, i)) yield t)

// the declarations of the variables of pat, where v matches pat
function pattern_binds(pat: Pat, v: CExpr): List[CStmt] :=
  match pat
    case PVar(Var(name, _)) => list(CsDecl(value_type(), var_name(name), Some(v)))
    case PApp(_, pats) => field_binds(numbered(pats), v)
    case PTuple(pats) => field_binds(numbered(pats), v)
    case _ => list()
  end

function field_binds(ps: List[Pat * Int], v: CExpr): List[CStmt] :=
  list(for (p, i) in ps for b in pattern_binds(p, field(v, i)) yield b)

function pattern_names(pat: Pat): List[Name] :=
  match pat
    case PVar(Var(name, _)) => list(name)
    case PApp(_, pats) => list(for q in pats for x in pattern_names(q) yield x)
    case PTuple(pats) => list(for q in pats for x in pattern_names(q) yield x)
    case _ => list()
  end

function free_in_all(exprs: List[Expr], bound: List[Name]): List[Name] :=
  list(for a in exprs for n in free_vars(a, bound) yield n)

function unbound(names: List[Name], bound: List[Name]): List[Name] :=
  list(for y in names if not contains(y, bound))

// the variables of expr that bound does not bind, which lambdas capture if they are local
function free_vars(expr: Expr, bound: List[Name]): List[Name] :=
  match expr
    case ELit(_) => list()
    case EVar(Var(name, _)) => if contains(name, bound) then list() else list(name)
    case EApp(fun, args) => free_vars(fun, bound) ++ free_in_all(args, bound)
    case EField(expr, _) => free_vars(expr, bound)
    case EUpdate(expr, _, value) => free_vars(expr, bound) ++ free_vars(value, bound)
    case EForm(_, _, _) => list()
    case EFor(_, _, _, _) => list()
    case ELam(formals, body) => free_vars(body, var_names(formals) ++ bound)
    case EProc(ins, outs, refs, stmt) => free_in_stmt(stmt, var_names(ins ++ outs ++ refs) ++ bound)
    case ELet(bindings, body) => free_in_all(seconds(bindings), bound) ++ free_vars(body, var_names(firsts(bindings)) ++ bound)
    case EIte(cond, then_expr, else_expr) => free_vars(cond, bound) ++ free_vars(then_expr, bound) ++ free_vars(else_expr, bound)
    case EMatch(expr, cases) => free_vars(expr, bound) ++ list(for b in cases for n in free_in_branch(b, bound) yield n)
    case ETuple(exprs) => free_in_all(exprs, bound)
    case ERaise(expr, _) => free_vars(expr, bound)
  end

// the variables of x that bound does not bind, including procedures called through variables
function free_in_stmt(x: Stmt, bound: List[Name]): List[Name] :=
  match x
    case SSkip => list()
    case SAssign(assignments) => unbound(var_names(firsts(assignments)), bound) ++ free_in_all(seconds(assignments), bound)
    case SBlock(locals, stmts) => list(for y in stmts for n in free_in_stmt(y, var_names(locals) ++ bound) yield n)
    case SIf(cond, then_stmt, else_stmt) => free_vars(cond, bound) ++ free_in_stmt(then_stmt, bound) ++ free_in_stmt(else_stmt, bound)
    case SWhile(cond, body) => free_vars(cond, bound) ++ free_in_stmt(body, bound)
    case SCall(proc, ins, outs, refs) =>
      unbound(list(proc; var_names(outs ++ refs)), bound) ++ free_in_all(ins, bound)
    case SMatch(expr, cases) => free_vars(expr, bound) ++ list(for b in cases for n in free_in_stmt_branch(b, bound) yield n)
    case SAssert(cond) => free_vars(cond, bound)
    case SRaise(expr, _) => free_vars(expr, bound)
    case STry(body, handlers) => free_in_stmt(body, bound) ++ list(for h in handlers for n in free_in_handler(h, bound) yield n)
  end

function free_in_stmt_branch(b: Branch[Stmt], bound: List[Name]): List[Name] :=
  match b
    case Branch(_, pat, Some(g), body) =>
      let inner := pattern_names(pat) ++ bound in free_vars(g, inner) ++ free_in_stmt(body, inner)
    case Branch(_, pat, None, body) => free_in_stmt(body, pattern_names(pat) ++ bound)
  end

function free_in_handler(h: Handler, bound: List[Name]): List[Name] :=
  let inner := pattern_names(h.pat) ++ bound in
    free_in_stmt(h.body, inner) ++ (match h.guard case Some(g) => free_vars(g, inner) case None => list() end)

function free_in_branch(b: Branch[Expr], bound: List[Name]): List[Name] :=
  match b
    case Branch(_, pat, Some(g), body) =>
      let inner := pattern_names(pat) ++ bound in free_vars(g, inner) ++ free_vars(body, inner)
    case Branch(_, pat, None, body) => free_vars(body, pattern_names(pat) ++ bound)
  end

procedure gen_name(in stem: Str, out x: Str, ref g: Gen) :=
  assign x := stem ++ show(g.count), g := g with count := g.count + 1

procedure lift(in d: CDecl, ref g: Gen) :=
  assign g := g with lifted := g.lifted ++ list(d)

// a function, constructor, or builtin of name n with type t as a value, which is a closure of its wrapper
function global_value(defs: Defs, n: Name, t: Type): CExpr :=
  if is_global_fun(defs, n, arity(t)) then closure("w_" ++ fun_name(n, arity(t))) else other_global(defs, n)

function closure(w: Str): CExpr :=
  c_call("u_mk_closure", list(CeVar(w), CeNum(0)))

function other_global(defs: Defs, n: Name): CExpr :=
  match fields_count(defs, n)
    case Some(0) => unit_value(n)
    case Some(_) => closure("wc_" ++ mangle(n))
    case None => builtin_global(defs, n)
  end

function builtin_global(defs: Defs, n: Name): CExpr :=
  match get(n, builtin_functions())
    case Some((f, _)) => closure("w" ++ f)
    case None if contains(n, defs.procs) => c_call("u_mk_proc", list(CeVar("wp_" ++ mangle(n)), CeNum(0)))
    case None => raise Unsupported("the variable " ++ n.base)
  end

function declare_none(x: Str): CStmt :=
  CsDecl(value_type(), x, None)

function prefix_of(text: Str): Str :=
  slice(text, 0, if size(text) < 16 then size(text) else 16)

function static_literal(x: Str, text: Str): CStmt :=
  CsDecl(CtNamed("static struct u_object"), x, Some(c_call("U_LIT", list(CeStr(text)))))

// the statements that compute expr in a scope with the local variables env, and its value r
procedure compile_expr(in defs: Defs, env: Vars, expr: Expr, out ss: List[CStmt], r: CExpr, ref g: Gen) :=
  local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], ra: CExpr, rb: CExpr, rc: CExpr, rs: List[CExpr]
  local t: Str, d: Str, names: List[Name]

  match expr
    case ELit(LStr(text)) =>
      call   gen_name(in "l_" ++ mangle(unqualified(prefix_of(text))) ++ "_", out t, ref g)
      assign ss := list(static_literal(t, text)), r := CeUnary("&", CeVar(t))

    case ELit(lit) =>
      assign ss := list(), r := literal_value(lit)

    case EVar(Var(name, typ)) =>
      match get(name, env)
        case Some(c) =>
          assign ss := list(), r := c
        case None =>
          assign ss := list(), r := global_value(defs, name, typ)
      end

    case EApp(EVar(Var(n, _)), args) if array_fusion(n, args) != None =>
      match array_fusion(n, args)
        case Some((gs, q, e)) =>
          call compile_array_comprehension(in defs, env, gs, q, e, out ss, r, ref g)
        case None =>
          raise Unsupported("an array comprehension")
      end

    case EApp(EVar(Var(name, _)), list(l)) if name == array_name() and list_literal(l) != None =>
      match list_literal(l)
        case Some(es) =>
          call   compile_exprs(in defs, env, es, out ss, rs, ref g)
          assign r := c_call("u_mk_array", list(CeNum(size(rs))) ++ rs)
        case None =>
          raise Unsupported("an array literal")
      end

    // [e for x in c, y in d if q] over lists and arrays, nested folds into which comprehensions translate, are nested loops
    // that build the list in order
    case EApp(EVar(Var(n, _)), list(xs, init, ELam(list(x, acc), body))) if fused(n, xs, x, body, acc.name) != None =>
      match fused(n, xs, x, body, acc.name)
        case Some((gs, q, e)) =>
          call compile_list_comprehension(in defs, env, gs, q, e, init, out ss, r, ref g)
        case None =>
          raise Unsupported("a list comprehension")
      end

    case EApp(EVar(Var(name, typ)), args) if get(name, env) == None =>
      call compile_named(in defs, env, name, typ, args, out ss, r, ref g)

    case EField(_, field) =>
      raise Unsupported("the unresolved field " ++ field)

    case EUpdate(_, field, _) =>
      raise Unsupported("the unresolved field " ++ field)

    case EForm(form, _, _) =>
      raise Unsupported("the untranslated form " ++ form_name(form))

    case EFor(form, _, _, _) =>
      raise Unsupported("the untranslated form " ++ form_name(form))

    case EApp(fun, args) =>
      call   compile_expr(in defs, env, fun, out as, ra, ref g)
      call   compile_exprs(in defs, env, args, out bs, rs, ref g)
      assign ss := as ++ bs, r := c_call("u_apply", list(ra, CeNum(size(args))) ++ rs)

    case ELam(formals, body) =>
      call compile_lambda(in defs, env, formals, body, out ss, r, ref g)

    case EProc(ins, outs, refs, stmt) =>
      call compile_proc_lambda(in defs, env, ins, outs, refs, stmt, out ss, r, ref g)

    case ELet(bindings, body) =>
      assign names := list(for x in firsts(bindings) yield x.name)
      call   compile_exprs(in defs, env, seconds(bindings), out as, rs, ref g)
      call   compile_expr(in defs, in_scope(names) ++ env, body, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      call   temps(in rs, out cs, ref g)
      assign ss := as ++ cs ++ list(declare_none(t), CsBlock(rebind(names, cs) ++ bs ++ list(set_var(t, rb))))
      assign r := CeVar(t)

    case EIte(cond, then_expr, else_expr) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_expr(in defs, env, then_expr, out as, ra, ref g)
      call   compile_expr(in defs, env, else_expr, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      assign ss := cs ++ list(declare_none(t), CsIf(truth(rc), as ++ list(set_var(t, ra)), bs ++ list(set_var(t, rb))))
      assign r := CeVar(t)

    case EMatch(expr, cases) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      call   gen_name(in "s", out d, ref g)
      call   gen_name(in "t", out t, ref g)
      call   expr_cases(in defs, env, cases, CeVar(d), t, out bs, ref g)
      assign ss := as ++ list(CsDecl(value_type(), d, Some(ra)), CsDecl(value_type(), t, Some(CeVar("NULL")))) ++ bs
      assign ss := ss ++ list(CsIf(CeUnary("!", CeVar(t)), list(CsExpr(c_call("u_no_case", list(CeVar(d))))), list()))
      assign r := CeVar(t)

    case ETuple(exprs) =>
      call   compile_exprs(in defs, env, exprs, out ss, rs, ref g)
      assign r := c_call("u_mk_tuple", list(CeNum(size(exprs))) ++ rs)

    // the value of a raise is never used, since u_raise does not return
    case ERaise(expr, typ) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      assign ss := as ++ list(CsExpr(c_call("u_raise", list(ra, CeStr(type_key(typ)))))), r := CeVar("NULL")
  end

procedure compile_exprs(in defs: Defs, env: Vars, exprs: List[Expr], out ss: List[CStmt], rs: List[CExpr], ref g: Gen) :=
  local as: List[CStmt], r: CExpr

  assign ss := list(), rs := list()

  for e in exprs do
    call   compile_expr(in defs, env, e, out as, r, ref g)
    assign ss := ss ++ as, rs := rs ++ list(r)
  end

// the values rs in fresh variables, which later expressions do not change, as declarations
procedure temps(in rs: List[CExpr], out ss: List[CStmt], ref g: Gen) :=
  local t: Str

  assign ss := list()

  for r in rs do
    call   gen_name(in "t", out t, ref g)
    assign ss := ss ++ list(CsDecl(value_type(), t, Some(r)))
  end

// the variables xs as the temporaries declared by ts
function rebind(xs: List[Name], ts: List[CStmt]): List[CStmt] :=
  match (xs, ts)
    case (list(x; more), list(CsDecl(_, name, _); rest)) => list(CsDecl(value_type(), var_name(x), Some(CeVar(name))); rebind(more, rest))
    case _ => list()
  end

// applications of functions, constructors, and builtins of their arities are direct calls
procedure compile_named(
  in  defs: Defs,
      env: Vars,
      n: Name,
      ty: Type,
      args: List[Expr],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local as: List[CStmt], bs: List[CStmt], ra: CExpr, rb: CExpr, rs: List[CExpr], t: Str

  match args
    // and, or are not strict
    case list(a, b) if n == unqualified("and") or n == unqualified("or") =>
      call   compile_expr(in defs, env, a, out as, ra, ref g)
      call   compile_expr(in defs, env, b, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      if n == unqualified("and")
        assign ss := as ++ list(declare(t, ra), guarded(truth(CeVar(t)), t, bs, rb))
      else
        assign ss := as ++ list(declare(t, ra), guarded(CeUnary("!", truth(CeVar(t))), t, bs, rb))
      end
      assign r := CeVar(t)
    case _ =>
      call compile_exprs(in defs, env, args, out ss, rs, ref g)
      if is_global_fun(defs, n, size(args)) and arity(ty) == size(args)
        assign r := c_call(fun_name(n, size(args)), rs)
      else
        if contains((n, size(args)), defs.fields)
          assign r := field_call(n, positions_of(defs, n, size(args)), rs)
        else
          if fields_count(defs, n) == Some(0) and args == list()
            assign r := unit_value(n)
          else
            if fields_count(defs, n) == Some(size(args))
              assign r := c_call("u_mk_con", list(descriptor(n), CeNum(size(args))) ++ rs)
            else
              match get(n, builtin_functions())
                case Some((b, k)) if k == size(args) =>
                  assign r := c_call(b, rs)
                case _ =>
                  assign r := c_call("u_apply", list(global_value(defs, n, ty), CeNum(size(args))) ++ rs)
              end
            end
          end
        end
      end
  end

// a closure of a function lifted to the top level, which takes the captured values and the arguments
procedure compile_lambda(in defs: Defs, env: Vars, xs: List[Var], b: Expr, out ss: List[CStmt], r: CExpr, ref g: Gen) :=
  local  caps := captured(env, free_vars(b, var_names(xs)))
  local  f: Str, bs: List[CStmt], rb: CExpr, decls: List[CStmt]

  call   gen_name(in "lam", out f, ref g)
  call   compile_expr(in defs, in_scope(caps ++ var_names(xs)), b, out bs, rb, ref g)
  assign decls := unpack(numbered(caps), "env") ++ unpack(numbered(var_names(xs)), "args")
  call   lift(in CdFunction(value_type(), f, closure_params(), decls ++ bs ++ list(CsReturn(Some(rb)))), ref g)
  assign ss := list(), r := make_closure("u_mk_closure", f, caps, env)

// a lambda in x, out y, ref z => body end is a lifted function of the captured values, the ins, and pointers to the outs and refs
procedure compile_proc_lambda(
  in  defs: Defs,
      env: Vars,
      ins: List[Var],
      outs: List[Var],
      refs: List[Var],
      b: Stmt,
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local  caps := captured(env, free_in_stmt(b, var_names(ins ++ outs ++ refs)))
  local  f: Str, bs: List[CStmt], decls: List[CStmt]

  call   gen_name(in "proc", out f, ref g)
  call   compile_stmt(in defs, in_scope(caps ++ var_names(ins ++ outs ++ refs)), b, out bs, ref g)
  assign decls := unpack(numbered(caps), "env") ++ unpack(numbered(var_names(ins)), "ins")
  assign decls := decls ++ unpack_pointers(numbered(var_names(outs ++ refs)))
  assign decls := decls ++ copy_in(var_names(outs), var_names(refs))
  call   lift(in CdFunction(CtVoid, f, proc_params(), decls ++ bs ++ copy_out(var_names(outs ++ refs))), ref g)
  assign ss := list(), r := make_closure("u_mk_proc", f, caps, env)

function proc_params(): List[CType * Str] :=
  list((value_ptr(), "env"), (value_ptr(), "ins"), (CtPtr(value_ptr()), "outs"))

function unpack_pointers(xs: List[Name * Int]): List[CStmt] :=
  list(for (x, i) in xs yield CsDecl(value_ptr(), ref_name(x), Some(index("outs", i))))

// declarations of the variables xs with the values in the array a
function unpack(xs: List[Name * Int], a: Str): List[CStmt] :=
  list(for (x, i) in xs yield CsDecl(value_type(), var_name(x), Some(index(a, i))))

// the cases of a match of the value v, which assign the result to t, where t stays NULL if no case applies
procedure expr_cases(
  in  defs: Defs,
      env: Vars,
      cases: List[Branch[Expr]],
      v: CExpr,
      t: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  local bs: List[CStmt], rb: CExpr, gs: List[CStmt], rg: CExpr, body: List[CStmt], rest: List[CStmt], env1: Vars

  match cases
    case list() =>
      assign ss := list()
    case list(Branch(_, pat, guard, e); more) =>
      assign env1 := in_scope(pattern_names(pat)) ++ env
      call   compile_expr(in defs, env1, e, out bs, rb, ref g)
      assign body := bs ++ list(CsAssign(CeVar(t), rb))
      match guard
        case Some(c) =>
          call   compile_expr(in defs, env1, c, out gs, rg, ref g)
          assign body := gs ++ list(CsIf(truth(rg), body, list()))
        case None =>
          skip
      end
      call   expr_cases(in defs, env, more, v, t, out rest, ref g)
      assign ss := list(case_if(t, pattern_tests(pat, v), pat, v, body)) ++ rest
  end

// the elements of a list literal, Cons(a, Cons(b, Nil))
function list_literal(expr: Expr): Option[List[Expr]] :=
  match expr
    case EVar(Var(name, _)) if name == nil_name() => Some(list())
    case EApp(EVar(Var(name, _)), list(e, rest)) if name == cons_name() =>
      match list_literal(rest)
        case Some(es) => Some(list(e; es))
        case None => None
      end
    case _ => None
  end

// the condition and the element of a function body that puts the element in front of the accumulator acc if the condition holds,
// and returns acc otherwise
function consing(body: Expr, acc: Name): Option[Option[Expr] * Expr] :=
  match body
    case EIte(cond, EApp(EVar(Var(k, _)), list(e, EVar(Var(a, _)))), EVar(Var(b, _))) if cons_else(k, a, b, acc) =>
      if contains(acc, free_vars(cond, list()) ++ free_vars(e, list())) then None else Some((Some(cond), e))
    case EApp(EVar(Var(k, _)), list(e, EVar(Var(a, _)))) if cons_onto(k, a, acc) =>
      if contains(acc, free_vars(e, list())) then None else Some((None, e))
    case _ => None
  end

function cons_onto(k: Name, a: Name, acc: Name): Bool :=
  k == cons_name() and a == acc

function cons_else(k: Name, a: Name, b: Name, acc: Name): Bool :=
  cons_onto(k, a, acc) and b == acc

type Fusion :=
  List[Name * Expr * Var] * Option[Expr] * Expr

// the generators, the condition, and the element of a comprehension over lists and arrays, foldr(c1, init, lambda x1, acc =>
// foldr(c2, acc, lambda x2, acc => ... if q then Cons(e, acc) else acc)), into which comprehensions translate, where each
// generator is the fold of its container, the container, and the variable, and acc is free nowhere else
function fused(f: Name, c: Expr, x: Var, body: Expr, acc: Name): Option[Fusion] :=
  if f != list_foldr_name() and f != array_foldr_name() then
    None
  else
    match consing(body, acc)
      case Some((q, e)) => Some((list((f, c, x)), q, e))
      case None => fused_inner(f, c, x, body, acc)
    end

function fused_inner(f: Name, c: Expr, x: Var, body: Expr, acc: Name): Option[Fusion] :=
  match body
    case EApp(EVar(Var(f1, _)), list(c1, EVar(Var(a, _)), lam)) if a == acc and unused(acc, c1, lam) =>
      match lam
        case ELam(list(x1, acc1), inner) => nested(f, c, x, fused(f1, c1, x1, inner, acc1.name))
        case _ => None
      end
    case _ => None
  end

function unused(acc: Name, c: Expr, lam: Expr): Bool :=
  not contains(acc, free_vars(c, list()) ++ free_vars(lam, list()))

function nested(f: Name, c: Expr, x: Var, inner: Option[Fusion]): Option[Fusion] :=
  match inner
    case Some((gs, q, e)) => Some((list((f, c, x); gs), q, e))
    case None => None
  end

// the generators, condition, and element of an array comprehension array(foldr(c, Nil, lambda x, acc => ...))
function array_fusion(n: Name, args: List[Expr]): Option[Fusion] :=
  match args
    case list(EApp(EVar(Var(f, _)), list(xs, EVar(Var(k, _)), lam))) if n == array_name() and k == nil_name() =>
      match lam
        case ELam(list(x, acc), body) => fused(f, xs, x, body, acc.name)
        case _ => None
      end
    case _ => None
  end

// the loops of the generators gs, nested, in a scope with the local variables env, where the innermost adds the element e
// by add if the condition holds, and a list is walked by its cells and an array by its indices
procedure compile_loops(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * Expr * Var],
      cond: Option[Expr],
      e: Expr,
      add: CExpr -> List[CStmt],
  out ss: List[CStmt],
  ref g: Gen
) :=
  local cs: List[CStmt], rc: CExpr, es: List[CStmt], re: CExpr, body: List[CStmt], l: Str, n: Str, i: Str, item: CStmt

  match gs
    case list() =>
      call   compile_expr(in defs, env, e, out es, re, ref g)
      assign ss := es ++ add(re)
      match cond
        case Some(q) =>
          call   compile_expr(in defs, env, q, out cs, rc, ref g)
          assign ss := cs ++ list(CsIf(truth(rc), ss, list()))
        case None =>
          skip
      end

    case list((f, c, x); rest) =>
      call   compile_expr(in defs, env, c, out cs, rc, ref g)
      call   compile_loops(in defs, in_scope(list(x.name)) ++ env, rest, cond, e, add, out body, ref g)
      call   gen_name(in "l", out l, ref g)

      if f == list_foldr_name()
        assign item := declare(var_name(x.name), field(CeVar(l), 0))
        assign ss := cs ++ list(declare(l, rc), walk_list(l, item, body))
      else
        call   gen_name(in "n", out n, ref g)
        call   gen_name(in "i", out i, ref g)
        assign item := declare(var_name(x.name), CeIndex(CeArrow(CeVar(l), "items"), CeVar(i)))
        assign ss := cs ++ list(declare(l, rc), declare_size(n, l), declare_int(i, 0))
        assign ss := ss ++ list(walk_array(i, n, item, body))
      end
  end

// the list of a comprehension, built in order, where d points to the place of the next cell, first t and then the tail of the
// last cell, which is init at the end
procedure compile_list_comprehension(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * Expr * Var],
      cond: Option[Expr],
      e: Expr,
      init: Expr,
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local is: List[CStmt], ri: CExpr, loops: List[CStmt], t: Str, d: Str

  call   gen_name(in "t", out t, ref g)
  call   gen_name(in "e", out d, ref g)
  call   compile_loops(in defs, env, gs, cond, e, lambda re => append_stmt(d, re), out loops, ref g)
  call   compile_expr(in defs, env, init, out is, ri, ref g)
  assign ss := list(declare(t, unit_value(nil_name())), declare_ptr(d, CeUnary("&", CeVar(t)))) ++ loops
  assign ss := ss ++ is ++ list(CsAssign(CeUnary("*", CeVar(d)), ri)), r := CeVar(t)

// the array t of a comprehension, with room for as many elements as the first container has, which is exact for one
// generator without a condition, into which the loops push the elements, where t grows if a later generator adds more, and
// is shrunk to its elements at the end unless it has exactly as many
procedure compile_array_comprehension(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * Expr * Var],
      cond: Option[Expr],
      e: Expr,
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local cs: List[CStmt], rc: CExpr, loops: List[CStmt], t: Str, n: Str, l: Str, source := unqualified("(source)")
  local scope: Vars, inner: List[Name * Expr * Var]

  match gs
    case list((f, c, x); rest) =>
      call   compile_expr(in defs, env, c, out cs, rc, ref g)
      call   gen_name(in "t", out t, ref g)
      call   gen_name(in "n", out n, ref g)
      call   gen_name(in "l", out l, ref g)
      assign scope := list((source, CeVar(l)); env), inner := list((f, EVar(Var(source, THole)), x); rest)
      call   compile_loops(in defs, scope, inner, cond, e, lambda re => push_stmt(t, re), out loops, ref g)
      assign ss := cs ++ list(declare(l, rc), declare_count(n, l), declare_array(t, n)) ++ loops
      assign r := CeVar(t)

      if rest != list()
        assign ss := ss ++ list(CsAssign(CeVar(t), c_call("u_array_done", list(CeVar(t), CeNum(-1)))))
      else
        if cond != None
          assign ss := ss ++ list(CsAssign(CeVar(t), c_call("u_array_done", list(CeVar(t), CeVar(n)))))
        end
      end

    case list() =>
      raise Unsupported("a comprehension without generators")
  end

function declare(x: Str, init: CExpr): CStmt :=
  CsDecl(value_type(), x, Some(init))

function declare_int(x: Str, num: Int): CStmt :=
  CsDecl(CtInt, x, Some(CeNum(num)))

function set_var(x: Str, e: CExpr): CStmt :=
  CsAssign(CeVar(x), e)

function call_c(f: Str, args: List[CExpr]): CStmt :=
  CsExpr(c_call(f, args))

function not_flag(d: Str): CExpr :=
  CeUnary("!", CeVar(d))

function pop_handler(d: Str): CStmt :=
  call_c("u_pop", list(CeVar(d)))

function push_handler(d: Str): CStmt :=
  CsDecl(CtPtr(CtNamed("struct u_handler")), d, Some(c_call("u_push", list())))

function setjmp_zero(d: Str): CExpr :=
  CeBinary("==", c_call("setjmp", list(CeArrow(CeVar(d), "env"))), CeNum(0))

function null_decls(locals: List[Var]): List[CStmt] :=
  list(for x in locals yield declare_null(x.name))

function save_vars(env: Vars, xs: List[Name]): List[CStmt] :=
  list(for x in xs yield declare(saved_name(x), var_expr(env, x)))

function restore_vars(env: Vars, xs: List[Name]): List[CStmt] :=
  list(for x in xs yield CsAssign(var_expr(env, x), CeVar(saved_name(x))))

function address_args(env: Vars, outs: List[Var], refs: List[Var]): List[CExpr] :=
  list(for x in outs ++ refs yield address(var_expr(env, x.name)))

function var_names(xs: List[Var]): List[Name] :=
  list(for x in xs yield x.name)

// the variables of names that are local variables of env
function captured(env: Vars, names: List[Name]): List[Name] :=
  list(for x in distinct(names) if get(x, env) != None)

function make_closure(kind: Str, f: Str, caps: List[Name], env: Vars): CExpr :=
  c_call(kind, list(CeVar(f), CeNum(size(caps))) ++ list(for x in caps yield var_expr(env, x)))

function guarded(c: CExpr, t: Str, bs: List[CStmt], rb: CExpr): CStmt :=
  CsIf(c, bs ++ list(set_var(t, rb)), list())

function case_if(flag: Str, tests: List[CExpr], pat: Pat, v: CExpr, body: List[CStmt]): CStmt :=
  CsIf(conjunction(list(not_flag(flag)) ++ tests), pattern_binds(pat, v) ++ body, list())

function declare_ptr(x: Str, init: CExpr): CStmt :=
  CsDecl(value_ptr(), x, Some(init))

function declare_size(n: Str, l: Str): CStmt :=
  CsDecl(CtInt, n, Some(CeArrow(CeVar(l), "size")))

function declare_count(n: Str, l: Str): CStmt :=
  CsDecl(CtInt, n, Some(c_call("u_count", list(CeVar(l)))))

function is_cell(l: Str): CExpr :=
  c_call("u_is_con", list(CeVar(l), descriptor(cons_name())))

function walk_list(l: Str, item: CStmt, body: List[CStmt]): CStmt :=
  CsWhile(is_cell(l), list(item) ++ body ++ list(set_var(l, field(CeVar(l), 1))))

function declare_array(t: Str, n: Str): CStmt :=
  declare(t, c_call("u_array_new", list(CeVar(n))))

function walk_array(i: Str, n: Str, item: CStmt, body: List[CStmt]): CStmt :=
  CsWhile(CeBinary("<", CeVar(i), CeVar(n)), list(item) ++ body ++ list(set_var(i, CeBinary("+", CeVar(i), CeNum(1)))))

function append_stmt(d: Str, re: CExpr): List[CStmt] :=
  list(set_var(d, c_call("u_append", list(CeVar(d), re))))

function push_stmt(t: Str, re: CExpr): List[CStmt] :=
  list(set_var(t, c_call("u_array_push", list(CeVar(t), re))))

function value_formals(xs: List[Var]): List[CType * Str] :=
  list(for x in var_names(xs) yield (value_type(), var_name(x)))

function pointer_formals(xs: List[Var]): List[CType * Str] :=
  list(for x in var_names(xs) yield (value_ptr(), ref_name(x)))

function prototypes(fs: List[CDecl]): List[CDecl] :=
  list(for d in fs for p in prototype(d) yield p)

function main_function(ms: List[CStmt]): CDecl :=
  CdFunction(CtInt, "main", main_formals(), main_body(ms))

function main_body(ms: List[CStmt]): List[CStmt] :=
  list(call_c("u_args", list(CeVar("argc"), CeVar("argv")))) ++ ms ++ list(CsReturn(Some(CeNum(0))))

function main_formals(): List[CType * Str] :=
  list((CtInt, "argc"), (CtPtr(CtPtr(CtNamed("char"))), "argv"))

// statements, whose variables are local variables of C, where procedures copy outs and refs back at their end
procedure compile_stmt(in defs: Defs, env: Vars, s: Stmt, out ss: List[CStmt], ref g: Gen) :=
  local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], ra: CExpr, rb: CExpr, rc: CExpr, rs: List[CExpr]
  local t: Str, d: Str, xs: List[Name], ps: List[CExpr]

  match s
    case SSkip =>
      assign ss := list()

    case SAssign(assignments) =>
      call   compile_exprs(in defs, env, seconds(assignments), out as, rs, ref g)
      call   temps(in rs, out cs, ref g)
      assign ss := as ++ cs ++ reassign(env, list(for x in firsts(assignments) yield x.name), cs)

    case SBlock(locals, stmts) =>
      call   compile_stmts(in defs, in_scope(list(for x in locals yield x.name)) ++ env, stmts, out bs, ref g)
      assign ss := list(CsBlock(null_decls(locals) ++ bs))

    case SIf(cond, then_stmt, else_stmt) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_stmt(in defs, env, then_stmt, out as, ref g)
      call   compile_stmt(in defs, env, else_stmt, out bs, ref g)
      assign ss := cs ++ list(CsIf(truth(rc), as, bs))

    case SWhile(cond, body) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_stmt(in defs, env, body, out bs, ref g)
      call   gen_name(in "t", out t, ref g)
      call   compile_expr(in defs, env, cond, out as, ra, ref g)
      assign ss := cs ++ list(declare(t, rc), CsWhile(truth(CeVar(t)), bs ++ as ++ list(set_var(t, ra))))

    // a variable of a procedure type hides the procedures of that name
    case SCall(proc, ins, outs, refs) =>
      call compile_exprs(in defs, env, ins, out as, rs, ref g)

      assign ps := address_args(env, outs, refs)

      if get(proc, env) != None
        assign rs := list(var_expr(env, proc), CeNum(size(ins)), CeNum(size(outs ++ refs))) ++ rs ++ ps
        assign ss := as ++ list(call_c("u_call_proc", rs))
      else
        assign ss := as ++ list(call_c(proc_name(proc), rs ++ ps))
      end

    case SMatch(expr, cases) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      call   gen_name(in "s", out d, ref g)
      call   gen_name(in "d", out t, ref g)
      call   stmt_cases(in defs, env, cases, CeVar(d), t, out bs, ref g)
      assign ss := as ++ list(CsDecl(value_type(), d, Some(ra)), CsDecl(CtInt, t, Some(CeNum(0)))) ++ bs
      assign ss := ss ++ list(CsIf(CeUnary("!", CeVar(t)), list(CsExpr(c_call("u_no_case", list(CeVar(d))))), list()))

    // assertions of equations show both sides when they fail
    case SAssert(EApp(EVar(Var(Name(None, "=="), _)), list(a, b))) =>
      call   compile_expr(in defs, env, a, out as, ra, ref g)
      call   compile_expr(in defs, env, b, out bs, rb, ref g)
      assign ss := as ++ bs ++ list(CsExpr(c_call("u_assert_equal", list(ra, rb))))

    case SAssert(cond) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      assign ss := cs ++ list(CsExpr(c_call("u_assert_true", list(rc))))

    // exceptions carry their type, which handlers compare
    case SRaise(expr, typ) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      assign ss := as ++ list(CsExpr(c_call("u_raise", list(ra, CeStr(type_key(typ))))))

    // the body runs after setjmp returns 0, and the handlers after a raise jumps back, which raise again if none applies,
    // where the handlers start from the variables before the try, which their copies, unchanged since setjmp, restore
    case STry(body, handlers) =>
      call   compile_stmt(in defs, env, body, out bs, ref g)
      call   gen_name(in "h", out d, ref g)
      call   gen_name(in "d", out t, ref g)
      call   handler_cases(in defs, env, handlers, d, t, out cs, ref g)
      assign xs := list(for x in distinct(changed(body)) if get(x, env) != None)
      assign as := list(pop_handler(d)) ++ restore_vars(env, xs) ++ list(declare_int(t, 0))
      assign as := as ++ cs ++ list(CsIf(not_flag(t), list(call_c("u_reraise", list(CeVar(d)))), list()))
      assign ss := save_vars(env, xs) ++ list(push_handler(d))
      assign ss := list(CsBlock(ss ++ list(CsIf(setjmp_zero(d), bs ++ list(pop_handler(d)), as))))
  end

function saved_name(x: Name): Str :=
  "was_" ++ var_name(x)

// the variables that s assigns, directly or as outs and refs
function changed(s: Stmt): List[Name] :=
  match s
    case SAssign(assignments) => list(for x in firsts(assignments) yield x.name)
    case SBlock(_, stmts) => list(for y in stmts for n in changed(y) yield n)
    case SIf(_, then_stmt, else_stmt) => changed(then_stmt) ++ changed(else_stmt)
    case SWhile(_, body) => changed(body)
    case SCall(_, _, outs, refs) => list(for x in outs ++ refs yield x.name)
    case SMatch(_, cases) => list(for b in cases for n in changed(b.body) yield n)
    case STry(b, handlers) => changed(b) ++ list(for h in handlers for n in changed(h.body) yield n)
    case _ => list()
  end

procedure compile_stmts(in defs: Defs, env: Vars, xs: List[Stmt], out ss: List[CStmt], ref g: Gen) :=
  local as: List[CStmt]

  assign ss := list()

  for x in xs do
    call   compile_stmt(in defs, env, x, out as, ref g)
    assign ss := ss ++ as
  end

function reassign(env: Vars, xs: List[Name], ts: List[CStmt]): List[CStmt] :=
  match (xs, ts)
    case (list(x; more), list(CsDecl(_, name, _); rest)) => list(CsAssign(var_expr(env, x), CeVar(name)); reassign(env, more, rest))
    case _ => list()
  end

// the handlers of an exception caught by h, which set the flag d when one applies, where _ handles all types
procedure handler_cases(in defs: Defs, env: Vars, hs: List[Handler], h: Str, d: Str, out ss: List[CStmt], ref g: Gen) :=
  local  v := c_call("u_caught", list(CeVar(h)))
  local  bs: List[CStmt], gs: List[CStmt], rg: CExpr, body: List[CStmt], rest: List[CStmt], env1: Vars, tests: List[CExpr]

  match hs
    case list() =>
      assign ss := list()
    case list(Handler(_, typ, pat, guard, s); more) =>
      assign env1 := in_scope(pattern_names(pat)) ++ env
      call   compile_stmt(in defs, env1, s, out bs, ref g)
      assign body := list(CsAssign(CeVar(d), CeNum(1))) ++ bs
      match guard
        case Some(c) =>
          call   compile_expr(in defs, env1, c, out gs, rg, ref g)
          assign body := gs ++ list(CsIf(truth(rg), body, list()))
        case None =>
          skip
      end
      match pat
        case PWild =>
          assign tests := list()
        case _ =>
          assign tests := list(c_call("u_has_type", list(CeVar(h), CeStr(type_key(typ))))) ++ pattern_tests(pat, v)
      end
      call   handler_cases(in defs, env, more, h, d, out rest, ref g)
      assign ss := list(case_if(d, tests, pat, v, body)) ++ rest
  end

// the cases of a match statement, which set the flag d when one applies
procedure stmt_cases(
  in  defs: Defs,
      env: Vars,
      cases: List[Branch[Stmt]],
      v: CExpr,
      d: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  local bs: List[CStmt], gs: List[CStmt], rg: CExpr, body: List[CStmt], rest: List[CStmt], env1: Vars

  match cases
    case list() =>
      assign ss := list()
    case list(Branch(_, pat, guard, s); more) =>
      assign env1 := in_scope(pattern_names(pat)) ++ env
      call   compile_stmt(in defs, env1, s, out bs, ref g)
      assign body := list(CsAssign(CeVar(d), CeNum(1))) ++ bs
      match guard
        case Some(c) =>
          call   compile_expr(in defs, env1, c, out gs, rg, ref g)
          assign body := gs ++ list(CsIf(truth(rg), body, list()))
        case None =>
          skip
      end
      call   stmt_cases(in defs, env, more, v, d, out rest, ref g)
      assign ss := list(case_if(d, pattern_tests(pat, v), pat, v, body)) ++ rest
  end

// the C functions of a command, and the statements of main for runs and tests
procedure compile_cmd(in defs: Defs, entry: Id, cmd: Cmd, out ds: List[CDecl], ms: List[CStmt], ref g: Gen) :=
  local bs: List[CStmt], rb: CExpr, params: List[CType * Str]

  match cmd
    case CFun(name, _, formals, _, body) =>
      call   compile_expr(in defs, in_scope(list(for x in formals yield x.name)), body, out bs, rb, ref g)
      assign params := list(for x in formals yield (value_type(), var_name(x.name)))

      if formals == list()
        assign bs := cached(format_name(name), bs, rb)
      else
        assign bs := bs ++ list(CsReturn(Some(rb)))
      end
      assign ds := list(CdFunction(value_type(), fun_name(name, size(formals)), params, bs)), ms := list()

    // outs and refs are pointers to the variables of the caller, which the procedure assigns when it returns
    case CProc(name, _, ins, outs, refs, stmt) =>
      call   compile_stmt(in defs, in_scope(var_names(ins ++ outs ++ refs)), stmt, out bs, ref g)
      assign params := value_formals(ins) ++ pointer_formals(outs ++ refs)
      assign bs := copy_in(var_names(outs), var_names(refs)) ++ bs ++ copy_out(var_names(outs ++ refs))
      assign ds := list(CdFunction(CtVoid, proc_name(name), params, bs)), ms := list()

    case CTest(test_name, _, stmt) if entry == "test" =>
      call   compile_stmt(in defs, list(), stmt, out bs, ref g)
      assign ds := list(), ms := list(CsBlock(bs ++ list(CsExpr(c_call("u_passed", list(CeStr(test_name)))))))

    case _ =>
      assign ds := list(), ms := list()
  end

procedure compile_cmds(in defs: Defs, entry: Id, cmds: List[Cmd], out ds: List[CDecl], ms: List[CStmt], ref g: Gen) :=
  local d1: List[CDecl], m1: List[CStmt], found_ds: Buffer[CDecl] := empty(), found_ms: Buffer[CStmt] := empty()

  for c in cmds do
    call   compile_cmd(in defs, entry, c, out d1, m1, ref g)
    assign found_ds := found_ds ++ d1, found_ms := found_ms ++ m1
  end

  assign ds := list(for d in found_ds), ms := list(for m in found_ms)

// the body of a function without arguments, whose value is computed once, since expressions are deterministic,
// where the cache is U_COMPUTING while the value is computed, which detects a value that needs itself,
// and an exception that leaves the computation resets the cache, such that the next call computes it again
function cached(n: Str, bs: List[CStmt], r: CExpr): List[CStmt] :=
  cache_start(n) ++ bs ++ list(pop_cache_handler(), CsAssign(CeVar("cache"), r), CsReturn(Some(CeVar("cache"))))

function cache_handler(): CExpr :=
  CeVar("handler")

function cache_start(n: Str): List[CStmt] :=
  list(cache_decl(), cache_computing(n), cache_hit(), cache_mark(), cache_handler_decl(), cache_catch())

function cache_decl(): CStmt :=
  CsDecl(CtNamed("static u_value"), "cache", Some(CeVar("NULL")))

function cache_computing(n: Str): CStmt :=
  CsIf(CeBinary("==", CeVar("cache"), CeVar("U_COMPUTING")), list(fail_recursive(n)), list())

function cache_hit(): CStmt :=
  CsIf(CeVar("cache"), list(CsReturn(Some(CeVar("cache")))), list())

function cache_mark(): CStmt :=
  CsAssign(CeVar("cache"), CeVar("U_COMPUTING"))

function cache_handler_decl(): CStmt :=
  CsDecl(CtPtr(CtNamed("struct u_handler")), "handler", Some(c_call("u_push", list())))

function cache_catch(): CStmt :=
  CsIf(CeBinary("!=", c_call("setjmp", list(CeArrow(cache_handler(), "env"))), CeNum(0)), cache_unwind(), list())

function pop_cache_handler(): CStmt :=
  CsExpr(c_call("u_pop", list(cache_handler())))

function fail_recursive(n: Str): CStmt :=
  CsExpr(c_call("u_fail", list(CeStr(format_failure(RecursiveInitialization(n))))))

function cache_unwind(): List[CStmt] :=
  list(pop_cache_handler(), CsAssign(CeVar("cache"), CeVar("NULL")), CsExpr(c_call("u_reraise", list(cache_handler()))))

// closures of functions, constructors, and builtins, which take their arguments from an array
function wrappers(defs: Defs): List[CDecl] :=
  fun_wrappers(defs) ++ constr_wrappers(defs) ++ builtin_wrappers() ++ proc_wrappers(defs)

function fun_wrappers(defs: Defs): List[CDecl] :=
  list(for p in firsts(list(for x in defs.funs)) yield fun_wrapper(p))

function constr_wrappers(defs: Defs): List[CDecl] :=
  list(for p in constr_arities(defs) for w in constr_wrapper(p) yield w)

function builtin_wrappers(): List[CDecl] :=
  list(for p in distinct(seconds(list(for x in builtin_functions()))) yield builtin_wrapper(p))

function proc_wrappers(defs: Defs): List[CDecl] :=
  list(for p in proc_arities(defs) yield proc_wrapper(p))

function proc_call(n: Name, k: Int, m: Int): CStmt :=
  CsExpr(c_call(proc_name(n), indexed("ins", k) ++ indexed("outs", m)))

// procedures as values call the procedure with the values of the array ins and the pointers of the array outs
function proc_wrapper(p: Name * (Int * Int)): CDecl :=
  match p
    case (n, (k, m)) =>
      CdFunction(CtVoid, "wp_" ++ mangle(n), proc_params(), list(proc_call(n, k, m)))
  end

function fun_wrapper(p: Name * Int): CDecl :=
  match p
    case (n, k) => wrapper("w_" ++ fun_name(n, k), fun_name(n, k), k)
  end

function builtin_wrapper(p: Str * Int): CDecl :=
  match p
    case (f, k) => wrapper("w" ++ f, f, k)
  end

function wrapper(w: Str, f: Str, k: Int): CDecl :=
  CdFunction(value_type(), w, closure_params(), list(CsReturn(Some(c_call(f, indexed("args", k))))))

function closure_params(): List[CType * Str] :=
  list((value_ptr(), "env"), (value_ptr(), "args"))

function indexed(name: Str, k: Int): List[CExpr] :=
  list(for i in range_to(k) yield index(name, i))

function con_array(n: Name, k: Int): CExpr :=
  c_call("u_mk_con_array", list(descriptor(n), CeNum(k), CeVar("args")))

// constructors without fields are no functions
function constr_wrapper(p: Name * Int): List[CDecl] :=
  match p
    case (_, 0) => list()
    case (n, k) =>
      list(CdFunction(value_type(), "wc_" ++ mangle(n), closure_params(), list(CsReturn(Some(con_array(n, k))))))
  end

function range_to(k: Int): List[Int] :=
  if k == 0 then list() else range_to(k - 1) ++ list(k - 1)

function prototype(d: CDecl): List[CDecl] :=
  match d
    case CdFunction(typ, fun, formals, _) => list(CdPrototype(typ, fun, formals))
    case _ => list()
  end

// the C of q of module m, whose main calls the procedure entry without parameters, or runs all tests for the entry test
procedure compile_program(in q: Prog, m: Id, entry: Id, out f: CFile) :=
  local g := Gen(0, list()), defs := defs_of(q), ds: List[CDecl], ms: List[CStmt], fs: List[CDecl], hs: List[CDecl]

  if entry != "test" and not exists(q.cmds, lambda c => is_entry(c, Name(Some(m), entry)))
    raise UnknownEntry(Name(Some(m), entry))
  end

  call   compile_cmds(in defs, entry, q.cmds, out ds, ms, ref g)

  if entry != "test"
    assign ms := list(CsExpr(c_call(proc_name(Name(Some(m), entry)), list())))
  end

  assign fs := wrappers(defs) ++ ds ++ g.lifted
  assign hs := list(CdInclude("ulang.h")) ++ prototypes(fs) ++ descriptor_decls(defs, q.cmds) ++ texts()
  assign f := CFile(hs ++ fs ++ list(main_function(ms)))

// the texts of the runtime errors that self/runtime/ulang.c prints
function texts(): List[CDecl] :=
  list(for p in failure_formats() yield text_decl(p))

function text_decl(p: Str * Str): CDecl :=
  let (name, text) := p in CdGlobal(CtNamed("const char *const"), name, Some(CeStr(text)))

// checks the program of the file source, which is its module, and writes its translation to C to target, with the module
// list, which the runtime needs, also for the modules before it, which do not import it
procedure compile_file(in source: Str, entry: Id, target: Str) :=
  local parsed: Source, q: Prog, f: CFile

  call   parse_file(in source, out parsed)
  call   load_modules(in source, list("list"), ref parsed)
  call   check_program(in parsed, out q)
  call   compile_program(in q, parsed.main, entry, out f)
  call   os_write(in target, format_file(f))

// a procedure without parameters
function is_entry(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, list(), list(), list(), _) => name == n
    case _ => false
  end
