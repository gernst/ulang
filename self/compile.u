// a compiler from programs of self/syntax.u, which self/check.u has checked, to C in the syntax of self/c.u,
// whose code calls the runtime in self/runtime, where every value has the C type u_value

import syntax
import check
import defs
import format
import c
import parse
import os
import map
import set

export

data CompileError :=
  | Unsupported(what: Str)
  | UnknownEntry(name: Name)

procedure compile_file(in source: Str, entry: Id, target: Str)
function is_entry(cmd: Cmd, n: Name): Bool

implementation

// the variables in scope with the C expressions they are accessed through
type Vars :=
  List[Name * CExpr]

data Gen :=
  | Gen(count: Int, lifted: List[CDecl])

function value_type(): CType :=
  CtNamed("u_value")

function value_ptr(): CType :=
  CtPtr(CtNamed("u_value"))

// names of ulang with their modules as names of C, where other characters than letters, digits, and _ are their codes
function mangle(n: Name): Str :=
  str([d for c in list(format_name(n)), d in mangle_char(c)])

function mangle_char(c: Char): List[Char] :=
  if is_letter(c) or is_digit(c) or c == '_' then [c] else list("_" ++ show(ord(c)) ++ "_")

function fun_name(n: Name, k: Int): Str :=
  "f_" ++ mangle(n) ++ "_" ++ show(k)

// the C function of procedure n, which the runtime defines for those of the builtin section of os
function proc_name(n: Name): Str :=
  if n.module == Some("os") and contains(n.base, native_procs()) then "p_" ++ n.base else "p_" ++ mangle(n)

// the procedures of the builtin section of os
function native_procs(): Set[Id] :=
  {"os_args", "os_read", "os_write", "os_library", "os_print", "os_print_error", "os_exit", "os_list", "os_is_dir", "os_cwd", "os_chdir"}

function var_name(n: Name): Str :=
  "v_" ++ mangle(n)

function ref_name(n: Name): Str :=
  "r_" ++ mangle(n)

// the functions of the runtime for the builtins with their numbers of arguments, without a module, and of the builtin
// sections of the prelude, str.u, and array.u by their qualified names
function builtin_functions(): Map[Name, Str * Int] :=
  {
    Name(Some("prelude"), "+") => ("u_add", 2),
    Name(Some("prelude"), "-") => ("u_sub", 2),
    Name(Some("prelude"), "*") => ("u_mul", 2),
    Name(Some("prelude"), "/") => ("u_div", 2),
    Name(Some("prelude"), "%") => ("u_mod", 2),
    unqualified("<") => ("u_lt", 2),
    unqualified("==") => ("u_eq", 2),
    unqualified("compare") => ("u_compare", 2),
    unqualified("show") => ("u_show", 1),
    Name(Some("str"), "list") => ("u_chars", 1),
    Name(Some("str"), "str") => ("u_string", 1),
    Name(Some("str"), "ord") => ("u_ord", 1),
    Name(Some("str"), "chr") => ("u_chr", 1),
    Name(Some("prelude"), "++") => ("u_concat", 2),
    Name(Some("str"), "is_digit") => ("u_is_digit", 1),
    Name(Some("str"), "is_letter") => ("u_is_letter", 1),
    Name(Some("str"), "is_space") => ("u_is_space", 1),
    Name(Some("str"), "size") => ("u_size", 1),
    Name(Some("str"), "at") => ("u_at", 2),
    Name(Some("str"), "contains") => ("u_contains", 2),
    Name(Some("str"), "slice") => ("u_slice", 3),
    Name(Some("str"), "join") => ("u_join", 2),
    Name(Some("str"), "split") => ("u_split", 2),
    Name(Some("str"), "quote") => ("u_quote", 1),
    Name(Some("str"), "number") => ("u_number", 1),
    Name(Some("array"), "array") => ("u_array", 1),
    Name(Some("array"), "list") => ("u_array_list", 1),
    Name(Some("array"), "size") => ("u_array_size", 1),
    Name(Some("array"), "at") => ("u_array_at", 2),
    Name(Some("array"), "slice") => ("u_array_slice", 3),
    Name(Some("array"), "foldr") => ("u_array_foldr", 3),
    Name(Some("array"), "foldl") => ("u_array_foldl", 3)
  }

// the descriptor of constructor n, which the runtime compares by its address
function descriptor(n: Name): CExpr :=
  CeUnary("&", CeVar("n_" ++ mangle(n)))

// the shared value of constructor n without arguments
function unit_value(n: Name): CExpr :=
  CeUnary("&", CeVar("o_" ++ mangle(n)))

// the datatypes and constructors whose descriptors the runtime defines, of OsError, which its builtins create also in
// programs that do not import os, while each program defines those of the prelude and its modules, which it always has
function runtime_constructors(): Set[Name] :=
  {os_error_name()}

function runtime_types(): Set[Name] :=
  {os_error_name()}

function type_name(t: Name): Str :=
  "t_" ++ mangle(t)

// the descriptor of constructor n at position i of its declaration, of datatype t
function descriptor_decl(n: Name, i: Int, t: Name): CDecl :=
  match n
    case Name(Some(m), base) => CdGlobal(CtNamed("const struct u_name"), "n_" ++ mangle(n), Some(CeInit([CeStr(m), CeStr(base), CeNum(i), CeUnary("&", CeVar(type_name(t)))])))
    case Name(None, base) => CdGlobal(CtNamed("const struct u_name"), "n_" ++ mangle(n), Some(CeInit([CeVar("NULL"), CeStr(base), CeNum(i), CeUnary("&", CeVar(type_name(t)))])))
  end

// the shared value of constructor n without arguments, of datatype t
function unit_decl(n: Name, t: Name): CDecl :=
  CdGlobal(CtNamed("struct u_object"), "o_" ++ mangle(n), Some(c_call("U_UNIT", [CeVar("n_" ++ mangle(n)), CeVar(type_name(t))])))

// the descriptors of the datatypes of cs and their constructors that the runtime does not define, and the values of
// the constructors without arguments, where the descriptor of a datatype points to the functions compare, ==, and show
// that its module declares, and otherwise to the structural ones of the runtime
function descriptor_decls(defs: Defs, cmds: List[Cmd]): List[CDecl] :=
  data_decls(cmds, defs.orders, defs.equalities, defs.shows)

function data_decls(
  cmds: List[Cmd],
  compares: Map[Name, Name],
  equalities: Map[Name, Name],
  shows: Map[Name, Name]
): List[CDecl] :=
  match cmds
    case Nil =>
      Nil
    case [CData(name, _, constrs); rest] =>
      type_decls(name, compares, equalities, shows) ++ constructor_decls(name, constrs, 0) ++ data_decls(rest, compares, equalities, shows)
    case [_; rest] =>
      data_decls(rest, compares, equalities, shows)
  end

function type_decls(
  t: Name,
  compares: Map[Name, Name],
  equalities: Map[Name, Name],
  shows: Map[Name, Name]
): List[CDecl] :=
  if contains(t, runtime_types()) then
    []
  else
    [
      CdGlobal(
        CtNamed("const struct u_type"),
        type_name(t),
        Some(
          CeInit(
            [
              CeStr(format_name(t)),
              CeVar(declared_or(get(t, compares), 2, "u_con_compare")),
              CeVar(declared_or(get(t, equalities), 2, "u_equals_by_compare")),
              CeVar(declared_or(get(t, shows), 1, "u_con_show"))
            ]
          )
        )
      )
    ]

// the C function of a declared function f with n parameters, or else the function of the runtime
function declared_or(f: Option[Name], n: Int, default: Str): Str :=
  match f
    case Some(g) => fun_name(g, n)
    case None => default
  end

function constructor_decls(t: Name, ks: List[Constr], i: Int): List[CDecl] :=
  match ks
    case Nil => Nil
    case [k; rest] if contains(k.name, runtime_constructors()) => constructor_decls(t, rest, i + 1)
    case [Constr(name, []); rest] => [descriptor_decl(name, i, t), unit_decl(name, t); constructor_decls(t, rest, i + 1)]
    case [Constr(name, _); rest] => [descriptor_decl(name, i, t); constructor_decls(t, rest, i + 1)]
  end

function in_scope(xs: List[Name]): Vars :=
  [(x, CeVar(var_name(x))) for x in xs]

function var_expr(env: Vars, x: Name): CExpr :=
  match get(x, env)
    case Some(c) => c
    case _ => CeVar(var_name(x))
  end

function address(c: CExpr): CExpr :=
  CeUnary("&", c)

// outs and refs are locals of a procedure, which start as NULL and as the value of the caller, and which go back to the caller
// only when it returns, so that an exception leaves the variables of the caller as they were
function copy_in(outs: List[Name], refs: List[Name]): List[CStmt] :=
  [CsDecl(value_type(), var_name(x), Some(CeVar("NULL"))) for x in outs] ++
    [CsDecl(value_type(), var_name(x), Some(CeUnary("*", CeVar(ref_name(x))))) for x in refs]

function copy_out(xs: List[Name]): List[CStmt] :=
  [CsAssign(CeUnary("*", CeVar(ref_name(x))), CeVar(var_name(x))) for x in xs]

// types as names of exceptions, which handlers compare
function type_key(t: Type): Str :=
  match t
    case TSort(name, []) => format_name(name)
    case TSort(name, args) => format_name(name) ++ "[" ++ join(", ", [type_key(a) for a in args]) ++ "]"
    case TFun(args, res) => "(" ++ join(", ", [type_key(a) for a in args]) ++ ") -> " ++ type_key(res)
    case TProc(ins, outs, refs) => "(in " ++ join(", ", [type_key(a) for a in ins]) ++ ", out " ++ join(", ", [type_key(a) for a in outs]) ++ ", ref " ++ join(", ", [type_key(a) for a in refs]) ++ ")"
    case TTuple(types) => "(" ++ join(" * ", [type_key(a) for a in types]) ++ ")"
    case _ => "?"
  end

// a function n with k arguments
function is_global_fun(defs: Defs, n: Name, k: Int): Bool :=
  contains((n, k), defs.funs)

// the number of fields of constructor n
function fields_count(defs: Defs, n: Name): Option[Int] :=
  match get(n, defs.constrs)
    case Some((k, _, _)) => Some(k)
    case None => None
  end

// the procedures with their numbers of ins and of outs and refs
function proc_arities(defs: Defs): List[Name * (Int * Int)] :=
  [(n, proc_arity(d)) for n => d in defs.procs]

function proc_arity(d: List[Var] * List[Var] * List[Var] * Stmt): Int * Int :=
  match d
    case (ins, outs, refs, _) => (size(ins), size(outs) + size(refs))
  end

function constr_arities(defs: Defs): List[Name * Int] :=
  [(n, constr_arity(d)) for n => d in defs.constrs]

function constr_arity(d: Int * Int * Name): Int :=
  match d
    case (k, _, _) => k
  end

function numbered[A](xs: List[A], i: Int): List[A * Int] :=
  match xs
    case [] => []
    case [x; rest] => [(x, i); numbered(rest, i + 1)]
  end

function index(a: Str, i: Int): CExpr :=
  CeIndex(CeVar(a), CeNum(i))

function field(v: CExpr, i: Int): CExpr :=
  c_call("u_field", [v, CeNum(i)])

function truth(v: CExpr): CExpr :=
  c_call("u_truth", [v])

function conjunction(cs: List[CExpr]): CExpr :=
  match cs
    case [] => CeNum(1)
    case [d] => d
    case [d; rest] => CeBinary("&&", d, conjunction(rest))
  end

function literal_value(l: Val): CExpr :=
  match l
    case VUnit => c_call("u_mk_tuple", [CeNum(0)])
    case VBool(bool) => c_call("u_mk_bool", [CeNum(if bool then 1 else 0)])
    case VInt(num) => if -1000000000000000000 < num and num < 1000000000000000000 then c_call("u_mk_int", [CeNum(num)]) else c_call("u_mk_int_str", [CeStr(show(num))])
    case VStr(text) => c_call("u_mk_lit", [CeStr(text)])
    case VChar(char) => c_call("u_mk_char", [CeNum(ord(char))])
  end

// the tests that v matches p, in an order that checks a constructor before its fields
function pattern_tests(pat: Pat, v: CExpr): List[CExpr] :=
  match pat
    case PLit(lit) => [c_call("u_equals", [v, literal_value(lit)])]
    case PApp(constr, pats) => [c_call("u_is_con", [v, descriptor(constr)])] ++ field_tests(numbered(pats, 0), v)
    case PTuple(pats) => field_tests(numbered(pats, 0), v)
    case _ => []
  end

function field_tests(ps: List[Pat * Int], v: CExpr): List[CExpr] :=
  match ps
    case [] => []
    case [(p, i); rest] => pattern_tests(p, field(v, i)) ++ field_tests(rest, v)
  end

// the declarations of the variables of p, where v matches p
function pattern_binds(pat: Pat, v: CExpr): List[CStmt] :=
  match pat
    case PVar(Var(name, _)) => [CsDecl(value_type(), var_name(name), Some(v))]
    case PApp(_, pats) => field_binds(numbered(pats, 0), v)
    case PTuple(pats) => field_binds(numbered(pats, 0), v)
    case _ => []
  end

function field_binds(ps: List[Pat * Int], v: CExpr): List[CStmt] :=
  match ps
    case [] => []
    case [(p, i); rest] => pattern_binds(p, field(v, i)) ++ field_binds(rest, v)
  end

function pattern_names(pat: Pat): List[Name] :=
  match pat
    case PVar(Var(name, _)) => [name]
    case PApp(_, pats) => [x for q in pats, x in pattern_names(q)]
    case PTuple(pats) => [x for q in pats, x in pattern_names(q)]
    case _ => []
  end

// the variables of e that bound does not bind, which lambdas capture if they are local
function free_vars(expr: Expr, bound: List[Name]): List[Name] :=
  match expr
    case ELit(_) => []
    case EVar(Var(name, _)) => if contains(name, bound) then [] else [name]
    case EApp(fun, args) => free_vars(fun, bound) ++ [n for a in args, n in free_vars(a, bound)]
    case ELam(formals, body) => free_vars(body, names(formals) ++ bound)
    case EProc(ins, outs, refs, stmt) => free_in_stmt(stmt, names(ins ++ outs ++ refs) ++ bound)
    case ELet(bindings, body) => [n for a in seconds(bindings), n in free_vars(a, bound)] ++ free_vars(body, names(firsts(bindings)) ++ bound)
    case EIte(cond, then_expr, else_expr) => free_vars(cond, bound) ++ free_vars(then_expr, bound) ++ free_vars(else_expr, bound)
    case EMatch(expr, cases) => free_vars(expr, bound) ++ [n for b in cases, n in free_in_branch(b, bound)]
    case ETuple(exprs) => [n for a in exprs, n in free_vars(a, bound)]
    case ERaise(expr, _) => free_vars(expr, bound)
  end

// the variables of x that bound does not bind, including procedures called through variables
function free_in_stmt(x: Stmt, bound: List[Name]): List[Name] :=
  match x
    case SSkip => []
    case SAssign(assignments) => [y for y in names(firsts(assignments)) if not contains(y, bound)] ++ [n for a in seconds(assignments), n in free_vars(a, bound)]
    case SBlock(locals, stmts) => [n for y in stmts, n in free_in_stmt(y, names(locals) ++ bound)]
    case SIf(cond, then_stmt, else_stmt) => free_vars(cond, bound) ++ free_in_stmt(then_stmt, bound) ++ free_in_stmt(else_stmt, bound)
    case SWhile(cond, body) => free_vars(cond, bound) ++ free_in_stmt(body, bound)
    case SCall(proc, ins, outs, refs) =>
      [y for y in [proc; names(outs ++ refs)] if not contains(y, bound)] ++ [n for a in ins, n in free_vars(a, bound)]
    case SMatch(expr, cases) => free_vars(expr, bound) ++ [n for b in cases, n in free_in_stmt_branch(b, bound)]
    case SAssert(cond) => free_vars(cond, bound)
    case SRaise(expr, _) => free_vars(expr, bound)
    case STry(body, handlers) => free_in_stmt(body, bound) ++ [n for h in handlers, n in free_in_handler(h, bound)]
  end

function free_in_stmt_branch(b: Branch[Stmt], bound: List[Name]): List[Name] :=
  match b
    case Branch(pat, Some(g), body) => free_vars(g, pattern_names(pat) ++ bound) ++ free_in_stmt(body, pattern_names(pat) ++ bound)
    case Branch(pat, None, body) => free_in_stmt(body, pattern_names(pat) ++ bound)
  end

function free_in_handler(h: Handler, bound: List[Name]): List[Name] :=
  let inner := pattern_names(h.pat) ++ bound in
    free_in_stmt(h.body, inner) ++ (match h.guard case Some(g) => free_vars(g, inner) case None => [] end)

function free_in_branch(b: Branch[Expr], bound: List[Name]): List[Name] :=
  match b
    case Branch(pat, Some(g), body) => free_vars(g, pattern_names(pat) ++ bound) ++ free_vars(body, pattern_names(pat) ++ bound)
    case Branch(pat, None, body) => free_vars(body, pattern_names(pat) ++ bound)
  end

// the lambdas of the lists of parameters after the first of a function
function lambdas(xss: List[List[Var]], b: Expr): Expr :=
  match xss
    case [] => b
    case [xs; rest] => ELam(xs, lambdas(rest, b))
  end

procedure gen_name(in stem: Str, out x: Str, ref g: Gen) :=
  assign x := stem ++ show(g.count), g := g with count := g.count + 1

procedure lift(in d: CDecl, ref g: Gen) :=
  assign g := g with lifted := g.lifted ++ [d]

// a function, constructor, or builtin of name n with type t as a value, which is a closure of its wrapper
function global_value(defs: Defs, n: Name, t: Type): CExpr :=
  if is_global_fun(defs, n, arity(t)) then
    c_call("u_mk_closure", [CeVar("w_" ++ fun_name(n, arity(t))), CeNum(0)])
  else
    match fields_count(defs, n)
      case Some(0) => unit_value(n)
      case Some(_) => c_call("u_mk_closure", [CeVar("wc_" ++ mangle(n)), CeNum(0)])
      case None =>
        match get(n, builtin_functions())
          case Some((f, _)) => c_call("u_mk_closure", [CeVar("w" ++ f), CeNum(0)])
          case None if contains(n, defs.procs) => c_call("u_mk_proc", [CeVar("wp_" ++ mangle(n)), CeNum(0)])
          case None => raise Unsupported("the variable " ++ n.base)
        end
    end

// the statements that compute e in a scope with the local variables env, and its value r
procedure compile_expr(in defs: Defs, env: Vars, expr: Expr, out ss: List[CStmt], r: CExpr, ref g: Gen) :=
  local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], ra: CExpr, rb: CExpr, rc: CExpr, rs: List[CExpr], t: Str, d: Str

  match expr
    // a string literal is a static object, which is created once, named after its text
    case ELit(VStr(text)) =>
      call   gen_name(in "l_" ++ mangle(unqualified(slice(text, 0, if size(text) < 16 then size(text) else 16))) ++ "_", out t, ref g)
      assign ss := [CsDecl(CtNamed("static struct u_object"), t, Some(c_call("U_LIT", [CeStr(text)])))], r := CeUnary("&", CeVar(t))

    case ELit(lit) =>
      assign ss := Nil, r := literal_value(lit)

    case EVar(Var(name, typ)) =>
      match get(name, env)
        case Some(c) =>
          assign ss := Nil, r := c
        case None =>
          assign ss := Nil, r := global_value(defs, name, typ)
      end

    // |e for x in c, y in d if q| over lists and arrays, which fills an array without a list
    case EApp(EVar(Var(n, _)), [EApp(EVar(Var(f, _)), [xs, EVar(Var(k, _)), ELam([x, acc], body)])]) if n == array_name() and k == nil_name() and fused(f, xs, x, body, acc.name) != None =>
      match fused(f, xs, x, body, acc.name)
        case Some((gs, q, e)) =>
          call compile_array_comprehension(in defs, env, gs, q, e, out ss, r, ref g)
        case None =>
          raise Unsupported("an array comprehension")
      end

    // |a, b|, whose elements are the items of the array
    case EApp(EVar(Var(name, _)), [l]) if name == array_name() and list_literal(l) != None =>
      match list_literal(l)
        case Some(es) =>
          call   compile_exprs(in defs, env, es, out ss, rs, ref g)
          assign r := c_call("u_mk_array", [CeNum(size(rs))] ++ rs)
        case None =>
          raise Unsupported("an array literal")
      end

    // [e for x in c, y in d if q] over lists and arrays, nested folds into which comprehensions translate, are nested loops
    // that build the list in order
    case EApp(EVar(Var(n, _)), [xs, init, ELam([x, acc], body)]) if fused(n, xs, x, body, acc.name) != None =>
      match fused(n, xs, x, body, acc.name)
        case Some((gs, q, e)) =>
          call compile_list_comprehension(in defs, env, gs, q, e, init, out ss, r, ref g)
        case None =>
          raise Unsupported("a list comprehension")
      end

    case EApp(EVar(Var(name, typ)), args) if get(name, env) == None =>
      call compile_named(in defs, env, name, typ, args, out ss, r, ref g)

    case EApp(fun, args) =>
      call   compile_expr(in defs, env, fun, out as, ra, ref g)
      call   compile_exprs(in defs, env, args, out bs, rs, ref g)
      assign ss := as ++ bs, r := c_call("u_apply", [ra, CeNum(size(args))] ++ rs)

    case ELam(formals, body) =>
      call compile_lambda(in defs, env, formals, body, out ss, r, ref g)

    case EProc(ins, outs, refs, stmt) =>
      call compile_proc_lambda(in defs, env, ins, outs, refs, stmt, out ss, r, ref g)

    case ELet(bindings, body) =>
      call   compile_exprs(in defs, env, seconds(bindings), out as, rs, ref g)
      call   compile_expr(in defs, in_scope(names(firsts(bindings))) ++ env, body, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      call   temps(in rs, out cs, ref g)
      assign ss := as ++ cs ++ [CsDecl(value_type(), t, None), CsBlock(rebind(names(firsts(bindings)), cs) ++ bs ++ [CsAssign(CeVar(t), rb)])]
      assign r := CeVar(t)

    case EIte(cond, then_expr, else_expr) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_expr(in defs, env, then_expr, out as, ra, ref g)
      call   compile_expr(in defs, env, else_expr, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      assign ss := cs ++ [CsDecl(value_type(), t, None), CsIf(truth(rc), as ++ [CsAssign(CeVar(t), ra)], bs ++ [CsAssign(CeVar(t), rb)])]
      assign r := CeVar(t)

    case EMatch(expr, cases) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      call   gen_name(in "s", out d, ref g)
      call   gen_name(in "t", out t, ref g)
      call   expr_cases(in defs, env, cases, CeVar(d), t, out bs, ref g)
      assign ss := as ++ [CsDecl(value_type(), d, Some(ra)), CsDecl(value_type(), t, Some(CeVar("NULL")))] ++ bs
      assign ss := ss ++ [CsIf(CeUnary("!", CeVar(t)), [CsExpr(c_call("u_no_case", [CeVar(d)]))], [])]
      assign r := CeVar(t)

    case ETuple(exprs) =>
      call   compile_exprs(in defs, env, exprs, out ss, rs, ref g)
      assign r := c_call("u_mk_tuple", [CeNum(size(exprs))] ++ rs)

    // the value of a raise is never used, since u_raise does not return
    case ERaise(expr, typ) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      assign ss := as ++ [CsExpr(c_call("u_raise", [ra, CeStr(type_key(typ))]))], r := CeVar("NULL")
  end

procedure compile_exprs(in defs: Defs, env: Vars, exprs: List[Expr], out ss: List[CStmt], rs: List[CExpr], ref g: Gen) :=
  local as: List[CStmt], r: CExpr, bs: List[CStmt], more: List[CExpr]

  match exprs
    case [] =>
      assign ss := Nil, rs := Nil
    case [e; rest] =>
      call   compile_expr(in defs, env, e, out as, r, ref g)
      call   compile_exprs(in defs, env, rest, out bs, more, ref g)
      assign ss := as ++ bs, rs := [r; more]
  end

// the values rs in fresh variables, which later expressions do not change, as declarations
procedure temps(in rs: List[CExpr], out ss: List[CStmt], ref g: Gen) :=
  local t: Str, more: List[CStmt]

  match rs
    case [] =>
      assign ss := Nil
    case [r; rest] =>
      call   gen_name(in "t", out t, ref g)
      call   temps(in rest, out more, ref g)
      assign ss := [CsDecl(value_type(), t, Some(r)); more]
  end

// the variables xs as the temporaries declared by ts
function rebind(xs: List[Name], ts: List[CStmt]): List[CStmt] :=
  match (xs, ts)
    case ([x; more], [CsDecl(_, name, _); rest]) => [CsDecl(value_type(), var_name(x), Some(CeVar(name))); rebind(more, rest)]
    case _ => []
  end

// applications of functions, constructors, and builtins of their arities are direct calls
procedure compile_named(
  in  defs: Defs,
      env: Vars,
      n: Name,
      ty: Type,
      args: List[Expr],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local as: List[CStmt], bs: List[CStmt], ra: CExpr, rb: CExpr, rs: List[CExpr], t: Str

  match args
    // and, or are not strict
    case [a, b] if n == unqualified("and") or n == unqualified("or") =>
      call   compile_expr(in defs, env, a, out as, ra, ref g)
      call   compile_expr(in defs, env, b, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      if n == unqualified("and")
        assign ss := as ++ [CsDecl(value_type(), t, Some(ra)), CsIf(truth(CeVar(t)), bs ++ [CsAssign(CeVar(t), rb)], [])]
      else
        assign ss := as ++ [CsDecl(value_type(), t, Some(ra)), CsIf(CeUnary("!", truth(CeVar(t))), bs ++ [CsAssign(CeVar(t), rb)], [])]
      end
      assign r := CeVar(t)
    case _ =>
      call compile_exprs(in defs, env, args, out ss, rs, ref g)
      if is_global_fun(defs, n, size(args)) and arity(ty) == size(args)
        assign r := c_call(fun_name(n, size(args)), rs)
      else if fields_count(defs, n) == Some(0) and args == []
        assign r := unit_value(n)
      else if fields_count(defs, n) == Some(size(args))
        assign r := c_call("u_mk_con", [descriptor(n), CeNum(size(args))] ++ rs)
      else
        match get(n, builtin_functions())
          case Some((b, k)) if k == size(args) =>
            assign r := c_call(b, rs)
          case _ =>
            assign r := c_call("u_apply", [global_value(defs, n, ty), CeNum(size(args))] ++ rs)
        end
      end
  end

// a closure of a function lifted to the top level, which takes the captured values and the arguments
procedure compile_lambda(in defs: Defs, env: Vars, xs: List[Var], b: Expr, out ss: List[CStmt], r: CExpr, ref g: Gen) :=
  local  caps := [x for x in distinct(free_vars(b, names(xs))) if get(x, env) != None]
  local  f: Str, bs: List[CStmt], rb: CExpr, decls: List[CStmt]

  call   gen_name(in "lam", out f, ref g)
  call   compile_expr(in defs, in_scope(caps ++ names(xs)), b, out bs, rb, ref g)
  assign decls := unpack(numbered(caps, 0), "env") ++ unpack(numbered(names(xs), 0), "args")
  call   lift(in CdFunction(value_type(), f, [(value_ptr(), "env"), (value_ptr(), "args")], decls ++ bs ++ [CsReturn(Some(rb))]), ref g)
  assign ss := Nil, r := c_call("u_mk_closure", [CeVar(f), CeNum(size(caps))] ++ [var_expr(env, x) for x in caps])

// a lambda in x, out y, ref z => body end is a lifted function of the captured values, the ins, and pointers to the outs and refs
procedure compile_proc_lambda(
  in  defs: Defs,
      env: Vars,
      ins: List[Var],
      outs: List[Var],
      refs: List[Var],
      b: Stmt,
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local  caps := [x for x in distinct(free_in_stmt(b, names(ins ++ outs ++ refs))) if get(x, env) != None]
  local  f: Str, bs: List[CStmt], decls: List[CStmt]

  call   gen_name(in "proc", out f, ref g)
  call   compile_stmt(in defs, in_scope(caps ++ names(ins ++ outs ++ refs)), b, out bs, ref g)
  assign decls := unpack(numbered(caps, 0), "env") ++ unpack(numbered(names(ins), 0), "ins") ++ unpack_pointers(numbered(names(outs ++ refs), 0))
  assign decls := decls ++ copy_in(names(outs), names(refs))
  call   lift(in CdFunction(CtVoid, f, proc_params(), decls ++ bs ++ copy_out(names(outs ++ refs))), ref g)
  assign ss := Nil, r := c_call("u_mk_proc", [CeVar(f), CeNum(size(caps))] ++ [var_expr(env, x) for x in caps])

function proc_params(): List[CType * Str] :=
  [(value_ptr(), "env"), (value_ptr(), "ins"), (CtPtr(value_ptr()), "outs")]

function unpack_pointers(xs: List[Name * Int]): List[CStmt] :=
  match xs
    case [] => []
    case [(x, i); rest] => [CsDecl(value_ptr(), ref_name(x), Some(index("outs", i))); unpack_pointers(rest)]
  end

// declarations of the variables xs with the values in the array a
function unpack(xs: List[Name * Int], a: Str): List[CStmt] :=
  match xs
    case [] => []
    case [(x, i); rest] => [CsDecl(value_type(), var_name(x), Some(index(a, i))); unpack(rest, a)]
  end

// the cases of a match of the value v, which assign the result to t, where t stays NULL if no case applies
procedure expr_cases(
  in  defs: Defs,
      env: Vars,
      cases: List[Branch[Expr]],
      v: CExpr,
      t: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  local bs: List[CStmt], rb: CExpr, gs: List[CStmt], rg: CExpr, body: List[CStmt], rest: List[CStmt], env1: Vars

  match cases
    case [] =>
      assign ss := Nil
    case [Branch(pat, guard, e); more] =>
      assign env1 := in_scope(pattern_names(pat)) ++ env
      call   compile_expr(in defs, env1, e, out bs, rb, ref g)
      assign body := bs ++ [CsAssign(CeVar(t), rb)]
      match guard
        case Some(c) =>
          call   compile_expr(in defs, env1, c, out gs, rg, ref g)
          assign body := gs ++ [CsIf(truth(rg), body, [])]
        case None =>
          skip
      end
      call   expr_cases(in defs, env, more, v, t, out rest, ref g)
      assign ss := [CsIf(conjunction([CeUnary("!", CeVar(t))] ++ pattern_tests(pat, v)), pattern_binds(pat, v) ++ body, [])] ++ rest
  end

function list_foldr_name(): Name :=
  Name(Some("list"), "foldr")

function array_name(): Name :=
  Name(Some("array"), "array")

function array_foldr_name(): Name :=
  Name(Some("array"), "foldr")

// the elements of a list literal, Cons(a, Cons(b, Nil))
function list_literal(expr: Expr): Option[List[Expr]] :=
  match expr
    case EVar(Var(name, _)) if name == nil_name() => Some(Nil)
    case EApp(EVar(Var(name, _)), [e, rest]) if name == cons_name() =>
      match list_literal(rest)
        case Some(es) => Some([e; es])
        case None => None
      end
    case _ => None
  end

// the condition and the element of a function body that puts the element in front of the accumulator acc if the condition holds,
// and returns acc otherwise
function consing(body: Expr, acc: Name): Option[Option[Expr] * Expr] :=
  match body
    case EIte(cond, EApp(EVar(Var(k, _)), [e, EVar(Var(a, _))]), EVar(Var(b, _))) if k == cons_name() and a == acc and b == acc =>
      if contains(acc, free_vars(cond, Nil) ++ free_vars(e, Nil)) then None else Some((Some(cond), e))
    case EApp(EVar(Var(k, _)), [e, EVar(Var(a, _))]) if k == cons_name() and a == acc =>
      if contains(acc, free_vars(e, Nil)) then None else Some((None, e))
    case _ => None
  end

// the generators, the condition, and the element of a comprehension over lists and arrays, foldr(c1, init, lambda x1, acc =>
// foldr(c2, acc, lambda x2, acc => ... if q then Cons(e, acc) else acc)), into which comprehensions translate, where each
// generator is the fold of its container, the container, and the variable, and acc is free nowhere else
function fused(f: Name, c: Expr, x: Var, body: Expr, acc: Name): Option[List[Name * Expr * Var] * Option[Expr] * Expr] :=
  if f != list_foldr_name() and f != array_foldr_name() then
    None
  else
    match consing(body, acc)
      case Some((q, e)) => Some(([(f, c, x)], q, e))
      case None => fused_inner(f, c, x, body, acc)
    end

function fused_inner(f: Name, c: Expr, x: Var, body: Expr, acc: Name): Option[List[Name * Expr * Var] * Option[Expr] * Expr] :=
  match body
    case EApp(EVar(Var(f1, _)), [c1, EVar(Var(a, _)), ELam([x1, acc1], body)]) if a == acc and not contains(acc, free_vars(c1, Nil) ++ free_vars(ELam([x1, acc1], body), Nil)) =>
      match fused(f1, c1, x1, body, acc1.name)
        case Some((gs, q, e)) => Some(([(f, c, x); gs], q, e))
        case None => None
      end
    case _ => None
  end

// the loops of the generators gs, nested, in a scope with the local variables env, where the innermost adds the element e
// by add if the condition holds, and a list is walked by its cells and an array by its indices
procedure compile_loops(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * Expr * Var],
      cond: Option[Expr],
      e: Expr,
      add: CExpr -> List[CStmt],
  out ss: List[CStmt],
  ref g: Gen
) :=
  local cs: List[CStmt], rc: CExpr, es: List[CStmt], re: CExpr, body: List[CStmt], l: Str, n: Str, i: Str, item: CStmt

  match gs
    case Nil =>
      call   compile_expr(in defs, env, e, out es, re, ref g)
      assign ss := es ++ add(re)
      match cond
        case Some(q) =>
          call   compile_expr(in defs, env, q, out cs, rc, ref g)
          assign ss := cs ++ [CsIf(truth(rc), ss, [])]
        case None =>
          skip
      end

    case [(f, c, x); rest] =>
      call   compile_expr(in defs, env, c, out cs, rc, ref g)
      call   compile_loops(in defs, in_scope([x.name]) ++ env, rest, cond, e, add, out body, ref g)
      call   gen_name(in "l", out l, ref g)

      if f == list_foldr_name()
        assign item := CsDecl(value_type(), var_name(x.name), Some(field(CeVar(l), 0)))
        assign ss := cs ++ [CsDecl(value_type(), l, Some(rc)), CsWhile(c_call("u_is_con", [CeVar(l), descriptor(cons_name())]), [item] ++ body ++ [CsAssign(CeVar(l), field(CeVar(l), 1))])]
      else
        call   gen_name(in "n", out n, ref g)
        call   gen_name(in "i", out i, ref g)
        assign item := CsDecl(value_type(), var_name(x.name), Some(CeIndex(CeArrow(CeVar(l), "items"), CeVar(i))))
        assign ss := cs ++ [CsDecl(value_type(), l, Some(rc)), CsDecl(CtInt, n, Some(CeArrow(CeVar(l), "size"))), CsDecl(CtInt, i, Some(CeNum(0)))]
        assign ss := ss ++ [CsWhile(CeBinary("<", CeVar(i), CeVar(n)), [item] ++ body ++ [CsAssign(CeVar(i), CeBinary("+", CeVar(i), CeNum(1)))])]
      end
  end

// the list of a comprehension, built in order, where d points to the place of the next cell, first t and then the tail of the
// last cell, which is init at the end
procedure compile_list_comprehension(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * Expr * Var],
      cond: Option[Expr],
      e: Expr,
      init: Expr,
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local is: List[CStmt], ri: CExpr, loops: List[CStmt], t: Str, d: Str

  call   gen_name(in "t", out t, ref g)
  call   gen_name(in "e", out d, ref g)
  call   compile_loops(in defs, env, gs, cond, e, lambda re => [CsAssign(CeVar(d), c_call("u_append", [CeVar(d), re]))], out loops, ref g)
  call   compile_expr(in defs, env, init, out is, ri, ref g)
  assign ss := [CsDecl(value_type(), t, Some(unit_value(nil_name()))), CsDecl(value_ptr(), d, Some(CeUnary("&", CeVar(t))))] ++ loops
  assign ss := ss ++ is ++ [CsAssign(CeUnary("*", CeVar(d)), ri)], r := CeVar(t)

// the array t of a comprehension, with room for as many elements as the first container has, which is exact for one
// generator without a condition, into which the loops push the elements, where t grows if a later generator adds more, and
// is shrunk to its elements at the end unless it has exactly as many
procedure compile_array_comprehension(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * Expr * Var],
      cond: Option[Expr],
      e: Expr,
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local cs: List[CStmt], rc: CExpr, loops: List[CStmt], t: Str, n: Str, l: Str, source := unqualified("(source)")

  match gs
    case [(f, c, x); rest] =>
      call   compile_expr(in defs, env, c, out cs, rc, ref g)
      call   gen_name(in "t", out t, ref g)
      call   gen_name(in "n", out n, ref g)
      call   gen_name(in "l", out l, ref g)
      call   compile_loops(in defs, [(source, CeVar(l)); env], [(f, EVar(Var(source, THole)), x); rest], cond, e, lambda re => [CsAssign(CeVar(t), c_call("u_array_push", [CeVar(t), re]))], out loops, ref g)
      assign ss := cs ++ [CsDecl(value_type(), l, Some(rc)), CsDecl(CtInt, n, Some(c_call("u_count", [CeVar(l)]))), CsDecl(value_type(), t, Some(c_call("u_array_new", [CeVar(n)])))] ++ loops
      assign r := CeVar(t)

      if rest != Nil
        assign ss := ss ++ [CsAssign(CeVar(t), c_call("u_array_done", [CeVar(t), CeNum(-1)]))]
      else if cond != None
        assign ss := ss ++ [CsAssign(CeVar(t), c_call("u_array_done", [CeVar(t), CeVar(n)]))]
      end

    case Nil =>
      raise Unsupported("a comprehension without generators")
  end

// statements, whose variables are local variables of C, where procedures copy outs and refs back at their end
procedure compile_stmt(in defs: Defs, env: Vars, s: Stmt, out ss: List[CStmt], ref g: Gen) :=
  local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], ra: CExpr, rb: CExpr, rc: CExpr, rs: List[CExpr], t: Str, d: Str, xs: List[Name]

  match s
    case SSkip =>
      assign ss := Nil

    case SAssign(assignments) =>
      call   compile_exprs(in defs, env, seconds(assignments), out as, rs, ref g)
      call   temps(in rs, out cs, ref g)
      assign ss := as ++ cs ++ reassign(env, names(firsts(assignments)), cs)

    case SBlock(locals, stmts) =>
      call   compile_stmts(in defs, in_scope(names(locals)) ++ env, stmts, out bs, ref g)
      assign ss := [CsBlock([CsDecl(value_type(), var_name(x), Some(CeVar("NULL"))) for x in names(locals)] ++ bs)]

    case SIf(cond, then_stmt, else_stmt) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_stmt(in defs, env, then_stmt, out as, ref g)
      call   compile_stmt(in defs, env, else_stmt, out bs, ref g)
      assign ss := cs ++ [CsIf(truth(rc), as, bs)]
    // the condition is computed before the loop and again at the end of each iteration

    case SWhile(cond, body) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_stmt(in defs, env, body, out bs, ref g)
      call   gen_name(in "t", out t, ref g)
      call   compile_expr(in defs, env, cond, out as, ra, ref g)
      assign ss := cs ++ [CsDecl(value_type(), t, Some(rc)), CsWhile(truth(CeVar(t)), bs ++ as ++ [CsAssign(CeVar(t), ra)])]

    // a variable of a procedure type hides the procedures of that name
    case SCall(proc, ins, outs, refs) =>
      call compile_exprs(in defs, env, ins, out as, rs, ref g)

      if get(proc, env) != None
        assign ss := as ++ [CsExpr(c_call("u_call_proc", [var_expr(env, proc), CeNum(size(ins)), CeNum(size(outs ++ refs))] ++ rs ++ [address(var_expr(env, x)) for x in names(outs ++ refs)]))]
      else
        assign ss := as ++ [CsExpr(c_call(proc_name(proc), rs ++ [address(var_expr(env, x)) for x in names(outs ++ refs)]))]
      end

    case SMatch(expr, cases) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      call   gen_name(in "s", out d, ref g)
      call   gen_name(in "d", out t, ref g)
      call   stmt_cases(in defs, env, cases, CeVar(d), t, out bs, ref g)
      assign ss := as ++ [CsDecl(value_type(), d, Some(ra)), CsDecl(CtInt, t, Some(CeNum(0)))] ++ bs
      assign ss := ss ++ [CsIf(CeUnary("!", CeVar(t)), [CsExpr(c_call("u_no_case", [CeVar(d)]))], [])]
    // assertions of equations show both sides when they fail

    case SAssert(EApp(EVar(Var(Name(None, "=="), _)), [a, b])) =>
      call   compile_expr(in defs, env, a, out as, ra, ref g)
      call   compile_expr(in defs, env, b, out bs, rb, ref g)
      assign ss := as ++ bs ++ [CsExpr(c_call("u_assert_equal", [ra, rb]))]

    case SAssert(cond) =>
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      assign ss := cs ++ [CsExpr(c_call("u_assert_true", [rc]))]
    // exceptions carry their type, which handlers compare

    case SRaise(expr, typ) =>
      call   compile_expr(in defs, env, expr, out as, ra, ref g)
      assign ss := as ++ [CsExpr(c_call("u_raise", [ra, CeStr(type_key(typ))]))]
    // the body runs after setjmp returns 0, and the handlers after a raise jumps back, which raise again if none applies,
    // where the handlers start from the variables before the try, which their copies, unchanged since setjmp, restore

    case STry(body, handlers) =>
      call   compile_stmt(in defs, env, body, out bs, ref g)
      call   gen_name(in "h", out d, ref g)
      call   gen_name(in "d", out t, ref g)
      call   handler_cases(in defs, env, handlers, d, t, out cs, ref g)
      assign xs := [x for x in distinct(changed(body)) if get(x, env) != None]
      assign as := [CsExpr(c_call("u_pop", [CeVar(d)]))] ++ [CsAssign(var_expr(env, x), CeVar(saved_name(x))) for x in xs] ++ [CsDecl(CtInt, t, Some(CeNum(0)))]
      assign as := as ++ cs ++ [CsIf(CeUnary("!", CeVar(t)), [CsExpr(c_call("u_reraise", [CeVar(d)]))], [])]
      assign ss := [CsDecl(value_type(), saved_name(x), Some(var_expr(env, x))) for x in xs] ++ [CsDecl(CtPtr(CtNamed("struct u_handler")), d, Some(c_call("u_push", [])))]
      assign ss := [CsBlock(ss ++ [CsIf(CeBinary("==", c_call("setjmp", [CeArrow(CeVar(d), "env")]), CeNum(0)), bs ++ [CsExpr(c_call("u_pop", [CeVar(d)]))], as)])]
  end

function saved_name(x: Name): Str :=
  "was_" ++ var_name(x)

// the variables that s assigns, directly or as outs and refs
function changed(s: Stmt): List[Name] :=
  match s
    case SAssign(assignments) => names(firsts(assignments))
    case SBlock(_, stmts) => [n for y in stmts, n in changed(y)]
    case SIf(_, then_stmt, else_stmt) => changed(then_stmt) ++ changed(else_stmt)
    case SWhile(_, body) => changed(body)
    case SCall(_, _, outs, refs) => names(outs ++ refs)
    case SMatch(_, cases) => [n for b in cases, n in changed(b.body)]
    case STry(b, handlers) => changed(b) ++ [n for h in handlers, n in changed(h.body)]
    case _ => []
  end

procedure compile_stmts(in defs: Defs, env: Vars, xs: List[Stmt], out ss: List[CStmt], ref g: Gen) :=
  local as: List[CStmt], bs: List[CStmt]

  match xs
    case [] =>
      assign ss := Nil
    case [x; rest] =>
      call   compile_stmt(in defs, env, x, out as, ref g)
      call   compile_stmts(in defs, env, rest, out bs, ref g)
      assign ss := as ++ bs
  end

function reassign(env: Vars, xs: List[Name], ts: List[CStmt]): List[CStmt] :=
  match (xs, ts)
    case ([x; more], [CsDecl(_, name, _); rest]) => [CsAssign(var_expr(env, x), CeVar(name)); reassign(env, more, rest)]
    case _ => []
  end

// the handlers of an exception caught by h, which set the flag d when one applies, where _ handles all types
procedure handler_cases(in defs: Defs, env: Vars, hs: List[Handler], h: Str, d: Str, out ss: List[CStmt], ref g: Gen) :=
  local  v := c_call("u_caught", [CeVar(h)])
  local  bs: List[CStmt], gs: List[CStmt], rg: CExpr, body: List[CStmt], rest: List[CStmt], env1: Vars, tests: List[CExpr]

  match hs
    case [] =>
      assign ss := Nil
    case [Handler(typ, pat, guard, s); more] =>
      assign env1 := in_scope(pattern_names(pat)) ++ env
      call   compile_stmt(in defs, env1, s, out bs, ref g)
      assign body := [CsAssign(CeVar(d), CeNum(1))] ++ bs
      match guard
        case Some(c) =>
          call   compile_expr(in defs, env1, c, out gs, rg, ref g)
          assign body := gs ++ [CsIf(truth(rg), body, [])]
        case None =>
          skip
      end
      match pat
        case PWild =>
          assign tests := Nil
        case _ =>
          assign tests := [c_call("u_has_type", [CeVar(h), CeStr(type_key(typ))])] ++ pattern_tests(pat, v)
      end
      call   handler_cases(in defs, env, more, h, d, out rest, ref g)
      assign ss := [CsIf(conjunction([CeUnary("!", CeVar(d))] ++ tests), pattern_binds(pat, v) ++ body, [])] ++ rest
  end

// the cases of a match statement, which set the flag d when one applies
procedure stmt_cases(
  in  defs: Defs,
      env: Vars,
      cases: List[Branch[Stmt]],
      v: CExpr,
      d: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  local bs: List[CStmt], gs: List[CStmt], rg: CExpr, body: List[CStmt], rest: List[CStmt], env1: Vars

  match cases
    case [] =>
      assign ss := Nil
    case [Branch(pat, guard, s); more] =>
      assign env1 := in_scope(pattern_names(pat)) ++ env
      call   compile_stmt(in defs, env1, s, out bs, ref g)
      assign body := [CsAssign(CeVar(d), CeNum(1))] ++ bs
      match guard
        case Some(c) =>
          call   compile_expr(in defs, env1, c, out gs, rg, ref g)
          assign body := gs ++ [CsIf(truth(rg), body, [])]
        case None =>
          skip
      end
      call   stmt_cases(in defs, env, more, v, d, out rest, ref g)
      assign ss := [CsIf(conjunction([CeUnary("!", CeVar(d))] ++ pattern_tests(pat, v)), pattern_binds(pat, v) ++ body, [])] ++ rest
  end

// the C functions of a command, and the statements of main for runs and tests
procedure compile_cmd(in defs: Defs, entry: Id, cmd: Cmd, out ds: List[CDecl], ms: List[CStmt], ref g: Gen) :=
  local bs: List[CStmt], rb: CExpr, params: List[CType * Str]

  match cmd
    case CFun(name, _, formals, _, body) =>
      call   compile_expr(in defs, in_scope(names(first_list(formals))), lambdas(drop(1, formals), body), out bs, rb, ref g)
      assign params := [(value_type(), var_name(x)) for x in names(first_list(formals))]

      if first_list(formals) == Nil
        assign bs := cached(format_name(name), bs, rb)
      else
        assign bs := bs ++ [CsReturn(Some(rb))]
      end
      assign ds := [CdFunction(value_type(), fun_name(name, size(first_list(formals))), params, bs)], ms := Nil
    // outs and refs are pointers to the variables of the caller, which the procedure assigns when it returns

    case CProc(name, _, ins, outs, refs, stmt) =>
      call   compile_stmt(in defs, in_scope(names(ins ++ outs ++ refs)), stmt, out bs, ref g)
      assign params := [(value_type(), var_name(x)) for x in names(ins)] ++ [(value_ptr(), ref_name(x)) for x in names(outs ++ refs)]
      assign bs := copy_in(names(outs), names(refs)) ++ bs ++ copy_out(names(outs ++ refs))
      assign ds := [CdFunction(CtVoid, proc_name(name), params, bs)], ms := Nil

    // main runs all tests for the entry test, which report that they passed

    case CTest(test_name, _, stmt) if entry == "test" =>
      call   compile_stmt(in defs, Nil, stmt, out bs, ref g)
      assign ds := Nil, ms := [CsBlock(bs ++ [CsExpr(c_call("u_passed", [CeStr(test_name)]))])]

    case _ =>
      assign ds := Nil, ms := Nil
  end

procedure compile_cmds(in defs: Defs, entry: Id, cmds: List[Cmd], out ds: List[CDecl], ms: List[CStmt], ref g: Gen) :=
  local d1: List[CDecl], m1: List[CStmt], d2: List[CDecl], m2: List[CStmt]

  match cmds
    case [] =>
      assign ds := Nil, ms := Nil
    case [c; rest] =>
      call   compile_cmd(in defs, entry, c, out d1, m1, ref g)
      call   compile_cmds(in defs, entry, rest, out d2, m2, ref g)
      assign ds := d1 ++ d2, ms := m1 ++ m2
  end

// the body of a function without arguments, whose value is computed once, since expressions are deterministic,
// where the cache is U_COMPUTING while the value is computed, which detects a value that needs itself,
// and an exception that leaves the computation resets the cache, such that the next call computes it again
function cached(n: Str, bs: List[CStmt], r: CExpr): List[CStmt] :=
  let h := CeVar("handler") in
    [
      CsDecl(CtNamed("static u_value"), "cache", Some(CeVar("NULL"))),
      CsIf(CeBinary("==", CeVar("cache"), CeVar("U_COMPUTING")), [CsExpr(c_call("u_fail", [CeStr("recursive initialization of " ++ n)]))], []),
      CsIf(CeVar("cache"), [CsReturn(Some(CeVar("cache")))], []),
      CsAssign(CeVar("cache"), CeVar("U_COMPUTING")),
      CsDecl(CtPtr(CtNamed("struct u_handler")), "handler", Some(c_call("u_push", []))),
      CsIf(
        CeBinary("!=", c_call("setjmp", [CeArrow(h, "env")]), CeNum(0)),
        [CsExpr(c_call("u_pop", [h])), CsAssign(CeVar("cache"), CeVar("NULL")), CsExpr(c_call("u_reraise", [h]))],
        []
      )
    ] ++ bs ++ [CsExpr(c_call("u_pop", [h])), CsAssign(CeVar("cache"), r), CsReturn(Some(CeVar("cache")))]

// closures of functions, constructors, and builtins, which take their arguments from an array
function wrappers(defs: Defs): List[CDecl] :=
  [fun_wrapper(p) for p in firsts(list(defs.funs))] ++ [w for p in constr_arities(defs), w in constr_wrapper(p)] ++
  [builtin_wrapper(p) for p in distinct(seconds(list(builtin_functions())))] ++ [proc_wrapper(p) for p in proc_arities(defs)]

// procedures as values call the procedure with the values of the array ins and the pointers of the array outs
function proc_wrapper(p: Name * (Int * Int)): CDecl :=
  match p
    case (n, (k, m)) =>
      CdFunction(CtVoid, "wp_" ++ mangle(n), proc_params(), [CsExpr(c_call(proc_name(n), [index("ins", i) for i in range_to(k)] ++ [index("outs", i) for i in range_to(m)]))])
  end

function fun_wrapper(p: Name * Int): CDecl :=
  match p
    case (n, k) => wrapper("w_" ++ fun_name(n, k), fun_name(n, k), k)
  end

function builtin_wrapper(p: Str * Int): CDecl :=
  match p
    case (f, k) => wrapper("w" ++ f, f, k)
  end

function wrapper(w: Str, f: Str, k: Int): CDecl :=
  CdFunction(value_type(), w, [(value_ptr(), "env"), (value_ptr(), "args")], [CsReturn(Some(c_call(f, [index("args", i) for i in range_to(k)])))])

// constructors without fields are no functions
function constr_wrapper(p: Name * Int): List[CDecl] :=
  match p
    case (_, 0) => []
    case (n, k) =>
      [CdFunction(value_type(), "wc_" ++ mangle(n), [(value_ptr(), "env"), (value_ptr(), "args")], [CsReturn(Some(c_call("u_mk_con_array", [descriptor(n), CeNum(k), CeVar("args")])))])]
  end

function range_to(k: Int): List[Int] :=
  if k == 0 then [] else range_to(k - 1) ++ [k - 1]

function prototype(d: CDecl): List[CDecl] :=
  match d
    case CdFunction(typ, fun, formals, _) => [CdPrototype(typ, fun, formals)]
    case _ => []
  end

// the C of q of module m, whose main calls the procedure entry without parameters, or runs all tests for the entry test
procedure compile_program(in q: Prog, m: Id, entry: Id, out f: CFile) :=
  local g := Gen(0, Nil), defs := defs_of(q), ds: List[CDecl], ms: List[CStmt], fs: List[CDecl]

  if entry != "test" and not exists(q.cmds, lambda c => is_entry(c, Name(Some(m), entry)))
    raise UnknownEntry(Name(Some(m), entry))
  end

  call   compile_cmds(in defs, entry, q.cmds, out ds, ms, ref g)

  if entry != "test"
    assign ms := [CsExpr(c_call(proc_name(Name(Some(m), entry)), []))]
  end

  assign fs := wrappers(defs) ++ ds ++ g.lifted
  assign f := CFile([CdInclude("ulang.h")] ++ [p for d in fs, p in prototype(d)] ++ descriptor_decls(defs, q.cmds) ++ fs ++ [CdFunction(CtInt, "main", [(CtInt, "argc"), (CtPtr(CtPtr(CtNamed("char"))), "argv")], [CsExpr(c_call("u_args", [CeVar("argc"), CeVar("argv")]))] ++ ms ++ [CsReturn(Some(CeNum(0)))])])

// checks the program of the file source, which is its module, and writes its translation to C to target
procedure compile_file(in source: Str, entry: Id, target: Str) :=
  local parsed: Source, q: Prog, f: CFile

  call   parse_file(in source, out parsed)
  call   check_program(in parsed, out q)
  call   compile_program(in q, parsed.main, entry, out f)
  call   os_write(in target, format_file(f))

// a procedure without parameters
function is_entry(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, [], [], [], _) => name == n
    case _ => false
  end
