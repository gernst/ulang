// the lexer of ulang, which splits source code into tokens with their offsets, as the regular expressions of
// ulang/src/ulang/Parser.scala read them, except that a symbol is always the longest run of symbol characters

import os

// names include keywords and operators that are names, which only the parser tells apart
data Token :=
  | TName(Str)
  | TSym(Str)
  | TPunct(Char)
  | TNum(Int)
  | TStr(Str)
  | TChar(Char)
  | TEnd

data LexError :=
  | LexError(Str, Int)

function is_symbol(c: Char): Bool :=
  str_contains("-+*/%<>=!&|:^~?@#$", c)

function is_punct(c: Char): Bool :=
  str_contains("()[],;", c)

function is_name_char(c: Char): Bool :=
  is_letter(c) or is_digit(c) or c == '_'

// the character at i, or the character 0 after the end of s
function peek(s: Str, i: Int): Char :=
  if i < str_size(s) then str_get(s, i) else chr(0)

function unescape(c: Char): Option[Char] :=
  match c
    case '"' => Some('"')
    case '\'' => Some('\'')
    case '\\' => Some('\\')
    case 'n' => Some('\n')
    case 't' => Some('\t')
    case 'r' => Some('\r')
    else None
  end

// the end of the run of characters from i that satisfy p
function scan(s: Str, i: Int, p: Char -> Bool): Int :=
  if p(peek(s, i)) then scan(s, i + 1, p) else i

// the line and column of the offset i in s, counted from 1
procedure position(in s: Str, i: Int, out line: Int, column: Int) :=
  local  j: Int
  assign j := 0, line := 1, column := 1

  while j < i
    if str_get(s, j) == '\n'
      assign line := line + 1, column := 1
    else
      assign column := column + 1
    end

    assign j := j + 1
  end

// the contents of the literal delimited by q at i, with its escapes resolved, where i ends after the closing quote
procedure lex_literal(in s: Str, q: Char, out text: Str, ref i: Int) :=
  local  start: Int, from: Int, parts: List[Str], c: Char
  assign start := i, i := i + 1, parts := Nil
  assign from := i

  while peek(s, i) != q
    assign c := peek(s, i)

    if c == '\n' or i >= str_size(s)
      raise LexError("unterminated literal", start)
    end

    if c == '\\'
      match unescape(peek(s, i + 1))
        case Some(d) =>
          assign parts := [string([d]), str_slice(s, from, i); parts], i := i + 2
          assign from := i
        case None =>
          raise LexError("invalid escape", i)
      end
    else
      assign i := i + 1
    end
  end

  assign text := str_join("", reverse([str_slice(s, from, i); parts])), i := i + 1

procedure lex_name(in s: Str, out t: Token, ref i: Int) :=
  local  j: Int
  assign j := scan(s, i, is_name_char)
  assign t := TName(str_slice(s, i, j)), i := j

procedure lex_number(in s: Str, out t: Token, ref i: Int) :=
  local  j: Int
  assign j := scan(s, i, is_digit)

  match str_number(str_slice(s, i, j))
    case Some(n) =>
      assign t := TNum(n), i := j
    case None =>
      raise LexError("invalid number", i)
  end

procedure lex_symbol(in s: Str, out t: Token, ref i: Int) :=
  local  j: Int
  assign j := scan(s, i, is_symbol)
  assign t := TSym(str_slice(s, i, j)), i := j

procedure lex_string(in s: Str, out t: Token, ref i: Int) :=
  local  text: Str
  call   lex_literal(in s, '"', out text, ref i)
  assign t := TStr(text)

procedure lex_char(in s: Str, out t: Token, ref i: Int) :=
  local  start: Int, text: Str
  assign start := i
  call   lex_literal(in s, '\'', out text, ref i)

  if str_size(text) != 1
    raise LexError("invalid character", start)
  end

  assign t := TChar(str_get(text, 0))

// the token at i, where i ends after it
procedure lex_token(in s: Str, out t: Token, ref i: Int) :=
  local  c: Char
  assign c := str_get(s, i)

  match c
    case _ if is_letter(c) or c == '_' =>
      call lex_name(in s, out t, ref i)
    case _ if is_digit(c) =>
      call lex_number(in s, out t, ref i)
    case _ if is_symbol(c) =>
      call lex_symbol(in s, out t, ref i)
    case '"' =>
      call lex_string(in s, out t, ref i)
    case '\'' =>
      call lex_char(in s, out t, ref i)
    case _ if is_punct(c) =>
      assign t := TPunct(c), i := i + 1
    else
      raise LexError("unexpected character", i)
  end

// the tokens of s with their offsets, which end with TEnd at the end of s
procedure lex(in s: Str, out ts: List[Token * Int]) :=
  local  i: Int, start: Int, t: Token, rev: List[Token * Int]
  assign i := 0, rev := Nil

  while i < str_size(s)
    assign start := i

    if is_space(str_get(s, i))
      assign i := i + 1
    else if str_get(s, i) == '/' and peek(s, i + 1) == '/'
      assign i := scan(s, i, lambda c => c != '\n')
    else
      call   lex_token(in s, out t, ref i)
      assign rev := [(t, start); rev]
    end
  end

  assign ts := reverse([(TEnd, i); rev])

function tokens(ts: List[Token * Int]): List[Token] :=
  firsts(ts)

test lex_tokens :=
  local  ts: List[Token * Int]
  call   lex(in "function f(x: Int): Int := x+-1 // one\n", out ts)
  assert ts ==
    [
      (TName("function"), 0),
      (TName("f"), 9),
      (TPunct('('), 10),
      (TName("x"), 11),
      (TSym(":"), 12),
      (TName("Int"), 14),
      (TPunct(')'), 17),
      (TSym(":"), 18),
      (TName("Int"), 20),
      (TSym(":="), 24),
      (TName("x"), 27),
      (TSym("+-"), 28),
      (TNum(1), 30),
      (TEnd, 39)
    ]

test lex_literals :=
  local  ts: List[Token * Int]
  call   lex(in "\"a\\\"b\\n\" \"\" 'c' '\\'' [x; xs]", out ts)
  assert tokens(ts) == [TStr("a\"b\n"), TStr(""), TChar('c'), TChar('\''), TPunct('['), TName("x"), TPunct(';'), TName("xs"), TPunct(']'), TEnd]

test lex_errors :=
  local ts: List[Token * Int], e: LexError
  try
    call lex(in "x := \"ab", out ts)
  catch
    case LexError(m, i) =>
      assign e := LexError(m, i)
  end
  assert e == LexError("unterminated literal", 5)
  try
    call lex(in "'\\q'", out ts)
  catch
    case LexError(m, i) =>
      assign e := LexError(m, i)
  end
  assert e == LexError("invalid escape", 1)
  try
    call lex(in "'ab'", out ts)
  catch
    case LexError(m, i) =>
      assign e := LexError(m, i)
  end
  assert e == LexError("invalid character", 0)

test lex_position :=
  local  line: Int, column: Int
  call   position(in "ab\ncd", 4, out line, column)
  assert (line, column) == (2, 2)

// all files of self lex without errors
test lex_files :=
  local  text: Str, ts: List[Token * Int]
  call   os_read(in "lex.u", out text)
  call   lex(in text, out ts)
  assert length(ts) > 1000
  call   os_read(in "check.u", out text)
  call   lex(in text, out ts)
  call   os_read(in "compile.u", out text)
  call   lex(in text, out ts)
