// the lexer of ulang, which splits source code into tokens with their offsets, where a symbol is always the longest run
// of symbol characters

import os

export

// names include keywords and operators that are names, which only the parser tells apart
data Token :=
  | TName(Str)
  | TSym(Str)
  | TPunct(Char)
  | TNum(Int)
  | TStr(Str)
  | TChar(Char)
  | TEnd

// tokens with their offsets
type Tokens :=
  List[Token * Int]

data LexError :=
  | LexError(Str, Int)

procedure position(in text: Str, offset: Int, out line: Int, column: Int)
procedure lex(in text: Str, out toks: Tokens)

implementation

function is_symbol(c: Char): Bool :=
  str_contains("-+*/%<>=!&|:^~?@#$", c)

function is_punct(c: Char): Bool :=
  str_contains("()[]{},;.", c)

function is_name_char(c: Char): Bool :=
  is_letter(c) or is_digit(c) or c == '_'

// the character at offset, or the character 0 after the end of text
function peek(text: Str, offset: Int): Char :=
  if offset < str_size(text) then str_get(text, offset) else chr(0)

function unescape(c: Char): Option[Char] :=
  match c
    case '"' => Some('"')
    case '\'' => Some('\'')
    case '\\' => Some('\\')
    case 'n' => Some('\n')
    case 't' => Some('\t')
    case 'r' => Some('\r')
    case _ => None
  end

// the run of characters from offset that satisfy p, where start is the offset before it, and offset ends after it
procedure scan(in text: Str, p: Char -> Bool, out start: Int, ref offset: Int) :=
  assign start := offset

  while p(peek(text, offset))
    assign offset := offset + 1
  end

// the line and column of offset in text, counted from 1
procedure position(in text: Str, offset: Int, out line: Int, column: Int) :=
  local j: Int

  assign j := 0, line := 1, column := 1

  while j < offset
    if str_get(text, j) == '\n'
      assign line := line + 1, column := 1
    else
      assign column := column + 1
    end

    assign j := j + 1
  end

// the contents of the literal delimited by q at offset, with its escapes resolved, where offset ends after the closing quote
procedure lex_literal(in text: Str, q: Char, out contents: Str, ref offset: Int) :=
  local start := offset, from := offset + 1, parts: List[Str] := Nil, c: Char

  assign offset := offset + 1

  while peek(text, offset) != q
    assign c := peek(text, offset)

    if c == '\n' or offset >= str_size(text)
      raise LexError("unterminated literal", start)
    end

    if c == '\\'
      match unescape(peek(text, offset + 1))
        case Some(d) =>
          assign parts := [string([d]), str_slice(text, from, offset); parts], offset := offset + 2
          assign from := offset
        case None =>
          raise LexError("invalid escape", offset)
      end
    else
      assign offset := offset + 1
    end
  end

  assign contents := str_join("", reverse([str_slice(text, from, offset); parts])), offset := offset + 1

procedure lex_name(in text: Str, out tok: Token, ref offset: Int) :=
  local from: Int

  call   scan(in text, is_name_char, out from, ref offset)
  assign tok := TName(str_slice(text, from, offset))

procedure lex_number(in text: Str, out tok: Token, ref offset: Int) :=
  local from: Int

  call scan(in text, is_digit, out from, ref offset)

  match str_number(str_slice(text, from, offset))
    case Some(n) =>
      assign tok := TNum(n)
    case None =>
      raise LexError("invalid number", from)
  end

procedure lex_symbol(in text: Str, out tok: Token, ref offset: Int) :=
  local from: Int

  call   scan(in text, is_symbol, out from, ref offset)
  assign tok := TSym(str_slice(text, from, offset))

procedure lex_string(in text: Str, out tok: Token, ref offset: Int) :=
  local contents: Str

  call   lex_literal(in text, '"', out contents, ref offset)
  assign tok := TStr(contents)

procedure lex_char(in text: Str, out tok: Token, ref offset: Int) :=
  local start := offset, contents: Str

  call lex_literal(in text, '\'', out contents, ref offset)

  if str_size(contents) != 1
    raise LexError("invalid character", start)
  end

  assign tok := TChar(str_get(contents, 0))

// the token at offset, where offset ends after it
procedure lex_token(in text: Str, out tok: Token, ref offset: Int) :=
  local c := str_get(text, offset)

  match c
    case _ if is_letter(c) or c == '_' =>
      call lex_name(in text, out tok, ref offset)
    case _ if is_digit(c) =>
      call lex_number(in text, out tok, ref offset)
    case _ if is_symbol(c) =>
      call lex_symbol(in text, out tok, ref offset)
    case '"' =>
      call lex_string(in text, out tok, ref offset)
    case '\'' =>
      call lex_char(in text, out tok, ref offset)
    case _ if is_punct(c) =>
      assign tok := TPunct(c), offset := offset + 1
    case _ =>
      raise LexError("unexpected character", offset)
  end

// the tokens of text with their offsets, which end with TEnd at the end of text
procedure lex(in text: Str, out toks: Tokens) :=
  local offset := 0, rev: Tokens := Nil, start: Int, tok: Token

  while offset < str_size(text)
    assign start := offset

    if is_space(str_get(text, offset))
      assign offset := offset + 1
    else if str_get(text, offset) == '/' and peek(text, offset + 1) == '/'
      call scan(in text, lambda c => c != '\n', out start, ref offset)
    else
      call   lex_token(in text, out tok, ref offset)
      assign rev := [(tok, start); rev]
    end
  end

  assign toks := reverse([(TEnd, offset); rev])

function tokens(toks: Tokens): List[Token] :=
  firsts(toks)

test lex_tokens() :=
  local toks: Tokens

  call   lex(in "function f(x: Int): Int := x+-1 // one\n", out toks)
  assert toks ==
    [
      (TName("function"), 0),
      (TName("f"), 9),
      (TPunct('('), 10),
      (TName("x"), 11),
      (TSym(":"), 12),
      (TName("Int"), 14),
      (TPunct(')'), 17),
      (TSym(":"), 18),
      (TName("Int"), 20),
      (TSym(":="), 24),
      (TName("x"), 27),
      (TSym("+-"), 28),
      (TNum(1), 30),
      (TEnd, 39)
    ]

test lex_literals() :=
  local toks: Tokens

  call   lex(in "\"a\\\"b\\n\" \"\" 'c' '\\'' [x; xs]", out toks)
  assert tokens(toks) == [TStr("a\"b\n"), TStr(""), TChar('c'), TChar('\''), TPunct('['), TName("x"), TPunct(';'), TName("xs"), TPunct(']'), TEnd]

test lex_errors() :=
  local toks: Tokens, e := LexError("none", -1)

  try
    call lex(in "x := \"ab", out toks)
  catch
    case LexError(m, offset) =>
      assign e := LexError(m, offset)
  end
  assert e == LexError("unterminated literal", 5)
  try
    call lex(in "'\\q'", out toks)
  catch
    case LexError(m, offset) =>
      assign e := LexError(m, offset)
  end
  assert e == LexError("invalid escape", 1)
  try
    call lex(in "'ab'", out toks)
  catch
    case LexError(m, offset) =>
      assign e := LexError(m, offset)
  end
  assert e == LexError("invalid character", 0)

test lex_position() :=
  local line: Int, column: Int

  call   position(in "ab\ncd", 4, out line, column)
  assert (line, column) == (2, 2)
