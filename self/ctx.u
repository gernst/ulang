// the context of the checker, with maps from the names of declarations

import syntax
import map
import set

export

// type definitions with their parameters, the type schemes of functions with their parameters, the signatures of procedures
// with parameters, ins, outs, and refs, datatypes with their numbers of parameters, their constructors,
// constructors with the parameters of their datatype, their argument types, and their datatype,
// the declarations of each base name, of any kind and module, and the declarations that are private to their modules,
// which include the constructors and fields of abstract types
data Ctx :=
  | Ctx(
    aliases: Map[Name, List[Id] * Type],
    funs: Map[Name, List[List[Type] * Type]],
    procs: Map[Name, List[Type] * List[Type] * List[Type] * List[Type]],
    datas: Map[Name, Int],
    members: Map[Name, List[Name]],
    constrs: Map[Name, List[Type] * List[Type] * Type],
    named: Map[Id, List[Name]],
    hidden: Set[Name]
  )

function empty_ctx(): Ctx
function ctx_of(c: Ctx, ms: List[Id]): Ctx
function ctx_union(a: Ctx, b: Ctx): Ctx
function public_ctx(c: Ctx): Ctx
function hidden_named(c: Ctx, b: Id): List[Name]
function alias_of(c: Ctx, n: Name): Option[List[Id] * Type]
function schemes_of(c: Ctx, n: Name): List[List[Type] * Type]
function proc_of(c: Ctx, n: Name): Option[List[Type] * List[Type] * List[Type] * List[Type]]
function data_of(c: Ctx, n: Name): Option[Int]
function members_of(c: Ctx, n: Name): Option[List[Name]]
function constr_of(c: Ctx, n: Name): Option[List[Type] * List[Type] * Type]
function is_fun(c: Ctx, n: Name): Bool
function is_proc(c: Ctx, n: Name): Bool
function is_data(c: Ctx, n: Name): Bool
function is_alias(c: Ctx, n: Name): Bool
function is_constr(c: Ctx, n: Name): Bool
function is_sort(c: Ctx, n: Name): Bool
function names_of(c: Ctx, b: Id): List[Name]
function with_alias(c: Ctx, n: Name, ps: List[Id], t: Type): Ctx
function with_fun(c: Ctx, n: Name, sc: List[Type] * Type): Ctx
function with_proc(c: Ctx, n: Name, g: List[Type] * List[Type] * List[Type] * List[Type]): Ctx
function with_data(c: Ctx, n: Name, arity: Int): Ctx
function with_members(c: Ctx, n: Name, cs: List[Name]): Ctx
function with_constr(c: Ctx, n: Name, kc: List[Type] * List[Type] * Type): Ctx

implementation

function empty_ctx(): Ctx :=
  Ctx(empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty())

// the declarations of the modules ms
function ctx_of(c: Ctx, ms: List[Id]): Ctx :=
  Ctx(
    owned_map(c.aliases, ms),
    owned_map(c.funs, ms),
    owned_map(c.procs, ms),
    owned_map(c.datas, ms),
    owned_map(c.members, ms),
    owned_map(c.constrs, ms),
    put_all(owned_named(entries(c.named), ms), empty()),
    from_list([n for n in elements(c.hidden) if in_modules(n, ms)])
  )

function owned_map[V](m: Map[Name, V], ms: List[Id]): Map[Name, V] :=
  put_all(owned(entries(m), ms), empty())

function owned[V](es: List[Name * V], ms: List[Id]): List[Name * V] :=
  match es
    case Nil => Nil
    case [(n, v); rest] => if in_modules(n, ms) then [(n, v); owned(rest, ms)] else owned(rest, ms)
  end

function owned_named(es: List[Id * List[Name]], ms: List[Id]): List[Id * List[Name]] :=
  match es
    case Nil => Nil
    case [(b, ns); rest] =>
      let ks := [n for n in ns if in_modules(n, ms)] in if ks == Nil then owned_named(rest, ms) else [(b, ks); owned_named(rest, ms)]
  end

function in_modules(n: Name, ms: List[Id]): Bool :=
  match n.module
    case Some(m) => contains(m, ms)
    case None => false
  end

// the declarations of both, whose names differ since they are qualified by their modules
function ctx_union(a: Ctx, b: Ctx): Ctx :=
  Ctx(
    put_all(entries(b.aliases), a.aliases),
    put_all(entries(b.funs), a.funs),
    put_all(entries(b.procs), a.procs),
    put_all(entries(b.datas), a.datas),
    put_all(entries(b.members), a.members),
    put_all(entries(b.constrs), a.constrs),
    union_named(entries(b.named), a.named),
    insert_all(elements(b.hidden), a.hidden)
  )

// the declarations as other modules see them, without the hidden ones, where datatypes whose constructors are hidden
// are abstract, without members
function public_ctx(c: Ctx): Ctx :=
  if size(c.hidden) == 0 then
    c
  else
    Ctx(
      unhidden(c.aliases, c.hidden),
      unhidden(c.funs, c.hidden),
      unhidden(c.procs, c.hidden),
      unhidden(c.datas, c.hidden),
      put_all([e for e in entries(unhidden(c.members, c.hidden)) if not exists(value_of(e), lambda k => contains(k, c.hidden))], empty()),
      unhidden(c.constrs, c.hidden),
      put_all([(key_of(e), [n for n in value_of(e) if not contains(n, c.hidden)]) for e in entries(c.named)], empty()),
      c.hidden
    )

function unhidden[V](m: Map[Name, V], hidden: Set[Name]): Map[Name, V] :=
  put_all([e for e in entries(m) if not contains(key_of(e), hidden)], empty())

function key_of[K, V](e: K * V): K :=
  match e
    case (k, _) => k
  end

function value_of[K, V](e: K * V): V :=
  match e
    case (_, v) => v
  end

// hidden declarations named like n, which other modules do not see
function hidden_named(c: Ctx, b: Id): List[Name] :=
  [n for n in elements(c.hidden) if n.base == b]

function union_named(es: List[Id * List[Name]], bs: Map[Id, List[Name]]): Map[Id, List[Name]] :=
  match es
    case Nil => bs
    case [(k, ns); rest] =>
      match get(k, bs)
        case Some(ms) => union_named(rest, put(k, ms ++ ns, bs))
        case None => union_named(rest, put(k, ns, bs))
      end
  end

function alias_of(c: Ctx, n: Name): Option[List[Id] * Type] :=
  get(n, c.aliases)

function schemes_of(c: Ctx, n: Name): List[List[Type] * Type] :=
  match get(n, c.funs)
    case Some(ss) => ss
    case None => Nil
  end

function proc_of(c: Ctx, n: Name): Option[List[Type] * List[Type] * List[Type] * List[Type]] :=
  get(n, c.procs)

function data_of(c: Ctx, n: Name): Option[Int] :=
  get(n, c.datas)

function members_of(c: Ctx, n: Name): Option[List[Name]] :=
  get(n, c.members)

function constr_of(c: Ctx, n: Name): Option[List[Type] * List[Type] * Type] :=
  get(n, c.constrs)

function is_fun(c: Ctx, n: Name): Bool :=
  contains(n, c.funs)

function is_proc(c: Ctx, n: Name): Bool :=
  contains(n, c.procs)

function is_data(c: Ctx, n: Name): Bool :=
  contains(n, c.datas)

function is_alias(c: Ctx, n: Name): Bool :=
  contains(n, c.aliases)

function is_constr(c: Ctx, n: Name): Bool :=
  contains(n, c.constrs)

function is_sort(c: Ctx, n: Name): Bool :=
  is_data(c, n) or is_alias(c, n)

// the declarations with base name b, of any kind and module, in the order of their declaration
function names_of(c: Ctx, b: Id): List[Name] :=
  match get(b, c.named)
    case Some(ns) => ns
    case None => Nil
  end

function with_named(bs: Map[Id, List[Name]], n: Name): Map[Id, List[Name]] :=
  match get(n.base, bs)
    case Some(ns) => if contains(n, ns) then bs else put(n.base, ns ++ [n], bs)
    case None => put(n.base, [n], bs)
  end

function with_alias(c: Ctx, n: Name, ps: List[Id], t: Type): Ctx :=
  c with aliases := put(n, (ps, t), c.aliases), named := with_named(c.named, n)

function with_fun(c: Ctx, n: Name, sc: List[Type] * Type): Ctx :=
  c with funs := put(n, schemes_of(c, n) ++ [sc], c.funs), named := with_named(c.named, n)

function with_proc(c: Ctx, n: Name, g: List[Type] * List[Type] * List[Type] * List[Type]): Ctx :=
  c with procs := put(n, g, c.procs), named := with_named(c.named, n)

function with_data(c: Ctx, n: Name, arity: Int): Ctx :=
  c with datas := put(n, arity, c.datas), named := with_named(c.named, n)

function with_members(c: Ctx, n: Name, cs: List[Name]): Ctx :=
  c with members := put(n, cs, c.members)

function with_constr(c: Ctx, n: Name, kc: List[Type] * List[Type] * Type): Ctx :=
  c with constrs := put(n, kc, c.constrs), named := with_named(c.named, n)
