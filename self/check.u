// the type checker of ulang, which checks and elaborates programs of self/syntax.u in signatures of self/sig.u,
// where the state is passed by reference, and errors are values of TypeError instead of messages,
// and which overloads names across modules: the declarations of a name in all visible modules are its candidates,
// and each use resolves to the one whose type fits, at once if only one fits, or else at the end of the command,
// when the uses that are still open are solved together

import syntax

import sig
import defs
import format
import map
import set

export

data TypeError :=
  | UnknownSort(name: Name)
  | SortArity(name: Name, expected: Int, actual: Int)
  | SortDefined(name: Name)
  | MissingType(name: Name)
  | UndeclaredParams(name: Name, types: List[Type])
  | CannotUnify(left: Type, right: Type)
  | InfiniteType(meta: Type, typ: Type)
  | UnknownVariable(name: Name)
  | NoOverload(name: Name, typ: Type)
  | WrongArity(name: Name, arity: Int)
  | AlreadyDefined(name: Name)
  | Duplicate(what: Str, item: Str)
  | Ambiguous(name: Name, candidates: List[Name * (List[Type] * Type)])
  | UnknownField(name: Name)
  | UnknownFieldType(field: Id, typ: Type)
  | CountMismatch(owner: Str, unit: Str, expected: Int, actual: Int)
  | UnknownConstructor(name: Name)
  | NotExhaustive(pat: Pat)
  | Unreachable(pat: Pat)
  | NotAssignable(name: Name)
  | UnknownProcedure(name: Name)
  | UnknownException(typ: Type)
  | TestParams(test_name: Id)
  | Unassigned(name: Name)
  | OutputUnassigned(output: Name, proc: Name)
  // the errors of export sections
  | MissingDefinition(name: Name)
  | SignatureMismatch(name: Name)
  | PartlyExported(name: Name)
  | PrivateType(name: Name, sort: Name)
  | VisibleEquality(sort: Name)
  | UnexportedOrder(fun: Name, sort: Name)
  // an error of the command at the position of an imported module, or of the main module for None
  | Located(module: Option[Id], pos: Pos, error: TypeError)

// checked modules: their commands with qualified names, their declarations, and the modules each imports
data Checked :=
  | Checked(cmds: List[Cmd], sig: Sig, imports: List[Id * List[Id]])

procedure check_program(in source: Source, out q: Prog)

implementation

// the types of unknowns by their index
type Subst :=
  Map[Int, Type]

type Env :=
  List[Name * Local]

// a variable with its type scheme, and whether it is assigned on every path to the current statement
data Local :=
  | Local(scheme: List[Type] * Type, assigned: Bool)

// a use of an overloaded name that more than one candidate fits, by the placeholder that stands for it,
// with the candidates that fit so far, and the type of the use
data Pending :=
  | Pending(id: Name, name: Name, cands: List[Name * (List[Type] * Type)], typ: Type)

// the context, the substitution, the number of unknowns so far, the module whose declarations are checked
// with the modules it sees, the modules that each module sees, itself first, the open uses of overloaded names,
// and the declarations chosen for the placeholders of uses that were open
data State :=
  | State(
    sig: Sig,
    sub: Subst,
    count: Int,
    module: Id,
    visible: List[Id],
    table: List[Id * List[Id]],
    pending: List[Pending],
    chosen: Map[Name, Name]
  )

// the constructor of a pattern, where literals count as constructors without arguments
data Head :=
  | HCon(constr: Name)
  | HLit(lit: Val)

function with_sig(s: State, sig: Sig): State :=
  s with sig := sig

// the state for checking a declaration of module m, where the substitution starts empty and unknowns are numbered
// from 1 again, since unknowns do not outlive the command that introduces them
function enter(s: State, m: Id): State :=
  s with sub := empty(), count := 0, module := m, visible := sees(m, s.table), pending := Nil, chosen := empty()

function sees(m: Id, vs: List[Id * List[Id]]): List[Id] :=
  match get(m, vs)
    case Some(ms) => ms
    case None => [m]
  end

function start(main: Id, vs: List[Id * List[Id]]): State :=
  State(initial(), empty(), 0, main, sees(main, vs), vs, Nil, empty())

function in_module(m: Id, n: Name): Name :=
  Name(Some(m), n.base)

function qualify(m: Id, cmd: Cmd): Cmd :=
  match cmd
    case CSort(name, params, typ) => CSort(in_module(m, name), params, typ)
    case CData(name, params, constrs) => CData(in_module(m, name), params, [qualify_constr(m, k) for k in constrs])
    case CFun(name, params, formals, typ, body) => CFun(in_module(m, name), params, formals, typ, body)
    case CProc(name, params, ins, outs, refs, stmt) => CProc(in_module(m, name), params, ins, outs, refs, stmt)
    case CFunSig(name, params, formals, typ) => CFunSig(in_module(m, name), params, formals, typ)
    case CProcSig(name, params, ins, outs, refs) => CProcSig(in_module(m, name), params, ins, outs, refs)
    case CAbstract(name, params) => CAbstract(in_module(m, name), params)
    case _ => cmd
  end

function qualify_constr(m: Id, k: Constr): Constr :=
  k with name := in_module(m, k.name)

// each module sees itself and its direct imports, which include the implicit ones, for the imports of each module
function visibility(imports: List[Id * List[Id]], main: Id): List[Id * List[Id]] :=
  [(m, distinct([m] ++ imports_of(imports, m))) for m in distinct([main] ++ firsts(imports))]

function imports_of(imports: List[Id * List[Id]], m: Id): List[Id] :=
  match get(m, imports)
    case Some(ns) => ns
    case None => Nil
  end

// the declarations named n of a kind that the module sees, where its own declarations hide those of other modules
// and declared tells whether a name is a declaration of that kind
function visible_names(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := [d for d in names_of(s.sig, n.base) if declared(d)] in
    match n
      case Name(Some(_), _) => if contains(n, ds) then [n] else Nil
      case Name(None, base) =>
        if contains(Name(Some(s.module), base), ds) then [Name(Some(s.module), base)] else [d for d in ds if is_visible(s, d)]
    end

// the declarations named n of a kind in all modules that the module sees, its own included, whose types decide
// among them
// a name of the module * stands for the declarations of all visible modules, as an unqualified name does, but locals never
// hide it, since the parser introduces such names in translations, where users cannot write them
function overloads(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  match n
    case Name(Some(m), _) if m != "*" => [d for d in names_of(s.sig, n.base) if declared(d) and d == n]
    case _ => [d for d in names_of(s.sig, n.base) if declared(d) and is_visible(s, d)]
  end

function is_visible(s: State, d: Name): Bool :=
  match d.module
    case Some(m) => contains(m, s.visible)
    case None => false
  end

function params(ps: List[Id]): List[Type] :=
  [TParam(p) for p in ps]

function literal(v: Val): Type :=
  match v
    case VUnit => TTuple(Nil)
    case VBool(_) => type_bool()
    case VInt(_) => type_int()
    case VStr(_) => type_str()
    case VChar(_) => type_char()
  end

function initial(): Sig :=
  empty()

function logic(): List[Type] * Type :=
  (Nil, type_fun([type_bool(), type_bool()], type_bool()))

// only what cannot be defined in the prelude, which are names without a module
function builtin_schemes(n: Name): List[List[Type] * Type] :=
  match n
    case Name(None, base) => builtin_scheme(base)
    case _ => Nil
  end

function builtin_scheme(b: Id): List[List[Type] * Type] :=
  let a := TParam("A") in
    match b
      case "<" => [([a], type_fun([a, a], type_bool()))]
      case "==" => [([a], type_fun([a, a], type_bool()))]
      case "compare" => [([a], type_fun([a, a], type_int()))]
      case "show" => [([a], type_fun([a], type_str()))]
      case "and" => [logic()]
      case "or" => [logic()]
      case _ => Nil
    end

function is_meta(t: Type): Bool :=
  match t
    case TMeta(_) => true
    case _ => false
  end

// the Params and Metas in t
function free(t: Type): List[Type] :=
  match t
    case TParam(_) => [t]
    case TMeta(_) => [t]
    case THole => Nil
    case TSort(_, args) => distinct([v for a in args, v in free(a)])
    case TFun(args, res) => distinct([v for a in args ++ [res], v in free(a)])
    case TProc(ins, outs, refs) => distinct([v for a in ins ++ outs ++ refs, v in free(a)])
    case TTuple(types) => distinct([v for a in types, v in free(a)])
  end

function holes(t: Type): Bool :=
  match t
    case THole => true
    case TSort(_, args) => exists(args, holes)
    case TFun(args, res) => exists(args, holes) or holes(res)
    case TProc(ins, outs, refs) => exists(ins ++ outs ++ refs, holes)
    case TTuple(types) => exists(types, holes)
    case _ => false
  end

function subst(t: Type, m: List[Type * Type]): Type :=
  match t
    case TSort(name, args) => TSort(name, [subst(a, m) for a in args])
    case TFun(args, res) => TFun([subst(a, m) for a in args], subst(res, m))
    case TProc(ins, outs, refs) => TProc([subst(a, m) for a in ins], [subst(a, m) for a in outs], [subst(a, m) for a in refs])
    case TTuple(types) => TTuple([subst(a, m) for a in types])
    case _ =>
      match get(t, m)
        case Some(u) => u
        case None => t
      end
  end

function resolve(su: Subst, t: Type): Type :=
  match t
    case TMeta(meta) =>
      match get(meta, su)
        case Some(u) => resolve(su, u)
        case None => t
      end
    case _ => t
  end

function occurs(su: Subst, i: Int, t: Type): Bool :=
  match resolve(su, t)
    case TMeta(meta) => i == meta
    case TSort(_, args) => exists(args, lambda a => occurs(su, i, a))
    case TFun(args, res) => exists(args, lambda a => occurs(su, i, a)) or occurs(su, i, res)
    case TProc(ins, outs, refs) => exists(ins ++ outs ++ refs, lambda a => occurs(su, i, a))
    case TTuple(types) => exists(types, lambda a => occurs(su, i, a))
    case _ => false
  end

function constructor_scheme(k: List[Type] * List[Type] * Type): List[Type] * Type :=
  match k
    case (ps, ks, r) => (ps, if ks == Nil then r else type_fun(ks, r))
  end

function constructor_of(sig: Sig, k: Name): List[Type] * Type :=
  match constr_of(sig, k)
    case Some(kc) => constructor_scheme(kc)
    case None => (Nil, TTuple(Nil))
  end

// the meanings of n with their names, where local variables hide functions, constructors, and builtins
function candidates(s: State, env: Env, n: Name): List[Name * (List[Type] * Type)] :=
  match get(n, env)
    case Some(l) => [(n, l.scheme)]
    case None =>
      [(f, sc) for f in overloads(s, n, lambda f => is_fun(s.sig, f)), sc in schemes_of(s.sig, f)] ++
        [(k, constructor_of(s.sig, k)) for k in overloads(s, n, lambda k => is_constr(s.sig, k))] ++
        [(p, proc_scheme(s.sig, p)) for p in overloads(s, n, lambda p => is_proc(s.sig, p))] ++
        [(n, sc) for sc in builtin_schemes(n)]
  end

// the accessors or updaters T.f of all datatypes T for the field f, which is .name or .name:=, of all modules, of which
// visible_accessors keeps those of the modules that the module sees, since fields are visible as other names are
function accessors(sig: Sig, f: Id, es: List[Id * List[Name]]): List[Name * (List[Type] * Type)] :=
  match es
    case Nil => Nil
    case [(b, ds); rest] =>
      if ends_with(b, f) then [(d, sc) for d in ds, sc in schemes_of(sig, d)] ++ accessors(sig, f, rest) else accessors(sig, f, rest)
  end

function visible_accessors(s: State, cs: List[Name * (List[Type] * Type)]): List[Name * (List[Type] * Type)] :=
  match cs
    case Nil => Nil
    case [(d, sc); rest] => if is_visible(s, d) then [(d, sc); visible_accessors(s, rest)] else visible_accessors(s, rest)
  end

function ends_with(b: Id, f: Id): Bool :=
  if size(b) > size(f) then slice(b, size(b) - size(f), size(b)) == f else false

// a procedure is a value of its type (in A, out B, ref C)
function proc_scheme(sig: Sig, p: Name): List[Type] * Type :=
  match proc_of(sig, p)
    case Some((ps, is, os, rs)) => (ps, TProc(is, os, rs))
    case None => (Nil, THole)
  end

function with_arity(cs: List[Name * (List[Type] * Type)], k: Int): List[Name * (List[Type] * Type)] :=
  match cs
    case Nil => Nil
    case [(n, (ps, t)); rest] => if arity(t) == k then [(n, (ps, t)); with_arity(rest, k)] else with_arity(rest, k)
  end

function has_arity(scs: List[List[Type] * Type], k: Int): Bool :=
  match scs
    case Nil => false
    case [(_, t); rest] => arity(t) == k or has_arity(rest, k)
  end

function bind(xs: List[Var]): Env :=
  [(x.name, Local((Nil, x.typ), true)) for x in xs]

function unassigned(xs: List[Var]): Env :=
  [(x.name, Local((Nil, x.typ), false)) for x in xs]

// env after assignments to xs, which are the innermost variables of their names
function assigned(env: Env, xs: List[Name]): Env :=
  match (env, xs)
    case (_, Nil) => env
    case (Nil, _) => Nil
    case ([(n, l); rest], _) =>
      if contains(n, xs) then [(n, l with assigned := true); assigned(rest, xs -- [n])] else [(n, l); assigned(rest, xs)]
  end

// the variables that both paths assign, where env and other have the same variables
function joined(env: Env, other: Env): Env :=
  match (env, other)
    case ([(n, l); rest], [(_, k); more]) => [(n, l with assigned := l.assigned and k.assigned); joined(rest, more)]
    case _ => Nil
  end

// the variables after a raise, where no path continues, which joins with others as if it assigned all of them
function unreachable(env: Env): Env :=
  match env
    case Nil => Nil
    case [(n, l); rest] => [(n, l with assigned := true); unreachable(rest)]
  end

procedure readable(in env: Env, n: Name) :=
  match get(n, env)
    case Some(Local(_, false)) =>
      raise Unassigned(n)
    case _ =>
      skip
  end

procedure readables(in env: Env, ns: List[Name]) :=
  match ns
    case Nil =>
      skip
    case [n; more] =>
      call readable(in env, n)
      call readables(in env, more)
  end

// the outs os of procedure p must be assigned at the end of its body
procedure outputs(in p: Name, os: List[Var], env: Env) :=
  match os
    case Nil =>
      skip
    case [o; more] =>
      match get(o.name, env)
        case Some(Local(_, false)) =>
          raise OutputUnassigned(o.name, p)
        case _ =>
          skip
      end
      call outputs(in p, more, env)
  end

// the unknowns of the types of env, which a let cannot generalize
function fixed(su: Subst, env: Env): List[Type] :=
  match env
    case Nil => Nil
    case [(_, Local((ps, t), _)); rest] => (free(zonk_type(su, t)) -- ps) ++ fixed(su, rest)
  end

function generalize(su: Subst, env: Env, t: Type): List[Type] * Type :=
  let fx := fixed(su, env), u := zonk_type(su, t) in
  ([m for m in free(u) if is_meta(m) and not contains(m, fx)], u)

// the unknowns of open uses of overloaded names stay fixed, too, since their declarations are not chosen yet
function generalized(s: State, env: Env, xs: List[Var]): Env :=
  let waiting := [(p.id, Local((Nil, p.typ), true)) for p in s.pending] in [(x.name, Local(generalize(s.sub, waiting ++ env, x.typ), true)) for x in xs]

// the pattern of a case, and whether it has no guard, such that it may cover values
function case_of[A](b: Branch[A]): Pat * Bool :=
  match b
    case Branch(pat, guard, _) => (pat, guard == None)
  end

function zonk_guard(s: State, g: Option[Expr]): Option[Expr] :=
  match g
    case Some(e) => Some(zonk_expr(s, e))
    case None => None
  end

function zonk_type(su: Subst, t: Type): Type :=
  match resolve(su, t)
    case TSort(name, args) => TSort(name, [zonk_type(su, a) for a in args])
    case TFun(args, res) => TFun([zonk_type(su, a) for a in args], zonk_type(su, res))
    case TProc(ins, outs, refs) => TProc([zonk_type(su, a) for a in ins], [zonk_type(su, a) for a in outs], [zonk_type(su, a) for a in refs])
    case TTuple(types) => TTuple([zonk_type(su, a) for a in types])
    case u => u
  end

// the declaration chosen for an overloaded name, which stands for it until the end of the command
function settled(s: State, n: Name): Name :=
  match n.module
    case Some("?") =>
      match get(n, s.chosen)
        case Some(m) => m
        case None => n
      end
    case _ => n
  end

function zonk_var(s: State, x: Var): Var :=
  Var(settled(s, x.name), zonk_type(s.sub, x.typ))

function zonk_vars(s: State, xs: List[Var]): List[Var] :=
  [zonk_var(s, x) for x in xs]

function zonk_expr(s: State, expr: Expr): Expr :=
  match expr
    case ELit(_) => expr
    case EVar(var) => EVar(zonk_var(s, var))
    case EApp(fun, args) => EApp(zonk_expr(s, fun), [zonk_expr(s, a) for a in args])
    case ELam(formals, body) => ELam(zonk_vars(s, formals), zonk_expr(s, body))
    case EProc(ins, outs, refs, stmt) => EProc(zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, stmt))
    case ELet(bindings, body) => ELet([zonk_binding(s, p) for p in bindings], zonk_expr(s, body))
    case EIte(cond, then_expr, else_expr) => EIte(zonk_expr(s, cond), zonk_expr(s, then_expr), zonk_expr(s, else_expr))
    case EMatch(expr, cases) => EMatch(zonk_expr(s, expr), [zonk_expr_branch(s, b) for b in cases])
    case ETuple(exprs) => ETuple([zonk_expr(s, expr) for expr in exprs])
    case ERaise(expr, typ) => ERaise(zonk_expr(s, expr), zonk_type(s.sub, typ))
  end

function zonk_binding(s: State, p: Var * Expr): Var * Expr :=
  match p
    case (x, e) => (zonk_var(s, x), zonk_expr(s, e))
  end

function zonk_expr_branch(s: State, b: Branch[Expr]): Branch[Expr] :=
  match b
    case Branch(pat, guard, body) => Branch(zonk_pat(s, pat), zonk_guard(s, guard), zonk_expr(s, body))
  end

function zonk_pat(s: State, pat: Pat): Pat :=
  match pat
    case PVar(var) => PVar(zonk_var(s, var))
    case PApp(constr, pats) => PApp(constr, [zonk_pat(s, a) for a in pats])
    case PTuple(pats) => PTuple([zonk_pat(s, q) for q in pats])
    case _ => pat
  end

function zonk_stmt(s: State, x: Stmt): Stmt :=
  match x
    case SSkip => x
    case SAssign(assignments) => SAssign([zonk_binding(s, p) for p in assignments])
    case SBlock(locals, stmts) => SBlock(zonk_vars(s, locals), [zonk_stmt(s, y) for y in stmts])
    case SIf(cond, then_stmt, else_stmt) => SIf(zonk_expr(s, cond), zonk_stmt(s, then_stmt), zonk_stmt(s, else_stmt))
    case SWhile(cond, body) => SWhile(zonk_expr(s, cond), zonk_stmt(s, body))
    case SCall(proc, ins, outs, refs) => SCall(settled(s, proc), [zonk_expr(s, e) for e in ins], zonk_vars(s, outs), zonk_vars(s, refs))
    case SMatch(expr, cases) => SMatch(zonk_expr(s, expr), [zonk_stmt_branch(s, b) for b in cases])
    case SAssert(cond) => SAssert(zonk_expr(s, cond))
    case SRaise(expr, typ) => SRaise(zonk_expr(s, expr), zonk_type(s.sub, typ))
    case STry(body, handlers) => STry(zonk_stmt(s, body), [zonk_handler(s, h) for h in handlers])
  end

function zonk_stmt_branch(s: State, b: Branch[Stmt]): Branch[Stmt] :=
  match b
    case Branch(pat, guard, body) => Branch(zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_handler(s: State, h: Handler): Handler :=
  match h
    case Handler(typ, pat, guard, body) => Handler(zonk_type(s.sub, typ), zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_cmd(s: State, cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, body) => CFun(name, params, [zonk_vars(s, xs) for xs in formals], zonk_type(s.sub, typ), zonk_expr(s, body))
    case CProc(name, params, ins, outs, refs, stmt) => CProc(name, params, zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, stmt))
    case CTest(test_name, vars, stmt) => CTest(test_name, vars, zonk_stmt(s, stmt))
    case _ => cmd
  end

// exceptions are told apart by their types at runtime, which must therefore be known after checking
function unknown_type(t: Type): Option[Type] :=
  if free(t) == Nil then None else Some(t)

// the type of an exception that is not known, also of those raised in expressions
function unknown_in(x: Stmt): Option[Type] :=
  match x
    case SAssign(assignments) => unknown_in_exprs(seconds(assignments))
    case SBlock(_, stmts) => unknown_in_all(stmts)
    case SIf(cond, then_stmt, else_stmt) => or_else(unknown_in_expr(cond), or_else(unknown_in(then_stmt), unknown_in(else_stmt)))
    case SWhile(cond, body) => or_else(unknown_in_expr(cond), unknown_in(body))
    case SCall(_, ins, _, _) => unknown_in_exprs(ins)
    case SMatch(expr, cases) => or_else(unknown_in_expr(expr), unknown_in_branches(cases))
    case SAssert(cond) => unknown_in_expr(cond)
    case SRaise(expr, typ) => or_else(unknown_type(typ), unknown_in_expr(expr))
    case STry(body, handlers) => or_else(unknown_in(body), unknown_in_handlers(handlers))
    case _ => None
  end

function unknown_in_expr(expr: Expr): Option[Type] :=
  match expr
    case ERaise(expr, typ) => or_else(unknown_type(typ), unknown_in_expr(expr))
    case EApp(fun, args) => unknown_in_exprs([fun; args])
    case ELam(_, body) => unknown_in_expr(body)
    case EProc(_, _, _, stmt) => unknown_in(stmt)
    case ELet(bindings, body) => unknown_in_exprs(seconds(bindings) ++ [body])
    case EIte(cond, then_expr, else_expr) => unknown_in_exprs([cond, then_expr, else_expr])
    case EMatch(expr, cases) => unknown_in_exprs([expr; [e for b in cases, e in branch_exprs(b)]])
    case ETuple(exprs) => unknown_in_exprs(exprs)
    case _ => None
  end

function unknown_in_exprs(exprs: List[Expr]): Option[Type] :=
  match exprs
    case Nil => None
    case [e; rest] => or_else(unknown_in_expr(e), unknown_in_exprs(rest))
  end

function branch_exprs(b: Branch[Expr]): List[Expr] :=
  match b
    case Branch(_, Some(g), body) => [g, body]
    case Branch(_, None, body) => [body]
  end

function unknown_in_all(xs: List[Stmt]): Option[Type] :=
  match xs
    case Nil => None
    case [y; ys] => or_else(unknown_in(y), unknown_in_all(ys))
  end

function unknown_in_branches(bs: List[Branch[Stmt]]): Option[Type] :=
  match bs
    case Nil => None
    case [Branch(_, Some(g), body); rest] => or_else(unknown_in_expr(g), or_else(unknown_in(body), unknown_in_branches(rest)))
    case [Branch(_, None, body); rest] => or_else(unknown_in(body), unknown_in_branches(rest))
  end

// handlers of _ catch exceptions of any type
function unknown_in_handlers(hs: List[Handler]): Option[Type] :=
  match hs
    case Nil => None
    case [Handler(_, PWild, _, body); rest] => or_else(unknown_in(body), unknown_in_handlers(rest))
    case [Handler(typ, _, _, body); rest] => or_else(unknown_type(typ), or_else(unknown_in(body), unknown_in_handlers(rest)))
  end

function unknown_in_cmd(cmd: Cmd): Option[Type] :=
  match cmd
    case CFun(_, _, _, _, body) => unknown_in_expr(body)
    case CProc(_, _, _, _, _, stmt) => unknown_in(stmt)
    case CTest(_, _, stmt) => unknown_in(stmt)
    case _ => None
  end

function head_of(pat: Pat): Option[Head * List[Pat]] :=
  match pat
    case PApp(constr, pats) => Some((HCon(constr), pats))
    case PTuple(pats) => Some((HCon(tuple_name()), pats))
    case PLit(lit) => Some((HLit(lit), Nil))
    case _ => None
  end

// the constructors in the first column
function heads(rows: List[List[Pat]]): List[Head] :=
  match rows
    case Nil => Nil
    case [[p; _]; rest] =>
      match head_of(p)
        case Some((h, _)) => [h; heads(rest)]
        case None => heads(rest)
      end
    case [Nil; rest] => heads(rest)
  end

// the argument types of constructor k of a datatype with type arguments args
function field_types(sig: Sig, k: Name, args: List[Type]): List[Type] :=
  match constr_of(sig, k)
    case Some((ps, ks, _)) => [subst(a, zip(ps, args)) for a in ks]
    case None => Nil
  end

// all constructors of t with their argument types, if there are finitely many
function constructors_of(sig: Sig, su: Subst, t: Type): Option[List[Head * List[Type]]] :=
  match zonk_type(su, t)
    case TSort(name, Nil) if TSort(name, Nil) == type_bool() => Some([(HLit(VBool(true)), Nil), (HLit(VBool(false)), Nil)])
    case TTuple(types) => Some([(HCon(tuple_name()), types)])
    case TSort(name, args) =>
      match members_of(sig, name)
        case Some(ks) => Some([(HCon(k), field_types(sig, k, args)) for k in ks])
        case None => None
      end
    case _ => None
  end

function fields_of(sig: Sig, su: Subst, t: Type, h: Head): List[Type] :=
  match constructors_of(sig, su, t)
    case Some(ks) =>
      match get(h, ks)
        case Some(ts) => ts
        case None => Nil
      end
    case None => Nil
  end

function covers(hs: List[Head], ks: List[Head * List[Type]]): Bool :=
  match ks
    case Nil => true
    case [(h, _); rest] => contains(h, hs) and covers(hs, rest)
  end

// the rows whose first pattern has no constructor, without it
function defaults(rows: List[List[Pat]]): List[List[Pat]] :=
  match rows
    case Nil => Nil
    case [[p; ps]; rest] =>
      match head_of(p)
        case Some(_) => defaults(rest)
        case None => [ps; defaults(rest)]
      end
    case [Nil; rest] => defaults(rest)
  end

function specialize(rows: List[List[Pat]], h: Head, n: Int): List[List[Pat]] :=
  match rows
    case Nil => Nil
    case [[p; ps]; rest] =>
      match head_of(p)
        case Some((g, args)) => if g == h then [args ++ ps; specialize(rest, h, n)] else specialize(rest, h, n)
        case None => [replicate(n, PWild) ++ ps; specialize(rest, h, n)]
      end
    case [Nil; rest] => specialize(rest, h, n)
  end

// some values of types ts match q but no row
function useful(sig: Sig, su: Subst, rows: List[List[Pat]], q: List[Pat], ts: List[Type]): Bool :=
  match (q, ts)
    case (Nil, _) => rows == Nil
    case ([p; ps], [t; rest]) =>
      match head_of(p)
        case Some((h, args)) => useful(sig, su, specialize(rows, h, size(args)), args ++ ps, fields_of(sig, su, t, h) ++ rest)
        case None =>
          match constructors_of(sig, su, t)
            case Some(ks) =>
              if covers(heads(rows), ks) then useful_in(sig, su, rows, ks, ps, rest) else useful(sig, su, defaults(rows), ps, rest)
            case None => useful(sig, su, defaults(rows), ps, rest)
          end
      end
    case ([_; _], Nil) => false
  end

function useful_in(
  sig: Sig,
  su: Subst,
  rows: List[List[Pat]],
  ks: List[Head * List[Type]],
  pats: List[Pat],
  rest: List[Type]
): Bool :=
  match ks
    case Nil => false
    case [(h, args); more] =>
      useful(sig, su, specialize(rows, h, size(args)), replicate(size(args), PWild) ++ pats, args ++ rest) or
      useful_in(sig, su, rows, more, pats, rest)
  end

function witness(h: Head, args: List[Pat]): Pat :=
  match h
    case HCon(constr) => if constr == tuple_name() then PTuple(args) else PApp(constr, args)
    case HLit(lit) => PLit(lit)
  end

// values of types ts, as patterns, that no row matches
function missing(sig: Sig, su: Subst, rows: List[List[Pat]], ts: List[Type]): Option[List[Pat]] :=
  match ts
    case Nil => if rows == Nil then Some(Nil) else None
    case [t; rest] => missing_in(sig, su, rows, heads(rows), constructors_of(sig, su, t), rest)
  end

// hs are the constructors in the first column, cs are all constructors of its type if there are finitely many
function missing_in(
  sig: Sig,
  su: Subst,
  rows: List[List[Pat]],
  hs: List[Head],
  cs: Option[List[Head * List[Type]]],
  rest: List[Type]
): Option[List[Pat]] :=
  match cs
    case Some(ks) => if covers(hs, ks) then first_missing(sig, su, rows, ks, rest) else other_missing(sig, su, rows, hs, cs, rest)
    case None => other_missing(sig, su, rows, hs, cs, rest)
  end

function first_missing(
  sig: Sig,
  su: Subst,
  rows: List[List[Pat]],
  ks: List[Head * List[Type]],
  rest: List[Type]
): Option[List[Pat]] :=
  match ks
    case Nil => None
    case [(h, args); more] =>
      match missing(sig, su, specialize(rows, h, size(args)), args ++ rest)
        case Some(ws) => Some([witness(h, take(size(args), ws)); drop(size(args), ws)])
        case None => first_missing(sig, su, rows, more, rest)
      end
  end

function other_missing(
  sig: Sig,
  su: Subst,
  rows: List[List[Pat]],
  hs: List[Head],
  cs: Option[List[Head * List[Type]]],
  rest: List[Type]
): Option[List[Pat]] :=
  match missing(sig, su, defaults(rows), rest)
    case Some(ws) => Some([uncovered(hs, cs); ws])
    case None => None
  end

// a value of the first column that hs do not cover
function uncovered(hs: List[Head], cs: Option[List[Head * List[Type]]]): Pat :=
  match cs
    case Some(ks) => if hs == Nil then PWild else first_uncovered(hs, ks)
    case None => PWild
  end

function first_uncovered(hs: List[Head], ks: List[Head * List[Type]]): Pat :=
  match ks
    case Nil => PWild
    case [(h, args); rest] => if contains(h, hs) then first_uncovered(hs, rest) else witness(h, replicate(size(args), PWild))
  end

procedure fresh(out t: Type, ref s: State) :=
  assign t := TMeta(s.count + 1), s := s with count := s.count + 1

procedure bind_meta(in i: Int, t: Type, ref s: State) :=
  if occurs(s.sub, i, t)
    raise InfiniteType(TMeta(i), zonk_type(s.sub, t))
  end

  assign s := s with sub := put(i, t, s.sub)

procedure unify(in t1: Type, t2: Type, ref s: State) :=
  local a := resolve(s.sub, t1), b := resolve(s.sub, t2)

  match (a, b)
    case (TMeta(i), TMeta(j)) =>
      if i != j
        call bind_meta(in i, b, ref s)
      end

    case (TMeta(meta), _) =>
      call bind_meta(in meta, b, ref s)

    case (_, TMeta(meta)) =>
      call bind_meta(in meta, a, ref s)

    case (TParam(x), TParam(y)) =>
      if x != y
        raise CannotUnify(a, b)
      end

    case (TSort(f, xs), TSort(g, ys)) =>
      if f == g and size(xs) == size(ys)
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TFun(xs, r1), TFun(ys, r2)) =>
      if size(xs) == size(ys)
        call unifies(in xs ++ [r1], ys ++ [r2], ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TTuple(xs), TTuple(ys)) =>
      if size(xs) == size(ys)
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TProc(xs, ys, zs), TProc(us, vs, ws)) =>
      if size(xs) == size(us) and size(ys) == size(vs) and size(zs) == size(ws)
        call unifies(in xs ++ ys ++ zs, us ++ vs ++ ws, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case _ =>
      raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
  end

procedure unifies(in xs: List[Type], ys: List[Type], ref s: State) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call   unify(in x, y, ref s)
      call   unifies(in xs1, ys1, ref s)
    case (Nil, Nil) =>
      skip
    case _ =>
      raise CountMismatch("", "values", size(xs), size(ys))
  end

// a fresh unknown for each of xs
procedure fresh_list[A](in xs: List[A], out ts: List[Type], ref s: State) :=
  local t: Type, rest: List[Type]

  match xs
    case Nil =>
      assign ts := Nil
    case [_; more] =>
      call   fresh(out t, ref s)
      call   fresh_list(in more, out rest, ref s)
      assign ts := [t; rest]
  end

procedure instance(in ps: List[Type], out m: List[Type * Type], ref s: State) :=
  local t: Type, rest: List[Type * Type]

  match ps
    case Nil =>
      assign m := Nil
    case [p; qs] =>
      call   fresh(out t, ref s)
      call   instance(in qs, out rest, ref s)
      assign m := [(p, t); rest]
  end

procedure instantiate(in sc: List[Type] * Type, out t: Type, ref s: State) :=
  local m: List[Type * Type]

  match sc
    case (ps, u) =>
      call   instance(in ps, out m, ref s)
      assign t := subst(zonk_type(s.sub, u), m)
  end

// the names ns, which must be distinct, of what they are, e.g. formals
procedure unique(in what: Str, ns: List[Name]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(what, n.base)
    case None =>
      skip
  end

procedure unique_ids(in what: Str, ns: List[Id]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(what, n)
    case None =>
      skip
  end

// the one of the names ns that n refers to
// the number n of the units of owner, which expects m of them, e.g. the arguments of a constructor
procedure same_length(in owner: Str, unit: Str, m: Int, n: Int) :=
  if m != n
    raise CountMismatch(owner, unit, m, n)
  end

procedure arguments(in n: Name, k: Int, args: List[Type]) :=
  if size(args) != k
    raise SortArity(n, k, size(args))
  end

// expands type definitions and replaces holes by fresh unknowns
procedure normalize(in t: Type, out u: Type, ref s: State) :=
  local us: List[Type], v: Type

  match t
    case THole =>
      call fresh(out u, ref s)

    case TParam(_) =>
      assign u := t

    case TMeta(_) =>
      assign u := t

    case TFun(args, res) =>
      call   normalizes(in args, out us, ref s)
      call   normalize(in res, out v, ref s)
      assign u := TFun(us, v)

    case TTuple(types) =>
      call   normalizes(in types, out us, ref s)
      assign u := TTuple(us)

    case TProc(ins, outs, refs) =>
      call   normalizes(in ins ++ outs ++ refs, out us, ref s)
      assign u := TProc(take(size(ins), us), take(size(outs), drop(size(ins), us)), drop(size(ins) + size(outs), us))

    case TSort(name, args) =>
      match visible_names(s, name, lambda t => is_sort(s.sig, t))
        case [m] =>
          call normalize_sort(in m, args, out u, ref s)
        case Nil =>
          raise UnknownSort(name)
        case ms =>
          raise Ambiguous(name, [(m, (Nil, THole)) for m in ms])
      end
  end

procedure normalize_sort(in n: Name, args: List[Type], out u: Type, ref s: State) :=
  local us: List[Type]

  match data_of(s.sig, n)
    case Some(k) =>
      call   arguments(in n, k, args)
      call   normalizes(in args, out us, ref s)
      assign u := TSort(n, us)
    case None =>
      match alias_of(s.sig, n)
        case Some((ps, rhs)) =>
          call   arguments(in n, size(ps), args)
          call   normalizes(in args, out us, ref s)
          assign u := subst(rhs, zip(params(ps), us))
        case None =>
          raise UnknownSort(n)
      end
  end

procedure normalizes(in ts: List[Type], out us: List[Type], ref s: State) :=
  local u: Type, rest: List[Type]

  match ts
    case Nil =>
      assign us := Nil
    case [t; more] =>
      call   normalize(in t, out u, ref s)
      call   normalizes(in more, out rest, ref s)
      assign us := [u; rest]
  end

procedure known(in t: Type, what: Name, out u: Type, ref s: State) :=
  if holes(t)
    raise MissingType(what)
  end
  call normalize(in t, out u, ref s)

procedure knowns(in ts: List[Type], what: Name, out us: List[Type], ref s: State) :=
  local u: Type, rest: List[Type]

  match ts
    case Nil =>
      assign us := Nil
    case [t; more] =>
      call   known(in t, what, out u, ref s)
      call   knowns(in more, what, out rest, ref s)
      assign us := [u; rest]
  end

// the variables of a lambda, a let, or locals, which are what, e.g. formals
procedure formals(in what: Str, xs: List[Var], out ys: List[Var], ref s: State) :=
  call   unique(in what, names(xs))
  call   normalize_vars(in xs, out ys, ref s)

procedure normalize_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  local u: Type, rest: List[Var]

  match xs
    case Nil =>
      assign ys := Nil
    case [Var(name, typ); more] =>
      call   normalize(in typ, out u, ref s)
      call   normalize_vars(in more, out rest, ref s)
      assign ys := [Var(name, u); rest]
  end

// the parameters and locals, which have types
procedure signature(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call   unique(in "formal", names(xs))
  call   known_vars(in xs, out ys, ref s)

procedure known_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  local u: Type, rest: List[Var]

  match xs
    case Nil =>
      assign ys := Nil
    case [Var(name, typ); more] =>
      call   known(in typ, name, out u, ref s)
      call   known_vars(in more, out rest, ref s)
      assign ys := [Var(name, u); rest]
  end

// a use of n elaborated with an instance of sc, where w is normalized
procedure use(in n: Name, w: Type, sc: List[Type] * Type, out x: Var, ref s: State) :=
  local u: Type

  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)
  assign x := Var(n, u)

// a use of n of type w, which is normalized, as the one of the candidates cs that fits w
procedure use_name(in n: Name, cs: List[Name * (List[Type] * Type)], w: Type, out x: Var, ref s: State) :=
  local m: Name

  match cs
    case Nil =>
      raise UnknownVariable(n)
    case [(m1, sc)] =>
      call use(in m1, w, sc, out x, ref s)
    case _ =>
      call   choose(in n, cs, w, out m, ref s)
      assign x := Var(m, w)
  end

// the one of the candidates cs that fits w, or a placeholder for the use if several fit, which stays open
procedure choose(in n: Name, cs: List[Name * (List[Type] * Type)], w: Type, out m: Name, ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State], best: List[(Name * (List[Type] * Type)) * State]

  call trials(in cs, w, s, out ok)
  if size(ok) > 1 and known_type(s.sub, w)
    call   decide(in ok, w, s, out best)
    assign ok := best
  end

  match ok
    case Nil =>
      raise NoOverload(n, zonk_type(s.sub, w))
    case [((m1, _), s1)] =>
      assign m := m1, s := s1
    case _ =>
      assign m := Name(Some("?"), show(s.count + 1))
      assign s := s with count := s.count + 1, pending := s.pending ++ [Pending(m, n, firsts(ok), w)]
  end

// the candidates that fit w, each with the state after unifying its instance with w
procedure trials(
  in  cs: List[Name * (List[Type] * Type)],
      w: Type,
      s: State,
  out ok: List[(Name * (List[Type] * Type)) * State]
) :=
  local rest: List[(Name * (List[Type] * Type)) * State], u: State, failed: Option[TypeError]

  match cs
    case Nil =>
      assign ok := Nil
    case [(m, sc); more] =>
      call   trials(in more, w, s, out rest)
      assign u := s, failed := None
      try
        call trial(in sc, w, ref u)
      catch
        case e =>
          assign failed := Some(e)
      end

      if failed == None
        assign ok := [((m, sc), u); rest]
      else
        assign ok := rest
      end
  end

procedure trial(in sc: List[Type] * Type, w: Type, ref s: State) :=
  local u: Type

  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)

// the open uses, until none can be decided, where each is decided once one of its candidates fits
procedure solve(ref s: State) :=
  local changed := true, ps: List[Pending]

  while changed
    assign ps := s.pending, changed := false
    assign s := s with pending := Nil
    call   revisit(in ps, ref changed, s)
  end

procedure revisit(in ps: List[Pending], ref changed: Bool, s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State], best: List[(Name * (List[Type] * Type)) * State]

  match ps
    case Nil =>
      skip
    case [p; rest] =>
      call trials(in p.cands, p.typ, s, out ok)
      if size(ok) > 1 and known_type(s.sub, p.typ)
        call   decide(in ok, p.typ, s, out best)
        assign ok := best
      end

      match ok
        case Nil =>
          raise NoOverload(p.name, zonk_type(s.sub, p.typ))
        case [((m, _), s1)] =>
          assign s := s1 with chosen := put(p.id, m, s1.chosen)
          assign changed := true
        case _ =>
          assign s := s with pending := s.pending ++ [p with cands := firsts(ok)]
          if size(ok) < size(p.cands)
            assign changed := true
          end
      end

      call revisit(in rest, ref changed, s)
  end

// all uses decided at the end of a command, by the preferences of decide among the candidates that fit, and else by the one
// candidate after which the other open uses can still be decided, e.g. empty and put of map literals {k => v} when set and
// array are imported as well, where only the empty and the put of map fit together
procedure settle(ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State], best: List[(Name * (List[Type] * Type)) * State], states: List[State]

  call solve(ref s)
  while s.pending != Nil
    match s.pending
      case [p; rest] =>
        call trials(in p.cands, p.typ, s, out ok)
        call decide(in ok, p.typ, s, out best)
        match best
          case [((m, _), s1)] =>
            assign s := s1 with pending := rest, chosen := put(p.id, m, s1.chosen)
            call   solve(ref s)
          case _ =>
            call viable(in best, p, rest, out states)
            match states
              case [s2] =>
                assign s := s2
              case _ =>
                raise Ambiguous(p.name, p.cands)
            end
        end
      case Nil =>
        skip
    end
  end

// the states after choosing each candidate of the use p, of those after which every open use of rest has a candidate that fits
procedure viable(in cands: List[(Name * (List[Type] * Type)) * State], p: Pending, rest: List[Pending], out states: List[State]) :=
  local t: State, failed := false

  match cands
    case Nil =>
      assign states := Nil
    case [((m, _), s1); more] =>
      call   viable(in more, p, rest, out states)
      assign t := s1 with pending := rest, chosen := put(p.id, m, s1.chosen)
      try
        call solve(ref t)
      catch
        case NoOverload(_, _) =>
          assign failed := true
      end

      if not failed
        assign states := [t; states]
      end
  end

// the types of a use without unknowns, for which the candidates that fit stay the same
function known_type(su: Subst, t: Type): Bool :=
  [m for m in free(zonk_type(su, t)) if is_meta(m)] == Nil

// among several candidates that fit w, the most specific, which is an instance of all others, if the type of the use
// is known, and the most general otherwise, of which all others are instances, such that builtins like == serve
// when no declaration for a type fits, and else the one declared by the module itself, or all if none of these is unique
procedure decide(
  in  ok: List[(Name * (List[Type] * Type)) * State],
      w: Type,
      s: State,
  out picked: List[(Name * (List[Type] * Type)) * State]
) :=
  local best: List[(Name * (List[Type] * Type)) * State]

  call most(in ok, ok, known_type(s.sub, w), s, out best)
  match (best, own_fits(s, ok))
    case ([b], _) =>
      assign picked := [b]
    case (_, [o]) =>
      assign picked := [o]
    case _ =>
      assign picked := ok
  end

function own_fits(
  s: State,
  ok: List[(Name * (List[Type] * Type)) * State]
): List[(Name * (List[Type] * Type)) * State] :=
  match ok
    case Nil => Nil
    case [((n, sc), u); rest] => if n.module == Some(s.module) then [((n, sc), u); own_fits(s, rest)] else own_fits(s, rest)
  end

// the candidates of cs that are instances of all of all, if specific, or of which all of all are instances
procedure most(
  in  cs: List[(Name * (List[Type] * Type)) * State],
      all: List[(Name * (List[Type] * Type)) * State],
      specific: Bool,
      s: State,
  out best: List[(Name * (List[Type] * Type)) * State]
) :=
  local rest: List[(Name * (List[Type] * Type)) * State], yes: Bool

  match cs
    case Nil =>
      assign best := Nil
    case [c; more] =>
      call most(in more, all, specific, s, out rest)
      call dominates(in fst_of(c), firsts(all), specific, s, out yes)
      if yes
        assign best := [c; rest]
      else
        assign best := rest
      end
  end

function fst_of[A, B](p: A * B): A :=
  match p
    case (a, _) => a
  end

procedure dominates(
  in  c: Name * (List[Type] * Type),
      ds: List[Name * (List[Type] * Type)],
      specific: Bool,
      s: State,
  out yes: Bool
) :=
  local related: Bool

  match ds
    case Nil =>
      assign yes := true
    case [d; rest] =>
      if d == c
        call dominates(in c, rest, specific, s, out yes)
      else
        call related_to(in c, d, specific, s, out related)
        if related
          call dominates(in c, rest, specific, s, out yes)
        else
          assign yes := false
        end
      end
  end

// c is an instance of d, if specific, or else d of c
procedure related_to(
  in  c: Name * (List[Type] * Type),
      d: Name * (List[Type] * Type),
      specific: Bool,
      s: State,
  out yes: Bool
) :=
  if specific
    call instance_of(in c, d, s, out yes)
  else
    call instance_of(in d, c, s, out yes)
  end

// the type of c, with its parameters fixed, is an instance of the scheme of d
procedure instance_of(in c: Name * (List[Type] * Type), d: Name * (List[Type] * Type), s: State, out yes: Bool) :=
  local u := s, failed: Option[TypeError] := None

  match (c, d)
    case ((_, (_, t)), (_, sc)) =>
      try
        call trial(in sc, t, ref u)
      catch
        case e =>
          assign failed := Some(e)
      end
  end

  assign yes := failed == None

function own[A](s: State, cs: List[Name * A]): List[Name * A] :=
  match cs
    case Nil => Nil
    case [(n, a); rest] => if n.module == Some(s.module) then [(n, a); own(s, rest)] else own(s, rest)
  end

procedure infer(in env: Env, expr: Expr, out e1: Expr, t: Type, ref s: State) :=
  local sc: List[Type] * Type, m: Name, x: Var, xs: List[Var], ys: List[Var], zs: List[Var], b: Expr, c: Expr, l: Expr, u: Type, w: Type,
    exprs: List[Expr], ts: List[Type], bs: List[Branch[Expr]], y: Stmt, inner: Env

  match expr
    case ELit(lit) =>
      assign e1 := expr, t := literal(lit)

    case EVar(Var(name, a)) =>
      call   normalize(in a, out w, ref s)
      call   use_name(in name, candidates(s, env, name), w, out x, ref s)
      call   readable(in env, name)
      assign e1 := EVar(x), t := x.typ

    case EApp(fun, args) =>
      call application(in env, fun, args, out e1, t, ref s)

    case ELam(bound, body) =>
      call   formals(in "formal", bound, out xs, ref s)
      call   infer(in bind(xs) ++ env, body, out b, u, ref s)
      assign e1 := ELam(xs, b), t := type_fun(types(xs), u)

    // the body sees the variables around it, but assigns only the outs and refs of the lambda
    case EProc(ins, outs, refs, stmt) =>
      call   unique(in "formal", names(ins ++ outs ++ refs))
      call   formals(in "formal", ins, out xs, ref s)
      call   formals(in "formal", outs, out ys, ref s)
      call   formals(in "formal", refs, out zs, ref s)
      assign inner := bind(xs) ++ unassigned(ys) ++ bind(zs) ++ env
      call   statement(in names(ys ++ zs), stmt, out y, ref inner, s)
      call   outputs(in unqualified("lambda"), ys, inner)
      assign e1 := EProc(xs, ys, zs, y), t := TProc(types(xs), types(ys), types(zs))

    case ELet(bound, body) =>
      call   formals(in "binding", firsts(bound), out xs, ref s)
      call   checks(in env, "the bindings", seconds(bound), types(xs), out exprs, ref s)
      call   solve(ref s)
      call   infer(in generalized(s, env, xs) ++ env, body, out b, u, ref s)
      assign e1 := ELet(zip(xs, exprs), b), t := u

    case EIte(cond, then_expr, else_expr) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      call   infer(in env, then_expr, out l, u, ref s)
      call   check(in env, else_expr, u, out b, ref s)
      assign e1 := EIte(c, l, b), t := u

    case ETuple(items) =>
      call   infers(in env, items, out exprs, ts, ref s)
      assign e1 := ETuple(exprs), t := TTuple(ts)

    // the exception, whose type must be known after checking, and the expression of any type
    case ERaise(expr, typ) =>
      call   infer(in env, expr, out c, u, ref s)
      call   normalize(in typ, out w, ref s)
      call   unify(in u, w, ref s)
      call   fresh(out t, ref s)
      assign e1 := ERaise(c, u)

    case EMatch(expr, cases) =>
      call   fresh(out t, ref s)
      call   infer(in env, expr, out c, u, ref s)
      call   expr_branches(in env, cases, u, t, out bs, ref s)
      call   solve(ref s)
      call   coverage(in s, u, [case_of(br) for br in bs])
      assign e1 := EMatch(c, bs)
  end

// overloaded names are resolved by their number of arguments and the types of the arguments and the result,
// where the arguments are inferred first
procedure application(in env: Env, f: Expr, args: List[Expr], out e1: Expr, t: Type, ref s: State) :=
  local cs: List[Name * (List[Type] * Type)], x: Var, f1: Expr, u: Type, w: Type, args1: List[Expr], ts: List[Type]

  match f
    case EVar(Var(Name(None, base), typ)) if size(base) > 1 and at(0, base) == '.' =>
      call field_access(in env, base, typ, args, out e1, t, ref s)

    case EVar(Var(name, typ)) =>
      assign cs := candidates(s, env, name)
      if size(cs) > 1
        call   infers(in env, args, out args1, ts, ref s)
        call   fresh(out t, ref s)
        call   normalize(in typ, out w, ref s)
        call   unify(in w, type_fun(ts, t), ref s)
        if with_arity(cs, size(args)) == Nil
          raise WrongArity(name, size(args))
        end

        call   use_name(in name, with_arity(cs, size(args)), w, out x, ref s)
        assign e1 := EApp(EVar(x), args1)
      else
        call   infer(in env, f, out f1, u, ref s)
        call   apply(in env, u, args, out args1, t, ref s)
        assign e1 := EApp(f1, args1)
      end
    case _ =>
      call   infer(in env, f, out f1, u, ref s)
      call   apply(in env, u, args, out args1, t, ref s)
      assign e1 := EApp(f1, args1)
  end

// e.f, which is the accessor T.f of the type T of e, of the module of T, and e with f := a, which is the updater T.f:=
// applied to e and a, where the accessors of all datatypes with the field are the candidates while T is not known
procedure field_access(in env: Env, f: Id, a: Type, args: List[Expr], out e1: Expr, t: Type, ref s: State) :=
  local arg1: Expr, u: Type, w: Type, rest1: List[Expr], us: List[Type], acc: Name, x: Var

  match args
    case [arg; rest] =>
      call   infer(in env, arg, out arg1, u, ref s)
      call   infers(in env, rest, out rest1, us, ref s)
      call   fresh(out t, ref s)
      call   normalize(in a, out w, ref s)
      call   unify(in w, type_fun([u; us], t), ref s)

      match zonk_type(s.sub, u)
        case TSort(Name(Some(m), base), _) =>
          assign acc := Name(Some(m), base ++ f)
          match schemes_of(s.sig, acc)
            case [sc] if is_visible(s, acc) =>
              call use(in acc, w, sc, out x, ref s)
            case _ =>
              raise UnknownField(acc)
          end
        case TMeta(_) =>
          match visible_accessors(s, accessors(s.sig, f, list(s.sig.named)))
            case Nil =>
              raise UnknownField(unqualified(f))
            case cs =>
              call use_name(in unqualified(f), cs, w, out x, ref s)
          end
        case v =>
          raise UnknownFieldType(f, v)
      end

      assign e1 := EApp(EVar(x), [arg1; rest1])
    case _ =>
      raise CountMismatch("the access ." ++ f, "arguments", 1, size(args))
  end

procedure apply(in env: Env, f: Type, args: List[Expr], out args1: List[Expr], r: Type, ref s: State) :=
  local ts: List[Type]

  call   fresh(out r, ref s)
  call   infers(in env, args, out args1, ts, ref s)
  call   unify(in f, type_fun(ts, r), ref s)

procedure check(in env: Env, expr: Expr, t: Type, out e1: Expr, ref s: State) :=
  local u: Type

  call   infer(in env, expr, out e1, u, ref s)
  call   unify(in u, t, ref s)

// the expressions of what, checked against the types ts, as many
procedure checks(in env: Env, what: Str, exprs: List[Expr], ts: List[Type], out es1: List[Expr], ref s: State) :=
  local e1: Expr, rest: List[Expr]

  match (exprs, ts)
    case ([e; more], [t; ts1]) =>
      call   check(in env, e, t, out e1, ref s)
      call   checks(in env, what, more, ts1, out rest, ref s)
      assign es1 := [e1; rest]
    case (Nil, Nil) =>
      assign es1 := Nil
    case _ =>
      raise CountMismatch(what, "values", size(ts), size(exprs))
  end

procedure infers(in env: Env, exprs: List[Expr], out es1: List[Expr], ts: List[Type], ref s: State) :=
  local e1: Expr, t: Type, rest: List[Expr], us: List[Type]

  match exprs
    case Nil =>
      assign es1 := Nil, ts := Nil
    case [e; more] =>
      call   infer(in env, e, out e1, t, ref s)
      call   infers(in env, more, out rest, us, ref s)
      assign es1 := [e1; rest], ts := [t; us]
  end

procedure expr_branches(
  in  env: Env,
      cases: List[Branch[Expr]],
      t: Type,
      r: Type,
  out cases1: List[Branch[Expr]],
  ref s: State
) :=
  local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Expr, rest: List[Branch[Expr]]

  match cases
    case Nil =>
      assign cases1 := Nil
    case [Branch(pat, g, body); more] =>
      call   pattern(in pat, t, out p1, xs, ref s)
      call   guard(in bind(xs) ++ env, g, out g1, ref s)
      call   check(in bind(xs) ++ env, body, r, out b1, ref s)
      call   expr_branches(in env, more, t, r, out rest, ref s)
      assign cases1 := [Branch(p1, g1, b1); rest]
  end

procedure guard(in env: Env, g: Option[Expr], out g1: Option[Expr], ref s: State) :=
  local e1: Expr

  match g
    case Some(e) =>
      call   check(in env, e, type_bool(), out e1, ref s)
      assign g1 := Some(e1)
    case None =>
      assign g1 := None
  end

// guarded cases neither cover values for exhaustiveness nor make later cases unreachable
procedure coverage(in s: State, t: Type, cs: List[Pat * Bool]) :=
  call reachable(in s, t, Nil, cs)
  match missing(s.sig, s.sub, [[p] for p in unguarded(cs)], [t])
    case Some([w; _]) =>
      raise NotExhaustive(w)
    case _ =>
      skip
  end

function unguarded(cs: List[Pat * Bool]): List[Pat] :=
  match cs
    case Nil => Nil
    case [(p, true); rest] => [p; unguarded(rest)]
    case [(_, false); rest] => unguarded(rest)
  end

procedure reachable(in s: State, t: Type, before: List[Pat], cs: List[Pat * Bool]) :=
  match cs
    case Nil =>
      skip
    case [(p, open); rest] =>
      if not useful(s.sig, s.sub, [[q] for q in before], [p], [t])
        raise Unreachable(p)
      end
      if open
        call reachable(in s, t, before ++ [p], rest)
      else
        call reachable(in s, t, before, rest)
      end
  end

procedure pattern(in pat: Pat, t: Type, out p1: Pat, xs: List[Var], ref s: State) :=
  call   binders(in pat, t, out p1, xs, ref s)
  call   unique(in "pattern variable", names(xs))

procedure binders(in pat: Pat, t: Type, out p1: Pat, xs: List[Var], ref s: State) :=
  local u: Type, m: List[Type * Type], qs: List[Pat], ts: List[Type], k: Name

  match pat
    case PWild =>
      assign p1 := pat, xs := Nil

    case PLit(lit) =>
      call   unify(in literal(lit), t, ref s)
      assign p1 := pat, xs := Nil

    case PVar(Var(name, typ)) =>
      if overloads(s, name, lambda k => is_constr(s.sig, k)) != Nil
        call binders(in PApp(name, Nil), t, out p1, xs, ref s)
      else
        call   normalize(in typ, out u, ref s)
        call   unify(in u, t, ref s)
        assign p1 := PVar(Var(name, u)), xs := [Var(name, u)]
      end

    case PApp(constr, pats) =>
      match overloads(s, constr, lambda k => is_constr(s.sig, k))
        case [k1] =>
          assign k := k1
        case Nil =>
          raise UnknownConstructor(constr)
        case ks =>
          call pattern_constructor(in constr, ks, size(pats), t, out k, ref s)
      end

      match constr_of(s.sig, k)
        case Some((ps, ks, r)) =>
          call   same_length(in "constructor " ++ k.base, "arguments", size(ks), size(pats))
          call   instance(in ps, out m, ref s)
          call   unify(in subst(r, m), t, ref s)
          call   binder_list(in pats, [subst(kt, m) for kt in ks], out qs, xs, ref s)
          assign p1 := PApp(k, qs)
        case None =>
          raise UnknownConstructor(constr)
      end

    case PTuple(pats) =>
      call   fresh_list(in pats, out ts, ref s)
      call   unify(in TTuple(ts), t, ref s)
      call   binder_list(in pats, ts, out qs, xs, ref s)
      assign p1 := PTuple(qs)
  end

// the one of the constructors ks with k arguments whose datatype fits t, where open uses are solved first if
// several fit, since the variables of the pattern need their types
procedure pattern_constructor(in n: Name, ks: List[Name], k: Int, t: Type, out c: Name, ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State]

  call trials(in results(s.sig, ks, k), t, s, out ok)
  if size(ok) > 1
    call solve(ref s)
    call trials(in results(s.sig, ks, k), t, s, out ok)
  end

  match (ok, own(s, firsts(ok)))
    case ([((c1, _), _)], _) =>
      assign c := c1
    case (Nil, _) =>
      raise NoOverload(n, zonk_type(s.sub, t))
    case (_, [(c1, _)]) =>
      assign c := c1
    case _ =>
      raise Ambiguous(n, firsts(ok))
  end

// the constructors of ks with k arguments, each with the scheme of its datatype
function results(sig: Sig, ks: List[Name], k: Int): List[Name * (List[Type] * Type)] :=
  match ks
    case Nil => Nil
    case [n; rest] =>
      match constr_of(sig, n)
        case Some((ps, args, r)) => if size(args) == k then [(n, (ps, r)); results(sig, rest, k)] else results(sig, rest, k)
        case None => results(sig, rest, k)
      end
  end

procedure binder_list(in pats: List[Pat], ts: List[Type], out qs: List[Pat], xs: List[Var], ref s: State) :=
  local q: Pat, ys: List[Var], rest: List[Pat], zs: List[Var]

  match (pats, ts)
    case ([p; more], [t; ts1]) =>
      call   binders(in p, t, out q, ys, ref s)
      call   binder_list(in more, ts1, out rest, zs, ref s)
      assign qs := [q; rest], xs := ys ++ zs
    case (Nil, Nil) =>
      assign qs := Nil, xs := Nil
    case _ =>
      raise CountMismatch("the pattern", "components", size(ts), size(pats))
  end

procedure variable(in env: Env, assignable: List[Name], x: Var, out y: Var, ref s: State) :=
  local u: Type

  match x
    case Var(name, typ) =>
      if not contains(name, assignable)
        raise NotAssignable(name)
      end
      match get(name, env)
        case Some(Local((_, t), _)) =>
          call   normalize(in typ, out u, ref s)
          call   unify(in t, u, ref s)
          assign y := Var(name, t)
        case None =>
          raise UnknownVariable(name)
      end
  end

procedure variables(in env: Env, assignable: List[Name], xs: List[Var], out ys: List[Var], ref s: State) :=
  local y: Var, rest: List[Var]

  match xs
    case Nil =>
      assign ys := Nil
    case [x; more] =>
      call   variable(in env, assignable, x, out y, ref s)
      call   variables(in env, assignable, more, out rest, ref s)
      assign ys := [y; rest]
  end

// env tells which variables are assigned on every path to x, and after it
procedure statement(in assignable: List[Name], x: Stmt, out y: Stmt, ref env: Env, s: State) :=
  local ys: List[Var], exprs: List[Expr], c: Expr, t: Type, u: Type, l: Stmt, r: Stmt, xs: List[Stmt], bs: List[Branch[Stmt]], hs: List[Handler],
    inner: Env, other: Env

  match x
    case SSkip =>
      assign y := x

    case SAssign(assignments) =>
      call   unique(in "assignment to", names(firsts(assignments)))
      call   variables(in env, assignable, firsts(assignments), out ys, ref s)
      call   checks(in env, "the assignment", seconds(assignments), types(ys), out exprs, ref s)
      assign y := SAssign(zip(ys, exprs)), env := assigned(env, names(ys))
    // the types of locals that are initialized at the start of the block may be inferred

    case SBlock(locals, stmts) =>
      call   untyped(in locals, initialized(stmts))
      call   formals(in "local", locals, out ys, ref s)
      assign inner := unassigned(ys) ++ env
      call   statements(in names(ys) ++ assignable, stmts, out xs, ref inner, s)
      assign y := SBlock(ys, xs), env := drop(size(ys), inner)

    case SIf(cond, then_stmt, else_stmt) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      assign other := env
      call   statement(in assignable, then_stmt, out l, ref env, s)
      call   statement(in assignable, else_stmt, out r, ref other, s)
      assign y := SIf(c, l, r), env := joined(env, other)

    case SWhile(cond, body) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      assign inner := env
      call   statement(in assignable, body, out l, ref inner, s)
      assign y := SWhile(c, l)

    // a procedure that a variable holds and the refs are read
    case SCall(proc, ins, outs, refs) =>
      call   call_proc(in env, assignable, proc, ins, outs, refs, out y, ref s)
      call   readables(in env, [proc; names(refs)])
      assign env := assigned(env, names(outs ++ refs))

    case SMatch(expr, cases) =>
      call   infer(in env, expr, out c, t, ref s)
      call   stmt_branches(in assignable, cases, t, out bs, ref env, s)
      call   solve(ref s)
      call   coverage(in s, t, [case_of(br) for br in bs])
      assign y := SMatch(c, bs)

    case SAssert(cond) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      assign y := SAssert(c)

      if c == ELit(VBool(false))
        assign env := unreachable(env)
      end

    case SRaise(expr, typ) =>
      call   infer(in env, expr, out c, t, ref s)
      call   normalize(in typ, out u, ref s)
      call   unify(in t, u, ref s)
      assign y := SRaise(c, t), env := unreachable(env)

    case STry(body, handlers) =>
      assign other := env
      call   statement(in assignable, body, out l, ref env, s)
      call   handler_list(in assignable, handlers, out hs, ref other, s)
      assign y := STry(l, hs), env := joined(env, other)
  end

// the variables that the leading assignments of a block assign one at a time, as local x := e does
function initialized(xs: List[Stmt]): List[Name] :=
  match xs
    case [SAssign([(x, _)]); rest] => [x.name; initialized(rest)]
    case _ => Nil
  end

// the locals without a type are initialized
procedure untyped(in xs: List[Var], inits: List[Name]) :=
  match xs
    case Nil =>
      skip
    case [Var(name, typ); rest] =>
      if holes(typ) and not contains(name, inits)
        raise MissingType(name)
      end

      call untyped(in rest, inits)
  end

procedure statements(in assignable: List[Name], xs: List[Stmt], out ys: List[Stmt], ref env: Env, s: State) :=
  local y: Stmt, rest: List[Stmt]

  match xs
    case Nil =>
      assign ys := Nil
    case [x; more] =>
      call   statement(in assignable, x, out y, ref env, s)
      call   statements(in assignable, more, out rest, ref env, s)
      assign ys := [y; rest]
  end

// the procedures of the program hide the builtin ones
// a variable of a procedure type hides the procedures of that name
procedure call_proc(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  match get(p, env)
    case Some(l) =>
      call call_variable(in env, assignable, p, l.scheme, ins, outs, refs, out y, ref s)
    case None =>
      call call_declared(in env, assignable, p, ins, outs, refs, out y, ref s)
  end

procedure call_variable(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      sc: List[Type] * Type,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  local x: Var, w: Type, is: List[Type], os: List[Type], rs: List[Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]

  call   fresh(out w, ref s)
  call   use(in p, w, sc, out x, ref s)
  call   fresh_list(in ins, out is, ref s)
  call   fresh_list(in outs, out os, ref s)
  call   fresh_list(in refs, out rs, ref s)
  call   unify(in x.typ, TProc(is, os, rs), ref s)
  call   unique(in "out or ref", names(outs ++ refs))
  call   checks(in env, "procedure " ++ p.base, ins, is, out ins1, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   unifies(in types(outs1 ++ refs1), os ++ rs, ref s)
  assign y := SCall(p, ins1, outs1, refs1)

procedure call_declared(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  match overloads(s, p, lambda q => is_proc(s.sig, q))
    case [q] =>
      call declared_call(in env, assignable, p, q, ins, outs, refs, out y, ref s)
    case Nil =>
      call declared_call(in env, assignable, p, p, ins, outs, refs, out y, ref s)
    case qs =>
      call overloaded_call(in env, assignable, p, qs, ins, outs, refs, out y, ref s)
  end

// a call of one of the procedures qs, by the types of its arguments, where the arguments are inferred first
procedure overloaded_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      qs: List[Name],
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  local ins1: List[Expr], is: List[Type], outs1: List[Var], refs1: List[Var], m: Name

  call   unique(in "out or ref", names(outs ++ refs))
  call   infers(in env, ins, out ins1, is, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   choose(in p, [(q, proc_scheme(s.sig, q)) for q in qs], TProc(is, types(outs1), types(refs1)), out m, ref s)
  assign y := SCall(m, ins1, outs1, refs1)

procedure declared_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      q: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  local m: List[Type * Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]

  match proc_of(s.sig, q)
    case Some((ps, is, os, rs)) =>
      call   instance(in ps, out m, ref s)
      call   same_length(in "procedure " ++ q.base, "ins", size(is), size(ins))
      call   same_length(in "procedure " ++ q.base, "outs", size(os), size(outs))
      call   same_length(in "procedure " ++ q.base, "refs", size(rs), size(refs))
      call   unique(in "out or ref", names(outs ++ refs))
      call   checks(in env, "procedure " ++ q.base, ins, [subst(t, m) for t in is], out ins1, ref s)
      call   variables(in env, assignable, outs, out outs1, ref s)
      call   variables(in env, assignable, refs, out refs1, ref s)
      call   unifies(in types(outs1 ++ refs1), [subst(t, m) for t in os ++ rs], ref s)
      assign y := SCall(q, ins1, outs1, refs1)
    case None =>
      raise UnknownProcedure(p)
  end

// env joins what the cases assign, where a match that no case fits raises
procedure stmt_branches(
  in  assignable: List[Name],
      cases: List[Branch[Stmt]],
      t: Type,
  out cases1: List[Branch[Stmt]],
  ref env: Env,
      s: State
) :=
  local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Branch[Stmt]], inner: Env

  match cases
    case Nil =>
      assign cases1 := Nil, env := unreachable(env)
    case [Branch(pat, g, body); more] =>
      call   pattern(in pat, t, out p1, xs, ref s)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out g1, ref s)
      call   statement(in assignable -- names(xs), body, out b1, ref inner, s)
      call   stmt_branches(in assignable, more, t, out rest, ref env, s)
      assign cases1 := [Branch(p1, g1, b1); rest], env := joined(drop(size(xs), inner), env)
  end

// handlers start from the variables before the try, which an exception restores
procedure handler_list(in assignable: List[Name], hs: List[Handler], out hs1: List[Handler], ref env: Env, s: State) :=
  local u: Type, p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Handler], inner: Env

  match hs
    case Nil =>
      assign hs1 := Nil, env := unreachable(env)
    case [Handler(typ, pat, g, body); more] =>
      call   normalize(in typ, out u, ref s)
      call   pattern(in pat, u, out p1, xs, ref s)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out g1, ref s)
      call   statement(in assignable -- names(xs), body, out b1, ref inner, s)
      call   handler_list(in assignable, more, out rest, ref env, s)
      assign hs1 := [Handler(u, p1, g1, b1); rest], env := joined(drop(size(xs), inner), env)
  end

procedure declare_name(in sig: Sig, n: Name) :=
  if is_fun(sig, n) or is_proc(sig, n) or is_constr(sig, n) or builtin_schemes(unqualified(n.base)) != Nil
    raise AlreadyDefined(n)
  end

// functions of the same name must differ in their number of arguments, while they may overload builtins
procedure overload(in sig: Sig, n: Name, k: Int) :=
  if is_proc(sig, n) or is_constr(sig, n) or has_arity(schemes_of(sig, n), k)
    raise AlreadyDefined(n)
  end

procedure declare_sort(in sig: Sig, n: Name) :=
  if n.base == "->" or is_alias(sig, n) or is_data(sig, n)
    raise SortDefined(n)
  end

procedure closed(in n: Name, ps: List[Id], ts: List[Type]) :=
  local undeclared := distinct([v for t in ts, v in free(t)]) -- params(ps)

  if undeclared != Nil
    raise UndeclaredParams(n, undeclared)
  end

// datatypes may be mutually recursive, so they are known before any sort is checked
procedure declare_datas(in cs: List[Id * Cmd], ref s: State) :=
  match cs
    case Nil =>
      skip
    case [(m, CData(name, params, _)); rest] =>
      assign s := enter(s, m)
      call   declare_sort(in s.sig, name)
      assign s := with_sig(s, with_data(s.sig, name, size(params)))
      call   declare_datas(in rest, ref s)
    case [_; rest] =>
      call declare_datas(in rest, ref s)
  end

procedure declare_sorts(in cs: List[Id * Cmd], ref s: State) :=
  local u: Type

  match cs
    case Nil =>
      skip
    case [(m, CSort(name, params, typ)); rest] =>
      assign s := enter(s, m)
      call   declare_sort(in s.sig, name)
      call   unique_ids(in "type parameter", params)
      call   known(in typ, name, out u, ref s)
      call   closed(in name, params, [u])
      assign s := with_sig(s, with_alias(s.sig, name, params, u))
      call   declare_sorts(in rest, ref s)
    case [_; rest] =>
      call declare_sorts(in rest, ref s)
  end

procedure declare_constrs(in cs: List[Id * Cmd], ref s: State) :=
  match cs
    case Nil =>
      skip
    case [(m, CData(n, params, constrs)); rest] =>
      assign s := enter(s, m)
      call   unique_ids(in "type parameter", params)
      assign s := with_sig(s, with_members(s.sig, n, [k.name for k in constrs]))
      call   declare_constructors(in n, params, constrs, ref s)
      call   declare_constrs(in rest, ref s)
    case [_; rest] =>
      call declare_constrs(in rest, ref s)
  end

procedure declare_constructors(in n: Name, ps: List[Id], ks: List[Constr], ref s: State) :=
  local ts: List[Type]

  match ks
    case Nil =>
      skip
    case [Constr(name, args); rest] =>
      call   declare_name(in s.sig, name)
      call   knowns(in args, name, out ts, ref s)
      call   closed(in n, ps, ts)
      assign s := with_sig(s, with_constr(s.sig, name, (params(ps), ts, TSort(n, params(ps)))))
      call   declare_constructors(in n, ps, rest, ref s)
  end

// the type of a function with several lists of parameters, which returns functions for all but the first
function curried(xss: List[List[Var]], r: Type): Type :=
  match xss
    case Nil => r
    case [xs; rest] => type_fun(types(xs), curried(rest, r))
  end

procedure signatures(in xss: List[List[Var]], out yss: List[List[Var]], ref s: State) :=
  local ys: List[Var], rest: List[List[Var]]

  match xss
    case Nil =>
      assign yss := Nil
    case [xs; more] =>
      call   signature(in xs, out ys, ref s)
      call   signatures(in more, out rest, ref s)
      assign yss := [ys; rest]
  end

procedure declare_funs(in cs: List[Id * Cmd], ref s: State) :=
  local xss: List[List[Var]], r: Type

  match cs
    case Nil =>
      skip
    case [(m, CFun(name, ps, formals, typ, _)); rest] =>
      assign s := enter(s, m)
      call   overload(in s.sig, name, size(first_list(formals)))
      call   unique_ids(in "type parameter", ps)
      call   unique(in "formal", names(concat(formals)))
      call   signatures(in formals, out xss, ref s)
      call   known(in typ, name, out r, ref s)
      call   closed(in name, ps, [curried(xss, r)])
      assign s := with_sig(s, with_fun(s.sig, name, (params(ps), curried(xss, r))))
      call   declare_funs(in rest, ref s)
    case [_; rest] =>
      call declare_funs(in rest, ref s)
  end

procedure declare_procs(in cs: List[Id * Cmd], ref s: State) :=
  local xs: List[Var], ts: List[Type]

  match cs
    case Nil =>
      skip
    case [(m, CProc(name, ps, ins, outs, refs, _)); rest] =>
      assign s := enter(s, m)
      call   declare_name(in s.sig, name)
      call   unique_ids(in "type parameter", ps)
      call   signature(in ins ++ outs ++ refs, out xs, ref s)
      assign ts := types(xs)
      call   closed(in name, ps, ts)
      assign s := with_sig(s, with_proc(s.sig, name, (params(ps), take(size(ins), ts), take(size(outs), drop(size(ins), ts)), drop(size(ins) + size(outs), ts))))
      call   declare_procs(in rest, ref s)
    case [_; rest] =>
      call declare_procs(in rest, ref s)
  end

// the elaborated command c
procedure command(in cmd: Cmd, out c1: Cmd, ref s: State) :=
  local xss: List[List[Var]], r: Type, b: Expr, t: Type, is: List[Var], os: List[Var], rs: List[Var], y: Stmt, env: Env

  match cmd
    case CFun(name, params, formals, typ, body) =>
      call   signatures(in formals, out xss, ref s)
      call   known(in typ, name, out r, ref s)
      call   check(in bind(concat(xss)), body, r, out b, ref s)
      assign c1 := CFun(name, params, xss, r, b)

    case CProc(name, params, ins, outs, refs, stmt) =>
      call   signature(in ins, out is, ref s)
      call   signature(in outs, out os, ref s)
      call   signature(in refs, out rs, ref s)
      assign env := bind(is) ++ unassigned(os) ++ bind(rs)
      call   statement(in names(os ++ rs), stmt, out y, ref env, s)
      call   outputs(in name, os, env)
      assign c1 := CProc(name, params, is, os, rs, y)

    case CTest(test_name, [], stmt) =>
      assign env := Nil
      call   statement(in Nil, stmt, out y, ref env, s)
      assign c1 := CTest(test_name, Nil, y)

    case CTest(test_name, _, _) =>
      raise TestParams(test_name)

    case _ =>
      assign c1 := cmd
  end

procedure commands(in cs: List[Id * Cmd], out cs1: List[Cmd], ref s: State) :=
  local c1: Cmd, c2: Cmd, rest: List[Cmd]

  match cs
    case Nil =>
      assign cs1 := Nil
    case [(m, c); more] =>
      assign s := enter(s, m)
      call   command(in c, out c1, ref s)
      call   settle(ref s)
      assign c2 := zonk_cmd(s, c1)
      match unknown_in_cmd(c2)
        case Some(t) =>
          raise UnknownException(t)
        case None =>
          skip
      end
      call   commands(in more, out rest, ref s)
      assign cs1 := [c2; rest]
  end

// tests are chosen by name
function block_names(cs: List[Id * Cmd]): List[Id] :=
  match cs
    case Nil => Nil
    case [(_, CTest(test_name, _, _)); more] => [test_name; block_names(more)]
    case [_; more] => block_names(more)
  end

// only abstract types declare equalities, since matching tells the values of other datatypes apart by their constructors,
// and the orders and equalities of exported datatypes are exported, since they change what the builtins do for importers
procedure check_orders(in cmds: List[Cmd], abstract: List[Name], hidden: Set[Name], hidden_sorts: List[Name]) :=
  match cmds
    case Nil =>
      skip
    case [c; rest] =>
      match (c, order_of(c))
        case (_, Some(("==", t))) if not contains(t, abstract) =>
          raise VisibleEquality(t)
        case (CFun(name, _, _, _, _), Some((_, t))) if contains(name, hidden) and not contains(t, hidden_sorts) =>
          raise UnexportedOrder(name, t)
        case _ =>
          call check_orders(in rest, abstract, hidden, hidden_sorts)
      end
  end

// the order and equality of the abstract types of ds that their modules do not declare, which raise Unordered for a type
// with an equality, and Incomparable for a type without, since the structure of an abstract type is no order
function synthesized(ds: List[Id * Cmd], cmds: List[Cmd], natives: List[Name]): List[Id * Cmd] :=
  [e for c in ds, e in synthesized_for(c, ordered(cmds, "compare") ++ natives, ordered(cmds, "=="))]

function synthesized_for(d: Id * Cmd, compares: List[Name], equalities: List[Name]): List[Id * Cmd] :=
  match d
    case (m, CAbstract(name, params)) =>
      if contains(name, compares) then
        Nil
      else if contains(name, equalities) then
        [(m, failing(name, params, "compare", type_int(), "Unordered"))]
      else
        [(m, failing(name, params, "compare", type_int(), "Incomparable")), (m, failing(name, params, "==", type_bool(), "Incomparable"))]
    case _ => Nil
  end

function failing(t: Name, ps: List[Id], op: Id, r: Type, e: Id): Cmd :=
  let a := TSort(t, params(ps)) in
    CFun(
      Name(t.module, t.base ++ "." ++ op),
      ps,
      [[Var(unqualified("a"), a), Var(unqualified("b"), a)]],
      r,
      ERaise(EApp(EVar(Var(Name(Some("prelude"), e), THole)), [ELit(VStr(format_name(t)))]), THole)
    )

// the commands of ds without signatures and abstract types, which only the checks of sections need
function definitions(ds: List[Id * Cmd]): List[Id * Cmd] :=
  match ds
    case Nil => Nil
    case [(_, CFunSig(_, _, _, _)); rest] => definitions(rest)
    case [(_, CProcSig(_, _, _, _, _)); rest] => definitions(rest)
    case [(_, CAbstract(_, _)); rest] => definitions(rest)
    case [d; rest] => [d; definitions(rest)]
  end

// the signatures and types of the builtin section of d as definitions to declare, whose definitions the interpreter and the
// runtime give, where a type is a datatype without constructors, whose values the interpreter and the runtime make
function natives(d: Mod): List[Id * Cmd] :=
  [(d.name, native(qualify(d.name, c))) for c in seconds(d.builtins)]

function native(cmd: Cmd): Cmd :=
  match cmd
    case CFunSig(name, params, formals, typ) => CFun(name, params, formals, typ, ELit(VUnit))
    case CProcSig(name, params, ins, outs, refs) => CProc(name, params, ins, outs, refs, SSkip)
    case CAbstract(name, params) => CData(name, params, Nil)
    case _ => cmd
  end

// the types of the builtin sections of ds, which the interpreter and the runtime order, equate, and show
function native_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case Nil => Nil
    case [(_, CData(name, _, _)); rest] => [name; native_types(rest)]
    case [_; rest] => native_types(rest)
  end

function qualified_name(cmd: Cmd): Name :=
  match cmd
    case CFun(name, _, _, _, _) => name
    case _ => unqualified("")
  end

function abstract_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case Nil => Nil
    case [(_, CAbstract(name, _)); rest] => [name; abstract_types(rest)]
    case [_; rest] => abstract_types(rest)
  end

// the declarations of an implementation section that the export section does not export, with the constructors and fields
// of abstract types
function private_names(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  [n for c in im, n in private_in(c, ex)]

function private_in(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CFun(name, _, _, _, _) => if exists(ex, lambda e => signs(e, name)) then Nil else [name]
    case CProc(name, _, _, _, _, _) => if exists(ex, lambda e => signs(e, name)) then Nil else [name]
    case CData(t, _, constrs) => if exists(ex, lambda e => abstracts(e, t)) then [k.name for k in constrs] else [t; [k.name for k in constrs]]
    case CSort(name, _, _) => [name]
    case _ => Nil
  end

// the sorts of an implementation section that the export section does not export, not even as abstract types
function private_sorts(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  [n for c in im, n in private_sort(c, ex)]

function private_sort(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CData(name, _, _) => if exists(ex, lambda e => abstracts(e, name)) then Nil else [name]
    case CSort(name, _, _) => [name]
    case _ => Nil
  end

function signs(e: Cmd, n: Name): Bool :=
  match e
    case CFunSig(name, _, _, _) => name == n
    case CProcSig(name, _, _, _, _) => name == n
    case _ => false
  end

function abstracts(e: Cmd, t: Name): Bool :=
  match e
    case CAbstract(name, _) => name == t
    case _ => false
  end

// the function n of k arguments, the procedure n, and the datatype n
function defines_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFun(name, _, formals, _, _) => name == n and size(first_list(formals)) == k
    case _ => false
  end

function defines_proc(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, _, _, _, _) => name == n
    case _ => false
  end

function defines_data(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CData(name, _, _) => name == n
    case _ => false
  end

function signs_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFunSig(name, _, formals, _) => name == n and size(first_list(formals)) == k
    case _ => false
  end

// the signatures of ex, each of which the implementation section im defines once and exactly as written
procedure check_signatures(in ex: List[Cmd], im: List[Cmd]) :=
  match ex
    case Nil =>
      skip

    case [CFunSig(name, params, formals, typ); rest] =>
      if exists(rest, lambda e => signs_fun(e, name, size(first_list(formals))))
        raise AlreadyDefined(name)
      end

      match [c for c in im if defines_fun(c, name, size(first_list(formals)))]
        case [CFun(_, ps1, xss1, r1, _)] =>
          if ps1 != params or xss1 != formals or r1 != typ
            raise SignatureMismatch(name)
          end
        case _ =>
          raise MissingDefinition(name)
      end

      call check_signatures(in rest, im)

    case [CProcSig(name, params, ins, outs, refs); rest] =>
      if exists(rest, lambda e => signs(e, name))
        raise AlreadyDefined(name)
      end

      match [c for c in im if defines_proc(c, name)]
        case [CProc(_, ps1, ins1, outs1, refs1, _)] =>
          if ps1 != params or ins1 != ins or outs1 != outs or refs1 != refs
            raise SignatureMismatch(name)
          end
        case _ =>
          raise MissingDefinition(name)
      end

      call check_signatures(in rest, im)

    case [CAbstract(name, params); rest] =>
      match [c for c in im if defines_data(c, name)]
        case [CData(_, ps1, _)] =>
          if ps1 != params
            raise SignatureMismatch(name)
          end
        case _ =>
          raise MissingDefinition(name)
      end

      call check_signatures(in rest, im)

    case [_; rest] =>
      call check_signatures(in rest, im)
  end

// a function of the implementation section that is exported is exported with each of its numbers of arguments
procedure check_arities(in im: List[Cmd], ex: List[Cmd]) :=
  match im
    case Nil =>
      skip
    case [CFun(name, _, formals, _, _); rest] =>
      if exists(ex, lambda e => signs(e, name)) and not exists(ex, lambda e => signs_fun(e, name, size(first_list(formals))))
        raise PartlyExported(name)
      end
      call check_arities(in rest, ex)
    case [_; rest] =>
      call check_arities(in rest, ex)
  end

// the types of the export section name only sorts that importers can name, not the private sorts of the module
procedure check_exposed(in m: Id, ex: List[Cmd], hidden_sorts: List[Name]) :=
  local found: List[Name]

  match ex
    case Nil =>
      skip
    case [c; rest] =>
      match exposed(c)
        case Some((n, ts)) =>
          assign found := [own_name(m, t) for u in ts, t in sorts_in(u) if contains(own_name(m, t), hidden_sorts)]
          match found
            case [t; _] =>
              raise PrivateType(n, t)
            case Nil =>
              skip
          end
        case None =>
          skip
      end
      call check_exposed(in m, rest, hidden_sorts)
  end

// a name as written in module m, where an unqualified name of a sort of m is one of its own
function own_name(m: Id, n: Name): Name :=
  if n.module == None then in_module(m, n) else n

// the declaration of an export section with the types that it shows to importers
function exposed(cmd: Cmd): Option[Name * List[Type]] :=
  match cmd
    case CFunSig(name, _, formals, typ) => Some((name, types(concat(formals)) ++ [typ]))
    case CProcSig(name, _, ins, outs, refs) => Some((name, types(ins ++ outs ++ refs)))
    case CData(name, _, constrs) => Some((name, [t for k in constrs, t in k.args]))
    case CSort(name, _, typ) => Some((name, [typ]))
    case _ => None
  end

// the sorts that t names, as written, unqualified or qualified
function sorts_in(t: Type): List[Name] :=
  match t
    case TSort(name, args) => [name; [u for a in args, u in sorts_in(a)]]
    case TFun(args, res) => [u for a in args ++ [res], u in sorts_in(a)]
    case TProc(ins, outs, refs) => [u for a in ins ++ outs ++ refs, u in sorts_in(a)]
    case TTuple(types) => [u for a in types, u in sorts_in(a)]
    case _ => Nil
  end

// the sections of the modules ds, with the declarations and sorts that the modules keep private, which are all of a module
// without an export section
procedure check_sections(in ds: List[Mod], out hidden: Set[Name], hidden_sorts: List[Name]) :=
  local ex: List[Cmd], im: List[Cmd], more: Set[Name], sorts: List[Name]

  match ds
    case Nil =>
      assign hidden := empty(), hidden_sorts := Nil
    case [d; rest] =>
      call check_sections(in rest, out more, sorts)

      assign ex := [qualify(d.name, c) for c in seconds(d.exported)], im := [qualify(d.name, c) for c in seconds(d.implemented)]
      call   check_signatures(in ex, im)
      call   check_arities(in im, ex)
      call   check_exposed(in d.name, ex, private_sorts(ex, im))
      assign hidden := more ++ set(private_names(ex, im)), hidden_sorts := private_sorts(ex, im) ++ sorts
  end

// the commands of the program with qualified names, where each module is checked once, after the modules it imports
procedure check_program(in source: Source, out q: Prog) :=
  local sig: Sig := empty(), imports: List[Id * List[Id]] := Nil, cmds: List[Cmd] := Nil

  try
    call check_units(in units(source.mods), ref sig, imports, cmds)
  catch
    case Located(Some(m), pos, error) if m == source.main =>
      raise Located(None, pos, error)
  end

  assign q := Prog(cmds)

procedure check_units(in us: List[List[Mod]], ref sig: Sig, imports: List[Id * List[Id]], cs: List[Cmd]) :=
  local checked: Checked

  match us
    case Nil =>
      skip
    case [ds; rest] =>
      call   check_unit(in ds, sig, imports, out checked)
      assign sig := union(sig, checked.sig), imports := imports ++ checked.imports, cs := cs ++ checked.cmds
      call   check_units(in rest, ref sig, imports, cs)
  end

// the modules ds, checked after the declarations before of the modules that imports lists, as the last of them, where the
// declarations that other modules keep private are unknown, since before has only their signatures
procedure check_unit(in ds: List[Mod], before: Sig, imports: List[Id * List[Id]], out checked: Checked) :=
  local own := [(d.name, all_imports(d)) for d in ds], main := last_mod(ds).name, placed := [p for d in ds, p in decls_of(d)], s: State,
    decls: List[Id * Cmd], cmds: List[Cmd], hidden: Set[Name], hidden_sorts: List[Name], extra: List[Id * Cmd], more: List[Cmd],
    builtins := [b for d in ds, b in natives(d)]

  assign s := State(before, empty(), 0, main, Nil, visibility(imports ++ own, main), Nil, empty()), decls := seconds(placed)
  call   each_placed(in declare_datas, placed, ref s)
  call   declare_datas(in builtins, ref s)
  call   each_placed(in declare_sorts, placed, ref s)
  call   each_placed(in declare_constrs, placed, ref s)
  call   each_placed(in declare_funs, placed, ref s)
  call   each_placed(in declare_procs, placed, ref s)
  call   declare_funs(in builtins, ref s)
  call   declare_procs(in builtins, ref s)
  call   check_sections(in ds, out hidden, hidden_sorts)
  call   unique_ids(in "declaration", block_names(decls))
  call   placed_commands(in placed_definitions(placed), out cmds, ref s)
  call   check_orders(in cmds, abstract_types(decls), hidden, hidden_sorts)
  assign extra := synthesized(decls, cmds, native_types(builtins))
  call   declare_funs(in extra, ref s)
  call   commands(in extra, out more, ref s)
  assign hidden := hidden ++ set([qualified_name(c) for c in more])
  assign checked := Checked(cmds ++ more, exported(restrict(s.sig, firsts(own)), hidden, set(hidden_sorts)), own)

// the commands of module d with qualified names, with the module of each, and their positions
function decls_of(d: Mod): List[Pos * (Id * Cmd)] :=
  [(position_of(pc), (d.name, qualify(d.name, command_of(pc)))) for pc in placed_of(d)]

function position_of(pc: Pos * Cmd): Pos :=
  match pc
    case (p, _) => p
  end

function command_of(pc: Pos * Cmd): Cmd :=
  match pc
    case (_, c) => c
  end

function placed_definitions(placed: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  match placed
    case Nil => Nil
    case [(p, d); rest] => if definitions([d]) == Nil then placed_definitions(rest) else [(p, d); placed_definitions(rest)]
  end

// the declarations of a phase, one by one, where an error is located at the declaration that raises it
procedure each_placed(in phase: (in List[Id * Cmd], ref State), placed: List[Pos * (Id * Cmd)], ref s: State) :=
  match placed
    case Nil =>
      skip
    case [(p, d); rest] =>
      try
        call phase(in [d], ref s)
      catch
        case e =>
          raise located(d, p, e)
      end

      call each_placed(in phase, rest, ref s)
  end

// the commands of the definitions, checked one by one, where an error is located at the definition that raises it
procedure placed_commands(in placed: List[Pos * (Id * Cmd)], out cmds: List[Cmd], ref s: State) :=
  local one: List[Cmd], rest: List[Cmd]

  match placed
    case Nil =>
      assign cmds := Nil
    case [(p, d); more] =>
      try
        call commands(in [d], out one, ref s)
      catch
        case e =>
          raise located(d, p, e)
      end

      call   placed_commands(in more, out rest, ref s)
      assign cmds := one ++ rest
  end

// the error e of declaration d of a module at position p, if the parser read it
function located(d: Id * Cmd, p: Pos, e: TypeError): TypeError :=
  match d
    case (m, _) => if p == Pos(0, 0) then e else Located(Some(m), p, e)
  end

// the units of the modules, in load order, each module on its own
function units(ds: List[Mod]): List[List[Mod]] :=
  [[d] for d in ds]

// the type of e without a program
procedure type_of(in expr: Expr, out t: Type) :=
  local s := start("main", Nil), e1: Expr, u: Type

  call   infer(in Nil, expr, out e1, u, ref s)
  call   settle(ref s)
  assign t := zonk_type(s.sub, u)

test inference() :=
  local t: Type

  call   type_of(in expr_app("<", [expr_int(1), expr_int(2)]), out t)
  assert t == type_bool()
  // let id = lambda x => x in (id(1), id(true))
  call   type_of(in ELet([(Var(unqualified("id"), THole), ELam([Var(unqualified("x"), THole)], expr_var("x")))], ETuple([expr_app("id", [expr_int(1)]), expr_app("id", [ELit(VBool(true))])])), out t)
  assert t == TTuple([type_int(), type_bool()])
  // lambda f => f(f)
  try
    call   type_of(in ELam([Var(unqualified("f"), THole)], expr_app("f", [expr_var("f")])), out t)
    assert false
  catch
    case InfiniteType(_, _) =>
      skip
  end
  try
    call   type_of(in expr_app("<", [expr_int(1), ELit(VBool(true))]), out t)
    assert false
  catch
    case CannotUnify(left, right) =>
      assert (left, right) == (type_int(), type_bool())
  end
  try
    call   type_of(in expr_app("x", Nil), out t)
    assert false
  catch
    case UnknownVariable(name) =>
      assert name == unqualified("x")
  end

test elaboration() :=
  local q: Prog

  call check_program(in with_lists([CTest("r", Nil, SBlock([Var(unqualified("n"), THole)], [SAssign([(Var(unqualified("n"), THole), expr_app("len", [expr_app("Cons", [expr_int(1), expr_var("Nil")])]))])]))]), out q)
  match q
    case Prog([_, CFun(_, _, _, _, EMatch(_, [Branch(pat, _, _); _])), CTest(_, Nil, SBlock(_, [SAssign([(_, EApp(EVar(Var(_, typ)), _))])]))]) =>
      // the constructor Nil is elaborated to a pattern of a constructor
      assert pat == PApp(nil_name(), Nil)
      assert typ == type_fun([type_list(type_int())], type_int())
    case _ =>
      assert false
  end

test coverage() :=
  local q: Prog

  try
    call   check_program(in with_lists([CFun(unqualified("f"), Nil, [[Var(unqualified("xs"), type_plain_list(type_int()))]], type_int(), EMatch(expr_var("xs"), [Branch(pat_var("Nil"), None, expr_int(0))]))]), out q)
    assert false
  catch
    case NotExhaustive(pat) =>
      assert pat == PApp(cons_name(), [PWild, PWild])
  end
  try
    call   check_program(in with_lists([CFun(unqualified("f"), Nil, [[Var(unqualified("xs"), type_plain_list(type_int()))]], type_int(), EMatch(expr_var("xs"), [Branch(PWild, None, expr_int(0)), Branch(pat_var("Nil"), None, expr_int(1))]))]), out q)
    assert false
  catch
    case Unreachable(pat) =>
      assert pat == PApp(nil_name(), Nil)
  end

test statements() :=
  local q: Prog

  // procedure inc(ref k: Int) := assign k := k + 1, called with an input
  try
    call check_program(in program_of(
        [
          CProc(unqualified("inc"), Nil, Nil, Nil, [Var(unqualified("k"), type_int())], SBlock(Nil, [SAssign([(Var(unqualified("k"), THole), expr_app("+", [expr_var("k"), expr_int(1)]))])])),
          CProc(unqualified("p"), Nil, [Var(unqualified("n"), type_int())], Nil, Nil, SBlock(Nil, [SCall(unqualified("inc"), Nil, Nil, [Var(unqualified("n"), THole)])]))
        ]
      ), out q)
    assert false
  catch
    case NotAssignable(name) =>
      assert name == unqualified("n")
  end
  try
    call   check_program(in with_lists([CTest("t", Nil, SBlock(Nil, [SRaise(expr_var("Nil"), THole)]))]), out q)
    assert false
  catch
    case UnknownException(TSort(Name(Some("list"), "List"), _)) =>
      skip
  end

// tests of overloading across modules

function unq(n: Id): Name :=
  unqualified(n)

function tsort(n: Id): Type :=
  TSort(unqualified(n), Nil)

function var_of(n: Id, t: Type): Var :=
  Var(unqualified(n), t)

function fun_cmd(n: Id, xs: List[Var], r: Type, b: Expr): Cmd :=
  CFun(unqualified(n), Nil, [xs], r, b)

// the modules bag and box, which both export a function size, a constructor Leaf, a procedure fill, and a field x,
// and that the program imports
function bags(): List[Mod] :=
  [
    Mod("bag", Nil, unplaced([
      CData(unq("Bag"), Nil, [Constr(unq("Bag"), [type_int()]), Constr(unq("Leaf"), [type_int()])]),
      CData(unq("Pt"), Nil, [Constr(unq("Pt"), [type_int()])]),
      fun_cmd("size", [var_of("b", tsort("Bag"))], type_int(), expr_int(1)),
      fun_cmd("compare", [var_of("a", tsort("Bag")), var_of("b", tsort("Bag"))], type_int(), expr_int(0)),
      fun_cmd("Pt.x", [var_of("p", tsort("Pt"))], type_int(), EMatch(expr_var("p"), [Branch(PApp(unq("Pt"), [pat_var("n")]), None, expr_var("n"))])),
      CProc(unq("fill"), Nil, Nil, [var_of("b", tsort("Bag"))], Nil, SAssign([(var_of("b", THole), expr_app("Bag", [expr_int(0)]))]))
    ]), Nil, Nil),
    Mod("box", Nil, unplaced([
      CData(unq("Box"), Nil, [Constr(unq("Box"), [type_str()]), Constr(unq("Leaf"), [type_str()])]),
      CData(unq("Qt"), Nil, [Constr(unq("Qt"), [type_str()])]),
      fun_cmd("size", [var_of("b", tsort("Box"))], type_int(), expr_int(2)),
      fun_cmd("Qt.x", [var_of("q", tsort("Qt"))], type_str(), EMatch(expr_var("q"), [Branch(PApp(unq("Qt"), [pat_var("s")]), None, expr_var("s"))])),
      CProc(unq("fill"), Nil, Nil, [var_of("b", tsort("Box"))], Nil, SAssign([(var_of("b", THole), expr_app("Box", [ELit(VStr(""))]))]))
    ]), Nil, Nil)
  ]

// the program of the commands cmds of the module main, which imports bag and box
function with_bags(cmds: List[Cmd]): Source :=
  Source([natives_prelude(); bags()] ++ [Mod("main", ["bag", "box"], Nil, Nil, unplaced(cmds))], "main")

function in_bag(n: Id): Name :=
  Name(Some("bag"), n)

function in_box(n: Id): Name :=
  Name(Some("box"), n)

// the body of the last function of the checked program with_bags([c])
procedure body_of(in cmd: Cmd, out b: Expr) :=
  local q: Prog

  call check_program(in with_bags([cmd]), out q)
  match reverse(q.cmds)
    case [CFun(_, _, _, _, body); _] =>
      assign b := body
    case _ =>
      assert false
  end

// size(Bag(1)) + size(Box("x"))
test by_arguments() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, type_int(), expr_app("+", [expr_app("size", [expr_app("Bag", [expr_int(1)])]), expr_app("size", [expr_app("Box", [ELit(VStr("x"))])])])), out b)
  match b
    case EApp(_, [EApp(EVar(Var(m, _)), _), EApp(EVar(Var(n, _)), _)]) =>
      assert (m, n) == (in_bag("size"), in_box("size"))
    case _ =>
      assert false
  end

// (lambda x => size(x))(Box("x")), where size(x) stays open until the lambda is applied
test deferred() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, type_int(), EApp(ELam([var_of("x", THole)], expr_app("size", [expr_var("x")])), [expr_app("Box", [ELit(VStr("x"))])])), out b)
  match b
    case EApp(ELam(_, EApp(EVar(Var(name, typ)), _)), _) =>
      assert name == in_box("size")
      assert typ == type_fun([TSort(in_box("Box"), Nil)], type_int())
    case _ =>
      assert false
  end

// size as a value of the declared result type Box -> Int
test by_result() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, type_fun([tsort("Box")], type_int()), expr_var("size")), out b)
  assert b == EVar(Var(in_box("size"), type_fun([TSort(in_box("Box"), Nil)], type_int())))

// Leaf("s") constructs a Box, and the case Leaf(n) of a Bag is of bag
test constructors() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, tsort("Box"), expr_app("Leaf", [ELit(VStr("s"))])), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == in_box("Leaf")
    case _ =>
      assert false
  end

  call body_of(in fun_cmd("g", [var_of("b", tsort("Bag"))], type_int(), EMatch(expr_var("b"), [Branch(PApp(unq("Leaf"), [pat_var("n")]), None, expr_var("n")), Branch(PApp(unq("Bag"), [pat_var("n")]), None, expr_var("n"))])), out b)
  match b
    case EMatch(_, [Branch(PApp(constr, _), _, _); _]) =>
      assert constr == in_bag("Leaf")
    case _ =>
      assert false
  end

// call fill(out b) for a local b: Box
test procedures() :=
  local q: Prog

  call check_program(in with_bags([CProc(unq("p"), Nil, Nil, Nil, Nil, SBlock([var_of("b", tsort("Box"))], [SCall(unq("fill"), Nil, [var_of("b", THole)], Nil)]))]), out q)
  match reverse(q.cmds)
    case [CProc(_, _, _, _, _, SBlock(_, [SCall(proc, _, _, _)])); _] =>
      assert proc == in_box("fill")
    case _ =>
      assert false
  end

// (lambda p => p.x)(Pt(3)), where the type of p is not known at the access
test fields() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, type_int(), EApp(ELam([var_of("p", THole)], expr_app(".x", [expr_var("p")])), [expr_app("Pt", [expr_int(3)])])), out b)
  match b
    case EApp(ELam(_, EApp(EVar(Var(name, _)), _)), _) =>
      assert name == in_bag("Pt.x")
    case _ =>
      assert false
  end

// compare of bags is that of bag, while == and compare of other types, also of type parameters, are the builtins
test builtins() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, type_int(), expr_app("compare", [expr_app("Bag", [expr_int(1)]), expr_app("Bag", [expr_int(2)])])), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == in_bag("compare")
    case _ =>
      assert false
  end

  call body_of(in fun_cmd("g", Nil, type_bool(), expr_app("==", [expr_int(1), expr_int(2)])), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == unq("==")
    case _ =>
      assert false
  end

  call body_of(in CFun(unq("h"), ["A"], [[var_of("x", TParam("A"))]], type_bool(), expr_app("==", [expr_var("x"), expr_var("x")])), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == unq("==")
    case _ =>
      assert false
  end

  // lambda x => x == x, of a type that nothing decides, compares by the builtin
  call body_of(in fun_cmd("k", Nil, type_bool(), ELet([(var_of("e", THole), ELam([var_of("x", THole)], expr_app("==", [expr_var("x"), expr_var("x")])))], ELit(VBool(true)))), out b)
  match b
    case ELet([(_, ELam(_, EApp(EVar(Var(name, _)), _)))], _) =>
      assert name == unq("==")
    case _ =>
      assert false
  end

// a local variable hides all declarations of its name
test locals() :=
  local b: Expr

  call body_of(in fun_cmd("f", [var_of("size", type_int())], type_int(), expr_var("size")), out b)
  assert b == EVar(Var(unq("size"), type_int()))

test errors() :=
  local b: Expr

  try
    call   body_of(in fun_cmd("f", Nil, type_int(), expr_app("size", [expr_int(1)])), out b)
    assert false
  catch
    case NoOverload(name, _) =>
      assert name == unq("size")
  end
  // let h := lambda x => size(x) in true, where nothing decides size
  try
    call   body_of(in fun_cmd("f", Nil, type_bool(), ELet([(var_of("h", THole), ELam([var_of("x", THole)], expr_app("size", [expr_var("x")])))], ELit(VBool(true)))), out b)
    assert false
  catch
    case Ambiguous(name, candidates) =>
      assert name == unq("size")
      assert size(candidates) == 2
  end
  try
    call   body_of(in fun_cmd("f", Nil, type_int(), expr_app("size", [expr_int(1), expr_int(2)])), out b)
    assert false
  catch
    case WrongArity(name, arity) =>
      assert (name, arity) == (unq("size"), 2)
  end
