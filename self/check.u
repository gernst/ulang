// the type checker of ulang, which checks and elaborates programs of self/syntax.u in signatures of self/sig.u,
// where the state is passed by reference, and errors are values of TypeError instead of messages,
// and which overloads names across modules: the declarations of a name in all visible modules are its candidates,
// and each use resolves to the one whose type fits, at once if only one fits, or else at the end of the command,
// when the uses that are still open are solved together

import "builtins.u"
import "defs.u"
import "format.u"
import "map.u"
import "set.u"
import "sig.u"
import "syntax.u"

export

data TypeError :=
  case UnknownSort(name: Name)
  case SortArity(name: Name, expected: Int, actual: Int)
  case SortDefined(name: Name)
  case MissingType(name: Name)
  case UndeclaredParams(name: Name, types: List[Type])
  case CannotUnify(left: Type, right: Type)
  case InfiniteType(meta: Type, typ: Type)
  case UnknownVariable(name: Name)
  case NoOverload(name: Name, typ: Type)
  case WrongArity(name: Name, arity: Int)
  case AlreadyDefined(name: Name)
  case Duplicate(what: Str, item: Str)
  case Ambiguous(name: Name, candidates: List[Name * (List[Type] * Type)])
  case UnknownField(name: Name)
  case UnknownFieldType(field: Id, typ: Type)
  case UnknownFieldOwner(field: Id)
  // a container of a generator whose type, which chooses the folds, is not known at the generator
  case UnknownContainer(typ: Type)
  // set(…), map(…), and array(…) build by the module of their name, which the module must import
  case FormImport(imported: Id)
  case CountMismatch(owner: Str, unit: Str, expected: Int, actual: Int)
  case UnknownConstructor(name: Name)
  case NotExhaustive(pat: Pat)
  case Unreachable(pat: Pat)
  case NotAssignable(name: Name)
  case UnknownProcedure(name: Name)
  case UnknownException(typ: Type)
  case TestParams(test_name: Id)
  case Unassigned(name: Name)
  case OutputUnassigned(output: Name, proc: Name)
  case MissingDefinition(name: Name)
  case SignatureMismatch(name: Name)
  case PartlyExported(name: Name)
  case PrivateType(name: Name, sort: Name)
  case VisibleEquality(sort: Name)
  case UnexportedOrder(fun: Name, sort: Name)
  // an error of the command at the position of an imported module, or of the main module for None
  case Located(module: Option[Id], pos: Pos, error: TypeError)

procedure check_program(in source: Source, out q: Prog)

implementation

// the types of unknowns by their index
type Subst :=
  Map[Int, Type]

type Env :=
  List[Name * Local]

data Local :=
  case Local(scheme: List[Type] * Type, assigned: Bool)

// a use of an overloaded name that more than one candidate fits, by the placeholder id that stands for it
data Pending :=
  case Pending(id: Name, name: Name, cands: List[Name * (List[Type] * Type)], typ: Type)

data State :=
  case State(sig: Sig, sub: Subst, count: Int, module: Id, visible: List[Id], table: List[Id * List[Id]], pending: List[Pending], chosen: Map[Name, Name])

// the constructor of a pattern, where literals count as constructors without arguments
data Head :=
  case HCon(constr: Name)
  case HLit(lit: Lit)

function with_sig(s: State, sig: Sig): State :=
  s with sig := sig

// the state for checking a declaration of module m, where the substitution starts empty and unknowns are numbered
// from 1 again, since unknowns do not outlive the command that introduces them
function enter(s: State, m: Id): State :=
  s with sub := empty(), count := 0, module := m, visible := sees(m, s.table), pending := list(), chosen := empty()

function sees(m: Id, vs: List[Id * List[Id]]): List[Id] :=
  value_or(get(m, vs), list(m))

function start(main: Id, vs: List[Id * List[Id]]): State :=
  State(empty(), empty(), 0, main, sees(main, vs), vs, list(), empty())

function in_module(m: Id, n: Name): Name :=
  Name(Some(m), n.base)

function qualify(m: Id, cmd: Cmd): Cmd :=
  match cmd
    case CSort(name, params, typ) =>
      CSort(in_module(m, name), params, typ)

    case CData(name, params, constrs) =>
      CData(in_module(m, name), params, list(for k in constrs yield qualify_constr(m, k)))

    case CFun(name, params, formals, typ, body) =>
      CFun(in_module(m, name), params, formals, typ, body)

    case CProc(name, params, ins, outs, refs, stmt) =>
      CProc(in_module(m, name), params, ins, outs, refs, stmt)

    case CFunSig(name, params, formals, typ) =>
      CFunSig(in_module(m, name), params, formals, typ)

    case CProcSig(name, params, ins, outs, refs) =>
      CProcSig(in_module(m, name), params, ins, outs, refs)

    case CAbstract(name, params) =>
      CAbstract(in_module(m, name), params)

    case _ =>
      cmd
  end

function qualify_constr(m: Id, k: Constr): Constr :=
  k with name := in_module(m, k.name)

// each module sees itself and its direct imports, which include the implicit ones, for the imports of each module
function visibility(imports: List[Id * List[Id]], main: Id): List[Id * List[Id]] :=
  list(for m in distinct(list(main) ++ firsts(imports)) yield (m, distinct(list(m) ++ imports_of(imports, m))))

function imports_of(imports: List[Id * List[Id]], m: Id): List[Id] :=
  value_or(get(m, imports), list())

// the declarations named n of a kind that the module sees, where its own declarations hide those of other modules
// and declared tells whether a name is a declaration of that kind
function visible_names(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := list(for d in names_of(s.sig, n.base) if declared(d)) in match n
    case Name(Some(_), _) =>
      if contains(n, ds) then list(n) else list()
    case Name(None, base) =>
      if contains(Name(Some(s.module), base), ds) then list(Name(Some(s.module), base)) else list(for d in ds if is_visible(s, d))
  end

// the declarations named n of a kind in all modules that the module sees, its own included, whose types decide
// among them
function overloads(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  match n
    case Name(Some(_), _) =>
      list(for d in names_of(s.sig, n.base) if declared(d) and d == n)
    case _ =>
      list(for d in names_of(s.sig, n.base) if declared(d) and is_visible(s, d))
  end

function is_visible(s: State, d: Name): Bool :=
  match d.module
    case Some(m) =>
      contains(m, s.visible)
    case None =>
      false
  end

function params(ps: List[Id]): List[Type] :=
  list(for p in ps yield TParam(p))

function literal(v: Lit): Type :=
  match v
    case LUnit =>
      TTuple(list())

    case LBool(_) =>
      type_bool()

    case LInt(_) =>
      type_int()

    case LStr(_) =>
      type_str()

    case LChar(_) =>
      type_char()
  end

function logic(): List[Type] * Type :=
  (list(), TFun(list(type_bool(), type_bool()), type_bool()))

// only what cannot be defined in the prelude, which are names without a module
function builtin_schemes(n: Name): List[List[Type] * Type] :=
  match n
    case Name(None, base) =>
      builtin_scheme(base)
    case _ =>
      list()
  end

function builtin_scheme(b: Id): List[List[Type] * Type] :=
  let a := TParam("A") in match b
    case "<" =>
      list((list(a), TFun(list(a, a), type_bool())))

    case "==" =>
      list((list(a), TFun(list(a, a), type_bool())))

    case "compare" =>
      list((list(a), TFun(list(a, a), type_int())))

    case "show" =>
      list((list(a), TFun(list(a), type_str())))

    case "and" =>
      list(logic())

    case "or" =>
      list(logic())

    case _ =>
      list()
  end

function is_meta(t: Type): Bool :=
  match t
    case TMeta(_) =>
      true
    case _ =>
      false
  end

// the Params and Metas in t
function free(t: Type): List[Type] :=
  match t
    case TParam(_) =>
      list(t)

    case TMeta(_) =>
      list(t)

    case THole =>
      list()

    case TSort(_, args) =>
      distinct(list(for a in args for v in free(a) yield v))

    case TFun(args, res) =>
      distinct(list(for a in args ++ list(res) for v in free(a) yield v))

    case TProc(ins, outs, refs) =>
      distinct(list(for a in ins ++ outs ++ refs for v in free(a) yield v))

    case TTuple(types) =>
      distinct(list(for a in types for v in free(a) yield v))
  end

function holes(t: Type): Bool :=
  match t
    case THole =>
      true

    case TSort(_, args) =>
      exists(args, holes)

    case TFun(args, res) =>
      exists(args, holes) or holes(res)

    case TProc(ins, outs, refs) =>
      exists(ins ++ outs ++ refs, holes)

    case TTuple(types) =>
      exists(types, holes)

    case _ =>
      false
  end

function subst(t: Type, m: List[Type * Type]): Type :=
  match t
    case TSort(name, args) =>
      TSort(name, list(for a in args yield subst(a, m)))

    case TFun(args, res) =>
      TFun(list(for a in args yield subst(a, m)), subst(res, m))

    case TProc(ins, outs, refs) =>
      TProc(list(for a in ins yield subst(a, m)), list(for a in outs yield subst(a, m)), list(for a in refs yield subst(a, m)))

    case TTuple(types) =>
      TTuple(list(for a in types yield subst(a, m)))

    case _ =>
      match get(t, m)
        case Some(u) =>
          u
        case None =>
          t
      end
  end

function resolve(su: Subst, t: Type): Type :=
  match t
    case TMeta(meta) =>
      match get(meta, su)
        case Some(u) =>
          resolve(su, u)
        case None =>
          t
      end

    case _ =>
      t
  end

function occurs(su: Subst, i: Int, t: Type): Bool :=
  match resolve(su, t)
    case TMeta(meta) =>
      i == meta

    case TSort(_, args) =>
      exists(args, lambda a => occurs(su, i, a))

    case TFun(args, res) =>
      exists(args, lambda a => occurs(su, i, a)) or occurs(su, i, res)

    case TProc(ins, outs, refs) =>
      exists(ins ++ outs ++ refs, lambda a => occurs(su, i, a))

    case TTuple(types) =>
      exists(types, lambda a => occurs(su, i, a))

    case _ =>
      false
  end

function constructor_scheme(k: List[Type] * List[Type] * Type): List[Type] * Type :=
  match k
    case (ps, ks, r) =>
      (ps, if ks == list() then r else TFun(ks, r))
  end

function constructor_of(sig: Sig, k: Name): List[Type] * Type :=
  match constr_of(sig, k)
    case Some(kc) =>
      constructor_scheme(kc)
    case None =>
      (list(), TTuple(list()))
  end

// the meanings of n with their names, where local variables hide functions, constructors, and builtins
function candidates(s: State, env: Env, n: Name): List[Name * (List[Type] * Type)] :=
  match get(n, env)
    case Some(l) =>
      list((n, l.scheme))
    case None =>
      list(for f in overloads(s, n, lambda f => is_fun(s.sig, f)) for sc in schemes_of(s.sig, f) yield (f, sc)) ++ list(for k in overloads(s, n, lambda k => is_constr(s.sig, k)) yield (k, constructor_of(s.sig, k))) ++ list(for p in overloads(s, n, lambda p => is_proc(s.sig, p)) yield (p, proc_scheme(s.sig, p))) ++ list(for sc in builtin_schemes(n) yield (n, sc))
  end

// a procedure is a value of its type (in A, out B, ref C)
function proc_scheme(sig: Sig, p: Name): List[Type] * Type :=
  match proc_of(sig, p)
    case Some((ps, is, os, rs)) =>
      (ps, TProc(is, os, rs))
    case None =>
      (list(), THole)
  end

function with_arity(cs: List[Name * (List[Type] * Type)], k: Int): List[Name * (List[Type] * Type)] :=
  list(for (n, (ps, t)) in cs if arity(t) == k)

function has_arity(scs: List[List[Type] * Type], k: Int): Bool :=
  exists(scs, lambda (_, t) => arity(t) == k)

function bind(xs: List[Var]): Env :=
  list(for x in xs yield (x.name, Local((list(), x.typ), true)))

function unassigned(xs: List[Var]): Env :=
  list(for x in xs yield (x.name, Local((list(), x.typ), false)))

// env after assignments to xs, which are the innermost variables of their names
function assigned(env: Env, xs: List[Name]): Env :=
  match (env, xs)
    case (_, list()) =>
      env

    case (list(), _) =>
      list()

    case (list((n, l); rest), _) =>
      if contains(n, xs) then list((n, l with assigned := true); assigned(rest, xs -- list(n))) else list((n, l); assigned(rest, xs))
  end

// the variables that both paths assign, where env and other have the same variables
function joined(env: Env, other: Env): Env :=
  match (env, other)
    case (list((n, l); rest), list((_, k); more)) =>
      list(
        (n, l with assigned := l.assigned and k.assigned); joined(rest, more))

    case _ =>
      list()
  end

// the variables after a raise, where no path continues, which joins with others as if it assigned all of them
function unreachable(env: Env): Env :=
  list(for (n, l) in env yield (n, l with assigned := true))

procedure readable(in env: Env, n: Name) :=
  match get(n, env)
    case Some(Local(_, false)) =>
      raise Unassigned(n)
    case _ =>
      skip
  end

procedure readables(in env: Env, ns: List[Name]) :=
  for n in ns do
    call readable(in env, n)
  end

// the outs os of procedure p must be assigned at the end of its body
procedure outputs(in p: Name, os: List[Var], env: Env) :=
  match os
    case list() =>
      skip

    case list(o; more) =>
      match get(o.name, env)
        case Some(Local(_, false)) =>
          raise OutputUnassigned(o.name, p)
        case _ =>
          skip
      end
      call outputs(in p, more, env)
  end

// the unknowns of the types of env, which a let cannot generalize
function fixed(su: Subst, env: Env): List[Type] :=
  list(for (_, Local((ps, t), _)) in env for a in free(zonk_type(su, t)) -- ps yield a)

function generalize(su: Subst, env: Env, t: Type): List[Type] * Type :=
  let fx := fixed(su, env), u := zonk_type(su, t) in (list(for m in free(u) if is_meta(m) and not contains(m, fx)), u)

// the unknowns of open uses of overloaded names stay fixed, too, since their declarations are not chosen yet
function generalized(s: State, env: Env, xs: List[Var]): Env :=
  let waiting := list(for p in s.pending yield (p.id, Local((list(), p.typ), true))) in list(for x in xs yield (x.name, Local(generalize(s.sub, waiting ++ env, x.typ), true)))

// the pattern of a case, and whether it has no guard, such that it may cover values
function case_of[A](b: Branch[A]): Pat * Bool :=
  match b
    case Branch(_, pat, guard, _) =>
      (pat, guard == None)
  end

function zonk_guard(s: State, g: Option[Expr]): Option[Expr] :=
  map_option(g, lambda e => zonk_expr(s, e))

function zonk_type(su: Subst, t: Type): Type :=
  match resolve(su, t)
    case TSort(name, args) =>
      TSort(name, list(for a in args yield zonk_type(su, a)))

    case TFun(args, res) =>
      TFun(list(for a in args yield zonk_type(su, a)), zonk_type(su, res))

    case TProc(ins, outs, refs) =>
      TProc(list(for a in ins yield zonk_type(su, a)), list(for a in outs yield zonk_type(su, a)), list(for a in refs yield zonk_type(su, a)))

    case TTuple(types) =>
      TTuple(list(for a in types yield zonk_type(su, a)))

    case u =>
      u
  end

// the declaration chosen for an overloaded name, which stands for it until the end of the command
function settled(s: State, n: Name): Name :=
  match n.module
    case Some("?") =>
      match get(n, s.chosen)
        case Some(m) =>
          m
        case None =>
          n
      end

    case _ =>
      n
  end

function zonk_var(s: State, x: Var): Var :=
  Var(settled(s, x.name), zonk_type(s.sub, x.typ))

function zonk_vars(s: State, xs: List[Var]): List[Var] :=
  list(for x in xs yield zonk_var(s, x))

function zonk_expr(s: State, expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(var) =>
      EVar(zonk_var(s, var))

    case EApp(fun, args) =>
      EApp(zonk_expr(s, fun), list(for a in args yield zonk_expr(s, a)))

    case EField(expr, field) =>
      EField(zonk_expr(s, expr), field)

    case EUpdate(expr, field, value) =>
      EUpdate(zonk_expr(s, expr), field, zonk_expr(s, value))

    case ELam(formals, body) =>
      ELam(zonk_vars(s, formals), zonk_expr(s, body))

    case EProc(ins, outs, refs, stmt) =>
      EProc(zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, stmt))

    case ELet(bindings, body) =>
      ELet(list(for p in bindings yield zonk_binding(s, p)), zonk_expr(s, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(zonk_expr(s, cond), zonk_expr(s, then_expr), zonk_expr(s, else_expr))

    case EMatch(expr, cases) =>
      EMatch(zonk_expr(s, expr), list(for b in cases yield zonk_expr_branch(s, b)))

    case ETuple(exprs) =>
      ETuple(list(for expr in exprs yield zonk_expr(s, expr)))

    case ERaise(expr, typ) =>
      ERaise(zonk_expr(s, expr), zonk_type(s.sub, typ))

    case EForm(_, _, _) =>
      expr

    case EFor(_, _, _, _) =>
      expr
  end

function zonk_binding(s: State, p: Var * Expr): Var * Expr :=
  match p
    case (x, e) =>
      (zonk_var(s, x), zonk_expr(s, e))
  end

function zonk_expr_branch(s: State, b: Branch[Expr]): Branch[Expr] :=
  match b
    case Branch(doc, pat, guard, body) =>
      Branch(doc, zonk_pat(s, pat), zonk_guard(s, guard), zonk_expr(s, body))
  end

function zonk_pat(s: State, pat: Pat): Pat :=
  match pat
    case PVar(var) =>
      PVar(zonk_var(s, var))

    case PApp(constr, pats) =>
      PApp(constr, list(for a in pats yield zonk_pat(s, a)))

    case PTuple(pats) =>
      PTuple(list(for q in pats yield zonk_pat(s, q)))

    case _ =>
      pat
  end

function zonk_stmt(s: State, x: Stmt): Stmt :=
  match x
    case SSkip =>
      x

    case SAssign(assignments) =>
      SAssign(list(for p in assignments yield zonk_binding(s, p)))

    case SBlock(locals, stmts) =>
      SBlock(zonk_vars(s, locals), list(for y in stmts yield zonk_stmt(s, y)))

    case SIf(cond, then_stmt, else_stmt) =>
      SIf(zonk_expr(s, cond), zonk_stmt(s, then_stmt), zonk_stmt(s, else_stmt))

    case SWhile(cond, body) =>
      SWhile(zonk_expr(s, cond), zonk_stmt(s, body))

    case SCall(proc, ins, outs, refs) =>
      SCall(settled(s, proc), list(for e in ins yield zonk_expr(s, e)), zonk_vars(s, outs), zonk_vars(s, refs))

    case SMatch(expr, cases) =>
      SMatch(zonk_expr(s, expr), list(for b in cases yield zonk_stmt_branch(s, b)))

    case SAssert(cond) =>
      SAssert(zonk_expr(s, cond))

    case SRaise(expr, typ) =>
      SRaise(zonk_expr(s, expr), zonk_type(s.sub, typ))

    case STry(body, handlers) =>
      STry(zonk_stmt(s, body), list(for h in handlers yield zonk_handler(s, h)))
  end

function zonk_stmt_branch(s: State, b: Branch[Stmt]): Branch[Stmt] :=
  match b
    case Branch(doc, pat, guard, body) =>
      Branch(doc, zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_handler(s: State, h: Handler): Handler :=
  match h
    case Handler(doc, typ, pat, guard, body) =>
      Handler(doc, zonk_type(s.sub, typ), zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_cmd(s: State, cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, body) =>
      CFun(name, params, zonk_vars(s, formals), zonk_type(s.sub, typ), zonk_expr(s, body))

    case CProc(name, params, ins, outs, refs, stmt) =>
      CProc(name, params, zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, stmt))

    case CTest(test_name, vars, stmt) =>
      CTest(test_name, vars, zonk_stmt(s, stmt))

    case _ =>
      cmd
  end

// exceptions are told apart by their types at runtime, which must therefore be known after checking
function unknown_type(t: Type): Option[Type] :=
  if free(t) == list() then None else Some(t)

// the type of an exception that is not known, also of those raised in expressions
function unknown_in(x: Stmt): Option[Type] :=
  match x
    case SAssign(assignments) =>
      unknown_in_exprs(seconds(assignments))

    case SBlock(_, stmts) =>
      unknown_in_all(stmts)

    case SIf(cond, then_stmt, else_stmt) =>
      or_else(unknown_in_expr(cond), or_else(unknown_in(then_stmt), unknown_in(else_stmt)))

    case SWhile(cond, body) =>
      or_else(unknown_in_expr(cond), unknown_in(body))

    case SCall(_, ins, _, _) =>
      unknown_in_exprs(ins)

    case SMatch(expr, cases) =>
      or_else(unknown_in_expr(expr), unknown_in_branches(cases))

    case SAssert(cond) =>
      unknown_in_expr(cond)

    case SRaise(expr, typ) =>
      or_else(unknown_type(typ), unknown_in_expr(expr))

    case STry(body, handlers) =>
      or_else(unknown_in(body), unknown_in_handlers(handlers))

    case _ =>
      None
  end

function unknown_in_expr(expr: Expr): Option[Type] :=
  match expr
    case ERaise(expr, typ) =>
      or_else(unknown_type(typ), unknown_in_expr(expr))

    case EApp(fun, args) =>
      unknown_in_exprs(list(fun; args))

    case EField(expr, _) =>
      unknown_in_expr(expr)

    case EUpdate(expr, _, value) =>
      unknown_in_exprs(list(expr, value))

    case ELam(_, body) =>
      unknown_in_expr(body)

    case EProc(_, _, _, stmt) =>
      unknown_in(stmt)

    case ELet(bindings, body) =>
      unknown_in_exprs(seconds(bindings) ++ list(body))

    case EIte(cond, then_expr, else_expr) =>
      unknown_in_exprs(list(cond, then_expr, else_expr))

    case EMatch(expr, cases) =>
      unknown_in_exprs(list(expr; list(for b in cases for e in branch_exprs(b) yield e)))

    case ETuple(exprs) =>
      unknown_in_exprs(exprs)

    case _ =>
      None
  end

function unknown_in_exprs(exprs: List[Expr]): Option[Type] :=
  find_map(exprs, unknown_in_expr)

function branch_exprs(b: Branch[Expr]): List[Expr] :=
  match b
    case Branch(_, _, Some(g), body) =>
      list(g, body)
    case Branch(_, _, None, body) =>
      list(body)
  end

function unknown_in_all(xs: List[Stmt]): Option[Type] :=
  find_map(xs, unknown_in)

function unknown_in_branches(bs: List[Branch[Stmt]]): Option[Type] :=
  find_map(bs, unknown_in_branch)

function unknown_in_branch(b: Branch[Stmt]): Option[Type] :=
  match b
    case Branch(_, _, guard, body) =>
      or_else(unknown_in_guard(guard), unknown_in(body))
  end

// handlers of _ catch exceptions of any type
function unknown_in_handlers(hs: List[Handler]): Option[Type] :=
  find_map(hs, unknown_in_handler)

function unknown_in_handler(h: Handler): Option[Type] :=
  match h
    case Handler(_, typ, pat, guard, body) =>
      let caught := if pat == PWild then None else unknown_type(typ) in or_else(caught, or_else(unknown_in_guard(guard), unknown_in(body)))
  end

function unknown_in_guard(guard: Option[Expr]): Option[Type] :=
  match guard
    case Some(g) =>
      unknown_in_expr(g)
    case None =>
      None
  end

function unknown_in_cmd(cmd: Cmd): Option[Type] :=
  match cmd
    case CFun(_, _, _, _, body) =>
      unknown_in_expr(body)

    case CProc(_, _, _, _, _, stmt) =>
      unknown_in(stmt)

    case CTest(_, _, stmt) =>
      unknown_in(stmt)

    case _ =>
      None
  end

function head_of(pat: Pat): Option[Head * List[Pat]] :=
  match pat
    case PApp(constr, pats) =>
      Some((HCon(constr), pats))

    case PTuple(pats) =>
      Some((HCon(tuple_name()), pats))

    case PLit(lit) =>
      Some((HLit(lit), list()))

    case _ =>
      None
  end

// the constructors in the first column
function heads(rows: List[List[Pat]]): List[Head] :=
  match rows
    case list() =>
      list()

    case list(list(p; _); rest) =>
      match head_of(p)
        case Some((h, _)) =>
          list(h; heads(rest))
        case None =>
          heads(rest)
      end

    case list(list(); rest) =>
      heads(rest)
  end

// the argument types of constructor k of a datatype with type arguments args
function field_types(sig: Sig, k: Name, args: List[Type]): List[Type] :=
  match constr_of(sig, k)
    case Some((ps, ks, _)) =>
      list(for a in ks yield subst(a, zip(ps, args)))
    case None =>
      list()
  end

// all constructors of t with their argument types, if there are finitely many
function constructors_of(sig: Sig, su: Subst, t: Type): Option[List[Head * List[Type]]] :=
  match zonk_type(su, t)
    case TSort(name, list()) if TSort(name, list()) == type_bool() =>
      Some(list((HLit(LBool(true)), list()), (HLit(LBool(false)), list())))

    case TTuple(types) =>
      Some(list((HCon(tuple_name()), types)))

    case TSort(name, args) =>
      match members_of(sig, name)
        case Some(ks) =>
          Some(list(for k in ks yield (HCon(k), field_types(sig, k, args))))
        case None =>
          None
      end

    case _ =>
      None
  end

function fields_of(sig: Sig, su: Subst, t: Type, h: Head): List[Type] :=
  match constructors_of(sig, su, t)
    case Some(ks) =>
      value_or(get(h, ks), list())
    case None =>
      list()
  end

function covers(hs: List[Head], ks: List[Head * List[Type]]): Bool :=
  forall(ks, lambda (h, _) => contains(h, hs))

// the rows whose first pattern has no constructor, without it
function defaults(rows: List[List[Pat]]): List[List[Pat]] :=
  match rows
    case list() =>
      list()

    case list(list(p; ps); rest) =>
      match head_of(p)
        case Some(_) =>
          defaults(rest)
        case None =>
          list(ps; defaults(rest))
      end

    case list(list(); rest) =>
      defaults(rest)
  end

function specialize(rows: List[List[Pat]], h: Head, n: Int): List[List[Pat]] :=
  match rows
    case list() =>
      list()

    case list(list(p; ps); rest) =>
      match head_of(p)
        case Some((g, args)) =>
          if g == h then list(args ++ ps; specialize(rest, h, n)) else specialize(rest, h, n)
        case None =>
          list(replicate(n, PWild) ++ ps; specialize(rest, h, n))
      end

    case list(list(); rest) =>
      specialize(rest, h, n)
  end

// some values of types ts match q but no row
function useful(sig: Sig, su: Subst, rows: List[List[Pat]], q: List[Pat], ts: List[Type]): Bool :=
  match (q, ts)
    case (list(), _) =>
      rows == list()

    case (list(p; ps), list(t; rest)) =>
      match head_of(p)
        case Some((h, args)) =>
          useful(sig, su, specialize(rows, h, size(args)), args ++ ps, fields_of(sig, su, t, h) ++ rest)

        case None =>
          match constructors_of(sig, su, t)
            case Some(ks) =>
              if covers(heads(rows), ks) then useful_in(sig, su, rows, ks, ps, rest) else useful(sig, su, defaults(rows), ps, rest)
            case None =>
              useful(sig, su, defaults(rows), ps, rest)
          end
      end

    case (list(_; _), list()) =>
      false
  end

function useful_in(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], pats: List[Pat], rest: List[Type]): Bool :=
  exists(ks, lambda (h, args) => useful(sig, su, specialize(rows, h, size(args)), replicate(size(args), PWild) ++ pats, args ++ rest))

function witness(h: Head, args: List[Pat]): Pat :=
  match h
    case HCon(constr) =>
      if constr == tuple_name() then PTuple(args) else PApp(constr, args)
    case HLit(lit) =>
      PLit(lit)
  end

// values of types ts, as patterns, that no row matches
function missing(sig: Sig, su: Subst, rows: List[List[Pat]], ts: List[Type]): Option[List[Pat]] :=
  match ts
    case list() =>
      if rows == list() then Some(list()) else None
    case list(t; rest) =>
      missing_in(sig, su, rows, heads(rows), constructors_of(sig, su, t), rest)
  end

// hs are the constructors in the first column, cs are all constructors of its type if there are finitely many
function missing_in(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match cs
    case Some(ks) =>
      if covers(hs, ks) then first_missing(sig, su, rows, ks, rest) else other_missing(sig, su, rows, hs, cs, rest)
    case None =>
      other_missing(sig, su, rows, hs, cs, rest)
  end

function first_missing(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], rest: List[Type]): Option[List[Pat]] :=
  match ks
    case list() =>
      None

    case list((h, args); more) =>
      match missing(sig, su, specialize(rows, h, size(args)), args ++ rest)
        case Some(ws) =>
          match split_at(size(args), ws)
            case (found, others) =>
              Some(list(witness(h, found); others))
          end

        case None =>
          first_missing(sig, su, rows, more, rest)
      end
  end

function other_missing(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match missing(sig, su, defaults(rows), rest)
    case Some(ws) =>
      Some(list(uncovered(hs, cs); ws))
    case None =>
      None
  end

// a value of the first column that hs do not cover
function uncovered(hs: List[Head], cs: Option[List[Head * List[Type]]]): Pat :=
  match cs
    case Some(ks) =>
      if hs == list() then PWild else first_uncovered(hs, ks)
    case None =>
      PWild
  end

function first_uncovered(hs: List[Head], ks: List[Head * List[Type]]): Pat :=
  match ks
    case list() =>
      PWild
    case list((h, args); rest) =>
      if contains(h, hs) then first_uncovered(hs, rest) else witness(h, replicate(size(args), PWild))
  end

procedure fresh(out t: Type, ref s: State) :=
  assign t := TMeta(s.count + 1), s := s with count := s.count + 1

procedure bind_meta(in i: Int, t: Type, ref s: State) :=
  if occurs(s.sub, i, t)
    raise InfiniteType(TMeta(i), zonk_type(s.sub, t))
  end
  assign s := s with sub := put(i, t, s.sub)

procedure unify(in t1: Type, t2: Type, ref s: State) :=
  local a := resolve(s.sub, t1), b := resolve(s.sub, t2)
  match (a, b)
    case (TMeta(i), TMeta(j)) =>
      if i != j
        call bind_meta(in i, b, ref s)
      end

    case (TMeta(meta), _) =>
      call bind_meta(in meta, b, ref s)

    case (_, TMeta(meta)) =>
      call bind_meta(in meta, a, ref s)

    case (TParam(x), TParam(y)) =>
      if x != y
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TSort(f, xs), TSort(g, ys)) =>
      if f == g and size(xs) == size(ys)
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TFun(xs, r1), TFun(ys, r2)) =>
      if size(xs) == size(ys)
        call unifies(in xs ++ list(r1), ys ++ list(r2), ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TTuple(xs), TTuple(ys)) =>
      if size(xs) == size(ys)
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TProc(xs, ys, zs), TProc(us, vs, ws)) =>
      if size(xs) == size(us) and size(ys) == size(vs) and size(zs) == size(ws)
        call unifies(in xs ++ ys ++ zs, us ++ vs ++ ws, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case _ =>
      raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
  end

procedure unifies(in xs: List[Type], ys: List[Type], ref s: State) :=
  match (xs, ys)
    case (list(x; xs1), list(y; ys1)) =>
      call unify(in x, y, ref s)
      call unifies(in xs1, ys1, ref s)

    case (list(), list()) =>
      skip

    case _ =>
      raise CountMismatch("", "values", size(xs), size(ys))
  end

procedure fresh_list[A](in xs: List[A], out ts: List[Type], ref s: State) :=
  local t: Type
  assign ts := list()
  for _ in xs do
    call   fresh(out t, ref s)
    assign ts := ts ++ list(t)
  end

procedure instance(in ps: List[Type], out m: List[Type * Type], ref s: State) :=
  local t: Type
  assign m := list()
  for p in ps do
    call   fresh(out t, ref s)
    assign m := m ++ list((p, t))
  end

procedure instantiate(in sc: List[Type] * Type, out t: Type, ref s: State) :=
  local m: List[Type * Type]
  match sc
    case (ps, u) =>
      call   instance(in ps, out m, ref s)
      assign t := subst(zonk_type(s.sub, u), m)
  end

// the names ns, which must be distinct, of what they are, e.g. formals
procedure unique(in what: Str, ns: List[Name]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(what, n.base)
    case None =>
      skip
  end

procedure unique_ids(in what: Str, ns: List[Id]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(what, n)
    case None =>
      skip
  end

// the number n of the units of owner, which expects m of them, e.g. the arguments of a constructor
procedure same_length(in owner: Str, unit: Str, m: Int, n: Int) :=
  if m != n
    raise CountMismatch(owner, unit, m, n)
  end

procedure arguments(in n: Name, k: Int, args: List[Type]) :=
  if size(args) != k
    raise SortArity(n, k, size(args))
  end

// expands type definitions and replaces holes by fresh unknowns
procedure normalize(in t: Type, out u: Type, ref s: State) :=
  local us: List[Type], v: Type
  match t
    case THole =>
      call fresh(out u, ref s)

    case TParam(_) =>
      assign u := t

    case TMeta(_) =>
      assign u := t

    case TFun(args, res) =>
      call   normalizes(in args, out us, ref s)
      call   normalize(in res, out v, ref s)
      assign u := TFun(us, v)

    case TTuple(types) =>
      call   normalizes(in types, out us, ref s)
      assign u := TTuple(us)

    case TProc(ins, outs, refs) =>
      call   normalizes(in ins ++ outs ++ refs, out us, ref s)
      assign u := match split_at(size(ins), us)
        case (in_types, others) =>
          match split_at(size(outs), others)
            case (out_types, ref_types) =>
              TProc(in_types, out_types, ref_types)
          end
      end

    case TSort(name, args) =>
      match visible_names(s, name, lambda t => is_sort(s.sig, t))
        case list(m) =>
          call normalize_sort(in m, args, out u, ref s)

        case list() =>
          raise UnknownSort(name)

        case ms =>
          raise Ambiguous(name, list(for m in ms yield (m, (list(), THole))))
      end
  end

procedure normalize_sort(
  in  n: Name,
      args: List[Type],
  out u: Type,
  ref s: State
) :=
  local us: List[Type]
  match data_of(s.sig, n)
    case Some(k) =>
      call   arguments(in n, k, args)
      call   normalizes(in args, out us, ref s)
      assign u := TSort(n, us)

    case None =>
      match alias_of(s.sig, n)
        case Some((ps, rhs)) =>
          call   arguments(in n, size(ps), args)
          call   normalizes(in args, out us, ref s)
          assign u := subst(rhs, zip(params(ps), us))

        case None =>
          raise UnknownSort(n)
      end
  end

procedure normalizes(in ts: List[Type], out us: List[Type], ref s: State) :=
  local u: Type
  assign us := list()
  for t in ts do
    call   normalize(in t, out u, ref s)
    assign us := us ++ list(u)
  end

procedure known(in t: Type, what: Name, out u: Type, ref s: State) :=
  if holes(t)
    raise MissingType(what)
  end
  call normalize(in t, out u, ref s)

procedure knowns(
  in  ts: List[Type],
      what: Name,
  out us: List[Type],
  ref s: State
) :=
  local u: Type
  assign us := list()
  for t in ts do
    call   known(in t, what, out u, ref s)
    assign us := us ++ list(u)
  end

// the variables of a lambda, a let, or locals, which are what, e.g. formals
procedure formals(in what: Str, xs: List[Var], out ys: List[Var], ref s: State) :=
  call unique(in what, list(for x in xs yield x.name))
  call normalize_vars(in xs, out ys, ref s)

procedure normalize_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  local u: Type
  assign ys := list()
  for Var(name, typ) in xs do
    call   normalize(in typ, out u, ref s)
    assign ys := ys ++ list(Var(name, u))
  end

// the parameters and locals, which have types
procedure signature(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call unique(in "formal", list(for x in xs yield x.name))
  call known_vars(in xs, out ys, ref s)

procedure known_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  local u: Type
  assign ys := list()
  for Var(name, typ) in xs do
    call   known(in typ, name, out u, ref s)
    assign ys := ys ++ list(Var(name, u))
  end

// a use of n elaborated with an instance of sc, where w is normalized
procedure use(
  in  n: Name,
      w: Type,
      sc: List[Type] * Type,
  out x: Var,
  ref s: State
) :=
  local u: Type
  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)
  assign x := Var(n, u)

// a use of n of type w, which is normalized, as the one of the candidates cs that fits w
procedure use_name(
  in  n: Name,
      cs: List[Name * (List[Type] * Type)],
      w: Type,
  out x: Var,
  ref s: State
) :=
  local m: Name
  match cs
    case list() =>
      raise UnknownVariable(n)

    case list((m1, sc)) =>
      call use(in m1, w, sc, out x, ref s)

    case _ =>
      call   choose(in n, cs, w, out m, ref s)
      assign x := Var(m, w)
  end

// the one of the candidates cs that fits w, or a placeholder for the use if several fit, which stays open
procedure choose(
  in  n: Name,
      cs: List[Name * (List[Type] * Type)],
      w: Type,
  out m: Name,
  ref s: State
) :=
  local ok: List[(Name * (List[Type] * Type)) * State], best: List[(Name * (List[Type] * Type)) * State]
  call trials(in cs, w, s, out ok)
  if size(ok) > 1 and known_type(s.sub, w)
    call   decide(in ok, w, s, out best)
    assign ok := best
  end
  match ok
    case list() =>
      raise NoOverload(n, zonk_type(s.sub, w))

    case list(((m1, _), s1)) =>
      assign m := m1, s := s1

    case _ =>
      assign m := Name(Some("?"), show(s.count + 1))
      assign s := s with count := s.count + 1, pending := s.pending ++ list(Pending(m, n, firsts(ok), w))
  end

// the candidates that fit w, each with the state after unifying its instance with w
procedure trials(
  in  cs: List[Name * (List[Type] * Type)],
      w: Type,
      s: State,
  out ok: List[(Name * (List[Type] * Type)) * State]
) :=
  local u: State, failed: Option[TypeError]
  assign ok := list()
  for (m, sc) in cs do
    assign u := s, failed := None
    try
      call trial(in sc, w, ref u)
    catch
      case e =>
        assign failed := Some(e)
    end
    if failed == None
      assign ok := ok ++ list(((m, sc), u))
    end
  end

procedure trial(in sc: List[Type] * Type, w: Type, ref s: State) :=
  local u: Type
  call instantiate(in sc, out u, ref s)
  call unify(in u, w, ref s)

// the open uses, until none can be decided, where each is decided once one of its candidates fits
procedure solve(ref s: State) :=
  local changed := true, ps: List[Pending]
  while changed
    assign ps := s.pending, changed := false
    assign s := s with pending := list()
    call   revisit(in ps, ref changed, s)
  end

procedure revisit(in ps: List[Pending], ref changed: Bool, s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State], best: List[(Name * (List[Type] * Type)) * State]
  match ps
    case list() =>
      skip

    case list(p; rest) =>
      call trials(in p.cands, p.typ, s, out ok)
      if size(ok) > 1 and known_type(s.sub, p.typ)
        call   decide(in ok, p.typ, s, out best)
        assign ok := best
      end
      match ok
        case list() =>
          raise NoOverload(p.name, zonk_type(s.sub, p.typ))

        case list(((m, _), s1)) =>
          assign s := s1 with chosen := put(p.id, m, s1.chosen)
          assign changed := true

        case _ =>
          assign s := s with pending := s.pending ++ list(p with cands := firsts(ok))
          if size(ok) < size(p.cands)
            assign changed := true
          end
      end
      call revisit(in rest, ref changed, s)
  end

// all uses decided at the end of a command, by the preferences of decide among the candidates that fit, and else by the one
// candidate after which the other open uses can still be decided, e.g. empty and put of map literals {k => v} when set and
// array are imported as well, where only the empty and the put of map fit together
procedure settle(ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State], best: List[(Name * (List[Type] * Type)) * State], states: List[State]
  call solve(ref s)
  while s.pending != list()
    match s.pending
      case list(p; rest) =>
        call trials(in p.cands, p.typ, s, out ok)
        call decide(in ok, p.typ, s, out best)
        match best
          case list(((m, _), s1)) =>
            assign s := s1 with pending := rest, chosen := put(p.id, m, s1.chosen)
            call   solve(ref s)

          case _ =>
            call viable(in best, p, rest, out states)
            match states
              case list(s2) =>
                assign s := s2
              case _ =>
                raise Ambiguous(p.name, p.cands)
            end
        end

      case list() =>
        skip
    end
  end

// the states after choosing each candidate of the use p, of those after which every open use of rest has a candidate that fits
procedure viable(
  in  cands: List[(Name * (List[Type] * Type)) * State],
      p: Pending,
      rest: List[Pending],
  out states: List[State]
) :=
  local t: State, failed: Bool
  assign states := list()
  for ((m, _), s1) in cands do
    assign t := s1 with pending := rest, chosen := put(p.id, m, s1.chosen)
    assign failed := false
    try
      call solve(ref t)
    catch
      case NoOverload(_, _) =>
        assign failed := true
    end
    if not failed
      assign states := states ++ list(t)
    end
  end

// the types of a use without unknowns, for which the candidates that fit stay the same
function known_type(su: Subst, t: Type): Bool :=
  list(for m in free(zonk_type(su, t)) if is_meta(m)) == list()

// among several candidates that fit w, the most specific, which is an instance of all others, if the type of the use
// is known, and the most general otherwise, of which all others are instances, such that builtins like == serve
// when no declaration for a type fits, and else the one declared by the module itself, or all if none of these is unique
procedure decide(
  in  ok: List[(Name * (List[Type] * Type)) * State],
      w: Type,
      s: State,
  out picked: List[(Name * (List[Type] * Type)) * State]
) :=
  local best: List[(Name * (List[Type] * Type)) * State]
  call most(in ok, ok, known_type(s.sub, w), s, out best)
  match (best, own_fits(s, ok))
    case (list(b), _) =>
      assign picked := list(b)

    case (_, list(o)) =>
      assign picked := list(o)

    case _ =>
      assign picked := ok
  end

function own_fits(s: State, ok: List[(Name * (List[Type] * Type)) * State]): List[(Name * (List[Type] * Type)) * State] :=
  list(for ((n, sc), u) in ok if n.module == Some(s.module))

// the candidates of cs that are instances of all of all, if specific, or of which all of all are instances
procedure most(
  in  cs: List[(Name * (List[Type] * Type)) * State],
      all: List[(Name * (List[Type] * Type)) * State],
      specific: Bool,
      s: State,
  out best: List[(Name * (List[Type] * Type)) * State]
) :=
  local yes: Bool
  assign best := list()
  for c in cs do
    call dominates(in first(c), firsts(all), specific, s, out yes)
    if yes
      assign best := best ++ list(c)
    end
  end

procedure dominates(
  in  c: Name * (List[Type] * Type),
      ds: List[Name * (List[Type] * Type)],
      specific: Bool,
      s: State,
  out yes: Bool
) :=
  local related: Bool
  match ds
    case list() =>
      assign yes := true

    case list(d; rest) =>
      if d == c
        call dominates(in c, rest, specific, s, out yes)
      else
        call related_to(in c, d, specific, s, out related)
        if related
          call dominates(in c, rest, specific, s, out yes)
        else
          assign yes := false
        end
      end
  end

// c is an instance of d, if specific, or else d of c
procedure related_to(
  in  c: Name * (List[Type] * Type),
      d: Name * (List[Type] * Type),
      specific: Bool,
      s: State,
  out yes: Bool
) :=
  if specific
    call instance_of(in c, d, s, out yes)
  else
    call instance_of(in d, c, s, out yes)
  end

// the type of c, with its parameters fixed, is an instance of the scheme of d
procedure instance_of(
  in  c: Name * (List[Type] * Type),
      d: Name * (List[Type] * Type),
      s: State,
  out yes: Bool
) :=
  local u := s, failed: Option[TypeError] := None
  match (c, d)
    case ((_, (_, t)), (_, sc)) =>
      try
        call trial(in sc, t, ref u)
      catch
        case e =>
          assign failed := Some(e)
      end
  end
  assign yes := failed == None

function own[A](s: State, cs: List[Name * A]): List[Name * A] :=
  list(for (n, a) in cs if n.module == Some(s.module))

procedure infer(in env: Env, expr: Expr, out e1: Expr, t: Type, ref s: State) :=
  local sc: List[Type] * Type, m: Name, x: Var, xs: List[Var], ys: List[Var], zs: List[Var], b: Expr, c: Expr, l: Expr, u: Type, w: Type, exprs: List[Expr], ts: List[Type], bs: List[Branch[Expr]], y: Stmt, inner: Env
  match expr
    case ELit(lit) =>
      assign e1 := expr, t := literal(lit)

    case EVar(Var(name, a)) =>
      call   normalize(in a, out w, ref s)
      call   use_name(in name, candidates(s, env, name), w, out x, ref s)
      call   readable(in env, name)
      assign e1 := EVar(x), t := x.typ

    case EApp(fun, args) =>
      call application(in env, fun, args, out e1, t, ref s)

    case EField(expr, field) =>
      call field_access(in env, "." ++ field, expr, list(), out e1, t, ref s)

    case EUpdate(expr, field, value) =>
      call field_access(in env, "." ++ field ++ ":=", expr, list(value), out e1, t, ref s)

    case ELam(bound, body) =>
      call   formals(in "formal", bound, out xs, ref s)
      call   infer(in bind(xs) ++ env, body, out b, u, ref s)
      assign e1 := ELam(xs, b), t := TFun(list(for x in xs yield x.typ), u)

    // the body sees the variables around it, but assigns only the outs and refs of the lambda
    case EProc(ins, outs, refs, stmt) =>
      call   unique(in "formal", list(for x in ins ++ outs ++ refs yield x.name))
      call   formals(in "formal", ins, out xs, ref s)
      call   formals(in "formal", outs, out ys, ref s)
      call   formals(in "formal", refs, out zs, ref s)
      assign inner := bind(xs) ++ unassigned(ys) ++ bind(zs) ++ env
      call   statement(in list(for x in ys ++ zs yield x.name), stmt, out y, ref inner, s)
      call   outputs(in unqualified("lambda"), ys, inner)
      assign e1 := EProc(xs, ys, zs, y), t := TProc(list(for x in xs yield x.typ), list(for x in ys yield x.typ), list(for x in zs yield x.typ))

    case ELet(bound, body) =>
      call   formals(in "binding", firsts(bound), out xs, ref s)
      call   checks(in env, "the bindings", seconds(bound), list(for x in xs yield x.typ), out exprs, ref s)
      call   solve(ref s)
      call   infer(in generalized(s, env, xs) ++ env, body, out b, u, ref s)
      assign e1 := ELet(zip(xs, exprs), b), t := u

    case EIte(cond, then_expr, else_expr) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      call   infer(in env, then_expr, out l, u, ref s)
      call   check(in env, else_expr, u, out b, ref s)
      assign e1 := EIte(c, l, b), t := u

    case ETuple(items) =>
      call   infers(in env, items, out exprs, ts, ref s)
      assign e1 := ETuple(exprs), t := TTuple(ts)

    // the exception, whose type must be known after checking, and the expression of any type
    case ERaise(expr, typ) =>
      call   infer(in env, expr, out c, u, ref s)
      call   normalize(in typ, out w, ref s)
      call   unify(in u, w, ref s)
      call   fresh(out t, ref s)
      assign e1 := ERaise(c, u)

    case EMatch(expr, cases) =>
      call   fresh(out t, ref s)
      call   infer(in env, expr, out c, u, ref s)
      call   expr_branches(in env, cases, u, t, out bs, ref s)
      call   solve(ref s)
      call   coverage(in s, u, list(for br in bs yield case_of(br)))
      assign e1 := EMatch(c, bs)

    // forms as the builders of the module of their name, and their generators as the folds of the modules of the
    // containers, which the checked program keeps
    case EForm(form, elems, rest) =>
      call form_import(in form, s)
      call infer(in env, form_expr(form, elems, rest), out e1, t, ref s)

    case EFor(FormArray, gens, elem, None) =>
      call form_import(in FormArray, s)
      call infer(in env, EApp(EVar(Var(Name(Some("array"), "from_list"), THole)), list(EFor(FormList, gens, elem, None))), out e1, t, ref s)

    case EFor(form, list(), elem, rest) =>
      call form_import(in form, s)
      call infer(in env, step_expr(form, elem, base_expr(form, rest)), out e1, t, ref s)

    case EFor(form, list(GIf(cond); more), elem, rest) =>
      call infer(in env, EIte(cond, EFor(form, more, elem, rest), base_expr(form, rest)), out e1, t, ref s)

    case EFor(form, list(g; more), elem, rest) =>
      call generator(in env, form, g, more, elem, rest, out e1, t, ref s)
  end

procedure form_import(in form: Form, s: State) :=
  match form_module(form)
    case Some(m) if not contains(m, s.visible) =>
      raise FormImport(m)
    case _ =>
      skip
  end

// the fold of the module of the type of the container of generator g, which must be known after the container, applied to
// the container, the base of the form, and the function of a step, whose body adds the elements of the generators after g
procedure generator(
  in  env: Env,
      form: Form,
      g: Gen,
      more: List[Gen],
      elem: Elem,
      rest: Option[Expr],
  out e1: Expr,
      t: Type,
  ref s: State
) :=
  local c: Expr, u: Type, f1: Expr, x: Var
  call   infer(in env, gen_container(g), out c, u, ref s)
  call   solve(ref s)
  assign x := Var(unqualified("(container)"), u)
  match zonk_type(s.sub, u)
    case TSort(Name(Some(m), _), targs) =>
      call infer(in bind(list(x)) ++ env, fold_expr(form, m, targs, g, EVar(x), EFor(form, more, elem, Some(EVar(form_acc()))), base_expr(form, rest)), out f1, t, ref s)
    case v =>
      raise UnknownContainer(v)
  end
  match f1
    case EApp(f, list(_; args)) =>
      assign e1 := EApp(f, list(c; args))
    case _ =>
      assign e1 := f1
  end

function form_module(form: Form): Option[Id] :=
  match form
    case FormList =>
      None

    case FormSet =>
      Some("set")

    case FormMap =>
      Some("map")

    case FormArray =>
      Some("array")
  end

function form_app(m: Id, f: Id, args: List[Expr]): Expr :=
  EApp(EVar(Var(Name(Some(m), f), THole)), args)

// the accumulator of the folds, which users cannot name
function form_acc(): Var :=
  Var(unqualified("(acc)"), THole)

// the container that a form adds its elements to, its rest or else the empty one
function base_expr(form: Form, rest: Option[Expr]): Expr :=
  match (rest, form)
    case (Some(r), _) =>
      r

    case (None, FormList) =>
      EVar(Var(nil_name(), THole))

    case (None, FormSet) =>
      form_app("set", "empty", list())

    case (None, _) =>
      form_app("map", "empty", list())
  end

// base with elem added, which comes first in a list, and whose key counts in a map
function step_expr(form: Form, elem: Elem, base: Expr): Expr :=
  match (form, elem)
    case (FormMap, Entry(k, v)) =>
      form_app("map", "put", list(k, v, base))

    case (FormMap, Elem(e)) =>
      form_app("map", "put", list(
        EApp(EVar(Var(Name(Some("prelude"), "first"), THole)), list(e)),
        EApp(EVar(Var(Name(Some("prelude"), "second"), THole)), list(e)),
        base))

    case (FormSet, Elem(e)) =>
      form_app("set", "insert", list(e, base))

    case (_, Elem(e)) =>
      EApp(EVar(Var(cons_name(), THole)), list(e, base))

    case (_, Entry(k, v)) =>
      EApp(EVar(Var(cons_name(), THole)), list(ETuple(list(k, v)), base))
  end

// list(a, b; r) is Cons(a, Cons(b, r)), set(a, b; r) is insert(a, insert(b, r)), map(k => v, l => w; r) is
// put(l, w, put(k, v, r)), so that the last entry of a key counts, and array(a, b) is from_list(list(a, b))
function form_expr(form: Form, elems: List[Elem], rest: Option[Expr]): Expr :=
  match form
    case FormArray =>
      form_app("array", "from_list", list(form_expr(FormList, elems, None)))

    case FormMap =>
      foldl(elems, base_expr(form, rest), lambda acc, e => step_expr(form, e, acc))

    case _ =>
      foldr(elems, base_expr(form, rest), lambda e, acc => step_expr(form, e, acc))
  end

function gen_container(g: Gen): Expr :=
  match g
    case GFor(_, c) =>
      c

    case GEntries(_, _, c) =>
      c

    case GIf(c) =>
      c
  end

// the fold of module m over container c into base, by foldr for lists, so that prepending keeps the order, and else by foldl,
// so that the steps run in the order of the generators, whose function binds the pattern of g and computes body, where a
// pattern that is no variable is matched, and the fold of a map takes key and value
function fold_expr(form: Form, m: Id, targs: List[Type], g: Gen, c: Expr, body: Expr, base: Expr): Expr :=
  let fold := (if form == FormList then "foldr" else "foldl"), acc := form_acc() in match g
    case GEntries(k, v, _) =>
      let kx := formal_of(k, "(key)", key_type(targs)), vx := formal_of(v, "(value)", value_type(targs)) in form_app(m, fold, list(
        c,
        base,
        ELam(if fold == "foldr" then list(kx, vx, acc) else list(acc, kx, vx), matched(list((kx, k), (vx, v)), body))))

    case GFor(p, _) if m == "map" =>
      let kx := Var(unqualified("(key)"), key_type(targs)), vx := Var(unqualified("(value)"), value_type(targs)) in form_app(m, fold, list(
        c,
        base,
        ELam(if fold == "foldr" then list(kx, vx, acc) else list(acc, kx, vx), EMatch(ETuple(list(EVar(kx), EVar(vx))), list(Branch("", p, None, body))))))

    case GFor(p, _) =>
      let x := formal_of(p, "(element)", key_type(targs)) in form_app(m, fold, list(
        c,
        base,
        ELam(if fold == "foldr" then list(x, acc) else list(acc, x), matched(list((x, p)), body))))

    case GIf(_) =>
      body
  end

// the types of the first and second type argument of a container, which are those of the elements, or keys and values
function key_type(targs: List[Type]): Type :=
  match targs
    case list(t; _) =>
      t
    case list() =>
      THole
  end

function value_type(targs: List[Type]): Type :=
  match targs
    case list(_, t; _) =>
      t
    case _ =>
      THole
  end

// the variable of a pattern that is one, and else a formal that users cannot name
function formal_of(p: Pat, name: Id, typ: Type): Var :=
  match p
    case PVar(x) =>
      Var(x.name, typ)
    case _ =>
      Var(unqualified(name), typ)
  end

// body under a match of the formals against the patterns that are not variables
function matched(pairs: List[Var * Pat], body: Expr): Expr :=
  match list(for q in pairs if not is_pvar(second(q)))
    case list() =>
      body

    case list((x, p)) =>
      EMatch(EVar(x), list(Branch("", p, None, body)))

    case ps =>
      EMatch(ETuple(list(for q in ps yield EVar(first(q)))), list(Branch("", PTuple(seconds(ps)), None, body)))
  end

function is_pvar(p: Pat): Bool :=
  match p
    case PVar(_) =>
      true
    case _ =>
      false
  end

// overloaded names are resolved by their number of arguments and the types of the arguments and the result,
// where the arguments are inferred first
procedure application(
  in  env: Env,
      f: Expr,
      args: List[Expr],
  out e1: Expr,
      t: Type,
  ref s: State
) :=
  local cs: List[Name * (List[Type] * Type)], x: Var, f1: Expr, u: Type, w: Type, args1: List[Expr], ts: List[Type]
  match f
    case EVar(Var(name, typ)) =>
      assign cs := candidates(s, env, name)
      if size(cs) > 1
        call infers_first(in env, args, out args1, ts, ref s)
        call fresh(out t, ref s)
        call normalize(in typ, out w, ref s)
        call unify(in w, TFun(ts, t), ref s)
        if with_arity(cs, size(args)) == list()
          raise WrongArity(name, size(args))
        end
        call   use_name(in name, with_arity(cs, size(args)), w, out x, ref s)
        call   infers_lambdas(in env, args, ts, ref args1, s)
        assign e1 := EApp(EVar(x), args1)
      else
        call   infer(in env, f, out f1, u, ref s)
        call   apply(in env, u, args, out args1, t, ref s)
        assign e1 := EApp(f1, args1)
      end

    case ELam(_, _) =>
      call   infers(in env, args, out args1, ts, ref s)
      call   fresh(out t, ref s)
      call   infer_lambda(in env, f, TFun(ts, t), out f1, ref s)
      assign e1 := EApp(f1, args1)

    case _ =>
      call   infer(in env, f, out f1, u, ref s)
      call   apply(in env, u, args, out args1, t, ref s)
      assign e1 := EApp(f1, args1)
  end

// the accessor T.f, or for the suffix .f:= the updater T.f:=, applied to e and the further arguments, of the type T of e,
// of the module of T, where an unknown type of e is an error
procedure field_access(
  in  env: Env,
      suffix: Id,
      expr: Expr,
      rest: List[Expr],
  out e1: Expr,
      t: Type,
  ref s: State
) :=
  local c: Expr, u: Type, w: Type, rest1: List[Expr], us: List[Type], acc: Name, x: Var
  call infer(in env, expr, out c, u, ref s)
  call infers(in env, rest, out rest1, us, ref s)
  call fresh(out t, ref s)
  call fresh(out w, ref s)
  call unify(in w, TFun(list(u; us), t), ref s)
  call solve(ref s)
  match zonk_type(s.sub, u)
    case TSort(Name(Some(m), base), _) =>
      assign acc := Name(Some(m), base ++ suffix)
      match schemes_of(s.sig, acc)
        case list(sc) if is_visible(s, acc) =>
          call use(in acc, w, sc, out x, ref s)
        case _ =>
          raise UnknownField(acc)
      end

    case TMeta(_) =>
      raise UnknownFieldOwner(suffix)

    case v =>
      raise UnknownFieldType(suffix, v)
  end
  assign e1 := EApp(EVar(x), list(c; rest1))

procedure apply(
  in  env: Env,
      f: Type,
      args: List[Expr],
  out args1: List[Expr],
      r: Type,
  ref s: State
) :=
  local ts: List[Type]
  call fresh(out r, ref s)
  call infers_first(in env, args, out args1, ts, ref s)
  call unify(in f, TFun(ts, r), ref s)
  call infers_lambdas(in env, args, ts, ref args1, s)

// the arguments in order, except the lambdas, which get an unknown type and wait until the type of the function is
// known, so that the formals of a lambda have the types that the function expects, see infers_lambdas
procedure infers_first(
  in  env: Env,
      exprs: List[Expr],
  out es1: List[Expr],
      ts: List[Type],
  ref s: State
) :=
  local e1: Expr, t: Type
  assign es1 := list(), ts := list()
  for e in exprs do
    if is_lambda(e)
      call   fresh(out t, ref s)
      assign e1 := e
    else
      call infer(in env, e, out e1, t, ref s)
    end
    assign es1 := es1 ++ list(e1), ts := ts ++ list(t)
  end

function is_lambda(e: Expr): Bool :=
  match e
    case ELam(_, _) =>
      true
    case _ =>
      false
  end

// the lambdas among exprs, whose types are those in ts, inferred with the formals that have no type typed by the parameters
// of the function type there, if it is known
procedure infers_lambdas(
  in  env: Env,
      exprs: List[Expr],
      ts: List[Type],
  ref es1: List[Expr],
      s: State
) :=
  local found: List[Expr] := list(), e2: Expr
  for ((e, e1), t) in zip(zip(exprs, es1), ts) do
    if is_lambda(e)
      call infer_lambda(in env, e, t, out e2, ref s)
    else
      assign e2 := e1
    end
    assign found := found ++ list(e2)
  end
  assign es1 := found

procedure infer_lambda(
  in  env: Env,
      e: Expr,
      t: Type,
  out e1: Expr,
  ref s: State
) :=
  local u: Type
  match (e, zonk_type(s.sub, t))
    case (ELam(formals, body), TFun(ps, _)) if size(ps) == size(formals) =>
      call infer(in env, ELam(list(for (x, p) in zip(formals, ps) yield if x.typ == THole then Var(x.name, p) else x), body), out e1, u, ref s)
    case _ =>
      call infer(in env, e, out e1, u, ref s)
  end
  call unify(in u, t, ref s)

procedure check(in env: Env, expr: Expr, t: Type, out e1: Expr, ref s: State) :=
  local u: Type
  if is_lambda(expr)
    call infer_lambda(in env, expr, t, out e1, ref s)
  else
    call infer(in env, expr, out e1, u, ref s)
    call unify(in u, t, ref s)
  end

// the expressions of what, checked against the types ts, as many
procedure checks(
  in  env: Env,
      what: Str,
      exprs: List[Expr],
      ts: List[Type],
  out es1: List[Expr],
  ref s: State
) :=
  local e1: Expr, rest: List[Expr]
  match (exprs, ts)
    case (list(e; more), list(t; ts1)) =>
      call   check(in env, e, t, out e1, ref s)
      call   checks(in env, what, more, ts1, out rest, ref s)
      assign es1 := list(e1; rest)

    case (list(), list()) =>
      assign es1 := list()

    case _ =>
      raise CountMismatch(what, "values", size(ts), size(exprs))
  end

procedure infers(
  in  env: Env,
      exprs: List[Expr],
  out es1: List[Expr],
      ts: List[Type],
  ref s: State
) :=
  local e1: Expr, t: Type
  assign es1 := list(), ts := list()
  for e in exprs do
    call   infer(in env, e, out e1, t, ref s)
    assign es1 := es1 ++ list(e1), ts := ts ++ list(t)
  end

procedure expr_branches(
  in  env: Env,
      cases: List[Branch[Expr]],
      t: Type,
      r: Type,
  out cases1: List[Branch[Expr]],
  ref s: State
) :=
  local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Expr, rest: List[Branch[Expr]]
  match cases
    case list() =>
      assign cases1 := list()

    case list(Branch(doc, pat, g, body); more) =>
      call   pattern(in pat, t, out p1, xs, ref s)
      call   guard(in bind(xs) ++ env, g, out g1, ref s)
      call   check(in bind(xs) ++ env, body, r, out b1, ref s)
      call   expr_branches(in env, more, t, r, out rest, ref s)
      assign cases1 := list(Branch(doc, p1, g1, b1); rest)
  end

procedure guard(
  in  env: Env,
      g: Option[Expr],
  out g1: Option[Expr],
  ref s: State
) :=
  local e1: Expr
  match g
    case Some(e) =>
      call   check(in env, e, type_bool(), out e1, ref s)
      assign g1 := Some(e1)

    case None =>
      assign g1 := None
  end

// guarded cases neither cover values for exhaustiveness nor make later cases unreachable
procedure coverage(in s: State, t: Type, cs: List[Pat * Bool]) :=
  call reachable(in s, t, list(), cs)
  match missing(s.sig, s.sub, list(for p in unguarded(cs) yield list(p)), list(t))
    case Some(list(w; _)) =>
      raise NotExhaustive(w)
    case _ =>
      skip
  end

function unguarded(cs: List[Pat * Bool]): List[Pat] :=
  list(for (p, g) in cs if g yield p)

procedure reachable(
  in  s: State,
      t: Type,
      before: List[Pat],
      cs: List[Pat * Bool]
) :=
  match cs
    case list() =>
      skip

    case list((p, open); rest) =>
      if not useful(s.sig, s.sub, list(for q in before yield list(q)), list(p), list(t))
        raise Unreachable(p)
      end
      if open
        call reachable(in s, t, before ++ list(p), rest)
      else
        call reachable(in s, t, before, rest)
      end
  end

procedure pattern(
  in  pat: Pat,
      t: Type,
  out p1: Pat,
      xs: List[Var],
  ref s: State
) :=
  call binders(in pat, t, out p1, xs, ref s)
  call unique(in "pattern variable", list(for x in xs yield x.name))

procedure binders(
  in  pat: Pat,
      t: Type,
  out p1: Pat,
      xs: List[Var],
  ref s: State
) :=
  local u: Type, m: List[Type * Type], qs: List[Pat], ts: List[Type], k: Name
  match pat
    case PWild =>
      assign p1 := pat, xs := list()

    case PLit(lit) =>
      call   unify(in literal(lit), t, ref s)
      assign p1 := pat, xs := list()

    case PVar(Var(name, typ)) =>
      if overloads(s, name, lambda k => is_constr(s.sig, k)) != list()
        call binders(in PApp(name, list()), t, out p1, xs, ref s)
      else
        call   normalize(in typ, out u, ref s)
        call   unify(in u, t, ref s)
        assign p1 := PVar(Var(name, u)), xs := list(Var(name, u))
      end

    case PApp(constr, pats) =>
      match overloads(s, constr, lambda k => is_constr(s.sig, k))
        case list(k1) =>
          assign k := k1

        case list() =>
          raise UnknownConstructor(constr)

        case ks =>
          call pattern_constructor(in constr, ks, size(pats), t, out k, ref s)
      end
      match constr_of(s.sig, k)
        case Some((ps, ks, r)) =>
          call   same_length(in "constructor " ++ k.base, "arguments", size(ks), size(pats))
          call   instance(in ps, out m, ref s)
          call   unify(in subst(r, m), t, ref s)
          call   binder_list(in pats, list(for kt in ks yield subst(kt, m)), out qs, xs, ref s)
          assign p1 := PApp(k, qs)

        case None =>
          raise UnknownConstructor(constr)
      end

    case PTuple(pats) =>
      call   fresh_list(in pats, out ts, ref s)
      call   unify(in TTuple(ts), t, ref s)
      call   binder_list(in pats, ts, out qs, xs, ref s)
      assign p1 := PTuple(qs)
  end

// the one of the constructors ks with k arguments whose datatype fits t, where open uses are solved first if
// several fit, since the variables of the pattern need their types
procedure pattern_constructor(
  in  n: Name,
      ks: List[Name],
      k: Int,
      t: Type,
  out c: Name,
  ref s: State
) :=
  local ok: List[(Name * (List[Type] * Type)) * State]
  call trials(in results(s.sig, ks, k), t, s, out ok)
  if size(ok) > 1
    call solve(ref s)
    call trials(in results(s.sig, ks, k), t, s, out ok)
  end
  match (ok, own(s, firsts(ok)))
    case (list(((c1, _), _)), _) =>
      assign c := c1

    case (list(), _) =>
      raise NoOverload(n, zonk_type(s.sub, t))

    case (_, list((c1, _))) =>
      assign c := c1

    case _ =>
      raise Ambiguous(n, firsts(ok))
  end

// the constructors of ks with k arguments, each with the scheme of its datatype
function results(sig: Sig, ks: List[Name], k: Int): List[Name * (List[Type] * Type)] :=
  match ks
    case list() =>
      list()

    case list(n; rest) =>
      match constr_of(sig, n)
        case Some((ps, args, r)) =>
          if size(args) == k then list((n, (ps, r)); results(sig, rest, k)) else results(sig, rest, k)
        case None =>
          results(sig, rest, k)
      end
  end

procedure binder_list(
  in  pats: List[Pat],
      ts: List[Type],
  out qs: List[Pat],
      xs: List[Var],
  ref s: State
) :=
  local q: Pat, ys: List[Var], rest: List[Pat], zs: List[Var]
  match (pats, ts)
    case (list(p; more), list(t; ts1)) =>
      call   binders(in p, t, out q, ys, ref s)
      call   binder_list(in more, ts1, out rest, zs, ref s)
      assign qs := list(q; rest), xs := ys ++ zs

    case (list(), list()) =>
      assign qs := list(), xs := list()

    case _ =>
      raise CountMismatch("the pattern", "components", size(ts), size(pats))
  end

procedure variable(
  in  env: Env,
      assignable: List[Name],
      x: Var,
  out y: Var,
  ref s: State
) :=
  local u: Type
  match x
    case Var(name, typ) =>
      if not contains(name, assignable)
        raise NotAssignable(name)
      end
      match get(name, env)
        case Some(Local((_, t), _)) =>
          call   normalize(in typ, out u, ref s)
          call   unify(in t, u, ref s)
          assign y := Var(name, t)

        case None =>
          raise UnknownVariable(name)
      end
  end

procedure variables(
  in  env: Env,
      assignable: List[Name],
      xs: List[Var],
  out ys: List[Var],
  ref s: State
) :=
  local y: Var
  assign ys := list()
  for x in xs do
    call   variable(in env, assignable, x, out y, ref s)
    assign ys := ys ++ list(y)
  end

// env tells which variables are assigned on every path to x, and after it
procedure statement(
  in  assignable: List[Name],
      x: Stmt,
  out y: Stmt,
  ref env: Env,
      s: State
) :=
  local ys: List[Var], exprs: List[Expr], c: Expr, t: Type, u: Type, l: Stmt, r: Stmt, xs: List[Stmt], bs: List[Branch[Stmt]], hs: List[Handler], inner: Env, other: Env
  match x
    case SSkip =>
      assign y := x

    case SAssign(assignments) =>
      call   unique(in "assignment to", list(for x in firsts(assignments) yield x.name))
      call   variables(in env, assignable, firsts(assignments), out ys, ref s)
      call   checks(in env, "the assignment", seconds(assignments), list(for x in ys yield x.typ), out exprs, ref s)
      assign y := SAssign(zip(ys, exprs)), env := assigned(env, list(for x in ys yield x.name))

    // the types of locals that are initialized at the start of the block may be inferred
    case SBlock(locals, stmts) =>
      call   untyped(in locals, initialized(stmts))
      call   formals(in "local", locals, out ys, ref s)
      assign inner := unassigned(ys) ++ env
      call   statements(in list(for x in ys yield x.name) ++ assignable, stmts, out xs, ref inner, s)
      assign y := SBlock(ys, xs), env := drop(size(ys), inner)

    case SIf(cond, then_stmt, else_stmt) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      assign other := env
      call   statement(in assignable, then_stmt, out l, ref env, s)
      call   statement(in assignable, else_stmt, out r, ref other, s)
      assign y := SIf(c, l, r), env := joined(env, other)

    case SWhile(cond, body) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      assign inner := env
      call   statement(in assignable, body, out l, ref inner, s)
      assign y := SWhile(c, l)

    // a procedure that a variable holds and the refs are read
    case SCall(proc, ins, outs, refs) =>
      call   call_proc(in env, assignable, proc, ins, outs, refs, out y, ref s)
      call   readables(in env, list(proc; list(for x in refs yield x.name)))
      assign env := assigned(env, list(for x in outs ++ refs yield x.name))

    case SMatch(expr, cases) =>
      call   infer(in env, expr, out c, t, ref s)
      call   stmt_branches(in assignable, cases, t, out bs, ref env, s)
      call   solve(ref s)
      call   coverage(in s, t, list(for br in bs yield case_of(br)))
      assign y := SMatch(c, bs)

    case SAssert(cond) =>
      call   check(in env, cond, type_bool(), out c, ref s)
      assign y := SAssert(c)
      if c == ELit(LBool(false))
        assign env := unreachable(env)
      end

    case SRaise(expr, typ) =>
      call   infer(in env, expr, out c, t, ref s)
      call   normalize(in typ, out u, ref s)
      call   unify(in t, u, ref s)
      assign y := SRaise(c, t), env := unreachable(env)

    case STry(body, handlers) =>
      assign other := env
      call   statement(in assignable, body, out l, ref env, s)
      call   handler_list(in assignable, handlers, out hs, ref other, s)
      assign y := STry(l, hs), env := joined(env, other)
  end

// the variables that the leading assignments of a block assign one at a time, as local x := e does
function initialized(xs: List[Stmt]): List[Name] :=
  match xs
    case list(SAssign(list((x, _))); rest) =>
      list(x.name; initialized(rest))
    case _ =>
      list()
  end

// the locals without a type are initialized
procedure untyped(in xs: List[Var], inits: List[Name]) :=
  match xs
    case list() =>
      skip

    case list(Var(name, typ); rest) =>
      if holes(typ) and not contains(name, inits)
        raise MissingType(name)
      end
      call untyped(in rest, inits)
  end

procedure statements(
  in  assignable: List[Name],
      xs: List[Stmt],
  out ys: List[Stmt],
  ref env: Env,
      s: State
) :=
  local y: Stmt
  assign ys := list()
  for x in xs do
    call   statement(in assignable, x, out y, ref env, s)
    assign ys := ys ++ list(y)
  end

// the procedures of the program hide the builtin ones
// a variable of a procedure type hides the procedures of that name
procedure call_proc(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  match get(p, env)
    case Some(l) =>
      call call_variable(in env, assignable, p, l.scheme, ins, outs, refs, out y, ref s)
    case None =>
      call call_declared(in env, assignable, p, ins, outs, refs, out y, ref s)
  end

procedure call_variable(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      sc: List[Type] * Type,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  local x: Var, w: Type, is: List[Type], os: List[Type], rs: List[Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]
  call   fresh(out w, ref s)
  call   use(in p, w, sc, out x, ref s)
  call   fresh_list(in ins, out is, ref s)
  call   fresh_list(in outs, out os, ref s)
  call   fresh_list(in refs, out rs, ref s)
  call   unify(in x.typ, TProc(is, os, rs), ref s)
  call   unique(in "out or ref", list(for x in outs ++ refs yield x.name))
  call   checks(in env, "procedure " ++ p.base, ins, is, out ins1, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   unifies(in list(for x in outs1 ++ refs1 yield x.typ), os ++ rs, ref s)
  assign y := SCall(p, ins1, outs1, refs1)

procedure call_declared(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  match overloads(s, p, lambda q => is_proc(s.sig, q))
    case list(q) =>
      call declared_call(in env, assignable, p, q, ins, outs, refs, out y, ref s)

    case list() =>
      call declared_call(in env, assignable, p, p, ins, outs, refs, out y, ref s)

    case qs =>
      call overloaded_call(in env, assignable, p, qs, ins, outs, refs, out y, ref s)
  end

// a call of one of the procedures qs, by the types of its arguments, where the arguments are inferred first
procedure overloaded_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      qs: List[Name],
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  local ins1: List[Expr], is: List[Type], outs1: List[Var], refs1: List[Var], m: Name
  call   unique(in "out or ref", list(for x in outs ++ refs yield x.name))
  call   infers(in env, ins, out ins1, is, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   choose(in p, list(for q in qs yield (q, proc_scheme(s.sig, q))), TProc(is, list(for x in outs1 yield x.typ), list(for x in refs1 yield x.typ)), out m, ref s)
  assign y := SCall(m, ins1, outs1, refs1)

procedure declared_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      q: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out y: Stmt,
  ref s: State
) :=
  local m: List[Type * Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]
  match proc_of(s.sig, q)
    case Some((ps, is, os, rs)) =>
      call   instance(in ps, out m, ref s)
      call   same_length(in "procedure " ++ q.base, "ins", size(is), size(ins))
      call   same_length(in "procedure " ++ q.base, "outs", size(os), size(outs))
      call   same_length(in "procedure " ++ q.base, "refs", size(rs), size(refs))
      call   unique(in "out or ref", list(for x in outs ++ refs yield x.name))
      call   checks(in env, "procedure " ++ q.base, ins, list(for t in is yield subst(t, m)), out ins1, ref s)
      call   variables(in env, assignable, outs, out outs1, ref s)
      call   variables(in env, assignable, refs, out refs1, ref s)
      call   unifies(in list(for x in outs1 ++ refs1 yield x.typ), list(for t in os ++ rs yield subst(t, m)), ref s)
      assign y := SCall(q, ins1, outs1, refs1)

    case None =>
      raise UnknownProcedure(p)
  end

// env joins what the cases assign, where a match that no case fits raises
procedure stmt_branches(
  in  assignable: List[Name],
      cases: List[Branch[Stmt]],
      t: Type,
  out cases1: List[Branch[Stmt]],
  ref env: Env,
      s: State
) :=
  local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Branch[Stmt]], inner: Env
  match cases
    case list() =>
      assign cases1 := list(), env := unreachable(env)

    case list(Branch(doc, pat, g, body); more) =>
      call   pattern(in pat, t, out p1, xs, ref s)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out g1, ref s)
      call   statement(in assignable -- list(for x in xs yield x.name), body, out b1, ref inner, s)
      call   stmt_branches(in assignable, more, t, out rest, ref env, s)
      assign cases1 := list(Branch(doc, p1, g1, b1); rest), env := joined(drop(size(xs), inner), env)
  end

// handlers start from the variables before the try, which an exception restores
procedure handler_list(
  in  assignable: List[Name],
      hs: List[Handler],
  out hs1: List[Handler],
  ref env: Env,
      s: State
) :=
  local u: Type, p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Handler], inner: Env
  match hs
    case list() =>
      assign hs1 := list(), env := unreachable(env)

    case list(Handler(doc, typ, pat, g, body); more) =>
      call   normalize(in typ, out u, ref s)
      call   pattern(in pat, u, out p1, xs, ref s)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out g1, ref s)
      call   statement(in assignable -- list(for x in xs yield x.name), body, out b1, ref inner, s)
      call   handler_list(in assignable, more, out rest, ref env, s)
      assign hs1 := list(Handler(doc, u, p1, g1, b1); rest), env := joined(drop(size(xs), inner), env)
  end

procedure declare_name(in sig: Sig, n: Name) :=
  if is_fun(sig, n) or is_proc(sig, n) or is_constr(sig, n) or builtin_schemes(unqualified(n.base)) != list()
    raise AlreadyDefined(n)
  end

// functions of the same name must differ in their number of arguments, while they may overload builtins
procedure overload(in sig: Sig, n: Name, k: Int) :=
  if is_proc(sig, n) or is_constr(sig, n) or has_arity(schemes_of(sig, n), k)
    raise AlreadyDefined(n)
  end

procedure declare_sort(in sig: Sig, n: Name) :=
  if n.base == "->" or is_alias(sig, n) or is_data(sig, n)
    raise SortDefined(n)
  end

procedure closed(in n: Name, ps: List[Id], ts: List[Type]) :=
  local undeclared := distinct(list(for t in ts for v in free(t) yield v)) -- params(ps)
  if undeclared != list()
    raise UndeclaredParams(n, undeclared)
  end

// datatypes may be mutually recursive, so they are known before any sort is checked
procedure declare_datas(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(name, params, _) =>
        assign s := enter(s, m)
        call   declare_sort(in s.sig, name)
        assign s := with_sig(s, with_data(s.sig, name, size(params)))

      case _ =>
        skip
    end
  end

procedure declare_sorts(in cs: List[Id * Cmd], ref s: State) :=
  local u: Type
  for (m, cmd) in cs do
    match cmd
      case CSort(name, params, typ) =>
        assign s := enter(s, m)
        call   declare_sort(in s.sig, name)
        call   unique_ids(in "type parameter", params)
        call   known(in typ, name, out u, ref s)
        call   closed(in name, params, list(u))
        assign s := with_sig(s, with_alias(s.sig, name, params, u))

      case _ =>
        skip
    end
  end

procedure declare_constrs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(n, params, constrs) =>
        assign s := enter(s, m)
        call   unique_ids(in "type parameter", params)
        assign s := with_sig(s, with_members(s.sig, n, list(for k in constrs yield k.name)))
        call   declare_constructors(in n, params, constrs, ref s)
        call   declare_fields(in n, params, field_types(s.sig, constrs), ref s)

      case _ =>
        skip
    end
  end

procedure declare_constructors(
  in  n: Name,
      ps: List[Id],
      ks: List[Constr],
  ref s: State
) :=
  local ts: List[Type]
  for Constr(_, name, fields) in ks do
    call   declare_name(in s.sig, name)
    call   knowns(in list(for field in fields yield field.typ), name, out ts, ref s)
    call   closed(in n, ps, ts)
    assign s := with_sig(s, with_constr(s.sig, name, (params(ps), ts, TSort(n, params(ps)))))
  end

// the accessor T.f and the updater T.f:= of each field f of the datatype T, which have no definitions, since the
// interpreter and the compiler implement them by the positions of the fields (fields of Defs)
procedure declare_fields(
  in  n: Name,
      ps: List[Id],
      fields: List[Id * Type],
  ref s: State
) :=
  local t := TSort(n, params(ps))
  for (f, u) in fields do
    assign s := with_sig(s, with_fun(with_fun(s.sig, accessor_name(n, f), (params(ps), TFun(list(t), u))), updater_name(n, f), (params(ps), TFun(list(t, u), t))))
  end

// each field of the constructors once, with its type as the constructor that declares it first has it, which is that of
// the others, since the parser rejects a field with different types
function field_types(sig: Sig, ks: List[Constr]): List[Id * Type] :=
  first_fields(list(for k in ks for p in zip(list(for field in k.fields yield field.name), constr_types(sig, k.name)) yield p))

function constr_types(sig: Sig, k: Name): List[Type] :=
  value_or(map_option(constr_of(sig, k), lambda (_, ts, _) => ts), list())

function first_fields(fields: List[Id * Type]): List[Id * Type] :=
  match fields
    case list() =>
      list()
    case list((f, u); rest) =>
      list((f, u); first_fields(list(for p in rest if first(p) != f)))
  end

procedure declare_funs(in cs: List[Id * Cmd], ref s: State) :=
  local xs: List[Var], r: Type
  for (m, cmd) in cs do
    match cmd
      case CFun(name, ps, formals, typ, _) =>
        assign s := enter(s, m)
        call   overload(in s.sig, name, size(formals))
        call   unique_ids(in "type parameter", ps)
        call   unique(in "formal", list(for x in formals yield x.name))
        call   signature(in formals, out xs, ref s)
        call   known(in typ, name, out r, ref s)
        call   closed(in name, ps, list(TFun(list(for x in xs yield x.typ), r)))
        assign s := with_sig(s, with_fun(s.sig, name, (params(ps), TFun(list(for x in xs yield x.typ), r))))

      case _ =>
        skip
    end
  end

procedure declare_procs(in cs: List[Id * Cmd], ref s: State) :=
  local xs: List[Var], ts: List[Type]
  for (m, cmd) in cs do
    match cmd
      case CProc(name, ps, ins, outs, refs, _) =>
        assign s := enter(s, m)
        call   declare_name(in s.sig, name)
        call   unique_ids(in "type parameter", ps)
        call   signature(in ins ++ outs ++ refs, out xs, ref s)
        assign ts := list(for x in xs yield x.typ)
        call   closed(in name, ps, ts)
        assign s := match split_at(size(ins), ts)
          case (in_types, others) =>
            match split_at(size(outs), others)
              case (out_types, ref_types) =>
                with_sig(s, with_proc(s.sig, name, (params(ps), in_types, out_types, ref_types)))
            end
        end

      case _ =>
        skip
    end
  end

procedure command(in cmd: Cmd, out c1: Cmd, ref s: State) :=
  local xs: List[Var], r: Type, b: Expr, t: Type, is: List[Var], os: List[Var], rs: List[Var], y: Stmt, env: Env
  match cmd
    case CFun(name, params, formals, typ, body) =>
      call   signature(in formals, out xs, ref s)
      call   known(in typ, name, out r, ref s)
      call   check(in bind(xs), body, r, out b, ref s)
      assign c1 := CFun(name, params, xs, r, b)

    case CProc(name, params, ins, outs, refs, stmt) =>
      call   signature(in ins, out is, ref s)
      call   signature(in outs, out os, ref s)
      call   signature(in refs, out rs, ref s)
      assign env := bind(is) ++ unassigned(os) ++ bind(rs)
      call   statement(in list(for x in os ++ rs yield x.name), stmt, out y, ref env, s)
      call   outputs(in name, os, env)
      assign c1 := CProc(name, params, is, os, rs, y)

    case CTest(test_name, list(), stmt) =>
      assign env := list()
      call   statement(in list(), stmt, out y, ref env, s)
      assign c1 := CTest(test_name, list(), y)

    case CTest(test_name, _, _) =>
      raise TestParams(test_name)

    case _ =>
      assign c1 := cmd
  end

procedure commands(in cs: List[Id * Cmd], out cs1: List[Cmd], ref s: State) :=
  local c1: Cmd, c2: Cmd, rest: List[Cmd]
  match cs
    case list() =>
      assign cs1 := list()

    case list((m, c); more) =>
      assign s := enter(s, m)
      call   command(in c, out c1, ref s)
      call   settle(ref s)
      assign c2 := zonk_cmd(s, c1)
      match unknown_in_cmd(c2)
        case Some(t) =>
          raise UnknownException(t)
        case None =>
          skip
      end
      call   commands(in more, out rest, ref s)
      assign cs1 := list(c2; rest)
  end

// tests are chosen by name
function block_names(cs: List[Id * Cmd]): List[Id] :=
  match cs
    case list() =>
      list()

    case list((_, CTest(test_name, _, _)); more) =>
      list(test_name; block_names(more))

    case list(_; more) =>
      block_names(more)
  end

// only abstract types declare equalities, since matching tells the values of other datatypes apart by their constructors,
// and the orders and equalities of exported datatypes are exported, since they change what the builtins do for importers
procedure check_orders(
  in  cmds: List[Cmd],
      abstract: List[Name],
      hidden: Set[Name],
      hidden_sorts: List[Name]
) :=
  match cmds
    case list() =>
      skip

    case list(c; rest) =>
      match (c, order_of(c))
        case (_, Some(("==", t))) if not contains(t, abstract) =>
          raise VisibleEquality(t)

        case (CFun(name, _, _, _, _), Some((_, t))) if contains(name, hidden) and not contains(t, hidden_sorts) =>
          raise UnexportedOrder(name, t)

        case _ =>
          call check_orders(in rest, abstract, hidden, hidden_sorts)
      end
  end

// the order and equality of the abstract types of ds that their modules do not declare, which raise Unordered for a type
// with an equality, and Incomparable for a type without, since the structure of an abstract type is no order
function synthesized(ds: List[Id * Cmd], cmds: List[Cmd], natives: List[Name]): List[Id * Cmd] :=
  let compares := ordered(cmds, "compare") ++ natives, equalities := ordered(cmds, "==") in list(for c in ds for e in synthesized_for(c, compares, equalities) yield e)

function synthesized_for(d: Id * Cmd, compares: List[Name], equalities: List[Name]): List[Id * Cmd] :=
  match d
    case (m, CAbstract(name, params)) =>
      if contains(name, compares) then list() else if contains(name, equalities) then list((m, failing(name, params, "compare", type_int(), "Unordered"))) else list(
        (m, failing(name, params, "compare", type_int(), "Incomparable")),
        (m, failing(name, params, "==", type_bool(), "Incomparable")))

    case _ =>
      list()
  end

function failing(t: Name, ps: List[Id], op: Id, r: Type, e: Id): Cmd :=
  let a := TSort(t, params(ps)) in CFun(Name(t.module, t.base ++ "." ++ op), ps, list(Var(unqualified("a"), a), Var(unqualified("b"), a)), r, ERaise(EApp(EVar(Var(Name(Some("prelude"), e), THole)), list(ELit(LStr(format_name(t))))), THole))

// the commands of ds without signatures and abstract types, which only the checks of sections need
function is_definition(d: Id * Cmd): Bool :=
  match d
    case (_, CFunSig(_, _, _, _)) =>
      false

    case (_, CProcSig(_, _, _, _, _)) =>
      false

    case (_, CAbstract(_, _)) =>
      false

    case _ =>
      true
  end

function definitions(ds: List[Id * Cmd]): List[Id * Cmd] :=
  list(for d in ds if is_definition(d))

// the signatures and types of the builtin section of d as definitions to declare, whose definitions the interpreter and the
// runtime give, where a type is a datatype without constructors, whose values the interpreter and the runtime make
function natives(d: Mod): List[Id * Cmd] :=
  list(for c in commands_of(d.builtins) yield (d.name, native(qualify(d.name, c))))

function native(cmd: Cmd): Cmd :=
  match cmd
    case CFunSig(name, params, formals, typ) =>
      CFun(name, params, formals, typ, ELit(LUnit))

    case CProcSig(name, params, ins, outs, refs) =>
      CProc(name, params, ins, outs, refs, SSkip)

    case CAbstract(name, params) =>
      CData(name, params, list())

    case _ =>
      cmd
  end

// the types of the builtin sections of ds, which the interpreter and the runtime order, equate, and show
function native_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case list() =>
      list()

    case list((_, CData(name, _, _)); rest) =>
      list(name; native_types(rest))

    case list(_; rest) =>
      native_types(rest)
  end

function qualified_name(cmd: Cmd): Name :=
  match cmd
    case CFun(name, _, _, _, _) =>
      name
    case _ =>
      unqualified("")
  end

function abstract_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case list() =>
      list()

    case list((_, CAbstract(name, _)); rest) =>
      list(name; abstract_types(rest))

    case list(_; rest) =>
      abstract_types(rest)
  end

// the declarations of an implementation section that the export section does not export, with the constructors and fields
// of abstract types
function private_names(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  list(for c in im for n in private_in(c, ex) yield n)

function private_in(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CFun(name, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then list() else list(name)

    case CProc(name, _, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then list() else list(name)

    case CData(t, _, constrs) =>
      let members := list(for k in constrs yield k.name) ++ list(for f in field_names(constrs) for n in list(accessor_name(t, f), updater_name(t, f)) yield n) in if exists(ex, lambda e => abstracts(e, t)) then members else list(t; members)

    case CSort(name, _, _) =>
      list(name)

    case _ =>
      list()
  end

// the sorts of an implementation section that the export section does not export, not even as abstract types
function private_sorts(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  list(for c in im for n in private_sort(c, ex) yield n)

function private_sort(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CData(name, _, _) =>
      if exists(ex, lambda e => abstracts(e, name)) then list() else list(name)

    case CSort(name, _, _) =>
      list(name)

    case _ =>
      list()
  end

function signs(e: Cmd, n: Name): Bool :=
  match e
    case CFunSig(name, _, _, _) =>
      name == n

    case CProcSig(name, _, _, _, _) =>
      name == n

    case _ =>
      false
  end

function abstracts(e: Cmd, t: Name): Bool :=
  match e
    case CAbstract(name, _) =>
      name == t
    case _ =>
      false
  end

// the function n of k arguments, the procedure n, and the datatype n
function defines_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFun(name, _, formals, _, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

function defines_proc(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, _, _, _, _) =>
      name == n
    case _ =>
      false
  end

function defines_data(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CData(name, _, _) =>
      name == n
    case _ =>
      false
  end

function signs_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFunSig(name, _, formals, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

// the signatures of ex, each of which the implementation section im defines once and exactly as written
procedure check_signatures(in ex: List[Cmd], im: List[Cmd]) :=
  match ex
    case list() =>
      skip

    case list(CFunSig(name, params, formals, typ); rest) =>
      if exists(rest, lambda e => signs_fun(e, name, size(formals)))
        raise AlreadyDefined(name)
      end
      match list(for c in im if defines_fun(c, name, size(formals)))
        case list(CFun(_, ps1, xs1, r1, _)) =>
          if ps1 != params or xs1 != formals or r1 != typ
            raise SignatureMismatch(name)
          end

        case _ =>
          raise MissingDefinition(name)
      end
      call check_signatures(in rest, im)

    case list(CProcSig(name, params, ins, outs, refs); rest) =>
      if exists(rest, lambda e => signs(e, name))
        raise AlreadyDefined(name)
      end
      match list(for c in im if defines_proc(c, name))
        case list(CProc(_, ps1, ins1, outs1, refs1, _)) =>
          if ps1 != params or ins1 != ins or outs1 != outs or refs1 != refs
            raise SignatureMismatch(name)
          end

        case _ =>
          raise MissingDefinition(name)
      end
      call check_signatures(in rest, im)

    case list(CAbstract(name, params); rest) =>
      match list(for c in im if defines_data(c, name))
        case list(CData(_, ps1, _)) =>
          if ps1 != params
            raise SignatureMismatch(name)
          end

        case _ =>
          raise MissingDefinition(name)
      end
      call check_signatures(in rest, im)

    case list(_; rest) =>
      call check_signatures(in rest, im)
  end

// a function of the implementation section that is exported is exported with each of its numbers of arguments
procedure check_arities(in im: List[Cmd], ex: List[Cmd]) :=
  for cmd in im do
    match cmd
      case CFun(name, _, formals, _, _) =>
        if exists(ex, lambda e => signs(e, name)) and not exists(ex, lambda e => signs_fun(e, name, size(formals)))
          raise PartlyExported(name)
        end

      case _ =>
        skip
    end
  end

// the types of the export section name only sorts that importers can name, not the private sorts of the module
procedure check_exposed(in m: Id, ex: List[Cmd], hidden_sorts: List[Name]) :=
  local found: List[Name]
  match ex
    case list() =>
      skip

    case list(c; rest) =>
      match exposed(c)
        case Some((n, ts)) =>
          assign found := list(for u in ts for t in sorts_in(u) if contains(own_name(m, t), hidden_sorts) yield own_name(m, t))
          match found
            case list(t; _) =>
              raise PrivateType(n, t)
            case list() =>
              skip
          end

        case None =>
          skip
      end
      call check_exposed(in m, rest, hidden_sorts)
  end

// a name as written in module m, where an unqualified name of a sort of m is one of its own
function own_name(m: Id, n: Name): Name :=
  if n.module == None then in_module(m, n) else n

// the declaration of an export section with the types that it shows to importers
function exposed(cmd: Cmd): Option[Name * List[Type]] :=
  match cmd
    case CFunSig(name, _, formals, typ) =>
      Some((name, list(for x in formals yield x.typ) ++ list(typ)))

    case CProcSig(name, _, ins, outs, refs) =>
      Some((name, list(for x in ins ++ outs ++ refs yield x.typ)))

    case CData(name, _, constrs) =>
      Some((name, list(for k in constrs for field in k.fields yield field.typ)))

    case CSort(name, _, typ) =>
      Some((name, list(typ)))

    case _ =>
      None
  end

// the sorts that t names, as written, unqualified or qualified
function sorts_in(t: Type): List[Name] :=
  match t
    case TSort(name, args) =>
      list(name; list(for a in args for u in sorts_in(a) yield u))

    case TFun(args, res) =>
      list(for a in args ++ list(res) for u in sorts_in(a) yield u)

    case TProc(ins, outs, refs) =>
      list(for a in ins ++ outs ++ refs for u in sorts_in(a) yield u)

    case TTuple(types) =>
      list(for a in types for u in sorts_in(a) yield u)

    case _ =>
      list()
  end

// the sections of module d, with the declarations and sorts that it keeps private, which are all of a module without an
// export section
procedure check_sections(
  in  d: Mod,
  out hidden: Set[Name],
      hidden_sorts: List[Name]
) :=
  local ex := list(for c in commands_of(d.exported) yield qualify(d.name, c)), im := list(for c in commands_of(d.implemented) yield qualify(d.name, c))
  call   check_signatures(in ex, im)
  call   check_arities(in im, ex)
  call   check_exposed(in d.name, ex, private_sorts(ex, im))
  assign hidden := set(for x in private_names(ex, im)), hidden_sorts := private_sorts(ex, im)

// the commands of the program with qualified names, where each module is checked once, after the modules it imports
procedure check_program(in source: Source, out q: Prog) :=
  local sig: Sig := empty(), imports: List[Id * List[Id]] := list(), cmds: List[Cmd] := list()
  try
    call check_mods(in source.mods, ref sig, imports, cmds)
  catch
    case Located(Some(m), pos, error) if m == source.main =>
      raise Located(None, pos, error)
  end
  assign q := Prog(cmds)

procedure check_mods(
  in  mods: List[Mod],
  ref sig: Sig,
      imports: List[Id * List[Id]],
      cs: List[Cmd]
) :=
  local cmds: List[Cmd], shown: Sig
  for d in mods do
    call   check_mod(in d, sig, imports, out cmds, shown)
    assign sig := union(sig, shown), imports := imports ++ list((d.name, all_imports(d))), cs := cs ++ cmds
  end

// the commands of module d and the signature it shows its importers, checked after the declarations before of the modules that imports
// lists, where the declarations that other modules keep private are unknown, since before has only their signatures
procedure check_mod(
  in  d: Mod,
      before: Sig,
      imports: List[Id * List[Id]],
  out cmds: List[Cmd],
      shown: Sig
) :=
  local own := list((d.name, all_imports(d))), placed := decls_of(d), s: State, decls: List[Id * Cmd], defined: List[Cmd], hidden: Set[Name], hidden_sorts: List[Name], extra: List[Id * Cmd], more: List[Cmd], builtins := natives(d)
  assign s := State(before, empty(), 0, d.name, list(), visibility(imports ++ own, d.name), list(), empty()), decls := seconds(placed)
  call   each_placed(in declare_datas, placed, ref s)
  call   declare_datas(in builtins, ref s)
  call   each_placed(in declare_sorts, placed, ref s)
  call   each_placed(in declare_constrs, placed, ref s)
  call   each_placed(in declare_funs, placed, ref s)
  call   each_placed(in declare_procs, placed, ref s)
  call   declare_funs(in builtins, ref s)
  call   declare_procs(in builtins, ref s)
  call   check_sections(in d, out hidden, hidden_sorts)
  call   unique_ids(in "declaration", block_names(decls))
  call   placed_commands(in placed_definitions(placed), out defined, ref s)
  call   check_orders(in defined, abstract_types(decls), hidden, hidden_sorts)
  assign extra := synthesized(decls, defined, native_types(builtins))
  call   declare_funs(in extra, ref s)
  call   commands(in extra, out more, ref s)
  assign hidden := hidden ++ set(for c in more yield qualified_name(c))
  assign cmds := defined ++ more, shown := exported(restrict(s.sig, firsts(own)), hidden, set(for x in hidden_sorts))

// the commands of module d with qualified names, with the module of each, and their positions
function decls_of(d: Mod): List[Pos * (Id * Cmd)] :=
  list(for top in placed_of(d) yield (top.pos, (d.name, qualify(d.name, top.cmd))))

function placed_definitions(placed: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  list(for (p, d) in placed if is_definition(d))

// the declarations of a phase, one by one, where an error is located at the declaration that raises it
procedure each_placed(
  in  phase: (in List[Id * Cmd], ref State),
      placed: List[Pos * (Id * Cmd)],
  ref s: State
) :=
  match placed
    case list() =>
      skip

    case list((p, d); rest) =>
      try
        call phase(in list(d), ref s)
      catch
        case e =>
          raise located(d, p, e)
      end
      call each_placed(in phase, rest, ref s)
  end

// the commands of the definitions, checked one by one, where an error is located at the definition that raises it
procedure placed_commands(
  in  placed: List[Pos * (Id * Cmd)],
  out cmds: List[Cmd],
  ref s: State
) :=
  local one: List[Cmd], rest: List[Cmd]
  match placed
    case list() =>
      assign cmds := list()

    case list((p, d); more) =>
      try
        call commands(in list(d), out one, ref s)
      catch
        case e =>
          raise located(d, p, e)
      end
      call   placed_commands(in more, out rest, ref s)
      assign cmds := one ++ rest
  end

// the error e of declaration d of a module at position p, if the parser read it
function located(d: Id * Cmd, p: Pos, e: TypeError): TypeError :=
  match d
    case (m, _) =>
      if p == Pos(0, 0) then e else Located(Some(m), p, e)
  end

// the type of expr without a program
procedure type_of(in expr: Expr, out t: Type) :=
  local s := start("main", list()), e1: Expr, u: Type
  call   infer(in list(), expr, out e1, u, ref s)
  call   settle(ref s)
  assign t := zonk_type(s.sub, u)

test inference() :=
  local t: Type
  call type_of(in expr_app("<", list(expr_int(1), expr_int(2))), out t)
  assert t == type_bool()
  call type_of(in ELet(list(
    (Var(unqualified("id"), THole), ELam(list(Var(unqualified("x"), THole)), expr_var("x")))), ETuple(list(
    expr_app("id", list(expr_int(1))),
    expr_app("id", list(ELit(LBool(true))))))), out t)
  assert t == TTuple(list(type_int(), type_bool()))
  try
    call type_of(in ELam(list(Var(unqualified("f"), THole)), expr_app("f", list(expr_var("f")))), out t)
    assert false
  catch
    case InfiniteType(_, _) =>
      skip
  end
  try
    call type_of(in expr_app("<", list(expr_int(1), ELit(LBool(true)))), out t)
    assert false
  catch
    case CannotUnify(left, right) =>
      assert (left, right) == (type_int(), type_bool())
  end
  try
    call type_of(in expr_app("x", list()), out t)
    assert false
  catch
    case UnknownVariable(name) =>
      assert name == unqualified("x")
  end

test elaboration() :=
  local q: Prog
  call check_program(in with_lists(list(
    CTest("r", list(), SBlock(list(Var(unqualified("n"), THole)), list(
      SAssign(list(
        (Var(unqualified("n"), THole), expr_app("len", list(expr_app("Cons", list(expr_int(1), expr_var("Nil"))))))))))))), out q)
  match q
    case Prog(list(_, CFun(_, _, _, _, EMatch(_, list(Branch(_, pat, _, _); _))), CTest(_, list(), SBlock(_, list(SAssign(list((_, EApp(EVar(Var(_, typ)), _))))))))) =>
      assert pat == PApp(nil_name(), list())
      assert typ == TFun(list(TSort(list_name(), list(type_int()))), type_int())

    case _ =>
      assert false
  end

test coverage() :=
  local q: Prog
  try
    call check_program(in with_lists(list(
      CFun(unqualified("f"), list(), list(Var(unqualified("xs"), type_plain_list(type_int()))), type_int(), EMatch(expr_var("xs"), list(Branch("", pat_var("Nil"), None, expr_int(0))))))), out q)
    assert false
  catch
    case NotExhaustive(pat) =>
      assert pat == PApp(cons_name(), list(PWild, PWild))
  end
  try
    call check_program(in with_lists(list(
      CFun(unqualified("f"), list(), list(Var(unqualified("xs"), type_plain_list(type_int()))), type_int(), EMatch(expr_var("xs"), list(
        Branch("", PWild, None, expr_int(0)),
        Branch("", pat_var("Nil"), None, expr_int(1))))))), out q)
    assert false
  catch
    case Unreachable(pat) =>
      assert pat == PApp(nil_name(), list())
  end

test statements() :=
  local q: Prog
  try
    call check_program(in program_of(list(
      CProc(unqualified("inc"), list(), list(), list(), list(Var(unqualified("k"), type_int())), SBlock(list(), list(
        SAssign(list(
          (Var(unqualified("k"), THole), expr_app("+", list(expr_var("k"), expr_int(1))))))))),
      CProc(unqualified("p"), list(), list(Var(unqualified("n"), type_int())), list(), list(), SBlock(list(), list(
        SCall(unqualified("inc"), list(), list(), list(Var(unqualified("n"), THole)))))))), out q)
    assert false
  catch
    case NotAssignable(name) =>
      assert name == unqualified("n")
  end
  try
    call check_program(in with_lists(list(
      CTest("t", list(), SBlock(list(), list(SRaise(expr_var("Nil"), THole)))))), out q)
    assert false
  catch
    case UnknownException(TSort(Name(Some("list"), "List"), _)) =>
      skip
  end

function tsort(n: Id): Type :=
  TSort(unqualified(n), list())

function var_of(n: Id, t: Type): Var :=
  Var(unqualified(n), t)

function fun_cmd(n: Id, xs: List[Var], r: Type, b: Expr): Cmd :=
  CFun(unqualified(n), list(), xs, r, b)

// the modules bag and box, which both export a function size, a constructor Leaf, a procedure fill, and a field x,
// and that the program imports
function bags(): List[Mod] :=
  list(
    Mod("bag", "", list(), unplaced(list(
      CData(unqualified("Bag"), list(), list(
        Constr("", unqualified("Bag"), list(Field("n", type_int()))),
        Constr("", unqualified("Leaf"), list(Field("n", type_int()))))),
      CData(unqualified("Pt"), list(), list(Constr("", unqualified("Pt"), list(Field("x", type_int()))))),
      fun_cmd("size", list(var_of("b", tsort("Bag"))), type_int(), expr_int(1)),
      fun_cmd("compare", list(var_of("a", tsort("Bag")), var_of("b", tsort("Bag"))), type_int(), expr_int(0)),
      CProc(unqualified("fill"), list(), list(), list(var_of("b", tsort("Bag"))), list(), SAssign(list((var_of("b", THole), expr_app("Bag", list(expr_int(0))))))))), list(), list()),
    Mod("box", "", list(), unplaced(list(
      CData(unqualified("Box"), list(), list(
        Constr("", unqualified("Box"), list(Field("s", type_str()))),
        Constr("", unqualified("Leaf"), list(Field("s", type_str()))))),
      CData(unqualified("Qt"), list(), list(Constr("", unqualified("Qt"), list(Field("x", type_str()))))),
      fun_cmd("size", list(var_of("b", tsort("Box"))), type_int(), expr_int(2)),
      CProc(unqualified("fill"), list(), list(), list(var_of("b", tsort("Box"))), list(), SAssign(list((var_of("b", THole), expr_app("Box", list(ELit(LStr("")))))))))), list(), list()))

// the program of the commands cmds of the module main, which imports bag and box
function with_bags(cmds: List[Cmd]): Source :=
  Source(list(natives_prelude(); bags()) ++ list(Mod("main", "", list("bag", "box"), list(), list(), unplaced(cmds))), "main")

function in_bag(n: Id): Name :=
  Name(Some("bag"), n)

function in_box(n: Id): Name :=
  Name(Some("box"), n)

// the body of the last function of the checked program with_bags([cmd])
procedure body_of(in cmd: Cmd, out b: Expr) :=
  local q: Prog
  call check_program(in with_bags(list(cmd)), out q)
  match reverse(q.cmds)
    case list(CFun(_, _, _, _, body); _) =>
      assign b := body
    case _ =>
      assert false
  end

// size(Bag(1)) + size(Box("x"))
test by_arguments() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(), type_int(), expr_app("+", list(
    expr_app("size", list(expr_app("Bag", list(expr_int(1))))),
    expr_app("size", list(expr_app("Box", list(ELit(LStr("x"))))))))), out b)
  match b
    case EApp(_, list(EApp(EVar(Var(m, _)), _), EApp(EVar(Var(n, _)), _))) =>
      assert (m, n) == (in_bag("size"), in_box("size"))
    case _ =>
      assert false
  end

// (lambda x => size(x))(Box("x")), where size(x) stays open until the lambda is applied
test deferred() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(), type_int(), EApp(ELam(list(var_of("x", THole)), expr_app("size", list(expr_var("x")))), list(expr_app("Box", list(ELit(LStr("x"))))))), out b)
  match b
    case EApp(ELam(_, EApp(EVar(Var(name, typ)), _)), _) =>
      assert name == in_box("size")
      assert typ == TFun(list(TSort(in_box("Box"), list())), type_int())

    case _ =>
      assert false
  end

// size as a value of the declared result type Box -> Int
test by_result() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(), TFun(list(tsort("Box")), type_int()), expr_var("size")), out b)
  assert b == EVar(Var(in_box("size"), TFun(list(TSort(in_box("Box"), list())), type_int())))

// Leaf("s") constructs a Box, and the case Leaf(n) of a Bag is of bag
test constructors() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(), tsort("Box"), expr_app("Leaf", list(ELit(LStr("s"))))), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == in_box("Leaf")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("g", list(var_of("b", tsort("Bag"))), type_int(), EMatch(expr_var("b"), list(
    Branch("", PApp(unqualified("Leaf"), list(pat_var("n"))), None, expr_var("n")),
    Branch("", PApp(unqualified("Bag"), list(pat_var("n"))), None, expr_var("n"))))), out b)
  match b
    case EMatch(_, list(Branch(_, PApp(constr, _), _, _); _)) =>
      assert constr == in_bag("Leaf")
    case _ =>
      assert false
  end

// call fill(out b) for a local b: Box
test procedures() :=
  local q: Prog
  call check_program(in with_bags(list(
    CProc(unqualified("p"), list(), list(), list(), list(), SBlock(list(var_of("b", tsort("Box"))), list(SCall(unqualified("fill"), list(), list(var_of("b", THole)), list())))))), out q)
  match reverse(q.cmds)
    case list(CProc(_, _, _, _, _, SBlock(_, list(SCall(proc, _, _, _)))); _) =>
      assert proc == in_box("fill")
    case _ =>
      assert false
  end

// (lambda p => p.x)(Pt(3)), where the type of p is not known at the access
test fields() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(), type_int(), EApp(ELam(list(var_of("p", THole)), EField(expr_var("p"), "x")), list(expr_app("Pt", list(expr_int(3)))))), out b)
  match b
    case EApp(ELam(_, EApp(EVar(Var(name, _)), _)), _) =>
      assert name == in_bag("Pt.x")
    case _ =>
      assert false
  end

// compare of bags is that of bag, while == and compare of other types, also of type parameters, are the builtins
test builtins() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(), type_int(), expr_app("compare", list(expr_app("Bag", list(expr_int(1))), expr_app("Bag", list(expr_int(2)))))), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == in_bag("compare")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("g", list(), type_bool(), expr_app("==", list(expr_int(1), expr_int(2)))), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  call body_of(in CFun(unqualified("h"), list("A"), list(var_of("x", TParam("A"))), type_bool(), expr_app("==", list(expr_var("x"), expr_var("x")))), out b)
  match b
    case EApp(EVar(Var(name, _)), _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("k", list(), type_bool(), ELet(list(
    (var_of("e", THole), ELam(list(var_of("x", THole)), expr_app("==", list(expr_var("x"), expr_var("x")))))), ELit(LBool(true)))), out b)
  match b
    case ELet(list((_, ELam(_, EApp(EVar(Var(name, _)), _)))), _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end

// a local variable hides all declarations of its name
test locals() :=
  local b: Expr
  call body_of(in fun_cmd("f", list(var_of("size", type_int())), type_int(), expr_var("size")), out b)
  assert b == EVar(Var(unqualified("size"), type_int()))

test errors() :=
  local b: Expr
  try
    call body_of(in fun_cmd("f", list(), type_int(), expr_app("size", list(expr_int(1)))), out b)
    assert false
  catch
    case NoOverload(name, _) =>
      assert name == unqualified("size")
  end
  try
    call body_of(in fun_cmd("f", list(), type_bool(), ELet(list(
      (var_of("h", THole), ELam(list(var_of("x", THole)), expr_app("size", list(expr_var("x")))))), ELit(LBool(true)))), out b)
    assert false
  catch
    case Ambiguous(name, candidates) =>
      assert name == unqualified("size")
      assert size(candidates) == 2
  end
  try
    call body_of(in fun_cmd("f", list(), type_int(), expr_app("size", list(expr_int(1), expr_int(2)))), out b)
    assert false
  catch
    case WrongArity(name, arity) =>
      assert (name, arity) == (unqualified("size"), 2)
  end
