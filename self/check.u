// the type checker of ulang/src/ulang/Check.scala, which checks and elaborates programs of self/syntax.u in contexts of self/ctx.u,
// where the state is passed by reference, and errors are values of TypeError instead of messages,
// and which overloads names across modules: the declarations of a name in all visible modules are its candidates,
// and each use resolves to the one whose type fits, at once if only one fits, or else at the end of the command,
// when the uses that are still open are solved together

import syntax

import ctx
import map

// the types of unknowns by their index
type Subst :=
  Map[Int, Type]

type Env :=
  List[Name * (List[Type] * Type)]

// a use of an overloaded name that more than one candidate fits, by the placeholder that stands for it,
// with the candidates that fit so far, and the type of the use
data Pending :=
  | Pending(id: Name, name: Name, cands: List[Name * (List[Type] * Type)], typ: Type)

// the context, the substitution, the number of unknowns so far, the module whose declarations are checked
// with the modules it sees, the modules that each module sees, itself first, the open uses of overloaded names,
// and the declarations chosen for the placeholders of uses that were open
data State :=
  | State(
    ctx: Ctx,
    sub: Subst,
    count: Int,
    module: Id,
    visible: List[Id],
    table: List[Id * List[Id]],
    pending: List[Pending],
    chosen: Map[Name, Name]
  )

data TypeError :=
  | UnknownSort(Name)
  | SortArity(Name, Int, Int)
  | SortDefined(Name)
  | MissingType(Name)
  | UndeclaredParams(Name, List[Type])
  | CannotUnify(Type, Type)
  | InfiniteType(Type, Type)
  | UnknownVariable(Name)
  | NoOverload(Name, Type)
  | WrongArity(Name, Int)
  | AlreadyDefined(Name)
  | Duplicate(Str)
  | Ambiguous(Name, List[Name])
  | UnknownField(Name)
  | UnknownFieldType(Id, Type)
  | CountMismatch(Int, Int)
  | UnknownConstructor(Name)
  | NotExhaustive(Pat)
  | Unreachable(Pat)
  | NotAssignable(Name)
  | UnknownProcedure(Name)
  | UnknownException(Type)
  | TestParams(Id)

// the constructor of a pattern, where literals count as constructors without arguments
data Head :=
  | HCon(Name)
  | HLit(Val)

function with_ctx(s: State, c: Ctx): State :=
  s with ctx := c

// the state for checking a declaration of module m, where the substitution starts empty and unknowns are numbered
// from 1 again, since unknowns do not outlive the command that introduces them
function enter(s: State, m: Id): State :=
  s with sub := empty(), count := 0, module := m, visible := sees(m, s.table), pending := Nil, chosen := empty()

function sees(m: Id, vs: List[Id * List[Id]]): List[Id] :=
  match get(m, vs)
    case Some(ms) => ms
    case None => [m]
  end

function start(main: Id, vs: List[Id * List[Id]]): State :=
  State(initial(), empty(), 0, main, sees(main, vs), vs, Nil, empty())

// the commands of the modules with the module of each, where declarations get their module
function flatten(m: Id, cs: List[Cmd]): List[Id * Cmd] :=
  match cs
    case Nil => Nil
    case [CModule(n, ds); rest] => flatten(n, ds) ++ flatten(m, rest)
    case [c; rest] => [(m, qualify(m, c)); flatten(m, rest)]
  end

function in_module(m: Id, n: Name): Name :=
  Name(Some(m), n.base)

function qualify(m: Id, c: Cmd): Cmd :=
  match c
    case CSort(n, ps, t) => CSort(in_module(m, n), ps, t)
    case CData(n, ps, ks) => CData(in_module(m, n), ps, [qualify_constr(m, k) for k in ks])
    case CFun(n, ps, xss, r, b) => CFun(in_module(m, n), ps, xss, r, b)
    case CProc(n, ps, ins, outs, refs, b) => CProc(in_module(m, n), ps, ins, outs, refs, b)
    case _ => c
  end

function qualify_constr(m: Id, k: Constr): Constr :=
  k with name := in_module(m, k.name)

function imports_in(ds: List[Id * Cmd], m: Id): List[Id] :=
  match ds
    case Nil => Nil
    case [(k, CImport(n)); rest] if k == m => [n; imports_in(rest, m)]
    case [_; rest] => imports_in(rest, m)
  end

// each module sees itself, its direct imports, and the prelude with its imports, for the imports of each module
function visibility(imports: List[Id * List[Id]], main: Id): List[Id * List[Id]] :=
  [(m, distinct([m] ++ imports_of(imports, m) ++ ["prelude"] ++ imports_of(imports, "prelude"))) for m in distinct([main] ++ firsts(imports))]

function imports_of(imports: List[Id * List[Id]], m: Id): List[Id] :=
  match get(m, imports)
    case Some(ns) => ns
    case None => Nil
  end

// the declarations named n of a kind that the module sees, where its own declarations hide those of other modules
// and declared tells whether a name is a declaration of that kind
function visible_names(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := [d for d in names_of(s.ctx, n.base) if declared(d)] in
    match n
      case Name(Some(_), _) => if contains(n, ds) then [n] else Nil
      case Name(None, b) =>
        if contains(Name(Some(s.module), b), ds) then [Name(Some(s.module), b)] else [d for d in ds if is_visible(s, d)]
    end

// the declarations named n of a kind in all modules that the module sees, its own included, whose types decide
// among them
function overloads(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  match n
    case Name(Some(_), _) => [d for d in names_of(s.ctx, n.base) if declared(d) and d == n]
    case Name(None, _) => [d for d in names_of(s.ctx, n.base) if declared(d) and is_visible(s, d)]
  end

function is_visible(s: State, d: Name): Bool :=
  match d.module
    case Some(m) => contains(m, s.visible)
    case None => false
  end

function tbool(): Type :=
  TSort(unqualified("Bool"), Nil)

function tint(): Type :=
  TSort(unqualified("Int"), Nil)

function tstr(): Type :=
  TSort(unqualified("Str"), Nil)

function tchar(): Type :=
  TSort(unqualified("Char"), Nil)

function tlist(t: Type): Type :=
  TSort(list_name(), [t])

function fun(args: List[Type], res: Type): Type :=
  TFun(args, res)

function params(ps: List[Id]): List[Type] :=
  [TParam(p) for p in ps]

function basic(n: Name): Bool :=
  match n
    case Name(None, b) => contains(b, ["Bool", "Int", "Str", "Char"])
    case _ => false
  end

function literal(v: Val): Type :=
  match v
    case VUnit => TTuple(Nil)
    case VBool(_) => tbool()
    case VInt(_) => tint()
    case VStr(_) => tstr()
    case VChar(_) => tchar()
  end

function initial(): Ctx :=
  empty_ctx()

function arith(): List[Type] * Type :=
  (Nil, fun([tint(), tint()], tint()))

function logic(): List[Type] * Type :=
  (Nil, fun([tbool(), tbool()], tbool()))

// only what cannot be defined in the prelude, which are names without a module
function builtin(n: Name): List[List[Type] * Type] :=
  match n
    case Name(None, b) => builtin_scheme(b)
    case _ => Nil
  end

function builtin_scheme(b: Id): List[List[Type] * Type] :=
  let a := TParam("A") in
    match b
      case "+" => [arith()]
      case "-" => [arith()]
      case "*" => [arith()]
      case "/" => [arith()]
      case "%" => [arith()]
      case "<" => [(Nil, fun([tint(), tint()], tbool()))]
      case "==" => [([a], fun([a, a], tbool()))]
      case "compare" => [([a], fun([a, a], tint()))]
      case "and" => [logic()]
      case "or" => [logic()]
      case "chars" => [(Nil, fun([tstr()], tlist(tchar())))]
      case "string" => [(Nil, fun([tlist(tchar())], tstr()))]
      case "ord" => [(Nil, fun([tchar()], tint()))]
      case "chr" => [(Nil, fun([tint()], tchar()))]
      case "^" => [(Nil, fun([tstr(), tstr()], tstr()))]
      case "str_size" => [(Nil, fun([tstr()], tint()))]
      case "str_join" => [(Nil, fun([tstr(), tlist(tstr())], tstr()))]
      case "str_slice" => [(Nil, fun([tstr(), tint(), tint()], tstr()))]
      case "str_split" => [(Nil, fun([tstr(), tchar()], tlist(tstr())))]
      case "str_get" => [(Nil, fun([tstr(), tint()], tchar()))]
      case "str_contains" => [(Nil, fun([tstr(), tchar()], tbool()))]
      case "str_compare" => [(Nil, fun([tstr(), tstr()], tint()))]
      case "str_show" => [(Nil, fun([tint()], tstr()))]
      case "str_quote" => [(Nil, fun([tstr()], tstr()))]
      case "str_number" => [(Nil, fun([tstr()], TSort(option_name(), [tint()])))]
      case "is_digit" => [(Nil, fun([tchar()], tbool()))]
      case "is_letter" => [(Nil, fun([tchar()], tbool()))]
      case "is_space" => [(Nil, fun([tchar()], tbool()))]
      case _ => Nil
    end

function is_meta(t: Type): Bool :=
  match t
    case TMeta(_) => true
    case _ => false
  end

// the Params and Metas in t
function free(t: Type): List[Type] :=
  match t
    case TParam(_) => [t]
    case TMeta(_) => [t]
    case THole => Nil
    case TSort(_, args) => distinct(concat([free(a) for a in args]))
    case TFun(args, r) => distinct(concat([free(a) for a in args ++ [r]]))
    case TProc(is, os, rs) => distinct(concat([free(a) for a in is ++ os ++ rs]))
    case TTuple(ts) => distinct(concat([free(a) for a in ts]))
  end

function holes(t: Type): Bool :=
  match t
    case THole => true
    case TSort(_, args) => exists(args, holes)
    case TFun(args, r) => exists(args, holes) or holes(r)
    case TProc(is, os, rs) => exists(is ++ os ++ rs, holes)
    case TTuple(ts) => exists(ts, holes)
    case _ => false
  end

function subst(t: Type, m: List[Type * Type]): Type :=
  match t
    case TSort(n, args) => TSort(n, [subst(a, m) for a in args])
    case TFun(args, r) => TFun([subst(a, m) for a in args], subst(r, m))
    case TProc(is, os, rs) => TProc([subst(a, m) for a in is], [subst(a, m) for a in os], [subst(a, m) for a in rs])
    case TTuple(ts) => TTuple([subst(a, m) for a in ts])
    case _ =>
      match get(t, m)
        case Some(u) => u
        case None => t
      end
  end

function resolve(su: Subst, t: Type): Type :=
  match t
    case TMeta(i) =>
      match get(i, su)
        case Some(u) => resolve(su, u)
        case None => t
      end
    case _ => t
  end

function occurs(su: Subst, i: Int, t: Type): Bool :=
  match resolve(su, t)
    case TMeta(j) => i == j
    case TSort(_, args) => exists(args, lambda a => occurs(su, i, a))
    case TFun(args, r) => exists(args, lambda a => occurs(su, i, a)) or occurs(su, i, r)
    case TProc(is, os, rs) => exists(is ++ os ++ rs, lambda a => occurs(su, i, a))
    case TTuple(ts) => exists(ts, lambda a => occurs(su, i, a))
    case _ => false
  end

function constructor_scheme(k: List[Type] * List[Type] * Type): List[Type] * Type :=
  match k
    case (ps, ks, r) => (ps, if ks == Nil then r else fun(ks, r))
  end

function constructor_of(c: Ctx, k: Name): List[Type] * Type :=
  match constr_of(c, k)
    case Some(kc) => constructor_scheme(kc)
    case None => (Nil, TTuple(Nil))
  end

// the meanings of n with their names, where local variables hide functions, constructors, and builtins
function candidates(s: State, env: Env, n: Name): List[Name * (List[Type] * Type)] :=
  match get(n, env)
    case Some(sc) => [(n, sc)]
    case None =>
      concat([[(f, sc) for sc in schemes_of(s.ctx, f)] for f in overloads(s, n, lambda f => is_fun(s.ctx, f))]) ++
        [(k, constructor_of(s.ctx, k)) for k in overloads(s, n, lambda k => is_constr(s.ctx, k))] ++
        [(p, proc_scheme(s.ctx, p)) for p in overloads(s, n, lambda p => is_proc(s.ctx, p))] ++
        [(n, sc) for sc in builtin(n)]
  end

// the accessors or updaters T.f of all datatypes T for the field f, which is .name or .name:=, of all modules,
// since the type of a value need not be visible where its fields are used
function accessors(c: Ctx, f: Id, es: List[Id * List[Name]]): List[Name * (List[Type] * Type)] :=
  match es
    case Nil => Nil
    case [(b, ds); rest] =>
      if ends_with(b, f) then concat([[(d, sc) for sc in schemes_of(c, d)] for d in ds]) ++ accessors(c, f, rest) else accessors(c, f, rest)
  end

function ends_with(b: Id, f: Id): Bool :=
  if str_size(b) > str_size(f) then str_slice(b, str_size(b) - str_size(f), str_size(b)) == f else false

// a procedure is a value of its type (in A, out B, ref C)
function proc_scheme(c: Ctx, p: Name): List[Type] * Type :=
  match proc_of(c, p)
    case Some((ps, is, os, rs)) => (ps, TProc(is, os, rs))
    case None => (Nil, THole)
  end

function with_arity(cs: List[Name * (List[Type] * Type)], k: Int): List[Name * (List[Type] * Type)] :=
  match cs
    case Nil => Nil
    case [(n, (ps, t)); rest] => if arity(t) == k then [(n, (ps, t)); with_arity(rest, k)] else with_arity(rest, k)
  end

function has_arity(scs: List[List[Type] * Type], k: Int): Bool :=
  match scs
    case Nil => false
    case [(_, t); rest] => arity(t) == k or has_arity(rest, k)
  end

function bind(xs: List[Var]): Env :=
  [(x.name, (Nil, x.typ)) for x in xs]

// the unknowns of the types of env, which a let cannot generalize
function fixed(su: Subst, env: Env): List[Type] :=
  match env
    case Nil => Nil
    case [(_, (ps, t)); rest] => diff(free(zonk_type(su, t)), ps) ++ fixed(su, rest)
  end

function generalize(su: Subst, env: Env, t: Type): List[Type] * Type :=
  let fx := fixed(su, env), u := zonk_type(su, t) in
  ([m for m in free(u) if is_meta(m) and not contains(m, fx)], u)

// the unknowns of open uses of overloaded names stay fixed, too, since their declarations are not chosen yet
function generalized(s: State, env: Env, xs: List[Var]): Env :=
  let waiting := [(p.id, (Nil, p.typ)) for p in s.pending] in [(x.name, generalize(s.sub, waiting ++ env, x.typ)) for x in xs]

// the pattern of a case, and whether it has no guard, such that it may cover values
function case_of[A](b: Branch[A]): Pat * Bool :=
  match b
    case Branch(p, g, _) => (p, g == None)
  end

function zonk_guard(s: State, g: Option[Expr]): Option[Expr] :=
  match g
    case Some(e) => Some(zonk_expr(s, e))
    case None => None
  end

function zonk_type(su: Subst, t: Type): Type :=
  match resolve(su, t)
    case TSort(n, args) => TSort(n, [zonk_type(su, a) for a in args])
    case TFun(args, r) => TFun([zonk_type(su, a) for a in args], zonk_type(su, r))
    case TProc(is, os, rs) => TProc([zonk_type(su, a) for a in is], [zonk_type(su, a) for a in os], [zonk_type(su, a) for a in rs])
    case TTuple(ts) => TTuple([zonk_type(su, a) for a in ts])
    case u => u
  end

// the declaration chosen for an overloaded name, which stands for it until the end of the command
function settled(s: State, n: Name): Name :=
  match n.module
    case Some("?") =>
      match get(n, s.chosen)
        case Some(m) => m
        case None => n
      end
    case _ => n
  end

function zonk_var(s: State, x: Var): Var :=
  Var(settled(s, x.name), zonk_type(s.sub, x.typ))

function zonk_vars(s: State, xs: List[Var]): List[Var] :=
  [zonk_var(s, x) for x in xs]

function zonk_expr(s: State, e: Expr): Expr :=
  match e
    case ELit(_) => e
    case EVar(x) => EVar(zonk_var(s, x))
    case EApp(f, args) => EApp(zonk_expr(s, f), [zonk_expr(s, a) for a in args])
    case ELam(xs, b) => ELam(zonk_vars(s, xs), zonk_expr(s, b))
    case EProc(is, os, rs, b) => EProc(zonk_vars(s, is), zonk_vars(s, os), zonk_vars(s, rs), zonk_stmt(s, b))
    case ELet(ps, b) => ELet([zonk_binding(s, p) for p in ps], zonk_expr(s, b))
    case EIte(c, l, r) => EIte(zonk_expr(s, c), zonk_expr(s, l), zonk_expr(s, r))
    case EMatch(a, bs) => EMatch(zonk_expr(s, a), [zonk_expr_branch(s, b) for b in bs])
    case EComp(r, xs, ls, c) => EComp(zonk_expr(s, r), zonk_vars(s, xs), [zonk_expr(s, l) for l in ls], zonk_expr(s, c))
    case ETuple(es) => ETuple([zonk_expr(s, e) for e in es])
    case ERaise(a, t) => ERaise(zonk_expr(s, a), zonk_type(s.sub, t))
  end

function zonk_binding(s: State, p: Var * Expr): Var * Expr :=
  match p
    case (x, e) => (zonk_var(s, x), zonk_expr(s, e))
  end

function zonk_expr_branch(s: State, b: Branch[Expr]): Branch[Expr] :=
  match b
    case Branch(p, g, e) => Branch(zonk_pat(s, p), zonk_guard(s, g), zonk_expr(s, e))
  end

function zonk_pat(s: State, p: Pat): Pat :=
  match p
    case PVar(x) => PVar(zonk_var(s, x))
    case PApp(n, args) => PApp(n, [zonk_pat(s, a) for a in args])
    case PTuple(ps) => PTuple([zonk_pat(s, q) for q in ps])
    case _ => p
  end

function zonk_stmt(s: State, x: Stmt): Stmt :=
  match x
    case SSkip => x
    case SAssign(ps) => SAssign([zonk_binding(s, p) for p in ps])
    case SBlock(xs, ys) => SBlock(zonk_vars(s, xs), [zonk_stmt(s, y) for y in ys])
    case SIf(c, l, r) => SIf(zonk_expr(s, c), zonk_stmt(s, l), zonk_stmt(s, r))
    case SWhile(c, b) => SWhile(zonk_expr(s, c), zonk_stmt(s, b))
    case SCall(p, ins, outs, refs) => SCall(settled(s, p), [zonk_expr(s, e) for e in ins], zonk_vars(s, outs), zonk_vars(s, refs))
    case SMatch(a, bs) => SMatch(zonk_expr(s, a), [zonk_stmt_branch(s, b) for b in bs])
    case SAssert(c) => SAssert(zonk_expr(s, c))
    case SRaise(a, t) => SRaise(zonk_expr(s, a), zonk_type(s.sub, t))
    case STry(b, hs) => STry(zonk_stmt(s, b), [zonk_handler(s, h) for h in hs])
  end

function zonk_stmt_branch(s: State, b: Branch[Stmt]): Branch[Stmt] :=
  match b
    case Branch(p, g, y) => Branch(zonk_pat(s, p), zonk_guard(s, g), zonk_stmt(s, y))
  end

function zonk_handler(s: State, h: Handler): Handler :=
  match h
    case Handler(t, p, g, b) => Handler(zonk_type(s.sub, t), zonk_pat(s, p), zonk_guard(s, g), zonk_stmt(s, b))
  end

function zonk_cmd(s: State, c: Cmd): Cmd :=
  match c
    case CFun(n, ps, xss, r, b) => CFun(n, ps, [zonk_vars(s, xs) for xs in xss], zonk_type(s.sub, r), zonk_expr(s, b))
    case CProc(n, ps, ins, outs, refs, b) => CProc(n, ps, zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, b))
    case CTest(n, xs, b) => CTest(n, xs, zonk_stmt(s, b))
    case _ => c
  end

// exceptions are told apart by their types at runtime, which must therefore be known after checking
function unknown_type(t: Type): Option[Type] :=
  if free(t) == Nil then None else Some(t)

// the type of an exception that is not known, also of those raised in expressions
function unknown_in(x: Stmt): Option[Type] :=
  match x
    case SAssign(ps) => unknown_in_exprs(seconds(ps))
    case SBlock(_, ys) => unknown_in_all(ys)
    case SIf(c, l, r) => or_else(unknown_in_expr(c), or_else(unknown_in(l), unknown_in(r)))
    case SWhile(c, b) => or_else(unknown_in_expr(c), unknown_in(b))
    case SCall(_, ins, _, _) => unknown_in_exprs(ins)
    case SMatch(a, bs) => or_else(unknown_in_expr(a), unknown_in_branches(bs))
    case SAssert(c) => unknown_in_expr(c)
    case SRaise(a, t) => or_else(unknown_type(t), unknown_in_expr(a))
    case STry(b, hs) => or_else(unknown_in(b), unknown_in_handlers(hs))
    case _ => None
  end

function unknown_in_expr(e: Expr): Option[Type] :=
  match e
    case ERaise(a, t) => or_else(unknown_type(t), unknown_in_expr(a))
    case EApp(f, args) => unknown_in_exprs([f; args])
    case ELam(_, b) => unknown_in_expr(b)
    case EProc(_, _, _, b) => unknown_in(b)
    case ELet(ps, b) => unknown_in_exprs(seconds(ps) ++ [b])
    case EIte(c, l, r) => unknown_in_exprs([c, l, r])
    case EMatch(a, bs) => unknown_in_exprs([a; concat([branch_exprs(b) for b in bs])])
    case EComp(r, _, ls, c) => unknown_in_exprs([r, c; ls])
    case ETuple(es) => unknown_in_exprs(es)
    case _ => None
  end

function unknown_in_exprs(es: List[Expr]): Option[Type] :=
  match es
    case Nil => None
    case [e; rest] => or_else(unknown_in_expr(e), unknown_in_exprs(rest))
  end

function branch_exprs(b: Branch[Expr]): List[Expr] :=
  match b
    case Branch(_, Some(g), e) => [g, e]
    case Branch(_, None, e) => [e]
  end

function unknown_in_all(xs: List[Stmt]): Option[Type] :=
  match xs
    case Nil => None
    case [y; ys] => or_else(unknown_in(y), unknown_in_all(ys))
  end

function unknown_in_branches(bs: List[Branch[Stmt]]): Option[Type] :=
  match bs
    case Nil => None
    case [Branch(_, Some(g), y); rest] => or_else(unknown_in_expr(g), or_else(unknown_in(y), unknown_in_branches(rest)))
    case [Branch(_, None, y); rest] => or_else(unknown_in(y), unknown_in_branches(rest))
  end

// handlers of _ catch exceptions of any type
function unknown_in_handlers(hs: List[Handler]): Option[Type] :=
  match hs
    case Nil => None
    case [Handler(_, PWild, _, b); rest] => or_else(unknown_in(b), unknown_in_handlers(rest))
    case [Handler(t, _, _, b); rest] => or_else(unknown_type(t), or_else(unknown_in(b), unknown_in_handlers(rest)))
  end

function unknown_in_cmd(c: Cmd): Option[Type] :=
  match c
    case CFun(_, _, _, _, b) => unknown_in_expr(b)
    case CProc(_, _, _, _, _, b) => unknown_in(b)
    case CTest(_, _, b) => unknown_in(b)
    case _ => None
  end

function head_of(p: Pat): Option[Head * List[Pat]] :=
  match p
    case PApp(n, args) => Some((HCon(n), args))
    case PTuple(ps) => Some((HCon(tuple_name()), ps))
    case PLit(v) => Some((HLit(v), Nil))
    case _ => None
  end

// the constructors in the first column
function heads(rows: List[List[Pat]]): List[Head] :=
  match rows
    case Nil => Nil
    case [[p; _]; rest] =>
      match head_of(p)
        case Some((h, _)) => [h; heads(rest)]
        case None => heads(rest)
      end
    case [Nil; rest] => heads(rest)
  end

// the argument types of constructor k of a datatype with type arguments args
function field_types(c: Ctx, k: Name, args: List[Type]): List[Type] :=
  match constr_of(c, k)
    case Some((ps, ks, _)) => [subst(a, zip(ps, args)) for a in ks]
    case None => Nil
  end

// all constructors of t with their argument types, if there are finitely many
function constructors_of(c: Ctx, su: Subst, t: Type): Option[List[Head * List[Type]]] :=
  match zonk_type(su, t)
    case TSort(Name(None, "Bool"), Nil) => Some([(HLit(VBool(true)), Nil), (HLit(VBool(false)), Nil)])
    case TTuple(ts) => Some([(HCon(tuple_name()), ts)])
    case TSort(n, args) =>
      match members_of(c, n)
        case Some(ks) => Some([(HCon(k), field_types(c, k, args)) for k in ks])
        case None => None
      end
    case _ => None
  end

function fields_of(c: Ctx, su: Subst, t: Type, h: Head): List[Type] :=
  match constructors_of(c, su, t)
    case Some(ks) =>
      match get(h, ks)
        case Some(ts) => ts
        case None => Nil
      end
    case None => Nil
  end

function covers(hs: List[Head], ks: List[Head * List[Type]]): Bool :=
  match ks
    case Nil => true
    case [(h, _); rest] => contains(h, hs) and covers(hs, rest)
  end

// the rows whose first pattern has no constructor, without it
function defaults(rows: List[List[Pat]]): List[List[Pat]] :=
  match rows
    case Nil => Nil
    case [[p; ps]; rest] =>
      match head_of(p)
        case Some(_) => defaults(rest)
        case None => [ps; defaults(rest)]
      end
    case [Nil; rest] => defaults(rest)
  end

function specialize(rows: List[List[Pat]], h: Head, n: Int): List[List[Pat]] :=
  match rows
    case Nil => Nil
    case [[p; ps]; rest] =>
      match head_of(p)
        case Some((g, args)) => if g == h then [args ++ ps; specialize(rest, h, n)] else specialize(rest, h, n)
        case None => [replicate(n, PWild) ++ ps; specialize(rest, h, n)]
      end
    case [Nil; rest] => specialize(rest, h, n)
  end

// some values of types ts match q but no row
function useful(c: Ctx, su: Subst, rows: List[List[Pat]], q: List[Pat], ts: List[Type]): Bool :=
  match (q, ts)
    case (Nil, _) => rows == Nil
    case ([p; ps], [t; rest]) =>
      match head_of(p)
        case Some((h, args)) => useful(c, su, specialize(rows, h, size(args)), args ++ ps, fields_of(c, su, t, h) ++ rest)
        case None =>
          match constructors_of(c, su, t)
            case Some(ks) =>
              if covers(heads(rows), ks) then useful_in(c, su, rows, ks, ps, rest) else useful(c, su, defaults(rows), ps, rest)
            case None => useful(c, su, defaults(rows), ps, rest)
          end
      end
    case ([_; _], Nil) => false
  end

function useful_in(c: Ctx, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], ps: List[Pat], rest: List[Type]): Bool :=
  match ks
    case Nil => false
    case [(h, args); more] =>
      useful(c, su, specialize(rows, h, size(args)), replicate(size(args), PWild) ++ ps, args ++ rest) or
      useful_in(c, su, rows, more, ps, rest)
  end

function witness(h: Head, args: List[Pat]): Pat :=
  match h
    case HCon(n) => if n == tuple_name() then PTuple(args) else PApp(n, args)
    case HLit(v) => PLit(v)
  end

// values of types ts, as patterns, that no row matches
function missing(c: Ctx, su: Subst, rows: List[List[Pat]], ts: List[Type]): Option[List[Pat]] :=
  match ts
    case Nil => if rows == Nil then Some(Nil) else None
    case [t; rest] => missing_in(c, su, rows, heads(rows), constructors_of(c, su, t), rest)
  end

// hs are the constructors in the first column, cs are all constructors of its type if there are finitely many
function missing_in(c: Ctx, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match cs
    case Some(ks) => if covers(hs, ks) then first_missing(c, su, rows, ks, rest) else other_missing(c, su, rows, hs, cs, rest)
    case None => other_missing(c, su, rows, hs, cs, rest)
  end

function first_missing(c: Ctx, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], rest: List[Type]): Option[List[Pat]] :=
  match ks
    case Nil => None
    case [(h, args); more] =>
      match missing(c, su, specialize(rows, h, size(args)), args ++ rest)
        case Some(ws) => Some([witness(h, take(size(args), ws)); drop(size(args), ws)])
        case None => first_missing(c, su, rows, more, rest)
      end
  end

function other_missing(c: Ctx, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match missing(c, su, defaults(rows), rest)
    case Some(ws) => Some([uncovered(hs, cs); ws])
    case None => None
  end

// a value of the first column that hs do not cover
function uncovered(hs: List[Head], cs: Option[List[Head * List[Type]]]): Pat :=
  match cs
    case Some(ks) => if hs == Nil then PWild else first_uncovered(hs, ks)
    case None => PWild
  end

function first_uncovered(hs: List[Head], ks: List[Head * List[Type]]): Pat :=
  match ks
    case Nil => PWild
    case [(h, args); rest] => if contains(h, hs) then first_uncovered(hs, rest) else witness(h, replicate(size(args), PWild))
  end

procedure fresh(out t: Type, ref s: State) :=
  assign t := TMeta(s.count + 1), s := s with count := s.count + 1

procedure bind_meta(in i: Int, t: Type, ref s: State) :=
  if occurs(s.sub, i, t)
    raise InfiniteType(TMeta(i), zonk_type(s.sub, t))
  end

  assign s := s with sub := put(i, t, s.sub)

procedure unify(in t1: Type, t2: Type, ref s: State) :=
  local a := resolve(s.sub, t1), b := resolve(s.sub, t2)

  match (a, b)
    case (TMeta(i), TMeta(j)) =>
      if i != j
        call bind_meta(in i, b, ref s)
      end

    case (TMeta(i), _) =>
      call bind_meta(in i, b, ref s)

    case (_, TMeta(j)) =>
      call bind_meta(in j, a, ref s)

    case (TParam(x), TParam(y)) =>
      if x != y
        raise CannotUnify(a, b)
      end

    case (TSort(f, xs), TSort(g, ys)) =>
      if f == g and size(xs) == size(ys)
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TFun(xs, r1), TFun(ys, r2)) =>
      if size(xs) == size(ys)
        call unifies(in xs ++ [r1], ys ++ [r2], ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TTuple(xs), TTuple(ys)) =>
      if size(xs) == size(ys)
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TProc(xs, ys, zs), TProc(us, vs, ws)) =>
      if size(xs) == size(us) and size(ys) == size(vs) and size(zs) == size(ws)
        call unifies(in xs ++ ys ++ zs, us ++ vs ++ ws, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case _ =>
      raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
  end

procedure unifies(in xs: List[Type], ys: List[Type], ref s: State) :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) =>
      call   unify(in x, y, ref s)
      call   unifies(in xs1, ys1, ref s)
    case (Nil, Nil) =>
      skip
    case _ =>
      raise CountMismatch(size(xs), size(ys))
  end

// a fresh unknown for each of xs
procedure fresh_list[A](in xs: List[A], out ts: List[Type], ref s: State) :=
  local t: Type, rest: List[Type]

  match xs
    case Nil =>
      assign ts := Nil
    case [_; more] =>
      call   fresh(out t, ref s)
      call   fresh_list(in more, out rest, ref s)
      assign ts := [t; rest]
  end

procedure instance(in ps: List[Type], out m: List[Type * Type], ref s: State) :=
  local t: Type, rest: List[Type * Type]

  match ps
    case Nil =>
      assign m := Nil
    case [p; qs] =>
      call   fresh(out t, ref s)
      call   instance(in qs, out rest, ref s)
      assign m := [(p, t); rest]
  end

procedure instantiate(in sc: List[Type] * Type, out t: Type, ref s: State) :=
  local m: List[Type * Type]

  match sc
    case (ps, u) =>
      call   instance(in ps, out m, ref s)
      assign t := subst(zonk_type(s.sub, u), m)
  end

procedure unique(in ns: List[Name]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(qualified(n))
    case None =>
      skip
  end

procedure unique_ids(in ns: List[Id]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(n)
    case None =>
      skip
  end

// the one of the names ns that n refers to
procedure same_length(in m: Int, n: Int) :=
  if m != n
    raise CountMismatch(m, n)
  end

procedure arguments(in n: Name, k: Int, args: List[Type]) :=
  if size(args) != k
    raise SortArity(n, k, size(args))
  end

// expands type definitions and replaces holes by fresh unknowns
procedure normalize(in t: Type, out u: Type, ref s: State) :=
  local us: List[Type], v: Type

  match t
    case THole =>
      call fresh(out u, ref s)

    case TParam(_) =>
      assign u := t

    case TMeta(_) =>
      assign u := t

    case TFun(args, r) =>
      call   normalizes(in args, out us, ref s)
      call   normalize(in r, out v, ref s)
      assign u := TFun(us, v)

    case TTuple(ts) =>
      call   normalizes(in ts, out us, ref s)
      assign u := TTuple(us)

    case TProc(is, os, rs) =>
      call   normalizes(in is ++ os ++ rs, out us, ref s)
      assign u := TProc(take(size(is), us), take(size(os), drop(size(is), us)), drop(size(is) + size(os), us))

    case TSort(n, args) =>
      if basic(n)
        call   arguments(in n, 0, args)
        assign u := t
      else
        match visible_names(s, n, lambda t => is_sort(s.ctx, t))
          case [m] =>
            call normalize_sort(in m, args, out u, ref s)
          case Nil =>
            raise UnknownSort(n)
          case ms =>
            raise Ambiguous(n, ms)
        end
      end
  end

procedure normalize_sort(in n: Name, args: List[Type], out u: Type, ref s: State) :=
  local us: List[Type]

  match data_of(s.ctx, n)
    case Some(k) =>
      call   arguments(in n, k, args)
      call   normalizes(in args, out us, ref s)
      assign u := TSort(n, us)
    case None =>
      match alias_of(s.ctx, n)
        case Some((ps, rhs)) =>
          call   arguments(in n, size(ps), args)
          call   normalizes(in args, out us, ref s)
          assign u := subst(rhs, zip(params(ps), us))
        case None =>
          raise UnknownSort(n)
      end
  end

procedure normalizes(in ts: List[Type], out us: List[Type], ref s: State) :=
  local u: Type, rest: List[Type]

  match ts
    case Nil =>
      assign us := Nil
    case [t; more] =>
      call   normalize(in t, out u, ref s)
      call   normalizes(in more, out rest, ref s)
      assign us := [u; rest]
  end

procedure known(in t: Type, what: Name, out u: Type, ref s: State) :=
  if holes(t)
    raise MissingType(what)
  end
  call normalize(in t, out u, ref s)

procedure knowns(in ts: List[Type], what: Name, out us: List[Type], ref s: State) :=
  local u: Type, rest: List[Type]

  match ts
    case Nil =>
      assign us := Nil
    case [t; more] =>
      call   known(in t, what, out u, ref s)
      call   knowns(in more, what, out rest, ref s)
      assign us := [u; rest]
  end

// the variables of a lambda, let, or comprehension
procedure formals(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call   unique(in names(xs))
  call   normalize_vars(in xs, out ys, ref s)

procedure normalize_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  local u: Type, rest: List[Var]

  match xs
    case Nil =>
      assign ys := Nil
    case [Var(n, t); more] =>
      call   normalize(in t, out u, ref s)
      call   normalize_vars(in more, out rest, ref s)
      assign ys := [Var(n, u); rest]
  end

// the parameters and locals, which have types
procedure signature(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call   unique(in names(xs))
  call   known_vars(in xs, out ys, ref s)

procedure known_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  local u: Type, rest: List[Var]

  match xs
    case Nil =>
      assign ys := Nil
    case [Var(n, t); more] =>
      call   known(in t, n, out u, ref s)
      call   known_vars(in more, out rest, ref s)
      assign ys := [Var(n, u); rest]
  end

// a use of n elaborated with an instance of sc, where w is normalized
procedure use(in n: Name, w: Type, sc: List[Type] * Type, out x: Var, ref s: State) :=
  local u: Type

  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)
  assign x := Var(n, u)

// a use of n of type w, which is normalized, as the one of the candidates cs that fits w
procedure use_name(in n: Name, cs: List[Name * (List[Type] * Type)], w: Type, out x: Var, ref s: State) :=
  local m: Name

  match cs
    case Nil =>
      raise UnknownVariable(n)
    case [(m1, sc)] =>
      call use(in m1, w, sc, out x, ref s)
    case _ =>
      call   choose(in n, cs, w, out m, ref s)
      assign x := Var(m, w)
  end

// the one of the candidates cs that fits w, or a placeholder for the use if several fit, which stays open
procedure choose(in n: Name, cs: List[Name * (List[Type] * Type)], w: Type, out m: Name, ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State]

  call trials(in cs, w, s, out ok)
  match ok
    case Nil =>
      raise NoOverload(n, zonk_type(s.sub, w))
    case [((m1, _), s1)] =>
      assign m := m1, s := s1
    case _ =>
      assign m := Name(Some("?"), str_show(s.count + 1))
      assign s := s with count := s.count + 1, pending := s.pending ++ [Pending(m, n, firsts(ok), w)]
  end

// the candidates that fit w, each with the state after unifying its instance with w
procedure trials(in cs: List[Name * (List[Type] * Type)], w: Type, s: State, out ok: List[(Name * (List[Type] * Type)) * State]) :=
  local rest: List[(Name * (List[Type] * Type)) * State], u: State, failed: Option[TypeError]

  match cs
    case Nil =>
      assign ok := Nil
    case [(m, sc); more] =>
      call   trials(in more, w, s, out rest)
      assign u := s, failed := None
      try
        call trial(in sc, w, ref u)
      catch
        case e =>
          assign failed := Some(e)
      end

      if failed == None
        assign ok := [((m, sc), u); rest]
      else
        assign ok := rest
      end
  end

procedure trial(in sc: List[Type] * Type, w: Type, ref s: State) :=
  local u: Type

  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)

// the open uses, until none can be decided, where each is decided once one of its candidates fits
procedure solve(ref s: State) :=
  local changed := true, ps: List[Pending]

  while changed
    assign ps := s.pending, changed := false
    assign s := s with pending := Nil
    call   revisit(in ps, ref changed, s)
  end

procedure revisit(in ps: List[Pending], ref changed: Bool, s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State]

  match ps
    case Nil =>
      skip
    case [p; rest] =>
      call trials(in p.cands, p.typ, s, out ok)
      match ok
        case Nil =>
          raise NoOverload(p.name, zonk_type(s.sub, p.typ))
        case [((m, _), s1)] =>
          assign s := s1 with chosen := put(p.id, m, s1.chosen)
          assign changed := true
        case _ =>
          assign s := s with pending := s.pending ++ [p with cands := firsts(ok)]
          if size(ok) < size(p.cands)
            assign changed := true
          end
      end

      call revisit(in rest, ref changed, s)
  end

// all uses decided at the end of a command, where the declaration of the module itself is taken among several
// that fit, as when it hid those of other modules
procedure settle(ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State]

  call solve(ref s)
  while s.pending != Nil
    match s.pending
      case [p; rest] =>
        call trials(in own(s, p.cands), p.typ, s, out ok)
        match ok
          case [((m, _), s1)] =>
            assign s := s1 with pending := rest, chosen := put(p.id, m, s1.chosen)
            call   solve(ref s)
          case _ =>
            raise Ambiguous(p.name, firsts(p.cands))
        end
      case Nil =>
        skip
    end
  end

function own[A](s: State, cs: List[Name * A]): List[Name * A] :=
  match cs
    case Nil => Nil
    case [(n, a); rest] => if n.module == Some(s.module) then [(n, a); own(s, rest)] else own(s, rest)
  end

procedure infer(in env: Env, e: Expr, out e1: Expr, t: Type, ref s: State) :=
  local sc: List[Type] * Type, m: Name, x: Var, xs: List[Var], ys: List[Var], zs: List[Var], b: Expr, c: Expr, l: Expr, u: Type, w: Type,
    es: List[Expr], ts: List[Type], bs: List[Branch[Expr]], y: Stmt

  match e
    case ELit(v) =>
      assign e1 := e, t := literal(v)

    case EVar(Var(n, a)) =>
      call   normalize(in a, out w, ref s)
      call   use_name(in n, candidates(s, env, n), w, out x, ref s)
      assign e1 := EVar(x), t := x.typ

    case EApp(f, args) =>
      call application(in env, f, args, out e1, t, ref s)

    case ELam(bound, body) =>
      call   formals(in bound, out xs, ref s)
      call   infer(in bind(xs) ++ env, body, out b, u, ref s)
      assign e1 := ELam(xs, b), t := fun(types(xs), u)

    // the body sees the variables around it, but assigns only the outs and refs of the lambda
    case EProc(is, os, rs, body) =>
      call   unique(in names(is ++ os ++ rs))
      call   formals(in is, out xs, ref s)
      call   formals(in os, out ys, ref s)
      call   formals(in rs, out zs, ref s)
      call   statement(in bind(xs ++ ys ++ zs) ++ env, names(ys ++ zs), body, out y, ref s)
      assign e1 := EProc(xs, ys, zs, y), t := TProc(types(xs), types(ys), types(zs))

    case ELet(bound, body) =>
      call   formals(in firsts(bound), out xs, ref s)
      call   checks(in env, seconds(bound), types(xs), out es, ref s)
      call   solve(ref s)
      call   infer(in generalized(s, env, xs) ++ env, body, out b, u, ref s)
      assign e1 := ELet(zip(xs, es), b), t := u

    case EIte(cond, left, right) =>
      call   check(in env, cond, tbool(), out c, ref s)
      call   infer(in env, left, out l, u, ref s)
      call   check(in env, right, u, out b, ref s)
      assign e1 := EIte(c, l, b), t := u

    case EComp(result, bound, lists, cond) =>
      call   formals(in bound, out xs, ref s)
      call   same_length(in size(xs), size(lists))
      call   generators(in env, xs, lists, out es, ref s)
      call   check(in bind(xs) ++ env, cond, tbool(), out c, ref s)
      call   infer(in bind(xs) ++ env, result, out b, u, ref s)
      assign e1 := EComp(b, xs, es, c), t := tlist(u)

    case ETuple(items) =>
      call   infers(in env, items, out es, ts, ref s)
      assign e1 := ETuple(es), t := TTuple(ts)

    // the exception, whose type must be known after checking, and the expression of any type
    case ERaise(arg, a) =>
      call   infer(in env, arg, out c, u, ref s)
      call   normalize(in a, out w, ref s)
      call   unify(in u, w, ref s)
      call   fresh(out t, ref s)
      assign e1 := ERaise(c, u)

    case EMatch(arg, cases) =>
      call   fresh(out t, ref s)
      call   infer(in env, arg, out c, u, ref s)
      call   expr_branches(in env, cases, u, t, out bs, ref s)
      call   solve(ref s)
      call   coverage(in s, u, [case_of(br) for br in bs])
      assign e1 := EMatch(c, bs)
  end

// overloaded names are resolved by their number of arguments and the types of the arguments and the result,
// where the arguments are inferred first
procedure application(in env: Env, f: Expr, args: List[Expr], out e1: Expr, t: Type, ref s: State) :=
  local cs: List[Name * (List[Type] * Type)], x: Var, f1: Expr, u: Type, w: Type, args1: List[Expr], ts: List[Type]

  match f
    case EVar(Var(Name(None, b), a)) if str_size(b) > 1 and str_get(b, 0) == '.' =>
      call field_access(in env, b, a, args, out e1, t, ref s)

    case EVar(Var(n, a)) =>
      assign cs := candidates(s, env, n)
      if size(cs) > 1
        call   infers(in env, args, out args1, ts, ref s)
        call   fresh(out t, ref s)
        call   normalize(in a, out w, ref s)
        call   unify(in w, fun(ts, t), ref s)
        if with_arity(cs, size(args)) == Nil
          raise WrongArity(n, size(args))
        end

        call   use_name(in n, with_arity(cs, size(args)), w, out x, ref s)
        assign e1 := EApp(EVar(x), args1)
      else
        call   infer(in env, f, out f1, u, ref s)
        call   apply(in env, u, args, out args1, t, ref s)
        assign e1 := EApp(f1, args1)
      end
    case _ =>
      call   infer(in env, f, out f1, u, ref s)
      call   apply(in env, u, args, out args1, t, ref s)
      assign e1 := EApp(f1, args1)
  end

// e.f, which is the accessor T.f of the type T of e, of the module of T, and e with f := a, which is the updater T.f:=
// applied to e and a, where the accessors of all datatypes with the field are the candidates while T is not known
procedure field_access(in env: Env, f: Id, a: Type, args: List[Expr], out e1: Expr, t: Type, ref s: State) :=
  local arg1: Expr, u: Type, w: Type, rest1: List[Expr], us: List[Type], acc: Name, x: Var

  match args
    case [arg; rest] =>
      call   infer(in env, arg, out arg1, u, ref s)
      call   infers(in env, rest, out rest1, us, ref s)
      call   fresh(out t, ref s)
      call   normalize(in a, out w, ref s)
      call   unify(in w, fun([u; us], t), ref s)

      match zonk_type(s.sub, u)
        case TSort(Name(Some(m), tn), _) =>
          assign acc := Name(Some(m), tn ^ f)
          match schemes_of(s.ctx, acc)
            case [sc] =>
              call use(in acc, w, sc, out x, ref s)
            case _ =>
              raise UnknownField(acc)
          end
        case TMeta(_) =>
          match accessors(s.ctx, f, entries(s.ctx.named))
            case Nil =>
              raise UnknownField(unqualified(f))
            case cs =>
              call use_name(in unqualified(f), cs, w, out x, ref s)
          end
        case v =>
          raise UnknownFieldType(f, v)
      end

      assign e1 := EApp(EVar(x), [arg1; rest1])
    case _ =>
      raise CountMismatch(1, size(args))
  end

procedure apply(in env: Env, f: Type, args: List[Expr], out args1: List[Expr], r: Type, ref s: State) :=
  local ts: List[Type]

  call   fresh(out r, ref s)
  call   infers(in env, args, out args1, ts, ref s)
  call   unify(in f, fun(ts, r), ref s)

procedure check(in env: Env, e: Expr, t: Type, out e1: Expr, ref s: State) :=
  local u: Type

  call   infer(in env, e, out e1, u, ref s)
  call   unify(in u, t, ref s)

procedure checks(in env: Env, es: List[Expr], ts: List[Type], out es1: List[Expr], ref s: State) :=
  local e1: Expr, rest: List[Expr]

  match (es, ts)
    case ([e; more], [t; ts1]) =>
      call   check(in env, e, t, out e1, ref s)
      call   checks(in env, more, ts1, out rest, ref s)
      assign es1 := [e1; rest]
    case (Nil, Nil) =>
      assign es1 := Nil
    case _ =>
      raise CountMismatch(size(ts), size(es))
  end

procedure infers(in env: Env, es: List[Expr], out es1: List[Expr], ts: List[Type], ref s: State) :=
  local e1: Expr, t: Type, rest: List[Expr], us: List[Type]

  match es
    case Nil =>
      assign es1 := Nil, ts := Nil
    case [e; more] =>
      call   infer(in env, e, out e1, t, ref s)
      call   infers(in env, more, out rest, us, ref s)
      assign es1 := [e1; rest], ts := [t; us]
  end

// each list may refer to the variables bound before it
procedure generators(in env: Env, xs: List[Var], lists: List[Expr], out lists1: List[Expr], ref s: State) :=
  local l: Expr, rest: List[Expr]

  match (xs, lists)
    case ([x; ys], [e; es]) =>
      call   check(in env, e, tlist(x.typ), out l, ref s)
      call   generators(in bind([x]) ++ env, ys, es, out rest, ref s)
      assign lists1 := [l; rest]
    case _ =>
      assign lists1 := Nil
  end

procedure expr_branches(in env: Env, cases: List[Branch[Expr]], t: Type, r: Type, out cases1: List[Branch[Expr]], ref s: State) :=
  local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Expr, rest: List[Branch[Expr]]

  match cases
    case Nil =>
      assign cases1 := Nil
    case [Branch(p, g, b); more] =>
      call   pattern(in p, t, out p1, xs, ref s)
      call   guard(in bind(xs) ++ env, g, out g1, ref s)
      call   check(in bind(xs) ++ env, b, r, out b1, ref s)
      call   expr_branches(in env, more, t, r, out rest, ref s)
      assign cases1 := [Branch(p1, g1, b1); rest]
  end

procedure guard(in env: Env, g: Option[Expr], out g1: Option[Expr], ref s: State) :=
  local e1: Expr

  match g
    case Some(e) =>
      call   check(in env, e, tbool(), out e1, ref s)
      assign g1 := Some(e1)
    case None =>
      assign g1 := None
  end

// guarded cases neither cover values for exhaustiveness nor make later cases unreachable
procedure coverage(in s: State, t: Type, cs: List[Pat * Bool]) :=
  call reachable(in s, t, Nil, cs)
  match missing(s.ctx, s.sub, [[p] for p in unguarded(cs)], [t])
    case Some([w; _]) =>
      raise NotExhaustive(w)
    case _ =>
      skip
  end

function unguarded(cs: List[Pat * Bool]): List[Pat] :=
  match cs
    case Nil => Nil
    case [(p, true); rest] => [p; unguarded(rest)]
    case [(_, false); rest] => unguarded(rest)
  end

procedure reachable(in s: State, t: Type, before: List[Pat], cs: List[Pat * Bool]) :=
  match cs
    case Nil =>
      skip
    case [(p, open); rest] =>
      if not useful(s.ctx, s.sub, [[q] for q in before], [p], [t])
        raise Unreachable(p)
      end
      if open
        call reachable(in s, t, before ++ [p], rest)
      else
        call reachable(in s, t, before, rest)
      end
  end

procedure pattern(in p: Pat, t: Type, out p1: Pat, xs: List[Var], ref s: State) :=
  call   binders(in p, t, out p1, xs, ref s)
  call   unique(in names(xs))

procedure binders(in p: Pat, t: Type, out p1: Pat, xs: List[Var], ref s: State) :=
  local u: Type, m: List[Type * Type], qs: List[Pat], ts: List[Type], k: Name

  match p
    case PWild =>
      assign p1 := p, xs := Nil

    case PLit(v) =>
      call   unify(in literal(v), t, ref s)
      assign p1 := p, xs := Nil

    case PVar(Var(n, a)) =>
      if overloads(s, n, lambda k => is_constr(s.ctx, k)) != Nil
        call binders(in PApp(n, Nil), t, out p1, xs, ref s)
      else
        call   normalize(in a, out u, ref s)
        call   unify(in u, t, ref s)
        assign p1 := PVar(Var(n, u)), xs := [Var(n, u)]
      end

    case PApp(n, args) =>
      match overloads(s, n, lambda k => is_constr(s.ctx, k))
        case [k1] =>
          assign k := k1
        case Nil =>
          raise UnknownConstructor(n)
        case ks =>
          call pattern_constructor(in n, ks, size(args), t, out k, ref s)
      end

      match constr_of(s.ctx, k)
        case Some((ps, ks, r)) =>
          call   same_length(in size(ks), size(args))
          call   instance(in ps, out m, ref s)
          call   unify(in subst(r, m), t, ref s)
          call   binder_list(in args, [subst(kt, m) for kt in ks], out qs, xs, ref s)
          assign p1 := PApp(k, qs)
        case None =>
          raise UnknownConstructor(n)
      end

    case PTuple(items) =>
      call   fresh_list(in items, out ts, ref s)
      call   unify(in TTuple(ts), t, ref s)
      call   binder_list(in items, ts, out qs, xs, ref s)
      assign p1 := PTuple(qs)
  end

// the one of the constructors ks with k arguments whose datatype fits t, where open uses are solved first if
// several fit, since the variables of the pattern need their types
procedure pattern_constructor(in n: Name, ks: List[Name], k: Int, t: Type, out c: Name, ref s: State) :=
  local ok: List[(Name * (List[Type] * Type)) * State]

  call trials(in results(s.ctx, ks, k), t, s, out ok)
  if size(ok) > 1
    call solve(ref s)
    call trials(in results(s.ctx, ks, k), t, s, out ok)
  end

  match (ok, own(s, firsts(ok)))
    case ([((c1, _), _)], _) =>
      assign c := c1
    case (Nil, _) =>
      raise NoOverload(n, zonk_type(s.sub, t))
    case (_, [(c1, _)]) =>
      assign c := c1
    case _ =>
      raise Ambiguous(n, firsts(firsts(ok)))
  end

// the constructors of ks with k arguments, each with the scheme of its datatype
function results(c: Ctx, ks: List[Name], k: Int): List[Name * (List[Type] * Type)] :=
  match ks
    case Nil => Nil
    case [n; rest] =>
      match constr_of(c, n)
        case Some((ps, args, r)) => if size(args) == k then [(n, (ps, r)); results(c, rest, k)] else results(c, rest, k)
        case None => results(c, rest, k)
      end
  end

procedure binder_list(in ps: List[Pat], ts: List[Type], out qs: List[Pat], xs: List[Var], ref s: State) :=
  local q: Pat, ys: List[Var], rest: List[Pat], zs: List[Var]

  match (ps, ts)
    case ([p; more], [t; ts1]) =>
      call   binders(in p, t, out q, ys, ref s)
      call   binder_list(in more, ts1, out rest, zs, ref s)
      assign qs := [q; rest], xs := ys ++ zs
    case (Nil, Nil) =>
      assign qs := Nil, xs := Nil
    case _ =>
      raise CountMismatch(size(ts), size(ps))
  end

procedure variable(in env: Env, assignable: List[Name], x: Var, out y: Var, ref s: State) :=
  local u: Type

  match x
    case Var(n, a) =>
      if not contains(n, assignable)
        raise NotAssignable(n)
      end
      match get(n, env)
        case Some((_, t)) =>
          call   normalize(in a, out u, ref s)
          call   unify(in t, u, ref s)
          assign y := Var(n, t)
        case None =>
          raise UnknownVariable(n)
      end
  end

procedure variables(in env: Env, assignable: List[Name], xs: List[Var], out ys: List[Var], ref s: State) :=
  local y: Var, rest: List[Var]

  match xs
    case Nil =>
      assign ys := Nil
    case [x; more] =>
      call   variable(in env, assignable, x, out y, ref s)
      call   variables(in env, assignable, more, out rest, ref s)
      assign ys := [y; rest]
  end

procedure statement(in env: Env, assignable: List[Name], x: Stmt, out y: Stmt, ref s: State) :=
  local ys: List[Var], es: List[Expr], c: Expr, t: Type, u: Type, l: Stmt, r: Stmt, xs: List[Stmt], bs: List[Branch[Stmt]], hs: List[Handler]

  match x
    case SSkip =>
      assign y := x

    case SAssign(pairs) =>
      call   unique(in names(firsts(pairs)))
      call   variables(in env, assignable, firsts(pairs), out ys, ref s)
      call   checks(in env, seconds(pairs), types(ys), out es, ref s)
      assign y := SAssign(zip(ys, es))
    // the types of locals that are initialized at the start of the block may be inferred

    case SBlock(locals, body) =>
      call   untyped(in locals, initialized(body))
      call   formals(in locals, out ys, ref s)
      call   statements(in bind(ys) ++ env, names(ys) ++ assignable, body, out xs, ref s)
      assign y := SBlock(ys, xs)

    case SIf(cond, left, right) =>
      call   check(in env, cond, tbool(), out c, ref s)
      call   statement(in env, assignable, left, out l, ref s)
      call   statement(in env, assignable, right, out r, ref s)
      assign y := SIf(c, l, r)

    case SWhile(cond, body) =>
      call   check(in env, cond, tbool(), out c, ref s)
      call   statement(in env, assignable, body, out l, ref s)
      assign y := SWhile(c, l)

    case SCall(p, ins, outs, refs) =>
      call call_proc(in env, assignable, p, ins, outs, refs, out y, ref s)

    case SMatch(arg, cases) =>
      call   infer(in env, arg, out c, t, ref s)
      call   stmt_branches(in env, assignable, cases, t, out bs, ref s)
      call   solve(ref s)
      call   coverage(in s, t, [case_of(br) for br in bs])
      assign y := SMatch(c, bs)

    case SAssert(cond) =>
      call   check(in env, cond, tbool(), out c, ref s)
      assign y := SAssert(c)

    case SRaise(arg, a) =>
      call   infer(in env, arg, out c, t, ref s)
      call   normalize(in a, out u, ref s)
      call   unify(in t, u, ref s)
      assign y := SRaise(c, t)

    case STry(body, handlers) =>
      call   statement(in env, assignable, body, out l, ref s)
      call   handler_list(in env, assignable, handlers, out hs, ref s)
      assign y := STry(l, hs)
  end

// the variables that the leading assignments of a block assign one at a time, as local x := e does
function initialized(xs: List[Stmt]): List[Name] :=
  match xs
    case [SAssign([(x, _)]); rest] => [x.name; initialized(rest)]
    case _ => Nil
  end

// the locals without a type are initialized
procedure untyped(in xs: List[Var], inits: List[Name]) :=
  match xs
    case Nil =>
      skip
    case [Var(n, t); rest] =>
      if holes(t) and not contains(n, inits)
        raise MissingType(n)
      end

      call untyped(in rest, inits)
  end

procedure statements(in env: Env, assignable: List[Name], xs: List[Stmt], out ys: List[Stmt], ref s: State) :=
  local y: Stmt, rest: List[Stmt]

  match xs
    case Nil =>
      assign ys := Nil
    case [x; more] =>
      call   statement(in env, assignable, x, out y, ref s)
      call   statements(in env, assignable, more, out rest, ref s)
      assign ys := [y; rest]
  end

// the procedures of the library os, which exist in programs that import it, which declares OsError
function os_procs(c: Ctx): List[Name * (List[Type] * List[Type] * List[Type] * List[Type])] :=
  if is_data(c, os_error_name()) then
    [
      (unqualified("os_args"), (Nil, Nil, [tlist(tstr())], Nil)),
      (unqualified("os_read"), (Nil, [tstr()], [tstr()], Nil)),
      (unqualified("os_write"), (Nil, [tstr(), tstr()], Nil, Nil)),
      (unqualified("os_show"), ([TParam("A")], [TParam("A")], Nil, Nil)),
      (unqualified("os_print"), (Nil, [tstr()], Nil, Nil)),
      (unqualified("os_print_error"), (Nil, [tstr()], Nil, Nil)),
      (unqualified("os_exit"), (Nil, [tint()], Nil, Nil)),
      (unqualified("os_library"), (Nil, [tstr()], [tstr()], Nil))
    ]
  else
    Nil

// read and library give the syntax of self/syntax.u, so they exist only in programs that declare its Program
function syntax_procs(c: Ctx): List[Name * (List[Type] * List[Type] * List[Type] * List[Type])] :=
  match [d for d in names_of(c, "Program") if is_data(c, d)]
    case [d; _] =>
      [(unqualified("read"), (Nil, [tstr()], [TSort(d, Nil)], Nil)), (unqualified("library"), (Nil, [tstr()], [TSort(d, Nil)], Nil))]
    case _ => Nil
  end

// the procedures of the program hide the builtin ones
// a variable of a procedure type hides the procedures of that name
procedure call_proc(in env: Env, assignable: List[Name], p: Name, ins: List[Expr], outs: List[Var], refs: List[Var], out y: Stmt, ref s: State) :=
  match get(p, env)
    case Some(sc) =>
      call call_variable(in env, assignable, p, sc, ins, outs, refs, out y, ref s)
    case None =>
      call call_declared(in env, assignable, p, ins, outs, refs, out y, ref s)
  end

procedure call_variable(in env: Env, assignable: List[Name], p: Name, sc: List[Type] * Type, ins: List[Expr], outs: List[Var], refs: List[Var], out y: Stmt, ref s: State) :=
  local x: Var, w: Type, is: List[Type], os: List[Type], rs: List[Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]

  call   fresh(out w, ref s)
  call   use(in p, w, sc, out x, ref s)
  call   fresh_list(in ins, out is, ref s)
  call   fresh_list(in outs, out os, ref s)
  call   fresh_list(in refs, out rs, ref s)
  call   unify(in x.typ, TProc(is, os, rs), ref s)
  call   unique(in names(outs ++ refs))
  call   checks(in env, ins, is, out ins1, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   unifies(in types(outs1 ++ refs1), os ++ rs, ref s)
  assign y := SCall(p, ins1, outs1, refs1)

procedure call_declared(in env: Env, assignable: List[Name], p: Name, ins: List[Expr], outs: List[Var], refs: List[Var], out y: Stmt, ref s: State) :=
  match overloads(s, p, lambda q => is_proc(s.ctx, q))
    case [q] =>
      call declared_call(in env, assignable, p, q, ins, outs, refs, out y, ref s)
    case Nil =>
      call declared_call(in env, assignable, p, p, ins, outs, refs, out y, ref s)
    case qs =>
      call overloaded_call(in env, assignable, p, qs, ins, outs, refs, out y, ref s)
  end

// a call of one of the procedures qs, by the types of its arguments, where the arguments are inferred first
procedure overloaded_call(in env: Env, assignable: List[Name], p: Name, qs: List[Name], ins: List[Expr], outs: List[Var], refs: List[Var], out y: Stmt, ref s: State) :=
  local ins1: List[Expr], is: List[Type], outs1: List[Var], refs1: List[Var], m: Name

  call   unique(in names(outs ++ refs))
  call   infers(in env, ins, out ins1, is, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   choose(in p, [(q, proc_scheme(s.ctx, q)) for q in qs], TProc(is, types(outs1), types(refs1)), out m, ref s)
  assign y := SCall(m, ins1, outs1, refs1)

procedure declared_call(in env: Env, assignable: List[Name], p: Name, q: Name, ins: List[Expr], outs: List[Var], refs: List[Var], out y: Stmt, ref s: State) :=
  local m: List[Type * Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]

  match or_else(proc_of(s.ctx, q), get(q, os_procs(s.ctx) ++ syntax_procs(s.ctx)))
    case Some((ps, is, os, rs)) =>
      call   instance(in ps, out m, ref s)
      call   same_length(in size(is), size(ins))
      call   same_length(in size(os), size(outs))
      call   same_length(in size(rs), size(refs))
      call   unique(in names(outs ++ refs))
      call   checks(in env, ins, [subst(t, m) for t in is], out ins1, ref s)
      call   variables(in env, assignable, outs, out outs1, ref s)
      call   variables(in env, assignable, refs, out refs1, ref s)
      call   unifies(in types(outs1 ++ refs1), [subst(t, m) for t in os ++ rs], ref s)
      assign y := SCall(q, ins1, outs1, refs1)
    case None =>
      raise UnknownProcedure(p)
  end

procedure stmt_branches(in env: Env, assignable: List[Name], cases: List[Branch[Stmt]], t: Type, out cases1: List[Branch[Stmt]], ref s: State) :=
  local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Branch[Stmt]]

  match cases
    case Nil =>
      assign cases1 := Nil
    case [Branch(p, g, b); more] =>
      call   pattern(in p, t, out p1, xs, ref s)
      call   guard(in bind(xs) ++ env, g, out g1, ref s)
      call   statement(in bind(xs) ++ env, diff(assignable, names(xs)), b, out b1, ref s)
      call   stmt_branches(in env, assignable, more, t, out rest, ref s)
      assign cases1 := [Branch(p1, g1, b1); rest]
  end

procedure handler_list(in env: Env, assignable: List[Name], hs: List[Handler], out hs1: List[Handler], ref s: State) :=
  local u: Type, p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Handler]

  match hs
    case Nil =>
      assign hs1 := Nil
    case [Handler(a, p, g, b); more] =>
      call   normalize(in a, out u, ref s)
      call   pattern(in p, u, out p1, xs, ref s)
      call   guard(in bind(xs) ++ env, g, out g1, ref s)
      call   statement(in bind(xs) ++ env, diff(assignable, names(xs)), b, out b1, ref s)
      call   handler_list(in env, assignable, more, out rest, ref s)
      assign hs1 := [Handler(u, p1, g1, b1); rest]
  end

procedure declare_name(in c: Ctx, n: Name) :=
  if is_fun(c, n) or is_proc(c, n) or is_constr(c, n) or builtin(unqualified(n.base)) != Nil
    raise AlreadyDefined(n)
  end

// functions of the same name must differ in their number of arguments
procedure overload(in c: Ctx, n: Name, k: Int) :=
  if is_proc(c, n) or is_constr(c, n) or has_arity(schemes_of(c, n) ++ builtin(unqualified(n.base)), k)
    raise AlreadyDefined(n)
  end

procedure declare_sort(in c: Ctx, n: Name) :=
  if contains(n.base, ["Bool", "Int", "Str", "Char", "->"]) or is_alias(c, n) or is_data(c, n)
    raise SortDefined(n)
  end

procedure closed(in n: Name, ps: List[Id], ts: List[Type]) :=
  local undeclared := diff(distinct(concat([free(t) for t in ts])), params(ps))

  if undeclared != Nil
    raise UndeclaredParams(n, undeclared)
  end

// datatypes may be mutually recursive, so they are known before any sort is checked
procedure declare_datas(in cs: List[Id * Cmd], ref s: State) :=
  match cs
    case Nil =>
      skip
    case [(m, CData(n, ps, _)); rest] =>
      assign s := enter(s, m)
      call   declare_sort(in s.ctx, n)
      assign s := with_ctx(s, with_data(s.ctx, n, size(ps)))
      call   declare_datas(in rest, ref s)
    case [_; rest] =>
      call declare_datas(in rest, ref s)
  end

procedure declare_sorts(in cs: List[Id * Cmd], ref s: State) :=
  local u: Type

  match cs
    case Nil =>
      skip
    case [(m, CSort(n, ps, t)); rest] =>
      assign s := enter(s, m)
      call   declare_sort(in s.ctx, n)
      call   unique_ids(in ps)
      call   known(in t, n, out u, ref s)
      call   closed(in n, ps, [u])
      assign s := with_ctx(s, with_alias(s.ctx, n, ps, u))
      call   declare_sorts(in rest, ref s)
    case [_; rest] =>
      call declare_sorts(in rest, ref s)
  end

procedure declare_constrs(in cs: List[Id * Cmd], ref s: State) :=
  match cs
    case Nil =>
      skip
    case [(m, CData(n, ps, ks)); rest] =>
      assign s := enter(s, m)
      call   unique_ids(in ps)
      assign s := with_ctx(s, with_members(s.ctx, n, [k.name for k in ks]))
      call   declare_constructors(in n, ps, ks, ref s)
      call   declare_constrs(in rest, ref s)
    case [_; rest] =>
      call declare_constrs(in rest, ref s)
  end

procedure declare_constructors(in n: Name, ps: List[Id], ks: List[Constr], ref s: State) :=
  local ts: List[Type]

  match ks
    case Nil =>
      skip
    case [Constr(k, args); rest] =>
      call   declare_name(in s.ctx, k)
      call   knowns(in args, k, out ts, ref s)
      call   closed(in n, ps, ts)
      assign s := with_ctx(s, with_constr(s.ctx, k, (params(ps), ts, TSort(n, params(ps)))))
      call   declare_constructors(in n, ps, rest, ref s)
  end

// the type of a function with several lists of parameters, which returns functions for all but the first
function curried(xss: List[List[Var]], r: Type): Type :=
  match xss
    case Nil => r
    case [xs; rest] => fun(types(xs), curried(rest, r))
  end

function first_list(xss: List[List[Var]]): List[Var] :=
  match xss
    case Nil => Nil
    case [xs; _] => xs
  end

procedure signatures(in xss: List[List[Var]], out yss: List[List[Var]], ref s: State) :=
  local ys: List[Var], rest: List[List[Var]]

  match xss
    case Nil =>
      assign yss := Nil
    case [xs; more] =>
      call   signature(in xs, out ys, ref s)
      call   signatures(in more, out rest, ref s)
      assign yss := [ys; rest]
  end

procedure declare_funs(in cs: List[Id * Cmd], ref s: State) :=
  local xss: List[List[Var]], r: Type

  match cs
    case Nil =>
      skip
    case [(m, CFun(n, ps, bound, res, _)); rest] =>
      assign s := enter(s, m)
      call   overload(in s.ctx, n, size(first_list(bound)))
      call   unique_ids(in ps)
      call   unique(in names(concat(bound)))
      call   signatures(in bound, out xss, ref s)
      call   known(in res, n, out r, ref s)
      call   closed(in n, ps, [curried(xss, r)])
      assign s := with_ctx(s, with_fun(s.ctx, n, (params(ps), curried(xss, r))))
      call   declare_funs(in rest, ref s)
    case [_; rest] =>
      call declare_funs(in rest, ref s)
  end

procedure declare_procs(in cs: List[Id * Cmd], ref s: State) :=
  local xs: List[Var], ts: List[Type]

  match cs
    case Nil =>
      skip
    case [(m, CProc(n, ps, ins, outs, refs, _)); rest] =>
      assign s := enter(s, m)
      call   declare_name(in s.ctx, n)
      call   unique_ids(in ps)
      call   signature(in ins ++ outs ++ refs, out xs, ref s)
      assign ts := types(xs)
      call   closed(in n, ps, ts)
      assign s := with_ctx(s, with_proc(s.ctx, n, (params(ps), take(size(ins), ts), take(size(outs), drop(size(ins), ts)), drop(size(ins) + size(outs), ts))))
      call   declare_procs(in rest, ref s)
    case [_; rest] =>
      call declare_procs(in rest, ref s)
  end

// the elaborated command c
procedure command(in c: Cmd, out c1: Cmd, ref s: State) :=
  local xss: List[List[Var]], r: Type, b: Expr, t: Type, is: List[Var], os: List[Var], rs: List[Var], y: Stmt

  match c
    case CFun(n, ps, bound, res, body) =>
      call   signatures(in bound, out xss, ref s)
      call   known(in res, n, out r, ref s)
      call   check(in bind(concat(xss)), body, r, out b, ref s)
      assign c1 := CFun(n, ps, xss, r, b)

    case CProc(n, ps, ins, outs, refs, body) =>
      call   signature(in ins, out is, ref s)
      call   signature(in outs, out os, ref s)
      call   signature(in refs, out rs, ref s)
      call   statement(in bind(is ++ os ++ rs), names(os ++ rs), body, out y, ref s)
      assign c1 := CProc(n, ps, is, os, rs, y)

    case CTest(n, [], body) =>
      call   statement(in Nil, Nil, body, out y, ref s)
      assign c1 := CTest(n, Nil, y)

    case CTest(n, _, _) =>
      raise TestParams(n)

    case _ =>
      assign c1 := c
  end

procedure commands(in cs: List[Id * Cmd], out cs1: List[Cmd], ref s: State) :=
  local c1: Cmd, c2: Cmd, rest: List[Cmd]

  match cs
    case Nil =>
      assign cs1 := Nil
    case [(m, c); more] =>
      assign s := enter(s, m)
      call   command(in c, out c1, ref s)
      call   settle(ref s)
      assign c2 := zonk_cmd(s, c1)
      match unknown_in_cmd(c2)
        case Some(t) =>
          raise UnknownException(t)
        case None =>
          skip
      end
      call   commands(in more, out rest, ref s)
      assign cs1 := [c2; rest]
  end

// tests are chosen by name
function block_names(cs: List[Id * Cmd]): List[Id] :=
  match cs
    case Nil => Nil
    case [(_, CTest(n, _, _)); more] => [n; block_names(more)]
    case [_; more] => block_names(more)
  end

// checked modules: their commands with qualified names, their declarations, and the modules each imports
data Checked :=
  | Checked(cmds: List[Cmd], ctx: Ctx, imports: List[Id * List[Id]])

// the checked modules by their names, their commands, and the positions in the cache of the modules they see,
// since a module depends only on the prelude and its direct imports
type Cache :=
  List[(Id * List[Id * Cmd] * List[Int]) * Checked]

// the commands of p, which is the module main, flattened and with qualified names
procedure check_program(in p: Program, main: Id, out q: Program) :=
  local cache: Cache := Nil

  call check_modules(in p, main, out q, ref cache)

// each imported module is checked once, after the modules it imports, and the own commands of p last
procedure check_modules(in p: Program, main: Id, out q: Program, ref cache: Cache) :=
  local c := empty_ctx(), imports: List[Id * List[Id]] := Nil, seen: List[Id * Int] := Nil, cs: List[Cmd] := Nil, own: Checked

  call   check_units(in modules(p.cmds), ref c, imports, seen, cs, cache)
  call   check_unit(in own_decls(main, p.cmds), main, c, imports, out own)
  assign q := Program(cs ++ own.cmds)

procedure check_units(in us: List[Id * List[Id * Cmd]], ref c: Ctx, imports: List[Id * List[Id]], seen: List[Id * Int], cs: List[Cmd], cache: Cache) :=
  local key: Id * List[Id * Cmd] * List[Int], checked: Checked, i: Int

  match us
    case Nil =>
      skip
    case [(m, ds); rest] =>
      assign key := (m, ds, positions_of(["prelude"; imports_in(ds, m)], seen))

      match position_in(key, cache, 0)
        case Some((k, done)) =>
          assign i := k, checked := done
        case None =>
          call   check_unit(in ds, m, c, imports, out checked)
          assign i := size(cache), cache := cache ++ [(key, checked)]
      end

      assign c := ctx_union(c, checked.ctx), imports := imports ++ checked.imports, cs := cs ++ checked.cmds
      assign seen := [(n, i) for n in firsts(checked.imports)] ++ seen
      call   check_units(in rest, ref c, imports, seen, cs, cache)
  end

function positions_of(ms: List[Id], seen: List[Id * Int]): List[Int] :=
  match ms
    case Nil => Nil
    case [m; rest] =>
      match get(m, seen)
        case Some(i) => [i; positions_of(rest, seen)]
        case None => positions_of(rest, seen)
      end
  end

// the position of key in the cache with its checked modules
function position_in(key: Id * List[Id * Cmd] * List[Int], cache: Cache, i: Int): Option[Int * Checked] :=
  match cache
    case Nil => None
    case [(k, checked); rest] => if k == key then Some((i, checked)) else position_in(key, rest, i + 1)
  end

// the declarations ds of module main, checked after the declarations before of the modules that imports lists
procedure check_unit(in ds: List[Id * Cmd], main: Id, before: Ctx, imports: List[Id * List[Id]], out checked: Checked) :=
  local own := imports ++ [(m, imports_in(ds, m)) for m in distinct(firsts(ds))], s: State, cs: List[Cmd]

  assign s := State(before, empty(), 0, main, Nil, visibility(own, main), Nil, empty())
  call   declare_datas(in ds, ref s)
  call   declare_sorts(in ds, ref s)
  call   declare_constrs(in ds, ref s)
  call   declare_funs(in ds, ref s)
  call   declare_procs(in ds, ref s)
  call   unique_ids(in block_names(ds))
  call   commands(in ds, out cs, ref s)
  assign checked := Checked(cs, ctx_of(s.ctx, distinct(firsts(ds))), [(m, imports_in(ds, m)) for m in distinct(firsts(ds))])

// the modules of cs with their commands, after the modules they import, where the prelude and its imports
// are one, since every module sees the prelude
function modules(cs: List[Cmd]): List[Id * List[Id * Cmd]] :=
  match cs
    case Nil => Nil
    case [CModule("prelude", ds); rest] => [("prelude", flatten("prelude", ds)); modules(rest)]
    case [CModule(n, ds); rest] => modules(ds) ++ [(n, own_decls(n, ds)); modules(rest)]
    case [_; rest] => modules(rest)
  end

// the commands of module m without the modules it imports, with their module
function own_decls(m: Id, cs: List[Cmd]): List[Id * Cmd] :=
  [(m, qualify(m, c)) for c in cs if not is_module(c)]

function is_module(c: Cmd): Bool :=
  match c
    case CModule(_, _) => true
    case _ => false
  end

// the type of e without a program
procedure type_of(in e: Expr, out t: Type) :=
  local s := start("main", Nil), e1: Expr, u: Type

  call   infer(in Nil, e, out e1, u, ref s)
  call   settle(ref s)
  assign t := zonk_type(s.sub, u)

// abbreviations for the syntax in tests

function ev(n: Id): Expr :=
  EVar(Var(unqualified(n), THole))

function pv(n: Id): Pat :=
  PVar(Var(unqualified(n), THole))

function num(n: Int): Expr :=
  ELit(VInt(n))

function ap(f: Id, args: List[Expr]): Expr :=
  EApp(ev(f), args)

// the lists of the tests, before checking
function tl(t: Type): Type :=
  TSort(unqualified("List"), [t])

// lists with constructors Nil and Cons, in the module list as in the library, and their length
function lists(): List[Cmd] :=
  [
    CModule("list", [CData(unqualified("List"), ["A"], [Constr(unqualified("Nil"), Nil), Constr(unqualified("Cons"), [TParam("A"), tl(TParam("A"))])])]),
    CImport("list"),
    CFun(
      unqualified("len"),
      ["A"],
      [[Var(unqualified("xs"), tl(TParam("A")))]],
      tint(),
      EMatch(ev("xs"), [Branch(pv("Nil"), None, num(0)), Branch(PApp(unqualified("Cons"), [PWild, pv("ys")]), None, ap("+", [num(1), ap("len", [ev("ys")])]))])
    )
  ]

test inference() :=
  local t: Type

  call   type_of(in ap("+", [num(1), num(2)]), out t)
  assert t == tint()
  // let id = lambda x => x in (id(1), id(true))
  call   type_of(in ELet([(Var(unqualified("id"), THole), ELam([Var(unqualified("x"), THole)], ev("x")))], ETuple([ap("id", [num(1)]), ap("id", [ELit(VBool(true))])])), out t)
  assert t == TTuple([tint(), tbool()])
  // lambda f => f(f)
  try
    call   type_of(in ELam([Var(unqualified("f"), THole)], ap("f", [ev("f")])), out t)
    assert false
  catch
    case InfiniteType(_, _) =>
      skip
  end
  try
    call   type_of(in ap("+", [num(1), ELit(VBool(true))]), out t)
    assert false
  catch
    case CannotUnify(a, b) =>
      assert (a, b) == (tint(), tbool())
  end
  try
    call   type_of(in ap("x", Nil), out t)
    assert false
  catch
    case UnknownVariable(x) =>
      assert x == unqualified("x")
  end

test elaboration() :=
  local q: Program

  call check_program(in Program(lists() ++ [CTest("r", Nil, SBlock([Var(unqualified("n"), THole)], [SAssign([(Var(unqualified("n"), THole), ap("len", [ap("Cons", [num(1), ev("Nil")])]))])]))]), "main", out q)
  match q
    case Program([_, _, CFun(_, _, _, _, EMatch(_, [Branch(p, _, _); _])), CTest(_, Nil, SBlock(_, [SAssign([(_, EApp(EVar(Var(_, t)), _))])]))]) =>
      // the constructor Nil is elaborated to a pattern of a constructor
      assert p == PApp(nil_name(), Nil)
      assert t == fun([tlist(tint())], tint())
    case _ =>
      assert false
  end

test coverage() :=
  local q: Program

  try
    call   check_program(in Program(lists() ++ [CFun(unqualified("f"), Nil, [[Var(unqualified("xs"), tl(tint()))]], tint(), EMatch(ev("xs"), [Branch(pv("Nil"), None, num(0))]))]), "main", out q)
    assert false
  catch
    case NotExhaustive(w) =>
      assert w == PApp(cons_name(), [PWild, PWild])
  end
  try
    call   check_program(in Program(lists() ++ [CFun(unqualified("f"), Nil, [[Var(unqualified("xs"), tl(tint()))]], tint(), EMatch(ev("xs"), [Branch(PWild, None, num(0)), Branch(pv("Nil"), None, num(1))]))]), "main", out q)
    assert false
  catch
    case Unreachable(p) =>
      assert p == PApp(nil_name(), Nil)
  end

test statements() :=
  local q: Program

  // procedure inc(ref k: Int) := assign k := k + 1, called with an input
  try
    call check_program(in Program(
        [
          CProc(unqualified("inc"), Nil, Nil, Nil, [Var(unqualified("k"), tint())], SBlock(Nil, [SAssign([(Var(unqualified("k"), THole), ap("+", [ev("k"), num(1)]))])])),
          CProc(unqualified("p"), Nil, [Var(unqualified("n"), tint())], Nil, Nil, SBlock(Nil, [SCall(unqualified("inc"), Nil, Nil, [Var(unqualified("n"), THole)])]))
        ]
      ), "main", out q)
    assert false
  catch
    case NotAssignable(n) =>
      assert n == unqualified("n")
  end
  try
    call   check_program(in Program(lists() ++ [CTest("t", Nil, SBlock(Nil, [SRaise(ev("Nil"), THole)]))]), "main", out q)
    assert false
  catch
    case UnknownException(TSort(Name(Some("list"), "List"), _)) =>
      skip
  end

// tests of overloading across modules

function unq(n: Id): Name :=
  unqualified(n)

function tsort(n: Id): Type :=
  TSort(unqualified(n), Nil)

function var_of(n: Id, t: Type): Var :=
  Var(unqualified(n), t)

function fun_cmd(n: Id, xs: List[Var], r: Type, b: Expr): Cmd :=
  CFun(unqualified(n), Nil, [xs], r, b)

// the modules bag and box, which both declare a function size, a constructor Leaf, a procedure fill, and a field x,
// and that the program imports
function bags(): List[Cmd] :=
  [
    CModule("bag", [
      CData(unq("Bag"), Nil, [Constr(unq("Bag"), [tint()]), Constr(unq("Leaf"), [tint()])]),
      CData(unq("Pt"), Nil, [Constr(unq("Pt"), [tint()])]),
      fun_cmd("size", [var_of("b", tsort("Bag"))], tint(), num(1)),
      fun_cmd("Pt.x", [var_of("p", tsort("Pt"))], tint(), EMatch(ev("p"), [Branch(PApp(unq("Pt"), [pv("n")]), None, ev("n"))])),
      CProc(unq("fill"), Nil, Nil, [var_of("b", tsort("Bag"))], Nil, SAssign([(var_of("b", THole), ap("Bag", [num(0)]))]))
    ]),
    CImport("bag"),
    CModule("box", [
      CData(unq("Box"), Nil, [Constr(unq("Box"), [tstr()]), Constr(unq("Leaf"), [tstr()])]),
      CData(unq("Qt"), Nil, [Constr(unq("Qt"), [tstr()])]),
      fun_cmd("size", [var_of("b", tsort("Box"))], tint(), num(2)),
      fun_cmd("Qt.x", [var_of("q", tsort("Qt"))], tstr(), EMatch(ev("q"), [Branch(PApp(unq("Qt"), [pv("s")]), None, ev("s"))])),
      CProc(unq("fill"), Nil, Nil, [var_of("b", tsort("Box"))], Nil, SAssign([(var_of("b", THole), ap("Box", [ELit(VStr(""))]))]))
    ]),
    CImport("box")
  ]

function in_bag(n: Id): Name :=
  Name(Some("bag"), n)

function in_box(n: Id): Name :=
  Name(Some("box"), n)

// the body of the last function of the checked program bags() ++ [c]
procedure body_of(in c: Cmd, out b: Expr) :=
  local q: Program

  call check_program(in Program(bags() ++ [c]), "main", out q)
  match reverse(q.cmds)
    case [CFun(_, _, _, _, e); _] =>
      assign b := e
    case _ =>
      assert false
  end

// size(Bag(1)) + size(Box("x"))
test by_arguments() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, tint(), ap("+", [ap("size", [ap("Bag", [num(1)])]), ap("size", [ap("Box", [ELit(VStr("x"))])])])), out b)
  match b
    case EApp(_, [EApp(EVar(Var(m, _)), _), EApp(EVar(Var(n, _)), _)]) =>
      assert (m, n) == (in_bag("size"), in_box("size"))
    case _ =>
      assert false
  end

// (lambda x => size(x))(Box("x")), where size(x) stays open until the lambda is applied
test deferred() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, tint(), EApp(ELam([var_of("x", THole)], ap("size", [ev("x")])), [ap("Box", [ELit(VStr("x"))])])), out b)
  match b
    case EApp(ELam(_, EApp(EVar(Var(m, t)), _)), _) =>
      assert m == in_box("size")
      assert t == fun([TSort(in_box("Box"), Nil)], tint())
    case _ =>
      assert false
  end

// size as a value of the declared result type Box -> Int
test by_result() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, fun([tsort("Box")], tint()), ev("size")), out b)
  assert b == EVar(Var(in_box("size"), fun([TSort(in_box("Box"), Nil)], tint())))

// Leaf("s") constructs a Box, and the case Leaf(n) of a Bag is of bag
test constructors() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, tsort("Box"), ap("Leaf", [ELit(VStr("s"))])), out b)
  match b
    case EApp(EVar(Var(k, _)), _) =>
      assert k == in_box("Leaf")
    case _ =>
      assert false
  end

  call body_of(in fun_cmd("g", [var_of("b", tsort("Bag"))], tint(), EMatch(ev("b"), [Branch(PApp(unq("Leaf"), [pv("n")]), None, ev("n")), Branch(PApp(unq("Bag"), [pv("n")]), None, ev("n"))])), out b)
  match b
    case EMatch(_, [Branch(PApp(k, _), _, _); _]) =>
      assert k == in_bag("Leaf")
    case _ =>
      assert false
  end

// call fill(out b) for a local b: Box
test procedures() :=
  local q: Program

  call check_program(in Program(bags() ++ [CProc(unq("p"), Nil, Nil, Nil, Nil, SBlock([var_of("b", tsort("Box"))], [SCall(unq("fill"), Nil, [var_of("b", THole)], Nil)]))]), "main", out q)
  match reverse(q.cmds)
    case [CProc(_, _, _, _, _, SBlock(_, [SCall(p, _, _, _)])); _] =>
      assert p == in_box("fill")
    case _ =>
      assert false
  end

// (lambda p => p.x)(Pt(3)), where the type of p is not known at the access
test fields() :=
  local b: Expr

  call body_of(in fun_cmd("f", Nil, tint(), EApp(ELam([var_of("p", THole)], ap(".x", [ev("p")])), [ap("Pt", [num(3)])])), out b)
  match b
    case EApp(ELam(_, EApp(EVar(Var(m, _)), _)), _) =>
      assert m == in_bag("Pt.x")
    case _ =>
      assert false
  end

// a local variable hides all declarations of its name
test locals() :=
  local b: Expr

  call body_of(in fun_cmd("f", [var_of("size", tint())], tint(), ev("size")), out b)
  assert b == EVar(Var(unq("size"), tint()))

test errors() :=
  local b: Expr

  try
    call   body_of(in fun_cmd("f", Nil, tint(), ap("size", [num(1)])), out b)
    assert false
  catch
    case NoOverload(n, _) =>
      assert n == unq("size")
  end
  // let h := lambda x => size(x) in true, where nothing decides size
  try
    call   body_of(in fun_cmd("f", Nil, tbool(), ELet([(var_of("h", THole), ELam([var_of("x", THole)], ap("size", [ev("x")])))], ELit(VBool(true)))), out b)
    assert false
  catch
    case Ambiguous(n, ms) =>
      assert n == unq("size")
      assert size(ms) == 2
  end
  try
    call   body_of(in fun_cmd("f", Nil, tint(), ap("size", [num(1), num(2)])), out b)
    assert false
  catch
    case WrongArity(n, k) =>
      assert (n, k) == (unq("size"), 2)
  end
