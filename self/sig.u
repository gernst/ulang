// the signatures of modules, the types of their declarations by name, made of the signatures of the declarations, and
// their notations, where the parser fills the notations and the checker the declarations

import syntax
import map
import set

export

// the precedences of prefix and postfix operators, and the fixities and precedences of infix ones
data Notations :=
  | Notations(prefix_ops: Map[Id, Int], postfix_ops: Map[Id, Int], infix_ops: Map[Id, Fixity * Int])

// type definitions with their parameters, the type schemes of functions with their parameters, the signatures of procedures
// with parameters, ins, outs, and refs, datatypes with their numbers of parameters, their constructors,
// constructors with the parameters of their datatype, their argument types, and their datatype,
// the declarations of each base name, of any kind and module, the notations, and the functions and procedures of builtin
// sections, which the interpreter and the runtime define, where the signature that a module shows to its importers has only
// its exported declarations and notations
data Sig :=
  | Sig(
    aliases: Map[Name, List[Id] * Type],
    funs: Map[Name, List[List[Type] * Type]],
    procs: Map[Name, List[Type] * List[Type] * List[Type] * List[Type]],
    datas: Map[Name, Int],
    members: Map[Name, List[Name]],
    constrs: Map[Name, List[Type] * List[Type] * Type],
    named: Map[Id, List[Name]],
    notations: Notations,
    natives: Set[Name]
  )

function empty_notations(): Notations
function prefix_prec(notations: Notations, op: Id): Option[Int]
function postfix_prec(notations: Notations, op: Id): Option[Int]
function infix_of(notations: Notations, op: Id): Option[Fixity * Int]
function notation_of(notations: Notations, f: Fixity, op: Id): Option[Fixity * Int]
function is_operator(notations: Notations, op: Id): Bool
function with_notations(notations: Notations, cmds: List[Cmd]): Notations
function with_operators(notations: Notations, f: Fixity, prec: Int, ops: List[Id]): Notations
function union_notations(a: Notations, b: Notations): Notations
function empty(): Sig
function restrict(sig: Sig, ms: List[Id]): Sig
function union(a: Sig, b: Sig): Sig
function exported(sig: Sig, values: Set[Name], sorts: Set[Name]): Sig
function alias_of(sig: Sig, n: Name): Option[List[Id] * Type]
function schemes_of(sig: Sig, n: Name): List[List[Type] * Type]
function proc_of(sig: Sig, n: Name): Option[List[Type] * List[Type] * List[Type] * List[Type]]
function data_of(sig: Sig, n: Name): Option[Int]
function members_of(sig: Sig, n: Name): Option[List[Name]]
function constr_of(sig: Sig, n: Name): Option[List[Type] * List[Type] * Type]
function is_fun(sig: Sig, n: Name): Bool
function is_proc(sig: Sig, n: Name): Bool
function is_data(sig: Sig, n: Name): Bool
function is_alias(sig: Sig, n: Name): Bool
function is_constr(sig: Sig, n: Name): Bool
function is_sort(sig: Sig, n: Name): Bool
function names_of(sig: Sig, b: Id): List[Name]
function with_alias(sig: Sig, n: Name, ps: List[Id], t: Type): Sig
function with_fun(sig: Sig, n: Name, sc: List[Type] * Type): Sig
function with_proc(sig: Sig, n: Name, g: List[Type] * List[Type] * List[Type] * List[Type]): Sig
function with_data(sig: Sig, n: Name, arity: Int): Sig
function with_members(sig: Sig, n: Name, cs: List[Name]): Sig
function with_constr(sig: Sig, n: Name, kc: List[Type] * List[Type] * Type): Sig
function with_native(sig: Sig, n: Name): Sig
function is_native(sig: Sig, n: Name): Bool

implementation

function empty(): Sig :=
  Sig(empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty_notations(), empty())

// the declarations of the modules ms
function restrict(sig: Sig, ms: List[Id]): Sig :=
  Sig(
    owned_map(sig.aliases, ms),
    owned_map(sig.funs, ms),
    owned_map(sig.procs, ms),
    owned_map(sig.datas, ms),
    owned_map(sig.members, ms),
    owned_map(sig.constrs, ms),
    put_all(owned_named(entries(sig.named), ms), empty()),
    sig.notations,
    from_list([n for n in list(sig.natives) if in_modules(n, ms)])
  )

function owned_map[V](m: Map[Name, V], ms: List[Id]): Map[Name, V] :=
  put_all(owned(entries(m), ms), empty())

function owned[V](es: List[Name * V], ms: List[Id]): List[Name * V] :=
  match es
    case Nil => Nil
    case [(n, v); rest] => if in_modules(n, ms) then [(n, v); owned(rest, ms)] else owned(rest, ms)
  end

function owned_named(es: List[Id * List[Name]], ms: List[Id]): List[Id * List[Name]] :=
  match es
    case Nil => Nil
    case [(b, ns); rest] =>
      let ks := [n for n in ns if in_modules(n, ms)] in if ks == Nil then owned_named(rest, ms) else [(b, ks); owned_named(rest, ms)]
  end

function in_modules(n: Name, ms: List[Id]): Bool :=
  match n.module
    case Some(m) => contains(m, ms)
    case None => false
  end

// the declarations of both, whose names differ since they are qualified by their modules
function union(a: Sig, b: Sig): Sig :=
  Sig(
    put_all(entries(b.aliases), a.aliases),
    put_all(entries(b.funs), a.funs),
    put_all(entries(b.procs), a.procs),
    put_all(entries(b.datas), a.datas),
    put_all(entries(b.members), a.members),
    put_all(entries(b.constrs), a.constrs),
    union_named(entries(b.named), a.named),
    union_notations(a.notations, b.notations),
    insert_all(list(b.natives), a.natives)
  )

// the signature without the private functions, procedures, and constructors, values, and without the private sorts, each kind
// of declaration filtered by its own names, since a datatype and its constructor may share a name, where an abstract type,
// whose constructors are private, has no members
function exported(sig: Sig, values: Set[Name], sorts: Set[Name]): Sig :=
  let kept := Sig(
      without(sig.aliases, sorts),
      without(sig.funs, values),
      without(sig.procs, values),
      without(sig.datas, sorts),
      put_all([e for e in entries(without(sig.members, sorts)) if not exists(value_of(e), lambda k => contains(k, values))], empty()),
      without(sig.constrs, values),
      empty(),
      sig.notations,
      sig.natives
    ) in
    kept with named := put_all([(key_of(e), [n for n in value_of(e) if declares(kept, n)]) for e in entries(sig.named)], empty())

function without[V](m: Map[Name, V], names: Set[Name]): Map[Name, V] :=
  put_all([e for e in entries(m) if not contains(key_of(e), names)], empty())

// a declaration of any kind named n
function declares(sig: Sig, n: Name): Bool :=
  is_alias(sig, n) or is_fun(sig, n) or is_proc(sig, n) or is_data(sig, n) or is_constr(sig, n)

function key_of[K, V](e: K * V): K :=
  match e
    case (k, _) => k
  end

function value_of[K, V](e: K * V): V :=
  match e
    case (_, v) => v
  end

function union_named(es: List[Id * List[Name]], bs: Map[Id, List[Name]]): Map[Id, List[Name]] :=
  match es
    case Nil => bs
    case [(k, ns); rest] =>
      match get(k, bs)
        case Some(ms) => union_named(rest, put(k, ms ++ ns, bs))
        case None => union_named(rest, put(k, ns, bs))
      end
  end

function alias_of(sig: Sig, n: Name): Option[List[Id] * Type] :=
  get(n, sig.aliases)

function schemes_of(sig: Sig, n: Name): List[List[Type] * Type] :=
  match get(n, sig.funs)
    case Some(ss) => ss
    case None => Nil
  end

function proc_of(sig: Sig, n: Name): Option[List[Type] * List[Type] * List[Type] * List[Type]] :=
  get(n, sig.procs)

function data_of(sig: Sig, n: Name): Option[Int] :=
  get(n, sig.datas)

function members_of(sig: Sig, n: Name): Option[List[Name]] :=
  get(n, sig.members)

function constr_of(sig: Sig, n: Name): Option[List[Type] * List[Type] * Type] :=
  get(n, sig.constrs)

function is_fun(sig: Sig, n: Name): Bool :=
  contains(n, sig.funs)

function is_proc(sig: Sig, n: Name): Bool :=
  contains(n, sig.procs)

function is_data(sig: Sig, n: Name): Bool :=
  contains(n, sig.datas)

function is_alias(sig: Sig, n: Name): Bool :=
  contains(n, sig.aliases)

function is_constr(sig: Sig, n: Name): Bool :=
  contains(n, sig.constrs)

function is_sort(sig: Sig, n: Name): Bool :=
  is_data(sig, n) or is_alias(sig, n)

// the declarations with base name b, of any kind and module, in the order of their declaration
function names_of(sig: Sig, b: Id): List[Name] :=
  match get(b, sig.named)
    case Some(ns) => ns
    case None => Nil
  end

function with_named(bs: Map[Id, List[Name]], n: Name): Map[Id, List[Name]] :=
  match get(n.base, bs)
    case Some(ns) => if contains(n, ns) then bs else put(n.base, ns ++ [n], bs)
    case None => put(n.base, [n], bs)
  end

function with_alias(sig: Sig, n: Name, ps: List[Id], t: Type): Sig :=
  sig with aliases := put(n, (ps, t), sig.aliases), named := with_named(sig.named, n)

function with_fun(sig: Sig, n: Name, sc: List[Type] * Type): Sig :=
  sig with funs := put(n, schemes_of(sig, n) ++ [sc], sig.funs), named := with_named(sig.named, n)

function with_proc(sig: Sig, n: Name, g: List[Type] * List[Type] * List[Type] * List[Type]): Sig :=
  sig with procs := put(n, g, sig.procs), named := with_named(sig.named, n)

function with_data(sig: Sig, n: Name, arity: Int): Sig :=
  sig with datas := put(n, arity, sig.datas), named := with_named(sig.named, n)

function with_members(sig: Sig, n: Name, cs: List[Name]): Sig :=
  sig with members := put(n, cs, sig.members)

function with_constr(sig: Sig, n: Name, kc: List[Type] * List[Type] * Type): Sig :=
  sig with constrs := put(n, kc, sig.constrs), named := with_named(sig.named, n)

function with_native(sig: Sig, n: Name): Sig :=
  sig with natives := insert(n, sig.natives)

function is_native(sig: Sig, n: Name): Bool :=
  contains(n, sig.natives)

// notations

function empty_notations(): Notations :=
  Notations(empty(), empty(), empty())

function prefix_prec(notations: Notations, op: Id): Option[Int] :=
  get(op, notations.prefix_ops)

function postfix_prec(notations: Notations, op: Id): Option[Int] :=
  get(op, notations.postfix_ops)

function infix_of(notations: Notations, op: Id): Option[Fixity * Int] :=
  get(op, notations.infix_ops)

// the notation of op of the kind of f, if any
function notation_of(notations: Notations, f: Fixity, op: Id): Option[Fixity * Int] :=
  match (f, prefix_prec(notations, op), postfix_prec(notations, op))
    case (FPrefix, Some(prec), _) => Some((FPrefix, prec))
    case (FPrefix, None, _) => None
    case (FPostfix, _, Some(prec)) => Some((FPostfix, prec))
    case (FPostfix, _, None) => None
    case _ => infix_of(notations, op)
  end

function is_operator(notations: Notations, op: Id): Bool :=
  contains(op, notations.prefix_ops) or contains(op, notations.postfix_ops) or contains(op, notations.infix_ops)

// the notations with those of the commands cmds
function with_notations(notations: Notations, cmds: List[Cmd]): Notations :=
  match cmds
    case Nil => notations
    case [CNotation(f, prec, ops); more] => with_notations(with_operators(notations, f, prec, ops), more)
    case [_; more] => with_notations(notations, more)
  end

function with_operators(notations: Notations, f: Fixity, prec: Int, ops: List[Id]): Notations :=
  match (f, ops)
    case (_, Nil) => notations
    case (FPrefix, [op; more]) => with_operators(notations with prefix_ops := put(op, prec, notations.prefix_ops), f, prec, more)
    case (FPostfix, [op; more]) => with_operators(notations with postfix_ops := put(op, prec, notations.postfix_ops), f, prec, more)
    case (_, [op; more]) => with_operators(notations with infix_ops := put(op, (f, prec), notations.infix_ops), f, prec, more)
  end

// the notations of both, where those of b count
function union_notations(a: Notations, b: Notations): Notations :=
  Notations(
    put_all(entries(b.prefix_ops), a.prefix_ops),
    put_all(entries(b.postfix_ops), a.postfix_ops),
    put_all(entries(b.infix_ops), a.infix_ops)
  )
