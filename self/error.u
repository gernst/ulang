// the runtime errors that the interpreter and compiled code both report, with their texts, which self/compile.u writes into
// every program as the formats u_text_* that self/runtime/ulang.c prints, where %s stands for a value as show gives it

export

data Failure :=
  case NoCase(text: Str)
  case CompareFunctions
  case CompareProcedures
  case AssertionFailed
  case AssertionUnequal(left: Str, right: Str)
  case Uncaught(text: Str)
  // of the qualified name of a function without parameters, which compiled code knows when it is compiled
  case RecursiveInitialization(name: Str)

function format_failure(failure: Failure): Str

// the formats of the failures whose values compiled code knows only at run time, by the names of their C variables
function failure_formats(): List[Str * Str]

implementation

function format_failure(failure: Failure): Str :=
  match failure
    case NoCase(text) => "no case matches " ++ text
    case CompareFunctions => "cannot compare functions"
    case CompareProcedures => "cannot compare procedures"
    case AssertionFailed => "assertion failed"
    case AssertionUnequal(left, right) => "assertion failed: " ++ left ++ " != " ++ right
    case Uncaught(text) => "uncaught exception " ++ text
    case RecursiveInitialization(name) => "recursive initialization of " ++ name
  end

function failure_formats(): List[Str * Str] :=
  [
    ("u_text_no_case", format_failure(NoCase("%s"))),
    ("u_text_compare_functions", format_failure(CompareFunctions)),
    ("u_text_compare_procedures", format_failure(CompareProcedures)),
    ("u_text_assertion_failed", format_failure(AssertionFailed)),
    ("u_text_assertion_unequal", format_failure(AssertionUnequal("%s", "%s"))),
    ("u_text_uncaught", format_failure(Uncaught("%s")))
  ]

test formats() :=
  assert contains(("u_text_assertion_unequal", "assertion failed: %s != %s"), failure_formats())
