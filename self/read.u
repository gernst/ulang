// call read(path; p) reads a file relative to this one, and returns its syntax before checking, where types are holes

import syntax

test
  local p: Program;
  call read("util.u"; p);
  match p
    case program(cfun(n, ps, xs, t, _) :: _) =>
      assert (n, ps) == ("contains", ["A"]);
      assert xs == [var("x", tparam("A")), var("xs", tsort("List", [tparam("A")]))];
      assert t == tsort("Bool", nil);
    case _ =>
      assert false;
  end
  call read("read.u"; p);
  match p
    case program(cimport("syntax") :: _) =>
      skip;
    case _ =>
      assert false;
  end
end
