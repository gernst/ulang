// call read(in path, out p) reads a file relative to this one, and returns its syntax before checking, where types are holes

import syntax

test read_files :=
  local  p: Program
  call   read(in "util.u", out p)
  match p
    case Program(CFun(n, ps, xs, t, _) :: _) =>
      assert (n, ps) == ("contains", ["A"])
      assert xs == [[Var("x", TParam("A")), Var("xs", TSort("List", [TParam("A")]))]]
      assert t == TSort("Bool", Nil)
    case _ =>
      assert false
  end
  call read(in "read.u", out p)
  match p
    case Program(CImport("syntax") :: _) =>
      skip
    case _ =>
      assert false
  end
