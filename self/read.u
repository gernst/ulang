// call read(in path, out p) reads a file relative to this one, and returns its syntax before checking, where types are holes,
// and raises OsError if there is no such file

import syntax
import os

test read_files :=
  local p: Program

  call read(in "../ulang/resources/option.u", out p)
  match p
    case Program([_, CFun(n, ps, xs, t, _); _]) =>
      assert (n, ps) == (unqualified("or_else"), ["A"])
      assert xs == [[Var(unqualified("a"), TSort(unqualified("Option"), [TParam("A")])), Var(unqualified("b"), TSort(unqualified("Option"), [TParam("A")]))]]
      assert t == TSort(unqualified("Option"), [TParam("A")])
    case _ =>
      assert false
  end
  call read(in "read.u", out p)
  match p
    case Program([CModule("syntax", _), CImport("syntax"); _]) =>
      skip
    case _ =>
      assert false
  end

test missing_file :=
  local p: Program, m: Str

  try
    call read(in "missing.u", out p)
  catch
    case OsError(e) =>
      assign m := e
  end
  assert m == "cannot read missing.u"
