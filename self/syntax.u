// the core syntax of ulang, without positions,
// where constructors are prefixed by their type, since they share one namespace

import map

export

// identifiers that never refer to declarations of modules: type parameters, modules, notation, runs, and tests
type Id :=
  Str

// a name with the module that declares it, which is None for locals, builtins, and names before checking
data Name :=
  | Name(module: Option[Id], base: Id)

data Type :=
  | THole
  | TMeta(Int)
  | TParam(Id)
  | TSort(Name, List[Type])
  | TFun(List[Type], Type)
  // procedures as values, (in A, out B, ref C), whose parameters have modes as in declarations
  | TProc(List[Type], List[Type], List[Type])
  | TTuple(List[Type])

data Val :=
  | VUnit
  | VBool(Bool)
  | VInt(Int)
  | VStr(Str)
  | VChar(Char)

// variable uses, binders, and pattern variables
data Var :=
  | Var(name: Name, typ: Type)

data Expr :=
  | ELit(Val)
  | EVar(Var)
  | EApp(Expr, List[Expr])
  | ELam(List[Var], Expr)
  // lambda in x, out y, ref z => body end, which sees the variables around it but assigns only its outs and refs
  | EProc(List[Var], List[Var], List[Var], Stmt)
  | ELet(List[Var * Expr], Expr)
  | EIte(Expr, Expr, Expr)
  | EMatch(Expr, List[Branch[Expr]])
  | ETuple(List[Expr])
  // an exception, as an expression of any type
  | ERaise(Expr, Type)

data Pat :=
  | PWild
  | PLit(Val)
  | PVar(Var)
  | PApp(Name, List[Pat])
  | PTuple(List[Pat])

// a case of a match with an optional guard
data Branch[A] :=
  | Branch(pat: Pat, guard: Option[Expr], body: A)

data Stmt :=
  | SSkip
  | SAssign(List[Var * Expr])
  | SBlock(List[Var], List[Stmt])
  | SIf(Expr, Stmt, Stmt)
  | SWhile(Expr, Stmt)
  | SCall(Name, List[Expr], List[Var], List[Var])
  | SMatch(Expr, List[Branch[Stmt]])
  | SAssert(Expr)
  | SRaise(Expr, Type)
  | STry(Stmt, List[Handler])

// handles exceptions of the type that match the pattern, or of any type if the pattern is PWild
data Handler :=
  | Handler(typ: Type, pat: Pat, guard: Option[Expr], body: Stmt)

data Constr :=
  | Constr(name: Name, args: List[Type])

data Fixity :=
  | FPrefix
  | FPostfix
  | FInfix
  | FLeft
  | FRight

data Cmd :=
  | CSort(Name, List[Id], Type)
  | CData(Name, List[Id], List[Constr])
  | CFun(Name, List[Id], List[List[Var]], Type, Expr)
  | CProc(Name, List[Id], List[Var], List[Var], List[Var], Stmt)
  // the first import of a module comes with the module itself, whose commands are those it declares
  | CNotation(Fixity, Int, List[Id])
  // tests take no parameters, which the checker enforces
  | CTest(Id, List[Var], Stmt)
  // the export section of a module, with the signatures of functions and procedures, as CFun and CProc without their
  // bodies, and abstract types, which its implementation section defines by data, and its builtin section, with the
  // signatures of exported functions and procedures that the interpreter and the runtime define
  | CFunSig(Name, List[Id], List[List[Var]], Type)
  | CProcSig(Name, List[Id], List[Var], List[Var], List[Var])
  | CAbstract(Name, List[Id])

data Prog :=
  | Prog(cmds: List[Cmd])

// the line and column of a command in its file, counted from 1, or 0 for commands that the parser did not read
data Pos :=
  | Pos(line: Int, col: Int)

// a module by its name, the modules it imports, its export section, its builtin section of signatures that the interpreter
// and the runtime define, and its implementation section, each command with the position where it starts, where a module
// without sections has all its commands implemented and exports nothing
data Mod :=
  | Mod(name: Id, imports: List[Id], exported: List[Pos * Cmd], builtins: List[Pos * Cmd], implemented: List[Pos * Cmd])

// a program by its modules in load order, each after the modules it imports, where the module main comes last
data Source :=
  | Source(mods: List[Mod], main: Id)

function unqualified(x: Id): Name
function tuple_name(): Name

function list_name(): Name
function nil_name(): Name
function cons_name(): Name
function option_name(): Name
function none_name(): Name
function some_name(): Name
function os_error_name(): Name

function division_by_zero_name(): Name
function no_index_name(): Name
function out_of_bounds_name(): Name
function no_character_name(): Name
function missing_field_name(): Name

function type_bool(): Type
function type_int(): Type
function type_str(): Type
function type_char(): Type
function type_list(t: Type): Type
function type_fun(args: List[Type], res: Type): Type

function arity(t: Type): Int

function names(xs: List[Var]): List[Name]
function types(xs: List[Var]): List[Type]
function first_list(xss: List[List[Var]]): List[Var]

function type_plain_list(t: Type): Type
function expr_var(n: Id): Expr
function expr_int(n: Int): Expr
function expr_app(f: Id, args: List[Expr]): Expr
function pat_var(n: Id): Pat
function lists(): List[Mod]
function with_lists(cmds: List[Cmd]): Source
function program_of(cmds: List[Cmd]): Source
function natives_prelude(): Mod
function commands_of(d: Mod): List[Cmd]
function placed_of(d: Mod): List[Pos * Cmd]
function exported_notation(d: Mod): Notation
function implicit_imports(name: Id): List[Id]
function all_imports(d: Mod): List[Id]
function unplaced(cmds: List[Cmd]): List[Pos * Cmd]
function without_positions(d: Mod): Mod
function last_mod(mods: List[Mod]): Mod
function but_last(mods: List[Mod]): List[Mod]

// the precedences of prefix and postfix operators, and the fixities and precedences of infix ones
data Notation :=
  | Notation(prefix_ops: Map[Id, Int], postfix_ops: Map[Id, Int], infix_ops: Map[Id, Fixity * Int])

function empty_notation(): Notation
function prefix_prec(notation: Notation, op: Id): Option[Int]
function postfix_prec(notation: Notation, op: Id): Option[Int]
function infix_of(notation: Notation, op: Id): Option[Fixity * Int]
function notation_of(notation: Notation, f: Fixity, op: Id): Option[Fixity * Int]
function is_operator(notation: Notation, op: Id): Bool
function with_notation(notation: Notation, cmds: List[Cmd]): Notation
function with_operators(notation: Notation, f: Fixity, prec: Int, ops: List[Id]): Notation
function union_notation(a: Notation, b: Notation): Notation

implementation

// a name without a module, of a local or a builtin, or before checking
function unqualified(x: Id): Name :=
  Name(None, x)

function tuple_name(): Name :=
  unqualified(",")

// names that builtins and the runtime create, of the modules of the library
function list_name(): Name :=
  Name(Some("list"), "List")

function nil_name(): Name :=
  Name(Some("list"), "Nil")

function cons_name(): Name :=
  Name(Some("list"), "Cons")

function option_name(): Name :=
  Name(Some("option"), "Option")

function none_name(): Name :=
  Name(Some("option"), "None")

function some_name(): Name :=
  Name(Some("option"), "Some")

function os_error_name(): Name :=
  Name(Some("os"), "OsError")

// the exceptions of the builtins and of accessors of fields, which the prelude declares
function division_by_zero_name(): Name :=
  Name(Some("prelude"), "DivisionByZero")

function no_index_name(): Name :=
  Name(Some("prelude"), "NoIndex")

function out_of_bounds_name(): Name :=
  Name(Some("prelude"), "OutOfBounds")

function no_character_name(): Name :=
  Name(Some("prelude"), "NoCharacter")

function missing_field_name(): Name :=
  Name(Some("prelude"), "MissingField")

// the types of the builtins
function type_bool(): Type :=
  TSort(Name(Some("prelude"), "Bool"), Nil)

function type_int(): Type :=
  TSort(Name(Some("prelude"), "Int"), Nil)

function type_str(): Type :=
  TSort(Name(Some("prelude"), "Str"), Nil)

function type_char(): Type :=
  TSort(Name(Some("prelude"), "Char"), Nil)

function type_list(t: Type): Type :=
  TSort(list_name(), [t])

function type_fun(args: List[Type], res: Type): Type :=
  TFun(args, res)

// the number of arguments of a function type, functions are overloaded by it
function arity(t: Type): Int :=
  match t
    case TFun(args, _) => size(args)
    case _ => -1
  end

function names(xs: List[Var]): List[Name] :=
  [x.name for x in xs]

function types(xs: List[Var]): List[Type] :=
  [x.typ for x in xs]

// the first list of formals of a function, by whose length functions are overloaded
function first_list(xss: List[List[Var]]): List[Var] :=
  match xss
    case Nil => Nil
    case [xs; _] => xs
  end

// abbreviations for the syntax, of the parser and of tests

// the lists of the tests, before checking
function type_plain_list(t: Type): Type :=
  TSort(unqualified("List"), [t])

function expr_var(n: Id): Expr :=
  EVar(Var(unqualified(n), THole))

function expr_int(n: Int): Expr :=
  ELit(VInt(n))

function expr_app(f: Id, args: List[Expr]): Expr :=
  EApp(expr_var(f), args)

function pat_var(n: Id): Pat :=
  PVar(Var(unqualified(n), THole))

// lists with constructors Nil and Cons, exported by the module list as in the library, and their length
function lists(): List[Mod] :=
  [Mod("list", Nil, unplaced([CData(unqualified("List"), ["A"], [Constr(unqualified("Nil"), Nil), Constr(unqualified("Cons"), [TParam("A"), type_plain_list(TParam("A"))])])]), Nil, Nil)]

// the program of the commands cmds after len of the module main, which imports lists
function with_lists(cmds: List[Cmd]): Source :=
  Source([natives_prelude(); lists()] ++ [Mod("main", ["list"], Nil, Nil, unplaced([len_fun(); cmds]))], "main")

function len_fun(): Cmd :=
  CFun(
    unqualified("len"),
    ["A"],
    [[Var(unqualified("xs"), type_plain_list(TParam("A")))]],
    type_int(),
    EMatch(expr_var("xs"), [Branch(pat_var("Nil"), None, expr_int(0)), Branch(PApp(unqualified("Cons"), [PWild, pat_var("ys")]), None, expr_app("+", [expr_int(1), expr_app("len", [expr_var("ys")])]))])
  )

// a prelude of the builtin types and functions of prelude/prelude.u only, for programs that are not parsed
function natives_prelude(): Mod :=
  let int_op := lambda op => CFunSig(unqualified(op), Nil, [[Var(unqualified("a"), type_int()), Var(unqualified("b"), type_int())]], type_int()) in
    Mod(
      "prelude",
      Nil,
      Nil,
      unplaced([CAbstract(unqualified(t), Nil) for t in ["Bool", "Int", "Str", "Char"]] ++ [int_op(op) for op in ["+", "-", "*", "/", "%"]] ++ [CFunSig(unqualified("++"), Nil, [[Var(unqualified("a"), type_str()), Var(unqualified("b"), type_str())]], type_str())]),
      Nil
    )

// the program of the commands cmds of the module main
function program_of(cmds: List[Cmd]): Source :=
  Source([natives_prelude(), Mod("main", Nil, Nil, Nil, unplaced(cmds))], "main")

// the commands of all sections, in order
function commands_of(d: Mod): List[Cmd] :=
  seconds(placed_of(d))

// the commands of all sections with their positions, in order
function placed_of(d: Mod): List[Pos * Cmd] :=
  d.exported ++ d.builtins ++ d.implemented

// the notation that module d exports to its importers, of the notation commands of its export section
function exported_notation(d: Mod): Notation :=
  with_notation(empty_notation(), seconds(d.exported))

// the modules that module name imports without saying so, from the library: the prelude and the modules that every module
// sees with it, where each of these imports those before it
function implicit_imports(name: Id): List[Id] :=
  implicit_before(name, ["prelude", "option", "list", "str"])

function implicit_before(name: Id, core: List[Id]): List[Id] :=
  match core
    case Nil => Nil
    case [m; rest] => if m == name then Nil else [m; implicit_before(name, rest)]
  end

// the modules that d imports, implicitly or by its imports, in that order
function all_imports(d: Mod): List[Id] :=
  let implicit := implicit_imports(d.name) in implicit ++ [m for m in d.imports if not contains(m, implicit)]

// commands without positions, as programs that are not parsed have them
function unplaced(cmds: List[Cmd]): List[Pos * Cmd] :=
  [(Pos(0, 0), c) for c in cmds]

// the last of the modules, the main module of a source
function last_mod(mods: List[Mod]): Mod :=
  match mods
    case [d] => d
    case [_; rest] => last_mod(rest)
    case Nil => Mod("", Nil, Nil, Nil, Nil)
  end

// the modules before the last
function but_last(mods: List[Mod]): List[Mod] :=
  match mods
    case [_] => Nil
    case [d; rest] => [d; but_last(rest)]
    case Nil => Nil
  end

// module d with the positions of its commands forgotten, to compare its commands
function without_positions(d: Mod): Mod :=
  d with exported := unplaced(seconds(d.exported)), builtins := unplaced(seconds(d.builtins)), implemented := unplaced(seconds(d.implemented))

// f(x) + 1, as the parser would produce it
test syntax() :=
  local f: Var, x: Var

  assign f := Var(unqualified("f"), THole), x := Var(unqualified("x"), THole)
  assert names([f, x]) == [unqualified("f"), unqualified("x")]
  assert types([f]) == [THole]

// notation

function empty_notation(): Notation :=
  Notation(empty(), empty(), empty())

function prefix_prec(notation: Notation, op: Id): Option[Int] :=
  get(op, notation.prefix_ops)

function postfix_prec(notation: Notation, op: Id): Option[Int] :=
  get(op, notation.postfix_ops)

function infix_of(notation: Notation, op: Id): Option[Fixity * Int] :=
  get(op, notation.infix_ops)

// the notation of op of the kind of f, if any
function notation_of(notation: Notation, f: Fixity, op: Id): Option[Fixity * Int] :=
  match (f, prefix_prec(notation, op), postfix_prec(notation, op))
    case (FPrefix, Some(prec), _) => Some((FPrefix, prec))
    case (FPrefix, None, _) => None
    case (FPostfix, _, Some(prec)) => Some((FPostfix, prec))
    case (FPostfix, _, None) => None
    case _ => infix_of(notation, op)
  end

function is_operator(notation: Notation, op: Id): Bool :=
  contains(op, notation.prefix_ops) or contains(op, notation.postfix_ops) or contains(op, notation.infix_ops)

// the notation with those of the commands cmds
function with_notation(notation: Notation, cmds: List[Cmd]): Notation :=
  match cmds
    case Nil => notation
    case [CNotation(f, prec, ops); more] => with_notation(with_operators(notation, f, prec, ops), more)
    case [_; more] => with_notation(notation, more)
  end

function with_operators(notation: Notation, f: Fixity, prec: Int, ops: List[Id]): Notation :=
  match (f, ops)
    case (_, Nil) => notation
    case (FPrefix, [op; more]) => with_operators(notation with prefix_ops := put(op, prec, notation.prefix_ops), f, prec, more)
    case (FPostfix, [op; more]) => with_operators(notation with postfix_ops := put(op, prec, notation.postfix_ops), f, prec, more)
    case (_, [op; more]) => with_operators(notation with infix_ops := put(op, (f, prec), notation.infix_ops), f, prec, more)
  end

// the notation of both, where those of b count
function union_notation(a: Notation, b: Notation): Notation :=
  Notation(
    a.prefix_ops ++ b.prefix_ops,
    a.postfix_ops ++ b.postfix_ops,
    a.infix_ops ++ b.infix_ops
  )
