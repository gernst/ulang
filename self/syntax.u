// the core syntax, mirroring ulang/src/ulang/Syntax.scala without positions,
// where constructors are prefixed by their type, since they share one namespace

// identifiers that never refer to declarations of modules: type parameters, modules, notations, runs, and tests
type Id :=
  Str

// a name with the module that declares it, which is None for locals, builtins, and names before checking
data Name :=
  | Name(module: Option[Id], base: Id)

data Type :=
  | THole
  | TMeta(Int)
  | TParam(Id)
  | TSort(Name, List[Type])
  | TFun(List[Type], Type)
  // procedures as values, (in A, out B, ref C), whose parameters have modes as in declarations
  | TProc(List[Type], List[Type], List[Type])
  | TTuple(List[Type])

data Val :=
  | VUnit
  | VBool(Bool)
  | VInt(Int)
  | VStr(Str)
  | VChar(Char)

// variable uses, binders, and pattern variables, which Syntax.scala distinguishes as Expr.Var and Pat.Var
data Var :=
  | Var(name: Name, typ: Type)

data Expr :=
  | ELit(Val)
  | EVar(Var)
  | EApp(Expr, List[Expr])
  | ELam(List[Var], Expr)
  // lambda in x, out y, ref z => body end, which sees the variables around it but assigns only its outs and refs
  | EProc(List[Var], List[Var], List[Var], Stmt)
  | ELet(List[Var * Expr], Expr)
  | EIte(Expr, Expr, Expr)
  | EMatch(Expr, List[Branch[Expr]])
  | EComp(Expr, List[Var], List[Expr], Expr)
  | ETuple(List[Expr])
  // an exception, as an expression of any type
  | ERaise(Expr, Type)

data Pat :=
  | PWild
  | PLit(Val)
  | PVar(Var)
  | PApp(Name, List[Pat])
  | PTuple(List[Pat])

// a case of a match with an optional guard, which is Case in Syntax.scala
data Branch[A] :=
  | Branch(pat: Pat, guard: Option[Expr], body: A)

data Stmt :=
  | SSkip
  | SAssign(List[Var * Expr])
  | SBlock(List[Var], List[Stmt])
  | SIf(Expr, Stmt, Stmt)
  | SWhile(Expr, Stmt)
  | SCall(Name, List[Expr], List[Var], List[Var])
  | SMatch(Expr, List[Branch[Stmt]])
  | SAssert(Expr)
  | SRaise(Expr, Type)
  | STry(Stmt, List[Handler])

// handles exceptions of the type that match the pattern, or of any type if the pattern is PWild
data Handler :=
  | Handler(typ: Type, pat: Pat, guard: Option[Expr], body: Stmt)

data Constr :=
  | Constr(name: Name, args: List[Type])

data Fixity :=
  | FPrefix
  | FPostfix
  | FInfix
  | FLeft
  | FRight

data Cmd :=
  | CSort(Name, List[Id], Type)
  | CData(Name, List[Id], List[Constr])
  | CFun(Name, List[Id], List[List[Var]], Type, Expr)
  | CProc(Name, List[Id], List[Var], List[Var], List[Var], Stmt)
  // the first import of a module comes with the module itself, whose commands are those it declares
  | CModule(Id, List[Cmd])
  | CImport(Id)
  | CNotation(Fixity, Int, List[Id])
  | CEval(Expr)
  | CRun(Id, Stmt)
  | CTest(Id, Stmt)

data Program :=
  | Program(cmds: List[Cmd])

// a name without a module, of a local or a builtin, or before checking
function unqualified(x: Id): Name :=
  Name(None, x)

// the name with its module, to tell names apart
function qualified(n: Name): Str :=
  match n
    case Name(Some(m), b) => m ^ "." ^ b
    case Name(None, b) => b
  end

// names that builtins and the runtime create, of the modules of the library
function list_name(): Name :=
  Name(Some("list"), "List")

function nil_name(): Name :=
  Name(Some("list"), "Nil")

function cons_name(): Name :=
  Name(Some("list"), "Cons")

function option_name(): Name :=
  Name(Some("option"), "Option")

function none_name(): Name :=
  Name(Some("option"), "None")

function some_name(): Name :=
  Name(Some("option"), "Some")

function os_error_name(): Name :=
  Name(Some("os"), "OsError")

// the exceptions of the builtins and of accessors of fields, which the prelude declares
function division_by_zero_name(): Name :=
  Name(Some("prelude"), "DivisionByZero")

function no_index_name(): Name :=
  Name(Some("prelude"), "NoIndex")

function no_character_name(): Name :=
  Name(Some("prelude"), "NoCharacter")

function missing_field_name(): Name :=
  Name(Some("prelude"), "MissingField")

function tuple_name(): Name :=
  unqualified(",")

function names(xs: List[Var]): List[Name] :=
  [x.name for x in xs]

function types(xs: List[Var]): List[Type] :=
  [x.typ for x in xs]

// the number of arguments of a function type, functions are overloaded by it
function arity(t: Type): Int :=
  match t
    case TFun(args, _) => length(args)
    else -1
  end

// f(x) + 1, as the parser would produce it
test syntax :=
  local f: Var, x: Var, e: Expr

  assign f := Var(unqualified("f"), THole), x := Var(unqualified("x"), THole)
  assign e := EApp(EVar(Var(unqualified("+"), THole)), [EApp(EVar(f), [EVar(x)]), ELit(VInt(1))])
  assert names([f, x]) == [unqualified("f"), unqualified("x")]
  assert types([f]) == [THole]
  assert qualified(cons_name()) == "list.Cons" and cons_name().base == "Cons"
