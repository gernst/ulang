// values, types, patterns, and names as text by their structure, for the messages of the checker and the interpreter, where
// show of the program uses the shows that datatypes declare, see show_in of self/run.u, while self/format.u shows programs

import syntax
import value
import array

export

function show_value(v: Value): Str
function show_type(t: Type): Str
function show_types(ts: List[Type]): Str
function show_pat(pat: Pat): Str
function text_of(v: Value): Str
function show_name(n: Name): Str
function symbolic(n: Id): Bool

implementation

function show_value(v: Value): Str :=
  match v
    case Lit(VUnit) => "()"
    case Lit(VBool(b)) => if b then "true" else "false"
    case Lit(VInt(n)) => show(n)
    case Lit(VStr(s)) => quote(s)
    case Lit(VChar(c)) => "'" ++ escape_char(c) ++ "'"
    case Obj(n, vs) if n == tuple_name() => "(" ++ show_values(vs) ++ ")"
    case Obj(n, _) if n == cons_name() and list_elements(v) != None => "[" ++ show_values(list_items(v)) ++ "]"
    case Obj(n, Nil) if n == nil_name() => "[]"
    case Obj(n, Nil) => n.base
    case Obj(n, vs) => n.base ++ "(" ++ show_values(vs) ++ ")"
    case Arr(a) => "array([" ++ show_values(list(a)) ++ "])"
    case Proc(_) => "<procedure>"
    case ProcClos(_, _, _, _, _) => "<procedure>"
    case _ => "<function>"
  end

function show_values(vs: List[Value]): Str :=
  join(", ", [show_value(v) for v in vs])

function list_items(v: Value): List[Value] :=
  match list_elements(v)
    case Some(vs) => vs
    case None => Nil
  end

function escape_char(c: Char): Str :=
  match c
    case '\\' => "\\\\"
    case '\n' => "\\n"
    case '\t' => "\\t"
    case '\r' => "\\r"
    case '\'' => "\\'"
    case _ => string([c])
  end

// types as the messages of the checker show them, without numbering the unknowns anew
function show_type(t: Type): Str :=
  match t
    case TParam(n) => n
    case THole => "_"
    case TMeta(i) => "?" ++ show(i)
    case TFun([TTuple([])], r) => "(()) -> " ++ show_type(r)
    case TFun([a], r) => type_operand(a) ++ " -> " ++ show_type(r)
    case TFun(args, r) => "(" ++ show_types(args) ++ ") -> " ++ show_type(r)
    case TProc(is, os, rs) => "(" ++ join(", ", type_section("in", is) ++ type_section("out", os) ++ type_section("ref", rs)) ++ ")"
    case TTuple([]) => "()"
    case TTuple(ts) => join(" * ", [type_component(a) for a in ts])
    case TSort(n, []) => n.base
    case TSort(n, args) => n.base ++ "[" ++ show_types(args) ++ "]"
  end

function show_types(ts: List[Type]): Str :=
  join(", ", [show_type(t) for t in ts])

function type_section(mode: Str, ts: List[Type]): List[Str] :=
  if ts == [] then [] else [mode ++ " " ++ show_types(ts)]

// the argument of a function, in parentheses if it is a function
function type_operand(t: Type): Str :=
  match t
    case TFun(_, _) => "(" ++ show_type(t) ++ ")"
    case _ => show_type(t)
  end

// a component of a tuple, in parentheses if it is a function or a tuple
function type_component(t: Type): Str :=
  match t
    case TFun(_, _) => "(" ++ show_type(t) ++ ")"
    case TTuple([_, _; _]) => "(" ++ show_type(t) ++ ")"
    case _ => show_type(t)
  end

// patterns as the messages of the checker show them
function show_pat(pat: Pat): Str :=
  match pat
    case PWild => "_"
    case PLit(l) => show_value(Lit(l))
    case PVar(x) => x.name.base
    case PTuple(ps) => "(" ++ show_pats(ps) ++ ")"
    case PApp(n, [x, xs]) if n == cons_name() or n == unqualified("Cons") => "[" ++ show_pat(x) ++ "; " ++ show_pat(xs) ++ "]"
    case PApp(n, [l, r]) if symbolic(n.base) => infix_text(n.base, show_pat(l), show_pat(r))
    case PApp(n, []) => n.base
    case PApp(n, ps) => n.base ++ "(" ++ show_pats(ps) ++ ")"
  end

function show_pats(pats: List[Pat]): Str :=
  join(", ", [show_pat(p) for p in pats])

// constructors named by operators are shown infix
function symbolic(n: Id): Bool :=
  let c := at(0, n) in not is_letter(c) and c != '_' and n != ","

function infix_text(op: Id, l: Str, r: Str): Str :=
  pat_operand(l) ++ " " ++ op ++ " " ++ pat_operand(r)

function pat_operand(a: Str): Str :=
  if contains(' ', a) and at(0, a) != '(' then "(" ++ a ++ ")" else a

// the text of a string, for os_print
function text_of(v: Value): Str :=
  match v
    case Lit(VStr(s)) => s
    case _ => show_value(v)
  end

// the name with its module, to tell names apart
function show_name(n: Name): Str :=
  match n
    case Name(Some(m), b) => m ++ "." ++ b
    case Name(None, b) => b
  end

test printing() :=
  assert show_type(TFun([TFun([TParam("A")], TParam("B")), TTuple([TSort(unqualified("Int"), []), TSort(unqualified("Str"), [])])], TSort(unqualified("List"), [TParam("A")]))) == "(A -> B, Int * Str) -> List[A]"
  assert show_type(TProc([TParam("A")], [], [TSort(unqualified("Int"), [])])) == "(in A, ref Int)"
  assert show_pat(PApp(cons_name(), [PVar(Var(unqualified("x"), THole)), PApp(unqualified("Some"), [PWild])])) == "[x; Some(_)]"
  assert show_value(list_value([Lit(VInt(1)), Lit(VStr("a\"b"))])) == "[1, \"a\\\"b\"]"
  assert show_value(Obj(tuple_name(), [Lit(VChar('\'')), Obj(nil_name(), Nil), Obj(unqualified("Some"), [Lit(VBool(true))])])) == "('\\'', [], Some(true))"
  assert show_name(cons_name()) == "list.Cons" and cons_name().base == "Cons"
