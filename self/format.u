// the tool's values, types, patterns, names, and programs as ulang source, where values, types, patterns, and names are
// formatted by their structure, for the messages of the checker and the interpreter, while show of the program uses the shows
// that datatypes declare, see show_in of self/run.u, and programs are formatted with the notation in effect, as ulang.bin
// format prints them, which parses to the same commands

import syntax
import value
import array

export

function format_program(mods: List[Mod]): Str
function format_value(v: Value): Str
function format_type(t: Type): Str
function format_types(ts: List[Type]): Str
function format_pat(pat: Pat): Str
function text_of(v: Value): Str
function array_text(texts: List[Str]): Str
function format_name(n: Name): Str
function symbolic(n: Id): Bool

implementation

// programs as source, where the notation of the prelude, of the program, and of its imports decide where operators need
// parentheses, and the translations of the parser are printed as what they translate, so that the source parses to the
// same commands

// the text of an expression or pattern with how it binds, which decides whether it needs parentheses where it occurs
data Doc :=
  | Doc(text: Str, shape: Shape)

// an open form extends as far to the right as it can, as if, let, lambda without modes, raise, and updates do, a negative
// literal would be read as - applied to its operand, and an operator binds its operands by its fixity and precedence
data Shape :=
  | Atom
  | Open
  | Negative
  | Operator(Fixity, Int)

// the last of the modules mods as source, after the modules before it, whose notation it starts with as far as it imports them,
// implicitly or not
function format_program(mods: List[Mod]): Str :=
  let d := last_mod(mods) in
    join("\n\n", format_mod(imported_notation(mods, all_imports(d)), d)) ++ "\n"

// the notation that the modules names of mods export, in order
function imported_notation(mods: List[Mod], names: List[Id]): Notation :=
  with_notation(empty_notation(), [c for d in mods, c in seconds(d.exported) if contains(d.name, names)])

// the imports of module d and its sections, where its export section declares the notation of the sections after it, and a
// module that exports nothing has no sections
function format_mod(notation: Notation, d: Mod): List[Str] :=
  ["import " ++ n for n in d.imports] ++
    if d.exported == Nil and d.builtins == Nil then
      format_cmds(notation, seconds(d.implemented))
    else
      let inner := with_notation(notation, seconds(d.exported)) in
        ["export"; format_cmds(notation, seconds(d.exported))] ++ (if d.builtins == Nil then [] else ["builtin"; format_cmds(inner, seconds(d.builtins))]) ++
          (if d.implemented == Nil then [] else ["implementation"; format_cmds(inner, seconds(d.implemented))])

// operators and parentheses

// op applied to the operands, if it is declared as an operator of their number
function operator_doc(notation: Notation, op: Id, args: List[Doc]): Option[Doc] :=
  match (args, infix_of(notation, op), prefix_prec(notation, op), postfix_prec(notation, op))
    case ([l, r], Some((f, prec)), _, _) =>
      Some(Doc(infix_operand(l, f, prec, FLeft) ++ " " ++ op ++ " " ++ infix_operand(r, f, prec, FRight), Operator(f, prec)))
    case ([a], _, Some(prec), _) =>
      Some(Doc(prefix_text(op, prefix_operand(a, prec)), Operator(FPrefix, prec)))
    case ([a], _, _, Some(prec)) =>
      Some(Doc(postfix_operand(a) ++ " " ++ op, Operator(FPostfix, prec)))
    case _ =>
      None
  end

function parenthesized(d: Doc, needed: Bool): Str :=
  if needed then "(" ++ d.text ++ ")" else d.text

// an operand of an infix operator of fixity f and precedence prec on the side FLeft or FRight, where a prefix operator
// would take the operators after it of its precedence or above, and a chain of an associative operator needs none
function infix_operand(d: Doc, f: Fixity, prec: Int, side: Fixity): Str :=
  parenthesized(d, match d.shape
      case Atom => false
      case Operator(FPrefix, q) => q <= prec
      case Operator(FPostfix, _) => true
      case Operator(g, q) => q < prec or q == prec and not (f == side and g == side)
      case _ => true
    end)

// the operand of a prefix operator, which takes the operators of its precedence or above
function prefix_operand(d: Doc, prec: Int): Str :=
  parenthesized(d, match d.shape
      case Atom => false
      case Operator(FPostfix, _) => true
      case Operator(_, q) => q < prec
      case _ => true
    end)

function postfix_operand(d: Doc): Str :=
  parenthesized(d, match d.shape
      case Atom => false
      case Operator(FPostfix, _) => false
      case _ => true
    end)

// a name is separated from its operand, and a symbol only from an operand that starts with a symbol, as in - -x
function prefix_text(op: Id, a: Str): Str :=
  if not symbolic(op) or is_symbol(at(0, a)) then op ++ " " ++ a else op ++ a

function is_symbol(c: Char): Bool :=
  contains(c, "-+*/%<>=!&:^~?@#$")

// the function of an application, and the record of an access
function atom_text(d: Doc): Str :=
  parenthesized(d, d.shape != Atom)

// an expression before a comma that a name and := may follow, which would continue its updates
function closed_text(d: Doc): Str :=
  parenthesized(d, d.shape == Open)

// expressions, at the indentation of the line they start on

function format_expr(notation: Notation, indent: Str, expr: Expr): Str :=
  expr_doc(notation, indent, expr).text

function format_exprs(notation: Notation, indent: Str, exprs: List[Expr]): Str :=
  join(", ", [format_expr(notation, indent, e) for e in exprs])

function expr_doc(notation: Notation, indent: Str, expr: Expr): Doc :=
  match expr
    case ELit(VInt(n)) if n < 0 =>
      Doc(show(n), Negative)
    case ELit(v) =>
      Doc(format_value(Lit(v)), Atom)
    case EVar(Var(Name(None, "Nil"), _)) =>
      Doc("[]", Atom)
    case EVar(x) =>
      Doc(x.name.base, Atom)
    case EApp(EVar(Var(Name(Some("*"), "array"), _)), [a]) if cons_rest(a) == EVar(Var(unqualified("Nil"), THole)) =>
      Doc(array_text([format_expr(notation, indent, e) for e in cons_items(a)]), Atom)
    case EApp(EVar(Var(Name(Some("*"), "array"), _)), [a]) =>
      Doc(bars(atom_text(expr_doc(notation, indent, a))), Atom)
    case EApp(EVar(Var(Name(Some("*"), f), _)), args) =>
      translation_doc(notation, indent, f, expr, args)
    case EApp(EVar(Var(Name(None, "Cons"), _)), [_, _]) =>
      Doc(list_text(notation, indent, expr), Atom)
    case EApp(EVar(Var(Name(None, f), _)), [a]) if is_access(f) =>
      Doc(atom_text(expr_doc(notation, indent, a)) ++ f, Atom)
    case EApp(EVar(Var(Name(None, f), _)), [_, _]) if is_update(f) =>
      updates_doc(notation, indent, expr)
    case EApp(f, args) =>
      app_doc(notation, indent, f, args)
    case ELam(Nil, body) =>
      Doc("lambda => " ++ format_expr(notation, indent, body), Open)
    case ELam(xs, body) =>
      Doc("lambda " ++ join(", ", [formal_text(x) for x in xs]) ++ " => " ++ format_expr(notation, indent, body), Open)
    case EProc(ins, outs, refs, body) =>
      Doc("lambda " ++ formal_sections(ins, outs, refs) ++ " =>" ++ format_body(notation, deeper(indent), body) ++ "\n" ++ indent ++ "end", Atom)
    case ELet(bindings, body) =>
      Doc("let " ++ assignments_text(notation, indent, bindings) ++ " in " ++ format_expr(notation, indent, body), Open)
    case EIte(c, a, b) =>
      Doc("if " ++ format_expr(notation, indent, c) ++ " then " ++ format_expr(notation, indent, a) ++ " else " ++ format_expr(notation, indent, b), Open)
    case EMatch(a, branches) =>
      Doc("match " ++ format_expr(notation, indent, a) ++ expr_cases(notation, deeper(indent), branches) ++ "\n" ++ indent ++ "end", Atom)
    case ETuple(es) =>
      Doc("(" ++ format_exprs(notation, indent, es) ++ ")", Atom)
    case ERaise(a, _) =>
      Doc("raise " ++ format_expr(notation, indent, a), Open)
  end

function app_doc(notation: Notation, indent: Str, f: Expr, args: List[Expr]): Doc :=
  let docs := [expr_doc(notation, indent, a) for a in args] in
    match f
      case EVar(Var(n, _)) =>
        match operator_doc(notation, n.base, docs)
          case Some(d) => d
          case None => Doc(n.base ++ "(" ++ texts(docs) ++ ")", Atom)
        end
      case _ =>
        Doc(atom_text(expr_doc(notation, indent, f)) ++ "(" ++ texts(docs) ++ ")", Atom)
    end

function texts(docs: List[Doc]): Str :=
  join(", ", [d.text for d in docs])

function is_access(f: Id): Bool :=
  at(0, f) == '.' and not is_update(f)

function is_update(f: Id): Bool :=
  let n := size(f) in at(0, f) == '.' and n > 3 and slice(f, n - 2, n) == ":="

// [a, b] for a list that ends in Nil, and [a, b; c] for one that ends in c
function list_text(notation: Notation, indent: Str, expr: Expr): Str :=
  match cons_rest(expr)
    case EVar(Var(Name(None, "Nil"), _)) => "[" ++ format_exprs(notation, indent, cons_items(expr)) ++ "]"
    case rest => "[" ++ format_exprs(notation, indent, cons_items(expr)) ++ "; " ++ format_expr(notation, indent, rest) ++ "]"
  end

function cons_items(expr: Expr): List[Expr] :=
  match expr
    case EApp(EVar(Var(Name(None, "Cons"), _)), [a, b]) => [a; cons_items(b)]
    case _ => Nil
  end

function cons_rest(expr: Expr): Expr :=
  match expr
    case EApp(EVar(Var(Name(None, "Cons"), _)), [_, b]) => cons_rest(b)
    case _ => expr
  end

// e with f := a, g := b, which the parser applies from the left, where e and the values are operands without updates
function updates_doc(notation: Notation, indent: Str, expr: Expr): Doc :=
  match updates_of(expr)
    case (r, updates) =>
      Doc(closed_text(expr_doc(notation, indent, r)) ++ " with " ++ join(", ", [update_text(notation, indent, u) for u in updates]), Open)
  end

function update_text(notation: Notation, indent: Str, update: Id * Expr): Str :=
  match update
    case (f, a) => f ++ " := " ++ closed_text(expr_doc(notation, indent, a))
  end

function updates_of(expr: Expr): Expr * List[Id * Expr] :=
  match expr
    case EApp(EVar(Var(Name(None, f), _)), [r, a]) if is_update(f) =>
      match updates_of(r)
        case (s, updates) => (s, updates ++ [(slice(f, 1, size(f) - 2), a)])
      end
    case _ =>
      (expr, Nil)
  end

// x := e, y := f, where an open form before a comma is parenthesized
function assignments_text(notation: Notation, indent: Str, pairs: List[Var * Expr]): Str :=
  match pairs
    case Nil => ""
    case [(x, a)] => x.name.base ++ " := " ++ format_expr(notation, indent, a)
    case [(x, a); more] => x.name.base ++ " := " ++ closed_text(expr_doc(notation, indent, a)) ++ ", " ++ assignments_text(notation, indent, more)
  end

function expr_cases(notation: Notation, indent: Str, branches: List[Branch[Expr]]): Str :=
  join("", ["\n" ++ indent ++ case_head(notation, indent, b.pat, b.guard) ++ " " ++ format_expr(notation, indent, b.body) for b in branches])

function case_head(notation: Notation, indent: Str, pat: Pat, guard: Option[Expr]): Str :=
  match guard
    case Some(g) => "case " ++ format_pattern(notation, pat) ++ " if " ++ format_expr(notation, indent, g) ++ " =>"
    case None => "case " ++ format_pattern(notation, pat) ++ " =>"
  end

// |a, b| of the text [a, b] of a list or a list comprehension
function bars(text: Str): Str :=
  "|" ++ slice(text, 1, size(text) - 1) ++ "|"

function deeper(indent: Str): Str :=
  indent ++ "  "

// the translations of literals and comprehensions to the declarations of the module *, see declared of self/parse.u

function translation_doc(notation: Notation, indent: Str, f: Id, expr: Expr, args: List[Expr]): Doc :=
  match (comprehension_text(notation, indent, expr), set_elements(expr), map_entries(expr))
    case (Some(text), _, _) =>
      Doc(text, Atom)
    case (_, Some((es, rest)), _) =>
      Doc("{" ++ format_exprs(notation, indent, es) ++ rest_text(notation, indent, rest) ++ "}", Atom)
    case (_, _, Some((entries, rest))) =>
      Doc("{" ++ join(", ", [entry_text(notation, indent, entry) for entry in entries]) ++ rest_text(notation, indent, rest) ++ "}", Atom)
    case _ =>
      Doc(f ++ "(" ++ format_exprs(notation, indent, args) ++ ")", Atom)
  end

// the set or map after ; that a literal adds to, if it is not empty
function rest_text(notation: Notation, indent: Str, rest: Option[Expr]): Str :=
  match rest
    case Some(r) => "; " ++ format_expr(notation, indent, r)
    case None => ""
  end

function entry_text(notation: Notation, indent: Str, entry: Expr * Expr): Str :=
  match entry
    case (k, v) => format_expr(notation, indent, k) ++ " => " ++ format_expr(notation, indent, v)
  end

function declared_name(f: Id): Name :=
  Name(Some("*"), f)

function empty_expr(): Expr :=
  EApp(EVar(Var(declared_name("empty"), THole)), Nil)

function acc_expr(): Expr :=
  EVar(Var(unqualified("(acc)"), THole))

// {a, b} is insert(a, insert(b, empty())), and {a, b; s} is insert(a, insert(b, s)), with the elements and the rest
function set_elements(expr: Expr): Option[List[Expr] * Option[Expr]] :=
  match expr
    case EApp(EVar(Var(n, _)), [_, _]) if n == declared_name("insert") => Some(set_chain(expr))
    case _ => if expr == empty_expr() then Some((Nil, None)) else None
  end

function set_chain(expr: Expr): List[Expr] * Option[Expr] :=
  match expr
    case EApp(EVar(Var(n, _)), [a, s]) if n == declared_name("insert") =>
      match set_chain(s)
        case (es, rest) => ([a; es], rest)
      end
    case _ => if expr == empty_expr() then (Nil, None) else (Nil, Some(expr))
  end

// {k => v, l => w} is put(l, w, put(k, v, empty())), and {k => v; m} is put(k, v, m), with the entries and the rest
function map_entries(expr: Expr): Option[List[Expr * Expr] * Option[Expr]] :=
  match expr
    case EApp(EVar(Var(n, _)), [_, _, _]) if n == declared_name("put") => Some(map_chain(expr))
    case _ => if expr == empty_expr() then Some((Nil, None)) else None
  end

function map_chain(expr: Expr): List[Expr * Expr] * Option[Expr] :=
  match expr
    case EApp(EVar(Var(n, _)), [k, v, m]) if n == declared_name("put") =>
      match map_chain(m)
        case (entries, rest) => (entries ++ [(k, v)], rest)
      end
    case _ => if expr == empty_expr() then (Nil, None) else (Nil, Some(expr))
  end

// [a for x in c, y in d if q], {a for x in c if q}, or {k => v for x in c if q}, as nested folds whose functions take the
// accumulator (acc) last for foldr and first for foldl, and whose innermost puts the result into the accumulator if q holds
function comprehension_text(notation: Notation, indent: Str, expr: Expr): Option[Str] :=
  match (fold_of("foldr", expr), fold_of("foldl", expr))
    case (Some((c, init, xs, inner)), _) => comprehension_of(notation, indent, "foldr", init, (xs, c), inner)
    case (_, Some((c, init, xs, inner))) => comprehension_of(notation, indent, "foldl", init, (xs, c), inner)
    case _ => None
  end

function comprehension_of(
  notation: Notation,
  indent: Str,
  fold: Id,
  init: Expr,
  generator: List[Var] * Expr,
  inner: Expr
): Option[Str] :=
  match inner_generators(fold, inner)
    case (generators, body) =>
      let gs := " for " ++ join(", ", [generator_text(notation, indent, g) for g in [generator; generators]]) in
        match (fold, condition_of(body))
          case ("foldr", (q, EApp(EVar(Var(Name(None, "Cons"), _)), [a, acc]))) if init == EVar(Var(unqualified("Nil"), THole)) and acc == acc_expr() =>
            Some("[" ++ format_expr(notation, indent, a) ++ gs ++ condition_text(notation, indent, q) ++ "]")
          case ("foldr", (q, EApp(EVar(Var(n, _)), [a, acc]))) if n == declared_name("insert") and init == empty_expr() and acc == acc_expr() =>
            Some("{" ++ format_expr(notation, indent, a) ++ gs ++ condition_text(notation, indent, q) ++ "}")
          case ("foldl", (q, EApp(EVar(Var(n, _)), [k, v, acc]))) if n == declared_name("put") and init == empty_expr() and acc == acc_expr() =>
            Some("{" ++ format_expr(notation, indent, k) ++ " => " ++ format_expr(notation, indent, v) ++ gs ++ condition_text(notation, indent, q) ++ "}")
          case _ =>
            None
        end
  end

// the container, the initial value, the variables of the generator, and the body of the function of a fold
function fold_of(fold: Id, expr: Expr): Option[Expr * Expr * List[Var] * Expr] :=
  match expr
    case EApp(EVar(Var(n, _)), [c, init, ELam(formals, inner)]) if n == declared_name(fold) =>
      match generator_vars(fold, formals)
        case Some(xs) => Some((c, init, xs, inner))
        case None => None
      end
    case _ =>
      None
  end

function generator_vars(fold: Id, formals: List[Var]): Option[List[Var]] :=
  match (fold, formals, reverse(formals))
    case ("foldr", _, [a; xs]) if EVar(a) == acc_expr() => Some(reverse(xs))
    case ("foldl", [a; xs], _) if EVar(a) == acc_expr() => Some(xs)
    case _ => None
  end

// the generators of the folds nested in the body of a fold, which start from the accumulator, and the innermost body
function inner_generators(fold: Id, expr: Expr): List[List[Var] * Expr] * Expr :=
  match fold_of(fold, expr)
    case Some((c, init, xs, inner)) if init == acc_expr() =>
      match inner_generators(fold, inner)
        case (generators, body) => ([(xs, c); generators], body)
      end
    case _ =>
      (Nil, expr)
  end

function condition_of(body: Expr): Option[Expr] * Expr :=
  match body
    case EIte(q, add, acc) if acc == acc_expr() => (Some(q), add)
    case _ => (None, body)
  end

function condition_text(notation: Notation, indent: Str, q: Option[Expr]): Str :=
  match q
    case Some(c) => " if " ++ format_expr(notation, indent, c)
    case None => ""
  end

// x in c, or k => v in m
function generator_text(notation: Notation, indent: Str, generator: List[Var] * Expr): Str :=
  match generator
    case ([k, v], c) => k.name.base ++ " => " ++ v.name.base ++ " in " ++ format_expr(notation, indent, c)
    case (xs, c) => join(", ", [x.name.base for x in xs]) ++ " in " ++ format_expr(notation, indent, c)
  end

// patterns

function format_pattern(notation: Notation, pat: Pat): Str :=
  pattern_doc(notation, pat).text

function format_patterns(notation: Notation, pats: List[Pat]): Str :=
  join(", ", [format_pattern(notation, p) for p in pats])

function pattern_doc(notation: Notation, pat: Pat): Doc :=
  match pat
    case PWild =>
      Doc("_", Atom)
    case PLit(VInt(n)) if n < 0 =>
      Doc(show(n), Negative)
    case PLit(v) =>
      Doc(format_value(Lit(v)), Atom)
    case PVar(x) =>
      Doc(x.name.base, Atom)
    case PTuple(ps) =>
      Doc("(" ++ format_patterns(notation, ps) ++ ")", Atom)
    case PApp(Name(None, "Nil"), Nil) =>
      Doc("[]", Atom)
    case PApp(Name(None, "Cons"), [_, _]) =>
      Doc(list_pattern_text(notation, pat), Atom)
    case PApp(n, ps) =>
      let docs := [pattern_doc(notation, q) for q in ps] in
        match operator_doc(notation, n.base, docs)
          case Some(d) => d
          case None => Doc(n.base ++ "(" ++ texts(docs) ++ ")", Atom)
        end
  end

function list_pattern_text(notation: Notation, pat: Pat): Str :=
  match cons_pattern_rest(pat)
    case PApp(Name(None, "Nil"), Nil) => "[" ++ format_patterns(notation, cons_pattern_items(pat)) ++ "]"
    case rest => "[" ++ format_patterns(notation, cons_pattern_items(pat)) ++ "; " ++ format_pattern(notation, rest) ++ "]"
  end

function cons_pattern_items(pat: Pat): List[Pat] :=
  match pat
    case PApp(Name(None, "Cons"), [a, b]) => [a; cons_pattern_items(b)]
    case _ => Nil
  end

function cons_pattern_rest(pat: Pat): Pat :=
  match pat
    case PApp(Name(None, "Cons"), [_, b]) => cons_pattern_rest(b)
    case _ => pat
  end

// statements, each on a line of its own at indent

function format_stmt(notation: Notation, indent: Str, s: Stmt): Str :=
  match s
    case SSkip =>
      "skip"
    case SAssign(pairs) =>
      "assign " ++ assignments_text(notation, indent, pairs)
    case SIf(c, l, r) =>
      "if " ++ format_expr(notation, indent, c) ++ format_body(notation, deeper(indent), l) ++ else_text(notation, indent, r)
    case SWhile(c, body) =>
      "while " ++ format_expr(notation, indent, c) ++ format_body(notation, deeper(indent), body) ++ "\n" ++ indent ++ "end"
    case SCall(p, ins, outs, refs) =>
      "call " ++ p.base ++ "(" ++ sections_text([format_expr(notation, indent, a) for a in ins], [x.name.base for x in outs], [x.name.base for x in refs]) ++ ")"
    case SMatch(a, branches) =>
      "match " ++ format_expr(notation, indent, a) ++ stmt_cases(notation, deeper(indent), branches) ++ "\n" ++ indent ++ "end"
    case SAssert(a) =>
      "assert " ++ format_expr(notation, indent, a)
    case SRaise(a, _) =>
      "raise " ++ format_expr(notation, indent, a)
    case STry(body, handlers) =>
      "try" ++ format_body(notation, deeper(indent), body) ++ "\n" ++ indent ++ "catch" ++ stmt_cases(notation, deeper(indent), [Branch(h.pat, h.guard, h.body) for h in handlers]) ++ "\n" ++ indent ++ "end"
    case SBlock(_, _) =>
      "skip" ++ format_body(notation, indent, s)
  end

// the else of an if, where an if after else continues the chain, which ends with one end
function else_text(notation: Notation, indent: Str, r: Stmt): Str :=
  match r
    case SSkip => "\n" ++ indent ++ "end"
    case SIf(_, _, _) => "\n" ++ indent ++ "else " ++ format_stmt(notation, indent, r)
    case _ => "\n" ++ indent ++ "else" ++ format_body(notation, deeper(indent), r) ++ "\n" ++ indent ++ "end"
  end

function stmt_cases(notation: Notation, indent: Str, branches: List[Branch[Stmt]]): Str :=
  join("", ["\n" ++ indent ++ case_head(notation, indent, b.pat, b.guard) ++ format_body(notation, deeper(indent), b.body) for b in branches])

// the lines of a body, each after a newline, where local x := e is x with the assignment that starts the block
function format_body(notation: Notation, indent: Str, body: Stmt): Str :=
  match body
    case SBlock(Nil, ss) =>
      format_stmts(notation, indent, ss)
    case SBlock(xs, ss) =>
      match local_decls(notation, indent, xs, ss)
        case (decls, rest) => "\n" ++ indent ++ "local " ++ join(", ", decls) ++ format_stmts(notation, indent, rest)
      end
    case _ =>
      format_stmts(notation, indent, [body])
  end

function format_stmts(notation: Notation, indent: Str, ss: List[Stmt]): Str :=
  join("", ["\n" ++ indent ++ format_stmt(notation, indent, s) for s in ss])

// the declarations of the locals xs, with the assignments at the start of ss that initialize them, and the statements after
function local_decls(notation: Notation, indent: Str, xs: List[Var], ss: List[Stmt]): List[Str] * List[Stmt] :=
  match (xs, ss)
    case (Nil, _) =>
      (Nil, ss)
    case ([x; more], [SAssign([(y, a)]); rest]) if y == Var(x.name, THole) =>
      match local_decls(notation, indent, more, rest)
        case (decls, after) => ([formal_text(x) ++ " := " ++ closed_text(expr_doc(notation, indent, a)); decls], after)
      end
    case ([x; more], _) =>
      match local_decls(notation, indent, more, ss)
        case (decls, after) => ([formal_text(x); decls], after)
      end
  end

// in a, b, out c, ref d, without the empty sections
function sections_text(ins: List[Str], outs: List[Str], refs: List[Str]): Str :=
  join(", ", section("in", ins) ++ section("out", outs) ++ section("ref", refs))

function section(mode: Str, items: List[Str]): List[Str] :=
  if items == [] then [] else [mode ++ " " ++ join(", ", items)]

function formal_sections(ins: List[Var], outs: List[Var], refs: List[Var]): Str :=
  sections_text([formal_text(x) for x in ins], [formal_text(x) for x in outs], [formal_text(x) for x in refs])

function formal_text(x: Var): Str :=
  if x.typ == THole then x.name.base else x.name.base ++ ": " ++ format_type(x.typ)

// commands, where the notation of a command apply to those after it, and the
// accessors and updaters of the fields of a data declaration as the names of its fields

function format_cmds(notation: Notation, cmds: List[Cmd]): List[Str] :=
  match cmds
    case Nil =>
      Nil
    case [cmd; more] =>
      let after := with_notation(notation, [cmd]) in
        match format_cmd(notation, cmd, more)
          case Some(text) => [text; format_cmds(after, more)]
          case None => format_cmds(after, more)
        end
  end

function format_cmd(notation: Notation, cmd: Cmd, more: List[Cmd]): Option[Str] :=
  match cmd
    case CSort(n, params, t) =>
      Some("type " ++ n.base ++ params_text(params) ++ " :=\n  " ++ format_type(t))
    case CAbstract(n, params) =>
      Some("type " ++ n.base ++ params_text(params))
    case CData(n, params, constrs) =>
      let fields := field_names(n.base, more) in
        Some("data " ++ n.base ++ params_text(params) ++ " :=" ++ join("", ["\n  | " ++ constr_text(c, fields) for c in constrs]))
    case CFun(n, _, _, _, _) if contains('.', n.base) =>
      None
    case CFun(n, params, xss, r, body) =>
      Some(function_head(n, params, xss, r) ++ " :=\n  " ++ format_expr(notation, "  ", body))
    case CFunSig(n, params, xss, r) =>
      Some(function_head(n, params, xss, r))
    case CProc(n, params, ins, outs, refs, body) =>
      Some("procedure " ++ n.base ++ params_text(params) ++ "(" ++ formal_sections(ins, outs, refs) ++ ") :=" ++ format_body(notation, "  ", body))
    case CProcSig(n, params, ins, outs, refs) =>
      Some("procedure " ++ n.base ++ params_text(params) ++ "(" ++ formal_sections(ins, outs, refs) ++ ")")
    case CNotation(f, prec, names) =>
      Some(fixity_text(f) ++ " " ++ show(prec) ++ " " ++ join(" ", names))
    case CTest(name, xs, body) =>
      Some("test " ++ name ++ "(" ++ join(", ", [formal_text(x) for x in xs]) ++ ") :=" ++ format_body(notation, "  ", body))
  end

function params_text(params: List[Id]): Str :=
  if params == [] then "" else "[" ++ join(", ", params) ++ "]"

function function_head(n: Name, params: List[Id], xss: List[List[Var]], r: Type): Str :=
  "function " ++ n.base ++ params_text(params) ++ join("", ["(" ++ join(", ", [formal_text(x) for x in xs]) ++ ")" for xs in xss]) ++ ": " ++ format_type(r)

function fixity_text(f: Fixity): Str :=
  match f
    case FPrefix => "prefix"
    case FPostfix => "postfix"
    case FInfix => "infix"
    case FLeft => "infix left"
    case FRight => "infix right"
  end

// C(f: T, U), where f names the field at its position
function constr_text(c: Constr, fields: List[(Id * Int) * Id]): Str :=
  match c
    case Constr(k, Nil) => k.base
    case Constr(k, args) => k.base ++ "(" ++ join(", ", constr_args(k.base, args, 0, fields)) ++ ")"
  end

function constr_args(k: Id, args: List[Type], i: Int, fields: List[(Id * Int) * Id]): List[Str] :=
  match args
    case Nil =>
      Nil
    case [t; more] =>
      let arg := match get((k, i), fields) case Some(f) => f ++ ": " ++ format_type(t) case None => format_type(t) end in
        [arg; constr_args(k, more, i + 1, fields)]
  end

// the fields of the constructors of data t by their positions, from the accessors t.f after it, case C(_, y, _) => y
function field_names(t: Id, cmds: List[Cmd]): List[(Id * Int) * Id] :=
  match cmds
    case [CFun(n, _, _, _, EMatch(_, branches)); more] if is_accessor(t, n.base) =>
      [(position, slice(n.base, size(t) + 1, size(n.base))) for position in branch_positions(branches)] ++ field_names(t, more)
    case [CFun(n, _, _, _, _); more] if contains('.', n.base) =>
      field_names(t, more)
    case _ =>
      Nil
  end

function is_accessor(t: Id, f: Id): Bool :=
  let n := size(t) in size(f) > n + 1 and slice(f, 0, n + 1) == t ++ "." and not is_update(slice(f, n, size(f)))

function branch_positions(branches: List[Branch[Expr]]): List[Id * Int] :=
  match branches
    case [Branch(PApp(k, ps), _, _); more] => [(k.base, var_position(ps, 0)); branch_positions(more)]
    case [_; more] => branch_positions(more)
    case Nil => Nil
  end

function var_position(pats: List[Pat], i: Int): Int :=
  match pats
    case [PVar(_); _] => i
    case [_; more] => var_position(more, i + 1)
    case Nil => -1
  end

function test_operators(): Notation :=
  with_notation(
    empty_notation(),
    [
      CNotation(FInfix, 6, ["=="]),
      CNotation(FRight, 8, ["^"]),
      CNotation(FLeft, 9, ["+", "-"]),
      CNotation(FLeft, 10, ["*"]),
      CNotation(FPrefix, 5, ["not"]),
      CNotation(FPrefix, 11, ["-"])
    ]
  )

function source(expr: Expr): Str :=
  format_expr(test_operators(), "", expr)

test operators_parenthesized() :=
  local a := expr_var("a"), b := expr_var("b"), c := expr_var("c")

  assert source(expr_app("*", [expr_app("+", [a, b]), c])) == "(a + b) * c"
  assert source(expr_app("+", [a, expr_app("*", [b, c])])) == "a + b * c"
  assert source(expr_app("-", [expr_app("-", [a, b]), c])) == "a - b - c"
  assert source(expr_app("-", [a, expr_app("-", [b, c])])) == "a - (b - c)"
  assert source(expr_app("^", [a, expr_app("^", [b, c])])) == "a ^ b ^ c"
  assert source(expr_app("^", [expr_app("^", [a, b]), c])) == "(a ^ b) ^ c"
  assert source(expr_app("==", [expr_app("==", [a, b]), c])) == "(a == b) == c"
  assert source(expr_app("not", [expr_app("==", [a, b])])) == "not a == b"
  assert source(expr_app("==", [expr_app("not", [a]), b])) == "(not a) == b"
  assert source(expr_app("-", [expr_app("+", [a, b])])) == "-(a + b)"
  assert source(expr_app("-", [expr_app("-", [a])])) == "- -a"
  assert source(expr_app("-", [expr_app("not", [a])])) == "-(not a)"
  assert source(expr_app("*", [a, expr_app("not", [b])])) == "a * (not b)"
  assert source(expr_app("-", [a, expr_int(-1)])) == "a - (-1)"
  assert source(expr_app(".f", [expr_int(-1)])) == "(-1).f"
  assert source(expr_app("+", [EIte(a, b, c), expr_int(1)])) == "(if a then b else c) + 1"

test updates_closed() :=
  local r := expr_app(".g:=", [expr_app(".f:=", [expr_var("r"), expr_int(1)]), EIte(expr_var("c"), expr_int(2), expr_int(3))])

  assert source(r) == "r with f := 1, g := (if c then 2 else 3)"
  assert format_stmt(test_operators(), "", SAssign([(Var(unqualified("x"), THole), r), (Var(unqualified("y"), THole), expr_int(2))])) == "assign x := (" ++ source(r) ++ "), y := 2"
  assert source(expr_app("+", [expr_app(".f", [expr_app("+", [expr_var("a"), expr_var("b")])]), r])) == "(a + b).f + (" ++ source(r) ++ ")"

test translations() :=
  local x := Var(unqualified("x"), THole), acc := Var(unqualified("(acc)"), THole), xs := expr_var("xs")
  local cons := expr_app("Cons", [expr_app("*", [EVar(x), expr_int(2)]), acc_expr()])
  local comprehension := EApp(EVar(Var(declared_name("foldr"), THole)), [xs, expr_var("Nil"), ELam([x, acc], EIte(EVar(x), cons, acc_expr()))])
  local insert := lambda a, s => EApp(EVar(Var(declared_name("insert"), THole)), [a, s])

  assert source(comprehension) == "[x * 2 for x in xs if x]"
  assert source(insert(expr_int(1), insert(expr_int(2), empty_expr()))) == "{1, 2}"
  assert source(empty_expr()) == "{}"
  assert source(expr_app("Cons", [expr_int(1), expr_app("Cons", [expr_int(2), xs])])) == "[1, 2; xs]"

test bodies() :=
  local x := Var(unqualified("x"), type_int()), y := Var(unqualified("y"), THole)
  local body := SBlock([x, y], [SAssign([(Var(x.name, THole), expr_int(1))]), SIf(EVar(y), SBlock(Nil, [SSkip]), SIf(EVar(x), SBlock(Nil, Nil), SSkip))])

  assert format_body(test_operators(), "", body) == "\nlocal x: Int := 1, y\nif y\n  skip\nelse if x\nend"
  assert format_cmd(test_operators(), CNotation(FLeft, 9, ["+", "-"]), Nil) == Some("infix left 9 + -")

// values, types, patterns, and names by their structure, in a fixed notation

function format_value(v: Value): Str :=
  match v
    case Lit(VUnit) => "()"
    case Lit(VBool(b)) => if b then "true" else "false"
    case Lit(VInt(n)) => show(n)
    case Lit(VStr(s)) => quote(s)
    case Lit(VChar(c)) => "'" ++ escape_char(c) ++ "'"
    case Obj(n, vs) if n == tuple_name() => "(" ++ format_values(vs) ++ ")"
    case Obj(n, _) if n == cons_name() and list_elements(v) != None => "[" ++ format_values(list_items(v)) ++ "]"
    case Obj(n, Nil) if n == nil_name() => "[]"
    case Obj(n, Nil) => n.base
    case Obj(n, vs) => n.base ++ "(" ++ format_values(vs) ++ ")"
    case Arr(a) => array_text([format_value(w) for w in list(a)])
    case Proc(_) => "<procedure>"
    case ProcClos(_, _, _, _, _) => "<procedure>"
    case _ => "<function>"
  end

// the array of the texts of its elements, |a, b|, where a first element that starts with || is in parentheses, |(||), a|,
// since the parser reads ||| as an empty array before a |
function array_text(texts: List[Str]): Str :=
  match texts
    case [t; rest] if size(t) >= 2 and slice(t, 0, 2) == "||" => "|" ++ join(", ", ["(" ++ t ++ ")"; rest]) ++ "|"
    case _ => "|" ++ join(", ", texts) ++ "|"
  end

function format_values(vs: List[Value]): Str :=
  join(", ", [format_value(v) for v in vs])

function list_items(v: Value): List[Value] :=
  match list_elements(v)
    case Some(vs) => vs
    case None => Nil
  end

function escape_char(c: Char): Str :=
  match c
    case '\\' => "\\\\"
    case '\n' => "\\n"
    case '\t' => "\\t"
    case '\r' => "\\r"
    case '\'' => "\\'"
    case _ => str([c])
  end

// types as the messages of the checker show them, without numbering the unknowns anew
function format_type(t: Type): Str :=
  match t
    case TParam(n) => n
    case THole => "_"
    case TMeta(i) => "?" ++ show(i)
    case TFun([TTuple([])], r) => "(()) -> " ++ format_type(r)
    case TFun([a], r) => type_operand(a) ++ " -> " ++ format_type(r)
    case TFun(args, r) => "(" ++ format_types(args) ++ ") -> " ++ format_type(r)
    case TProc(is, os, rs) => "(" ++ join(", ", type_section("in", is) ++ type_section("out", os) ++ type_section("ref", rs)) ++ ")"
    case TTuple([]) => "()"
    case TTuple(ts) => join(" * ", [type_component(a) for a in ts])
    case TSort(n, []) => n.base
    case TSort(n, args) => n.base ++ "[" ++ format_types(args) ++ "]"
  end

function format_types(ts: List[Type]): Str :=
  join(", ", [format_type(t) for t in ts])

function type_section(mode: Str, ts: List[Type]): List[Str] :=
  if ts == [] then [] else [mode ++ " " ++ format_types(ts)]

// the argument of a function, in parentheses if it is a function
function type_operand(t: Type): Str :=
  match t
    case TFun(_, _) => "(" ++ format_type(t) ++ ")"
    case _ => format_type(t)
  end

// a component of a tuple, in parentheses if it is a function or a tuple
function type_component(t: Type): Str :=
  match t
    case TFun(_, _) => "(" ++ format_type(t) ++ ")"
    case TTuple([_, _; _]) => "(" ++ format_type(t) ++ ")"
    case _ => format_type(t)
  end

// patterns as the messages of the checker show them
function format_pat(pat: Pat): Str :=
  match pat
    case PWild => "_"
    case PLit(l) => format_value(Lit(l))
    case PVar(x) => x.name.base
    case PTuple(ps) => "(" ++ format_pats(ps) ++ ")"
    case PApp(n, [x, xs]) if n == cons_name() or n == unqualified("Cons") => "[" ++ format_pat(x) ++ "; " ++ format_pat(xs) ++ "]"
    case PApp(n, [l, r]) if symbolic(n.base) => infix_text(n.base, format_pat(l), format_pat(r))
    case PApp(n, []) => n.base
    case PApp(n, ps) => n.base ++ "(" ++ format_pats(ps) ++ ")"
  end

function format_pats(pats: List[Pat]): Str :=
  join(", ", [format_pat(p) for p in pats])

// constructors named by operators are shown infix
function symbolic(n: Id): Bool :=
  let c := at(0, n) in not is_letter(c) and c != '_' and n != ","

function infix_text(op: Id, l: Str, r: Str): Str :=
  pat_operand(l) ++ " " ++ op ++ " " ++ pat_operand(r)

function pat_operand(a: Str): Str :=
  if contains(' ', a) and at(0, a) != '(' then "(" ++ a ++ ")" else a

// the text of a string, for os_print
function text_of(v: Value): Str :=
  match v
    case Lit(VStr(s)) => s
    case _ => format_value(v)
  end

// the name with its module, to tell names apart
function format_name(n: Name): Str :=
  match n
    case Name(Some(m), b) => m ++ "." ++ b
    case Name(None, b) => b
  end

test printing() :=
  assert format_type(TFun([TFun([TParam("A")], TParam("B")), TTuple([TSort(unqualified("Int"), []), TSort(unqualified("Str"), [])])], TSort(unqualified("List"), [TParam("A")]))) == "(A -> B, Int * Str) -> List[A]"
  assert format_type(TProc([TParam("A")], [], [TSort(unqualified("Int"), [])])) == "(in A, ref Int)"
  assert format_pat(PApp(cons_name(), [PVar(Var(unqualified("x"), THole)), PApp(unqualified("Some"), [PWild])])) == "[x; Some(_)]"
  assert format_value(list_value([Lit(VInt(1)), Lit(VStr("a\"b"))])) == "[1, \"a\\\"b\"]"
  assert format_value(Obj(tuple_name(), [Lit(VChar('\'')), Obj(nil_name(), Nil), Obj(unqualified("Some"), [Lit(VBool(true))])])) == "('\\'', [], Some(true))"
  assert format_name(cons_name()) == "list.Cons" and cons_name().base == "Cons"
