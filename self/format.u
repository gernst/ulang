// the tool's literals, types, patterns, names, and programs as ulang source, where literals, types, patterns, and names
// are formatted by their structure, for the messages of the checker and the interpreter, as format_value of self/run.u
// formats values, and programs with the notation in effect, as ulang.bin format prints them, which parses to the same
// commands

import "syntax.u"
import "builtins.u"
import "notation.u"
import "lex.u"
import "array.u"

export

function format_program(mods: List[Mod]): Str
function format_lit(lit: Lit): Str
function format_type(t: Type): Str
function format_types(ts: List[Type]): Str
function format_pat(pat: Pat): Str
function format_name(n: Name): Str

// the array of the texts of its elements, which the interpreter shows itself when they have declared shows
function array_text(texts: List[Str]): Str

implementation

// programs as source, where the notation of the prelude, of the program, and of its imports decide where operators need
// parentheses, and the translations of the parser are printed as what they translate, so that the source parses to the
// same commands
data Doc :=
  case Doc(text: Str, shape: Shape)

// an open form extends as far to the right as it can, as if, let, lambda without modes, raise, and updates do, a negative
// literal would be read as - applied to its operand, and an operator binds its operands by its fixity and precedence
data Shape :=
  case Atom
  case Open
  case Negative
  case Operator(fixity: Fixity, prec: Int)

// the last of the modules mods as source, after the modules before it, whose notation it starts with as far as it imports them,
// implicitly or not
function format_program(mods: List[Mod]): Str :=
  match last(mods)
    case Some(d) => join("\n\n", format_mod(imported_notation(mods, all_imports(d)), d)) ++ "\n"
    case None => ""
  end

// the notation that the modules names of mods export, in order
function imported_notation(mods: List[Mod], names: List[Id]): Notation :=
  with_notation(empty_notation(), list(for d in mods for c in commands_of(d.exported) if contains(d.name, names) yield c))

// the imports of module d and its sections, where its export section declares the notation of the sections after it, and a
// module that exports nothing has no sections
function format_mod(notation: Notation, d: Mod): List[Str] :=
  (if d.doc == "" then list() else list(doc_lines(d.doc))) ++ list(for n in d.imports yield "import " ++ quote(n ++ ".u")) ++
    if d.exported == list() and d.builtins == list() then
      format_cmds(notation, d.implemented)
    else
      let inner := with_notation(notation, commands_of(d.exported)) in
        list("export"; format_cmds(notation, d.exported)) ++ (if d.builtins == list() then list() else list("builtin"; format_cmds(inner, d.builtins))) ++
          (if d.implemented == list() then list() else list("implementation"; format_cmds(inner, d.implemented)))

// op applied to the operands, if it is declared as an operator of their number
function operator_doc(notation: Notation, op: Id, args: List[Doc]): Option[Doc] :=
  match (args, infix_of(notation, op), prefix_prec(notation, op), postfix_prec(notation, op))
    case (list(l, r), Some((f, prec)), _, _) =>
      Some(Doc(infix_operand(l, f, prec, FLeft) ++ " " ++ op ++ " " ++ infix_operand(r, f, prec, FRight), Operator(f, prec)))
    case (list(a), _, Some(prec), _) =>
      Some(Doc(prefix_text(op, prefix_operand(a, prec)), Operator(FPrefix, prec)))
    case (list(a), _, _, Some(prec)) =>
      Some(Doc(postfix_operand(a) ++ " " ++ op, Operator(FPostfix, prec)))
    case _ =>
      None
  end

function parenthesized(d: Doc, needed: Bool): Str :=
  if needed then "(" ++ d.text ++ ")" else d.text

// an operand of an infix operator of fixity f and precedence prec on the side FLeft or FRight, where a prefix operator
// would take the operators after it of its precedence or above, and a chain of an associative operator needs none
function infix_operand(d: Doc, f: Fixity, prec: Int, side: Fixity): Str :=
  parenthesized(d, match d.shape
      case Atom => false
      case Operator(FPrefix, q) => q <= prec
      case Operator(FPostfix, _) => true
      case Operator(fixity, q) => q < prec or q == prec and not (f == side and fixity == side)
      case _ => true
    end)

// the operand of a prefix operator, which takes the operators of its precedence or above
function prefix_operand(d: Doc, prec: Int): Str :=
  parenthesized(d, match d.shape
      case Atom => false
      case Operator(FPostfix, _) => true
      case Operator(_, q) => q < prec
      case _ => true
    end)

function postfix_operand(d: Doc): Str :=
  parenthesized(d, match d.shape
      case Atom => false
      case Operator(FPostfix, _) => false
      case _ => true
    end)

// a name is separated from its operand, and a symbol only from an operand that starts with a symbol, as in - -x
function prefix_text(op: Id, a: Str): Str :=
  if not symbolic(op) or is_op_char(at(0, a)) then op ++ " " ++ a else op ++ a

// the function of an application, and the record of an access
function atom_text(d: Doc): Str :=
  parenthesized(d, d.shape != Atom)

// an expression before a comma that a name and := may follow, which would continue its updates
function closed_text(d: Doc): Str :=
  parenthesized(d, d.shape == Open)

// expressions, at the indentation of the line they start on
function format_expr(notation: Notation, indent: Str, expr: Expr): Str :=
  expr_doc(notation, indent, expr).text

function format_exprs(notation: Notation, indent: Str, exprs: List[Expr]): Str :=
  join(", ", list(for e in exprs yield format_expr(notation, indent, e)))

function expr_doc(notation: Notation, indent: Str, expr: Expr): Doc :=
  match expr
    case ELit(LInt(num)) if num < 0 =>
      Doc(show(num), Negative)
    case ELit(lit) =>
      Doc(format_lit(lit), Atom)
    case EVar(var) =>
      Doc(var.name.base, Atom)
    case EApp(fun, args) =>
      app_doc(notation, indent, fun, args)
    case EField(e, field) =>
      Doc(atom_text(expr_doc(notation, indent, e)) ++ "." ++ field, Atom)
    case EUpdate(_, _, _) =>
      updates_doc(notation, indent, expr)
    case ELam(list(), body) =>
      Doc("lambda => " ++ format_expr(notation, indent, body), Open)
    case ELam(formals, body) =>
      match patterns_of_lambda(formals, body)
        case Some((pats, inner)) =>
          Doc("lambda " ++ format_patterns(notation, pats) ++ " => " ++ format_expr(notation, indent, inner), Open)
        case None =>
          Doc("lambda " ++ join(", ", list(for x in formals yield formal_text(x))) ++ " => " ++ format_expr(notation, indent, body), Open)
      end
    case EProc(ins, outs, refs, stmt) =>
      Doc("lambda " ++ formal_sections(ins, outs, refs) ++ " =>" ++ format_body(notation, deeper(indent), stmt) ++ "\n" ++ indent ++ "end", Atom)
    case ELet(bindings, body) =>
      Doc("let " ++ assignments_text(notation, indent, bindings) ++ " in " ++ format_expr(notation, indent, body), Open)
    case EIte(cond, then_expr, else_expr) =>
      Doc("if " ++ format_expr(notation, indent, cond) ++ " then " ++ format_expr(notation, indent, then_expr) ++ " else " ++ format_expr(notation, indent, else_expr), Open)
    case EMatch(expr, cases) =>
      Doc("match " ++ format_expr(notation, indent, expr) ++ expr_cases(notation, deeper(indent), cases) ++ "\n" ++ indent ++ "end", Atom)
    case ETuple(exprs) =>
      Doc("(" ++ format_exprs(notation, indent, exprs) ++ ")", Atom)
    case ERaise(expr, _) =>
      Doc("raise " ++ format_expr(notation, indent, expr), Open)
    case EForm(form, elems, rest) =>
      Doc(form_name(form) ++ "(" ++ join(", ", list(for e in elems yield elem_text(notation, indent, e))) ++ rest_text(notation, indent, rest) ++ ")", Atom)
    case EFor(form, gens, elem, rest) =>
      Doc(form_name(form) ++ "(" ++ join(" ", list(for g in gens yield gen_text(notation, indent, g))) ++ (if implicit_elem(form, gens) == Some(elem) then "" else " yield " ++ elem_text(notation, indent, elem)) ++ rest_text(notation, indent, rest) ++ ")", Atom)
  end

function elem_text(notation: Notation, indent: Str, elem: Elem): Str :=
  match elem
    case Elem(e) => format_expr(notation, indent, e)
    case Entry(k, v) => format_expr(notation, indent, k) ++ " => " ++ format_expr(notation, indent, v)
  end

// for p in c, for k => v in m, or if q
function gen_text(notation: Notation, indent: Str, g: Gen): Str :=
  match g
    case GFor(p, c) => "for " ++ format_pattern(notation, p) ++ " in " ++ format_expr(notation, indent, c)
    case GEntries(k, v, c) => "for " ++ format_pattern(notation, k) ++ " => " ++ format_pattern(notation, v) ++ " in " ++ format_expr(notation, indent, c)
    case GIf(q) => "if " ++ format_expr(notation, indent, q)
  end

function app_doc(notation: Notation, indent: Str, f: Expr, args: List[Expr]): Doc :=
  let docs := list(for a in args yield expr_doc(notation, indent, a)) in
    match f
      case EVar(Var(name, _)) =>
        match operator_doc(notation, name.base, docs)
          case Some(d) => d
          case None => Doc(name.base ++ "(" ++ texts(docs) ++ ")", Atom)
        end
      case _ =>
        Doc(atom_text(expr_doc(notation, indent, f)) ++ "(" ++ texts(docs) ++ ")", Atom)
    end

function texts(docs: List[Doc]): Str :=
  join(", ", list(for d in docs yield d.text))

// e with f := a, g := b, which the parser applies from the left, where e and the values are operands without updates
function updates_doc(notation: Notation, indent: Str, expr: Expr): Doc :=
  match updates_of(expr)
    case (r, updates) =>
      Doc(closed_text(expr_doc(notation, indent, r)) ++ " with " ++ join(", ", list(for u in updates yield update_text(notation, indent, u))), Open)
  end

function update_text(notation: Notation, indent: Str, update: Id * Expr): Str :=
  match update
    case (f, a) => f ++ " := " ++ closed_text(expr_doc(notation, indent, a))
  end

function updates_of(expr: Expr): Expr * List[Id * Expr] :=
  match expr
    case EUpdate(r, field, a) =>
      match updates_of(r)
        case (s, updates) => (s, updates ++ list((field, a)))
      end
    case _ =>
      (expr, list())
  end

// x := e, y := f, where an open form before a comma is parenthesized
function assignments_text(notation: Notation, indent: Str, pairs: List[Var * Expr]): Str :=
  match pairs
    case list() => ""
    case list((x, a)) => x.name.base ++ " := " ++ format_expr(notation, indent, a)
    case list((x, a); more) => x.name.base ++ " := " ++ closed_text(expr_doc(notation, indent, a)) ++ ", " ++ assignments_text(notation, indent, more)
  end

function expr_cases(notation: Notation, indent: Str, branches: List[Branch[Expr]]): Str :=
  join("", list(for b in branches yield indented_doc(indent, b.doc) ++ "\n" ++ indent ++ case_head(notation, indent, b.pat, b.guard) ++ " " ++ format_expr(notation, indent, b.body)))

function case_head(notation: Notation, indent: Str, pat: Pat, guard: Option[Expr]): Str :=
  match guard
    case Some(g) => "case " ++ format_pattern(notation, pat) ++ " if " ++ format_expr(notation, indent, g) ++ " =>"
    case None => "case " ++ format_pattern(notation, pat) ++ " =>"
  end

function deeper(indent: Str): Str :=
  indent ++ "  "

// the set or map after ; that a literal adds to, if it is not empty
function rest_text(notation: Notation, indent: Str, rest: Option[Expr]): Str :=
  match rest
    case Some(r) => "; " ++ format_expr(notation, indent, r)
    case None => ""
  end

function format_pattern(notation: Notation, pat: Pat): Str :=
  pattern_doc(notation, pat).text

function format_patterns(notation: Notation, pats: List[Pat]): Str :=
  join(", ", list(for p in pats yield format_pattern(notation, p)))

function pattern_doc(notation: Notation, pat: Pat): Doc :=
  match pat
    case PWild =>
      Doc("_", Atom)
    case PLit(LInt(num)) if num < 0 =>
      Doc(show(num), Negative)
    case PLit(lit) =>
      Doc(format_lit(lit), Atom)
    case PVar(var) =>
      Doc(var.name.base, Atom)
    case PTuple(pats) =>
      Doc("(" ++ format_patterns(notation, pats) ++ ")", Atom)
    case PApp(Name(None, "Nil"), list()) =>
      Doc("list()", Atom)
    case PApp(Name(None, "Cons"), list(_, _)) =>
      Doc(list_pattern_text(notation, pat), Atom)
    case PApp(constr, pats) =>
      let docs := list(for q in pats yield pattern_doc(notation, q)) in
        match operator_doc(notation, constr.base, docs)
          case Some(d) => d
          case None => Doc(constr.base ++ "(" ++ texts(docs) ++ ")", Atom)
        end
  end

function list_pattern_text(notation: Notation, pat: Pat): Str :=
  match cons_pattern_rest(pat)
    case PApp(Name(None, "Nil"), list()) => "list(" ++ format_patterns(notation, cons_pattern_items(pat)) ++ ")"
    case rest => "list(" ++ format_patterns(notation, cons_pattern_items(pat)) ++ "; " ++ format_pattern(notation, rest) ++ ")"
  end

function cons_pattern_items(pat: Pat): List[Pat] :=
  match pat
    case PApp(Name(None, "Cons"), list(a, b)) => list(a; cons_pattern_items(b))
    case _ => list()
  end

function cons_pattern_rest(pat: Pat): Pat :=
  match pat
    case PApp(Name(None, "Cons"), list(_, b)) => cons_pattern_rest(b)
    case _ => pat
  end

// statements, each on a line of its own at indent
function format_stmt(notation: Notation, indent: Str, s: Stmt): Str :=
  match s
    case SSkip =>
      "skip"
    case SAssign(assignments) =>
      "assign " ++ assignments_text(notation, indent, assignments)
    case SIf(cond, then_stmt, else_stmt) =>
      "if " ++ format_expr(notation, indent, cond) ++ format_body(notation, deeper(indent), then_stmt) ++ else_text(notation, indent, else_stmt)
    case SWhile(cond, body) =>
      "while " ++ format_expr(notation, indent, cond) ++ format_body(notation, deeper(indent), body) ++ "\n" ++ indent ++ "end"
    case SCall(proc, ins, outs, refs) =>
      "call " ++ proc.base ++ "(" ++ sections_text(list(for a in ins yield format_expr(notation, indent, a)), list(for x in outs yield x.name.base), list(for x in refs yield x.name.base)) ++ ")"
    case SMatch(expr, cases) =>
      "match " ++ format_expr(notation, indent, expr) ++ stmt_cases(notation, deeper(indent), cases) ++ "\n" ++ indent ++ "end"
    case SAssert(cond) =>
      "assert " ++ format_expr(notation, indent, cond)
    case SRaise(expr, _) =>
      "raise " ++ format_expr(notation, indent, expr)
    case STry(body, handlers) =>
      "try" ++ format_body(notation, deeper(indent), body) ++ "\n" ++ indent ++ "catch" ++ stmt_cases(notation, deeper(indent), list(for h in handlers yield Branch(h.doc, h.pat, h.guard, h.body))) ++ "\n" ++ indent ++ "end"
    case SBlock(_, _) =>
      match for_parts(s)
        case Some((pat, c, q, body)) => "for " ++ format_pattern(notation, pat) ++ " in " ++ format_expr(notation, indent, c) ++ condition_text(notation, indent, q) ++ " do" ++ format_body(notation, deeper(indent), body) ++ "\n" ++ indent ++ "end"
        case None => "skip" ++ format_body(notation, indent, s)
      end
  end

function condition_text(notation: Notation, indent: Str, q: Option[Expr]): Str :=
  match q
    case Some(c) => " if " ++ format_expr(notation, indent, c)
    case None => ""
  end

// the pattern, container, condition, and body of the block that the parser makes of for p in c if q do body end, see parse_for
function for_parts(s: Stmt): Option[Pat * Expr * Option[Expr] * Stmt] :=
  match s
    case SBlock(list(items), list(SAssign(list((_, EFor(FormList, list(GFor(_, c)), _, None)))), SWhile(_, SMatch(_, list(Branch(_, PApp(_, list(pat, _)), None, SBlock(list(), list(guarded, _))), _))))) if items.name.base == "(items)" =>
      match guarded
        case SIf(g, body, SSkip) => Some((pat, c, Some(g), body))
        case body => Some((pat, c, None, body))
      end
    case _ => None
  end

// the else of an if, whose body may be an if, nested
function else_text(notation: Notation, indent: Str, r: Stmt): Str :=
  match r
    case SSkip => "\n" ++ indent ++ "end"
    case _ => "\n" ++ indent ++ "else" ++ format_body(notation, deeper(indent), r) ++ "\n" ++ indent ++ "end"
  end

function stmt_cases(notation: Notation, indent: Str, branches: List[Branch[Stmt]]): Str :=
  join("", list(for b in branches yield indented_doc(indent, b.doc) ++ "\n" ++ indent ++ case_head(notation, indent, b.pat, b.guard) ++ format_body(notation, deeper(indent), b.body)))

// the lines of a body, each after a newline, where local x := e is x with the assignment that starts the block
function format_body(notation: Notation, indent: Str, body: Stmt): Str :=
  match body
    case SBlock(_, _) if for_parts(body) != None =>
      format_stmts(notation, indent, list(body))
    case SBlock(list(), stmts) =>
      format_stmts(notation, indent, stmts)
    case SBlock(locals, stmts) =>
      match local_decls(notation, indent, locals, stmts)
        case (decls, rest) => "\n" ++ indent ++ "local " ++ join(", ", decls) ++ format_stmts(notation, indent, rest)
      end
    case _ =>
      format_stmts(notation, indent, list(body))
  end

function format_stmts(notation: Notation, indent: Str, ss: List[Stmt]): Str :=
  join("", list(for s in ss yield "\n" ++ indent ++ format_stmt(notation, indent, s)))

// the declarations of the locals xs, with the assignments at the start of ss that initialize them, and the statements after
function local_decls(notation: Notation, indent: Str, xs: List[Var], ss: List[Stmt]): List[Str] * List[Stmt] :=
  match (xs, ss)
    case (list(), _) =>
      (list(), ss)
    case (list(x; more), list(SAssign(list((y, a))); rest)) if y == Var(x.name, THole) =>
      match local_decls(notation, indent, more, rest)
        case (decls, after) => (list(formal_text(x) ++ " := " ++ closed_text(expr_doc(notation, indent, a)); decls), after)
      end
    case (list(x; more), _) =>
      match local_decls(notation, indent, more, ss)
        case (decls, after) => (list(formal_text(x); decls), after)
      end
  end

// in a, b, out c, ref d, without the empty sections
function sections_text(ins: List[Str], outs: List[Str], refs: List[Str]): Str :=
  join(", ", section("in", ins) ++ section("out", outs) ++ section("ref", refs))

function section(mode: Str, items: List[Str]): List[Str] :=
  if items == list() then list() else list(mode ++ " " ++ join(", ", items))

function formal_sections(ins: List[Var], outs: List[Var], refs: List[Var]): Str :=
  sections_text(list(for x in ins yield formal_text(x)), list(for x in outs yield formal_text(x)), list(for x in refs yield formal_text(x)))

function formal_text(x: Var): Str :=
  if x.typ == THole then x.name.base else x.name.base ++ ": " ++ format_type(x.typ)

// commands, where the notation of a command apply to those after it
function format_cmds(notation: Notation, tops: List[Top]): List[Str] :=
  match tops
    case list() =>
      list()
    case list(top; more) =>
      let after := with_notation(notation, list(top.cmd)) in
        match format_cmd(notation, top.cmd)
          case Some(text) => list(doc_text(top.doc) ++ text; format_cmds(after, more))
          case None => format_cmds(after, more)
        end
  end

// the lines of a documentation as comments
function doc_lines(doc: Str): Str :=
  join("\n", list(for line in split(doc, '\n') yield if line == "" then "//" else "// " ++ line))

// the lines of a documentation as comments above its command, if there is any
function doc_text(doc: Str): Str :=
  if doc == "" then "" else doc_lines(doc) ++ "\n"

// the lines of a documentation as comments above a constructor or a case at indent, each after a newline
function indented_doc(indent: Str, doc: Str): Str :=
  if doc == "" then "" else join("", list(for line in split(doc, '\n') yield if line == "" then "\n" ++ indent ++ "//" else "\n" ++ indent ++ "// " ++ line))

function format_cmd(notation: Notation, cmd: Cmd): Option[Str] :=
  match cmd
    case CSort(name, params, typ) =>
      Some("type " ++ name.base ++ params_text(params) ++ " :=\n  " ++ format_type(typ))
    case CAbstract(name, params) =>
      Some("type " ++ name.base ++ params_text(params))
    case CData(name, params, constrs) =>
      Some("data " ++ name.base ++ params_text(params) ++ " :=" ++ join("", list(for c in constrs yield indented_doc("  ", c.doc) ++ "\n  case " ++ constr_text(c))))
    case CFun(name, params, formals, typ, body) =>
      Some(function_head(name, params, formals, typ) ++ " :=\n  " ++ format_expr(notation, "  ", body))
    case CFunSig(name, params, formals, typ) =>
      Some(function_head(name, params, formals, typ))
    case CProc(name, params, ins, outs, refs, stmt) =>
      Some("procedure " ++ name.base ++ params_text(params) ++ "(" ++ formal_sections(ins, outs, refs) ++ ") :=" ++ format_body(notation, "  ", stmt))
    case CProcSig(name, params, ins, outs, refs) =>
      Some("procedure " ++ name.base ++ params_text(params) ++ "(" ++ formal_sections(ins, outs, refs) ++ ")")
    case CNotation(fixity, prec, ops) =>
      Some(fixity_text(fixity) ++ " " ++ show(prec) ++ " " ++ join(" ", ops))
    case CTest(test_name, vars, stmt) =>
      Some("test " ++ test_name ++ "(" ++ join(", ", list(for x in vars yield formal_text(x))) ++ ") :=" ++ format_body(notation, "  ", stmt))
  end

function params_text(params: List[Id]): Str :=
  if params == list() then "" else "[" ++ join(", ", params) ++ "]"

function function_head(n: Name, params: List[Id], xs: List[Var], r: Type): Str :=
  "function " ++ n.base ++ params_text(params) ++ "(" ++ join(", ", list(for x in xs yield formal_text(x))) ++ "): " ++ format_type(r)

function fixity_text(f: Fixity): Str :=
  match f
    case FPrefix => "prefix"
    case FPostfix => "postfix"
    case FInfix => "infix"
    case FLeft => "infix left"
    case FRight => "infix right"
  end

// C(f: T, g: U)
function constr_text(c: Constr): Str :=
  match c
    case Constr(_, name, list()) => name.base
    case Constr(_, name, fields) => name.base ++ "(" ++ join(", ", list(for f in fields yield f.name ++ ": " ++ format_type(f.typ))) ++ ")"
  end

function test_operators(): Notation :=
  with_notation(
    empty_notation(),
    list(
      CNotation(FInfix, 6, list("==")),
      CNotation(FRight, 8, list("^")),
      CNotation(FLeft, 9, list("+", "-")),
      CNotation(FLeft, 10, list("*")),
      CNotation(FPrefix, 5, list("not")),
      CNotation(FPrefix, 11, list("-"))
    )
  )

function source(expr: Expr): Str :=
  format_expr(test_operators(), "", expr)

test operators_parenthesized() :=
  local a := expr_var("a"), b := expr_var("b"), c := expr_var("c")

  assert source(expr_app("*", list(expr_app("+", list(a, b)), c))) == "(a + b) * c"
  assert source(expr_app("+", list(a, expr_app("*", list(b, c))))) == "a + b * c"
  assert source(expr_app("-", list(expr_app("-", list(a, b)), c))) == "a - b - c"
  assert source(expr_app("-", list(a, expr_app("-", list(b, c))))) == "a - (b - c)"
  assert source(expr_app("^", list(a, expr_app("^", list(b, c))))) == "a ^ b ^ c"
  assert source(expr_app("^", list(expr_app("^", list(a, b)), c))) == "(a ^ b) ^ c"
  assert source(expr_app("==", list(expr_app("==", list(a, b)), c))) == "(a == b) == c"
  assert source(expr_app("not", list(expr_app("==", list(a, b))))) == "not a == b"
  assert source(expr_app("==", list(expr_app("not", list(a)), b))) == "(not a) == b"
  assert source(expr_app("-", list(expr_app("+", list(a, b))))) == "-(a + b)"
  assert source(expr_app("-", list(expr_app("-", list(a))))) == "- -a"
  assert source(expr_app("-", list(expr_app("not", list(a))))) == "-(not a)"
  assert source(expr_app("*", list(a, expr_app("not", list(b))))) == "a * (not b)"
  assert source(expr_app("-", list(a, expr_int(-1)))) == "a - (-1)"
  assert source(EField(expr_int(-1), "f")) == "(-1).f"
  assert source(expr_app("+", list(EIte(a, b, c), expr_int(1)))) == "(if a then b else c) + 1"

test updates_closed() :=
  local r := EUpdate(EUpdate(expr_var("r"), "f", expr_int(1)), "g", EIte(expr_var("c"), expr_int(2), expr_int(3)))

  assert source(r) == "r with f := 1, g := (if c then 2 else 3)"
  assert format_stmt(test_operators(), "", SAssign(list((Var(unqualified("x"), THole), r), (Var(unqualified("y"), THole), expr_int(2))))) == "assign x := (" ++ source(r) ++ "), y := 2"
  assert source(expr_app("+", list(EField(expr_app("+", list(expr_var("a"), expr_var("b"))), "f"), r))) == "(a + b).f + (" ++ source(r) ++ ")"

test bodies() :=
  local x := Var(unqualified("x"), type_int()), y := Var(unqualified("y"), THole)
  local body := SBlock(list(x, y), list(SAssign(list((Var(x.name, THole), expr_int(1)))), SIf(EVar(y), SBlock(list(), list(SSkip)), SIf(EVar(x), SBlock(list(), list()), SSkip))))

  assert format_body(test_operators(), "", body) == "\nlocal x: Int := 1, y\nif y\n  skip\nelse\n  if x\n  end\nend"
  assert format_cmd(test_operators(), CNotation(FLeft, 9, list("+", "-"))) == Some("infix left 9 + -")
  assert doc_text("") == "" and doc_text("a\n b\n") == "// a\n//  b\n//\n"
  assert format_cmds(test_operators(), list(Top(Pos(0, 0), "note", CNotation(FLeft, 9, list("+"))), Top(Pos(0, 0), "", CNotation(FLeft, 8, list("-"))))) == list("// note\ninfix left 9 +", "infix left 8 -")

// literals, types, patterns, and names by their structure, in a fixed notation
function format_lit(lit: Lit): Str :=
  match lit
    case LUnit => "()"
    case LBool(bool) => if bool then "true" else "false"
    case LInt(num) => show(num)
    case LStr(text) => quote(text)
    case LChar(char) => "'" ++ escape_char(char) ++ "'"
  end

function array_text(texts: List[Str]): Str :=
  "array(" ++ join(", ", texts) ++ ")"

function escape_char(c: Char): Str :=
  match c
    case '\\' => "\\\\"
    case '\n' => "\\n"
    case '\t' => "\\t"
    case '\r' => "\\r"
    case '\'' => "\\'"
    case _ => str(list(c))
  end

// types as the messages of the checker show them, without numbering the unknowns anew
function format_type(t: Type): Str :=
  match t
    case TParam(param) => param
    case THole => "_"
    case TMeta(meta) => "?" ++ show(meta)
    case TFun(list(TTuple(list())), res) => "(()) -> " ++ format_type(res)
    case TFun(list(a), res) => type_operand(a) ++ " -> " ++ format_type(res)
    case TFun(args, res) => "(" ++ format_types(args) ++ ") -> " ++ format_type(res)
    case TProc(ins, outs, refs) => "(" ++ join(", ", type_section("in", ins) ++ type_section("out", outs) ++ type_section("ref", refs)) ++ ")"
    case TTuple(list()) => "()"
    case TTuple(types) => join(" * ", list(for a in types yield type_component(a)))
    case TSort(name, list()) => name.base
    case TSort(name, args) => name.base ++ "[" ++ format_types(args) ++ "]"
  end

function format_types(ts: List[Type]): Str :=
  join(", ", list(for t in ts yield format_type(t)))

function type_section(mode: Str, ts: List[Type]): List[Str] :=
  if ts == list() then list() else list(mode ++ " " ++ format_types(ts))

// the argument of a function, in parentheses if it is a function
function type_operand(t: Type): Str :=
  match t
    case TFun(_, _) => "(" ++ format_type(t) ++ ")"
    case _ => format_type(t)
  end

// a component of a tuple, in parentheses if it is a function or a tuple
function type_component(t: Type): Str :=
  match t
    case TFun(_, _) => "(" ++ format_type(t) ++ ")"
    case TTuple(list(_, _; _)) => "(" ++ format_type(t) ++ ")"
    case _ => format_type(t)
  end

// patterns as the messages of the checker show them
function format_pat(pat: Pat): Str :=
  match pat
    case PWild => "_"
    case PLit(lit) => format_lit(lit)
    case PVar(var) => var.name.base
    case PTuple(pats) => "(" ++ format_pats(pats) ++ ")"
    case PApp(constr, list(x, xs)) if constr == cons_name() or constr == unqualified("Cons") => "list(" ++ format_pat(x) ++ "; " ++ format_pat(xs) ++ ")"
    case PApp(constr, list(l, r)) if symbolic(constr.base) => infix_text(constr.base, format_pat(l), format_pat(r))
    case PApp(constr, list()) => constr.base
    case PApp(constr, pats) => constr.base ++ "(" ++ format_pats(pats) ++ ")"
  end

function format_pats(pats: List[Pat]): Str :=
  join(", ", list(for p in pats yield format_pat(p)))

// constructors named by operators are shown infix
function symbolic(n: Id): Bool :=
  n != "" and is_op_char(at(0, n))

function infix_text(op: Id, l: Str, r: Str): Str :=
  pat_operand(l) ++ " " ++ op ++ " " ++ pat_operand(r)

function pat_operand(a: Str): Str :=
  if contains(' ', a) and at(0, a) != '(' then "(" ++ a ++ ")" else a

// the name with its module, to tell names apart
function format_name(n: Name): Str :=
  match n
    case Name(Some(m), base) => m ++ "." ++ base
    case Name(None, base) => base
  end

test printing() :=
  assert format_type(TFun(list(TFun(list(TParam("A")), TParam("B")), TTuple(list(TSort(unqualified("Int"), list()), TSort(unqualified("Str"), list())))), TSort(unqualified("List"), list(TParam("A"))))) == "(A -> B, Int * Str) -> List[A]"
  assert format_type(TProc(list(TParam("A")), list(), list(TSort(unqualified("Int"), list())))) == "(in A, ref Int)"
  assert format_pat(PApp(cons_name(), list(PVar(Var(unqualified("x"), THole)), PApp(unqualified("Some"), list(PWild))))) == "list(x; Some(_))"
  assert format_name(cons_name()) == "list.Cons" and cons_name().base == "Cons"
