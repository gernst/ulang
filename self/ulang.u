// the driver of ulang, as ./ulang.bin compile <file> <entry> <target.c>, which translates file to C, whose main runs
// the run entry, or all tests for the entry test, and as ./ulang.sh compile <file> <entry> <target.c> in the interpreter

import compile
import os

procedure main() :=
  local args: List[Str]

  call os_args(out args)
  // without arguments, e.g. when the tests run all files, the driver does nothing
  match args
    case [] =>
      skip
    case ["compile", source, entry, target] =>
      call compile_file(in source, entry, target)
    else
      raise OsError("usage: ulang compile <file> <entry> <target.c>")
  end
