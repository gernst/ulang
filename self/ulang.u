// the driver of ulang, ./ulang.bin, with the commands run, test, and check with the interpreter of run.u,
// compile, which translates a file to C, whose main calls the procedure entry, or runs all tests for the entry test,
// and format, which prints a file as format_program of format.u does

import "syntax.u"
import "parse.u"
import "check.u"
import "format.u"
import "run.u"
import "error.u"
import "compile.u"
import "os.u"
import "map.u"

data TestFailed :=
  case TestFailed(message: Str)

procedure main() :=
  local args: List[Str], command: List[Str], rest: List[Str], ok := true, dir: Bool

  call   os_args(out args)
  assign command := before_dashes(args), rest := after_dashes(args)

  // without arguments, e.g. when the tests run all files, the driver does nothing
  match command
    case list() =>
      skip
    case list("run", file) =>
      call attempt(in file, lambda out r => call run_file(in file, "main", rest, out r) end, out ok)
    case list("run", file, name) =>
      call attempt(in file, lambda out r => call run_file(in file, name, rest, out r) end, out ok)
    case list("test", first; more) =>
      call os_is_dir(in first, out dir)
      if dir
        call test_paths(in list(first; more), out ok)
      else
        call attempt(in first, lambda out r => call test_file(in first, more, rest, out r) end, out ok)
      end
    case list("check", file) =>
      call attempt(in file, lambda out r => call check_file(in file, out r) end, out ok)
    case list("compile", file, entry, target) =>
      call attempt(in file, lambda out r => call compile_to(in file, entry, target, out r) end, out ok)
    case list("format", file) =>
      call attempt(in file, lambda out r => call format_file(in file, out r) end, out ok)
    case _ =>
      call   os_print_error(in usage())
      assign ok := false
  end

  if not ok
    call os_exit(in 1)
  end

function usage(): Str :=
  "usage: ulang run <file> [<procedure>] [-- args]\n" ++
  "       ulang test <file> [<name> ...] [-- args]\n" ++
  "       ulang test <dir> [<path> ...]\n" ++
  "       ulang check <file>\n" ++
  "       ulang compile <file> <entry> <target.c>\n" ++
  "       ulang format <file>"

// the arguments of the driver, and those of the program after --
function before_dashes(args: List[Str]): List[Str] :=
  match args
    case list() => list()
    case list("--"; _) => list()
    case list(a; more) => list(a; before_dashes(more))
  end

function after_dashes(args: List[Str]): List[Str] :=
  match args
    case list() => list()
    case list("--"; more) => more
    case list(_; more) => after_dashes(more)
  end

// runs a command for file, which reports the errors of file, and whether it succeeded
procedure attempt(in file: Str, command: (out Bool), out ok: Bool) :=
  local message: Str

  call guarded(in file, command, out ok, message)
  if message != ""
    call os_print_error(in file ++ ": " ++ message)
  end

// runs a command for file, with whether it succeeded and the message of its error, or else ""
procedure guarded(in file: Str, command: (out Bool), out ok: Bool, message: Str) :=
  assign ok := false, message := ""

  try
    call command(out ok)
  catch
    case TestFailed(m) =>
      assign message := m
    case ParseError(m, pos) =>
      assign message := "parse error: " ++ m ++ at_pos(pos)
    case ImportError(module, m, pos) =>
      assign message := "parse error: " ++ m ++ " in " ++ module ++ at_pos(pos)
    case OsError(m) =>
      assign message := "runtime error: " ++ m
    case Unsupported(what) =>
      assign message := "compile error: " ++ what
    case UnknownEntry(name) =>
      assign message := "compile error: there is no procedure " ++ name.base ++ " without parameters"
    case e =>
      assign message := "type error: " ++ located_message(e)
    case e =>
      assign message := "runtime error: " ++ runtime_message(e)
  end

  if message != ""
    assign ok := false
  end

function at_pos(p: Pos): Str :=
  " at " ++ show(p.line) ++ "." ++ show(p.col)

// the checked program of file, after the modules it imports, and the name of the module of file
procedure load_file(in file: Str, out main: Id, q: Prog) :=
  local source: Source

  call   parse_file(in file, out source)
  call   check_program(in source, out q)
  assign main := source.main

function is_any_test(cmd: Cmd): Bool :=
  match cmd
    case CTest(_, _, _) => true
    case _ => false
  end

procedure check_file(in file: Str, out ok: Bool) :=
  local main: Id, q: Prog

  call   load_file(in file, out main, q)
  assign ok := true

procedure compile_to(in file: Str, entry: Str, target: Str, out ok: Bool) :=
  call   compile_file(in file, entry, target)
  assign ok := true

// prints file as source, which must parse to the same commands as file, so that formatting tests the parser and the printer
procedure format_file(in file: Str, out ok: Bool) :=
  local p: Source, q: Source, text: Str, source: Str

  call   os_read(in file, out text)
  call   parse_file_text(in file, text, out p)
  assign source := format_program(p.mods), ok := false

  try
    call parse_file_text(in file, source, out q)

    if list(for d in p.mods yield without_positions(d)) == list(for d in q.mods yield without_positions(d))
      call   os_print(in slice(source, 0, size(source) - 1))
      assign ok := true
    else
      call os_print_error(in file ++ ": format error: the source parses differently")
    end
  catch
    case ParseError(message, _) =>
      call os_print_error(in file ++ ": format error: the source does not parse: " ++ message)
  end

function without_positions(d: Mod): Mod :=
  d with exported := unplaced(commands_of(d.exported)), builtins := unplaced(commands_of(d.builtins)), implemented := unplaced(commands_of(d.implemented))

// calls the procedure name of file, which takes no parameters, and prints as it runs
procedure run_file(in file: Str, name: Str, args: List[Str], out ok: Bool) :=
  local main: Id, q: Prog, run: Run, cache: Map[Name, Value] := empty(), n: Name

  call   load_file(in file, out main, q)
  assign n := Name(Some(main), name)
  assign run := load(q) with args := args

  if exists(q.cmds, lambda c => is_entry(c, n))
    call   run_proc(in run, n, ref cache)
    assign ok := true
  else
    call   os_print_error(in file ++ ": runtime error: there is no procedure " ++ name ++ " without parameters")
    assign ok := false
  end

// runs the tests of file, all or the named ones, each on its own, also after a failed one, printing whether it passed
procedure test_file(in file: Str, names: List[Str], args: List[Str], out ok: Bool) :=
  local main: Id, q: Prog, run: Run, tests: List[Cmd], missing: List[Str]

  call   load_file(in file, out main, q)
  assign run := load(q) with args := args
  assign tests := list(for c in q.cmds if is_selected_test(c, names))
  assign missing := list(for n in names if not exists(tests, lambda c => is_test(c, n)))

  match missing
    case list(n; _) =>
      call   os_print_error(in file ++ ": runtime error: there is no test " ++ n)
      assign ok := false
    case _ =>
      call run_tests(in run, tests, out ok)
  end

procedure run_tests(in run: Run, tests: List[Cmd], out ok: Bool) :=
  local passed: Bool

  assign ok := true

  for c in tests do
    call   run_test(in run, c, out passed)
    assign ok := ok and passed
  end

procedure run_test(in run: Run, cmd: Cmd, out passed: Bool) :=
  local message: Str

  call test_message(in run, cmd, out message)
  if message == ""
    call   os_print(in "test " ++ cmd_name(cmd) ++ " passed")
    assign passed := true
  else
    call   os_print(in "test " ++ cmd_name(cmd) ++ " failed: " ++ message)
    assign passed := false
  end

// the error of the test cmd, or else ""
procedure test_message(in run: Run, cmd: Cmd, out message: Str) :=
  local cache: Map[Name, Value] := empty()

  assign message := ""

  try
    call run_cmd(in run, cmd, ref cache)
  catch
    case e =>
      assign message := "runtime error: " ++ runtime_message(e)
  end

// the .u files of the paths, where directories are walked, each run in its directory with all its tests, which must
// succeed, or fail with the error that its first line states, e.g. // type error: unknown variable x, where the files
// that do not are printed with the difference, and how many files passed
procedure test_paths(in paths: List[Str], out ok: Bool) :=
  local found: List[Str], files: List[Str], home: Str, failed: Int

  call   walk_all(in paths, out found)
  assign files := list(for f in found if is_source(f))
  call   os_cwd(out home)
  call   test_suite(in files, home, out failed)
  call   os_print(in show(size(files) - failed) ++ " of " ++ show(size(files)) ++ " files passed")
  assign ok := failed == 0

procedure walk_all(in paths: List[Str], out files: List[Str]) :=
  local here: List[Str], rest: List[Str]

  match paths
    case list() =>
      assign files := list()
    case list(path; more) =>
      call   os_walk(in path, out here)
      call   walk_all(in more, out rest)
      assign files := here ++ rest
  end

function is_source(path: Str): Bool :=
  size(path) > 2 and ends_with(path, ".u")

procedure test_suite(in files: List[Str], home: Str, out failed: Int) :=
  local good: Bool

  assign failed := 0

  for file in files do
    call verdict(in file, home, out good)

    if not good
      assign failed := failed + 1
    end
  end

// file, run in its directory, fails as its first line states, or else succeeds, where home is the directory to return to
procedure verdict(in file: Str, home: Str, out good: Bool) :=
  local text: Str, expected: Str, got: Str, ok: Bool, name := os_basename(file)

  call   os_read(in file, out text)
  assign expected := expected_error(text)
  call   os_chdir(in os_dirname(file))
  call   guarded(in name, lambda out r => call test_all(in name, out r) end, out ok, got)
  call   os_chdir(in home)
  assign good := got == expected

  if not good
    call os_print(in file ++ ": expected " ++ outcome(expected) ++ ", got " ++ outcome(got))
  end

function outcome(message: Str): Str :=
  if message == "" then "success" else message

// the error that the first line of a file states, or else ""
function expected_error(text: Str): Str :=
  match split(text, '\n')
    case list(line; _) =>
      if starts_with(line, "// parse error: ") or starts_with(line, "// type error: ") or starts_with(line, "// runtime error: ") then
        slice(line, 3, size(line))
      else
        ""
    case _ => ""
  end

// runs all tests of file, quietly, and raises the first failure
procedure test_all(in file: Str, out ok: Bool) :=
  local main: Id, q: Prog, run: Run, message: Str

  call   load_file(in file, out main, q)
  assign run := load(q)
  call   first_failure(in run, list(for c in q.cmds if is_any_test(c)), out message)

  if message != ""
    raise TestFailed(message)
  end

  assign ok := true

procedure first_failure(in run: Run, tests: List[Cmd], out message: Str) :=
  assign message := ""

  for c in tests do
    if message == ""
      call test_message(in run, c, out message)
    end
  end

function is_selected_test(cmd: Cmd, names: List[Str]): Bool :=
  match cmd
    case CTest(test_name, _, _) => names == list() or contains(test_name, names)
    case _ => false
  end

function is_test(cmd: Cmd, n: Str): Bool :=
  match cmd
    case CTest(test_name, _, _) => test_name == n
    case _ => false
  end

function cmd_name(cmd: Cmd): Str :=
  match cmd
    case CTest(test_name, _, _) => test_name
    case _ => ""
  end

// the messages of errors, without positions

// the message of e, with the position of the command that raised it, and the module if it is not the main module
function located_message(e: TypeError): Str :=
  match e
    case Located(None, pos, error) => type_message(error) ++ at_pos(pos)
    case Located(Some(m), pos, error) => type_message(error) ++ " in " ++ m ++ at_pos(pos)
    case _ => type_message(e)
  end

// a candidate of an ambiguous name with its type, if known, which tells overloads of one module apart
function candidate_text(c: Name * (List[Type] * Type)): Str :=
  match c
    case (m, (_, THole)) => format_name(m)
    case (m, (_, t)) => format_name(m) ++ ": " ++ format_type(t)
  end

function type_message(e: TypeError): Str :=
  match e
    case UnknownSort(name) => "unknown sort " ++ name.base
    case SortArity(name, expected, actual) => "sort " ++ name.base ++ " expects " ++ show(expected) ++ " arguments, got " ++ show(actual)
    case SortDefined(name) => "sort " ++ name.base ++ " is already defined"
    case MissingType(name) => "missing type for " ++ name.base
    case UndeclaredParams(name, types) => name.base ++ " has undeclared type parameters " ++ format_types(types)
    case CannotUnify(left, right) => "cannot unify " ++ format_type(left) ++ " and " ++ format_type(right)
    case InfiniteType(meta, typ) => "infinite type " ++ format_type(meta) ++ " = " ++ format_type(typ)
    case UnknownVariable(name) => "unknown variable " ++ name.base
    case NoOverload(name, typ) => "no declaration of " ++ name.base ++ " has the type " ++ format_type(typ)
    case WrongArity(name, arity) => name.base ++ " does not take " ++ show(arity) ++ " arguments"
    case AlreadyDefined(name) => name.base ++ " is already defined"
    case Duplicate(what, item) => "duplicate " ++ what ++ " " ++ item
    case Ambiguous(name, candidates) => name.base ++ " is ambiguous: " ++ join(", ", list(for c in candidates yield candidate_text(c)))
    case UnknownField(name) => field_message(split(name.base, '.'))
    case UnknownFieldType(field, typ) => "the type " ++ format_type(typ) ++ " of the value of " ++ field ++ " is not known"
    case UnknownContainer(typ) => "the type " ++ format_type(typ) ++ " of the container of a generator is not known there, which an annotation can give"
    case FormImport(m) => m ++ "(...) needs import \"" ++ m ++ ".u\""
    case CountMismatch(owner, unit, k, actual) => (if owner == "" then "expected " else owner ++ " expects ") ++ show(k) ++ " " ++ unit ++ ", got " ++ show(actual)
    case UnknownConstructor(name) => "unknown constructor " ++ name.base
    case NotExhaustive(pat) => "match is not exhaustive, missing " ++ format_pat(pat)
    case Unreachable(pat) => "unreachable case " ++ format_pat(pat)
    case NotAssignable(name) => name.base ++ " is not assignable"
    case UnknownProcedure(name) => "unknown procedure " ++ name.base
    case UnknownException(typ) => "the type " ++ format_type(typ) ++ " of an exception is not fully known"
    case TestParams(test_name) => "test " ++ test_name ++ " takes parameters"
    case Unassigned(name) => name.base ++ " is not assigned on every path"
    case OutputUnassigned(x, proc) => "output " ++ x.base ++ " of " ++ proc.base ++ " is not assigned on every path"
    case MissingDefinition(name) => name.base ++ " is exported but not defined"
    case SignatureMismatch(name) => "the definition of " ++ name.base ++ " differs from its signature"
    case PartlyExported(name) => name.base ++ " is exported, but not with each of its numbers of arguments"
    case PrivateType(name, sort) => "the signature of " ++ name.base ++ " names the private type " ++ sort.base
    case VisibleEquality(sort) => sort.base ++ " declares ==, which only abstract types may"
    case UnexportedOrder(fun, sort) => fun.base ++ " of the exported type " ++ sort.base ++ " is not exported"
    case Located(_, _, error) => type_message(error)
  end

// the accessor T.f, or the updater T.f:=, of an unknown field f
function field_message(parts: List[Str]): Str :=
  match parts
    case list("", f) => "unknown field " ++ without_update(f)
    case list(t, f) => "unknown field " ++ without_update(f) ++ " of " ++ t
    case _ => "unknown field " ++ join(".", parts)
  end

function without_update(f: Str): Str :=
  if size(f) > 2 and ends_with(f, ":=") then slice(f, 0, size(f) - 2) else f

function runtime_message(e: RuntimeError): Str :=
  match e
    case Failed(failure) => format_failure(failure)
    case Uninitialized(name) => name.base ++ " is not initialized"
    case NotFunction(value) => "cannot apply " ++ format_value(value)
    case Unspecified(name, args) => name.base ++ " is not specified for " ++ join(", ", list(for v in args yield format_value(v)))
    case NotList(value) => "expected a list, got " ++ format_value(value)
    case UnassignedOutput(x, proc) => "output " ++ x.base ++ " of " ++ proc.base ++ " is not assigned"
    case UnknownProc(name) => "unknown procedure " ++ name.base
    case NotProc(value) => "cannot call " ++ format_value(value)
    case UnresolvedField(field) => "the field " ++ field ++ " is not resolved"
    case UntranslatedForm(form) => "the form " ++ form ++ "(...) is not translated"
  end
