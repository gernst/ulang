// strings of code points and their characters, by the functions that the interpreter and the runtime implement, with the names that strings share with the containers, in their order and with their results, where a string is a map
// from indices to characters, concatenated by ++ of the prelude, compared by compare, and shown by show
//
// which every module imports implicitly after list, so that list.u cannot use it, where the builtin section declares the
// functions that the interpreter and the runtime define

import option
import list

export

// the character as an option, which is None out of range
function get(i: Int, s: Str): Option[Char]

// whether s starts with start, and whether it ends with finish
function starts_with(s: Str, start: Str): Bool
function ends_with(s: Str, finish: Str): Bool

builtin

// the characters of a string, and the string of characters
function list(s: Str): List[Char]
function str(cs: List[Char]): Str

// the code point of a character, and the character of a code point from 0 to 0x10FFFF other than the surrogates 0xD800
// to 0xDFFF of UTF-16, or else NoCharacter
function ord(c: Char): Int
function chr(n: Int): Char

function is_digit(c: Char): Bool
function is_letter(c: Char): Bool
function is_space(c: Char): Bool

// the number of characters, which are code points
function size(s: Str): Int

// the character at index i, from 0, or else OutOfBounds
function at(i: Int, s: Str): Char

function contains(c: Char, s: Str): Bool

// the characters from index i up to j, exclusively, where 0 <= i <= j <= size(s), or else OutOfBounds
function slice(s: Str, i: Int, j: Int): Str

// the strings of strs with sep between them, and the parts of s between the occurrences of c, including empty ones
function join(sep: Str, strs: List[Str]): Str
function split(s: Str, c: Char): List[Str]

// the string in double quotes, with escapes as in literals
function quote(s: Str): Str

// the integer of the decimal digits of s, with an optional -, if s is one
function number(s: Str): Option[Int]

implementation

function get(i: Int, s: Str): Option[Char] :=
  if 0 <= i and i < size(s) then Some(at(i, s)) else None

function starts_with(s: Str, start: Str): Bool :=
  size(start) <= size(s) and slice(s, 0, size(start)) == start

function ends_with(s: Str, finish: Str): Bool :=
  size(finish) <= size(s) and slice(s, size(s) - size(finish), size(s)) == finish

test strings() :=
  assert size("abc") == 3 and at(1, "abc") == 'b' and get(1, "abc") == Some('b') and get(3, "abc") == None
  assert get(-1, "abc") == None and contains('b', "abc") and not contains('d', "abc")
  assert slice("abc", 1, 3) == "bc" and join(", ", split("a,b", ',')) == "a, b"
  assert quote("a\"b") == "\"a\\\"b\"" and number("-12") == Some(-12) and number("1a") == None
  assert starts_with("abc", "ab") and not starts_with("a", "ab") and ends_with("abc", "bc") and not ends_with("abc", "ab")
