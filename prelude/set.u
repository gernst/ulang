// sets as AVL trees, ordered by compare, where the heights of the subtrees of each node differ by at most one,
// such that insert and contains take logarithmic time, with the names of the module map, which overload them

export

type Set[A]

function empty[A](): Set[A]
function contains[A](x: A, s: Set[A]): Bool
function insert[A](x: A, s: Set[A]): Set[A]
function set[A](xs: List[A]): Set[A]
function remove[A](x: A, s: Set[A]): Set[A]

// the union, the difference, and the intersection of two sets
function ++[A](a: Set[A], b: Set[A]): Set[A]
function --[A](a: Set[A], b: Set[A]): Set[A]
function intersect[A](a: Set[A], b: Set[A]): Set[A]

// whether p holds for some element, or for all
function exists[A](s: Set[A], p: A -> Bool): Bool
function forall[A](s: Set[A], p: A -> Bool): Bool
function size[A](s: Set[A]): Int

// f(x1, f(x2, ... f(xn, acc))) and f(... f(f(acc, x1), x2) ..., xn) of the elements in ascending order
function foldr[A, R](s: Set[A], acc: R, f: (A, R) -> R): R
function foldl[A, R](s: Set[A], acc: R, f: (R, A) -> R): R

// the elements of s in ascending order
function list[A](s: Set[A]): List[A]

// sets are ordered and equal by their elements, whatever the shapes of their trees, also as elements of other values
// and in generic code
function compare[A](a: Set[A], b: Set[A]): Int
function ==[A](a: Set[A], b: Set[A]): Bool

// the elements in ascending order as the literal {a, b}, also inside other values
function show[A](s: Set[A]): Str

implementation

data Set[A] :=
  | Leaf
  | Node(Set[A], A, Set[A], Int)

function empty[A](): Set[A] :=
  Leaf

function contains[A](x: A, s: Set[A]): Bool :=
  match s
    case Leaf => false
    case Node(l, y, r, _) =>
      match compare(x, y)
        case -1 => contains(x, l)
        case 1 => contains(x, r)
        case _ => true
      end
  end

function insert[A](x: A, s: Set[A]): Set[A] :=
  match s
    case Leaf => Node(Leaf, x, Leaf, 1)
    case Node(l, y, r, _) =>
      match compare(x, y)
        case -1 => balance(insert(x, l), y, r)
        case 1 => balance(l, y, insert(x, r))
        case _ => s
      end
  end

// s without x
function remove[A](x: A, s: Set[A]): Set[A] :=
  match s
    case Leaf => Leaf
    case Node(l, y, r, _) =>
      match compare(x, y)
        case -1 => balance(remove(x, l), y, r)
        case 1 => balance(l, y, remove(x, r))
        case _ => joined(l, r)
      end
  end

// the elements of l and r, where those of l are smaller
function joined[A](l: Set[A], r: Set[A]): Set[A] :=
  match first_of(r)
    case Some(x) => balance(l, x, without_first(r))
    case None => l
  end

function first_of[A](s: Set[A]): Option[A] :=
  match s
    case Leaf => None
    case Node(Leaf, x, _, _) => Some(x)
    case Node(l, _, _, _) => first_of(l)
  end

function without_first[A](s: Set[A]): Set[A] :=
  match s
    case Leaf => Leaf
    case Node(Leaf, _, r, _) => r
    case Node(l, x, r, _) => balance(without_first(l), x, r)
  end

function ++[A](a: Set[A], b: Set[A]): Set[A] :=
  foldl(b, a, lambda s, x => insert(x, s))

function --[A](a: Set[A], b: Set[A]): Set[A] :=
  foldl(b, a, lambda s, x => remove(x, s))

function intersect[A](a: Set[A], b: Set[A]): Set[A] :=
  foldl(a, empty(), lambda s, x => if contains(x, b) then insert(x, s) else s)

function exists[A](s: Set[A], p: A -> Bool): Bool :=
  foldl(s, false, lambda found, x => found or p(x))

function forall[A](s: Set[A], p: A -> Bool): Bool :=
  foldl(s, true, lambda all, x => all and p(x))

function set[A](xs: List[A]): Set[A] :=
  inserted(xs, Leaf)

// s with the elements of xs
function inserted[A](xs: List[A], s: Set[A]): Set[A] :=
  match xs
    case Nil => s
    case [x; rest] => inserted(rest, insert(x, s))
  end

function compare[A](a: Set[A], b: Set[A]): Int :=
  compare(list(a), list(b))

function ==[A](a: Set[A], b: Set[A]): Bool :=
  list(a) == list(b)

// the elements of s in their order
function elements_onto[A](s: Set[A], rest: List[A]): List[A] :=
  match s
    case Leaf => rest
    case Node(l, x, r, _) => elements_onto(l, [x; elements_onto(r, rest)])
  end

function foldr[A, R](s: Set[A], acc: R, f: (A, R) -> R): R :=
  match s
    case Leaf => acc
    case Node(l, x, r, _) => foldr(l, f(x, foldr(r, acc, f)), f)
  end

function foldl[A, R](s: Set[A], acc: R, f: (R, A) -> R): R :=
  match s
    case Leaf => acc
    case Node(l, x, r, _) => foldl(r, f(foldl(l, acc, f), x), f)
  end

function list[A](s: Set[A]): List[A] :=
  elements_onto(s, Nil)

function size[A](s: Set[A]): Int :=
  match s
    case Leaf => 0
    case Node(l, _, r, _) => size(l) + 1 + size(r)
  end

function height[A](s: Set[A]): Int :=
  match s
    case Leaf => 0
    case Node(_, _, _, d) => d
  end

function node_height[A](l: Set[A], r: Set[A]): Int :=
  1 + (if height(l) < height(r) then height(r) else height(l))

function node[A](l: Set[A], x: A, r: Set[A]): Set[A] :=
  Node(l, x, r, node_height(l, r))

function rotate_left[A](s: Set[A]): Set[A] :=
  match s
    case Node(a, x, Node(b, y, c, _), _) => node(node(a, x, b), y, c)
    case _ => s
  end

function rotate_right[A](s: Set[A]): Set[A] :=
  match s
    case Node(Node(a, x, b, _), y, c, _) => node(a, x, node(b, y, c))
    case _ => s
  end

function left_of[A](s: Set[A]): Set[A] :=
  match s
    case Node(l, _, _, _) => l
    case _ => s
  end

function right_of[A](s: Set[A]): Set[A] :=
  match s
    case Node(_, _, r, _) => r
    case _ => s
  end

// the node of l, x, r, where the heights of l and r differ by at most two, rebalanced by one or two rotations
function balance[A](l: Set[A], x: A, r: Set[A]): Set[A] :=
  if height(l) > height(r) + 1 then
    rotate_right(node(if height(left_of(l)) < height(right_of(l)) then rotate_left(l) else l, x, r))
  else if height(r) > height(l) + 1 then
    rotate_left(node(l, x, if height(right_of(r)) < height(left_of(r)) then rotate_right(r) else r))
  else
    node(l, x, r)

// the heights of the subtrees of each node differ by at most one, and its height is correct
function balanced[A](s: Set[A]): Bool :=
  match s
    case Leaf => true
    case Node(l, _, r, d) =>
      balanced(l) and balanced(r) and d == node_height(l, r) and height(l) <= height(r) + 1 and height(r) <= height(l) + 1
  end

function upto(n: Int): List[Int] :=
  if n == 0 then Nil else upto(n - 1) ++ [n]

function show[A](s: Set[A]): Str :=
  "{" ++ join(", ", [show(x) for x in list(s)]) ++ "}"

test sets() :=
  local s := {"a", "b"}

  assert contains("a", s) and not contains("c", s)
  assign s := insert("a", s)
  assert list(s) == ["a", "b"] and size(s) == 2
  assert list(set([3, 1, 2, 1])) == [1, 2, 3] and list({3, 1, 2, 1}) == [1, 2, 3]
  assert list(set([(2, 'a'), (1, 'b'), (2, 'a')])) == [(1, 'b'), (2, 'a')]
  assert list(set([Some(2), None, Some(1)])) == [None, Some(1), Some(2)]

test set_folds() :=
  local s := set(upto(50))

  assert foldr(s, Nil, Cons) == list(s) and foldl(s, Nil, lambda xs, x => [x; xs]) == reverse(list(s))
  assert foldr(s, empty(), insert) == s and foldl(s, 0, lambda n, x => n + x) == 1275
  assert foldr({1, 2, 3}, 0, lambda x, n => 10 * n + x) == 321 and foldl({1, 2, 3}, 0, lambda n, x => 10 * n + x) == 123
  assert list({3, 1, 2}) == [1, 2, 3] and list(s) == list(s)

// sets of the same elements are equal, although their trees differ
test set_equality() :=
  assert set([1, 2]) == set([2, 1]) and set([1, 2]) != set([1, 3])
  assert {1, 2, 3} == {3, 2, 1} and not ({1} != {1})

// ascending elements would make a list of an unbalanced tree
test set_balance() :=
  local s := set(upto(200))

  assert balanced(s) and size(s) == 200 and height(s) <= 11
  assert contains(100, s) and not contains(201, s) and list(s) == upto(200)
