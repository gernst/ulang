// maps from keys to values as AVL trees, ordered by compare, where the heights of the subtrees of each node
// differ by at most one, such that get and put take logarithmic time

export

type Map[K, V]

function empty[K, V](): Map[K, V]
function get[K, V](k: K, m: Map[K, V]): Option[V]
function contains[K, V](k: K, m: Map[K, V]): Bool
function put[K, V](k: K, v: V, m: Map[K, V]): Map[K, V]
function put_all[K, V](ps: List[K * V], m: Map[K, V]): Map[K, V]
function remove[K, V](k: K, m: Map[K, V]): Map[K, V]
function remove_all[K, V](ks: List[K], m: Map[K, V]): Map[K, V]

// the pairs of m in the order of their keys
function entries[K, V](m: Map[K, V]): List[K * V]
function size[K, V](m: Map[K, V]): Int

// f(k1, v1, f(k2, v2, ... f(kn, vn, acc))) and f(... f(f(acc, k1, v1), k2, v2) ..., kn, vn) of the entries in the order of
// their keys
function foldr[K, V, R](m: Map[K, V], acc: R, f: (K, V, R) -> R): R
function foldl[K, V, R](m: Map[K, V], acc: R, f: (R, K, V) -> R): R

// maps are ordered and equal by their entries, whatever the shapes of their trees, also as elements of other values
// and in generic code
function compare[K, V](a: Map[K, V], b: Map[K, V]): Int
function ==[K, V](a: Map[K, V], b: Map[K, V]): Bool

implementation

data Map[K, V] :=
  | Leaf
  | Node(Map[K, V], K, V, Map[K, V], Int)

function empty[K, V](): Map[K, V] :=
  Leaf

function get[K, V](k: K, m: Map[K, V]): Option[V] :=
  match m
    case Leaf => None
    case Node(l, j, v, r, _) =>
      match compare(k, j)
        case -1 => get(k, l)
        case 1 => get(k, r)
        case _ => Some(v)
      end
  end

function contains[K, V](k: K, m: Map[K, V]): Bool :=
  get(k, m) != None

// m where k has the value v
function put[K, V](k: K, v: V, m: Map[K, V]): Map[K, V] :=
  match m
    case Leaf => Node(Leaf, k, v, Leaf, 1)
    case Node(l, j, w, r, h) =>
      match compare(k, j)
        case -1 => balance(put(k, v, l), j, w, r)
        case 1 => balance(l, j, w, put(k, v, r))
        case _ => Node(l, k, v, r, h)
      end
  end

function compare[K, V](a: Map[K, V], b: Map[K, V]): Int :=
  compare(entries(a), entries(b))

function ==[K, V](a: Map[K, V], b: Map[K, V]): Bool :=
  entries(a) == entries(b)

function entries[K, V](m: Map[K, V]): List[K * V] :=
  entries_onto(m, Nil)

function entries_onto[K, V](m: Map[K, V], rest: List[K * V]): List[K * V] :=
  match m
    case Leaf => rest
    case Node(l, k, v, r, _) => entries_onto(l, [(k, v); entries_onto(r, rest)])
  end

function foldr[K, V, R](m: Map[K, V], acc: R, f: (K, V, R) -> R): R :=
  match m
    case Leaf => acc
    case Node(l, k, v, r, _) => foldr(l, f(k, v, foldr(r, acc, f)), f)
  end

function foldl[K, V, R](m: Map[K, V], acc: R, f: (R, K, V) -> R): R :=
  match m
    case Leaf => acc
    case Node(l, k, v, r, _) => foldl(r, f(foldl(l, acc, f), k, v), f)
  end

function size[K, V](m: Map[K, V]): Int :=
  match m
    case Leaf => 0
    case Node(l, _, _, r, _) => size(l) + 1 + size(r)
  end

function height[K, V](m: Map[K, V]): Int :=
  match m
    case Leaf => 0
    case Node(_, _, _, _, h) => h
  end

function node[K, V](l: Map[K, V], k: K, v: V, r: Map[K, V]): Map[K, V] :=
  Node(l, k, v, r, node_height(l, r))

function rotate_left[K, V](m: Map[K, V]): Map[K, V] :=
  match m
    case Node(a, j, v, Node(b, k, w, c, _), _) => node(node(a, j, v, b), k, w, c)
    case _ => m
  end

function rotate_right[K, V](m: Map[K, V]): Map[K, V] :=
  match m
    case Node(Node(a, j, v, b, _), k, w, c, _) => node(a, j, v, node(b, k, w, c))
    case _ => m
  end

function left_of[K, V](m: Map[K, V]): Map[K, V] :=
  match m
    case Node(l, _, _, _, _) => l
    case _ => m
  end

function right_of[K, V](m: Map[K, V]): Map[K, V] :=
  match m
    case Node(_, _, _, r, _) => r
    case _ => m
  end

// the node of l, k, v, r, where the heights of l and r differ by at most two, rebalanced by one or two rotations
function balance[K, V](l: Map[K, V], k: K, v: V, r: Map[K, V]): Map[K, V] :=
  if height(l) > height(r) + 1 then
    rotate_right(node(if height(left_of(l)) < height(right_of(l)) then rotate_left(l) else l, k, v, r))
  else if height(r) > height(l) + 1 then
    rotate_left(node(l, k, v, if height(right_of(r)) < height(left_of(r)) then rotate_right(r) else r))
  else
    node(l, k, v, r)

// the heights of the subtrees of each node differ by at most one, and its height is correct
function balanced[K, V](m: Map[K, V]): Bool :=
  match m
    case Leaf => true
    case Node(l, _, _, r, h) =>
      balanced(l) and balanced(r) and h == node_height(l, r) and height(l) <= height(r) + 1 and height(r) <= height(l) + 1
  end

function node_height[K, V](l: Map[K, V], r: Map[K, V]): Int :=
  1 + (if height(l) < height(r) then height(r) else height(l))

// m without k
function remove[K, V](k: K, m: Map[K, V]): Map[K, V] :=
  match m
    case Leaf => Leaf
    case Node(l, j, v, r, _) =>
      match compare(k, j)
        case -1 => balance(remove(k, l), j, v, r)
        case 1 => balance(l, j, v, remove(k, r))
        case _ => join(l, r)
      end
  end

function remove_all[K, V](ks: List[K], m: Map[K, V]): Map[K, V] :=
  match ks
    case Nil => m
    case [k; rest] => remove_all(rest, remove(k, m))
  end

// the entries of l and then r, whose heights differ by at most one
function join[K, V](l: Map[K, V], r: Map[K, V]): Map[K, V] :=
  match first_entry(r)
    case Some((k, v)) => balance(l, k, v, remove_first(r))
    case None => l
  end

function first_entry[K, V](m: Map[K, V]): Option[K * V] :=
  match m
    case Leaf => None
    case Node(Leaf, k, v, _, _) => Some((k, v))
    case Node(l, _, _, _, _) => first_entry(l)
  end

function remove_first[K, V](m: Map[K, V]): Map[K, V] :=
  match m
    case Leaf => Leaf
    case Node(Leaf, _, _, r, _) => r
    case Node(l, k, v, r, _) => balance(remove_first(l), k, v, r)
  end

function put_all[K, V](ps: List[K * V], m: Map[K, V]): Map[K, V] :=
  match ps
    case Nil => m
    case [(k, v); rest] => put_all(rest, put(k, v, m))
  end

function numbers(n: Int): List[Int] :=
  if n == 0 then Nil else numbers(n - 1) ++ [n]

test maps() :=
  local m := {"a" => 1, "b" => 2}

  assert get("a", m) == Some(1) and get("c", m) == None and contains("b", m) and not contains("c", m)
  assign m := put("a", 3, m)
  assert entries(m) == [("a", 3), ("b", 2)] and size(m) == 2 and entries({"b" => 2, "a" => 1, "a" => 3}) == entries(m)

test map_folds() :=
  local m := put_all([(i, str_show(i)) for i in numbers(50)], empty())

  assert foldr(m, Nil, lambda k, v, ps => [(k, v); ps]) == entries(m) and foldr(m, empty(), put) == m
  assert foldl(m, Nil, lambda ps, k, v => [(k, v); ps]) == reverse(entries(m)) and foldl(m, 0, lambda n, k, v => n + k) == 1275
  assert foldr({1 => "a", 2 => "b"}, "", lambda k, v, t => v ^ t) == "ab" and foldl({1 => "a", 2 => "b"}, "", lambda t, k, v => t ^ v) == "ab"

// maps of the same entries are equal, although their trees differ
test map_equality() :=
  assert {1 => "a", 2 => "b"} == {2 => "b", 1 => "a"} and {1 => "a"} != {1 => "b"}

// ascending keys would make a list of an unbalanced tree
test balance() :=
  local m := put_all([(str_show(1000 + i), i) for i in numbers(200)], empty())

  assert balanced(m) and size(m) == 200 and height(m) <= 11
  assert get("1100", m) == Some(100) and get("1201", m) == None
  assert entries(m) == [(str_show(1000 + i), i) for i in numbers(200)]
  assign m := remove_all([str_show(1000 + 2 * i) for i in numbers(100)] ++ ["none"], m)
  assert balanced(m) and size(m) == 100 and entries(m) == [(str_show(999 + 2 * i), 2 * i - 1) for i in numbers(100)]
