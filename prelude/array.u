// arrays of fixed size, whose elements are read by index in constant time, and which are changed by copying, with the names
// that arrays share with the containers, in their order, where the builtin section declares the type and the functions
// that the interpreter and the runtime define, which order arrays by their elements and then by their size, as lists, and
// show them as |a, b|, where |a, b| and |e for x in c if q| are the arrays of the list or of the comprehension

import "option.u"
import "list.u"

export

// the element as an option, which is None out of range, and whether x is an element
function get[A](i: Int, a: Array[A]): Option[A]
function contains[A](x: A, a: Array[A]): Bool

// whether p holds for some element, or for all
function exists[A](a: Array[A], p: A -> Bool): Bool
function forall[A](a: Array[A], p: A -> Bool): Bool

builtin

type Array[A]

// the array of the elements of xs, which the form array(...) uses
function from_list[A](xs: List[A]): Array[A]

function size[A](a: Array[A]): Int

// the element at index i, from 0, or else OutOfBounds
function at[A](i: Int, a: Array[A]): A

// the elements from index i up to j, exclusively, where 0 <= i <= j <= size(a), or else OutOfBounds
function slice[A](a: Array[A], i: Int, j: Int): Array[A]

// f(x1, f(x2, ... f(xn, acc))) and f(... f(f(acc, x1), x2) ..., xn), both by loops
function foldr[A, R](a: Array[A], acc: R, f: (A, R) -> R): R
function foldl[A, R](a: Array[A], acc: R, f: (R, A) -> R): R

implementation

function exists[A](a: Array[A], p: A -> Bool): Bool :=
  foldl(a, false, lambda found, x => found or p(x))

function forall[A](a: Array[A], p: A -> Bool): Bool :=
  foldl(a, true, lambda all, x => all and p(x))

function get[A](i: Int, a: Array[A]): Option[A] :=
  if 0 <= i and i < size(a) then Some(at(i, a)) else None

function contains[A](x: A, a: Array[A]): Bool :=
  foldl(a, false, lambda found, y => found or x == y)

test arrays() :=
  local a := array(1, 2, 3)

  assert size(a) == 3 and at(0, a) == 1 and at(2, a) == 3 and get(1, a) == Some(2) and get(3, a) == None and get(-1, a) == None
  assert list(for x in a) == list(1, 2, 3) and list(for x in array(for x in list())) == list() and contains(2, a) and not contains(4, a)
  assert list(for x in a) == list(1, 2, 3)
  assert list(for x in slice(a, 1, 3)) == list(2, 3) and size(slice(a, 1, 1)) == 0
  assert foldr(a, list(), Cons) == list(1, 2, 3) and foldl(a, 0, lambda n, x => 10 * n + x) == 123
