// files, directories, the arguments of the program, and printing, where the procedures of the builtin section are those that
// the interpreter and the runtime define

export

data OsError :=
  case OsError(message: Str)

// the paths of the files below path, depth-first in the order of names, or path itself if it is no directory,
// where each path is that of its directory, /, and its name
procedure os_walk(in path: Str, out files: List[Str])

// the path of name in dir, which may end with /
function os_join(dir: Str, name: Str): Str

// the last part of a path, after its last /, and the part before, which is . for a path without /
function os_basename(path: Str): Str
function os_dirname(path: Str): Str

builtin

// the arguments of the program, after -- for the interpreter
procedure os_args(out args: List[Str])

// read and write files, where relative paths start from the working directory, and failures raise OsError
procedure os_read(in path: Str, out text: Str)
procedure os_write(in path: Str, text: Str)

// the source of a module of the library
procedure os_library(in name: Str, out text: Str)

// print a string as it is, to the output and to the error output, where show gives the text of any value
procedure os_print(in text: Str)
procedure os_print_error(in text: Str)

// end the program with the status code
procedure os_exit(in code: Int)

// the names in a directory, sorted, each with whether it is a directory, without following links, and whether path is a directory,
// also through a link
procedure os_list(in dir: Str, out entries: List[Str * Bool])
procedure os_is_dir(in path: Str, out yes: Bool)

// the working directory, which relative paths start from, and its change
procedure os_cwd(out dir: Str)
procedure os_chdir(in dir: Str)

implementation

procedure os_walk(in path: Str, out files: List[Str]) :=
  local dir: Bool

  call os_is_dir(in path, out dir)
  if dir
    call os_walk_dir(in path, out files)
  else
    assign files := list(path)
  end

procedure os_walk_dir(in dir: Str, out files: List[Str]) :=
  local entries: List[Str * Bool]

  call os_list(in dir, out entries)
  call os_walk_entries(in dir, entries, out files)

procedure os_walk_entries(in dir: Str, entries: List[Str * Bool], out files: List[Str]) :=
  local below: List[Str], rest: List[Str]

  match entries
    case list() =>
      assign files := list()
    case list((name, true); more) =>
      call   os_walk_dir(in os_join(dir, name), out below)
      call   os_walk_entries(in dir, more, out rest)
      assign files := below ++ rest
    case list((name, false); more) =>
      call   os_walk_entries(in dir, more, out rest)
      assign files := list(os_join(dir, name); rest)
  end

function os_join(dir: Str, name: Str): Str :=
  if size(dir) > 0 and at(size(dir) - 1, dir) == '/' then dir ++ name else dir ++ "/" ++ name

function os_basename(path: Str): Str :=
  match last(split(path, '/'))
    case Some(name) => name
    case None => path
  end

function os_dirname(path: Str): Str :=
  let parts := split(path, '/') in if size(parts) == 1 then "." else join("/", take(size(parts) - 1, parts))

test paths() :=
  assert os_basename("a/b.u") == "b.u" and os_basename("b.u") == "b.u" and os_dirname("a/b/c.u") == "a/b" and os_dirname("c.u") == "."
  assert os_join("a", "b") == "a/b" and os_join("a/", "b") == "a/b"
