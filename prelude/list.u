// [a, b; xs] is notation for Cons(a, Cons(b, xs)), and [a, b] for Cons(a, Cons(b, Nil))

import option

export

infix right 7 ++

data List[A] :=
  | Nil
  | Cons(A, List[A])

function ++[A](xs: List[A], ys: List[A]): List[A]
function size[A](xs: List[A]): Int
function contains[A](x: A, xs: List[A]): Bool
function exists[A](xs: List[A], p: A -> Bool): Bool
function forall[A](xs: List[A], p: A -> Bool): Bool

// f(x1, f(x2, ... f(xn, acc))), which recurses as deep as xs is long, and f(... f(f(acc, x1), x2) ..., xn)
function foldr[A, R](xs: List[A], acc: R, f: (A, R) -> R): R
function foldl[A, R](xs: List[A], acc: R, f: (R, A) -> R): R

// association lists of keys and values, where the first pair of a key counts, and put replaces it, sharing the pairs after it,
// or puts (k, v) in front if k has none
function get[K, V](k: K, xs: List[K * V]): Option[V]
function put[K, V](k: K, v: V, xs: List[K * V]): List[K * V]
function remove[K, V](k: K, xs: List[K * V]): List[K * V]
function has_key[K, V](k: K, xs: List[K * V]): Bool
function keys[K, V](xs: List[K * V]): List[K]
function values[K, V](xs: List[K * V]): List[V]

function distinct[A](xs: List[A]): List[A]

// an element that occurs twice
function repeated[A](xs: List[A]): Option[A]
function diff[A](xs: List[A], ys: List[A]): List[A]
function concat[A](xss: List[List[A]]): List[A]

// the elements of xs in reverse order, before ys
function reverse_onto[A](xs: List[A], ys: List[A]): List[A]
function reverse[A](xs: List[A]): List[A]
function zip[A, B](xs: List[A], ys: List[B]): List[A * B]
function take[A](n: Int, xs: List[A]): List[A]
function drop[A](n: Int, xs: List[A]): List[A]
function replicate[A](n: Int, x: A): List[A]
function firsts[A, B](ps: List[A * B]): List[A]
function seconds[A, B](ps: List[A * B]): List[B]

implementation

function ++[A](xs: List[A], ys: List[A]): List[A] :=
  match xs
    case Nil => ys
    case [x; zs] => [x; zs ++ ys]
  end

function size[A](xs: List[A]): Int :=
  match xs
    case Nil => 0
    case [_; ys] => 1 + size(ys)
  end

function get[K, V](k: K, xs: List[K * V]): Option[V] :=
  match xs
    case Nil => None
    case [(j, v); _] if j == k => Some(v)
    case [_; ys] => get(k, ys)
  end

function put[K, V](k: K, v: V, xs: List[K * V]): List[K * V] :=
  match replaced(k, v, xs)
    case Some(ys) => ys
    case None => [(k, v); xs]
  end

function replaced[K, V](k: K, v: V, xs: List[K * V]): Option[List[K * V]] :=
  match xs
    case Nil => None
    case [(j, _); ys] if j == k => Some([(k, v); ys])
    case [p; ys] =>
      match replaced(k, v, ys)
        case Some(zs) => Some([p; zs])
        case None => None
      end
  end

function remove[K, V](k: K, xs: List[K * V]): List[K * V] :=
  match xs
    case Nil => Nil
    case [(j, _); ys] if j == k => remove(k, ys)
    case [p; ys] => [p; remove(k, ys)]
  end

function has_key[K, V](k: K, xs: List[K * V]): Bool :=
  match xs
    case Nil => false
    case [(j, _); ys] => j == k or has_key(k, ys)
  end

function keys[K, V](xs: List[K * V]): List[K] :=
  match xs
    case Nil => Nil
    case [(k, _); ys] => [k; keys(ys)]
  end

function values[K, V](xs: List[K * V]): List[V] :=
  match xs
    case Nil => Nil
    case [(_, v); ys] => [v; values(ys)]
  end

function contains[A](x: A, xs: List[A]): Bool :=
  match xs
    case Nil => false
    case [y; ys] => x == y or contains(x, ys)
  end

function exists[A](xs: List[A], p: A -> Bool): Bool :=
  match xs
    case Nil => false
    case [y; ys] => p(y) or exists(ys, p)
  end

function forall[A](xs: List[A], p: A -> Bool): Bool :=
  match xs
    case Nil => true
    case [y; ys] => p(y) and forall(ys, p)
  end

function foldr[A, R](xs: List[A], acc: R, f: (A, R) -> R): R :=
  match xs
    case Nil => acc
    case [y; ys] => f(y, foldr(ys, acc, f))
  end

function foldl[A, R](xs: List[A], acc: R, f: (R, A) -> R): R :=
  match xs
    case Nil => acc
    case [y; ys] => foldl(ys, f(acc, y), f)
  end

function distinct[A](xs: List[A]): List[A] :=
  match xs
    case Nil => Nil
    case [y; ys] => [y; distinct([z for z in ys if z != y])]
  end

function repeated[A](xs: List[A]): Option[A] :=
  match xs
    case Nil => None
    case [y; ys] => if contains(y, ys) then Some(y) else repeated(ys)
  end

function diff[A](xs: List[A], ys: List[A]): List[A] :=
  [x for x in xs if not contains(x, ys)]

function concat[A](xss: List[List[A]]): List[A] :=
  match xss
    case Nil => Nil
    case [xs; yss] => xs ++ concat(yss)
  end

function reverse_onto[A](xs: List[A], ys: List[A]): List[A] :=
  match xs
    case Nil => ys
    case [x; rest] => reverse_onto(rest, [x; ys])
  end

function reverse[A](xs: List[A]): List[A] :=
  reverse_onto(xs, Nil)

function zip[A, B](xs: List[A], ys: List[B]): List[A * B] :=
  match (xs, ys)
    case ([x; xs1], [y; ys1]) => [(x, y); zip(xs1, ys1)]
    case _ => Nil
  end

function take[A](n: Int, xs: List[A]): List[A] :=
  match xs
    case Nil => Nil
    case [y; ys] => if n == 0 then Nil else [y; take(n - 1, ys)]
  end

function drop[A](n: Int, xs: List[A]): List[A] :=
  match xs
    case Nil => Nil
    case [_; ys] => if n == 0 then xs else drop(n - 1, ys)
  end

function replicate[A](n: Int, x: A): List[A] :=
  if n == 0 then Nil else [x; replicate(n - 1, x)]

function firsts[A, B](ps: List[A * B]): List[A] :=
  match ps
    case Nil => Nil
    case [(a, _); rest] => [a; firsts(rest)]
  end

function seconds[A, B](ps: List[A * B]): List[B] :=
  match ps
    case Nil => Nil
    case [(_, b); rest] => [b; seconds(rest)]
  end

test lists() :=
  assert [1, 2] ++ [3] == [1, 2, 3] and size([1, 2, 3]) == 3
  assert get(2, [(1, "a"), (2, "b"), (2, "c")]) == Some("b") and get(3, [(1, "a")]) == None
  assert put(1, "c", [(1, "a"), (2, "b")]) == [(1, "c"), (2, "b")] and put(2, "c", [(1, "a"), (2, "b")]) == [(1, "a"), (2, "c")]
  assert put(3, "c", [(1, "a")]) == [(3, "c"), (1, "a")] and remove(1, [(1, "a"), (2, "b"), (1, "c")]) == [(2, "b")]
  assert has_key(2, [(1, "a"), (2, "b")]) and not has_key(3, [(1, "a")])
  assert keys([(1, "a"), (2, "b")]) == [1, 2] and values([(1, "a"), (2, "b")]) == ["a", "b"]
  assert contains(2, [1, 2]) and not contains(3, [1, 2])
  assert exists([1, 2], lambda x => x > 1) and not exists([1, 2], lambda x => x > 2) and not exists([], lambda x => x > 0)
  assert forall([1, 2], lambda x => x > 0) and not forall([1, 2], lambda x => x > 1) and forall([], lambda x => x > 0)
  assert foldr([1, 2, 3], Nil, Cons) == [1, 2, 3] and foldr([1, 2, 3], 0, lambda x, n => 10 * n + x) == 321
  assert foldl([1, 2, 3], Nil, lambda xs, x => [x; xs]) == [3, 2, 1] and foldl([1, 2, 3], 0, lambda n, x => 10 * n + x) == 123
  assert distinct([1, 2, 1, 3, 2]) == [1, 2, 3]
  assert repeated([1, 2, 1]) == Some(1)
  assert diff([1, 2, 3], [2]) == [1, 3]
  assert concat([[1], [], [2, 3]]) == [1, 2, 3]
  assert zip([1, 2, 3], [true, false]) == [(1, true), (2, false)]
  assert take(2, [1, 2, 3]) == [1, 2] and drop(2, [1, 2, 3]) == [3]
  assert replicate(2, 0) == [0, 0]
  assert reverse([1, 2, 3]) == [3, 2, 1] and reverse_onto([2, 1], [3]) == [1, 2, 3]
  assert firsts([(1, true), (2, false)]) == [1, 2] and seconds([(1, true), (2, false)]) == [true, false]
