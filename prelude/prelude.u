// which every module imports implicitly, before option, list, and str, which every module imports implicitly as well, each
// module of these those before it

export

// the exceptions of the builtins and of accessors of fields, which every module sees
data DivisionByZero :=
  | DivisionByZero

// an index of a string or an array with its size
data OutOfBounds :=
  | OutOfBounds(index: Int, count: Int)

data NoCharacter :=
  | NoCharacter(code: Int)

data MissingField :=
  | MissingField(field: Str)

// the order of an abstract type that declares == but not compare, and both of one that declares neither, with the name of the type
data Unordered :=
  | Unordered(sort: Str)

data Incomparable :=
  | Incomparable(sort: Str)

infix right 1 ->

infix right 2 ==>

infix left 3 or

infix left 4 and

prefix 5 not

infix 6 == != < <= > >=

infix left 7 --

infix right 8 ++

infix left 9 + -

infix left 10 * / %

prefix 11 -

function not(b: Bool): Bool
function ==>(a: Bool, b: Bool): Bool
function !=[A](x: A, y: A): Bool

// the comparisons by one < each, which follows compare, a total order
function <=[A](x: A, y: A): Bool
function >[A](x: A, y: A): Bool
function >=[A](x: A, y: A): Bool

function -(n: Int): Int

// the absolute value, and the greatest common divisor, which is 0 only for 0 and 0
function abs(n: Int): Int
function gcd(a: Int, b: Int): Int

// the components of a pair
function first[A, B](p: A * B): A
function second[A, B](p: A * B): B

// the types of literals, the arithmetic of integers, and the concatenation of strings, which the interpreter and the runtime
// define
builtin

type Bool
type Int
type Str
type Char

function +(a: Int, b: Int): Int
function -(a: Int, b: Int): Int
function *(a: Int, b: Int): Int
function /(a: Int, b: Int): Int
function %(a: Int, b: Int): Int
function ++(a: Str, b: Str): Str

implementation

function not(b: Bool): Bool :=
  if b then false else true

function ==>(a: Bool, b: Bool): Bool :=
  not a or b

function !=[A](x: A, y: A): Bool :=
  not (x == y)

function <=[A](x: A, y: A): Bool :=
  not (y < x)

function >[A](x: A, y: A): Bool :=
  y < x

function >=[A](x: A, y: A): Bool :=
  not (x < y)

function -(n: Int): Int :=
  0 - n

function abs(n: Int): Int :=
  if n < 0 then 0 - n else n

function gcd(a: Int, b: Int): Int :=
  if b == 0 then abs(a) else gcd(b, a % b)

function first[A, B](p: A * B): A :=
  let (a, _) := p in a

function second[A, B](p: A * B): B :=
  let (_, b) := p in b

test arithmetic() :=
  assert abs(-3) == 3 and abs(3) == 3 and gcd(12, -18) == 6 and gcd(0, 5) == 5 and gcd(0, 0) == 0
  assert first((1, "a")) == 1 and second((1, "a")) == "a"
