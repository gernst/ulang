// loaded before every program, whose notations apply to it

// the exceptions of the builtins and of accessors of fields, which every module sees
data DivisionByZero :=
  | DivisionByZero

data NoIndex :=
  | NoIndex(Str, Int)

data NoCharacter :=
  | NoCharacter(Int)

data MissingField :=
  | MissingField(Str)

// the order of an abstract type that declares == but not compare, and both of one that declares neither, with the name of the type
data Unordered :=
  | Unordered(Str)

data Incomparable :=
  | Incomparable(Str)

infix right 1 ->

infix right 2 ==>

infix left 3 or

infix left 4 and

prefix 5 not

infix 6 == != < <= > >=

infix right 7 ++

infix left 8 + -

infix left 9 * / %

prefix 10 -

function not(b: Bool): Bool :=
  if b then false else true

function ==>(a: Bool, b: Bool): Bool :=
  not a or b

function !=[A](x: A, y: A): Bool :=
  not (x == y)

// the comparisons by one < each, which follows compare, a total order
function <=[A](x: A, y: A): Bool :=
  not (y < x)

function >[A](x: A, y: A): Bool :=
  y < x

function >=[A](x: A, y: A): Bool :=
  not (x < y)

function -(n: Int): Int :=
  0 - n

import option

import list

import str
