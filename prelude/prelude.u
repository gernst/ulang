// which every module imports implicitly, before option, list, and str, which every module imports implicitly as well, each
// module of these those before it

export

// the exceptions of the builtins and of accessors of fields, which every module sees
data DivisionByZero :=
  | DivisionByZero

data NoIndex :=
  | NoIndex(text: Str, index: Int)

// an index of an array with the size of the array
data OutOfBounds :=
  | OutOfBounds(index: Int, count: Int)

data NoCharacter :=
  | NoCharacter(code: Int)

data MissingField :=
  | MissingField(field: Str)

// the order of an abstract type that declares == but not compare, and both of one that declares neither, with the name of the type
data Unordered :=
  | Unordered(sort: Str)

data Incomparable :=
  | Incomparable(sort: Str)

infix right 1 ->

infix right 2 ==>

infix left 3 or

infix left 4 and

prefix 5 not

infix 6 == != < <= > >=

infix left 7 --

infix right 8 ++

infix left 9 + -

infix left 10 * / %

prefix 11 -

function not(b: Bool): Bool
function ==>(a: Bool, b: Bool): Bool
function !=[A](x: A, y: A): Bool

// the comparisons by one < each, which follows compare, a total order
function <=[A](x: A, y: A): Bool
function >[A](x: A, y: A): Bool
function >=[A](x: A, y: A): Bool

function -(n: Int): Int

// the types of literals, the arithmetic of integers, and the concatenation of strings, which the interpreter and the runtime
// define
builtin

type Bool
type Int
type Str
type Char

function +(a: Int, b: Int): Int
function -(a: Int, b: Int): Int
function *(a: Int, b: Int): Int
function /(a: Int, b: Int): Int
function %(a: Int, b: Int): Int
function ++(a: Str, b: Str): Str

implementation

function not(b: Bool): Bool :=
  if b then false else true

function ==>(a: Bool, b: Bool): Bool :=
  not a or b

function !=[A](x: A, y: A): Bool :=
  not (x == y)

function <=[A](x: A, y: A): Bool :=
  not (y < x)

function >[A](x: A, y: A): Bool :=
  y < x

function >=[A](x: A, y: A): Bool :=
  not (x < y)

function -(n: Int): Int :=
  0 - n
