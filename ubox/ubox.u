import ubox.box

// a command: its arguments and its exit status
type Applet :=
  (in List[Str], out Int) raises OsError, Failure

procedure read_bytes(in path: Str, out bytes: Array[Byte]) :=
  if path == "-" then
    var input
    io_stdin(out input)
    io_read_all(in input, out bytes)
  else
    os_read_bytes(in path, out bytes)
  end

// the text of the files, where - and no file at all are the standard input
procedure read_text(in files: List[Str], out text: Str) :=
  text := ""
  for f in if files == List() then List("-") else files do
    var bytes: Array[Byte]
    read_bytes(in f, out bytes)
    match decode_utf8(bytes)
      case None =>
        raise Failure(f ++ " is not UTF-8")
      case Some(part) =>
        text := text ++ part
    end
  end

procedure emit(in ls: List[Str]) :=
  os_print(in join("", List(for l in ls yield l ++ "\n")))

procedure cmd_echo(in args: List[Str], out status: Int) :=
  match args
    case List("-n"; rest) =>
      os_print(in join(" ", rest))
    case _ =>
      os_println(in join(" ", args))
  end
  status := 0

procedure cmd_cat(in args: List[Str], out status: Int) :=
  var output
  io_stdout(out output)
  for f in if args == List() then List("-") else args do
    var bytes: Array[Byte]
    read_bytes(in f, out bytes)
    io_write_bytes(in output, bytes)
  end
  status := 0

// a command that prints f of the lines of its input
procedure filter(in args: List[Str], f: List[Str] -> List[Str], out status: Int) :=
  var text
  read_text(in args, out text)
  emit(in f(lines(text)))
  status := 0

procedure cmd_tac(in args: List[Str], out status: Int) :=
  filter(in args, lambda ls => reverse(ls), out status)

procedure cmd_rev(in args: List[Str], out status: Int) :=
  filter(in args, lambda ls => List(for l in ls yield str(reverse(chars(l)))), out status)

procedure cmd_nl(in args: List[Str], out status: Int) :=
  filter(in args, number_lines, out status)

// the number of lines of -n, 10 without it
procedure line_count(in args: List[Str], out n: Int, files: List[Str]) :=
  var o
  parse_options(in args, "", "n", out o)
  to_number(in "the count", value_or(value('n', o), "10"), out n)
  files := o.rest

procedure cmd_head(in args: List[Str], out status: Int) :=
  var n, files
  line_count(in args, out n, files)
  filter(in files, lambda ls => take(n, ls), out status)

procedure cmd_tail(in args: List[Str], out status: Int) :=
  var n, files
  line_count(in args, out n, files)
  filter(in files, lambda ls => last_lines(n, ls), out status)

// the counts as wc prints them: alone unpadded, else in columns of the width of the largest, and of 7 for the input
procedure cmd_wc(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "lwc", "", out o)
  let all := not (flag('l', o) or flag('w', o) or flag('c', o))
  let picked := lambda (l, w, c) => List(for (letter, n) in List(('l', l), ('w', w), ('c', c)) if all or flag(letter, o) yield n)
  var rows := List(), total := (0, 0, 0)
  for f in if o.rest == List() then List("") else o.rest do
    var text
    read_text(in if f == "" then List() else List(f), out text)
    let (l, w, c) := counts(text), (tl, tw, tc) := total
    rows := rows ++ List((picked((l, w, c)), f))
    total := (tl + l, tw + w, tc + c)
  end
  if size(rows) > 1 then
    rows := rows ++ List((picked(total), "total"))
  end
  let widest := size(show(foldl(picked(total), 0, max)))
  let width := if size(rows) == 1 and size(picked(total)) == 1 then
    1
  else if o.rest == List() then
    7
  else
    widest
  emit(in List(for (ns, name) in rows yield join(" ", List(for n in ns yield right(n, width)))
    ++ (if name == "" then "" else " " ++ name)))
  status := 0

procedure cmd_grep(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "ivnc", "", out o)
  match o.rest
    case List() =>
      raise Failure("usage: grep [-ivnc] TEXT [FILE...]")

    case List(needle; files) =>
      var text
      read_text(in files, out text)
      let hits := matching(needle, flag('i', o), flag('v', o), lines(text))
      if flag('c', o) then
        os_println(in show(size(hits)))
      else
        emit(in List(for (i, l) in hits yield if flag('n', o) then show(i) ++ ":" ++ l else l))
      end
      status := if hits == List() then 1 else 0
  end

procedure cmd_sort(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "rnu", "", out o)
  filter(in o.rest, lambda ls => sorted(flag('n', o), flag('r', o), flag('u', o), ls), out status)

procedure cmd_uniq(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "c", "", out o)
  filter(in o.rest, lambda ls => List(for (n, l) in runs(ls) yield if flag('c', o) then right(n, 7) ++ " " ++ l else l), out status)

procedure cmd_cut(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "", "df", out o)
  match (chars(value_or(value('d', o), "\t")), ranges(value_or(value('f', o), "")))
    case (List(d), Some(picks)) =>
      filter(in o.rest, lambda ls => List(for l in ls yield fields(d, picks, l)), out status)
    case _ =>
      raise Failure("usage: cut [-d CHAR] -f LIST [FILE...], with a list such as 1,3-5")
  end

procedure cmd_tr(in args: List[Str], out status: Int) :=
  var o, text: Str
  parse_options(in args, "d", "", out o)
  read_text(in List(), out text)
  match (flag('d', o), o.rest)
    case (true, List(set)) =>
      os_print(in delete_chars(expand_set(chars(set)), text))

    case (false, List(source, target)) if target != "" =>
      os_print(in translate(expand_set(chars(source)), expand_set(chars(target)), text))

    case _ =>
      raise Failure("usage: tr SET1 SET2 | tr -d SET")
  end
  status := 0

procedure cmd_seq(in args: List[Str], out status: Int) :=
  var ns := List()
  for a in args do
    var n
    to_number(in "the argument", a, out n)
    ns := ns ++ List(n)
  end
  match ns
    case List(last) =>
      emit(in List(for n in sequence(1, 1, last) yield show(n)))

    case List(first, last) =>
      emit(in List(for n in sequence(first, 1, last) yield show(n)))

    case List(first, step, last) =>
      emit(in List(for n in sequence(first, step, last) yield show(n)))

    case _ =>
      raise Failure("usage: seq [FIRST [STEP]] LAST")
  end
  status := 0

procedure cmd_tee(in args: List[Str], out status: Int) :=
  var text
  read_text(in List(), out text)
  for f in args do
    os_write_utf8(in f, text)
  end
  os_print(in text)
  status := 0

procedure cmd_ls(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "aF", "", out o)
  for path in if o.rest == List() then List(".") else o.rest do
    var is_dir
    os_is_dir(in path, out is_dir)
    if is_dir then
      var entries
      os_list(in path, out entries)
      emit(in List(for (name, dir) in List((".", true), ("..", true)) ++ entries if flag('a', o) or not starts_with(name, ".") yield if dir and flag('F', o) then name ++ "/" else name))
    else
      os_println(in path)
    end
  end
  status := 0

procedure cmd_find(in args: List[Str], out status: Int) :=
  for path in if args == List() then List(".") else args do
    var files
    os_walk(in path, out files)
    emit(in files)
  end
  status := 0

procedure copy(in source: Str, target: Str) :=
  var is_dir, bytes: Array[Byte]
  os_is_dir(in target, out is_dir)
  os_read_bytes(in source, out bytes)
  os_write_bytes(in if is_dir then os_join(target, os_basename(source)) else target, bytes)

procedure cmd_cp(in args: List[Str], out status: Int) :=
  match args
    case List(source, target) =>
      copy(in source, target)
    case _ =>
      raise Failure("usage: cp SOURCE TARGET")
  end
  status := 0

procedure cmd_mv(in args: List[Str], out status: Int) :=
  match args
    case List(source, target) =>
      copy(in source, target)
      os_remove(in source)

    case _ =>
      raise Failure("usage: mv SOURCE TARGET")
  end
  status := 0

procedure cmd_rm(in args: List[Str], out status: Int) :=
  var o
  parse_options(in args, "rf", "", out o)
  for path in o.rest do
    var is_dir
    os_is_dir(in path, out is_dir)
    if is_dir and not flag('r', o) then
      raise Failure(path ++ " is a directory, which takes -r")
    end
    try
      if is_dir then
        os_remove_all(in path)
      else
        os_remove(in path)
      end
    catch
      case OsError(message) =>
        if not flag('f', o) then
          raise OsError(message)
        end
    end
  end
  status := 0

procedure cmd_basename(in args: List[Str], out status: Int) :=
  emit(in List(for a in args yield os_basename(a)))
  status := 0

procedure cmd_dirname(in args: List[Str], out status: Int) :=
  emit(in List(for a in args yield os_dirname(a)))
  status := 0

procedure cmd_pwd(in args: List[Str], out status: Int) :=
  var dir
  os_cwd(out dir)
  os_println(in dir)
  status := 0

procedure cmd_printenv(in args: List[Str], out status: Int) :=
  status := 0
  for name in args do
    var value
    os_env(in name, out value)
    match value
      case None =>
        status := 1
      case Some(v) =>
        os_println(in v)
    end
  end

procedure cmd_date(in args: List[Str], out status: Int) :=
  var now
  os_time(out now)
  os_println(in utc_date(now))
  status := 0

procedure cmd_base64(in args: List[Str], out status: Int) :=
  var o, bytes: Array[Byte], width: Int
  parse_options(in args, "d", "w", out o)
  to_number(in "the width", value_or(value('w', o), "76"), out width)
  match o.rest
    case List() =>
      read_bytes(in "-", out bytes)

    case List(f) =>
      read_bytes(in f, out bytes)

    case _ =>
      raise Failure("usage: base64 [-d] [-w COLUMNS] [FILE]")
  end
  if flag('d', o) then
    match decode64(value_or(decode_utf8(bytes), "?"))
      case None =>
        raise Failure("the input is not base64")

      case Some(ns) =>
        var output
        io_stdout(out output)
        io_write_bytes(in output, Array(for n in ns yield byte(n)))
    end
  else
    if width == 0 then
      os_print(in encode64(List(for b in bytes yield int(b))))
    else
      emit(in wrapped(encode64(List(for b in bytes yield int(b))), width))
    end
  end
  status := 0

procedure cmd_factor(in args: List[Str], out status: Int) :=
  for a in args do
    var n
    to_number(in "the argument", a, out n)
    os_println(in join(" ", List(a ++ ":"; List(for p in factors(n) yield show(p)))))
  end
  status := 0

procedure cmd_true(in args: List[Str], out status: Int) :=
  status := 0

procedure cmd_false(in args: List[Str], out status: Int) :=
  status := 1

function applets(): List[(Str, Str, Applet)] :=
  List(
    ("base64", "[-d] [-w COLUMNS] [FILE]", cmd_base64),
    ("basename", "PATH...", cmd_basename),
    ("cat", "[FILE...]", cmd_cat),
    ("cp", "SOURCE TARGET", cmd_cp),
    ("cut", "[-d CHAR] -f LIST [FILE...]", cmd_cut),
    ("date", "", cmd_date),
    ("dirname", "PATH...", cmd_dirname),
    ("echo", "[-n] [TEXT...]", cmd_echo),
    ("factor", "NUMBER...", cmd_factor),
    ("false", "", cmd_false),
    ("find", "[PATH...]", cmd_find),
    ("grep", "[-ivnc] TEXT [FILE...]", cmd_grep),
    ("head", "[-n COUNT] [FILE...]", cmd_head),
    ("ls", "[-aF] [PATH...]", cmd_ls),
    ("mv", "SOURCE TARGET", cmd_mv),
    ("nl", "[FILE...]", cmd_nl),
    ("printenv", "NAME...", cmd_printenv),
    ("pwd", "", cmd_pwd),
    ("rev", "[FILE...]", cmd_rev),
    ("rm", "[-rf] PATH...", cmd_rm),
    ("seq", "[FIRST [STEP]] LAST", cmd_seq),
    ("sort", "[-rnu] [FILE...]", cmd_sort),
    ("tac", "[FILE...]", cmd_tac),
    ("tail", "[-n COUNT] [FILE...]", cmd_tail),
    ("tee", "FILE...", cmd_tee),
    ("tr", "SET1 SET2 | -d SET", cmd_tr),
    ("true", "", cmd_true),
    ("uniq", "[-c] [FILE...]", cmd_uniq),
    ("wc", "[-lwc] [FILE...]", cmd_wc))

procedure help() :=
  os_println(in "usage: ubox COMMAND [ARGUMENT...], with the commands")
  emit(in List(for (name, usage, _) in applets() yield "  " ++ name ++ " " ++ usage))

procedure main() :=
  var status := 0
  try
    var args
    os_args(out args)
    match args
      case List() | List("help") | List("--help") =>
        help()

      case List(name; rest) =>
        match find(applets(), lambda (n, _, _) => n == name)
          case None =>
            raise Failure("no command " ++ name ++ ", see ubox help")
          case Some((_, _, run)) =>
            run(in rest, out status)
        end
    end
  catch
    case OsError(message) =>
      os_print_error(in "ubox: " ++ message)
      status := 2

    case Failure(message) =>
      os_print_error(in "ubox: " ++ message)
      status := 2
  end
  os_exit(in status)

test table() :=
  let names := firsts(List(for (name, usage, _) in applets() yield (name, usage)))
  assert names == sort(names) and distinct(names) == names
