export

// the last n elements
function last_lines(n: Int, ls: List[Str]): List[Str] :=
  example last_lines(2, List("a", "b", "c")) == List("b", "c")
  example last_lines(5, List("a")) == List("a")

// n at the right of a column of that width
function right(n: Int, width: Int): Str :=
  example right(42, 6) == "    42"

function number_lines(ls: List[Str]): List[Str] :=
  example number_lines(List("a", "b")) == List("     1\ta", "     2\tb")

// the lines that contain the needle, or with invert those that do not, each with its number from 1
function matching(needle: Str, ignore_case: Bool, invert: Bool, ls: List[Str]): List[(Int, Str)] :=
  example matching("B", true, false, List("abc", "xyz", "b")) == List((1, "abc"), (3, "b"))
  example matching("b", false, true, List("abc", "xyz")) == List((2, "xyz"))

// in the order of the texts, or of the numbers that the lines start with
function sorted(numeric: Bool, descending: Bool, unique: Bool, ls: List[Str]): List[Str] :=
  example sorted(false, false, false, List("10", "9", "9")) == List("10", "9", "9")
  example sorted(true, true, true, List("10", "9", "9")) == List("10", "9")

// the runs of equal lines, each with its length
function runs(ls: List[Str]): List[(Int, Str)] :=
  example runs(List("a", "a", "b", "a")) == List((2, "a"), (1, "b"), (1, "a"))

// the ranges of a list such as 1,3-5,7-, from 1
function ranges(spec: Str): Option[List[(Int, Int)]] :=
  example ranges("1,3-5") == Some(List((1, 1), (3, 5)))
  example ranges("-2") == Some(List((1, 2)))
  example ranges("x") == None

// the fields of the line in the ranges, and the line itself if it has no delimiter
function fields(delimiter: Char, picks: List[(Int, Int)], line: Str): Str :=
  example fields(':', List((1, 1), (3, 4)), "a:b:c:d:e") == "a:c:d"
  example fields(':', List((2, 2)), "plain") == "plain"

// the characters of a set of tr, with its ranges a-z and its escapes \n, \t, and \\
function expand_set(cs: List[Char]): List[Char] :=
  example str(expand_set(chars("a-dx"))) == "abcdx"
  example expand_set(chars("\\n-")) == List('\n', '-')

// each character of source as the one at its place in target, or as the last of target
function translate(source: List[Char], target: List[Char], text: Str): Str :=
  example translate(chars("abc"), chars("xy"), "aabbcc d") == "xxyyyy d"

function delete_chars(set: List[Char], text: Str): Str :=
  example delete_chars(chars("lo"), "hello world") == "he wrd"

function words(s: Str): List[Str] :=
  example words(" a  b\tc\n") == List("a", "b", "c")

// the numbers of lines, words, and bytes
function counts(text: Str): (Int, Int, Int) :=
  example counts("a b\nä\n") == (2, 3, 7)

implementation

function last_lines(n: Int, ls: List[Str]): List[Str] :=
  drop(max(0, size(ls) - n), ls)

function right(n: Int, width: Int): Str :=
  let digits := show(n) in
  repeat(" ", width - size(digits)) ++ digits

function number_lines(ls: List[Str]): List[Str] :=
  List(for (i, l) in zip(range(1, size(ls) + 1), ls) yield right(i, 6) ++ "\t" ++ l)

function matching(needle: Str, ignore_case: Bool, invert: Bool, ls: List[Str]): List[(Int, Str)] :=
  let fold := (lambda s => if ignore_case then lower(s) else s), hit := lambda l => index_of(fold(needle), fold(l)) != None in
  List(for (i, l) in zip(range(1, size(ls) + 1), ls) if hit(l) != invert yield (i, l))

function leading_number(l: Str): Int :=
  let t := trim(l), k := run_end(t, 0, lambda c => c == '-'), j := run_end(t, k, is_digit) in
  value_or(number((if k > 0 then "-" else "") ++ slice(t, k, j)), 0)

function sorted(numeric: Bool, descending: Bool, unique: Bool, ls: List[Str]): List[Str] :=
  let up := (if numeric then
    seconds(sort(List(for l in ls yield (leading_number(l), l))))
  else
    sort(ls)), one := if unique then List(for (_, l) in runs(up) yield l) else up in
  if descending then reverse(one) else one

function runs(ls: List[Str]): List[(Int, Str)] :=
  match ls
    case List() =>
      List()

    case List(l; rest) =>
      let (same, others) := span(rest, lambda x => x == l) in
      List((size(same) + 1, l); runs(others))
  end

function range_of(part: Str): Option[(Int, Int)] :=
  match split(part, '-')
    case List(a) =>
      map_option(number(a), lambda n => (n, n))

    case List("", b) =>
      map_option(number(b), lambda n => (1, n))

    case List(a, "") =>
      map_option(number(a), lambda n => (n, 1000000000))

    case List(a, b) =>
      match (number(a), number(b))
        case (Some(m), Some(n)) =>
          Some((m, n))
        case _ =>
          None
      end

    case _ =>
      None
  end

function ranges(spec: Str): Option[List[(Int, Int)]] :=
  let rs := List(for p in split(spec, ',') yield range_of(p)) in
  if contains(None, rs) then
    None
  else
    Some(List(for r in rs for x in r yield x))

function fields(delimiter: Char, picks: List[(Int, Int)], line: Str): Str :=
  let parts := split(line, delimiter), picked := lambda i => exists(picks, lambda (a, b) => a <= i and i <= b) in
  if size(parts) < 2 then
    line
  else
    join(str(List(delimiter)), List(for (i, p) in zip(range(1, size(parts) + 1), parts) if picked(i) yield p))

function expand_set(cs: List[Char]): List[Char] :=
  match cs
    case List() =>
      List()

    case List('\\', 'n'; rest) =>
      List('\n'; expand_set(rest))

    case List('\\', 't'; rest) =>
      List('\t'; expand_set(rest))

    case List('\\', c; rest) =>
      List(c; expand_set(rest))

    case List(a, '-', b; rest) if int(a) <= int(b) =>
      List(for n in range(int(a), int(b) + 1) yield chr(n)) ++ expand_set(rest)

    case List(c; rest) =>
      List(c; expand_set(rest))
  end

function translated(c: Char, source: List[Char], target: List[Char]): Char :=
  match index_of(c, source)
    case None =>
      c
    case Some(i) =>
      at(min(i, size(target) - 1), target)
  end

function translate(source: List[Char], target: List[Char], text: Str): Str :=
  str(List(for c in text yield translated(c, source, target)))

function delete_chars(set: List[Char], text: Str): Str :=
  str(List(for c in text if not contains(c, set) yield c))

function words(s: Str): List[Str] :=
  List(for w in split(str(List(for c in s yield if is_space(c) then ' ' else c)), ' ') if w != "" yield w)

function counts(text: Str): (Int, Int, Int) :=
  let (newlines, starts) := scanned(text, 0, 0, 0, false) in
  (newlines, starts, size(encode_utf8(text)))

test sort_is_stable_under_repeat(ls: List[Str]) :=
  assert sorted(false, false, false, sorted(false, false, false, ls)) == sorted(false, false, false, ls)

test runs_keep_the_lines(ls: List[Str]) :=
  assert concat(List(for (n, l) in runs(ls) yield replicate(n, l))) == ls

// the lines and the words of text from index i on, added to those so far, where inside tells whether a word is open
function scanned(text: Str, i: Int, newlines: Int, starts: Int, inside: Bool): (Int, Int) :=
  if i == size(text) then
    (newlines, starts)
  else
    let c := at(i, text), space := is_space(c) in
    scanned(text, i + 1, if c == '\n' then newlines + 1 else newlines, if space or inside then starts else starts + 1, not space)

test counts_as_by_lists(text: Str) :=
  let (l, w, _) := counts(text)
  assert l == size(List(for c in text if c == '\n' yield c)) and w == size(words(text))

// the end of the run of characters from index i on of which p holds
function run_end(s: Str, i: Int, p: Char -> Bool): Int :=
  if i < size(s) and p(at(i, s)) then run_end(s, i + 1, p) else i

test leading_number_as_by_lists(l: Str) :=
  let cs := chars(trim(l)), sign := take_while(cs, lambda c => c == '-'), digits := take_while(drop(size(sign), cs), is_digit)
  assert leading_number(l) == value_or(number(str(take(1, sign) ++ digits)), 0)
  assert leading_number(" --42x") == -42 and leading_number("7") == 7 and leading_number("-") == 0
