// md2html: converts a Markdown file to HTML, printed or written to a file, as a whole page with --standalone
//
//   out/ulang.sh run examples/md2html.u -- [--standalone] input.md [output.html]
//
// the command line of the package library/md

import "library/md"

procedure main() :=
  var ok := true
  try
    var args: List[Str], standalone: Bool, rest: List[Str]
    os_args(out args)
    standalone := contains("--standalone", args), rest := remove("--standalone", args)
    match rest
      case List(input) =>
        var text: Str
        os_read_utf8(in input, out text)
        os_print(in page(text, standalone))

      case List(input, output) =>
        var text: Str
        os_read_utf8(in input, out text)
        os_write_utf8(in output, page(text, standalone))

      case _ =>
        raise OsError("usage: md2html [--standalone] input.md [output.html]")
    end
  catch
    case OsError(message) =>
      os_print_error(in message)
      ok := false
  end
  if not ok then
    os_exit(in 1)
  end

function page(text: Str, standalone: Bool): Str :=
  if standalone then
    "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>" ++ escape_html(value_or(title_of(text), "")) ++ "</title>\n</head>\n<body>\n" ++ to_html(text) ++ "</body>\n</html>\n"
  else
    to_html(text)
