// jq: prints the results of a query on a JSON file, indented, or compactly with -c
//
//   out/ulang.sh run examples/jq.u -- [-c] query file
//
// the command line of the package library/json

import "library/json"

procedure main() :=
  var ok := true
  try
    var args: List[Str], compact: Bool, rest: List[Str]
    os_args(out args)
    compact := contains("-c", args), rest := remove("-c", args)
    match rest
      case List(text, path) =>
        var q: Query, source: Str, j: Json, results: List[Json]
        parse_query(in text, out q)
        os_read_utf8(in path, out source)
        try
          parse_json(in source, out j)
        catch
          case JsonError(message, line, column) =>
            raise OsError(path ++ ":" ++ show(line) ++ ":" ++ show(column) ++ ": " ++ message)
        end
        run_query(in q, j, out results)
        for r in results do
          os_println(in if compact then show(r) else pretty(r))
        end

      case _ =>
        raise OsError("usage: jq [-c] query file")
    end
  catch
    case OsError(message) =>
      os_print_error(in message)
      ok := false

    case QueryError(message) =>
      os_print_error(in "query: " ++ message)
      ok := false
  end
  if not ok then
    os_exit(in 1)
  end
