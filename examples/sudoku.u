// sudoku: a solver by constraint propagation and search, where a wrong guess is undone by raising Contradiction alone,
// since the handler of a try sees the variables as they were before it, so that the search keeps no copies and no undo
//
//   out/ulang.bin run examples/sudoku.u -- [file]
//
// solves the puzzles of the file, or else an example, where a puzzle is 81 cells, row by row, each a digit, or . or 0
// for an empty cell, and other characters are ignored, so that puzzles may be written one per line or as grids

type Cell :=
  Int * Int

// the digits that each cell may still hold
type Grid :=
  Map[Cell, Set[Int]]

data Contradiction :=
  case Contradiction

data BadPuzzle :=
  case BadPuzzle(count: Int)

function digits(): Set[Int] :=
  Set(for d in range(1, 10))

// the cells as (row, column), row by row
function cells(): List[Cell] :=
  List(for row in range(0, 9) for col in range(0, 9) yield (row, col))

// whether two distinct cells share a row, a column, or a box
function sees(a: Cell, b: Cell): Bool :=
  match (a, b)
    case ((r, c), (s, d)) =>
      a != b and (r == s or c == d or r / 3 == s / 3 and c / 3 == d / 3)
  end

// the peers of each cell, computed once, since the function has no formals
function peers(): Map[Cell, Set[Cell]] :=
  Map(for cell in cells() yield cell => Set(for other in cells() if sees(cell, other)))

function peers_of(cell: Cell): List[Cell] :=
  match get(cell, peers())
    case Some(others) =>
      List(for other in others)
    case None =>
      List()
  end

function candidates(cell: Cell, grid: Grid): Set[Int] :=
  match get(cell, grid)
    case Some(ds) =>
      ds
    case None =>
      Set()
  end

// removes d from the candidates of cell, where a cell left without candidates is a contradiction, and a cell left with
// one removes that one from its peers in turn
procedure eliminate(in cell: Cell, d: Int, ref grid: Grid) :=
  local ds := candidates(cell, grid)
  if contains(d, ds) then
    assign ds := remove(d, ds)
    assign grid := put(cell, ds, grid)
    match List(for e in ds)
      case List() =>
        raise Contradiction

      case List(e) =>
        call eliminate_all(in peers_of(cell), e, ref grid)

      case _ =>
        skip
    end
  end

procedure eliminate_all(in others: List[Cell], d: Int, ref grid: Grid) :=
  match others
    case List() =>
      skip

    case List(other; rest) =>
      call eliminate(in other, d, ref grid)
      call eliminate_all(in rest, d, ref grid)
  end

// fixes cell to d, which must be one of its candidates, and removes d from its peers
procedure place(in cell: Cell, d: Int, ref grid: Grid) :=
  if contains(d, candidates(cell, grid)) then
    assign grid := put(cell, Set(d), grid)
    call   eliminate_all(in peers_of(cell), d, ref grid)
  else
    raise Contradiction
  end

// the cells with several candidates, by their number of candidates, ascending
function open_cells(grid: Grid): Set[Int * Cell] :=
  Set(for cell => ds in grid if size(ds) > 1 yield (size(ds), cell))

// the open cell with the fewest candidates, or None if every cell has one, which means that grid is solved
function open_cell(grid: Grid): Option[Cell] :=
  match List(for p in open_cells(grid))
    case List() =>
      None
    case List((_, cell); _) =>
      Some(cell)
  end

// solves grid by guessing each candidate of the open cell with the fewest, or raises Contradiction if none leads to a
// solution
procedure search(ref grid: Grid) :=
  match open_cell(grid)
    case None =>
      skip
    case Some(cell) =>
      call guess(in cell, List(for d in candidates(cell, grid)), ref grid)
  end

// tries the digits ds for cell in turn, where the handler sees grid as it was before the guess, so that the raise of a
// guess that leads to a contradiction undoes all that place and search have assigned since
procedure guess(in cell: Cell, ds: List[Int], ref grid: Grid) :=
  match ds
    case List() =>
      raise Contradiction

    case List(d; rest) =>
      try
        call place(in cell, d, ref grid)
        call search(ref grid)
      catch
        case Contradiction =>
          call guess(in cell, rest, ref grid)
      end
  end

// the grid of the givens, 0 for an empty cell, with every given placed, which raises Contradiction if they conflict
procedure start(in givens: List[Int], out grid: Grid) :=
  assign grid := Map(for cell in cells() yield cell => digits())
  call   place_all(in zip(cells(), givens), ref grid)

procedure place_all(in givens: List[Cell * Int], ref grid: Grid) :=
  match givens
    case List() =>
      skip

    case List((cell, d); rest) =>
      if d != 0 then
        call place(in cell, d, ref grid)
      end
      call place_all(in rest, ref grid)
  end

procedure solve(in givens: List[Int], out grid: Grid) :=
  call start(in givens, out grid)
  call search(ref grid)

// the cells of the rows, the columns, and the boxes
function units(): List[List[Cell]] :=
  List(for row in range(0, 9) yield List(for col in range(0, 9) yield (row, col))) ++ List(for col in range(0, 9) yield List(for row in range(0, 9) yield (row, col))) ++ List(for box in range(0, 9) yield List(for i in range(0, 9) yield (3 * (box / 3) + i / 3, 3 * (box % 3) + i % 3)))

// whether every cell has one candidate and every unit holds all digits
function solved(grid: Grid): Bool :=
  forall(cells(), lambda cell => size(candidates(cell, grid)) == 1) and forall(units(), lambda unit => unit_digits(unit, grid) == digits())

function unit_digits(unit: List[Cell], grid: Grid): Set[Int] :=
  Set(for cell in unit for d in candidates(cell, grid) yield d)

// whether grid keeps the givens
function agrees(givens: List[Int], grid: Grid): Bool :=
  forall(zip(cells(), givens), lambda (cell, d) => d == 0 or candidates(cell, grid) == Set(d))

function digit(c: Char): Int :=
  if c == '.' then 0 else ord(c) - ord('0')

// the puzzles of text, each of 81 cells, from the digits and dots of text
function puzzles(text: Str): List[List[Int]] :=
  let cs := List(for i in range(0, size(text)) yield at(i, text)) in
  chunks(List(for c in cs if is_digit(c) or c == '.' yield digit(c)))

function chunks(ds: List[Int]): List[List[Int]] :=
  match ds
    case List() =>
      List()

    case _ =>
      if size(ds) < 81 then
        raise BadPuzzle(size(ds))
      else
        List(take(81, ds); chunks(drop(81, ds)))
  end

// the digit of a cell, or . if it is still open
function format_cell(cell: Cell, grid: Grid): Str :=
  match List(for d in candidates(cell, grid))
    case List(d) =>
      show(d)
    case _ =>
      "."
  end

function format_row(row: Int, grid: Grid): Str :=
  join(" | ", List(for box in range(0, 3) yield join(" ", List(for col in range(3 * box, 3 * box + 3) yield format_cell((row, col), grid)))))

// the grid in rows of digits, with lines between the boxes
function format_grid(grid: Grid): Str :=
  join("\n------+-------+------\n", List(for band in range(0, 3) yield join("\n", List(for row in range(3 * band, 3 * band + 3) yield format_row(row, grid)))))

procedure solve_all(in pending: List[List[Int]]) :=
  match pending
    case List() =>
      skip

    case List(givens; rest) =>
      local grid: Grid
      try
        call solve(in givens, out grid)
        call os_println(in format_grid(grid) ++ "\n\n")
      catch
        case Contradiction =>
          call os_println(in "no solution\n\n")
      end
      call solve_all(in rest)
  end

// a puzzle that needs little search
function easy(): Str :=
  join("\n", List(
    "..3.2.6..",
    "9..3.5..1",
    "..18.64..",
    "..81.29..",
    "7.......8",
    "..67.82..",
    "..26.95..",
    "8..2.3..9",
    "..5.1.3.."))

// a puzzle that needs much search, by Arto Inkala
function hard(): Str :=
  join("\n", List(
    "8........",
    "..36.....",
    ".7..9.2..",
    ".5...7...",
    "....457..",
    "...1...3.",
    "..1....68",
    "..85...1.",
    ".9....4.."))

procedure main() :=
  local args: List[Str], text := hard()
  call os_args(out args)
  try
    match args
      case List() =>
        skip
      case List(path; _) =>
        call os_read(in path, out text)
    end
    call solve_all(in puzzles(text))
  catch
    case OsError(message) =>
      call os_print_error(in message ++ "\n")
      call os_exit(in 1)

    case BadPuzzle(count) =>
      call os_print_error(in "a puzzle has " ++ show(count) ++ " cells instead of 81\n")
      call os_exit(in 1)
  end

// the first puzzle of text
function puzzle(text: Str): List[Int] :=
  match puzzles(text)
    case List(givens; _) =>
      givens
    case List() =>
      raise BadPuzzle(0)
  end

// the least of a set of digits, which is the first of its ascending fold
function least(ds: Set[Int]): Int :=
  foldr(ds, 0, lambda d, acc => d)

test easy_puzzle() :=
  local grid: Grid
  call solve(in puzzle(easy()), out grid)
  assert solved(grid) and agrees(puzzle(easy()), grid)

test hard_puzzle() :=
  local grid: Grid
  call solve(in puzzle(hard()), out grid)
  assert solved(grid) and agrees(puzzle(hard()), grid)

// two 5s in the first row
test conflicting_givens() :=
  local grid: Grid, failed := false
  try
    call solve(in puzzle("55" ++ slice(easy(), 2, size(easy()))), out grid)
  catch
    case Contradiction =>
      assign failed := true
  end
  assert failed

// a raise undoes the effects of the procedures called in the try, without any code to undo them
test undone_by_raise() :=
  local grid: Grid, before: Grid
  call   start(in puzzle(hard()), out grid)
  assign before := grid
  match open_cell(grid)
    case Some(cell) =>
      try
        call place(in cell, least(candidates(cell, grid)), ref grid)
        assert grid != before
        raise Contradiction
      catch
        case Contradiction =>
          skip
      end

    case None =>
      assert false
  end
  assert grid == before
