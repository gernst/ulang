// recursive descent with procedures, which consume the tokens of their in/out parameter ts,
// and report whether they succeeded in their output ok

data Token :=
  | Num(Int)
  | Sym(Str)

procedure accept(in s: Str, out ok: Bool, ref ts: List[Token]) :=
  match ts
    case [Sym(t); us] =>
      if t == s
        assign ok := true, ts := us
      else
        assign ok := false
      end
    else
      assign ok := false
  end

procedure number(out n: Int, ok: Bool, ref ts: List[Token]) :=
  match ts
    case [Num(m); us] =>
      assign n := m, ok := true, ts := us
    else
      assign n := 0, ok := false
  end

// one of the operators + and -
procedure additive(out o: Str, ok: Bool, ref ts: List[Token]) :=
  match ts
    case [Sym(s); us] =>
      if s == "+" or s == "-"
        assign o := s, ok := true, ts := us
      else
        assign o := "", ok := false
      end
    else
      assign o := "", ok := false
  end

procedure expr(out n: Int, ok: Bool, ref ts: List[Token]) :=
  local  m: Int, o: Str, more: Bool
  call   term(out n, ok, ref ts)
  assign more := ok

  while more
    call additive(out o, more, ref ts)
    if more
      call term(out m, ok, ref ts)
      if o == "+"
        assign n := n + m
      else
        assign n := n - m
      end
      assign more := ok
    end
  end

procedure term(out n: Int, ok: Bool, ref ts: List[Token]) :=
  local  m: Int, more: Bool
  call   factor(out n, ok, ref ts)
  assign more := ok

  while more
    call accept(in "*", out more, ref ts)
    if more
      call   factor(out m, ok, ref ts)
      assign n := n * m, more := ok
    end
  end

procedure factor(out n: Int, ok: Bool, ref ts: List[Token]) :=
  call number(out n, ok, ref ts)
  if not ok
    call accept(in "(", out ok, ref ts)
    if ok
      call expr(out n, ok, ref ts)
      if ok
        call accept(in ")", out ok, ref ts)
      end
    end
  end

// all of ts must be consumed
procedure parse(in ts: List[Token], out n: Int, ok: Bool) :=
  local  rest: List[Token]
  assign rest := ts
  call   expr(out n, ok, ref rest)
  assign ok := ok and rest == Nil

test arithmetic :=
  local  n: Int, ok: Bool
  // 1 + 2 * (3 - 1)
  call   parse(in [Num(1), Sym("+"), Num(2), Sym("*"), Sym("("), Num(3), Sym("-"), Num(1), Sym(")")], out n, ok)
  assert ok and n == 5
  // 10 - 3 - 2, to the left
  call   parse(in [Num(10), Sym("-"), Num(3), Sym("-"), Num(2)], out n, ok)
  assert ok and n == 5
  call   parse(in [Num(1), Sym("+")], out n, ok)
  assert not ok
  call   parse(in [Sym("("), Num(1)], out n, ok)
  assert not ok

run example :=
  local  n: Int, ok: Bool
  call   parse(in [Num(2), Sym("*"), Num(3), Sym("+"), Num(4)], out n, ok)
