// words: the ten most frequent words of the files given as arguments, where a file that cannot be read is reported
// and skipped
//
//   out/ulang.sh run examples/words.u -- file …

// the words of a text, lower-cased runs of letters
function words(text: Str): List[Str] :=
  List(for w in split(str(List(for c in chars(text) yield if is_letter(c) then lower(c) else ' ')), ' ') if w != "")

function lower(c: Char): Char :=
  if 'A' <= c and c <= 'Z' then chr(int(c) + 32) else c

// adds the words to the counts in m
procedure count(in ws: List[Str], ref m: Map[Str, Int]) :=
  for w in ws do
    m := put(w, value_or(get(w, m), 0) + 1, m)
  end

// the n most frequent words, ties in alphabetical order
function top(n: Int, m: Map[Str, Int]): List[Str * Int] :=
  take(n, List(for (c, w) in sort(List(for w => c in m yield (-c, w))) yield (w, -c)))

procedure main() :=
  var args: List[Str], m := Map()
  os_args(out args)
  for path in args do
    try
      var text: Str
      os_read_utf8(in path, out text)
      count(in words(text), ref m)
    catch
      case OsError(message) =>
        os_print_error(in message)
    end
  end
  for (w, c) in top(10, m) do
    os_println(in show(c) ++ " " ++ w)
  end

test counting() :=
  var m := Map()
  count(in words("The cat saw the other cat. THE end."), ref m)
  assert top(2, m) == List(("the", 3), ("cat", 2))
