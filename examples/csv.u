// csv: the relational algebra on CSV files, one operation per command line, which prints the resulting table as CSV
//
//   out/ulang.sh run examples/csv.u -- join <file> …
//   out/ulang.sh run examples/csv.u -- project <col> … <file>
//   out/ulang.sh run examples/csv.u -- rename <old> <new> <file>
//   out/ulang.sh run examples/csv.u -- select <col> <value> <file>
//   out/ulang.sh run examples/csv.u -- union <file> <file>
//   out/ulang.sh run examples/csv.u -- diff <file> <file>
//   out/ulang.sh run examples/csv.u -- count <col> <file>
//
// the command line of the package library/csv

import "library/csv"

function usage(): Str :=
  "usage: csv " ++ join(" | ", List(
    "join <file> …",
    "project <col> … <file>",
    "rename <old> <new> <file>",
    "select <col> <value> <file>",
    "union <file> <file>",
    "diff <file> <file>",
    "count <col> <file>"))

procedure query(in args: List[Str], out result: Table) :=
  match args
    case List("join", path; paths) =>
      read_table(in path, out result)
      for other in paths do
        var table: Table
        read_table(in other, out table)
        result := join(result, table)
      end

    case List("project"; rest) if size(rest) >= 2 =>
      var table: Table
      let cols: List[Str] := take(size(rest) - 1, rest)
      read_table(in at(size(rest) - 1, from_list(rest)), out table)
      require_columns(in cols, table)
      result := project(cols, table)

    case List("rename", old, new, path) =>
      var table: Table
      read_table(in path, out table)
      require_columns(in List(old), table)
      if contains(new, table.columns) then
        raise CsvError("column " ++ new ++ " exists")
      end
      result := rename(old, new, table)

    case List("select", col, value, path) =>
      var table: Table
      read_table(in path, out table)
      require_columns(in List(col), table)
      result := select(col, value, table)

    case List("union", path, other) =>
      var a: Table, b: Table
      read_table(in path, out a)
      read_table(in other, out b)
      require_same_columns(in a, b)
      result := union(a, b)

    case List("diff", path, other) =>
      var a: Table, b: Table
      read_table(in path, out a)
      read_table(in other, out b)
      require_same_columns(in a, b)
      result := diff(a, b)

    case List("count", col, path) =>
      var table: Table
      read_table(in path, out table)
      require_columns(in List(col), table)
      if col == "count" then
        raise CsvError("column count is the result")
      end
      result := count(col, table)

    case _ =>
      raise CsvError(usage())
  end

procedure main() :=
  var args: List[Str]
  os_args(out args)
  try
    var result: Table
    query(in args, out result)
    os_print(in format_table(result))
  catch
    case CsvError(message) =>
      os_print_error(in "csv: " ++ message)
      os_exit(in 1)

    case OsError(message) =>
      os_print_error(in "csv: " ++ message)
      os_exit(in 1)
  end
