// parser combinators over lists of tokens of any type T, and arithmetic expressions as an example

sort Parser[T, A] :=
  | List[T] -> Option[A * List[T]]

infix left 3 <|>

infix left 4 >>=

function succeed[T, A](a: A): Parser[T, A] :=
  lambda ts => Some((a, ts))

function satisfy[T](p: T -> Bool): Parser[T, T] :=
  lambda ts =>
    match ts
      case t :: us => if p(t) then Some((t, us)) else None
      case Nil => None
    end

// sequencing, where f gets the result of p
function >>=[T, A, B](p: Parser[T, A], f: A -> Parser[T, B]): Parser[T, B] :=
  lambda ts =>
    match p(ts)
      case Some((a, us)) => f(a)(us)
      case None => None
    end

// alternatives, where q is tried if p fails
function <|>[T, A](p: Parser[T, A], q: Parser[T, A]): Parser[T, A] :=
  lambda ts =>
    match p(ts)
      case Some(r) => Some(r)
      case None => q(ts)
    end

function many[T, A](p: Parser[T, A]): Parser[T, List[A]] :=
  (p >>= lambda a => many(p) >>= lambda as => succeed(a :: as)) <|> succeed([])

// p, separated by operators o, which are applied to the left
function chain[T, A](p: Parser[T, A], o: Parser[T, (A, A) -> A]): Parser[T, A] :=
  p >>= lambda a => rest(p, o, a)

function rest[T, A](p: Parser[T, A], o: Parser[T, (A, A) -> A], a: A): Parser[T, A] :=
  (o >>= lambda f => p >>= lambda b => rest(p, o, f(a, b))) <|> succeed(a)

// the result of p for all of ts
function parse[T, A](p: Parser[T, A], ts: List[T]): Option[A] :=
  match p(ts)
    case Some((a, Nil)) => Some(a)
    else None
  end

data Token :=
  | Num(Int)
  | Sym(Str)

function symbol(s: Str): Parser[Token, Token] :=
  satisfy(lambda t => t == Sym(s))

function number(ts: List[Token]): Option[Int * List[Token]] :=
  match ts
    case Num(n) :: us => Some((n, us))
    else None
  end

function op(s: Str, f: (Int, Int) -> Int): Parser[Token, (Int, Int) -> Int] :=
  symbol(s) >>= lambda t => succeed(f)

// the nonterminals are functions on tokens, so that they can be recursive
function expr(ts: List[Token]): Option[Int * List[Token]] :=
  chain(term, op("+", lambda a, b => a + b) <|> op("-", lambda a, b => a - b))(ts)

function term(ts: List[Token]): Option[Int * List[Token]] :=
  chain(factor, op("*", lambda a, b => a * b))(ts)

function factor(ts: List[Token]): Option[Int * List[Token]] :=
  (number <|> (symbol("(") >>= lambda l => expr >>= lambda n => symbol(")") >>= lambda r => succeed(n)))(ts)

test arithmetic :=
  // 1 + 2 * (3 - 1)
  assert parse(expr, [Num(1), Sym("+"), Num(2), Sym("*"), Sym("("), Num(3), Sym("-"), Num(1), Sym(")")]) == Some(5)
  // 10 - 3 - 2, to the left
  assert parse(expr, [Num(10), Sym("-"), Num(3), Sym("-"), Num(2)]) == Some(5)
  assert parse(expr, [Num(1), Sym("+")]) == None
  assert parse(expr, [Sym("("), Num(1)]) == None
  assert parse(many(symbol("x")), [Sym("x"), Sym("x")]) == Some([Sym("x"), Sym("x")])

eval parse(expr, [Num(2), Sym("*"), Num(3), Sym("+"), Num(4)])
