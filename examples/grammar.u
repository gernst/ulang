// a grammar as data, over tokens of type T, whose nonterminals all produce values of type V,
// interpreted by a procedure that consumes the tokens of its in/out parameter ts, with None for failure

data Grammar[T, V] :=
  | Token(T -> Option[V])
  | Rule(Str)
  | Alt(Grammar[T, V], Grammar[T, V])
  | Seq(List[Grammar[T, V]], List[V] -> Option[V])
  | Chain(Grammar[T, V], List[T * ((V, V) -> V)])

function combine[V](f: (V, V) -> V, a: Option[V], b: Option[V]): Option[V] :=
  match (a, b)
    case (Some(x), Some(y)) => Some(f(x, y))
    else None
  end

// grammars cannot be cyclic, hence nonterminals refer to the rules by name, looked up in an association list
procedure interpret[T, V](in g: Grammar[T, V], rules: List[Str * Grammar[T, V]], out r: Option[V], ref ts: List[T]) :=
  local s: Option[V], vs: Option[List[V]], o: Option[(V, V) -> V], saved: List[T], more: Bool
  match g
    case Token(f) =>
      match ts
        case [t; us] =>
          assign r := f(t)
          if r != None
            assign ts := us
          end
        case Nil =>
          assign r := None
      end
    case Rule(x) =>
      match lookup(x, rules)
        case Some(h) =>
          call interpret(in h, rules, out r, ref ts)
        case None =>
          assign r := None
      end
    // backtracks to the tokens before g1 if it fails
    case Alt(g1, g2) =>
      assign saved := ts
      call   interpret(in g1, rules, out r, ref ts)
      if r == None
        assign ts := saved
        call   interpret(in g2, rules, out r, ref ts)
      end
    case Seq(gs, action) =>
      call parts(in gs, rules, out vs, ref ts)
      match vs
        case Some(xs) =>
          assign r := action(xs)
        case None =>
          assign r := None
      end
    case Chain(h, ops) =>
      call   interpret(in h, rules, out r, ref ts)
      assign more := r != None

      while more
        call operator(in ops, out o, ref ts)
        match o
          case Some(f) =>
            call   interpret(in h, rules, out s, ref ts)
            assign r := combine(f, r, s)
            assign more := r != None
          case None =>
            assign more := false
        end
      end
  end

// the values of gs, one after the other
procedure parts[T, V](in gs: List[Grammar[T, V]], rules: List[Str * Grammar[T, V]], out vs: Option[List[V]], ref ts: List[T]) :=
  local r: Option[V]
  match gs
    case Nil =>
      assign vs := Some([])
    case [g; hs] =>
      call interpret(in g, rules, out r, ref ts)
      match r
        case Some(v) =>
          call parts(in hs, rules, out vs, ref ts)
          match vs
            case Some(xs) =>
              assign vs := Some([v; xs])
            case None =>
              skip
          end
        case None =>
          assign vs := None
      end
  end

// the meaning of the first of the operators that is next
procedure operator[T, V](in ops: List[T * ((V, V) -> V)], out o: Option[(V, V) -> V], ref ts: List[T]) :=
  match ops
    case Nil =>
      assign o := None
    case [(u, f); rest] =>
      match ts
        case [t; us] =>
          if t == u
            assign o := Some(f), ts := us
          else
            call operator(in rest, out o, ref ts)
          end
        case Nil =>
          assign o := None
      end
  end

data Token :=
  | Num(Int)
  | Sym(Str)

function symbol[V](s: Str, v: V): Grammar[Token, V] :=
  Token(lambda t => if t == Sym(s) then Some(v) else None)

function second[V](vs: List[V]): Option[V] :=
  match vs
    case [_, v; _] => Some(v)
    else None
  end

// arithmetic expressions, given the values of numbers, the meaning of the operators, and a value for symbols
function arithmetic[V](leaf: Int -> V, plus: (V, V) -> V, minus: (V, V) -> V, times: (V, V) -> V, unit: V): List[Str * Grammar[Token, V]] :=
  [
    ("expr", Chain(Rule("term"), [(Sym("+"), plus), (Sym("-"), minus)])),
    ("term", Chain(Rule("factor"), [(Sym("*"), times)])),
    ("factor", Alt(Token(lambda t => match t case Num(n) => Some(leaf(n)) else None end), Seq([symbol("(", unit), Rule("expr"), symbol(")", unit)], second)))
  ]

// all of ts must be consumed
procedure parse[V](in rules: List[Str * Grammar[Token, V]], ts: List[Token], out r: Option[V]) :=
  local  rest: List[Token]
  assign rest := ts
  call   interpret(in Rule("expr"), rules, out r, ref rest)
  if rest != Nil
    assign r := None
  end

// the same grammar evaluates expressions and builds syntax trees
function values(): List[Str * Grammar[Token, Int]] :=
  arithmetic(lambda n => n, lambda a, b => a + b, lambda a, b => a - b, lambda a, b => a * b, 0)

data Tree :=
  | Leaf(Int)
  | Node(Str, Tree, Tree)

function trees(): List[Str * Grammar[Token, Tree]] :=
  arithmetic(Leaf, lambda a, b => Node("+", a, b), lambda a, b => Node("-", a, b), lambda a, b => Node("*", a, b), Leaf(0))

test arithmetic :=
  local  r: Option[Int], t: Option[Tree]
  // 1 + 2 * (3 - 1)
  call   parse(in values(), [Num(1), Sym("+"), Num(2), Sym("*"), Sym("("), Num(3), Sym("-"), Num(1), Sym(")")], out r)
  assert r == Some(5)
  // 10 - 3 - 2, to the left
  call   parse(in values(), [Num(10), Sym("-"), Num(3), Sym("-"), Num(2)], out r)
  assert r == Some(5)
  call   parse(in values(), [Num(1), Sym("+")], out r)
  assert r == None
  call   parse(in values(), [Sym("("), Num(1)], out r)
  assert r == None
  call   parse(in trees(), [Num(1), Sym("+"), Num(2), Sym("*"), Num(3)], out t)
  assert t == Some(Node("+", Leaf(1), Node("*", Leaf(2), Leaf(3))))

// grammars are data, here over tokens that are booleans, counting the true separated by false
test generic_tokens :=
  local  r: Option[Int], rest: List[Bool]
  assign rest := [true, false, true]
  call   interpret(in Chain(Token(lambda b => if b then Some(1) else None), [(false, lambda a, b => a + b)]), [], out r, ref rest)
  assert r == Some(2)
  assert rest == []

run example :=
  local  r: Option[Int], t: Option[Tree]
  call   parse(in values(), [Num(2), Sym("*"), Num(3), Sym("+"), Num(4)], out r)
  call   parse(in trees(), [Num(2), Sym("*"), Num(3), Sym("+"), Num(4)], out t)
