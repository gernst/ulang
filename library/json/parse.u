// a parser of JSON text (RFC 8259) by recursive descent over a cursor, which fails by JsonError

export

data JsonError :=
  case JsonError(message: Str, line: Int, column: Int)

procedure parse_json(in text: Str, out j: Json) raises JsonError

implementation

data Cursor :=
  case Cursor(text: Str, pos: Int)

// an error at the position of the cursor, by line and column from 1
data Failed :=
  case Failed(message: Str, pos: Int)

procedure parse_json(in text: Str, out j: Json) raises JsonError :=
  var s := Cursor(text, 0)
  try
    skip_space(ref s)
    value(out j, ref s)
    skip_space(ref s)
    if s.pos < size(text) then
      raise Failed("end of input expected", s.pos)
    end
  catch
    case Failed(message, pos) =>
      raise JsonError(message, line_of(text, pos), column_of(text, pos))
  end

function line_of(text: Str, pos: Int): Int :=
  1 + size(List(for c in chars(slice(text, 0, pos)) if c == '\n' yield c))

function column_of(text: Str, pos: Int): Int :=
  1 + size(take_while_back(chars(slice(text, 0, pos))))

// the characters after the last newline
function take_while_back(cs: List[Char]): List[Char] :=
  foldl(cs, List(), lambda acc, c => if c == '\n' then List() else acc ++ List(c))

function peek(s: Cursor): Option[Char] :=
  get(s.pos, s.text)

procedure advance(ref s: Cursor) :=
  s := s with pos := s.pos + 1

procedure skip_space(ref s: Cursor) :=
  var more := true
  while more do
    match peek(s)
      case Some(c) =>
        if c == ' ' or c == '\n' or c == '\t' or c == '\r' then
          advance(ref s)
        else
          more := false
        end

      case None =>
        more := false
    end
  end

procedure expect(in c: Char, ref s: Cursor) :=
  if peek(s) == Some(c) then
    advance(ref s)
  else
    raise Failed(quote(str(List(c))) ++ " expected", s.pos)
  end

// the word w, such as true, at the cursor
procedure keyword(in w: Str, ref s: Cursor) :=
  if s.pos + size(w) <= size(s.text) and slice(s.text, s.pos, s.pos + size(w)) == w then
    s := s with pos := s.pos + size(w)
  else
    raise Failed("value expected", s.pos)
  end

procedure value(out j: Json, ref s: Cursor) :=
  match peek(s)
    case Some('{') =>
      object(out j, ref s)

    case Some('[') =>
      elements(out j, ref s)

    case Some('"') =>
      var t: Str
      string(out t, ref s)
      j := String(t)

    case Some('t') =>
      keyword(in "true", ref s)
      j := Boolean(true)

    case Some('f') =>
      keyword(in "false", ref s)
      j := Boolean(false)

    case Some('n') =>
      keyword(in "null", ref s)
      j := Null

    case Some(c) =>
      if c == '-' or is_digit(c) then
        number(out j, ref s)
      else
        raise Failed("value expected", s.pos)
      end

    case None =>
      raise Failed("value expected but end of input found", s.pos)
  end

procedure object(out j: Json, ref s: Cursor) :=
  var fields := List(), more := true
  expect(in '{', ref s)
  skip_space(ref s)
  if peek(s) == Some('}') then
    advance(ref s)
  else
    while more do
      var k: Str, v: Json
      skip_space(ref s)
      string(out k, ref s)
      skip_space(ref s)
      expect(in ':', ref s)
      skip_space(ref s)
      value(out v, ref s)
      skip_space(ref s)
      fields := List((k, v); fields)
      if peek(s) == Some(',') then
        advance(ref s)
      else
        expect(in '}', ref s)
        more := false
      end
    end
  end
  j := Object(reverse(fields))

procedure elements(out j: Json, ref s: Cursor) :=
  var items := List(), more := true
  expect(in '[', ref s)
  skip_space(ref s)
  if peek(s) == Some(']') then
    advance(ref s)
  else
    while more do
      var v: Json
      skip_space(ref s)
      value(out v, ref s)
      skip_space(ref s)
      items := List(v; items)
      if peek(s) == Some(',') then
        advance(ref s)
      else
        expect(in ']', ref s)
        more := false
      end
    end
  end
  j := Elements(reverse(items))

procedure digits(out ds: List[Char], ref s: Cursor) :=
  var acc := List(), more := true
  while more do
    match peek(s)
      case Some(c) =>
        if is_digit(c) then
          acc := List(c; acc)
          advance(ref s)
        else
          more := false
        end

      case None =>
        more := false
    end
  end
  if acc == List() then
    raise Failed("digit expected", s.pos)
  end
  ds := reverse(acc)

function to_int(ds: List[Char]): Int :=
  foldl(ds, 0, lambda n, d => 10 * n + int(d) - int('0'))

// -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
procedure number(out j: Json, ref s: Cursor) :=
  var negative := false, whole: List[Char], fraction := List(), exponent := 0
  let start := s.pos
  var m: Int
  if peek(s) == Some('-') then
    negative := true
    advance(ref s)
  end
  digits(out whole, ref s)
  if size(whole) > 1 and take(1, whole) == List('0') then
    raise Failed("leading zero", start)
  end
  if peek(s) == Some('.') then
    advance(ref s)
    digits(out fraction, ref s)
  end
  if peek(s) == Some('e') or peek(s) == Some('E') then
    var sign := 1, ds: List[Char]
    advance(ref s)
    if peek(s) == Some('-') then
      sign := -1
      advance(ref s)
    else
      if peek(s) == Some('+') then
        advance(ref s)
      end
    end
    digits(out ds, ref s)
    exponent := sign * to_int(ds)
  end
  m := to_int(whole ++ fraction)
  j := decimal(if negative then -m else m, exponent - size(fraction))

procedure parse_hex_unit(out n: Int, ref s: Cursor) :=
  var i := 0
  n := 0
  while i < 4 do
    match peek(s)
      case Some(c) =>
        if is_digit(c) then
          n := 16 * n + int(c) - int('0')
        else
          if 'a' <= c and c <= 'f' then
            n := 16 * n + int(c) - int('a') + 10
          else
            if 'A' <= c and c <= 'F' then
              n := 16 * n + int(c) - int('A') + 10
            else
              raise Failed("hex digit expected", s.pos)
            end
          end
        end

      case None =>
        raise Failed("hex digit expected", s.pos)
    end
    advance(ref s)
    i := i + 1
  end

// a \u escape after its backslash, with a following low surrogate if it is a high one
procedure unicode(out c: Char, ref s: Cursor) :=
  var n: Int
  let start := s.pos
  expect(in 'u', ref s)
  parse_hex_unit(out n, ref s)
  if 55296 <= n and n <= 56319 then
    var low: Int
    expect(in '\\', ref s)
    expect(in 'u', ref s)
    parse_hex_unit(out low, ref s)
    if not (56320 <= low and low <= 57343) then
      raise Failed("low surrogate expected", start)
    end
    n := 65536 + (n - 55296) * 1024 + low - 56320
  else
    if 56320 <= n and n <= 57343 then
      raise Failed("lone low surrogate", start)
    end
  end
  c := chr(n)

procedure string(out t: Str, ref s: Cursor) :=
  var acc := List(), more := true
  expect(in '"', ref s)
  while more do
    match peek(s)
      case Some('"') =>
        advance(ref s)
        more := false

      case Some('\\') =>
        var c: Char
        advance(ref s)
        escaped(out c, ref s)
        acc := List(c; acc)

      case Some(c) =>
        if int(c) < 32 then
          raise Failed("control character in string", s.pos)
        end
        acc := List(c; acc)
        advance(ref s)

      case None =>
        raise Failed("unterminated string", s.pos)
    end
  end
  t := str(reverse(acc))

procedure escaped(out c: Char, ref s: Cursor) :=
  match peek(s)
    case Some('u') =>
      unicode(out c, ref s)

    case Some(e) =>
      let m := get(e, List(
        ('"', '"'),
        ('\\', '\\'),
        ('/', '/'),
        ('b', chr(8)),
        ('f', chr(12)),
        ('n', '\n'),
        ('r', '\r'),
        ('t', '\t')))
      match m
        case Some(d) =>
          c := d
          advance(ref s)

        case None =>
          raise Failed("unknown escape", s.pos)
      end

    case None =>
      raise Failed("unterminated string", s.pos)
  end

test values() :=
  var j: Json
  parse_json(in " {\"a\": [1, -2.50, 3e2, true, null], \"b\": \"x\\ny\"} ", out j)
  assert j == Object(List(
    ("a", Elements(List(Number(1, 0), Number(-25, -1), Number(3, 2), Boolean(true), Null))),
    ("b", String("x\ny"))))
  assert show(j) == "{\"a\":[1,-2.5,300,true,null],\"b\":\"x\\ny\"}"

test unicode_escapes() :=
  var j: Json
  parse_json(in "\"\\u00e9\\ud83d\\ude00\"", out j)
  assert j == String(str(List(chr(233), chr(128512))))

test errors() :=
  var j: Json
  assert raises JsonError("\":\" expected", 2, 7) do
    parse_json(in "{\n  \"a\" 1}", out j)
  end
  assert raises JsonError("leading zero", 1, 2) do
    parse_json(in "[01]", out j)
  end
  assert raises JsonError("lone low surrogate", 1, 3) do
    parse_json(in "\"\\udc00\"", out j)
  end
