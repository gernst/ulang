// a subset of jq: paths .a.b, indexes [0] and [-1], iteration [], pipes |, and the builtins length and keys, where
// each query gives a list of results

export

data Query :=
  case Identity
  case Field(name: Str)
  case Index(i: Int)
  case Iterate
  case Pipe(left: Query, right: Query)
  case Length
  case Keys

data QueryError :=
  case QueryError(message: Str)

procedure parse_query(in text: Str, out q: Query) raises QueryError

procedure run_query(
  in  q: Query,
      j: Json,
  out results: List[Json]
) raises QueryError

implementation

procedure parse_query(in text: Str, out q: Query) raises QueryError :=
  var cs := chars(text), more := true
  skip_spaces(ref cs)
  term(out q, ref cs)
  skip_spaces(ref cs)
  while more do
    match cs
      case List('|'; rest) =>
        var next: Query
        cs := rest
        skip_spaces(ref cs)
        term(out next, ref cs)
        skip_spaces(ref cs)
        q := Pipe(q, next)

      case List() =>
        more := false

      case List(c; _) =>
        raise QueryError("unexpected " ++ quote(str(List(c))))
    end
  end

procedure skip_spaces(ref cs: List[Char]) :=
  var more := true
  while more do
    match cs
      case List(c; rest) =>
        if is_space(c) then
          cs := rest
        else
          more := false
        end

      case List() =>
        more := false
    end
  end

procedure word(out w: Str, ref cs: List[Char]) :=
  var acc := List(), more := true
  while more do
    match cs
      case List(c; rest) =>
        if is_letter(c) or is_digit(c) or c == '_' then
          acc := List(c; acc), cs := rest
        else
          more := false
        end

      case List() =>
        more := false
    end
  end
  w := str(reverse(acc))

procedure term(out q: Query, ref cs: List[Char]) raises QueryError :=
  match cs
    case List('.'; _) =>
      path(out q, ref cs)

    case _ =>
      var w: Str
      word(out w, ref cs)
      if w == "length" then
        q := Length
      else
        if w == "keys" then
          q := Keys
        else
          raise QueryError("path, length, or keys expected")
        end
      end
  end

// a path of fields and indexes after a dot, which alone is the identity
procedure path(out q: Query, ref cs: List[Char]) raises QueryError :=
  var more := true
  q := Identity
  while more do
    match cs
      case List('.', '['; rest) =>
        cs := List('['; rest)

      case List('.'; rest) =>
        var name: Str
        cs := rest
        word(out name, ref cs)
        if name != "" then
          q := chain(q, Field(name))
        end

      case List('['; rest) =>
        var index: Query
        cs := rest
        bracket(out index, ref cs)
        q := chain(q, index)

      case _ =>
        more := false
    end
  end

procedure bracket(out q: Query, ref cs: List[Char]) raises QueryError :=
  var sign := 1
  match cs
    case List(']'; rest) =>
      q := Iterate, cs := rest

    case _ =>
      var ds: Str
      match cs
        case List('-'; rest) =>
          sign := -1, cs := rest
        case _ =>
          skip
      end
      word(out ds, ref cs)
      match (number(ds), cs)
        case (Some(n), List(']'; rest)) =>
          q := Index(sign * n), cs := rest
        case _ =>
          raise QueryError("index or ] expected")
      end
  end

function chain(a: Query, b: Query): Query :=
  if a == Identity then b else Pipe(a, b)

procedure run_query(
  in  q: Query,
      j: Json,
  out results: List[Json]
) raises QueryError :=
  match q
    case Identity =>
      results := List(j)

    case Field(name) =>
      match j
        case Object(fields) =>
          results := List(value_or(get(name, fields), Null))

        case Null =>
          results := List(Null)

        case _ =>
          raise QueryError("cannot index " ++ kind(j) ++ " with " ++ json_quote(name))
      end

    case Index(i) =>
      match j
        case Elements(items) =>
          let k := if i < 0 then size(items) + i else i
          results := List(if 0 <= k then nth(k, items) else Null)

        case Null =>
          results := List(Null)

        case _ =>
          raise QueryError("cannot index " ++ kind(j) ++ " with a number")
      end

    case Iterate =>
      match j
        case Elements(items) =>
          results := items

        case Object(fields) =>
          results := seconds(fields)

        case _ =>
          raise QueryError("cannot iterate over " ++ kind(j))
      end

    case Pipe(a, b) =>
      var first: List[Json]
      run_query(in a, j, out first)
      results := List()
      for x in first do
        var more: List[Json]
        run_query(in b, x, out more)
        results := results ++ more
      end

    case Length =>
      match j
        case Elements(items) =>
          results := List(decimal(size(items), 0))

        case Object(fields) =>
          results := List(decimal(size(fields), 0))

        case String(t) =>
          results := List(decimal(size(t), 0))

        case Null =>
          results := List(decimal(0, 0))

        case _ =>
          raise QueryError(kind(j) ++ " has no length")
      end

    case Keys =>
      match j
        case Object(fields) =>
          results := List(Elements(List(for k in sort(firsts(fields)) yield String(k))))
        case _ =>
          raise QueryError(kind(j) ++ " has no keys")
      end
  end

function nth(k: Int, items: List[Json]): Json :=
  match drop(k, items)
    case List(x; _) =>
      x
    case List() =>
      Null
  end

function kind(j: Json): Str :=
  match j
    case Null =>
      "null"

    case Boolean(_) =>
      "boolean"

    case Number(_, _) =>
      "number"

    case String(_) =>
      "string"

    case Elements(_) =>
      "array"

    case Object(_) =>
      "object"
  end

procedure query(in text: Str, json: Str, out shown: List[Str]) :=
  var q: Query, j: Json, rs: List[Json]
  parse_query(in text, out q)
  parse_json(in json, out j)
  run_query(in q, j, out rs)
  shown := List(for r in rs yield show(r))

test queries() :=
  var r: List[Str]
  let doc := "{\"users\": [{\"name\": \"ada\", \"langs\": [\"ml\", \"c\"]}, {\"name\": \"bob\", \"langs\": []}], \"n\": 2}"
  query(in ".users[0].name", doc, out r)
  assert r == List("\"ada\"")
  query(in ".users[].name", doc, out r)
  assert r == List("\"ada\"", "\"bob\"")
  query(in ".users[] | .langs | length", doc, out r)
  assert r == List("2", "0")
  query(in ".users[-1].langs[0]", doc, out r)
  assert r == List("null")
  query(in "keys", doc, out r)
  assert r == List("[\"n\",\"users\"]")
  query(in ".", "[]", out r)
  assert r == List("[]")
  assert raises QueryError("cannot index number with \"x\"") do
    query(in ".n.x", doc, out r)
  end
