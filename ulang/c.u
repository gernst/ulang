// the part of C that compiled ulang programs need, as datatypes, and a printer to C source code,
// where the runtime defines the type u_value of all ulang values in a header, which is not part of the syntax

export

data CType :=
  case CtVoid
  case CtInt
  case CtNamed(name: Str)
  case CtPtr(pointee: CType)

// operators are their C symbols, e.g. "+" or "==", and unary ones include "!", "-", "*", and "&"
data CExpr :=
  case CeVar(name: Str)
  case CeNum(num: Int)
  case CeStr(text: Str)
  case CeCall(fun: CExpr, args: List[CExpr])
  case CeUnary(op: Str, operand: CExpr)
  case CeBinary(op: Str, left: CExpr, right: CExpr)
  case CeIndex(base: CExpr, index: CExpr)
  case CeArrow(base: CExpr, field: Str)
  case CeCast(typ: CType, operand: CExpr)
  case CeCond(cond: CExpr, then_expr: CExpr, else_expr: CExpr)
  case CeInit(items: List[CExpr])

data CStmt :=
  case CsExpr(expr: CExpr)
  case CsDecl(typ: CType, name: Str, init: Option[CExpr])
  case CsAssign(target: CExpr, expr: CExpr)
  case CsIf(cond: CExpr, then_stmts: List[CStmt], else_stmts: List[CStmt])
  case CsWhile(cond: CExpr, body: List[CStmt])
  case CsReturn(result: Option[CExpr])
  case CsBlock(body: List[CStmt])

data CDecl :=
  case CdInclude(header: Str)
  case CdPrototype(typ: CType, fun: Str, formals: List[CType * Str])
  case CdFunction(typ: CType, fun: Str, formals: List[CType * Str], body: List[CStmt])
  case CdGlobal(typ: CType, name: Str, init: Option[CExpr])

data CFile :=
  case CFile(decls: List[CDecl])

// the C source code of a file, which is formatted rather than shown, since show gives ulang values as they are written
function format_file(file: CFile): Str

function c_call(fun: Str, args: List[CExpr]): CExpr

implementation

function format_type(typ: CType): Str :=
  match typ
    case CtVoid =>
      "void"

    case CtInt =>
      "int"

    case CtNamed(name) =>
      name

    case CtPtr(CtPtr(pointee)) =>
      format_type(CtPtr(pointee)) ++ "*"

    case CtPtr(pointee) =>
      format_type(pointee) ++ " *"
  end

// a declaration of name with type typ, without a space after a pointer
function format_typed(typ: CType, name: Str): Str :=
  match typ
    case CtPtr(_) =>
      format_type(typ) ++ name
    case _ =>
      format_type(typ) ++ " " ++ name
  end

// subexpressions are in parentheses unless they are atomic, which avoids the precedences of C
function format_expr(expr: CExpr): Str :=
  match expr
    case CeVar(name) =>
      name

    case CeNum(num) =>
      show(num)

    case CeStr(text) =>
      format_str(text)

    case CeCall(fun, args) =>
      format_operand(fun) ++ "(" ++ join(", ", List(for arg in args yield format_expr(arg))) ++ ")"

    case CeUnary(op, operand) =>
      op ++ format_operand(operand)

    case CeBinary(op, left, right) =>
      format_operand(left) ++ " " ++ op ++ " " ++ format_operand(right)

    case CeIndex(base, index) =>
      format_operand(base) ++ "[" ++ format_expr(index) ++ "]"

    case CeArrow(base, field) =>
      format_operand(base) ++ "->" ++ field

    case CeCast(typ, operand) =>
      "(" ++ format_type(typ) ++ ")" ++ format_operand(operand)

    case CeCond(cond, then_expr, else_expr) =>
      format_operand(cond) ++ " ? " ++ format_operand(then_expr) ++ " : " ++ format_operand(else_expr)

    case CeInit(items) =>
      "{" ++ join(", ", List(for item in items yield format_expr(item))) ++ "}"
  end

// the escapes of C strings are those of ulang for code points below 128, and a string of greater code points is "…",
// u"…", or U"…" by the greatest, as the runtime reads its units, with an octal escape for each code point below 160 and
// otherwise a universal character name, which C does not allow below 160
function format_str(text: Str): Str :=
  let greatest := foldl(chars(text), 0, lambda m, c => if ord(c) > m then ord(c) else m) in if greatest < 128 then quote(text) else (if greatest < 256 then "" else if greatest < 65536 then "u" else "U") ++ "\"" ++ join("", List(for c in chars(text) yield format_unit(greatest, c))) ++ "\""

function format_unit(greatest: Int, c: Char): Str :=
  let code := ord(c), quoted := quote(str(List(c))) in if code < 128 then slice(quoted, 1, size(quoted) - 1) else if code < 160 or greatest < 256 then "\\" ++ digits(code, 8, 3) else if code < 65536 then "\\u" ++ digits(code, 16, 4) else "\\U" ++ digits(code, 16, 8)

// the last k digits of n in base b, with leading zeros
function digits(n: Int, b: Int, k: Int): Str :=
  if k == 0 then "" else digits(n / b, b, k - 1) ++ str(List(at(n % b, "0123456789abcdef")))

function format_operand(expr: CExpr): Str :=
  match expr
    case CeVar(_) =>
      format_expr(expr)

    case CeNum(num) if num >= 0 =>
      format_expr(expr)

    case CeStr(_) =>
      format_expr(expr)

    case CeCall(_, _) =>
      format_expr(expr)

    case CeIndex(_, _) =>
      format_expr(expr)

    case CeArrow(_, _) =>
      format_expr(expr)

    case _ =>
      "(" ++ format_expr(expr) ++ ")"
  end

function format_stmt(indent: Str, stmt: CStmt): List[Str] :=
  let deeper := indent ++ "  " in match stmt
    case CsExpr(expr) =>
      List(indent ++ format_expr(expr) ++ ";")

    case CsDecl(typ, name, None) =>
      List(indent ++ format_typed(typ, name) ++ ";")

    case CsDecl(typ, name, Some(expr)) =>
      List(
        indent ++ format_typed(typ, name) ++ " = " ++ format_expr(expr) ++ ";")

    case CsAssign(target, expr) =>
      List(indent ++ format_expr(target) ++ " = " ++ format_expr(expr) ++ ";")

    case CsIf(cond, then_stmts, List()) =>
      List(indent ++ "if (" ++ format_expr(cond) ++ ") {") ++ format_stmts(deeper, then_stmts) ++ List(indent ++ "}")

    case CsIf(cond, then_stmts, else_stmts) =>
      List(indent ++ "if (" ++ format_expr(cond) ++ ") {") ++ format_stmts(deeper, then_stmts) ++ List(indent ++ "} else {") ++ format_stmts(deeper, else_stmts) ++ List(indent ++ "}")

    case CsWhile(cond, body) =>
      List(indent ++ "while (" ++ format_expr(cond) ++ ") {") ++ format_stmts(deeper, body) ++ List(indent ++ "}")

    case CsReturn(None) =>
      List(indent ++ "return;")

    case CsReturn(Some(expr)) =>
      List(indent ++ "return " ++ format_expr(expr) ++ ";")

    case CsBlock(body) =>
      List(indent ++ "{") ++ format_stmts(deeper, body) ++ List(indent ++ "}")
  end

function format_stmts(indent: Str, stmts: List[CStmt]): List[Str] :=
  List(for stmt in stmts for line in format_stmt(indent, stmt) yield line)

// the formals of a function, which are void if there are none
function format_formals(formals: List[CType * Str]): Str :=
  match formals
    case List() =>
      "void"
    case _ =>
      join(", ", List(for formal in formals yield format_formal(formal)))
  end

function format_formal(formal: CType * Str): Str :=
  match formal
    case (typ, name) =>
      format_typed(typ, name)
  end

function format_decl(decl: CDecl): List[Str] :=
  match decl
    case CdInclude(header) =>
      List("#include " ++ quote(header))

    case CdPrototype(typ, fun, formals) =>
      List(format_typed(typ, fun) ++ "(" ++ format_formals(formals) ++ ");")

    case CdFunction(typ, fun, formals, body) =>
      List(format_typed(typ, fun) ++ "(" ++ format_formals(formals) ++ ") {") ++ format_stmts("  ", body) ++ List("}")

    case CdGlobal(typ, name, None) =>
      List(format_typed(typ, name) ++ ";")

    case CdGlobal(typ, name, Some(expr)) =>
      List(format_typed(typ, name) ++ " = " ++ format_expr(expr) ++ ";")
  end

// the source code of a file, with an empty line between declarations
function format_file(file: CFile): Str :=
  match file
    case CFile(decls) =>
      join("\n\n", List(for decl in decls yield join("\n", format_decl(decl)))) ++ "\n"
  end

// a function of the runtime, which compiled code calls
function c_call(fun: Str, args: List[CExpr]): CExpr :=
  CeCall(CeVar(fun), args)

test format_c() :=
  local value := CtNamed("value"), one := c_call("make_int", List(CeNum(1))), fact := CdFunction(value, "fact", List((value, "n")), List(
    CsIf(c_call("is_zero", List(CeVar("n"))), List(CsReturn(Some(one))), List()),
    CsDecl(value, "m", Some(c_call("fact", List(c_call("sub", List(CeVar("n"), one)))))),
    CsReturn(Some(c_call("mul", List(CeVar("n"), CeVar("m"))))))), main := CdFunction(CtInt, "main", List(), List(
    CsExpr(c_call("print", List(c_call("fact", List(c_call("make_int", List(CeNum(5)))))))),
    CsReturn(Some(CeNum(0)))))
  assert format_file(CFile(List(CdInclude("ulang.h"), fact, main))) == "#include \"ulang.h\"\n\nvalue fact(value n) {\n  if (is_zero(n)) {\n    return make_int(1);\n  }\n  value m = fact(sub(n, make_int(1)));\n  return mul(n, m);\n}\n\nint main(void) {\n  print(fact(make_int(5)));\n  return 0;\n}\n"
  assert format_expr(CeBinary("+", CeBinary("*", CeVar("a"), CeNum(2)), CeUnary("-", CeVar("b")))) == "(a * 2) + (-b)"
  assert format_expr(CeStr("a\"b\n")) == "\"a\\\"b\\n\""
  assert format_expr(CeStr("\"ä\n")) == "\"\\\"\\344\\n\"" and format_expr(CeStr("a→")) == "u\"a\\u2192\""
  assert format_expr(CeStr(str(List(chr(128512), chr(150), chr(228))))) == "U\"\\U0001f600\\226\\u00e4\""
  assert format_stmt("", CsIf(CeVar("c"), List(CsReturn(None)), List(CsExpr(c_call("f", List()))))) == List("if (c) {", "  return;", "} else {", "  f();", "}")
