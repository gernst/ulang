// the core syntax of ulang, whose parts carry the positions that the parser gives them (At),
// where constructors are prefixed by their type, since they share one namespace

export

// identifiers that never refer to declarations of modules: type parameters, modules, notation, runs, and tests
type Id :=
  Str

// module is None for locals, builtins, and names before checking
data Name :=
  // a name as written, e.g. x, f, or T, which the parser never qualifies
  case Name(module: Option[Id], base: Id)

data Type :=
  // a type that is not written, e.g. of local x := e, which the checker infers
  case THole
  // an unknown of inference, which has no concrete syntax
  case TMeta(meta: Int)
  // a type parameter, e.g. A, declared by [A, …] after the name of a declaration
  case TParam(param: Id)
  // the type of a part that does not parse, which unifies with every type, and of what it reaches, whose errors the
  // checker does not report, which has no concrete syntax
  case TError
  // a type T or T[A, …], applied to its arguments, e.g. Int or Map[K, V]
  case TSort(name: Name, args: List[Type])
  // a function type A -> B, (A, B, …) -> C, or () -> C
  case TFun(args: List[Type], res: Type)
  // procedures as values, (in A, out B, ref C), whose parameters have modes as in declarations
  // where raises is a TTuple of the types that it may raise, as written, or a TMeta of inference
  case TProc(ins: List[Type], outs: List[Type], refs: List[Type], raised: Type)
  // a tuple type A * B * …, where a chain is one tuple type, or () for none
  case TTuple(types: List[Type])

data Lit :=
  // ()
  case LUnit
  // true or false
  case LBool(bool: Bool)
  // a number, e.g. 42, or a negative one, e.g. -1
  case LInt(num: Int)
  // a hexadecimal number, e.g. 0xFF, or a negative one, e.g. -0x10, which the checker translates to LInt
  case LHex(num: Int)
  // a string in double quotes, e.g. "text", with escapes, e.g. \\, \", and \n
  case LStr(text: Str)
  // a character in single quotes, e.g. 'c'
  case LChar(char: Char)

data Var :=
  // x or x: T, as a formal, local, or binding, with THole for a type not written
  case Var(name: Name, typ: Type)

// a part of the syntax at the position of its first token, or of the token that names it, and with its span, from its
// first token to the end of its last, which the checker keeps
data At[A] :=
  case AOk(pos: Pos, span: Span, that: A)
  // a part that a phase rejected, with its errors, whose positions may be inside it
  case AErr(pos: Pos, span: Span, that: A, errors: List[Diagnostic])
  // a part that does not parse, as written over span, from pos to where the parser resumes
  case AUnparsed(pos: Pos, span: Span, text: Str, error: Diagnostic)

// a part on lines of its own after its doc of // lines, a command, a constructor, or a case of a match or catch
data Doc[A] :=
  case Doc(doc: Option[Str], at: At[A])

data Expr :=
  // a literal
  case ELit(lit: Lit)
  // a name x of a local or a declaration, which the checker resolves
  case EVar(var: Var)
  // f(a, …) of a function or constructor, or an operator of the notation, e.g. a + b, -a, or not a, at the position of the
  // name or operator
  case EApp(fun: At[Expr], args: List[At[Expr]])
  // e.f and e with f := a, which the checker resolves by the type of e to the accessor T.f and the updater T.f:=, at the
  // position of . and with
  case EField(base: At[Expr], field: Id)
  case EUpdate(base: At[Expr], field: Id, value: At[Expr])
  // lambda p, … => body, whose formals are patterns, which it matches as let does, and which the checker makes variables,
  // keeping those that are variables and matching the others in the body, so that the backends see only variables
  case ELam(formals: List[At[Pat]], body: At[Expr])
  // lambda in x, out y, ref z => body end, which sees the variables around it but assigns only its outs and refs
  // where raised is the type of what it may raise, as of TProc, THole until the checker infers it from where it is used
  case EProc(ins: List[At[Var]], outs: List[At[Var]], refs: List[At[Var]], raised: Type, stmt: At[Stmt])
  // let p := a, … in body, which binds in parallel, by irrefutable patterns
  case ELet(bindings: List[At[Pat] * At[Expr]], body: At[Expr])
  // if c then a else b
  case EIte(cond: At[Expr], then_expr: At[Expr], else_expr: At[Expr])
  // match e case p => a … end, one case per line
  case EMatch(arg: At[Expr], cases: List[Doc[Branch[At[Expr]]]])
  // a tuple (a, b, …)
  case ETuple(args: List[At[Expr]])
  // List(a, b; r), Set(…), Map(k => v; r), and Array(…), which the checker translates to the builders of their modules
  case EForm(form: Form, elems: List[Yield], rest: Option[At[Expr]])
  // List(for p in c if q yield e; r) and the like, which the checker translates to the folds of the modules of the
  // containers, where elem is what each step adds, written after yield or else the value of the single generator
  case EFor(form: Form, gens: List[Gen], elem: Yield, rest: Option[At[Expr]])

data Form :=
  // the form List(…)
  case FList
  // the form Set(…)
  case FSet
  // the form Map(…)
  case FMap
  // the form Array(…)
  case FArray

// an element of a list, set, or array, or an entry k => v of a map
data Yield :=
  // an element a
  case YVal(value: At[Expr])
  // an entry k => v
  case YPair(key: At[Expr], value: At[Expr])

data Gen :=
  // for p in c over a list, set, or array, where p is irrefutable
  case GVal(pat: At[Pat], over: At[Expr])
  // for k => v in m over a map
  case GPair(key: At[Pat], value: At[Pat], over: At[Expr])
  // a guard if q after a generator
  case GIf(cond: At[Expr])

data Pat :=
  // the wildcard _
  case PWild
  // a literal, e.g. -1 or "a"
  case PLit(lit: Lit)
  // a variable x, which binds x
  case PVar(var: Var)
  // a constructor C(p, …) or C, where List(p, …; r) and List() are Cons and Nil
  case PApp(constr: Name, args: List[At[Pat]])
  // a tuple (p, q, …)
  case PTuple(args: List[At[Pat]])

// the proof of a lemma after its contract, see ideas/prove.md, section 4: steps that add facts and witnesses, then at most one
// split, which ends it, since it replaces the goal by its cases, each a proof of its own; without steps and split, the
// goal must close by simplification
data Proof :=
  case Proof(steps: List[At[Step]], split: Option[At[Split]])

data Step :=
  // local x := e, a definition, or local q: T, a witness that an out of a call binds
  case StepLocal(var: At[Var], value: Option[At[Expr]])
  // call l(in a, …, out q, …), the instance of the lemma l, whose requires are proven and whose ensures is then a fact
  case StepCall(name: Name, ins: List[At[Expr]], outs: List[Var])
  // assert e, a cut, which must follow by simplification and is a fact afterwards
  case StepAssert(cond: At[Expr])
  // assign q := e, …, the witnesses for the outs of the lemma being proven
  case StepAssign(upd: List[Var * At[Expr]])
  // invariant e of a loop of the procedure of a claim correct p(…), one per while of its body in the order of the
  // source, over the variables in scope at the loop
  case StepInvariant(cond: At[Expr])

data Split :=
  // induction x case p => … end, structural induction on the formal x
  case SplitInduction(formal: Var, cases: List[Doc[Branch[Proof]]])
  // match e case p => … end, on the constructors of e
  case SplitMatch(arg: At[Expr], cases: List[Doc[Branch[Proof]]])
  // if c then … else … end, with None for an else that is not written
  case SplitIf(cond: At[Expr], left: Proof, right: Option[Proof])

data Branch[A] :=
  // case p if g => body of a match, where if g is optional
  case Branch(pat: At[Pat], guard: Option[At[Expr]], body: A)

data Stmt :=
  // skip, also an else that is not written
  case SSkip
  // assign x := a, …, which assigns in parallel
  case SAssign(upd: List[Var * At[Expr]])
  // statements one after another, each after its doc, the body of an if, while, case, or procedure, which may declare
  // local x := e first, as assignments without docs that start stmts
  case SBlock(locals: List[At[Var]], stmts: List[Doc[Stmt]])
  // if c then … else … end, or if c then … end
  case SIf(cond: At[Expr], left: At[Stmt], right: At[Stmt])
  // while c do … end
  case SWhile(cond: At[Expr], body: At[Stmt])
  // call p(in a, …, out x, …, ref y, …), where in is optional before the first ins
  case SCall(proc: Name, ins: List[At[Expr]], outs: List[Var], refs: List[Var])
  // match e case p => … end
  case SMatch(arg: At[Expr], cases: List[Doc[Branch[At[Stmt]]]])
  // assert c
  case SAssert(cond: At[Expr])
  // assert raises p do … end, which fails unless body raises an exception that p matches, where typ is THole until
  // the checker infers it from p, as of a Catch
  case SAssertRaises(typ: Type, pat: At[Pat], body: At[Stmt])
  // raise e, where typ is the type of e, which the checker infers
  case SRaise(value: At[Expr], typ: Type)
  // try … catch case p => … end
  case STry(body: At[Stmt], catches: List[Doc[Catch]])
  // for p in c if q do … end, or for k => v in m do … end, over the elements of any container in the order of its fold,
  // where the parser allows one generator and an optional guard, and the checker gives the backends one GVal over the list
  // of the elements and the guard as an if in the body
  case SFor(gens: List[Gen], body: At[Stmt])

// with the pattern PWild, a handler handles exceptions of any type
data Catch :=
  // case p if g => body of a catch, where typ is THole until the checker infers it from p
  case Catch(typ: Type, pat: At[Pat], guard: Option[At[Expr]], body: At[Stmt])

data Constr :=
  // case C(f: A, …) of a datatype, or case C without fields
  case Constr(name: Name, fields: List[Field])

data Field :=
  // a field f: A
  case Field(name: Id, typ: Type)

data Fixity :=
  // prefix n op …, e.g. prefix 5 not
  case FPrefix
  // postfix n op …, e.g. postfix 12 !
  case FPostfix
  // infix n op …, which does not associate, e.g. infix 6 ==
  case FInfix
  // infix left n op …, e.g. infix left 9 + -
  case FLeft
  // infix right n op …, e.g. infix right 8 ++
  case FRight

data Cmd :=
  // an alias type T[A, …] := typ
  case CSort(name: Name, params: List[Id], typ: Type)
  // data T[A, …] := case C(f: A, …) case D, one case per line
  case CData(name: Name, params: List[Id], constrs: List[Doc[Constr]])
  // function f[A, …](x: A, …): T := spec body, where spec is the lines after :=, see Spec
  case CFun(name: Name, params: List[Id], formals: List[At[Var]], typ: Type, spec: Spec, body: At[Expr])
  // procedure p[A, …](in x: A, …, out y: B, …, ref z: C, …) := spec body, where in is optional before the first ins
  // raises T, … after the formals, where none written is none raised if it is exported, and else inferred
  case CProc(name: Name, params: List[Id], ins: List[At[Var]], outs: List[At[Var]], refs: List[At[Var]], raised: List[Type], spec: Spec, stmt: At[Stmt])
  // a notation, e.g. infix left 9 + -, see Fixity
  case CNotation(fixity: Fixity, prec: Int, ops: List[Id])
  // tests take no parameters, which the checker enforces
  case CTest(name: Name, vars: List[At[Var]], stmt: At[Stmt])
  // the export section of a module, with the signatures of functions and procedures, as CFun and CProc without their
  // bodies, and abstract types, which its implementation section defines by data, and its builtin section, with the
  // signatures of exported functions and procedures that the interpreter and the runtime define; a spec follows := after
  // the head, which a signature without one has not
  case CFunSig(name: Name, params: List[Id], formals: List[At[Var]], typ: Type, spec: Spec)
  case CProcSig(name: Name, params: List[Id], ins: List[At[Var]], outs: List[At[Var]], refs: List[At[Var]], raised: List[Type], spec: Spec)
  // an abstract type T[A, …], without a definition
  case CAbstract(name: Name, params: List[Id])
  // a pattern alias pattern C[A, …](x: A, …): T := pat, whose variables are the formals, each once, which the checker
  // expands at its uses in patterns, and which is a function of the same name where pat has no _
  case CPatAlias(name: Name, params: List[Id], formals: List[At[Var]], typ: Type, pat: At[Pat])
  // lemma l[A, …](in x: A, …, out y: B, …) := claim proof, see Claim and ideas/prove.md, which the prover proves, while the
  // interpreter and the compiler skip it
  case CLemma(name: Name, params: List[Id], ins: List[At[Var]], outs: List[At[Var]], claim: Claim, proof: Option[Proof])

// what a lemma states over its formals
data Claim :=
  // requires a, … ensures b: b for all ins that satisfy the assumptions a, …, for some outs
  case ClaimHolds(assms: List[At[Expr]], concl: At[Expr])
  // correct p(in a, …, out y, …): for all ins, every run of the call that ends normally from a state that satisfies the
  // requires of p ends in one that satisfies its ensures, where the outs y, … are the outs of the lemma, in their order
  case ClaimCorrect(proc: Name, ins: List[At[Expr]], outs: List[Var])

// the specification of a function or procedure, lines after := of its head and before its body: the contract of a
// procedure, requires a, … over its ins and refs as pre and ensures b over all its formals as post, see ideas/prove.md, then the
// examples; on the first occurrence of a signature, the export of an exported one, and empty on its definition
data Spec :=
  // the examples, each at its keyword, which the checker translates into tests
  case Spec(pre: List[At[Expr]], post: Option[At[Expr]], examples: List[At[Example]])

// an example of a function or procedure
data Example :=
  // a Bool expression that applies the function, e.g. gcd(12, 18) == 6
  case XHolds(expr: At[Expr])
  // an application of the function that raises an exception that pat matches, e.g. chr(-1) raises NoCharacter(-1)
  case XRaises(expr: At[Expr], pat: At[Pat])
  // a call of the procedure with the expected values of its outs and each ref from before to after, e.g.
  // divmod(in 7, 2, out 3, 1) or push(in 3, ref List(1) => List(3, 1))
  case XCall(proc: Name, ins: List[At[Expr]], outs: List[At[Expr]], refs: List[At[Expr] * At[Expr]])
  // a call of the procedure that raises an exception that pat matches, with blanks, the number of its outs, written _,
  // since it does not assign them, and each ref as before, e.g. divmod(in 7, 0, out _, _) raises DivisionByZero
  case XCallRaises(proc: Name, ins: List[At[Expr]], blanks: Int, befores: List[At[Expr]], pat: At[Pat])

// the checked program: the commands of the export and implementation sections of its modules with resolved names, each at
// its declaration, the definitions checked and the signatures as written, then the tests of examples and lemmas, those of
// the builtin sections apart, and the module of the file that is loaded, whose procedures run and compile call
data Prog :=
  case Prog(cmds: List[At[Cmd]], builtins: List[At[Cmd]], main: Id)

data Pos :=
  // line and column, both from 1
  case Pos(line: Int, col: Int)

// the text from start to stop, which is the position after its last character, so that an empty span has start == stop
data Span :=
  case Span(start: Pos, stop: Pos)

// a module without sections has all its commands implemented and exports nothing
data Mod :=
  // a file of import "p" lines of packages, then export, builtin, and implementation, each followed by its commands
  case Mod(name: Id, doc: Option[Str], imports: List[Id], exported: List[Doc[Cmd]], builtins: List[Doc[Cmd]], implemented: List[Doc[Cmd]])

// the files with sections of a directory, other than project.u, which see each other's exports and notations without
// imports, known by the directory from the root, "" for the root, and prelude for the library
data Package :=
  case Package(id: Id, members: List[Id])

// the modules in load order, each after the modules it imports, where the members of a package follow each other, after
// the packages and programs that they import, and with main last
data Source :=
  // the file that is run, tested, checked, or compiled, with its imports and their packages
  case Source(mods: List[Mod], packages: List[Package], main: Id)

// a variable and an application of a variable as expressions, and a variable as a pattern, with THole for no type
pattern EName(name: Name, typ: Type): Expr :=
  EVar(Var(name, typ))

// a call of a name, whose position is that of the name, as the parser places a call at its name
pattern ECall(pos: Pos, span: Span, name: Name, typ: Type, args: List[At[Expr]]): Expr :=
  EApp(AOk(pos, span, EVar(Var(name, typ))), args)

pattern PName(name: Name, typ: Type): Pat :=
  PVar(Var(name, typ))

function unqualified(x: Id): Name

function arity(t: Type): Int

// x at the position Pos(0, 0), of code that the parser did not read, e.g. of tests
function nowhere[A](x: A): At[A]

// a name of the generated code, which users cannot write
function generated_name(base: Id): Name

// the parts of generated code, at no position, with the names as written, which the checker resolves
function generated_call(name: Name, args: List[At[Expr]]): At[Expr]

function generated_op(op: Id, args: List[At[Expr]]): At[Expr]

function generated_var(name: Name): At[Expr]

function generated_lambda(d: Name, body: At[Expr]): At[Expr]

function generated_list(exprs: List[At[Expr]]): At[Expr]

// the empty span at pos, of code that a phase makes at the position of a part whose span it does not have
function span_at(pos: Pos): Span

// the span from the start of first to the stop of last
function span_over[A, B](first: At[A], last: At[B]): Span

// the spec of a head without :=, and of the checked program, whose examples are tests
function no_spec(): Spec

// the part of x mapped by f, at the position of x
function map_at[A, B](x: At[A], f: A -> B): At[B]

function map_doc[A, B](d: Doc[A], f: A -> B): Doc[B]

function expr_var(n: Id): At[Expr]

function expr_int(n: Int): At[Expr]

function expr_app(f: Id, args: List[At[Expr]]): At[Expr]

function pat_var(n: Id): At[Pat]

function pattern_expr(p: At[Pat]): Option[At[Expr]]

function pattern_names(pat: At[Pat]): List[Name]

// the variables of patterns that are all variables
function pattern_vars(pats: List[At[Pat]]): Option[List[Var]]

// the sorts that t names, as written, unqualified or qualified
function sorts_in(t: Type): List[Name]

function implicit_elem(form: Form, gens: List[Gen]): Option[Yield]

function form_name(form: Form): Id

function lambda_vars(formals: List[At[Pat]]): List[Var]

// a lambda of the variables xs, placed at pos
function lambda_of(pos: Pos, span: Span, xs: List[Var], body: At[Expr]): Expr

function placed_of(d: Mod): List[Doc[Cmd]]

// the commands of q that the backends run and the prover translates, without the signatures and the pattern aliases, which
// only the checker needs, where a definition that errors make unsafe to run has an error node of them as its body
function definitions(q: Prog): List[Cmd]

function commands_of(docs: List[Doc[Cmd]]): List[Cmd]

// the errors of the parts of cmd, of those that do not parse and of those that a phase rejected, in the order of the source
function part_errors(cmd: Cmd): List[Diagnostic]

// the expressions of a claim, the assumptions and the conclusion, or the ins of the call
function claim_exprs(claim: Claim): List[At[Expr]]

// the positions of the loops of stmt in the order of the source, by which the invariants of a claim of a procedure are
// matched to them, without those of the procedures that lambdas make, which are values
function loop_positions(stmt: At[Stmt]): List[Pos]

// the errors of cmd and of its parts
function cmd_errors(cmd: At[Cmd]): List[Diagnostic]

// the module of cmd, None for a notation, which has no name
function cmd_module(cmd: Cmd): Option[Id]

// whether x parsed, though it may have parts that do not
function is_parsed[A](x: At[A]): Bool

// the first error of the parts of the example x that do not parse, which its test reports
function example_error(x: At[Example]): Option[Diagnostic]

// the parts of docs, without their docs and positions, and without those that do not parse
function parts[A](docs: List[Doc[A]]): List[A]

// the statements of docs, without their docs
function stmts_of(docs: List[Doc[Stmt]]): List[At[Stmt]]

// a block of stmts without docs
function block(locals: List[Var], stmts: List[At[Stmt]]): Stmt

// the variables of declarations, without their positions
function vars(xs: List[At[Var]]): List[Var]

// variables of code that the parser did not read, as declarations at no position
function unplaced_vars(xs: List[Var]): List[At[Var]]

// the modules that module name imports without saying so: for a module of a project the library, and none for a module
// of the library, which sees the others as the members of its package
function implicit_imports(name: Id): List[Id]

// the members of the package of the library
function library_modules(): List[Id]

// the module of the library of the file name.u of the library, known as prelude/name, since the library is the package prelude
function library_module(name: Str): Id

// the name of the file of a module of the library without .u, as os_library reads it
function library_file(id: Id): Str

function library_name(module: Str, base: Id): Name

// the directory of a module from the root of its project, "" for the root, and prelude for the library
function module_dir(id: Id): Str

// the modules that d sees besides itself: the implicit imports, the members of the packages it imports, and the members
// of the package of its directory, whose member it is or, for a program, not
function seen_modules(d: Mod, packages: List[Package]): List[Id]

function unplaced(cmds: List[Cmd]): List[Doc[Cmd]]

// cmd with every position Pos(0, 0), which parsing the same text at other places gives the same
function strip_cmd(cmd: Cmd): Cmd

function strip_expr(expr: At[Expr]): At[Expr]

function strip_stmt(stmt: At[Stmt]): At[Stmt]

function strip_pat(pat: At[Pat]): At[Pat]

function strip_yield(y: Yield): Yield

// the escapes of literals, each the character after \ with the character that it stands for, as the lexer reads them and
// the printers write them, where a quote is escaped only in a literal that it delimits; the runtime writes them by escape
// of ulang/runtime/ulang.c, which the test escapes_round_trip of ulang/parse/lex.u keeps in step
function escapes(): List[Char * Char]

// c in a literal delimited by the quote delimiter, escaped if it needs to be
function escape(c: Char, delimiter: Char): Str

// the characters of operators, as the lexer reads them and the printer separates them
function is_op_char(c: Char): Bool

// num as a hexadecimal literal, with the digits in upper case, as the printers write LHex
function hex_text(num: Int): Str :=
  example hex_text(55296) == "0xD800"
  example hex_text(-16) == "-0x10"
  example hex_text(0) == "0x0"

implementation

function escapes(): List[Char * Char] :=
  List(
    ('"', '"'),
    ('\'', '\''),
    ('\\', '\\'),
    ('n', '\n'),
    ('t', '\t'),
    ('r', '\r'))

function is_op_char(c: Char): Bool :=
  contains(c, "-+*/%<>=!&:^~?@#$")

function hex_text(num: Int): Str :=
  if num < 0 then "-" ++ hex_text(0 - num) else "0x" ++ hex_digits(num)

function hex_digits(num: Int): Str :=
  let digit := slice("0123456789ABCDEF", num % 16, num % 16 + 1) in
  if num < 16 then digit else hex_digits(num / 16) ++ digit

function escape(c: Char, delimiter: Char): Str :=
  match find(escapes(), lambda (_, d) => d == c)
    case Some((e, _)) if c == delimiter or not contains(c, "\"'") =>
      str(List('\\', e))
    case _ =>
      str(List(c))
  end

// a name without a module, of a local or a builtin, or before checking
function unqualified(x: Id): Name :=
  Name(None, x)

// the number of arguments of a function type, functions are overloaded by it
function arity(t: Type): Int :=
  match t
    case TFun(args, _) =>
      size(args)
    case _ =>
      -1
  end

function no_spec(): Spec :=
  Spec(List(), None, List())

function nowhere[A](x: A): At[A] :=
  AOk(Pos(0, 0), span_at(Pos(0, 0)), x)

function span_at(pos: Pos): Span :=
  Span(pos, pos)

function span_over[A, B](first: At[A], last: At[B]): Span :=
  Span(first.span.start, last.span.stop)

function generated_name(base: Id): Name :=
  unqualified("(" ++ base ++ ")")

function generated_call(name: Name, args: List[At[Expr]]): At[Expr] :=
  nowhere(ECall(Pos(0, 0), span_at(Pos(0, 0)), name, THole, args))

function generated_op(op: Id, args: List[At[Expr]]): At[Expr] :=
  generated_call(unqualified(op), args)

function generated_var(name: Name): At[Expr] :=
  nowhere(EName(name, THole))

function generated_lambda(d: Name, body: At[Expr]): At[Expr] :=
  nowhere(ELam(List(nowhere(PName(d, THole))), body))

function generated_list(exprs: List[At[Expr]]): At[Expr] :=
  nowhere(EForm(FList, List(for e in exprs yield YVal(e)), None))

function map_at[A, B](x: At[A], f: A -> B): At[B] :=
  match x
    case AOk(pos, span, that) =>
      AOk(pos, span, f(that))

    case AErr(pos, span, that, errors) =>
      AErr(pos, span, f(that), errors)

    case AUnparsed(pos, span, text, error) =>
      AUnparsed(pos, span, text, error)
  end

function map_doc[A, B](d: Doc[A], f: A -> B): Doc[B] :=
  Doc(d.doc, map_at(d.at, f))

// abbreviations for the syntax, of tests
function expr_var(n: Id): At[Expr] :=
  nowhere(EName(unqualified(n), THole))

function expr_int(n: Int): At[Expr] :=
  nowhere(ELit(LInt(n)))

function expr_app(f: Id, args: List[At[Expr]]): At[Expr] :=
  nowhere(EApp(expr_var(f), args))

function pat_var(n: Id): At[Pat] :=
  nowhere(PName(unqualified(n), THole))

function placed_of(d: Mod): List[Doc[Cmd]] :=
  d.exported ++ d.builtins ++ d.implemented

function definitions(q: Prog): List[Cmd] :=
  List(for cmd in q.cmds for c in definition_in(cmd) yield c)

function definition_in(cmd: At[Cmd]): Option[Cmd] :=
  match cmd
    case AOk(_, _, that) =>
      if is_signature(that) then
        None
      else if has_unparsed(that) then
        Some(rejected(that, unparsed_errors(that)))
      else
        Some(that)

    case AErr(_, _, that, errors) =>
      if is_signature(that) then
        None
      else if errors == List() or exists(errors, blocks_run) or has_unparsed(that) then
        Some(rejected(that, errors ++ unparsed_errors(that)))
      else
        Some(that)

    // without_unparsed of ulang/parse/parse.u leaves none to the checker
    case AUnparsed(_, _, _, _) =>
      None
  end

// whether cmd has parts that do not parse, which checking keeps as written, with its names unresolved, so that no run
// takes it for checked code
function has_unparsed(cmd: Cmd): Bool :=
  unparsed_errors(cmd) != List()

function unparsed_errors(cmd: Cmd): List[Diagnostic] :=
  List(for d in part_errors(cmd) if d.kind == ParseKind)

// cmd, which checking rejected by errors, or without errors of its own if its package failed, with a body that is an
// error node of them, which a run reaches if it calls cmd
function rejected(cmd: Cmd, errors: List[Diagnostic]): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, spec, body) =>
      CFun(name, params, formals, typ, spec, with_body_errors(body, errors))

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(name, params, ins, outs, refs, raised, spec, with_body_errors(stmt, errors))

    case CTest(name, vars, stmt) =>
      CTest(name, vars, with_body_errors(stmt, errors))

    case _ =>
      cmd
  end

function with_body_errors[A](x: At[A], errors: List[Diagnostic]): At[A] :=
  match x
    case AOk(pos, span, that) =>
      AErr(pos, span, that, errors)

    case AErr(pos, span, that, own) =>
      AErr(pos, span, that, errors ++ own)

    case AUnparsed(_, _, _, _) =>
      x
  end

// whether cmd only declares, for the checker
function is_signature(cmd: Cmd): Bool :=
  match cmd
    case CFunSig(_, _, _, _, _) =>
      true

    case CProcSig(_, _, _, _, _, _, _) =>
      true

    case CPatAlias(_, _, _, _, _) =>
      true

    case _ =>
      false
  end

function commands_of(docs: List[Doc[Cmd]]): List[Cmd] :=
  parts(docs)

function stmts_of(docs: List[Doc[Stmt]]): List[At[Stmt]] :=
  List(for d in docs yield d.at)

function block(locals: List[Var], stmts: List[At[Stmt]]): Stmt :=
  SBlock(unplaced_vars(locals), List(for stmt in stmts yield Doc(None, stmt)))

function vars(xs: List[At[Var]]): List[Var] :=
  List(for x in xs yield x.that)

function unplaced_vars(xs: List[Var]): List[At[Var]] :=
  List(for x in xs yield nowhere(x))

function strip_vars(xs: List[At[Var]]): List[At[Var]] :=
  unplaced_vars(vars(xs))

function parts[A](docs: List[Doc[A]]): List[A] :=
  List(for d in docs if is_parsed(d.at) yield d.at.that)

function is_parsed[A](x: At[A]): Bool :=
  match x
    case AUnparsed(_, _, _, _) =>
      false
    case _ =>
      true
  end

function module_dir(id: Id): Str :=
  match reverse(split(id, '/'))
    case List(_; dirs) =>
      join("/", reverse(dirs))
    case List() =>
      ""
  end

function implicit_imports(name: Id): List[Id] :=
  if contains(name, library_modules()) then List() else library_modules()

function library_modules(): List[Id] :=
  List(for name in List(
    "prelude",
    "option",
    "list",
    "str",
    "set",
    "map",
    "array",
    "buffer",
    "os",
    "io") yield library_module(name))

function library_module(name: Str): Id :=
  "prelude/" ++ name

function library_file(id: Id): Str :=
  slice(id, size("prelude/"), size(id))

function library_name(module: Str, base: Id): Name :=
  Name(Some(library_module(module)), base)

function seen_modules(d: Mod, packages: List[Package]): List[Id] :=
  implicit_imports(d.name) ++ List(for p in packages if contains(p.id, d.imports) or p.id == module_dir(d.name) for m in p.members if m != d.name yield m)

// commands without positions and documentation, as programs that are not parsed have them
function unplaced(cmds: List[Cmd]): List[Doc[Cmd]] :=
  List(for c in cmds yield Doc(None, nowhere(c)))

// the variables of the formals of a checked lambda, which the checker makes variables
function lambda_vars(formals: List[At[Pat]]): List[Var] :=
  value_or(pattern_vars(formals), List())

function lambda_of(pos: Pos, span: Span, xs: List[Var], body: At[Expr]): Expr :=
  ELam(List(for x in xs yield AOk(pos, span, PVar(x))), body)

// what a form of a single generator yields without yield, the value its pattern matches, an entry of a map
function implicit_elem(form: Form, gens: List[Gen]): Option[Yield] :=
  match (List(for g in gens if not is_guard(g)), form)
    case (List(GPair(k, v, _)), FMap) =>
      pair_elem(pattern_expr(k), pattern_expr(v))

    case (List(GPair(k, v, _)), _) =>
      match (pattern_expr(k), pattern_expr(v))
        case (Some(a), Some(b)) =>
          Some(YVal(AOk(k.pos, span_over(k, v), ETuple(List(a, b)))))
        case _ =>
          None
      end

    case (List(GVal(AOk(_, _, PTuple(List(k, v))), _)), FMap) =>
      pair_elem(pattern_expr(k), pattern_expr(v))

    case (List(GVal(_, _)), FMap) =>
      None

    case (List(GVal(p, _)), _) =>
      map_option(pattern_expr(p), YVal)

    case _ =>
      None
  end

function pair_elem(k: Option[At[Expr]], v: Option[At[Expr]]): Option[Yield] :=
  match (k, v)
    case (Some(a), Some(b)) =>
      Some(YPair(a, b))
    case _ =>
      None
  end

function is_guard(g: Gen): Bool :=
  match g
    case GIf(_) =>
      true
    case _ =>
      false
  end

// the value that a pattern without _ matches, at the positions of the patterns
function pattern_expr(p: At[Pat]): Option[At[Expr]] :=
  map_option(pattern_value(p.pos, p.span, p.that), lambda e => AOk(p.pos, p.span, e))

// a call of a constructor at pos and over span, those of its pattern
function pattern_value(pos: Pos, span: Span, p: Pat): Option[Expr] :=
  match p
    case PWild =>
      None

    case PLit(lit) =>
      Some(ELit(lit))

    case PVar(x) =>
      Some(EVar(x))

    case PTuple(ps) =>
      map_option(pattern_exprs(ps), ETuple)

    case PApp(c, List()) =>
      Some(EName(c, THole))

    case PApp(c, ps) =>
      map_option(pattern_exprs(ps), lambda es => ECall(pos, span, c, THole, es))
  end

function sorts_in(t: Type): List[Name] :=
  match t
    case TSort(name, args) =>
      List(name; List(for a in args for u in sorts_in(a) yield u))

    case TFun(args, res) =>
      List(for a in args ++ List(res) for u in sorts_in(a) yield u)

    case TProc(ins, outs, refs, raised) =>
      List(for a in ins ++ outs ++ refs ++ List(raised) for u in sorts_in(a) yield u)

    case TTuple(types) =>
      List(for a in types for u in sorts_in(a) yield u)

    case _ =>
      List()
  end

// the variables that pat binds, from left to right
function pattern_vars(pats: List[At[Pat]]): Option[List[Var]] :=
  match pats
    case List() =>
      Some(List())

    case List(AOk(_, _, PVar(var)); more) =>
      match pattern_vars(more)
        case Some(xs) =>
          Some(List(var; xs))
        case None =>
          None
      end

    case _ =>
      None
  end

function pattern_names(pat: At[Pat]): List[Name] :=
  match pat.that
    case PVar(var) =>
      List(var.name)

    case PApp(_, args) =>
      List(for arg in args for name in pattern_names(arg) yield name)

    case PTuple(args) =>
      List(for arg in args for name in pattern_names(arg) yield name)

    case PWild =>
      List()

    case PLit(_) =>
      List()
  end

function pattern_exprs(ps: List[At[Pat]]): Option[List[At[Expr]]] :=
  match ps
    case List() =>
      Some(List())

    case List(p; more) =>
      match (pattern_expr(p), pattern_exprs(more))
        case (Some(e), Some(es)) =>
          Some(List(e; es))
        case _ =>
          None
      end
  end

function form_name(form: Form): Id :=
  match form
    case FList =>
      "List"

    case FSet =>
      "Set"

    case FMap =>
      "Map"

    case FArray =>
      "Array"
  end

function strip_cmd(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, spec, body) =>
      CFun(name, params, strip_vars(formals), typ, strip_spec(spec), strip_expr(body))

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(name, params, strip_vars(ins), strip_vars(outs), strip_vars(refs), raised, strip_spec(spec), strip_stmt(stmt))

    case CTest(name, vars, stmt) =>
      CTest(name, strip_vars(vars), strip_stmt(stmt))

    case CPatAlias(name, params, formals, typ, pat) =>
      CPatAlias(name, params, strip_vars(formals), typ, strip_pat(pat))

    case CLemma(name, params, ins, outs, claim, proof) =>
      CLemma(name, params, strip_vars(ins), strip_vars(outs), strip_claim(claim), map_option(proof, strip_proof))

    case CData(name, params, constrs) =>
      CData(name, params, List(for c in constrs yield Doc(c.doc, stripped(c.at, lambda x => x))))

    case CSort(_, _, _) =>
      cmd

    case CNotation(_, _, _) =>
      cmd

    case CFunSig(name, params, formals, typ, spec) =>
      CFunSig(name, params, strip_vars(formals), typ, strip_spec(spec))

    case CProcSig(name, params, ins, outs, refs, raised, spec) =>
      CProcSig(name, params, strip_vars(ins), strip_vars(outs), strip_vars(refs), raised, strip_spec(spec))

    case CAbstract(_, _) =>
      cmd
  end

function strip_spec(spec: Spec): Spec :=
  Spec(List(for a in spec.pre yield strip_expr(a)), map_option(spec.post, strip_expr), List(for x in spec.examples yield stripped(x, strip_example)))

function loop_positions(stmt: At[Stmt]): List[Pos] :=
  if not is_parsed(stmt) then List() else loop_positions_in(stmt.pos, stmt.that)

function loop_positions_in(pos: Pos, stmt: Stmt): List[Pos] :=
  match stmt
    case SWhile(_, body) =>
      List(pos; loop_positions(body))

    case SBlock(_, stmts) =>
      List(for d in stmts for p in loop_positions(d.at) yield p)

    case SIf(_, left, right) =>
      loop_positions(left) ++ loop_positions(right)

    case SMatch(_, cases) =>
      List(for d in cases for p in loop_positions(d.at.that.body) yield p)

    case SAssertRaises(_, _, body) =>
      loop_positions(body)

    case STry(body, catches) =>
      loop_positions(body) ++ List(for d in catches for p in loop_positions(d.at.that.body) yield p)

    case SFor(_, body) =>
      loop_positions(body)

    case SSkip =>
      List()

    case SAssign(_) =>
      List()

    case SCall(_, _, _, _) =>
      List()

    case SAssert(_) =>
      List()

    case SRaise(_, _) =>
      List()
  end

function strip_claim(claim: Claim): Claim :=
  match claim
    case ClaimHolds(assms, concl) =>
      ClaimHolds(List(for a in assms yield strip_expr(a)), strip_expr(concl))
    case ClaimCorrect(proc, ins, outs) =>
      ClaimCorrect(proc, List(for a in ins yield strip_expr(a)), outs)
  end

function strip_example(x: Example): Example :=
  match x
    case XHolds(expr) =>
      XHolds(strip_expr(expr))

    case XRaises(expr, pat) =>
      XRaises(strip_expr(expr), strip_pat(pat))

    case XCall(proc, ins, outs, refs) =>
      XCall(proc, List(for a in ins yield strip_expr(a)), List(for a in outs yield strip_expr(a)), List(for (a, b) in refs yield (strip_expr(a), strip_expr(b))))

    case XCallRaises(proc, ins, blanks, befores, pat) =>
      XCallRaises(proc, List(for a in ins yield strip_expr(a)), blanks, List(for a in befores yield strip_expr(a)), strip_pat(pat))
  end

// x at Pos(0, 0), with its part stripped by strip
function stripped[A](x: At[A], strip: A -> A): At[A] :=
  match x
    case AUnparsed(_, _, text, error) =>
      AUnparsed(Pos(0, 0), span_at(Pos(0, 0)), text, error with pos := Pos(0, 0))
    case _ =>
      map_at(x, strip) with pos := Pos(0, 0), span := span_at(Pos(0, 0))
  end

function strip_expr(expr: At[Expr]): At[Expr] :=
  stripped(expr, strip_node)

function strip_node(expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(_) =>
      expr

    case EApp(fun, args) =>
      EApp(strip_expr(fun), List(for a in args yield strip_expr(a)))

    case EField(base, field) =>
      EField(strip_expr(base), field)

    case EUpdate(base, field, value) =>
      EUpdate(strip_expr(base), field, strip_expr(value))

    case ELam(formals, body) =>
      ELam(List(for p in formals yield strip_pat(p)), strip_expr(body))

    case EProc(ins, outs, refs, raised, stmt) =>
      EProc(strip_vars(ins), strip_vars(outs), strip_vars(refs), raised, strip_stmt(stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (strip_pat(p), strip_expr(e))), strip_expr(body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(strip_expr(cond), strip_expr(then_expr), strip_expr(else_expr))

    case EMatch(arg, cases) =>
      EMatch(strip_expr(arg), List(for d in cases yield strip_case(d, strip_expr)))

    case ETuple(args) =>
      ETuple(List(for a in args yield strip_expr(a)))

    case EForm(form, elems, rest) =>
      EForm(form, List(for y in elems yield strip_yield(y)), map_option(rest, strip_expr))

    case EFor(form, gens, elem, rest) =>
      EFor(form, List(for g in gens yield strip_gen(g)), strip_yield(elem), map_option(rest, strip_expr))
  end

function strip_yield(y: Yield): Yield :=
  match y
    case YVal(value) =>
      YVal(strip_expr(value))
    case YPair(key, value) =>
      YPair(strip_expr(key), strip_expr(value))
  end

function strip_gen(g: Gen): Gen :=
  match g
    case GVal(pat, over) =>
      GVal(strip_pat(pat), strip_expr(over))

    case GPair(key, value, over) =>
      GPair(strip_pat(key), strip_pat(value), strip_expr(over))

    case GIf(cond) =>
      GIf(strip_expr(cond))
  end

function strip_case[A](d: Doc[Branch[A]], strip_body: A -> A): Doc[Branch[A]] :=
  Doc(d.doc, stripped(d.at, lambda br => Branch(strip_pat(br.pat), map_option(br.guard, strip_expr), strip_body(br.body))))

function strip_handler(d: Doc[Catch]): Doc[Catch] :=
  Doc(d.doc, stripped(d.at, lambda c => Catch(c.typ, strip_pat(c.pat), map_option(c.guard, strip_expr), strip_stmt(c.body))))

function strip_stmt(stmt: At[Stmt]): At[Stmt] :=
  stripped(stmt, strip_statement)

function strip_statement(stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for (x, e) in upd yield (x, strip_expr(e))))

    case SBlock(locals, stmts) =>
      SBlock(strip_vars(locals), List(for d in stmts yield Doc(d.doc, strip_stmt(d.at))))

    case SIf(cond, left, right) =>
      SIf(strip_expr(cond), strip_stmt(left), strip_stmt(right))

    case SWhile(cond, body) =>
      SWhile(strip_expr(cond), strip_stmt(body))

    case SCall(proc, ins, outs, refs) =>
      SCall(proc, List(for a in ins yield strip_expr(a)), outs, refs)

    case SMatch(arg, cases) =>
      SMatch(strip_expr(arg), List(for d in cases yield strip_case(d, strip_stmt)))

    case SAssert(cond) =>
      SAssert(strip_expr(cond))

    case SAssertRaises(typ, pat, body) =>
      SAssertRaises(typ, strip_pat(pat), strip_stmt(body))

    case SRaise(value, typ) =>
      SRaise(strip_expr(value), typ)

    case STry(body, catches) =>
      STry(strip_stmt(body), List(for d in catches yield strip_handler(d)))

    case SFor(gens, body) =>
      SFor(List(for g in gens yield strip_gen(g)), strip_stmt(body))
  end

function strip_proof(proof: Proof): Proof :=
  Proof(List(for step in proof.steps yield stripped(step, strip_step)), map_option(proof.split, lambda split => stripped(split, strip_split)))

function strip_step(step: Step): Step :=
  match step
    case StepLocal(x, value) =>
      StepLocal(nowhere(x.that), map_option(value, strip_expr))

    case StepCall(name, ins, outs) =>
      StepCall(name, List(for a in ins yield strip_expr(a)), outs)

    case StepAssert(cond) =>
      StepAssert(strip_expr(cond))

    case StepInvariant(cond) =>
      StepInvariant(strip_expr(cond))

    case StepAssign(upd) =>
      StepAssign(List(for (x, e) in upd yield (x, strip_expr(e))))
  end

function strip_split(split: Split): Split :=
  match split
    case SplitInduction(formal, cases) =>
      SplitInduction(formal, List(for d in cases yield strip_case(d, strip_proof)))

    case SplitMatch(arg, cases) =>
      SplitMatch(strip_expr(arg), List(for d in cases yield strip_case(d, strip_proof)))

    case SplitIf(cond, left, right) =>
      SplitIf(strip_expr(cond), strip_proof(left), map_option(right, strip_proof))
  end

function strip_pat(pat: At[Pat]): At[Pat] :=
  stripped(pat, strip_pattern)

function strip_pattern(pat: Pat): Pat :=
  match pat
    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield strip_pat(a)))

    case PTuple(args) =>
      PTuple(List(for a in args yield strip_pat(a)))

    case PWild =>
      pat

    case PLit(_) =>
      pat

    case PVar(_) =>
      pat
  end

function cmd_module(cmd: Cmd): Option[Id] :=
  match cmd
    case CSort(name, _, _) =>
      name.module

    case CData(name, _, _) =>
      name.module

    case CFun(name, _, _, _, _, _) =>
      name.module

    case CProc(name, _, _, _, _, _, _, _) =>
      name.module

    case CNotation(_, _, _) =>
      None

    case CTest(name, _, _) =>
      name.module

    case CFunSig(name, _, _, _, _) =>
      name.module

    case CProcSig(name, _, _, _, _, _, _) =>
      name.module

    case CAbstract(name, _) =>
      name.module

    case CPatAlias(name, _, _, _, _) =>
      name.module

    case CLemma(name, _, _, _, _, _) =>
      name.module
  end

function cmd_errors(cmd: At[Cmd]): List[Diagnostic] :=
  match cmd
    case AUnparsed(_, _, _, error) =>
      List(error)

    case AOk(_, _, that) =>
      part_errors(that)

    case AErr(_, _, that, errors) =>
      errors ++ part_errors(that)
  end

function part_errors(cmd: Cmd): List[Diagnostic] :=
  match cmd
    case CFun(_, _, _, _, spec, body) =>
      errors_in_spec(spec) ++ errors_in_expr(body)

    case CProc(_, _, _, _, _, _, spec, stmt) =>
      errors_in_spec(spec) ++ errors_in_stmt(stmt)

    case CTest(_, _, stmt) =>
      errors_in_stmt(stmt)

    case CLemma(_, _, _, _, claim, proof) =>
      errors_in_exprs(claim_exprs(claim)) ++ List(for p in proof for e in errors_in_proof(p) yield e)

    case CSort(_, _, _) =>
      List()

    case CData(_, _, _) =>
      List()

    case CNotation(_, _, _) =>
      List()

    case CFunSig(_, _, _, _, spec) =>
      errors_in_spec(spec)

    case CProcSig(_, _, _, _, _, _, spec) =>
      errors_in_spec(spec)

    case CAbstract(_, _) =>
      List()

    case CPatAlias(_, _, _, _, _) =>
      List()
  end

// those of the contract, but none of the examples, since an example that does not parse fails its test, not its
// declaration
function errors_in_spec(spec: Spec): List[Diagnostic] :=
  errors_in_exprs(spec.pre ++ List(for e in spec.post))

function claim_exprs(claim: Claim): List[At[Expr]] :=
  match claim
    case ClaimHolds(assms, concl) =>
      assms ++ List(concl)
    case ClaimCorrect(_, ins, _) =>
      ins
  end

function example_error(x: At[Example]): Option[Diagnostic] :=
  match x
    case AUnparsed(_, _, _, error) =>
      Some(error)

    case AOk(_, _, claim) =>
      first_error(errors_in_example(claim))

    case AErr(_, _, claim, _) =>
      first_error(errors_in_example(claim))
  end

function first_error(errors: List[Diagnostic]): Option[Diagnostic] :=
  match errors
    case List(e; _) =>
      Some(e)
    case List() =>
      None
  end

function errors_in_example(claim: Example): List[Diagnostic] :=
  match claim
    case XHolds(expr) =>
      errors_in_expr(expr)

    case XRaises(expr, _) =>
      errors_in_expr(expr)

    case XCall(_, ins, outs, refs) =>
      errors_in_exprs(ins ++ outs ++ List(for (a, b) in refs for e in List(a, b) yield e))

    case XCallRaises(_, ins, _, befores, _) =>
      errors_in_exprs(ins ++ befores)
  end

function errors_in_exprs(exprs: List[At[Expr]]): List[Diagnostic] :=
  List(for expr in exprs for e in errors_in_expr(expr) yield e)

function errors_in_expr(expr: At[Expr]): List[Diagnostic] :=
  match expr
    case AUnparsed(_, _, _, error) =>
      List(error)

    case AOk(_, _, that) =>
      errors_in_node(that)

    case AErr(_, _, that, errors) =>
      errors ++ errors_in_node(that)
  end

function errors_in_node(expr: Expr): List[Diagnostic] :=
  match expr
    case ELit(_) =>
      List()

    case EVar(_) =>
      List()

    case EApp(fun, args) =>
      errors_in_exprs(List(fun; args))

    case EField(base, _) =>
      errors_in_expr(base)

    case EUpdate(base, _, value) =>
      errors_in_exprs(List(base, value))

    case ELam(_, body) =>
      errors_in_expr(body)

    case EProc(_, _, _, _, stmt) =>
      errors_in_stmt(stmt)

    case ELet(bindings, body) =>
      errors_in_exprs(List(for (_, value) in bindings yield value) ++ List(body))

    case EIte(cond, then_expr, else_expr) =>
      errors_in_exprs(List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      errors_in_exprs(List(
        arg; List(for c in parts(cases) for e in List(for g in c.guard) ++ List(c.body) yield e)))

    case ETuple(args) =>
      errors_in_exprs(args)

    case EForm(_, elems, rest) =>
      errors_in_exprs(List(for y in elems for e in yielded(y) yield e) ++ List(for e in rest))

    case EFor(_, gens, elem, rest) =>
      errors_in_exprs(List(for g in gens for e in generated(g) yield e) ++ yielded(elem) ++ List(for e in rest))
  end

function yielded(y: Yield): List[At[Expr]] :=
  match y
    case YVal(value) =>
      List(value)
    case YPair(key, value) =>
      List(key, value)
  end

function generated(g: Gen): List[At[Expr]] :=
  match g
    case GVal(_, over) =>
      List(over)

    case GPair(_, _, over) =>
      List(over)

    case GIf(cond) =>
      List(cond)
  end

function errors_in_proof(proof: Proof): List[Diagnostic] :=
  List(for step in proof.steps for e in errors_in_step(step) yield e) ++ List(for split in proof.split for e in errors_in_split(split) yield e)

function errors_in_step(step: At[Step]): List[Diagnostic] :=
  match step
    case AUnparsed(_, _, _, error) =>
      List(error)

    case AOk(_, _, that) =>
      errors_in_step_node(that)

    case AErr(_, _, that, errors) =>
      errors ++ errors_in_step_node(that)
  end

function errors_in_step_node(step: Step): List[Diagnostic] :=
  match step
    case StepLocal(_, value) =>
      errors_in_exprs(List(for e in value))

    case StepCall(_, ins, _) =>
      errors_in_exprs(ins)

    case StepAssert(cond) =>
      errors_in_expr(cond)

    case StepInvariant(cond) =>
      errors_in_expr(cond)

    case StepAssign(upd) =>
      errors_in_exprs(List(for (_, e) in upd yield e))
  end

function errors_in_split(split: At[Split]): List[Diagnostic] :=
  match split
    case AUnparsed(_, _, _, error) =>
      List(error)

    case AOk(_, _, that) =>
      errors_in_split_node(that)

    case AErr(_, _, that, errors) =>
      errors ++ errors_in_split_node(that)
  end

function errors_in_split_node(split: Split): List[Diagnostic] :=
  match split
    case SplitInduction(_, cases) =>
      List(for c in parts(cases) for e in errors_in_exprs(List(for g in c.guard)) ++ errors_in_proof(c.body) yield e)

    case SplitMatch(arg, cases) =>
      errors_in_expr(arg) ++ List(for c in parts(cases) for e in errors_in_exprs(List(for g in c.guard)) ++ errors_in_proof(c.body) yield e)

    case SplitIf(cond, left, right) =>
      errors_in_expr(cond) ++ errors_in_proof(left) ++ List(for r in right for e in errors_in_proof(r) yield e)
  end

function errors_in_stmt(stmt: At[Stmt]): List[Diagnostic] :=
  match stmt
    case AUnparsed(_, _, _, error) =>
      List(error)

    case AOk(_, _, that) =>
      errors_in_stmt_node(that)

    case AErr(_, _, that, errors) =>
      errors ++ errors_in_stmt_node(that)
  end

function errors_in_stmts(stmts: List[At[Stmt]]): List[Diagnostic] :=
  List(for stmt in stmts for e in errors_in_stmt(stmt) yield e)

function errors_in_stmt_node(stmt: Stmt): List[Diagnostic] :=
  match stmt
    case SSkip =>
      List()

    case SAssign(upd) =>
      errors_in_exprs(seconds(upd))

    case SBlock(_, stmts) =>
      errors_in_stmts(stmts_of(stmts))

    case SIf(cond, left, right) =>
      errors_in_expr(cond) ++ errors_in_stmts(List(left, right))

    case SWhile(cond, body) =>
      errors_in_expr(cond) ++ errors_in_stmt(body)

    case SCall(_, ins, _, _) =>
      errors_in_exprs(ins)

    case SMatch(arg, cases) =>
      errors_in_expr(arg) ++ List(for c in parts(cases) for e in errors_in_exprs(List(for g in c.guard)) ++ errors_in_stmt(c.body) yield e)

    case SAssert(cond) =>
      errors_in_expr(cond)

    case SAssertRaises(_, _, body) =>
      errors_in_stmt(body)

    case SRaise(value, _) =>
      errors_in_expr(value)

    case STry(body, catches) =>
      errors_in_stmt(body) ++ List(for c in parts(catches) for e in errors_in_exprs(List(for g in c.guard)) ++ errors_in_stmt(c.body) yield e)

    case SFor(gens, body) =>
      errors_in_exprs(List(for g in gens for e in generated(g) yield e)) ++ errors_in_stmt(body)
  end
