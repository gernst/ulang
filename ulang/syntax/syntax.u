// the core syntax of ulang, whose parts carry the positions that the parser gives them (At),
// where constructors are prefixed by their type, since they share one namespace

export

// identifiers that never refer to declarations of modules: type parameters, modules, notation, runs, and tests
type Id :=
  Str

// module is None for locals, builtins, and names before checking
data Name :=
  // a name as written, e.g. x, f, or T, which the parser never qualifies
  case Name(module: Option[Id], base: Id)

data Type :=
  // a type that is not written, e.g. of local x := e, which the checker infers
  case THole
  // an unknown of inference, which has no concrete syntax
  case TMeta(meta: Int)
  // a type parameter, e.g. A, declared by [A, …] after the name of a declaration
  case TParam(param: Id)
  // a type T or T[A, …], applied to its arguments, e.g. Int or Map[K, V]
  case TSort(name: Name, args: List[Type])
  // a function type A -> B, (A, B, …) -> C, or () -> C
  case TFun(args: List[Type], res: Type)
  // procedures as values, (in A, out B, ref C), whose parameters have modes as in declarations
  // where raises is a TTuple of the types that it may raise, as written, or a TMeta of inference
  case TProc(ins: List[Type], outs: List[Type], refs: List[Type], raised: Type)
  // a tuple type A * B * …, where a chain is one tuple type, or () for none
  case TTuple(types: List[Type])

data Lit :=
  // ()
  case LUnit
  // true or false
  case LBool(bool: Bool)
  // a number, e.g. 42, or a negative one, e.g. -1
  case LInt(num: Int)
  // a string in double quotes, e.g. "text", with escapes, e.g. \\, \", and \n
  case LStr(text: Str)
  // a character in single quotes, e.g. 'c'
  case LChar(char: Char)

data Var :=
  // x or x: T, as a formal, local, or binding, with THole for a type not written
  case Var(name: Name, typ: Type)

// a part of the syntax at the position of its first token, or of the token that names it, which the checker keeps
data At[A] :=
  case AOk(pos: Pos, that: A)
  // a part that a phase rejected, with its error
  case AErr(pos: Pos, that: A, error: Diagnostic)
  // a part that does not parse, as written from pos to where the parser resumes
  case AUnparsed(pos: Pos, text: Str, error: Diagnostic)

// a part on lines of its own after its doc of // lines, a command, a constructor, or a case of a match or catch
data Doc[A] :=
  case Doc(doc: Option[Str], at: At[A])

data Expr :=
  // a literal
  case ELit(lit: Lit)
  // a name x of a local or a declaration, which the checker resolves
  case EVar(var: Var)
  // f(a, …) of a function or constructor, or an operator of the notation, e.g. a + b, -a, or not a, at the position of the
  // name or operator
  case EApp(fun: At[Expr], args: List[At[Expr]])
  // e.f and e with f := a, which the checker resolves by the type of e to the accessor T.f and the updater T.f:=, at the
  // position of . and with
  case EField(base: At[Expr], field: Id)
  case EUpdate(base: At[Expr], field: Id, value: At[Expr])
  // lambda p, … => body, whose formals are patterns, which it matches as let does, and which the checker makes variables,
  // keeping those that are variables and matching the others in the body, so that the backends see only variables
  case ELam(formals: List[At[Pat]], body: At[Expr])
  // lambda in x, out y, ref z => body end, which sees the variables around it but assigns only its outs and refs
  // where raised is the type of what it may raise, as of TProc, THole until the checker infers it from where it is used
  case EProc(ins: List[Var], outs: List[Var], refs: List[Var], raised: Type, stmt: At[Stmt])
  // let p := a, … in body, which binds in parallel, by irrefutable patterns
  case ELet(bindings: List[At[Pat] * At[Expr]], body: At[Expr])
  // if c then a else b
  case EIte(cond: At[Expr], then_expr: At[Expr], else_expr: At[Expr])
  // match e case p => a … end, one case per line
  case EMatch(arg: At[Expr], cases: List[Doc[Branch[At[Expr]]]])
  // a tuple (a, b, …)
  case ETuple(args: List[At[Expr]])
  // List(a, b; r), Set(…), Map(k => v; r), and Array(…), which the checker translates to the builders of their modules
  case EForm(form: Form, elems: List[Yield], rest: Option[At[Expr]])
  // List(for p in c if q yield e; r) and the like, which the checker translates to the folds of the modules of the
  // containers, where elem is what each step adds, written after yield or else the value of the single generator
  case EFor(form: Form, gens: List[Gen], elem: Yield, rest: Option[At[Expr]])

data Form :=
  // the form List(…)
  case FList
  // the form Set(…)
  case FSet
  // the form Map(…)
  case FMap
  // the form Array(…)
  case FArray

// an element of a list, set, or array, or an entry k => v of a map
data Yield :=
  // an element a
  case YVal(value: At[Expr])
  // an entry k => v
  case YPair(key: At[Expr], value: At[Expr])

data Gen :=
  // for p in c over a list, set, or array, where p is irrefutable
  case GVal(pat: At[Pat], over: At[Expr])
  // for k => v in m over a map
  case GPair(key: At[Pat], value: At[Pat], over: At[Expr])
  // a guard if q after a generator
  case GIf(cond: At[Expr])

data Pat :=
  // the wildcard _
  case PWild
  // a literal, e.g. -1 or "a"
  case PLit(lit: Lit)
  // a variable x, which binds x
  case PVar(var: Var)
  // a constructor C(p, …) or C, where List(p, …; r) and List() are Cons and Nil
  case PApp(constr: Name, args: List[At[Pat]])
  // a tuple (p, q, …)
  case PTuple(args: List[At[Pat]])

data Branch[A] :=
  // case p if g => body of a match, where if g is optional
  case Branch(pat: At[Pat], guard: Option[At[Expr]], body: A)

data Stmt :=
  // skip, also an else that is not written
  case SSkip
  // assign x := a, …, which assigns in parallel
  case SAssign(upd: List[Var * At[Expr]])
  // statements one after another, each after its doc, the body of an if, while, case, or procedure, which may declare
  // local x := e first, as assignments without docs that start stmts
  case SBlock(locals: List[Var], stmts: List[Doc[Stmt]])
  // if c then … else … end, or if c then … end
  case SIf(cond: At[Expr], left: At[Stmt], right: At[Stmt])
  // while c do … end
  case SWhile(cond: At[Expr], body: At[Stmt])
  // call p(in a, …, out x, …, ref y, …), where in is optional before the first ins
  case SCall(proc: Name, ins: List[At[Expr]], outs: List[Var], refs: List[Var])
  // match e case p => … end
  case SMatch(arg: At[Expr], cases: List[Doc[Branch[At[Stmt]]]])
  // assert c
  case SAssert(cond: At[Expr])
  // assert raises p do … end, which fails unless body raises an exception that p matches, where typ is THole until
  // the checker infers it from p, as of a Catch
  case SAssertRaises(typ: Type, pat: At[Pat], body: At[Stmt])
  // raise e, where typ is the type of e, which the checker infers
  case SRaise(value: At[Expr], typ: Type)
  // try … catch case p => … end
  case STry(body: At[Stmt], catches: List[Doc[Catch]])
  // for p in c if q do … end, or for k => v in m do … end, over the elements of any container in the order of its fold,
  // where the parser allows one generator and an optional guard, and the checker gives the backends one GVal over the list
  // of the elements and the guard as an if in the body
  case SFor(gens: List[Gen], body: At[Stmt])

// with the pattern PWild, a handler handles exceptions of any type
data Catch :=
  // case p if g => body of a catch, where typ is THole until the checker infers it from p
  case Catch(typ: Type, pat: At[Pat], guard: Option[At[Expr]], body: At[Stmt])

data Constr :=
  // case C(f: A, …) of a datatype, or case C without fields
  case Constr(name: Name, fields: List[Field])

data Field :=
  // a field f: A
  case Field(name: Id, typ: Type)

data Fixity :=
  // prefix n op …, e.g. prefix 5 not
  case FPrefix
  // postfix n op …, e.g. postfix 12 !
  case FPostfix
  // infix n op …, which does not associate, e.g. infix 6 ==
  case FInfix
  // infix left n op …, e.g. infix left 9 + -
  case FLeft
  // infix right n op …, e.g. infix right 8 ++
  case FRight

data Cmd :=
  // an alias type T[A, …] := typ
  case CSort(name: Name, params: List[Id], typ: Type)
  // data T[A, …] := case C(f: A, …) case D, one case per line
  case CData(name: Name, params: List[Id], constrs: List[Doc[Constr]])
  // function f[A, …](x: A, …): T := spec body, where spec is the lines after :=, see Spec
  case CFun(name: Name, params: List[Id], formals: List[Var], typ: Type, spec: Spec, body: At[Expr])
  // procedure p[A, …](in x: A, …, out y: B, …, ref z: C, …) := spec body, where in is optional before the first ins
  // raises T, … after the formals, where none written is none raised if it is exported, and else inferred
  case CProc(name: Name, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], raised: List[Type], spec: Spec, stmt: At[Stmt])
  // a notation, e.g. infix left 9 + -, see Fixity
  case CNotation(fixity: Fixity, prec: Int, ops: List[Id])
  // tests take no parameters, which the checker enforces
  case CTest(name: Name, vars: List[Var], stmt: At[Stmt])
  // the export section of a module, with the signatures of functions and procedures, as CFun and CProc without their
  // bodies, and abstract types, which its implementation section defines by data, and its builtin section, with the
  // signatures of exported functions and procedures that the interpreter and the runtime define; a spec follows := after
  // the head, which a signature without one has not
  case CFunSig(name: Name, params: List[Id], formals: List[Var], typ: Type, spec: Spec)
  case CProcSig(name: Name, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], raised: List[Type], spec: Spec)
  // an abstract type T[A, …], without a definition
  case CAbstract(name: Name, params: List[Id])
  // a pattern alias pattern C[A, …](x: A, …): T := pat, whose variables are the formals, each once, which the checker
  // expands at its uses in patterns, and which is a function of the same name where pat has no _
  case CPatAlias(name: Name, params: List[Id], formals: List[Var], typ: Type, pat: At[Pat])
  // lemma l[A, …](x: A, …) := requires a, … ensures b, which states b for all formals that satisfy the assumptions a, …,
  // see prove.md, and which the prover proves, while the interpreter and the compiler skip it
  case CLemma(name: Name, params: List[Id], formals: List[Var], assms: List[At[Expr]], concl: At[Expr])

// the specification of a function or procedure, lines after := of its head and before its body, where the contracts of
// prove.md, requires and ensures, will join the examples; on the first occurrence of a signature, the export of an
// exported one, and empty on its definition
data Spec :=
  // the examples, each at its keyword, which the checker translates into tests
  case Spec(examples: List[At[Example]])

// an example of a function or procedure
data Example :=
  // a Bool expression that applies the function, e.g. gcd(12, 18) == 6
  case XHolds(expr: At[Expr])
  // an application of the function that raises an exception that pat matches, e.g. chr(-1) raises NoCharacter(-1)
  case XRaises(expr: At[Expr], pat: At[Pat])
  // a call of the procedure with the expected values of its outs and each ref from before to after, e.g.
  // divmod(in 7, 2, out 3, 1) or push(in 3, ref List(1) => List(3, 1))
  case XCall(proc: Name, ins: List[At[Expr]], outs: List[At[Expr]], refs: List[At[Expr] * At[Expr]])
  // a call of the procedure that raises an exception that pat matches, with blanks, the number of its outs, written _,
  // since it does not assign them, and each ref as before, e.g. divmod(in 7, 0, out _, _) raises DivisionByZero
  case XCallRaises(proc: Name, ins: List[At[Expr]], blanks: Int, befores: List[At[Expr]], pat: At[Pat])

// the checked program: the commands of its modules with resolved names, and the module of the file that is loaded, whose
// procedures run and compile call
data Prog :=
  case Prog(cmds: List[Cmd], main: Id, errors: List[Diagnostic])

data Pos :=
  // line and column, both from 1
  case Pos(line: Int, col: Int)

// a module without sections has all its commands implemented and exports nothing
data Mod :=
  // a file of import "p" lines of packages, then export, builtin, and implementation, each followed by its commands
  case Mod(name: Id, doc: Option[Str], imports: List[Id], exported: List[Doc[Cmd]], builtins: List[Doc[Cmd]], implemented: List[Doc[Cmd]])

// the files with sections of a directory, other than project.u, which see each other's exports and notations without
// imports, known by the directory from the root, "" for the root, and prelude for the library
data Package :=
  case Package(id: Id, members: List[Id])

// the modules in load order, each after the modules it imports, where the members of a package follow each other, after
// the packages and programs that they import, and with main last
data Source :=
  // the file that is run, tested, checked, or compiled, with its imports and their packages
  case Source(mods: List[Mod], packages: List[Package], main: Id)

// a variable and an application of a variable as expressions, and a variable as a pattern, with THole for no type
pattern EName(name: Name, typ: Type): Expr :=
  EVar(Var(name, typ))

// a call of a name, whose position is that of the name, as the parser places a call at its name
pattern ECall(pos: Pos, name: Name, typ: Type, args: List[At[Expr]]): Expr :=
  EApp(AOk(pos, EVar(Var(name, typ))), args)

pattern PName(name: Name, typ: Type): Pat :=
  PVar(Var(name, typ))

function unqualified(x: Id): Name

function arity(t: Type): Int

// x at the position Pos(0, 0), of code that the parser did not read, e.g. of tests
function nowhere[A](x: A): At[A]

// the spec of a head without :=, and of the checked program, whose examples are tests
function no_spec(): Spec

// the part of x mapped by f, at the position of x
function map_at[A, B](x: At[A], f: A -> B): At[B]

function map_doc[A, B](d: Doc[A], f: A -> B): Doc[B]

function expr_var(n: Id): At[Expr]

function expr_int(n: Int): At[Expr]

function expr_app(f: Id, args: List[At[Expr]]): At[Expr]

function pat_var(n: Id): At[Pat]

function pattern_expr(p: At[Pat]): Option[At[Expr]]

function subst_pat(pat: At[Pat], sub: List[Name * At[Pat]]): At[Pat]

function pattern_names(pat: At[Pat]): List[Name]

// the variables of patterns that are all variables
function pattern_vars(pats: List[At[Pat]]): Option[List[Var]]

// the sorts that t names, as written, unqualified or qualified
function sorts_in(t: Type): List[Name]

function implicit_elem(form: Form, gens: List[Gen]): Option[Yield]

function form_name(form: Form): Id

function lambda_vars(formals: List[At[Pat]]): List[Var]

// a lambda of the variables xs, placed at pos
function lambda_of(pos: Pos, xs: List[Var], body: At[Expr]): Expr

function placed_of(d: Mod): List[Doc[Cmd]]

function commands_of(docs: List[Doc[Cmd]]): List[Cmd]

// the parts of docs, without their docs and positions
function parts[A](docs: List[Doc[A]]): List[A]

// the statements of docs, without their docs
function stmts_of(docs: List[Doc[Stmt]]): List[At[Stmt]]

// a block of stmts without docs
function block(locals: List[Var], stmts: List[At[Stmt]]): Stmt

// the modules that module name imports without saying so: for a module of a project the library but enumerate, which only
// the generated tests of lemmas name, and none for a module of the library, which sees the others as the members of its
// package
function implicit_imports(name: Id): List[Id]

// the members of the package of the library
function library_modules(): List[Id]

// the module of the library of the file name.u of the library, known as prelude/name, since the library is the package prelude
function library_module(name: Str): Id

// the name of the file of a module of the library without .u, as os_library reads it
function library_file(id: Id): Str

function library_name(module: Str, base: Id): Name

// the directory of a module from the root of its project, "" for the root, and prelude for the library
function module_dir(id: Id): Str

// the modules that d sees besides itself: the implicit imports, the members of the packages it imports, and the members
// of the package of its directory, whose member it is or, for a program, not
function seen_modules(d: Mod, packages: List[Package]): List[Id]

function unplaced(cmds: List[Cmd]): List[Doc[Cmd]]

// cmd with every position Pos(0, 0), which parsing the same text at other places gives the same
function strip_cmd(cmd: Cmd): Cmd

function strip_expr(expr: At[Expr]): At[Expr]

function strip_stmt(stmt: At[Stmt]): At[Stmt]

function strip_pat(pat: At[Pat]): At[Pat]

// the escapes of literals, each the character after \ with the character that it stands for, as the lexer reads them and
// the printers write them, where a quote is escaped only in a literal that it delimits; the runtime writes them by escape
// of ulang/runtime/ulang.c, which the test escapes_round_trip of ulang/parse/lex.u keeps in step
function escapes(): List[Char * Char]

// c in a literal delimited by the quote delimiter, escaped if it needs to be
function escape(c: Char, delimiter: Char): Str

// the characters of operators, as the lexer reads them and the printer separates them
function is_op_char(c: Char): Bool

implementation

function escapes(): List[Char * Char] :=
  List(
    ('"', '"'),
    ('\'', '\''),
    ('\\', '\\'),
    ('n', '\n'),
    ('t', '\t'),
    ('r', '\r'))

function is_op_char(c: Char): Bool :=
  contains(c, "-+*/%<>=!&:^~?@#$")

function escape(c: Char, delimiter: Char): Str :=
  match find(escapes(), lambda (_, d) => d == c)
    case Some((e, _)) if c == delimiter or not contains(c, "\"'") =>
      str(List('\\', e))
    case _ =>
      str(List(c))
  end

// a name without a module, of a local or a builtin, or before checking
function unqualified(x: Id): Name :=
  Name(None, x)

// the number of arguments of a function type, functions are overloaded by it
function arity(t: Type): Int :=
  match t
    case TFun(args, _) =>
      size(args)
    case _ =>
      -1
  end

function no_spec(): Spec :=
  Spec(List())

function nowhere[A](x: A): At[A] :=
  AOk(Pos(0, 0), x)

function map_at[A, B](x: At[A], f: A -> B): At[B] :=
  match x
    case AOk(pos, that) =>
      AOk(pos, f(that))

    case AErr(pos, that, error) =>
      AErr(pos, f(that), error)

    case AUnparsed(pos, text, error) =>
      AUnparsed(pos, text, error)
  end

function map_doc[A, B](d: Doc[A], f: A -> B): Doc[B] :=
  Doc(d.doc, map_at(d.at, f))

// abbreviations for the syntax, of tests
function expr_var(n: Id): At[Expr] :=
  nowhere(EName(unqualified(n), THole))

function expr_int(n: Int): At[Expr] :=
  nowhere(ELit(LInt(n)))

function expr_app(f: Id, args: List[At[Expr]]): At[Expr] :=
  nowhere(EApp(expr_var(f), args))

function pat_var(n: Id): At[Pat] :=
  nowhere(PName(unqualified(n), THole))

function placed_of(d: Mod): List[Doc[Cmd]] :=
  d.exported ++ d.builtins ++ d.implemented

function commands_of(docs: List[Doc[Cmd]]): List[Cmd] :=
  parts(docs)

function stmts_of(docs: List[Doc[Stmt]]): List[At[Stmt]] :=
  List(for d in docs yield d.at)

function block(locals: List[Var], stmts: List[At[Stmt]]): Stmt :=
  SBlock(locals, List(for stmt in stmts yield Doc(None, stmt)))

function parts[A](docs: List[Doc[A]]): List[A] :=
  List(for d in docs yield d.at.that)

function module_dir(id: Id): Str :=
  match reverse(split(id, '/'))
    case List(_; dirs) =>
      join("/", reverse(dirs))
    case List() =>
      ""
  end

function implicit_imports(name: Id): List[Id] :=
  if contains(name, library_modules()) then
    List()
  else
    List(for m in library_modules() if m != library_module("enumerate"))

function library_modules(): List[Id] :=
  List(for name in List(
    "prelude",
    "option",
    "list",
    "str",
    "set",
    "map",
    "array",
    "buffer",
    "os",
    "enumerate") yield library_module(name))

function library_module(name: Str): Id :=
  "prelude/" ++ name

function library_file(id: Id): Str :=
  slice(id, size("prelude/"), size(id))

function library_name(module: Str, base: Id): Name :=
  Name(Some(library_module(module)), base)

function seen_modules(d: Mod, packages: List[Package]): List[Id] :=
  implicit_imports(d.name) ++ List(for p in packages if contains(p.id, d.imports) or p.id == module_dir(d.name) for m in p.members if m != d.name yield m)

// commands without positions and documentation, as programs that are not parsed have them
function unplaced(cmds: List[Cmd]): List[Doc[Cmd]] :=
  List(for c in cmds yield Doc(None, nowhere(c)))

// the variables of the formals of a checked lambda, which the checker makes variables
function lambda_vars(formals: List[At[Pat]]): List[Var] :=
  value_or(pattern_vars(formals), List())

function lambda_of(pos: Pos, xs: List[Var], body: At[Expr]): Expr :=
  ELam(List(for x in xs yield AOk(pos, PVar(x))), body)

// what a form of a single generator yields without yield, the value its pattern matches, an entry of a map
function implicit_elem(form: Form, gens: List[Gen]): Option[Yield] :=
  match (List(for g in gens if not is_guard(g)), form)
    case (List(GPair(k, v, _)), FMap) =>
      pair_elem(pattern_expr(k), pattern_expr(v))

    case (List(GPair(k, v, _)), _) =>
      match (pattern_expr(k), pattern_expr(v))
        case (Some(a), Some(b)) =>
          Some(YVal(AOk(k.pos, ETuple(List(a, b)))))
        case _ =>
          None
      end

    case (List(GVal(AOk(_, PTuple(List(k, v))), _)), FMap) =>
      pair_elem(pattern_expr(k), pattern_expr(v))

    case (List(GVal(_, _)), FMap) =>
      None

    case (List(GVal(p, _)), _) =>
      map_option(pattern_expr(p), YVal)

    case _ =>
      None
  end

function pair_elem(k: Option[At[Expr]], v: Option[At[Expr]]): Option[Yield] :=
  match (k, v)
    case (Some(a), Some(b)) =>
      Some(YPair(a, b))
    case _ =>
      None
  end

function is_guard(g: Gen): Bool :=
  match g
    case GIf(_) =>
      true
    case _ =>
      false
  end

// the value that a pattern without _ matches, at the positions of the patterns
function pattern_expr(p: At[Pat]): Option[At[Expr]] :=
  map_option(pattern_value(p.pos, p.that), lambda e => AOk(p.pos, e))

function pattern_value(pos: Pos, p: Pat): Option[Expr] :=
  match p
    case PWild =>
      None

    case PLit(lit) =>
      Some(ELit(lit))

    case PVar(x) =>
      Some(EVar(x))

    case PTuple(ps) =>
      map_option(pattern_exprs(ps), ETuple)

    case PApp(c, List()) =>
      Some(EName(c, THole))

    case PApp(c, ps) =>
      map_option(pattern_exprs(ps), lambda es => ECall(pos, c, THole, es))
  end

// pat with the patterns of sub for its variables
function subst_pat(pat: At[Pat], sub: List[Name * At[Pat]]): At[Pat] :=
  match pat.that
    case PVar(var) =>
      value_or(get(var.name, sub), pat)

    case PApp(constr, args) =>
      pat with that := PApp(constr, List(for a in args yield subst_pat(a, sub)))

    case PTuple(args) =>
      pat with that := PTuple(List(for a in args yield subst_pat(a, sub)))

    case _ =>
      pat
  end

function sorts_in(t: Type): List[Name] :=
  match t
    case TSort(name, args) =>
      List(name; List(for a in args for u in sorts_in(a) yield u))

    case TFun(args, res) =>
      List(for a in args ++ List(res) for u in sorts_in(a) yield u)

    case TProc(ins, outs, refs, raised) =>
      List(for a in ins ++ outs ++ refs ++ List(raised) for u in sorts_in(a) yield u)

    case TTuple(types) =>
      List(for a in types for u in sorts_in(a) yield u)

    case _ =>
      List()
  end

// the variables that pat binds, from left to right
function pattern_vars(pats: List[At[Pat]]): Option[List[Var]] :=
  match pats
    case List() =>
      Some(List())

    case List(AOk(_, PVar(var)); more) =>
      match pattern_vars(more)
        case Some(xs) =>
          Some(List(var; xs))
        case None =>
          None
      end

    case _ =>
      None
  end

function pattern_names(pat: At[Pat]): List[Name] :=
  match pat.that
    case PVar(var) =>
      List(var.name)

    case PApp(_, args) =>
      List(for arg in args for name in pattern_names(arg) yield name)

    case PTuple(args) =>
      List(for arg in args for name in pattern_names(arg) yield name)

    case PWild =>
      List()

    case PLit(_) =>
      List()
  end

function pattern_exprs(ps: List[At[Pat]]): Option[List[At[Expr]]] :=
  match ps
    case List() =>
      Some(List())

    case List(p; more) =>
      match (pattern_expr(p), pattern_exprs(more))
        case (Some(e), Some(es)) =>
          Some(List(e; es))
        case _ =>
          None
      end
  end

function form_name(form: Form): Id :=
  match form
    case FList =>
      "List"

    case FSet =>
      "Set"

    case FMap =>
      "Map"

    case FArray =>
      "Array"
  end

function strip_cmd(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, spec, body) =>
      CFun(name, params, formals, typ, strip_spec(spec), strip_expr(body))

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(name, params, ins, outs, refs, raised, strip_spec(spec), strip_stmt(stmt))

    case CTest(name, vars, stmt) =>
      CTest(name, vars, strip_stmt(stmt))

    case CPatAlias(name, params, formals, typ, pat) =>
      CPatAlias(name, params, formals, typ, strip_pat(pat))

    case CLemma(name, params, formals, assms, concl) =>
      CLemma(name, params, formals, List(for a in assms yield strip_expr(a)), strip_expr(concl))

    case CData(name, params, constrs) =>
      CData(name, params, List(for c in constrs yield Doc(c.doc, stripped(c.at, lambda x => x))))

    case CSort(_, _, _) =>
      cmd

    case CNotation(_, _, _) =>
      cmd

    case CFunSig(name, params, formals, typ, spec) =>
      CFunSig(name, params, formals, typ, strip_spec(spec))

    case CProcSig(name, params, ins, outs, refs, raised, spec) =>
      CProcSig(name, params, ins, outs, refs, raised, strip_spec(spec))

    case CAbstract(_, _) =>
      cmd
  end

function strip_spec(spec: Spec): Spec :=
  Spec(List(for x in spec.examples yield stripped(x, strip_example)))

function strip_example(x: Example): Example :=
  match x
    case XHolds(expr) =>
      XHolds(strip_expr(expr))

    case XRaises(expr, pat) =>
      XRaises(strip_expr(expr), strip_pat(pat))

    case XCall(proc, ins, outs, refs) =>
      XCall(proc, List(for a in ins yield strip_expr(a)), List(for a in outs yield strip_expr(a)), List(for (a, b) in refs yield (strip_expr(a), strip_expr(b))))

    case XCallRaises(proc, ins, blanks, befores, pat) =>
      XCallRaises(proc, List(for a in ins yield strip_expr(a)), blanks, List(for a in befores yield strip_expr(a)), strip_pat(pat))
  end

// x at Pos(0, 0), with its part stripped by strip
function stripped[A](x: At[A], strip: A -> A): At[A] :=
  map_at(x, strip) with pos := Pos(0, 0)

function strip_expr(expr: At[Expr]): At[Expr] :=
  stripped(expr, strip_node)

function strip_node(expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(_) =>
      expr

    case EApp(fun, args) =>
      EApp(strip_expr(fun), List(for a in args yield strip_expr(a)))

    case EField(base, field) =>
      EField(strip_expr(base), field)

    case EUpdate(base, field, value) =>
      EUpdate(strip_expr(base), field, strip_expr(value))

    case ELam(formals, body) =>
      ELam(List(for p in formals yield strip_pat(p)), strip_expr(body))

    case EProc(ins, outs, refs, raised, stmt) =>
      EProc(ins, outs, refs, raised, strip_stmt(stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (strip_pat(p), strip_expr(e))), strip_expr(body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(strip_expr(cond), strip_expr(then_expr), strip_expr(else_expr))

    case EMatch(arg, cases) =>
      EMatch(strip_expr(arg), List(for d in cases yield strip_case(d, strip_expr)))

    case ETuple(args) =>
      ETuple(List(for a in args yield strip_expr(a)))

    case EForm(form, elems, rest) =>
      EForm(form, List(for y in elems yield strip_yield(y)), map_option(rest, strip_expr))

    case EFor(form, gens, elem, rest) =>
      EFor(form, List(for g in gens yield strip_gen(g)), strip_yield(elem), map_option(rest, strip_expr))
  end

function strip_yield(y: Yield): Yield :=
  match y
    case YVal(value) =>
      YVal(strip_expr(value))
    case YPair(key, value) =>
      YPair(strip_expr(key), strip_expr(value))
  end

function strip_gen(g: Gen): Gen :=
  match g
    case GVal(pat, over) =>
      GVal(strip_pat(pat), strip_expr(over))

    case GPair(key, value, over) =>
      GPair(strip_pat(key), strip_pat(value), strip_expr(over))

    case GIf(cond) =>
      GIf(strip_expr(cond))
  end

function strip_case[A](d: Doc[Branch[A]], strip_body: A -> A): Doc[Branch[A]] :=
  Doc(d.doc, stripped(d.at, lambda br => Branch(strip_pat(br.pat), map_option(br.guard, strip_expr), strip_body(br.body))))

function strip_handler(d: Doc[Catch]): Doc[Catch] :=
  Doc(d.doc, stripped(d.at, lambda c => Catch(c.typ, strip_pat(c.pat), map_option(c.guard, strip_expr), strip_stmt(c.body))))

function strip_stmt(stmt: At[Stmt]): At[Stmt] :=
  stripped(stmt, strip_statement)

function strip_statement(stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for (x, e) in upd yield (x, strip_expr(e))))

    case SBlock(locals, stmts) =>
      SBlock(locals, List(for d in stmts yield Doc(d.doc, strip_stmt(d.at))))

    case SIf(cond, left, right) =>
      SIf(strip_expr(cond), strip_stmt(left), strip_stmt(right))

    case SWhile(cond, body) =>
      SWhile(strip_expr(cond), strip_stmt(body))

    case SCall(proc, ins, outs, refs) =>
      SCall(proc, List(for a in ins yield strip_expr(a)), outs, refs)

    case SMatch(arg, cases) =>
      SMatch(strip_expr(arg), List(for d in cases yield strip_case(d, strip_stmt)))

    case SAssert(cond) =>
      SAssert(strip_expr(cond))

    case SAssertRaises(typ, pat, body) =>
      SAssertRaises(typ, strip_pat(pat), strip_stmt(body))

    case SRaise(value, typ) =>
      SRaise(strip_expr(value), typ)

    case STry(body, catches) =>
      STry(strip_stmt(body), List(for d in catches yield strip_handler(d)))

    case SFor(gens, body) =>
      SFor(List(for g in gens yield strip_gen(g)), strip_stmt(body))
  end

function strip_pat(pat: At[Pat]): At[Pat] :=
  stripped(pat, strip_pattern)

function strip_pattern(pat: Pat): Pat :=
  match pat
    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield strip_pat(a)))

    case PTuple(args) =>
      PTuple(List(for a in args yield strip_pat(a)))

    case PWild =>
      pat

    case PLit(_) =>
      pat

    case PVar(_) =>
      pat
  end
