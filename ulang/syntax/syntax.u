// the core syntax of ulang, without positions,
// where constructors are prefixed by their type, since they share one namespace

export

// identifiers that never refer to declarations of modules: type parameters, modules, notation, runs, and tests
type Id :=
  Str

// module is None for locals, builtins, and names before checking
data Name :=
  // a name as written, e.g. x, f, or T, which the parser never qualifies
  case Name(module: Option[Id], base: Id)

data Type :=
  // a type that is not written, e.g. of local x := e, which the checker infers
  case THole
  // an unknown of inference, which has no concrete syntax
  case TMeta(meta: Int)
  // a type parameter, e.g. A, declared by [A, …] after the name of a declaration
  case TParam(param: Id)
  // a type T or T[A, …], applied to its arguments, e.g. Int or Map[K, V]
  case TSort(name: Name, args: List[Type])
  // a function type A -> B, (A, B, …) -> C, or () -> C
  case TFun(args: List[Type], res: Type)
  // procedures as values, (in A, out B, ref C), whose parameters have modes as in declarations
  case TProc(ins: List[Type], outs: List[Type], refs: List[Type])
  // a tuple type A * B * …, where a chain is one tuple type, or () for none
  case TTuple(types: List[Type])

data Lit :=
  // ()
  case LUnit
  // true or false
  case LBool(bool: Bool)
  // a number, e.g. 42, or a negative one, e.g. -1
  case LInt(num: Int)
  // a string in double quotes, e.g. "text", with escapes, e.g. \\, \", and \n
  case LStr(text: Str)
  // a character in single quotes, e.g. 'c'
  case LChar(char: Char)

data Var :=
  // x or x: T, as a formal, local, or binding, with THole for a type not written
  case Var(name: Name, typ: Type)

data Expr :=
  // a literal
  case ELit(lit: Lit)
  // a name x of a local or a declaration, which the checker resolves
  case EVar(var: Var)
  // f(a, …) of a function or constructor, or an operator of the notation, e.g. a + b, -a, or not a
  case EApp(fun: Expr, args: List[Expr])
  // e.f and e with f := a, which the checker resolves by the type of e to the accessor T.f and the updater T.f:=
  case EField(base: Expr, field: Id)
  case EUpdate(base: Expr, field: Id, value: Expr)
  // lambda x, … => body, see lambda_patterns for formals that are patterns
  case ELam(formals: List[Var], body: Expr)
  // lambda in x, out y, ref z => body end, which sees the variables around it but assigns only its outs and refs
  case EProc(ins: List[Var], outs: List[Var], refs: List[Var], stmt: Stmt)
  // let p := a, … in body, which binds in parallel, by irrefutable patterns
  case ELet(bindings: List[Pat * Expr], body: Expr)
  // if c then a else b
  case EIte(cond: Expr, then_expr: Expr, else_expr: Expr)
  // match e case p => a … end, one case per line
  case EMatch(arg: Expr, cases: List[Branch[Expr]])
  // a tuple (a, b, …)
  case ETuple(args: List[Expr])
  // List(a, b; r), Set(…), Map(k => v; r), and Array(…), which the checker translates to the builders of their modules
  case EForm(form: Form, elems: List[Yield], rest: Option[Expr])
  // List(for p in c if q yield e; r) and the like, which the checker translates to the folds of the modules of the
  // containers, where elem is what each step adds, written after yield or else the value of the single generator
  case EFor(form: Form, gens: List[Gen], elem: Yield, rest: Option[Expr])
  // expr at the position of the token that names it, which the parser adds to the uses of names, accesses and updates of
  // fields, and forms, and the checker drops, reporting an error inside at the innermost position
  case EAt(pos: Pos, expr: Expr)

data Form :=
  // the form List(…)
  case FList
  // the form Set(…)
  case FSet
  // the form Map(…)
  case FMap
  // the form Array(…)
  case FArray

// an element of a list, set, or array, or an entry k => v of a map
data Yield :=
  // an element a
  case YVal(value: Expr)
  // an entry k => v
  case YPair(key: Expr, value: Expr)

data Gen :=
  // for p in c over a list, set, or array, where p is irrefutable
  case GVal(pat: Pat, over: Expr)
  // for k => v in m over a map
  case GPair(key: Pat, value: Pat, over: Expr)
  // a guard if q after a generator
  case GIf(cond: Expr)

data Pat :=
  // the wildcard _
  case PWild
  // a literal, e.g. -1 or "a"
  case PLit(lit: Lit)
  // a variable x, which binds x
  case PVar(var: Var)
  // a constructor C(p, …) or C, where List(p, …; r) and List() are Cons and Nil
  case PApp(constr: Name, args: List[Pat])
  // a tuple (p, q, …)
  case PTuple(args: List[Pat])
  // pat at its position, which the parser adds to constructors and the checker drops, as for EAt
  case PAt(pos: Pos, pat: Pat)

data Branch[A] :=
  // case p if g => body of a match, where if g is optional
  case Branch(doc: Str, pat: Pat, guard: Option[Expr], body: A)

data Stmt :=
  // skip, also an else that is not written
  case SSkip
  // assign x := a, …, which assigns in parallel
  case SAssign(upd: List[Var * Expr])
  // statements one after another, the body of an if, while, case, or procedure, which may declare local x := e first
  case SBlock(locals: List[Var], stmts: List[Stmt])
  // if c then … else … end, or if c then … end
  case SIf(cond: Expr, left: Stmt, right: Stmt)
  // while c do … end
  case SWhile(cond: Expr, body: Stmt)
  // call p(in a, …, out x, …, ref y, …), where in is optional before the first ins
  case SCall(proc: Name, ins: List[Expr], outs: List[Var], refs: List[Var])
  // match e case p => … end
  case SMatch(arg: Expr, cases: List[Branch[Stmt]])
  // assert c
  case SAssert(cond: Expr)
  // assert raises p do … end, which fails unless body raises an exception that p matches, where typ is THole until
  // the checker infers it from p, as of a Catch
  case SAssertRaises(typ: Type, pat: Pat, body: Stmt)
  // raise e, where typ is the type of e, which the checker infers
  case SRaise(value: Expr, typ: Type)
  // try … catch case p => … end
  case STry(body: Stmt, catches: List[Catch])
  // stmt at the position of its keyword, which the parser adds to each statement and the checker drops, as for EAt
  case SAt(pos: Pos, stmt: Stmt)

// with the pattern PWild, a handler handles exceptions of any type
data Catch :=
  // case p if g => body of a catch, where typ is THole until the checker infers it from p
  case Catch(doc: Str, typ: Type, pat: Pat, guard: Option[Expr], body: Stmt)

data Constr :=
  // case C(f: A, …) of a datatype, or case C without fields
  case Constr(doc: Str, name: Name, fields: List[Field])

data Field :=
  // a field f: A
  case Field(name: Id, typ: Type)

data Fixity :=
  // prefix n op …, e.g. prefix 5 not
  case FPrefix
  // postfix n op …, e.g. postfix 12 !
  case FPostfix
  // infix n op …, which does not associate, e.g. infix 6 ==
  case FInfix
  // infix left n op …, e.g. infix left 9 + -
  case FLeft
  // infix right n op …, e.g. infix right 8 ++
  case FRight

data Cmd :=
  // an alias type T[A, …] := typ
  case CSort(name: Name, params: List[Id], typ: Type)
  // data T[A, …] := case C(f: A, …) case D, one case per line
  case CData(name: Name, params: List[Id], constrs: List[Constr])
  // function f[A, …](x: A, …): T := body
  case CFun(name: Name, params: List[Id], formals: List[Var], typ: Type, body: Expr)
  // procedure p[A, …](in x: A, …, out y: B, …, ref z: C, …) := body, where in is optional before the first ins
  case CProc(name: Name, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], stmt: Stmt)
  // a notation, e.g. infix left 9 + -, see Fixity
  case CNotation(fixity: Fixity, prec: Int, ops: List[Id])
  // tests take no parameters, which the checker enforces
  case CTest(name: Name, vars: List[Var], stmt: Stmt)
  // the export section of a module, with the signatures of functions and procedures, as CFun and CProc without their
  // bodies, and abstract types, which its implementation section defines by data, and its builtin section, with the
  // signatures of exported functions and procedures that the interpreter and the runtime define
  case CFunSig(name: Name, params: List[Id], formals: List[Var], typ: Type)
  case CProcSig(name: Name, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var])
  // an abstract type T[A, …], without a definition
  case CAbstract(name: Name, params: List[Id])
  // a pattern alias pattern C[A, …](x: A, …): T := pat, whose variables are the formals, each once, which the checker
  // expands at its uses in patterns, and which is a function of the same name where pat has no _
  case CPatAlias(name: Name, params: List[Id], formals: List[Var], typ: Type, pat: Pat)
  // lemma l[A, …](x: A, …) := requires a, … ensures b, which states b for all formals that satisfy the assumptions a, …,
  // see prove.md, and which the prover proves, while the interpreter and the compiler skip it
  case CLemma(name: Name, params: List[Id], formals: List[Var], assms: List[Expr], concl: Expr)

// the checked program: the commands of its modules with resolved names, and the module of the file that is loaded, whose
// procedures run and compile call
data Prog :=
  case Prog(cmds: List[Cmd], main: Id)

data Pos :=
  // line and column, both from 1
  case Pos(line: Int, col: Int)

// a command with its position and its documentation, which is empty if there is none
data Top :=
  // a command after its doc of // lines
  case Top(pos: Pos, doc: Str, cmd: Cmd)

// a module without sections has all its commands implemented and exports nothing
data Mod :=
  // a file of import "p" lines of packages, then export, builtin, and implementation, each followed by its commands
  case Mod(name: Id, doc: Str, imports: List[Id], exported: List[Top], builtins: List[Top], implemented: List[Top])

// the files with sections of a directory, other than project.u, which see each other's exports and notations without
// imports, known by the directory from the root, "" for the root, and prelude for the library
data Package :=
  case Package(id: Id, members: List[Id])

// the modules in load order, each after the modules it imports, where the members of a package follow each other, after
// the packages and programs that they import, and with main last
data Source :=
  // the file that is run, tested, checked, or compiled, with its imports and their packages
  case Source(mods: List[Mod], packages: List[Package], main: Id)

// a variable and an application of a variable as expressions, and a variable as a pattern, with THole for no type
pattern EName(name: Name, typ: Type): Expr :=
  EVar(Var(name, typ))

pattern ECall(name: Name, typ: Type, args: List[Expr]): Expr :=
  EApp(EVar(Var(name, typ)), args)

pattern PName(name: Name, typ: Type): Pat :=
  PVar(Var(name, typ))

// the block of for p in c if q do body end, with guarded the body under the condition, which runs it for the elements of
// the container in the order of its fold, where the elements are collected first, List(for item in c), and then taken off
// one by one, by a while loop
//   local items := List(for item in c)
//   while items != List() match items case List(p; rest) => guarded; assign items := rest case List() => skip end end
// with names that users cannot write, which nested loops hide; the parser makes it and the printer reads it back
pattern ForBlock(pat: Pat, over: Expr, guarded: Stmt): Stmt :=
  SBlock(List(Var(Name(None, "(items)"), THole)), List(
    SAssign(List(
      (Var(Name(None, "(items)"), THole), EFor(FList, List(GVal(PName(Name(None, "(item)"), THole), over)), YVal(EName(Name(None, "(item)"), THole)), None)))),
    SWhile(ECall(Name(None, "!="), THole, List(EName(Name(None, "(items)"), THole), EName(Name(None, "Nil"), THole))), SMatch(EName(Name(None, "(items)"), THole), List(
      Branch("", PApp(Name(None, "Cons"), List(pat, PName(Name(None, "(rest)"), THole))), None, SBlock(List(), List(
        guarded,
        SAssign(List(
          (Var(Name(None, "(items)"), THole), EName(Name(None, "(rest)"), THole))))))),
      Branch("", PApp(Name(None, "Nil"), List()), None, SSkip))))))

function unqualified(x: Id): Name

function arity(t: Type): Int

function expr_var(n: Id): Expr

function expr_int(n: Int): Expr

function expr_app(f: Id, args: List[Expr]): Expr

function pat_var(n: Id): Pat

function lambda_patterns(pats: List[Pat], body: Expr): Expr

function pattern_expr(p: Pat): Option[Expr]

function subst_pat(pat: Pat, sub: List[Name * Pat]): Pat

function pattern_names(pat: Pat): List[Name]

// the variables of patterns that are all variables
function pattern_vars(pats: List[Pat]): Option[List[Var]]

// the sorts that t names, as written, unqualified or qualified
function sorts_in(t: Type): List[Name]

function implicit_elem(form: Form, gens: List[Gen]): Option[Yield]

function form_name(form: Form): Id

function patterns_of_lambda(formals: List[Var], body: Expr): Option[List[Pat] * Expr]

function placed_of(d: Mod): List[Top]

function commands_of(tops: List[Top]): List[Cmd]

// the modules that module name imports without saying so: for a module of a project the whole library, and none for a
// module of the library, which sees the others as the members of its package
function implicit_imports(name: Id): List[Id]

// the members of the package of the library
function library_modules(): List[Id]

// the module of the library of the file name.u of the library, known as prelude/name, since the library is the package prelude
function library_module(name: Str): Id

// the name of the file of a module of the library without .u, as os_library reads it
function library_file(id: Id): Str

function library_name(module: Str, base: Id): Name

// the directory of a module from the root of its project, "" for the root, and prelude for the library
function module_dir(id: Id): Str

// the modules that d sees besides itself: the implicit imports, the members of the packages it imports, and the members
// of the package of its directory, whose member it is or, for a program, not
function seen_modules(d: Mod, packages: List[Package]): List[Id]

function unplaced(cmds: List[Cmd]): List[Top]

// cmd without the positions EAt, SAt, and PAt, which parsing the same text at other places gives the same
function strip_cmd(cmd: Cmd): Cmd

function strip_expr(expr: Expr): Expr

function strip_stmt(stmt: Stmt): Stmt

function strip_pat(pat: Pat): Pat

// the escapes of literals, each the character after \ with the character that it stands for, as the lexer reads them and
// the printers write them, where a quote is escaped only in a literal that it delimits; the runtime writes them by escape
// of ulang/runtime/ulang.c, which the test escapes_round_trip of ulang/parse/lex.u keeps in step
function escapes(): List[Char * Char]

// c in a literal delimited by the quote delimiter, escaped if it needs to be
function escape(c: Char, delimiter: Char): Str

// the characters of operators, as the lexer reads them and the printer separates them
function is_op_char(c: Char): Bool

implementation

function escapes(): List[Char * Char] :=
  List(
    ('"', '"'),
    ('\'', '\''),
    ('\\', '\\'),
    ('n', '\n'),
    ('t', '\t'),
    ('r', '\r'))

function is_op_char(c: Char): Bool :=
  contains(c, "-+*/%<>=!&:^~?@#$")

function escape(c: Char, delimiter: Char): Str :=
  match find(escapes(), lambda (_, d) => d == c)
    case Some((e, _)) if c == delimiter or not contains(c, "\"'") =>
      str(List('\\', e))
    case _ =>
      str(List(c))
  end

// a name without a module, of a local or a builtin, or before checking
function unqualified(x: Id): Name :=
  Name(None, x)

// the number of arguments of a function type, functions are overloaded by it
function arity(t: Type): Int :=
  match t
    case TFun(args, _) =>
      size(args)
    case _ =>
      -1
  end

// abbreviations for the syntax, of the parser and of tests
function expr_var(n: Id): Expr :=
  EName(unqualified(n), THole)

function expr_int(n: Int): Expr :=
  ELit(LInt(n))

function expr_app(f: Id, args: List[Expr]): Expr :=
  EApp(expr_var(f), args)

function pat_var(n: Id): Pat :=
  PName(unqualified(n), THole)

function placed_of(d: Mod): List[Top] :=
  d.exported ++ d.builtins ++ d.implemented

function commands_of(tops: List[Top]): List[Cmd] :=
  List(for top in tops yield top.cmd)

function module_dir(id: Id): Str :=
  match reverse(split(id, '/'))
    case List(_; dirs) =>
      join("/", reverse(dirs))
    case List() =>
      ""
  end

function implicit_imports(name: Id): List[Id] :=
  if contains(name, library_modules()) then List() else library_modules()

function library_modules(): List[Id] :=
  List(for name in List(
    "prelude",
    "option",
    "list",
    "str",
    "set",
    "map",
    "array",
    "buffer",
    "os") yield library_module(name))

function library_module(name: Str): Id :=
  "prelude/" ++ name

function library_file(id: Id): Str :=
  slice(id, size("prelude/"), size(id))

function library_name(module: Str, base: Id): Name :=
  Name(Some(library_module(module)), base)

function seen_modules(d: Mod, packages: List[Package]): List[Id] :=
  implicit_imports(d.name) ++ List(for p in packages if contains(p.id, d.imports) or p.id == module_dir(d.name) for m in p.members if m != d.name yield m)

// commands without positions and documentation, as programs that are not parsed have them
function unplaced(cmds: List[Cmd]): List[Top] :=
  List(for c in cmds yield Top(Pos(0, 0), "", c))

// lambda p, q => e with patterns p and q is lambda (1), (2) => match ((1), (2)) case (p, q) => e end, with formals that
// users cannot write, and lambda (1) => match (1) case p => e end for one pattern
function lambda_patterns(pats: List[Pat], body: Expr): Expr :=
  let xs := pattern_formals(size(pats)) in
  ELam(xs, EMatch(pattern_scrutinee(xs), List(
    Branch("", match pats
      case List(pat) =>
        pat
      case _ =>
        PTuple(pats)
    end, None, body))))

function pattern_formals(n: Int): List[Var] :=
  List(for i in range(1, n + 1) yield Var(unqualified("(" ++ show(i) ++ ")"), THole))

function pattern_scrutinee(xs: List[Var]): Expr :=
  match xs
    case List(x) =>
      EVar(x)
    case _ =>
      ETuple(List(for x in xs yield EVar(x)))
  end

// the patterns and the body of a lambda that lambda_patterns built
function patterns_of_lambda(formals: List[Var], body: Expr): Option[List[Pat] * Expr] :=
  match (body, formals)
    case (EMatch(e, List(Branch(_, pat, None, inner))), List(_; more)) if formals == pattern_formals(size(formals)) and e == pattern_scrutinee(formals) =>
      match (pat, more)
        case (_, List()) =>
          Some((List(pat), inner))

        case (PTuple(args), _) =>
          Some((args, inner))

        case _ =>
          None
      end

    case _ =>
      None
  end

// what a form of a single generator yields without yield, the value its pattern matches, an entry of a map
function implicit_elem(form: Form, gens: List[Gen]): Option[Yield] :=
  match (List(for g in gens if not is_guard(g)), form)
    case (List(GPair(k, v, _)), FMap) =>
      pair_elem(pattern_expr(k), pattern_expr(v))

    case (List(GPair(k, v, _)), _) =>
      match (pattern_expr(k), pattern_expr(v))
        case (Some(a), Some(b)) =>
          Some(YVal(ETuple(List(a, b))))
        case _ =>
          None
      end

    case (List(GVal(PTuple(List(k, v)), _)), FMap) =>
      pair_elem(pattern_expr(k), pattern_expr(v))

    case (List(GVal(_, _)), FMap) =>
      None

    case (List(GVal(p, _)), _) =>
      map_option(pattern_expr(p), YVal)

    case _ =>
      None
  end

function pair_elem(k: Option[Expr], v: Option[Expr]): Option[Yield] :=
  match (k, v)
    case (Some(a), Some(b)) =>
      Some(YPair(a, b))
    case _ =>
      None
  end

function is_guard(g: Gen): Bool :=
  match g
    case GIf(_) =>
      true
    case _ =>
      false
  end

// the value that a pattern without _ matches
function pattern_expr(p: Pat): Option[Expr] :=
  match p
    case PWild =>
      None

    case PLit(lit) =>
      Some(ELit(lit))

    case PVar(x) =>
      Some(EVar(x))

    case PTuple(ps) =>
      map_option(pattern_exprs(ps), ETuple)

    case PApp(c, List()) =>
      Some(EName(c, THole))

    case PApp(c, ps) =>
      map_option(pattern_exprs(ps), lambda es => ECall(c, THole, es))

    case PAt(pos, pat) =>
      map_option(pattern_expr(pat), lambda e => EAt(pos, e))
  end

// pat with the patterns of sub for its variables
function subst_pat(pat: Pat, sub: List[Name * Pat]): Pat :=
  match pat
    case PVar(var) =>
      value_or(get(var.name, sub), pat)

    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield subst_pat(a, sub)))

    case PTuple(args) =>
      PTuple(List(for a in args yield subst_pat(a, sub)))

    case PAt(pos, inner) =>
      PAt(pos, subst_pat(inner, sub))

    case _ =>
      pat
  end

function sorts_in(t: Type): List[Name] :=
  match t
    case TSort(name, args) =>
      List(name; List(for a in args for u in sorts_in(a) yield u))

    case TFun(args, res) =>
      List(for a in args ++ List(res) for u in sorts_in(a) yield u)

    case TProc(ins, outs, refs) =>
      List(for a in ins ++ outs ++ refs for u in sorts_in(a) yield u)

    case TTuple(types) =>
      List(for a in types for u in sorts_in(a) yield u)

    case _ =>
      List()
  end

// the variables that pat binds, from left to right
function pattern_vars(pats: List[Pat]): Option[List[Var]] :=
  match pats
    case List() =>
      Some(List())

    case List(PVar(var); more) =>
      match pattern_vars(more)
        case Some(xs) =>
          Some(List(var; xs))
        case None =>
          None
      end

    case _ =>
      None
  end

function pattern_names(pat: Pat): List[Name] :=
  match pat
    case PVar(var) =>
      List(var.name)

    case PApp(_, args) =>
      List(for arg in args for name in pattern_names(arg) yield name)

    case PTuple(args) =>
      List(for arg in args for name in pattern_names(arg) yield name)

    case PWild =>
      List()

    case PLit(_) =>
      List()

    case PAt(_, inner) =>
      pattern_names(inner)
  end

function pattern_exprs(ps: List[Pat]): Option[List[Expr]] :=
  match ps
    case List() =>
      Some(List())

    case List(p; more) =>
      match (pattern_expr(p), pattern_exprs(more))
        case (Some(e), Some(es)) =>
          Some(List(e; es))
        case _ =>
          None
      end
  end

function form_name(form: Form): Id :=
  match form
    case FList =>
      "List"

    case FSet =>
      "Set"

    case FMap =>
      "Map"

    case FArray =>
      "Array"
  end

function strip_cmd(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, body) =>
      CFun(name, params, formals, typ, strip_expr(body))

    case CProc(name, params, ins, outs, refs, stmt) =>
      CProc(name, params, ins, outs, refs, strip_stmt(stmt))

    case CTest(name, vars, stmt) =>
      CTest(name, vars, strip_stmt(stmt))

    case CPatAlias(name, params, formals, typ, pat) =>
      CPatAlias(name, params, formals, typ, strip_pat(pat))

    case CLemma(name, params, formals, assms, concl) =>
      CLemma(name, params, formals, List(for a in assms yield strip_expr(a)), strip_expr(concl))

    case CSort(_, _, _) =>
      cmd

    case CData(_, _, _) =>
      cmd

    case CNotation(_, _, _) =>
      cmd

    case CFunSig(_, _, _, _) =>
      cmd

    case CProcSig(_, _, _, _, _) =>
      cmd

    case CAbstract(_, _) =>
      cmd
  end

function strip_expr(expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(_) =>
      expr

    case EApp(fun, args) =>
      EApp(strip_expr(fun), List(for a in args yield strip_expr(a)))

    case EField(base, field) =>
      EField(strip_expr(base), field)

    case EUpdate(base, field, value) =>
      EUpdate(strip_expr(base), field, strip_expr(value))

    case ELam(formals, body) =>
      ELam(formals, strip_expr(body))

    case EProc(ins, outs, refs, stmt) =>
      EProc(ins, outs, refs, strip_stmt(stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (strip_pat(p), strip_expr(e))), strip_expr(body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(strip_expr(cond), strip_expr(then_expr), strip_expr(else_expr))

    case EMatch(arg, cases) =>
      EMatch(strip_expr(arg), List(for br in cases yield strip_branch(br, strip_expr)))

    case ETuple(args) =>
      ETuple(List(for a in args yield strip_expr(a)))

    case EForm(form, elems, rest) =>
      EForm(form, List(for y in elems yield strip_yield(y)), map_option(rest, strip_expr))

    case EFor(form, gens, elem, rest) =>
      EFor(form, List(for g in gens yield strip_gen(g)), strip_yield(elem), map_option(rest, strip_expr))

    case EAt(_, inner) =>
      strip_expr(inner)
  end

function strip_yield(y: Yield): Yield :=
  match y
    case YVal(value) =>
      YVal(strip_expr(value))
    case YPair(key, value) =>
      YPair(strip_expr(key), strip_expr(value))
  end

function strip_gen(g: Gen): Gen :=
  match g
    case GVal(pat, over) =>
      GVal(strip_pat(pat), strip_expr(over))

    case GPair(key, value, over) =>
      GPair(strip_pat(key), strip_pat(value), strip_expr(over))

    case GIf(cond) =>
      GIf(strip_expr(cond))
  end

function strip_branch[A](br: Branch[A], strip_body: A -> A): Branch[A] :=
  Branch(br.doc, strip_pat(br.pat), map_option(br.guard, strip_expr), strip_body(br.body))

function strip_stmt(stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for (x, e) in upd yield (x, strip_expr(e))))

    case SBlock(locals, stmts) =>
      SBlock(locals, List(for s in stmts yield strip_stmt(s)))

    case SIf(cond, left, right) =>
      SIf(strip_expr(cond), strip_stmt(left), strip_stmt(right))

    case SWhile(cond, body) =>
      SWhile(strip_expr(cond), strip_stmt(body))

    case SCall(proc, ins, outs, refs) =>
      SCall(proc, List(for a in ins yield strip_expr(a)), outs, refs)

    case SMatch(arg, cases) =>
      SMatch(strip_expr(arg), List(for br in cases yield strip_branch(br, strip_stmt)))

    case SAssert(cond) =>
      SAssert(strip_expr(cond))

    case SAssertRaises(typ, pat, body) =>
      SAssertRaises(typ, strip_pat(pat), strip_stmt(body))

    case SRaise(value, typ) =>
      SRaise(strip_expr(value), typ)

    case STry(body, catches) =>
      STry(strip_stmt(body), List(for c in catches yield Catch(c.doc, c.typ, strip_pat(c.pat), map_option(c.guard, strip_expr), strip_stmt(c.body))))

    case SAt(_, inner) =>
      strip_stmt(inner)
  end

function strip_pat(pat: Pat): Pat :=
  match pat
    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield strip_pat(a)))

    case PTuple(args) =>
      PTuple(List(for a in args yield strip_pat(a)))

    case PAt(_, inner) =>
      strip_pat(inner)

    case PWild =>
      pat

    case PLit(_) =>
      pat

    case PVar(_) =>
      pat
  end
