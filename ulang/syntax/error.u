// the errors that the phases share, with their messages: the kinds of errors, the internal errors, and the runtime
// errors that the interpreter and compiled code both report, with their texts, which ulang/compile/compile.u writes into every program as the
// formats u_text_* that ulang/runtime/ulang.c prints, where %s stands for a value as show gives it

export

// the kinds of errors, which the commands report as "kind error: message" after the file, and which the first line of a
// file that is expected to fail states, also in the regular expression errorLine of vscode/extension.js
data ErrorKind :=
  case ParseKind
  case TypeKind
  case FormatKind
  case RuntimeKind
  case InternalKind

function error_kinds(): List[ErrorKind]

// an error of a phase at its position in module, None for the main module, where code is the constructor of the error, e.g.
// CannotUnify, and details are its parts, such as the expected and the found type
data Diagnostic :=
  case Diagnostic(kind: ErrorKind, code: Str, module: Option[Id], pos: Pos, message: Str, details: List[Str * Str])

// "kind error: message"
function error_text(kind: ErrorKind, message: Str): Str

// an error without a position, of a run or of a file, whose code is its kind
function diagnostic(kind: ErrorKind, message: Str): Diagnostic

// "kind error: message", with " in m" for a module other than the main one, and " at L.C" if it has a position
function format_diagnostic(d: Diagnostic): Str

data RuntimeError :=
  case NoCase(text: Str)
  case CompareFunctions
  case CompareProcedures
  case AssertionFailed
  case AssertionUnequal(left: Str, right: Str)
  // of the pattern of an assert raises, as format_pat writes it, whose body raised nothing
  case AssertionNotRaised(expected: Str)
  case Uncaught(text: Str)
  // of the qualified name of a function without parameters, which compiled code knows when it is compiled
  case RecursiveInitialization(name: Str)

function runtime_message(e: RuntimeError): Str

// the formats of the runtime errors whose values compiled code knows only at run time, by the names of their C variables
function runtime_formats(): List[Str * Str]

// the errors of the interpreter, the checker, and the compiler that checked programs do not raise, unlike RuntimeError,
// since an earlier phase rules out what they meet
data InternalError :=
  case Uninitialized(name: Name)
  // of values as format_value of ulang/run/run.u gives them
  case NotFunction(text: Str)
  case Unspecified(name: Name, args: List[Str])
  case NotList(text: Str)
  case UnassignedOutput(output: Name, proc: Name)
  case UnknownProc(name: Name)
  case NotProc(text: Str)
  // an access or update of a field, which the checker resolves to an accessor or updater
  case UnresolvedField(field: Id)
  case UntranslatedForm(form: Id)
  // of any other code that an earlier phase rules out, described by what was met, e.g. "array literal"
  case Unexpected(what: Str)

function internal_message(e: InternalError): Str

// the suffix of a message at a position, " at L.C"
function at_pos(p: Pos): Str

implementation

function error_kinds(): List[ErrorKind] :=
  List(ParseKind, TypeKind, FormatKind, RuntimeKind, InternalKind)

function kind_name(kind: ErrorKind): Str :=
  match kind
    case ParseKind =>
      "parse"

    case TypeKind =>
      "type"

    case FormatKind =>
      "format"

    case RuntimeKind =>
      "runtime"

    case InternalKind =>
      "internal"
  end

function error_text(kind: ErrorKind, message: Str): Str :=
  kind_name(kind) ++ " error: " ++ message

function runtime_message(e: RuntimeError): Str :=
  match e
    case NoCase(text) =>
      "no case matches " ++ text

    case CompareFunctions =>
      "cannot compare functions"

    case CompareProcedures =>
      "cannot compare procedures"

    case AssertionFailed =>
      "assertion failed"

    case AssertionUnequal(left, right) =>
      "assertion failed: " ++ left ++ " != " ++ right

    case AssertionNotRaised(expected) =>
      "assertion failed: nothing raised, expected " ++ expected

    case Uncaught(text) =>
      "uncaught exception " ++ text

    case RecursiveInitialization(name) =>
      "recursive initialization of " ++ name
  end

function runtime_formats(): List[Str * Str] :=
  List(
    ("u_text_no_case", runtime_message(NoCase("%s"))),
    ("u_text_compare_functions", runtime_message(CompareFunctions)),
    ("u_text_compare_procedures", runtime_message(CompareProcedures)),
    ("u_text_assertion_failed", runtime_message(AssertionFailed)),
    ("u_text_assertion_unequal", runtime_message(AssertionUnequal("%s", "%s"))),
    ("u_text_assertion_not_raised", runtime_message(AssertionNotRaised("%s"))),
    ("u_text_uncaught", runtime_message(Uncaught("%s"))))

test formats() :=
  assert contains(("u_text_assertion_unequal", "assertion failed: %s != %s"), runtime_formats())

function diagnostic(kind: ErrorKind, message: Str): Diagnostic :=
  Diagnostic(kind, kind_name(kind), None, Pos(0, 0), message, List())

function format_diagnostic(d: Diagnostic): Str :=
  error_text(d.kind, d.message ++ join("", List(for m in d.module yield " in " ++ m)) ++ (if d.pos == Pos(0, 0) then "" else at_pos(d.pos)))

function at_pos(p: Pos): Str :=
  " at " ++ show(p.line) ++ "." ++ show(p.col)

function internal_message(e: InternalError): Str :=
  match e
    case Uninitialized(name) =>
      name.base ++ " is not initialized"

    case NotFunction(text) =>
      "cannot apply " ++ text

    case Unspecified(name, args) =>
      name.base ++ " is not specified for " ++ join(", ", args)

    case NotList(text) =>
      "expected a list, got " ++ text

    case UnassignedOutput(x, proc) =>
      "output " ++ x.base ++ " of " ++ proc.base ++ " is not assigned"

    case UnknownProc(name) =>
      "unknown procedure " ++ name.base

    case NotProc(text) =>
      "cannot call " ++ text

    case UnresolvedField(field) =>
      "the field " ++ field ++ " is not resolved"

    case UntranslatedForm(form) =>
      "the form " ++ form ++ "(...) is not translated"

    case Unexpected(what) =>
      "unexpected " ++ what
  end

// the messages of the runtime errors that the cases of ulang/test/errors/ raise
test messages() :=
  assert runtime_message(AssertionNotRaised("DivisionByZero")) == "assertion failed: nothing raised, expected DivisionByZero"
  assert runtime_message(AssertionUnequal("24", "120")) == "assertion failed: 24 != 120"
  assert runtime_message(CompareFunctions) == "cannot compare functions"
  assert runtime_message(CompareProcedures) == "cannot compare procedures"
  assert runtime_message(RecursiveInitialization("ulang/test/errors/initialization.loop")) == "recursive initialization of ulang/test/errors/initialization.loop"
  assert runtime_message(Uncaught("Fail(2)")) == "uncaught exception Fail(2)"
