// the names of the builtin types, constructors, and exceptions, which the interpreter, the runtime, and the compiler
// create and refer to, of the modules of the library

export

// the patterns of the constructors of lists after checking, which resolves List() and List(p; r) to the module list
pattern PNil(): Pat :=
  PApp(Name(Some("prelude/list"), "Nil"), List())

pattern PCons(head: At[Pat], tail: At[Pat]): Pat :=
  PApp(Name(Some("prelude/list"), "Cons"), List(head, tail))

// the builtin types of the prelude, and lists after checking
pattern TBool(): Type :=
  TSort(Name(Some("prelude/prelude"), "Bool"), List())

pattern TInt(): Type :=
  TSort(Name(Some("prelude/prelude"), "Int"), List())

pattern TStr(): Type :=
  TSort(Name(Some("prelude/prelude"), "Str"), List())

pattern TChar(): Type :=
  TSort(Name(Some("prelude/prelude"), "Char"), List())

pattern TList(elem: Type): Type :=
  TSort(Name(Some("prelude/list"), "List"), List(elem))

// the expressions of the constructors of lists after checking, and the lists that forms translate to, before it
pattern ENil(typ: Type): Expr :=
  EVar(Var(Name(Some("prelude/list"), "Nil"), typ))

// at the position pos of the constructor
pattern ECons(pos: Pos, span: Span, typ: Type, head: At[Expr], tail: At[Expr]): Expr :=
  EApp(AOk(pos, span, EVar(Var(Name(Some("prelude/list"), "Cons"), typ))), List(head, tail))

function nil_name(): Name

function cons_name(): Name

function os_error_name(): Name

function division_by_zero_name(): Name

function out_of_bounds_name(): Name

function no_character_name(): Name

function missing_field_name(): Name

function unordered_name(): Name

function incomparable_name(): Name

// the exceptions of builtin functions and accessors, which no raises counts, since they are defects of the program, such
// as a division by zero, that requires of functions will rule out
function unchecked_exceptions(): List[Name]

function list_foldr_name(): Name

function array_name(): Name

function array_foldr_name(): Name

implementation

function nil_name(): Name :=
  library_name("list", "Nil")

function cons_name(): Name :=
  library_name("list", "Cons")

function os_error_name(): Name :=
  library_name("os", "OsError")

// the exceptions of the builtins and of accessors of fields, which the prelude declares
function division_by_zero_name(): Name :=
  library_name("prelude", "DivisionByZero")

function out_of_bounds_name(): Name :=
  library_name("prelude", "OutOfBounds")

function no_character_name(): Name :=
  library_name("prelude", "NoCharacter")

function missing_field_name(): Name :=
  library_name("prelude", "MissingField")

function unordered_name(): Name :=
  library_name("prelude", "Unordered")

function incomparable_name(): Name :=
  library_name("prelude", "Incomparable")

// the builtins of lists and arrays that comprehensions use
function unchecked_exceptions(): List[Name] :=
  List(
    division_by_zero_name(),
    out_of_bounds_name(),
    no_character_name(),
    missing_field_name(),
    unordered_name(),
    incomparable_name())

function list_foldr_name(): Name :=
  library_name("list", "foldr")

function array_name(): Name :=
  library_name("array", "from_list")

function array_foldr_name(): Name :=
  library_name("array", "foldr")
