// the values of types up to a depth, which the tests of lemmas enumerate (lemma_tests of ulang/check/check.u): a member of
// the library that the library sees but no other module, whose declarations the generated tests name by their qualified
// names, so that they are no candidates of overloading elsewhere

export

// the values of a type of depth at most n, values(n), without duplicates, and their number or a bound of it, count(n),
// where a constructor has the depth one more than its deepest field
data Enumeration[A] :=
  case Enumeration(count: Int -> Int, values: Int -> List[A])

// why the test of a lemma fails
data LemmaFailure :=
  // the formals of a case that satisfies the assumptions but not the conclusion, as name = value, …
  case Falsified(values: Str)
  // no case satisfies the assumptions
  case Vacuous

function count_of[A](e: Enumeration[A], n: Int): Int :=
  example count_of(ints(), 2) == 5

function values_of[A](e: Enumeration[A], n: Int): List[A] :=
  example values_of(ints(), 2) == List(0, 1, -1, 2, -2)

// 0, 1, -1, …, n, -n
function ints(): Enumeration[Int]

function bools(): Enumeration[Bool] :=
  example values_of(bools(), 0) == List(false, true)

// the first n + 1 of a, b, a space, 0, and é, which is no ASCII
function chars(): Enumeration[Char] :=
  example values_of(chars(), 1) == List('a', 'b')

// the strings of at most n of the characters of depth below n
function strs(): Enumeration[Str] :=
  example values_of(strs(), 1) == List("", "a")

// the lists of at most n of the elements of depth below n
function lists[A](e: Enumeration[A]): Enumeration[List[A]] :=
  example values_of(lists(ints()), 1) == List(List(), List(0))
  example count_of(lists(ints()), 2) == 1 + 3 * 2

// the sets, maps, and arrays of the lists of their elements or entries, where count is that of the lists
function sets[A](e: Enumeration[A]): Enumeration[Set[A]] :=
  example values_of(sets(ints()), 2) == List(Set(), Set(-1), Set(-1, 0), Set(0), Set(0, 1), Set(1))

function maps[K, V](k: Enumeration[K], v: Enumeration[V]): Enumeration[Map[K, V]] :=
  example values_of(maps(bools(), bools()), 1) == List(
      Map(),
      Map(false => false),
      Map(false => true),
      Map(true => false),
      Map(true => true))

function arrays[A](e: Enumeration[A]): Enumeration[Array[A]] :=
  example values_of(arrays(ints()), 1) == List(Array(), Array(0))

// the depth of the test of a lemma whose formals have the counts: the largest up to depth of limits() at which the product
// of their counts is at most cases of limits(), and 0 if none is
function depth_of(counts: List[Int -> Int]): Int :=
  example depth_of(List()) == 4
  example depth_of(List(lambda n => 10 * n)) == 4
  example depth_of(List(lambda n => 1000 * n)) == 1

implementation

// the bounds of the test of a lemma: the depth of the values of its formals, and the number of cases
data Limits :=
  case Limits(depth: Int, cases: Int)

function limits(): Limits :=
  Limits(4, 1000)

function count_of[A](e: Enumeration[A], n: Int): Int :=
  e.count(n)

function values_of[A](e: Enumeration[A], n: Int): List[A] :=
  e.values(n)

function ints(): Enumeration[Int] :=
  Enumeration(lambda n => 2 * n + 1, lambda n => List(0; List(for i in range(1, n + 1) for j in List(i, -i) yield j)))

function bools(): Enumeration[Bool] :=
  Enumeration(lambda _ => 2, lambda _ => List(false, true))

function alphabet(): List[Char] :=
  chars("ab 0é")

function chars(): Enumeration[Char] :=
  Enumeration(lambda n => size(take(n + 1, alphabet())), lambda n => take(n + 1, alphabet()))

function strs(): Enumeration[Str] :=
  Enumeration(lambda n => count_of(lists(chars()), n), lambda n => List(for cs in values_of(lists(chars()), n) yield str(cs)))

function lists[A](e: Enumeration[A]): Enumeration[List[A]] :=
  Enumeration(lambda n => list_count(e, n), lambda n => list_values(e, n))

function list_count[A](e: Enumeration[A], n: Int): Int :=
  if n == 0 then 1 else 1 + count_of(e, n - 1) * list_count(e, n - 1)

function list_values[A](e: Enumeration[A], n: Int): List[List[A]] :=
  if n == 0 then
    List(List())
  else
    let heads := values_of(e, n - 1), tails := list_values(e, n - 1) in
    List(List(); List(for x in heads for xs in tails yield List(x; xs)))

function sets[A](e: Enumeration[A]): Enumeration[Set[A]] :=
  Enumeration(lambda n => count_of(lists(e), n), lambda n => List(for s in Set(for xs in values_of(lists(e), n) yield Set(for x in xs))))

function maps[K, V](k: Enumeration[K], v: Enumeration[V]): Enumeration[Map[K, V]] :=
  let entries := lists(pairs(k, v)) in
  Enumeration(lambda n => count_of(entries, n), lambda n => List(for m in Set(for ps in values_of(entries, n) yield Map(for (a, b) in ps))))

function pairs[A, B](a: Enumeration[A], b: Enumeration[B]): Enumeration[A * B] :=
  Enumeration(lambda n => count_of(a, n) * count_of(b, n), lambda n => List(for x in values_of(a, n) for y in values_of(b, n) yield (x, y)))

function arrays[A](e: Enumeration[A]): Enumeration[Array[A]] :=
  Enumeration(lambda n => count_of(lists(e), n), lambda n => List(for xs in values_of(lists(e), n) yield Array(for x in xs)))

function depth_of(counts: List[Int -> Int]): Int :=
  deepest(counts, 0)

function deepest(counts: List[Int -> Int], n: Int): Int :=
  if n < limits().depth and product(List(for c in counts yield c(n + 1))) <= limits().cases then
    deepest(counts, n + 1)
  else
    n

function product(ns: List[Int]): Int :=
  foldl(ns, 1, lambda p, n => p * n)

test enumerations() :=
  assert values_of(strs(), 2) == List("", "a", "aa", "b", "ba")
  assert values_of(lists(bools()), 2) == List(
    List(),
    List(false),
    List(false, false),
    List(false, true),
    List(true),
    List(true, false),
    List(true, true))
  assert count_of(lists(bools()), 2) == size(values_of(lists(bools()), 2))
  assert size(values_of(chars(), 10)) == 5 and count_of(chars(), 10) == 5
  assert values_of(maps(bools(), ints()), 1) == List(Map(), Map(false => 0), Map(true => 0))
