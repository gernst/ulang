// [a, b; xs] is notation for Cons(a, Cons(b, xs)), and [a, b] for Cons(a, Cons(b, Nil))

export

data List[A] :=
  case Nil
  case Cons(head: A, tail: List[A])

function ++[A](xs: List[A], ys: List[A]): List[A]

function size[A](xs: List[A]): Int

function contains[A](x: A, xs: List[A]): Bool

function exists[A](xs: List[A], p: A -> Bool): Bool

function forall[A](xs: List[A], p: A -> Bool): Bool

// the first element that satisfies p, and the first Some that f gives, which stop there
function find[A](xs: List[A], p: A -> Bool): Option[A]

function find_map[A, B](xs: List[A], f: A -> Option[B]): Option[B]

// the index of the first x
function index_of[A](x: A, xs: List[A]): Option[Int]

// the elements of the lists that f gives for the elements of xs
function flat_map[A, B](xs: List[A], f: A -> List[B]): List[B]

// f(x1, f(x2, ... f(xn, acc))), which recurses as deep as xs is long, and f(... f(f(acc, x1), x2) ..., xn)
function foldr[A, R](xs: List[A], acc: R, f: (A, R) -> R): R :=
  example foldr(List(1, 2), List(), lambda x, ys => List(x; ys)) == List(1, 2)

function foldl[A, R](xs: List[A], acc: R, f: (R, A) -> R): R :=
  example foldl(List(1, 2), List(), lambda ys, x => List(x; ys)) == List(2, 1)

// the value of the first pair of k in an association list of keys and values
function get[K, V](k: K, xs: List[K * V]): Option[V] :=
  example get(1, List((1, "a"), (1, "b"))) == Some("a")

// xs without the occurrences of x
function remove[A](x: A, xs: List[A]): List[A]

// xs in ascending order of compare, where equal elements keep their order
function sort[A](xs: List[A]): List[A]

function distinct[A](xs: List[A]): List[A]

// the last element, if any
function last[A](xs: List[A]): Option[A]

// an element that occurs twice
function repeated[A](xs: List[A]): Option[A]

// the elements of xs that are not elements of ys
function --[A](xs: List[A], ys: List[A]): List[A]

function concat[A](xss: List[List[A]]): List[A]

// the elements of xs in reverse order, before ys
function reverse_onto[A](xs: List[A], ys: List[A]): List[A]

function reverse[A](xs: List[A]): List[A]

function zip[A, B](xs: List[A], ys: List[B]): List[A * B]

// the elements with their indices from 0
function numbered[A](xs: List[A]): List[A * Int] :=
  example numbered(List("a", "b")) == List(("a", 0), ("b", 1))

function take[A](n: Int, xs: List[A]): List[A]

function drop[A](n: Int, xs: List[A]): List[A]

// the elements from index i up to j, exclusively, as far as xs has them
function slice[A](xs: List[A], i: Int, j: Int): List[A]

// the first n elements and the others
function split_at[A](n: Int, xs: List[A]): List[A] * List[A] :=
  example split_at(1, List(1, 2, 3)) == (List(1), List(2, 3))

// the elements before the first sep and those after it, all and none if xs has no sep
function split_on[A](xs: List[A], sep: A): List[A] * List[A] :=
  example split_on(List(1, 0, 2, 0), 0) == (List(1), List(2, 0))
  example split_on(List(1, 2), 0) == (List(1, 2), List())

function replicate[A](n: Int, x: A): List[A]

// the integers from i up to j, exclusively
function range(i: Int, j: Int): List[Int]

function firsts[A, B](ps: List[A * B]): List[A]

function seconds[A, B](ps: List[A * B]): List[B]

// the elements as [a, b], also inside other values
function show[A](xs: List[A]): Str

implementation

function ++[A](xs: List[A], ys: List[A]): List[A] :=
  match xs
    case List() =>
      ys
    case List(x; zs) =>
      List(x; zs ++ ys)
  end

function size[A](xs: List[A]): Int :=
  match xs
    case List() =>
      0
    case List(_; ys) =>
      1 + size(ys)
  end

function get[K, V](k: K, xs: List[K * V]): Option[V] :=
  match xs
    case List() =>
      None

    case List((j, v); _) if j == k =>
      Some(v)

    case List(_; ys) =>
      get(k, ys)
  end

function remove[A](x: A, xs: List[A]): List[A] :=
  match xs
    case List() =>
      List()
    case List(y; ys) =>
      if y == x then remove(x, ys) else List(y; remove(x, ys))
  end

function sort[A](xs: List[A]): List[A] :=
  if size(xs) < 2 then
    xs
  else
    merge_sorted(sort(take(size(xs) / 2, xs)), sort(drop(size(xs) / 2, xs)))

function merge_sorted[A](xs: List[A], ys: List[A]): List[A] :=
  match (xs, ys)
    case (List(), _) =>
      ys

    case (_, List()) =>
      xs

    case (List(x; xt), List(y; yt)) =>
      if compare(y, x) < 0 then
        List(y; merge_sorted(xs, yt))
      else
        List(x; merge_sorted(xt, ys))
  end

function contains[A](x: A, xs: List[A]): Bool :=
  match xs
    case List() =>
      false
    case List(y; ys) =>
      x == y or contains(x, ys)
  end

function exists[A](xs: List[A], p: A -> Bool): Bool :=
  match xs
    case List() =>
      false
    case List(y; ys) =>
      p(y) or exists(ys, p)
  end

function forall[A](xs: List[A], p: A -> Bool): Bool :=
  match xs
    case List() =>
      true
    case List(y; ys) =>
      p(y) and forall(ys, p)
  end

function find[A](xs: List[A], p: A -> Bool): Option[A] :=
  match xs
    case List() =>
      None
    case List(y; ys) =>
      if p(y) then Some(y) else find(ys, p)
  end

function find_map[A, B](xs: List[A], f: A -> Option[B]): Option[B] :=
  match xs
    case List() =>
      None

    case List(y; ys) =>
      match f(y)
        case None =>
          find_map(ys, f)
        case found =>
          found
      end
  end

function index_of[A](x: A, xs: List[A]): Option[Int] :=
  match xs
    case List() =>
      None
    case List(y; ys) =>
      if y == x then Some(0) else map_option(index_of(x, ys), lambda i => i + 1)
  end

function flat_map[A, B](xs: List[A], f: A -> List[B]): List[B] :=
  concat(List(for x in xs yield f(x)))

function foldr[A, R](xs: List[A], acc: R, f: (A, R) -> R): R :=
  match xs
    case List() =>
      acc
    case List(y; ys) =>
      f(y, foldr(ys, acc, f))
  end

function foldl[A, R](xs: List[A], acc: R, f: (R, A) -> R): R :=
  match xs
    case List() =>
      acc
    case List(y; ys) =>
      foldl(ys, f(acc, y), f)
  end

function distinct[A](xs: List[A]): List[A] :=
  match xs
    case List() =>
      List()
    case List(y; ys) =>
      List(y; distinct(List(for z in ys if z != y)))
  end

function last[A](xs: List[A]): Option[A] :=
  match xs
    case List() =>
      None

    case List(x) =>
      Some(x)

    case List(_; rest) =>
      last(rest)
  end

function repeated[A](xs: List[A]): Option[A] :=
  match xs
    case List() =>
      None
    case List(y; ys) =>
      if contains(y, ys) then Some(y) else repeated(ys)
  end

function --[A](xs: List[A], ys: List[A]): List[A] :=
  List(for x in xs if not contains(x, ys))

function concat[A](xss: List[List[A]]): List[A] :=
  match xss
    case List() =>
      List()
    case List(xs; yss) =>
      xs ++ concat(yss)
  end

function reverse_onto[A](xs: List[A], ys: List[A]): List[A] :=
  match xs
    case List() =>
      ys
    case List(x; rest) =>
      reverse_onto(rest, List(x; ys))
  end

function reverse[A](xs: List[A]): List[A] :=
  reverse_onto(xs, List())

function zip[A, B](xs: List[A], ys: List[B]): List[A * B] :=
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) =>
      List((x, y); zip(xs_, ys_))
    case _ =>
      List()
  end

function numbered[A](xs: List[A]): List[A * Int] :=
  zip(xs, range(0, size(xs)))

function take[A](n: Int, xs: List[A]): List[A] :=
  match xs
    case List() =>
      List()
    case List(y; ys) =>
      if n <= 0 then List() else List(y; take(n - 1, ys))
  end

function drop[A](n: Int, xs: List[A]): List[A] :=
  match xs
    case List() =>
      List()
    case List(_; ys) =>
      if n <= 0 then xs else drop(n - 1, ys)
  end

function slice[A](xs: List[A], i: Int, j: Int): List[A] :=
  let k := max(i, 0) in
  take(j - k, drop(k, xs))

function split_at[A](n: Int, xs: List[A]): List[A] * List[A] :=
  (take(n, xs), drop(n, xs))

function split_on[A](xs: List[A], sep: A): List[A] * List[A] :=
  match xs
    case List() =>
      (List(), List())

    case List(x; more) =>
      if x == sep then
        (List(), more)
      else
        match split_on(more, sep)
          case (before, after) =>
            (List(x; before), after)
        end
  end

function replicate[A](n: Int, x: A): List[A] :=
  if n <= 0 then List() else List(x; replicate(n - 1, x))

function range(i: Int, j: Int): List[Int] :=
  if i >= j then List() else List(i; range(i + 1, j))

function firsts[A, B](ps: List[A * B]): List[A] :=
  match ps
    case List() =>
      List()
    case List((a, _); rest) =>
      List(a; firsts(rest))
  end

function seconds[A, B](ps: List[A * B]): List[B] :=
  match ps
    case List() =>
      List()
    case List((_, b); rest) =>
      List(b; seconds(rest))
  end

function show[A](xs: List[A]): Str :=
  "List(" ++ separated(List(for x in xs yield show(x))) ++ ")"

// the strings with commas between them, joined pairwise, so that each character is copied about log n times, since join of
// str.u comes after this module
function separated(ss: List[Str]): Str :=
  match ss
    case List() =>
      ""

    case List(s) =>
      s

    case _ =>
      separated(joined_pairs(ss))
  end

function joined_pairs(ss: List[Str]): List[Str] :=
  match ss
    case List(a, b; rest) =>
      List(a ++ ", " ++ b; joined_pairs(rest))
    case _ =>
      ss
  end

test lists() :=
  assert numbered(List("a", "b")) == List(("a", 0), ("b", 1)) and numbered(List()) == List()
  assert range(2, 5) == List(2, 3, 4) and range(5, 2) == List()
  assert List(1, 2) ++ List(3) == List(1, 2, 3) and size(List(1, 2, 3)) == 3
  assert get(2, List((1, "a"), (2, "b"), (2, "c"))) == Some("b") and get(3, List((1, "a"))) == None
  assert remove(1, List(1, 2, 1, 3)) == List(2, 3) and remove(4, List(1, 2)) == List(1, 2) and remove((1, "a"), List((1, "a"), (1, "b"))) == List((1, "b"))
  assert contains(2, List(1, 2)) and not contains(3, List(1, 2))
  assert slice(List(1, 2, 3), 1, 3) == List(2, 3) and slice(List(1, 2), 1, 5) == List(2) and slice(List(1, 2, 3), 2, 1) == List() and slice(List(1, 2), -1, 1) == List(1)
  assert exists(List(1, 2), lambda x => x > 1) and not exists(List(1, 2), lambda x => x > 2) and not exists(List(), lambda x => x > 0)
  assert forall(List(1, 2), lambda x => x > 0) and not forall(List(1, 2), lambda x => x > 1) and forall(List(), lambda x => x > 0)
  assert foldr(List(1, 2, 3), List(), Cons) == List(1, 2, 3) and foldr(List(1, 2, 3), 0, lambda x, n => 10 * n + x) == 321
  assert foldl(List(1, 2, 3), List(), lambda xs, x => List(x; xs)) == List(3, 2, 1) and foldl(List(1, 2, 3), 0, lambda n, x => 10 * n + x) == 123
  assert distinct(List(1, 2, 1, 3, 2)) == List(1, 2, 3)
  assert repeated(List(1, 2, 1)) == Some(1) and last(List(1, 2)) == Some(2) and last(List()) == None
  assert List(1, 2, 3) -- List(2) == List(1, 3)
  assert concat(List(List(1), List(), List(2, 3))) == List(1, 2, 3)
  assert zip(List(1, 2, 3), List(true, false)) == List((1, true), (2, false))
  assert take(2, List(1, 2, 3)) == List(1, 2) and drop(2, List(1, 2, 3)) == List(3)
  assert find(List(1, 4, 6), lambda x => x > 3) == Some(4) and find(List(1, 2), lambda x => x > 3) == None
  assert find_map(List(1, 4, 6), lambda x => if x > 3 then Some(x * 2) else None) == Some(8) and find_map(List(1), lambda _ => None) == None
  assert index_of(6, List(5, 6)) == Some(1) and index_of(7, List(5, 6)) == None
  assert flat_map(List(1, 2), lambda x => List(x, x)) == List(1, 1, 2, 2) and split_at(1, List(1, 2, 3)) == (List(1), List(2, 3))
  assert sort(List(3, 1, 2, 1)) == List(1, 1, 2, 3) and sort(List("b", "a")) == List("a", "b") and sort(List(1)) == List(1)
  assert replicate(2, 0) == List(0, 0) and replicate(-1, 0) == List()
  assert reverse(List(1, 2, 3)) == List(3, 2, 1) and reverse_onto(List(2, 1), List(3)) == List(1, 2, 3)
  assert firsts(List((1, true), (2, false))) == List(1, 2) and seconds(List((1, true), (2, false))) == List(true, false)
