// buffers collect elements at the end in constant time and read them out in order, kept as the reversed list of their
// elements, so that a loop that adds one element per step is linear

export

type Buffer[A]

function empty[A](): Buffer[A]

// b with the elements of xs added after those of b
function ++[A](b: Buffer[A], xs: List[A]): Buffer[A]

function size[A](b: Buffer[A]): Int

// f(x1, f(x2, ... f(xn, acc))) and f(... f(f(acc, x1), x2) ..., xn) of the elements in the order they were added
function foldr[A, R](b: Buffer[A], acc: R, f: (A, R) -> R): R

function foldl[A, R](b: Buffer[A], acc: R, f: (R, A) -> R): R

implementation

data Buffer[A] :=
  case Reversed(items: List[A])

function empty[A](): Buffer[A] :=
  Reversed(List())

function ++[A](b: Buffer[A], xs: List[A]): Buffer[A] :=
  match b
    case Reversed(items) =>
      Reversed(reverse_onto(xs, items))
  end

function size[A](b: Buffer[A]): Int :=
  match b
    case Reversed(items) =>
      size(items)
  end

function foldr[A, R](b: Buffer[A], acc: R, f: (A, R) -> R): R :=
  match b
    case Reversed(items) =>
      foldl(items, acc, lambda r, x => f(x, r))
  end

function foldl[A, R](b: Buffer[A], acc: R, f: (R, A) -> R): R :=
  match b
    case Reversed(items) =>
      foldr(items, acc, lambda x, r => f(r, x))
  end

test buffers() :=
  local b: Buffer[Int] := empty()
  assert size(b) == 0 and List(for x in b) == List()
  assign b := b ++ List(1) ++ List(2, 3)
  assign b := b ++ List()
  assert size(b) == 3 and List(for x in b) == List(1, 2, 3)
  assert foldr(b, List(), Cons) == List(1, 2, 3) and foldl(b, List(), lambda xs, x => List(x; xs)) == List(3, 2, 1)
  assert foldr(b, 0, lambda x, n => 10 * n + x) == 321 and foldl(b, 0, lambda n, x => 10 * n + x) == 123
  assert List(for x in b ++ List(4) if x > 2) == List(3, 4) and List(for x in b) == List(1, 2, 3)
