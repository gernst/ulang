test files() :=
  var t: Str, entries: List[Str * Bool], home: Str
  enter_scratch(out home)
  os_write_utf8(in "files/a.txt", "line\n\"quoted\"\n")
  os_read_utf8(in "files/a.txt", out t)
  assert t == "line\n\"quoted\"\n"
  os_write_utf8(in "files/a.txt", "")
  os_read_utf8(in "files/a.txt", out t)
  assert t == ""
  os_write_utf8(in "files/ä→.txt", "ä→😀\n")
  os_read_utf8(in "files/ä→.txt", out t)
  assert t == "ä→😀\n" and size(t) == 4
  os_list(in "files", out entries)
  assert contains(("ä→.txt", false), entries)
  os_chdir(in home)

// bytes as they are, also those that are not UTF-8, which os_read_utf8 rejects
test bytes() :=
  let bytes := Array(for n in List(0, 104, 255, 10) yield byte(n))
  var back: Array[Byte], t: Str, home: Str
  enter_scratch(out home)
  os_write_bytes(in "files/b.bin", bytes)
  os_read_bytes(in "files/b.bin", out back)
  assert back == bytes
  os_write_bytes(in "files/b.bin", Array())
  os_read_bytes(in "files/b.bin", out back)
  assert back == Array()
  os_write_utf8(in "files/b.txt", "ä")
  os_read_bytes(in "files/b.txt", out back)
  assert back == encode_utf8("ä")
  os_write_bytes(in "files/b.bin", Array(byte(255)))
  assert raises OsError("invalid UTF-8 in files/b.bin") do
    os_read_utf8(in "files/b.bin", out t)
  end
  os_chdir(in home)

// streams in the three modes, read by lines, bytes, and to the end, which are equal by identity and shown by their paths
test streams() :=
  var io: IO, other: IO, line: Option[Str], text: Str, bytes: Array[Byte], home: Str
  enter_scratch(out home)
  io_open(in "streams/a.txt", IoWrite, out io)
  io_write_utf8(in io, "one\nzwei ä\n")
  io_close(in io)
  io_open(in "streams/a.txt", IoAppend, out io)
  io_write_bytes(in io, Array(byte(51), byte(10), byte(52)))
  io_close(in io)
  io_open(in "streams/a.txt", IoRead, out io)
  assert io_path(io) == "streams/a.txt" and show(io) == "<io streams/a.txt>"
  io_read_line(in io, out line)
  assert line == Some("one")
  io_read_bytes(in io, 2, out bytes)
  assert bytes == Array(byte(122), byte(119))
  io_read_until(in io, byte(10), out bytes)
  assert decode_utf8(bytes) == Some("ei ä\n")
  io_read_utf8(in io, out text)
  assert text == "3\n4"
  io_read_line(in io, out line)
  assert line == None
  io_read_bytes(in io, 5, out bytes)
  assert bytes == Array()
  io_open(in "streams/a.txt", IoRead, out other)
  assert io == io and io != other and compare(io, other) == -1
  io_read_line(in other, out line)
  assert line == Some("one")
  io_close(in io)
  io_close(in other)
  assert raises OsError("closed stream streams/a.txt") do
    io_read_line(in io, out line)
  end
  io_open(in "streams/b.bin", IoWrite, out io)
  io_write_bytes(in io, Array(byte(97), byte(255), byte(10)))
  io_close(in io)
  io_open(in "streams/b.bin", IoRead, out io)
  assert raises OsError("invalid UTF-8 in streams/b.bin") do
    io_read_line(in io, out line)
  end
  io_close(in io)
  assert raises OsError("cannot read streams/missing.txt") do
    io_open(in "streams/missing.txt", IoRead, out io)
  end
  os_chdir(in home)

test library() :=
  var t: Str
  os_library(in "option", out t)
  assert slice(t, 0, 16) == "// optional valu"

test failures() :=
  var t: Str, home: Str
  enter_scratch(out home)
  assert raises OsError("cannot read files/missing.txt") do
    os_read_utf8(in "files/missing.txt", out t)
  end
  assert raises OsError("unknown module missing") do
    os_library(in "missing", out t)
  end
  os_chdir(in home)

// a tree of files, which os_list and os_walk see in the order of their names
test walking() :=
  var entries: List[Str * Bool], files: List[Str], dir: Bool, home: Str
  enter_scratch(out home)
  os_write_utf8(in "walk/z.txt", "z")
  os_write_utf8(in "walk/a.txt", "a")
  os_write_utf8(in "walk/sub/deep/c.txt", "c")
  os_write_utf8(in "walk/sub/b.txt", "b")
  os_list(in "walk", out entries)
  assert entries == List(("a.txt", false), ("sub", true), ("z.txt", false))
  os_walk(in "walk", out files)
  assert files == List("walk/a.txt", "walk/sub/b.txt", "walk/sub/deep/c.txt", "walk/z.txt")
  os_walk(in "walk/sub/", out files)
  assert files == List("walk/sub/b.txt", "walk/sub/deep/c.txt")
  os_walk(in "walk/a.txt", out files)
  assert files == List("walk/a.txt")
  os_is_dir(in "walk/sub", out dir)
  assert dir
  os_is_dir(in "walk/a.txt", out dir)
  assert not dir
  assert raises OsError("cannot list walk/missing") do
    os_list(in "walk/missing", out entries)
  end
  os_chdir(in home)

// relative paths start from the directory that os_chdir sets
test changing_directory() :=
  var t: Str, home: Str
  enter_scratch(out home)
  os_write_utf8(in "here/here.txt", "here")
  os_chdir(in "here")
  os_read_utf8(in "here.txt", out t)
  os_chdir(in "..")
  assert t == "here"
  assert raises OsError("cannot change to missing") do
    os_chdir(in "missing")
  end
  os_chdir(in home)

// the tests run without arguments
test arguments() :=
  var args: List[Str]
  os_args(out args)
  assert args == List()

// os_println prints a string as it is and a newline, also the text of any value that show gives
test printing() :=
  os_println(in "a \"text\"")
  os_println(in show(List(1, 2)))
  os_println(in show(("a\n", Some('\''), List(true), List(), ())))

// enters out/test/os below the root of the project, the nearest directory upward with project.u, so that the files that
// the tests write stay out of the sources, where home is the working directory before, which each test enters again at
// its end, since the tests of all files run in one working directory
procedure enter_scratch(out home: Str) :=
  var dir: Str, entries: List[Str * Bool], found := false
  os_cwd(out home)
  dir := home
  while not found do
    os_list(in dir, out entries)
    if contains(("project.u", false), entries) or dir == "/" then
      found := true
    else
      dir := os_dirname(dir)
    end
  end
  os_write_utf8(in os_join(dir, "out/test/os/.scratch"), "")
  os_chdir(in os_join(dir, "out/test/os"))
