// files, directories, the arguments of the program, and printing, where the procedures of the builtin section are those that
// the interpreter and the runtime define

export

data OsError :=
  case OsError(message: Str)

// the description of a project, which the function project(): Project of its file project.u at the root gives, read by
// ulang test, where the project is otherwise made by convention
data Project :=
  // the directories, from the root, whose programs ulang test does not run when it walks them, since they run only
  // compiled, e.g. because the interpreter is too slow for them
  case Project(compiled_only: List[Str])

// the paths of the files below path, depth-first in the order of names, or path itself if it is no directory,
// where each path is that of its directory, /, and its name
procedure os_walk(in path: Str, out files: List[Str]) raises OsError

// the path of name in dir, which may end with /
function os_join(dir: Str, name: Str): Str :=
  example os_join("a", "b") == "a/b"
  example os_join("a/", "b") == "a/b"

// the last part of a path, after its last /
function os_basename(path: Str): Str :=
  example os_basename("a/b.u") == "b.u"
  example os_basename("b.u") == "b.u"

// the part of a path before its last /, which is . for a path without /
function os_dirname(path: Str): Str :=
  example os_dirname("a/b/c.u") == "a/b"
  example os_dirname("c.u") == "."
  example os_dirname("/a") == "/"
  example os_dirname("/a/b") == "/a"

// print a string and then a newline
procedure os_println(in text: Str)

builtin

// the arguments of the program, after -- for the interpreter
procedure os_args(out args: List[Str]) raises OsError

// read and write files, where relative paths start from the working directory, and failures raise OsError
procedure os_read(in path: Str, out text: Str) raises OsError

procedure os_write(in path: Str, text: Str) raises OsError

// the source of a module of the library
procedure os_library(in name: Str, out text: Str) raises OsError

// print a string as it is, to the output, and with a newline to the error output, where show gives the text of any value
procedure os_print(in text: Str)

procedure os_print_error(in text: Str)

// end the program with the status code
procedure os_exit(in code: Int)

// the names in a directory, sorted, each with whether it is a directory, without following links, and whether path is a directory,
// also through a link
procedure os_list(in dir: Str, out entries: List[Str * Bool]) raises OsError

procedure os_is_dir(in path: Str, out yes: Bool)

// the working directory, which relative paths start from, and its change
procedure os_cwd(out dir: Str) raises OsError

procedure os_chdir(in dir: Str) raises OsError

implementation

procedure os_println(in text: Str) :=
  call os_print(in text)
  call os_print(in "\n")

procedure os_walk(in path: Str, out files: List[Str]) raises OsError :=
  local dir: Bool
  call os_is_dir(in path, out dir)
  if dir then
    call os_walk_dir(in path, out files)
  else
    assign files := List(path)
  end

procedure os_walk_dir(in dir: Str, out files: List[Str]) :=
  local entries: List[Str * Bool]
  call os_list(in dir, out entries)
  call os_walk_entries(in dir, entries, out files)

procedure os_walk_entries(
  in  dir: Str,
      entries: List[Str * Bool],
  out files: List[Str]
) :=
  match entries
    case List() =>
      assign files := List()

    case List((name, true); more) =>
      local below: List[Str], rest: List[Str]
      call   os_walk_dir(in os_join(dir, name), out below)
      call   os_walk_entries(in dir, more, out rest)
      assign files := below ++ rest

    case List((name, false); more) =>
      local rest: List[Str]
      call   os_walk_entries(in dir, more, out rest)
      assign files := List(os_join(dir, name); rest)
  end

function os_join(dir: Str, name: Str): Str :=
  if size(dir) > 0 and at(size(dir) - 1, dir) == '/' then
    dir ++ name
  else
    dir ++ "/" ++ name

function os_basename(path: Str): Str :=
  match last(split(path, '/'))
    case Some(name) =>
      name
    case None =>
      path
  end

// / for a path right below the root, such as /a
function os_dirname(path: Str): Str :=
  match split(path, '/')
    case List(_) =>
      "."

    case List("", _) =>
      "/"

    case parts =>
      join("/", take(size(parts) - 1, parts))
  end
