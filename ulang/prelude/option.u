// optional values, which every module imports implicitly, after the prelude

export

data Option[A] :=
  case None
  case Some(value: A)

// a if it has a value, else b
function or_else[A](a: Option[A], b: Option[A]): Option[A]

// the value of a, else d
function value_or[A](a: Option[A], d: A): A

// Some(f(x)) for Some(x), else None
function map_option[A, B](a: Option[A], f: A -> B): Option[B]

// f(x, acc) for Some(x), else acc: an option is a container of at most one element, for generators and for statements
function foldr[A, R](o: Option[A], acc: R, f: (A, R) -> R): R

function foldl[A, R](o: Option[A], acc: R, f: (R, A) -> R): R

// p(x) for Some(x), else false, and p(x), else true, as for the other containers
function exists[A](o: Option[A], p: A -> Bool): Bool

function forall[A](o: Option[A], p: A -> Bool): Bool

// None or Some(a), also inside other values
function show[A](o: Option[A]): Str

implementation

function or_else[A](a: Option[A], b: Option[A]): Option[A] :=
  match a
    case Some(_) =>
      a
    case None =>
      b
  end

function value_or[A](a: Option[A], d: A): A :=
  match a
    case Some(x) =>
      x
    case None =>
      d
  end

function map_option[A, B](a: Option[A], f: A -> B): Option[B] :=
  match a
    case Some(x) =>
      Some(f(x))
    case None =>
      None
  end

function foldr[A, R](o: Option[A], acc: R, f: (A, R) -> R): R :=
  match o
    case Some(x) =>
      f(x, acc)
    case None =>
      acc
  end

function foldl[A, R](o: Option[A], acc: R, f: (R, A) -> R): R :=
  match o
    case Some(x) =>
      f(acc, x)
    case None =>
      acc
  end

function exists[A](o: Option[A], p: A -> Bool): Bool :=
  match o
    case Some(x) =>
      p(x)
    case None =>
      false
  end

function forall[A](o: Option[A], p: A -> Bool): Bool :=
  match o
    case Some(x) =>
      p(x)
    case None =>
      true
  end

function show[A](o: Option[A]): Str :=
  match o
    case None =>
      "None"
    case Some(a) =>
      "Some(" ++ show(a) ++ ")"
  end

test options() :=
  assert value_or(Some(1), 2) == 1 and value_or(None, 2) == 2
  assert map_option(Some(1), lambda x => x + 1) == Some(2) and map_option(None, lambda x => x + 1) == None
  assert or_else(Some(1), Some(2)) == Some(1) and or_else(None, Some(2)) == Some(2)
  assert show(Some(Some(1))) == "Some(Some(1))" and show((None, Some("a"))) == "(None, Some(\"a\"))"
  assert exists(Some(1), lambda x => x > 0) and not exists(Some(1), lambda x => x > 1) and not exists(None, lambda x => x > 0)
  assert forall(Some(1), lambda x => x > 0) and not forall(Some(1), lambda x => x > 1) and forall(None, lambda x => x > 0)

test option_generators() :=
  local n := 0
  assert List(for x in Some(1)) == List(1) and List(for x in None) == List()
  assert Set(for x in List(1, 2, 3) for y in if x == 2 then None else Some(x * 10) yield y) == Set(10, 30)
  assert Map(for x in Some(1) for y in Some("a") yield x => y) == Map(1 => "a")
  for x in Some(5) do
    assign n := n + x
  end
  for x in None do
    assign n := n + x
  end
  assert n == 5
