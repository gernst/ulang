// loaded before every program, whose notations apply to it

infix right 1 ->
infix right 2 ==>
infix left 3 or
infix left 4 and
prefix 5 not
infix 6 == != < <= > >=
infix right 7 :: ++
infix left 8 + -
infix left 9 * / %
prefix 10 -

function not(b: Bool): Bool =
  if b then false else true

function ==>(a: Bool, b: Bool): Bool =
  not a or b

function !=[A](x: A, y: A): Bool =
  not (x == y)

function <=(m: Int, n: Int): Bool =
  m < n or m == n

function >(m: Int, n: Int): Bool =
  n < m

function >=(m: Int, n: Int): Bool =
  n <= m

function -(n: Int): Int =
  0 - n

data List[A] = nil | ::(A, List[A])
data Option[A] = none | some(A)
data Nat = zero | succ(Nat)

function ++[A](xs: List[A], ys: List[A]): List[A] =
  match xs
    case nil => ys
    case x :: zs => x :: zs ++ ys
  end

function length[A](xs: List[A]): Int =
  match xs
    case nil => 0
    case _ :: ys => 1 + length(ys)
  end
