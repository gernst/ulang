// sets as AVL trees, ordered by compare, where the depths of the subtrees of each node differ by at most one,
// such that insert and member take logarithmic time, with names that differ from those of the module map

data Set[A] :=
  | SLeaf
  | SNode(Set[A], A, Set[A], Int)

function empty_set[A](): Set[A] :=
  SLeaf

function member[A](x: A, s: Set[A]): Bool :=
  match s
    case SLeaf => false
    case SNode(l, y, r, _) =>
      let c := compare(x, y) in if c < 0 then member(x, l) else if c > 0 then member(x, r) else true
  end

function insert[A](x: A, s: Set[A]): Set[A] :=
  match s
    case SLeaf => SNode(SLeaf, x, SLeaf, 1)
    case SNode(l, y, r, _) =>
      let c := compare(x, y) in if c < 0 then rebalance(insert(x, l), y, r) else if c > 0 then rebalance(l, y, insert(x, r)) else s
  end

function from_list[A](xs: List[A]): Set[A] :=
  insert_all(xs, SLeaf)

function insert_all[A](xs: List[A], s: Set[A]): Set[A] :=
  match xs
    case Nil => s
    case [x; rest] => insert_all(rest, insert(x, s))
  end

// the elements of s in their order
function elements[A](s: Set[A]): List[A] :=
  elements_onto(s, Nil)

function elements_onto[A](s: Set[A], rest: List[A]): List[A] :=
  match s
    case SLeaf => rest
    case SNode(l, x, r, _) => elements_onto(l, [x; elements_onto(r, rest)])
  end

function count[A](s: Set[A]): Int :=
  match s
    case SLeaf => 0
    case SNode(l, _, r, _) => count(l) + 1 + count(r)
  end

function depth[A](s: Set[A]): Int :=
  match s
    case SLeaf => 0
    case SNode(_, _, _, d) => d
  end

function snode_depth[A](l: Set[A], r: Set[A]): Int :=
  1 + (if depth(l) < depth(r) then depth(r) else depth(l))

function snode[A](l: Set[A], x: A, r: Set[A]): Set[A] :=
  SNode(l, x, r, snode_depth(l, r))

function turn_left[A](s: Set[A]): Set[A] :=
  match s
    case SNode(a, x, SNode(b, y, c, _), _) => snode(snode(a, x, b), y, c)
    else s
  end

function turn_right[A](s: Set[A]): Set[A] :=
  match s
    case SNode(SNode(a, x, b, _), y, c, _) => snode(a, x, snode(b, y, c))
    else s
  end

function smaller[A](s: Set[A]): Set[A] :=
  match s
    case SNode(l, _, _, _) => l
    else s
  end

function greater[A](s: Set[A]): Set[A] :=
  match s
    case SNode(_, _, r, _) => r
    else s
  end

// the node of l, x, r, where the depths of l and r differ by at most two, rebalanced by one or two rotations
function rebalance[A](l: Set[A], x: A, r: Set[A]): Set[A] :=
  if depth(l) > depth(r) + 1 then
    turn_right(snode(if depth(smaller(l)) < depth(greater(l)) then turn_left(l) else l, x, r))
  else if depth(r) > depth(l) + 1 then
    turn_left(snode(l, x, if depth(greater(r)) < depth(smaller(r)) then turn_right(r) else r))
  else
    snode(l, x, r)

// the depths of the subtrees of each node differ by at most one, and its depth is correct
function well_formed[A](s: Set[A]): Bool :=
  match s
    case SLeaf => true
    case SNode(l, _, r, d) =>
      well_formed(l) and well_formed(r) and d == snode_depth(l, r) and depth(l) <= depth(r) + 1 and depth(r) <= depth(l) + 1
  end

function upto(n: Int): List[Int] :=
  if n == 0 then Nil else upto(n - 1) ++ [n]

test sets :=
  local s := insert("b", insert("a", empty_set()))

  assert member("a", s) and not member("c", s)
  assign s := insert("a", s)
  assert elements(s) == ["a", "b"] and count(s) == 2
  assert elements(from_list([3, 1, 2, 1])) == [1, 2, 3]
  assert elements(from_list([(2, 'a'), (1, 'b'), (2, 'a')])) == [(1, 'b'), (2, 'a')]
  assert elements(from_list([Some(2), None, Some(1)])) == [None, Some(1), Some(2)]

// ascending elements would make a list of an unbalanced tree
test set_balance :=
  local s := from_list(upto(200))

  assert well_formed(s) and count(s) == 200 and depth(s) <= 11
  assert member(100, s) and not member(201, s) and elements(s) == upto(200)
