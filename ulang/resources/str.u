// strings, which are converted from and to lists of characters by the builtins chars and string,
// and characters, which are converted from and to their codes by ord and chr

infix right 7 ^

function ^(s: Str, t: Str): Str :=
  string(chars(s) ++ chars(t))

function size(s: Str): Int :=
  length(chars(s))

// the strings ss with sep between them, built in one pass
function join(sep: Str, ss: List[Str]): Str :=
  string(joined(chars(sep), ss))

function joined(sep: List[Char], ss: List[Str]): List[Char] :=
  match ss
    case [] => []
    case [s] => chars(s)
    case [s; rest] => chars(s) ++ sep ++ joined(sep, rest)
  end

// the characters of s from i up to but excluding j
function slice(s: Str, i: Int, j: Int): Str :=
  string(first_chars(j - i, after_chars(i, chars(s))))

function first_chars(n: Int, cs: List[Char]): List[Char] :=
  match cs
    case [c; rest] if n > 0 => [c; first_chars(n - 1, rest)]
    else []
  end

function after_chars(n: Int, cs: List[Char]): List[Char] :=
  match cs
    case [_; rest] if n > 0 => after_chars(n - 1, rest)
    else cs
  end

// the parts of s between the occurrences of c
function split(s: Str, c: Char): List[Str] :=
  [string(p) for p in parts(chars(s), c)]

function parts(cs: List[Char], c: Char): List[List[Char]] :=
  match cs
    case [] => [[]]
    case [d; rest] if d == c => [[]; parts(rest, c)]
    case [d; rest] =>
      match parts(rest, c)
        case [p; ps] => [[d; p]; ps]
        else [[d]]
      end
  end

// n in decimal, with a sign if it is negative
function show(n: Int): Str :=
  if n < 0 then "-" ^ string(digits(-n)) else string(digits(n))

function digits(n: Int): List[Char] :=
  if n < 10 then [digit(n)] else digits(n / 10) ++ [digit(n % 10)]

function digit(n: Int): Char :=
  chr(ord('0') + n)

// the number in decimal that s is, the inverse of show
function number(s: Str): Option[Int] :=
  match chars(s)
    case ['-'; ds] =>
      match natural(ds, 0)
        case Some(n) => Some(-n)
        else None
      end
    case ds => natural(ds, 0)
  end

function natural(ds: List[Char], n: Int): Option[Int] :=
  match ds
    case [d] if is_digit(d) => Some(n * 10 + ord(d) - ord('0'))
    case [d; rest] if is_digit(d) => natural(rest, n * 10 + ord(d) - ord('0'))
    else None
  end

function is_digit(c: Char): Bool :=
  ord('0') <= ord(c) and ord(c) <= ord('9')

function is_letter(c: Char): Bool :=
  ord('a') <= ord(c) and ord(c) <= ord('z') or ord('A') <= ord(c) and ord(c) <= ord('Z')

function is_space(c: Char): Bool :=
  c == ' ' or c == '\n' or c == '\t' or c == '\r'
