// the expansions of the constructs that the checked program of ulang/check/check.u keeps as the source wrote them, with
// their names resolved and their types inferred, into the smaller language that the interpreter of ulang/run/run.u, the
// compilers of ulang/compile/, and translate of ulang/prove/translate.u translate, each of which expands the checked
// program first, or a lambda where it meets one

import "ulang/syntax"

export

// q with its commands expanded
function expanded(q: Prog): Prog

function expanded_cmd(cmd: Cmd): Cmd

// the formals and the body of the lambda of variables that a lambda of formals at pos is, where a formal that is no
// variable is a pattern annotated by its type t, as the checker keeps it, which the body matches against a formal of the
// type t that users cannot write: lambda x, p => e is lambda x, (1) => match (1) case p => e end
function expanded_lambda(pos: Pos, span: Span, formals: List[At[Pat]], body: At[Expr]): (List[Var], At[Expr])

implementation

function expanded(q: Prog): Prog :=
  q with cmds := List(for cmd in q.cmds yield map_at(cmd, expanded_cmd))

function expanded_cmd(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, spec, body) =>
      CFun(name, params, formals, typ, expanded_spec(spec), expanded_expr(body))

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(name, params, ins, outs, refs, raised, expanded_spec(spec), expanded_stmt(stmt))

    case CTest(name, vars, stmt) =>
      CTest(name, vars, expanded_stmt(stmt))

    case CLemma(name, params, ins, outs, claim, proof) =>
      CLemma(name, params, ins, outs, expanded_claim(claim), map_option(proof, expanded_proof))

    case CSort(_, _, _)
       | CData(_, _, _)
       | CNotation(_, _, _)
       | CFunSig(_, _, _, _, _)
       | CProcSig(_, _, _, _, _, _, _)
       | CAbstract(_, _)
       | CPatAlias(_, _, _, _, _) =>
      cmd
  end

function expanded_spec(spec: Spec): Spec :=
  spec with pre := List(for a in spec.pre yield expanded_expr(a)), post := map_option(spec.post, expanded_expr)

function expanded_claim(claim: Claim): Claim :=
  match claim
    case ClaimHolds(assms, concl) =>
      ClaimHolds(List(for a in assms yield expanded_expr(a)), expanded_expr(concl))
    case ClaimCorrect(proc, ins, outs) =>
      ClaimCorrect(proc, List(for a in ins yield expanded_expr(a)), outs)
  end

function expanded_proof(proof: Proof): Proof :=
  Proof(List(for step in proof.steps yield map_at(step, expanded_step)), map_option(proof.split, lambda split => map_at(split, expanded_split)))

function expanded_step(step: Step): Step :=
  match step
    case StepLocal(x, value) =>
      StepLocal(x, map_option(value, expanded_expr))

    case StepCall(name, ins, outs) =>
      StepCall(name, List(for a in ins yield expanded_expr(a)), outs)

    case StepAssert(cond) =>
      StepAssert(expanded_expr(cond))

    case StepInvariant(cond) =>
      StepInvariant(expanded_expr(cond))

    case StepAssign(upd) =>
      StepAssign(List(for (x, e) in upd yield (x, expanded_expr(e))))
  end

function expanded_split(split: Split): Split :=
  match split
    case SplitInduction(formal, cases) =>
      SplitInduction(formal, List(for d in cases yield expanded_case(d, expanded_proof)))

    case SplitMatch(arg, cases) =>
      SplitMatch(expanded_expr(arg), List(for d in cases yield expanded_case(d, expanded_proof)))

    case SplitIf(cond, left, right) =>
      SplitIf(expanded_expr(cond), expanded_proof(left), map_option(right, expanded_proof))
  end

function expanded_case[A](d: At[Branch[A]], expand: A -> A): At[Branch[A]] :=
  map_at(d, lambda br => Branch(br.pat, map_option(br.guard, expanded_expr), expand(br.body)))

function expanded_expr(expr: At[Expr]): At[Expr] :=
  map_at(expr, expanded_node)

function expanded_node(expr: Expr): Expr :=
  match expr
    case ELit(_) | EVar(_) =>
      expr

    case EApp(fun, args) =>
      EApp(expanded_expr(fun), List(for a in args yield expanded_expr(a)))

    case EField(base, field) =>
      EField(expanded_expr(base), field)

    case EUpdate(base, field, value) =>
      EUpdate(expanded_expr(base), field, expanded_expr(value))

    case ELam(formals, body) =>
      ELam(formals, expanded_expr(body))

    case EProc(ins, outs, refs, raised, stmt) =>
      EProc(ins, outs, refs, raised, expanded_stmt(stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (p, expanded_expr(e))), expanded_expr(body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(expanded_expr(cond), expanded_expr(then_expr), expanded_expr(else_expr))

    case EMatch(arg, cases) =>
      EMatch(expanded_expr(arg), List(for d in cases yield expanded_case(d, expanded_expr)))

    case ETuple(args) =>
      ETuple(List(for a in args yield expanded_expr(a)))

    case EForm(form, elems, rest) =>
      EForm(form, List(for y in elems yield expanded_yield(y)), map_option(rest, expanded_expr))

    case EFor(form, gens, elem, rest) =>
      EFor(form, List(for g in gens yield expanded_gen(g)), expanded_yield(elem), map_option(rest, expanded_expr))
  end

function expanded_yield(y: Yield): Yield :=
  match y
    case YVal(value) =>
      YVal(expanded_expr(value))
    case YPair(key, value) =>
      YPair(expanded_expr(key), expanded_expr(value))
  end

function expanded_gen(g: Gen): Gen :=
  match g
    case GVal(pat, over) =>
      GVal(pat, expanded_expr(over))

    case GPair(key, value, over) =>
      GPair(key, value, expanded_expr(over))

    case GIf(cond) =>
      GIf(expanded_expr(cond))
  end

function expanded_stmt(stmt: At[Stmt]): At[Stmt] :=
  match stmt
    case AOk(pos, span, that) =>
      AOk(pos, span, expanded_statement(pos, span, that))

    case AErr(pos, span, that, errors) =>
      AErr(pos, span, expanded_statement(pos, span, that), errors)

    case AUnparsed(_, _, _, _) =>
      stmt
  end

// the statement stmt at pos, whose expansions are at pos
function expanded_statement(pos: Pos, span: Span, stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for (x, e) in upd yield (x, expanded_expr(e))))

    case SBlock(locals, stmts) =>
      SBlock(locals, List(for d in stmts yield expanded_stmt(d)))

    case SLocal(mutable, decls) =>
      SLocal(mutable, List(for (p, init) in decls yield (p, map_option(init, expanded_expr))))

    case SIf(cond, left, right) =>
      SIf(expanded_expr(cond), expanded_stmt(left), expanded_stmt(right))

    case SWhile(cond, body) =>
      SWhile(expanded_expr(cond), expanded_stmt(body))

    case SCall(proc, ins, outs, refs) =>
      call_expansion(pos, span, proc, List(for a in ins yield expanded_expr(a)), outs, refs)

    case SMatch(arg, cases) =>
      SMatch(expanded_expr(arg), List(for d in cases yield expanded_case(d, expanded_stmt)))

    case SAssert(cond) =>
      SAssert(expanded_expr(cond))

    case SAssertRaises(typ, pat, guard, body) =>
      SAssertRaises(typ, pat, map_option(guard, expanded_expr), expanded_stmt(body))

    case SRaise(value, typ) =>
      SRaise(expanded_expr(value), typ)

    case STry(body, catches) =>
      STry(expanded_stmt(body), List(for d in catches yield map_at(d, lambda c => c with guard := map_option(c.guard, expanded_expr), body := expanded_stmt(c.body))))

    case SFor(gens, body) =>
      SFor(List(for g in gens yield expanded_gen(g)), expanded_stmt(body))
  end

// a call with an out _, of the type of its out, is a block around the call with a local for each, which nothing reads,
// numbered from 1 under a name that users cannot write
function call_expansion(pos: Pos, span: Span, proc: Name, ins: List[At[Expr]], outs: List[Var], refs: List[Var]): Stmt :=
  if exists(outs, is_dropped) then
    let kept := kept_outs(outs, 1) in
    SBlock(List(for (x, local) in zip(outs, kept) if is_dropped(x) yield AOk(pos, span_at(pos), local)), List(AOk(pos, span, SCall(proc, ins, kept, refs))))
  else
    SCall(proc, ins, outs, refs)

function kept_outs(outs: List[Var], i: Int): List[Var] :=
  match outs
    case List() =>
      List()

    case List(x; rest) =>
      if is_dropped(x) then
        List(
          Var(generated_name("out " ++ show(i)), x.typ); kept_outs(rest, i + 1))
      else
        List(x; kept_outs(rest, i))
  end

function expanded_lambda(pos: Pos, span: Span, formals: List[At[Pat]], body: At[Expr]): (List[Var], At[Expr]) :=
  match pattern_vars(formals)
    case Some(xs) =>
      (xs, body)

    case None =>
      let xs := List(for (p, i) in numbered(formals) yield formal_of(p, i)) in
      (xs, matched_body(pos, span, List(for (p, x) in zip(formals, xs) for q in formal_pattern(p) yield (x, q)), body))
  end

// the variable of a formal that is one, else the formal (i) of the type of its pattern
function formal_of(p: At[Pat], i: Int): Var :=
  match p.that
    case PVar(x) =>
      x

    case PAnnotated(_, t) =>
      Var(unqualified("(" ++ show(i) ++ ")"), t)

    case _ =>
      Var(unqualified("(" ++ show(i) ++ ")"), THole)
  end

// the pattern of a formal that is no variable
function formal_pattern(p: At[Pat]): List[At[Pat]] :=
  match p.that
    case PVar(_) =>
      List()

    case PAnnotated(inner, _) =>
      List(inner)

    case _ =>
      List(p)
  end

// body under a match of the variables against the patterns of pairs, if there are any
function matched_body(pos: Pos, span: Span, pairs: List[(Var, At[Pat])], body: At[Expr]): At[Expr] :=
  match pairs
    case List() =>
      body

    case _ =>
      AOk(pos, span, EMatch(scrutinee(pos, span, firsts(pairs)), List(
        AOk(pos, span, Branch(matched_pattern(pos, span, seconds(pairs)), None, body)))))
  end

function matched_pattern(pos: Pos, span: Span, pats: List[At[Pat]]): At[Pat] :=
  match pats
    case List(pat) =>
      pat
    case _ =>
      AOk(pos, span, PTuple(pats))
  end

function scrutinee(pos: Pos, span: Span, xs: List[Var]): At[Expr] :=
  match xs
    case List(x) =>
      AOk(pos, span, EVar(x))
    case _ =>
      AOk(pos, span, ETuple(List(for x in xs yield AOk(pos, span, EVar(x)))))
  end
