// the parser of ulang, which parses the tokens of ulang/parse/lex.u into programs of ulang/syntax/syntax.u,
// where notation apply to the commands after them, and imports load the packages of directories of the project

import "ulang/syntax"

export

data ParseError :=
  case ParseError(message: Str, pos: Pos)
  // an error of an imported module at its position in that module
  case ImportError(module: Id, message: Str, pos: Pos)
  // the errors of the commands of the main module, more than one, in order, where the parser resumes at the next command
  case ParseErrors(errors: List[ParseError])

function parse_diagnostic(e: ParseError): Diagnostic

// the errors of the modules of source, the parts that do not parse, of the main module as ParseError and of the others as
// ImportError, in load order and by position, so those of the imported modules first
function parse_errors(source: Source): List[ParseError]

function has_errors(source: Source): Bool

// source without the commands that do not parse, which the checker can check, while their names are unknown to it, and
// whose commands with parts that do not parse it checks by their signatures
function without_unparsed(source: Source): Source

// the names that the commands of source declare that do not parse, as far as the parser read them, the name after the
// keyword of a declaration and those after case in a datatype
function unparsed_names(source: Source): Set[Id]

// raises the errors of source: the first one of an imported module, else the one of the main module, or ParseErrors of
// several
procedure require_parsed(in source: Source) raises ParseError

// the modules of the file at path, in load order, each after the modules it imports, with the module of the file last,
// where a module of a project is known by its path from the root without .u, the root being the nearest directory above
// it with project.u, else its own directory, and a module name.u of the library as prelude/name; loading a module loads
// its package, the files with sections of its directory, whose members see each other's exports and notations, and a
// file without sections, a program, sees those of the package of its directory; import "p" loads the package of the
// directory p from the root, whose exports and notations the importing file sees, packages do not import each other
// cyclically, and implicit imports are the library; the modules keep their tests if they are the file or members of its
// package, and lose them else
procedure parse_file(
  in  path: Str,
  out source: Source
) raises ParseError, OsError

procedure parse_file_text(
  in  path: Str,
      text: Str,
  out source: Source
) raises ParseError, OsError

// whether path names a source file, name.u with a name
function is_source(path: Str): Bool

// the module of text without implicit imports and imports, which reads no files, for the tests, parsed with the empty
// notation, so without the operators of the library, such as +
procedure parse_text(in text: Str, out own: Mod) raises ParseError, OsError

// the source of the module main of text as parse_text parses it, with its errors as its parts that do not parse
procedure parse_text_recovering(
  in  text: Str,
  out source: Source
) raises ParseError, OsError

// the source of texts instead of files, for the tests: the members of the package of the directory dir from the root,
// each its module and text, and main, the module and text of the main file, which is one of them or a program in dir,
// where the library and the imported packages are read from their files
procedure parse_texts(
  in  root: Str,
      dir: Str,
      members: List[Id * Str],
      main: Id * Str,
  out source: Source
) raises ParseError, OsError

// the package dir of the members, each its module and text, read elsewhere, loaded into source without their tests, and
// placed right after the library, which is all they see, so that the modules loaded before see them as packages checked
// before, e.g. the enumeration that the tests of lemmas call, which no path names
procedure load_after_library(
  in  dir: Str,
      members: List[Id * Str],
  ref source: Source
) raises ParseError, OsError

// the nearest directory from dir upward with project.u, or else dir, where dir is absolute and normal
procedure project_root(in dir: Str, out root: Str) raises OsError

// the absolute path without . and .. and repeated /
function normal_path(path: Str): Str

implementation

function parse_diagnostic(e: ParseError): Diagnostic :=
  match e
    case ParseError(message, pos) =>
      Diagnostic(ParseKind, "ParseError", None, pos, message, List())

    case ImportError(module, message, pos) =>
      Diagnostic(ParseKind, "ImportError", Some(module), pos, message, List())

    case ParseErrors(errors) =>
      match errors
        case List(first; _) =>
          parse_diagnostic(first)
        case List() =>
          Diagnostic(ParseKind, "ParseErrors", None, Pos(0, 0), "", List())
      end
  end

function parse_errors(source: Source): List[ParseError] :=
  List(for m in source.mods for d in mod_errors(m) yield if m.name == source.main then
    ParseError(d.message, d.pos)
  else
    ImportError(m.name, d.message, d.pos))

function has_errors(source: Source): Bool :=
  exists(source.mods, lambda m => mod_errors(m) != List())

procedure require_parsed(in source: Source) raises ParseError :=
  match parse_errors(source)
    case List() =>
      skip

    case List(ImportError(m, message, pos); _) =>
      raise ImportError(m, message, pos)

    case List(e) =>
      raise e

    case errors =>
      raise ParseErrors(errors)
  end

function without_unparsed(source: Source): Source :=
  source with mods := List(for m in source.mods yield m with exported := whole(m.exported), builtins := whole(m.builtins), implemented := whole(m.implemented))

function unparsed_names(source: Source): Set[Id] :=
  Set(for m in source.mods for d in m.exported ++ m.builtins ++ m.implemented for x in declared_by(d) yield x)

function declared_by(cmd: At[Cmd]): List[Id] :=
  match cmd
    case AUnparsed(_, _, _, error) =>
      List(for (k, v) in error.details if k == "declares" for x in split(v, ',') yield x)
    case _ =>
      List()
  end

// the names that the declaration at the start of toks declares, as far as they are written, up to the next command, the
// name after its keyword and in a datatype those after case
function declared_names(toks: Tokens): List[Id] :=
  match toks
    case List((_, TKw(kw), _), (_, TName(name), _); more) if contains(kw, List("function", "procedure", "pattern", "type")) =>
      List(name)

    case List((_, TKw("data"), _), (_, TName(name), _); more) =>
      List(name; constructor_names(more))

    case _ =>
      List()
  end

function constructor_names(toks: Tokens): List[Id] :=
  match toks
    case List((_, TKw("case"), _), (_, TName(name), _); more) =>
      List(name; constructor_names(more))

    case List((_, tok, _); more) if not is_command_token(tok) =>
      constructor_names(more)

    case _ =>
      List()
  end

function is_command_token(tok: Token): Bool :=
  match tok
    case TKw(kw) =>
      is_command_kw(kw)

    case TEnd =>
      true

    case _ =>
      false
  end

// d with the names that its command declares, as the detail declares, if any
function declaring(d: Diagnostic, names: List[Id]): Diagnostic :=
  if names == List() then
    d
  else
    d with details := d.details ++ List(("declares", join(",", names)))

function whole(docs: List[At[Cmd]]): List[At[Cmd]] :=
  List(for d in docs if is_parsed(d))

// the errors of the parts of the commands of m that do not parse, by position
function mod_errors(m: Mod): List[Diagnostic] :=
  let errors := List(for d in m.exported ++ m.builtins ++ m.implemented for e in cmd_errors(d) yield e) in
  List(for (_, e) in sort(List(for e in errors yield (e.pos, e))) yield e)

function type_ops(): Ops[List[Type]] :=
  Ops("type", starts_type, parse_type_atom, type_apply)

function expr_ops(): Ops[At[Expr]] :=
  Ops("expression", starts_expr, parse_app, lambda in f, op, pos, args, out expr =>
    assign expr := expr_apply(f, op, pos, args)
  end)

function pat_ops(): Ops[At[Pat]] :=
  Ops("pattern", starts_pattern, parse_pattern_atom, lambda in f, op, pos, args, out pat =>
    assign pat := pat_apply(f, op, pos, args)
  end)

// an operator of the notation cmds that already has a notation of the same kind
function duplicate(notation: Notation, cmds: List[Cmd]): Option[Id] :=
  find_map(cmds, lambda cmd => duplicate_op(notation, cmd))

function duplicate_op(notation: Notation, cmd: Cmd): Option[Id] :=
  match cmd
    case CNotation(fixity, _, ops) =>
      find(ops, lambda op => notation_of(notation, fixity, op) != None)
    case _ =>
      None
  end

function redeclared_fixed(notation: Notation, imported: Notation): List[Id] :=
  redeclared_postfix(notation, imported) ++ redeclared_infix(notation, imported)

function redeclared_prefix(notation: Notation, imported: Notation): List[Id] :=
  List(for op => prec in imported.prefix_ops if differs(prefix_prec(notation, op), prec) yield op)

function redeclared_postfix(notation: Notation, imported: Notation): List[Id] :=
  List(for op => prec in imported.postfix_ops if differs(postfix_prec(notation, op), prec) yield op)

function redeclared_infix(notation: Notation, imported: Notation): List[Id] :=
  List(for op => fp in imported.infix_ops if differs(infix_of(notation, op), fp) yield op)

// an operator of the notation of an imported module with another notation of the same kind, where imports may repeat a
// notation as it is
function redeclared(notation: Notation, imported: Notation): Option[Id] :=
  match redeclared_prefix(notation, imported) ++ redeclared_fixed(notation, imported)
    case List(op; _) =>
      Some(op)
    case List() =>
      None
  end

function differs[A](old: Option[A], a: A): Bool :=
  old != None and old != Some(a)

procedure check_duplicates(in notation: Notation, cmds: List[Cmd], pos: Pos) :=
  match duplicate(notation, cmds)
    case Some(op) =>
      raise ParseError("operator " ++ op ++ " is already declared", pos)
    case None =>
      skip
  end

procedure check_imported(in notation: Notation, imported: Notation, pos: Pos) :=
  match redeclared(notation, imported)
    case Some(op) =>
      raise ParseError("imported operator " ++ op ++ " is declared differently", pos)
    case None =>
      skip
  end

function head_token(toks: Tokens): Token :=
  match toks
    case List((_, tok, _); _) =>
      tok
    case _ =>
      TEnd
  end

function second_token(toks: Tokens): Token :=
  match toks
    case List(_, (_, tok, _); _) =>
      tok
    case _ =>
      TEnd
  end

function head_pos(toks: Tokens): Pos :=
  match toks
    case List((p, _, _); _) =>
      p
    case _ =>
      Pos(0, 0)
  end

// the stop of the last token of code before toks, where the part ends that the parser read up to toks
function stop_pos(toks: Tokens): Pos :=
  match toks
    case List((_, _, stop); _) =>
      stop
    case _ =>
      Pos(0, 0)
  end

// the span of the part that starts at start and that the parser read up to toks
function span_from(start: Pos, toks: Tokens): Span :=
  Span(start, stop_pos(toks))

// the span of a token of op at pos, which has no newline
function op_span(op: Id, pos: Pos): Span :=
  Span(pos, Pos(pos.line, pos.col + size(op)))

// the span from the earlier start to the later stop
function span_union(a: Span, b: Span): Span :=
  Span(if b.start < a.start then b.start else a.start, if a.stop < b.stop then b.stop else a.stop)

function at_kw(toks: Tokens, w: Str): Bool :=
  head_token(toks) == TKw(w)

function at_case(toks: Tokens): Bool :=
  at_kw(toks, "case")

function at_comma(toks: Tokens): Bool :=
  at_kw(toks, ",")

function at_mode(toks: Tokens): Bool :=
  at_kw(toks, "in") or at_kw(toks, "out") or at_kw(toks, "ref")

// a comma before another raised type, unless name : of the next formal follows it
function at_raised_type(toks: Tokens): Bool :=
  match toks
    case List((_, TKw(","), _), (_, TName(_), _), (_, TKw(":"), _); _) =>
      false

    case List((_, TKw(","), _), (_, TName(_), _); _) =>
      true

    case _ =>
      false
  end

// a comma before another update
function at_update(toks: Tokens): Bool :=
  match toks
    case List((_, TKw(","), _), (_, TName(_), _), (_, TKw(":="), _); _) =>
      true
    case _ =>
      false
  end

function format_token(tok: Token): Str :=
  match tok
    case TName(name) =>
      name

    case TOp(op) =>
      op

    case TKw(kw) =>
      kw

    case TNum(num) =>
      show(num)

    case THex(num) =>
      hex_text(num)

    case TStr(text) =>
      quote(text)

    case TChar(char) =>
      "'" ++ escape(char, '\'') ++ "'"

    case TEnd =>
      "end of input"
  end

// the error that what is expected but the next token is found, where a keyword is not a name
function expected(what: Str, toks: Tokens): ParseError :=
  match head_token(toks)
    case TKw(kw) if is_keyword(kw) and (what == "name" or what == "pattern") =>
      ParseError("keyword " ++ kw ++ " is not a name", head_pos(toks))
    case tok =>
      ParseError(what ++ " expected but " ++ format_token(tok) ++ " found" ++ hint_at(what, toks), head_pos(toks))
  end

// the form to write where toks start as another language would, after "; ", or ""
function hint_at(what: Str, toks: Tokens): Str :=
  match (head_token(toks), second_token(toks))
    case (TName(x), TKw(":=")) =>
      "; a statement starts with its keyword, as in assign " ++ x ++ " := e"

    case (TName(x), TOp(op)) if is_update(op) =>
      "; write assign " ++ x ++ " := " ++ x ++ " " ++ slice(op, 0, size(op) - 1) ++ " e"

    case (TOp(op), _) if is_update(op) =>
      "; write assign x := x " ++ slice(op, 0, size(op) - 1) ++ " e"

    case (TName(p), TKw("(")) if what == "statement" or what == "declaration" =>
      "; a procedure is called by call " ++ p ++ "(in a, out x), and a function only in an expression"

    case (TName("return"), _) =>
      "; a function is the value of its body, and a procedure gives its results by assigning its outs"

    case (TName("break"), _) =>
      "; a loop ends by its condition or by an exception"

    case (TName("continue"), _) =>
      "; a loop ends by its condition or by an exception"

    case (TName("elif"), _) =>
      "; write else, then if c then … end on the next line, with an end of its own"

    case (TKw("local"), _) if what == "statement" =>
      "; locals are declared at the start of a body, before its statements"

    case (TKw("raise"), _) if what == "expression" =>
      "; functions do not raise, so code that raises is a procedure"

    case (TKw(","), tok) if contains(tok, List(TKw("in"), TKw("out"), TKw("ref"))) =>
      "; modes come in the order in, out, ref, each once before its group, as in ref a, b"

    case (TKw("["), _) =>
      "; containers are forms, List(1, 2), Set(…), Map(k => v), and Array(…), and [ ] holds only type arguments"

    case _ =>
      ""
  end

// the form to write for an undeclared operator of another language, after "; ", or ""
function operator_hint(op: Str): Str :=
  if op == "::" then
    "; a list is built and matched as List(x; rest)"
  else if op == "&&" or op == "!" then
    "; the operators of Bool are and, or, and not"
  else if op == "=" then
    "; equality is =="
  else
    ""

// an operator that updates its left side in other languages, such as +=
function is_update(op: Str): Bool :=
  contains(op, List("+=", "-=", "*=", "/=", "%=", "++="))

function literal_at(toks: Tokens): Option[Lit] :=
  match head_token(toks)
    case TKw("true") =>
      Some(LBool(true))

    case TKw("false") =>
      Some(LBool(false))

    case TNum(num) =>
      Some(LInt(num))

    case THex(num) =>
      Some(LHex(num))

    case TStr(text) =>
      Some(LStr(text))

    case TChar(char) =>
      Some(LChar(char))

    case _ =>
      None
  end

// an operator, or a name that the notation in effect declares as one
function operator_at(notation: Notation, toks: Tokens): Option[Id] :=
  match head_token(toks)
    case TOp(op) =>
      Some(op)

    case TName(name) if is_operator(notation, name) =>
      Some(name)

    case _ =>
      None
  end

procedure advance(ref toks: Tokens) :=
  match toks
    case List(_; more) =>
      assign toks := more
    case _ =>
      skip
  end

// the end of the construct opener at pos, whose error is at the construct, which is still open where the end is missing,
// while the end that is missing may be of a construct inside it, which took the end of this one
procedure expect_end(in opener: Str, pos: Pos, ref toks: Tokens) :=
  match head_token(toks)
    case TKw("end") =>
      call advance(ref toks)
    case tok =>
      raise ParseError("the " ++ opener ++ ", or a construct inside it, has no end: end expected but " ++ format_token(tok) ++ " found", pos)
  end

// the else of the if expression at pos, whose error is at the if, as expect_end reports a missing end, where the else that
// is missing may be of an if inside it, which took the else of this one
procedure expect_else(in pos: Pos, ref toks: Tokens) :=
  match head_token(toks)
    case TKw("else") =>
      call advance(ref toks)
    case tok =>
      raise ParseError("the if, or an if inside it, has no else: else expected but " ++ format_token(tok) ++ " found; an if expression always has its else", pos)
  end

procedure expect(in tok: Token, ref toks: Tokens) :=
  if head_token(toks) == tok then
    call advance(ref toks)
  else
    raise expected(format_token(tok), toks)
  end

procedure parse_name(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TName(m) =>
      assign name := m
      call   advance(ref toks)

    case _ =>
      raise expected("name", toks)
  end

// the package of import "p", the path of its directory from the root of the project, where names have letters, digits,
// and _, also keywords, and are separated by /
procedure parse_import(out name: Id, ref toks: Tokens) :=
  local pos := head_pos(toks)
  match head_token(toks)
    case TStr(path) if is_source(path) =>
      raise ParseError("an import names the directory of a package, not a file", pos)

    case TStr(path) if is_package_path(path) =>
      assign name := path
      call   advance(ref toks)

    case TStr(_) =>
      raise ParseError("an import names a package by its path from the root, of names of letters, digits, and _ only", pos)

    case _ =>
      raise expected("package", toks)
  end

function is_package_path(path: Str): Bool :=
  forall(split(path, '/'), lambda name => size(name) > 0 and is_module_name(name))

function is_module_name(name: Str): Bool :=
  forall(chars(name), lambda c => is_letter(c) or is_digit(c) or c == '_')

// a name that is not declared as an operator
procedure parse_plain_name(
  in  notation: Notation,
      params: List[Id],
  out name: Id,
  ref toks: Tokens
) :=
  match head_token(toks)
    case TName(m) if is_operator(notation, m) =>
      raise ParseError("operator " ++ m ++ " is not a name", head_pos(toks))
    case _ =>
      call parse_name(out name, ref toks)
  end

procedure parse_name_or_op(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TOp(op) =>
      assign name := op
      call   advance(ref toks)

    case _ =>
      call parse_name(out name, ref toks)
  end

// items, at least one, separated by the tokens that more finds
procedure parse_separated[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens) raises ParseError,
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, found: Buffer[A] := empty()
  call   item(in notation, params, out x, ref toks)
  assign found := found ++ List(x)
  while more(toks) do
    call   advance(ref toks)
    call   item(in notation, params, out x, ref toks)
    assign found := found ++ List(x)
  end
  assign xs := List(for y in found)

// items, at least one, without separators, as long as more holds
procedure parse_repeated[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens) raises ParseError,
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, found: Buffer[A] := empty()
  call   item(in notation, params, out x, ref toks)
  assign found := found ++ List(x)
  while more(toks) do
    call   item(in notation, params, out x, ref toks)
    assign found := found ++ List(x)
  end
  assign xs := List(for y in found)

// an argument of an application, a call, or a tuple, or after an error the argument as written up to the next , ) ; out or
// ref outside its brackets and blocks, from its start, as the handler sees the tokens, else the error, since the argument
// does not end
procedure parse_arg(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) raises ParseError :=
  local pos := head_pos(toks)
  try
    call parse_expr(in notation, params, out expr, ref toks)
  catch
    case ParseError(message, at) =>
      local ends: Bool, text: Str
      call skip_arg(in notation, out text, ends, ref toks)
      if not ends then
        raise ParseError(message, at)
      end
      assign expr := AUnparsed(pos, span_from(pos, toks), text, parse_diagnostic(ParseError(message, at)))
  end

// the tokens of an argument up to the next , ) ; out or ref outside its brackets and blocks, joined by spaces, and whether
// it ends there, not at a statement, what ends a body, a command, or the end of the input
procedure skip_arg(
  in  notation: Notation,
  out text: Str,
      ends: Bool,
  ref toks: Tokens
) :=
  local skipped: Buffer[Str] := empty(), prev := TKw("("), blocks := 0, brackets := 0, ites := 0, done := false
  assign ends := false
  while not done do
    if blocks == 0 and brackets == 0 and contains(head_token(toks), List(TKw(","), TKw(")"), TKw(";"), TKw("out"), TKw("ref"))) then
      assign done := true, ends := true
    else
      if head_token(toks) == TEnd or at_command(toks) or blocks == 0 and brackets == 0 and at_next(notation, prev, ites, toks) then
        assign done := true
      else
        call   nest(in prev, toks, ref blocks, brackets, ites)
        assign skipped := skipped ++ List(format_token(head_token(toks))), prev := head_token(toks)
        call   advance(ref toks)
      end
    end
  end
  assign text := joined(List(for t in skipped))

// items separated by commas until close, which may be empty
procedure parse_enclosed[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens) raises ParseError,
      close: Str,
  out xs: List[A],
  ref toks: Tokens
) :=
  if at_kw(toks, close) then
    assign xs := List()
  else
    call parse_separated(in notation, params, item, at_comma, out xs, ref toks)
  end
  call expect(in TKw(close), ref toks)

// an item after tok, if tok is next
procedure parse_optional[A](
  in  notation: Notation,
      params: List[Id],
      tok: Token,
      item: (in Notation, List[Id], out A, ref Tokens) raises ParseError,
  out x: Option[A],
  ref toks: Tokens
) :=
  if head_token(toks) == tok then
    local a: A
    call   advance(ref toks)
    call   item(in notation, params, out a, ref toks)
    assign x := Some(a)
  else
    assign x := None
  end

// the items a, b of a display [a, b], and the rest c of [a, b; c], read with brackets
procedure parse_display[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens) raises ParseError,
  out items: List[A],
      rest: Option[A],
  ref toks: Tokens
) :=
  call parse_separated(in notation, params, item, at_comma, out items, ref toks)
  call parse_optional(in notation, params, TKw(";"), item, out rest, ref toks)

// the items in front of rest by cons, as displays build lists
function cons_all[A](cons: (A, A) -> A, items: List[A], rest: A): A :=
  match items
    case List() =>
      rest
    case List(a; more) =>
      cons(a, cons_all(cons, more, rest))
  end

type Operand[A] :=
  (in Notation, List[Id], out A, ref Tokens) raises ParseError

// an operator applied to its operands, which raises a ParseError if they do not fit
type Apply[A] :=
  (in Fixity, Id, Pos, List[A], out A) raises ParseError

// precedence climbing over the tokens, as Mixfix of easyparse in cuvee, where prefix operators bind their operand
// with their own precedence, and a left associative operator is applied to all operands of a chain at once
data Ops[A] :=
  case Ops(what: Str, starts: (Notation, Token) -> Bool, operand: Operand[A], apply: Apply[A])

// operands and operators, where an operator that cannot be applied is an error
procedure parse_operators[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
  out a: A,
  ref toks: Tokens
) :=
  call climb(in notation, params, ops, 0, out a, ref toks)
  match operator_at(notation, toks)
    case Some(op) =>
      raise ParseError("unexpected operator " ++ op, head_pos(toks))
    case None =>
      skip
  end

// an operand and the operators after it of precedence min or above
procedure climb[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      min: Int,
  out a: A,
  ref toks: Tokens
) :=
  local lhs: A
  call climb_operand(in notation, params, ops, out lhs, ref toks)
  call climb_rest(in notation, params, ops, min, lhs, out a, ref toks)

// an operand, or a prefix operator applied to an operand
procedure climb_operand[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
  out a: A,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), operand := ops.operand, apply := ops.apply
  match operator_at(notation, toks)
    case Some(op) =>
      match prefix_prec(notation, op)
        case Some(prec) =>
          local b: A
          call advance(ref toks)
          call climb(in notation, params, ops, prec, out b, ref toks)
          call apply(in FPrefix, op, pos, List(b), out a)

        case None if is_operator(notation, op) =>
          raise ParseError(op ++ " is not a prefix operator", pos)

        case None =>
          raise ParseError("undeclared operator " ++ op ++ operator_hint(op), pos)
      end

    case None if ops.starts(notation, head_token(toks)) =>
      call operand(in notation, params, out a, ref toks)

    case None =>
      raise expected(ops.what, toks)
  end

// lhs and the operators after it of precedence min or above
procedure climb_rest[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      min: Int,
      lhs: A,
  out a: A,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), apply := ops.apply
  match operator_at(notation, toks)
    case Some(op) =>
      match (postfix_prec(notation, op), infix_of(notation, op))
        case (Some(prec), _) if prec >= min =>
          local b: A
          call advance(ref toks)
          call apply(in FPostfix, op, pos, List(lhs), out b)
          call climb_rest(in notation, params, ops, min, b, out a, ref toks)

        case (_, Some((f, prec))) if prec >= min =>
          local args: List[A], b: A
          call advance(ref toks)
          call climb_infix(in notation, params, ops, op, f, prec, out args, ref toks)
          call apply(in f, op, pos, List(lhs; args), out b)
          call climb_rest(in notation, params, ops, min, b, out a, ref toks)

        case _ if not is_operator(notation, op) =>
          raise ParseError("undeclared operator " ++ op ++ operator_hint(op), pos)

        case _ =>
          assign a := lhs
      end

    case None =>
      assign a := lhs
  end

// the operands after the infix operator op, where a right associative op takes the operators of its own precedence,
// a left associative op takes further operands after more occurrences of op, and a non-associative op only one
procedure climb_infix[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      op: Id,
      f: Fixity,
      prec: Int,
  out args: List[A],
  ref toks: Tokens
) :=
  local next := (if f == FRight then prec else prec + 1)
  call parse_separated(in notation, params, lambda in ns, ps, out b, ref ts =>
    call climb(in ns, ps, ops, next, out b, ref ts)
  end, lambda ts => f == FLeft and operator_at(notation, ts) == Some(op), out args, ref toks)
  match operator_at(notation, toks)
    case Some(other) if f == FInfix and is_prec(infix_of(notation, other), prec) =>
      raise ParseError("operator " ++ op ++ " is not associative", head_pos(toks))
    case _ =>
      skip
  end

function is_prec(fp: Option[Fixity * Int], prec: Int): Bool :=
  match fp
    case Some((_, q)) =>
      q == prec
    case _ =>
      false
  end

// types, whose operands are lists of types, since the arguments of a function are written (A, B),
// and where a chain A * B * C is one tuple type, while (A * B) * C stays nested
//
// the type of an operand, which is a list of other than one type only as the arguments of a function
procedure as_type(in types: List[Type], pos: Pos, out typ: Type) :=
  match types
    case List(t) =>
      assign typ := t

    case List() =>
      assign typ := TTuple(List())

    case _ =>
      raise ParseError("tuple types are written A * B", pos)
  end

procedure as_types(in args: List[List[Type]], pos: Pos, out types: List[Type]) :=
  assign types := List()
  for a in args do
    local typ: Type
    call   as_type(in a, pos, out typ)
    assign types := types ++ List(typ)
  end

// a chain of -> or another infix operator applied from the left, where the first operand of -> is the list of
// arguments of a function
procedure type_apply(
  in  f: Fixity,
      op: Id,
      pos: Pos,
      args: List[List[Type]],
  out r: List[Type]
) :=
  match args
    case List(a) =>
      local typ: Type
      call   as_type(in a, pos, out typ)
      assign r := List(TSort(unqualified(op), List(typ)))

    case _ if op == "*" =>
      local types: List[Type]
      call   as_types(in args, pos, out types)
      assign r := List(TTuple(types))

    case List(a; more) if op == "->" =>
      local types: List[Type]
      call   as_types(in more, pos, out types)
      assign r := foldl(types, a, lambda lhs, typ => List(TFun(lhs, typ)))

    case List(a; more) =>
      local first: Type, types: List[Type]
      call   as_type(in a, pos, out first)
      call   as_types(in more, pos, out types)
      assign r := List(
        foldl(types, first, lambda lhs, typ => TSort(unqualified(op), List(lhs, typ))))

    case List() =>
      assign r := List()
  end

function starts_type(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) =>
      not is_operator(notation, name)

    case TKw("(") =>
      true

    case _ =>
      false
  end

procedure parse_type(
  in  notation: Notation,
      params: List[Id],
  out typ: Type,
  ref toks: Tokens
) :=
  local start := head_pos(toks), r: List[Type]
  call parse_operators(in notation, params, type_ops(), out r, ref toks)
  call as_type(in r, start, out typ)

// a type, a type in parentheses, the arguments (A, B) of a function, or (), where params are the type parameters in scope,
// which distinguish TParam from TSort
procedure parse_type_atom(
  in  notation: Notation,
      params: List[Id],
  out r: List[Type],
  ref toks: Tokens
) :=
  if at_kw(toks, "(") and contains(second_token(toks), List(TKw("in"), TKw("out"), TKw("ref"))) then
    local ins: List[Type], outs: List[Type], refs: List[Type], raised: List[Type]
    call   advance(ref toks)
    call   parse_sections(in notation, params, parse_type, parse_type, out ins, outs, refs, ref toks)
    call   expect(in TKw(")"), ref toks)
    call   parse_raises(in notation, params, out raised, ref toks)
    assign r := List(TProc(ins, outs, refs, TTuple(raised)))
  else
    if at_kw(toks, "(") then
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_type, ")", out r, ref toks)
    else
      local name: Id
      call parse_plain_name(in notation, params, out name, ref toks)
      if at_kw(toks, "[") then
        local args: List[Type]
        call   advance(ref toks)
        call   parse_separated(in notation, params, parse_type, at_comma, out args, ref toks)
        call   expect(in TKw("]"), ref toks)
        assign r := List(TSort(unqualified(name), args))
      else
        if contains(name, params) then
          assign r := List(TParam(name))
        else
          assign r := List(TSort(unqualified(name), List()))
        end
      end
    end
  end

// -n for a number n is the negative literal, in patterns and expressions, and otherwise an operator is applied
function expr_apply(f: Fixity, op: Id, pos: Pos, args: List[At[Expr]]): At[Expr] :=
  match args
    case List(AOk(_, span, ELit(LInt(num)))) if f == FPrefix and op == "-" =>
      AOk(pos, span_union(op_span(op, pos), span), ELit(LInt(0 - num)))

    case List(AOk(_, span, ELit(LHex(num)))) if f == FPrefix and op == "-" =>
      AOk(pos, span_union(op_span(op, pos), span), ELit(LHex(0 - num)))

    case List(a) =>
      AOk(pos, span_union(op_span(op, pos), a.span), ECall(pos, op_span(op, pos), unqualified(op), THole, List(a)))

    case List(a; more) =>
      expr_infix(op, pos, a, more)

    case List() =>
      AOk(pos, op_span(op, pos), ECall(pos, op_span(op, pos), unqualified(op), THole, List()))
  end

// lhs and the operands rs, applied from the left, where op is at pos
function expr_infix(op: Id, pos: Pos, lhs: At[Expr], rs: List[At[Expr]]): At[Expr] :=
  match rs
    case List() =>
      lhs
    case List(r; more) =>
      expr_infix(op, pos, AOk(pos, span_over(lhs, r), ECall(pos, op_span(op, pos), unqualified(op), THole, List(lhs, r))), more)
  end

function starts_expr(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) =>
      not is_operator(notation, name)

    case TKw(kw) =>
      contains(kw, List("let", "if", "lambda", "match", "true", "false", "("))

    case TNum(_) =>
      true

    case THex(_) =>
      true

    case TStr(_) =>
      true

    case TChar(_) =>
      true

    case _ =>
      false
  end

procedure parse_expr(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  call parse_operators(in notation, params, expr_ops(), out expr, ref toks)
  if at_kw(toks, "with") then
    local pos: Pos := head_pos(toks), updates: List[Id * At[Expr]]
    call   advance(ref toks)
    call   parse_separated(in notation, params, parse_update, at_update, out updates, ref toks)
    assign expr := apply_updates(pos, expr, updates)
  end

// f := a in e with f := a
procedure parse_update(
  in  notation: Notation,
      params: List[Id],
  out update: Id * At[Expr],
  ref toks: Tokens
) :=
  local f: Id, a: At[Expr]
  call   parse_name(out f, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_operators(in notation, params, expr_ops(), out a, ref toks)
  assign update := (f, a)

// e with the updates in order, from the left, each at the position of with
function apply_updates(pos: Pos, expr: At[Expr], updates: List[Id * At[Expr]]): At[Expr] :=
  match updates
    case List() =>
      expr
    case List((f, a); more) =>
      apply_updates(pos, AOk(pos, span_over(expr, a), EUpdate(expr, f, a)), more)
  end

// f(x) at the position of f, and e.f at the position of .
procedure parse_app(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  local args: List[At[Expr]], f: Id, pos: Pos
  call parse_expr_atom(in notation, params, out expr, ref toks)
  while at_kw(toks, "(") or at_kw(toks, ".") do
    if at_kw(toks, "(") then
      call   advance(ref toks)
      call   parse_enclosed(in notation, params, parse_arg, ")", out args, ref toks)
      assign expr := AOk(expr.pos, span_from(expr.span.start, toks), EApp(expr, args))
    else
      assign pos := head_pos(toks)
      call   advance(ref toks)
      call   parse_name(out f, ref toks)
      assign expr := AOk(pos, span_from(expr.span.start, toks), EField(expr, f))
    end
  end

procedure parse_expr_atom(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  local pos := head_pos(toks)
  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign expr := AOk(pos, span_from(pos, toks), ELit(v))

    case (_, TKw("let")) =>
      call parse_let(in notation, params, out expr, ref toks)

    case (_, TKw("if")) =>
      local a: At[Expr], l: At[Expr], r: At[Expr]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out a, ref toks)
      call   expect(in TKw("then"), ref toks)
      call   parse_expr(in notation, params, out l, ref toks)
      call   expect_else(in pos, ref toks)
      call   parse_expr(in notation, params, out r, ref toks)
      assign expr := AOk(pos, span_from(pos, toks), EIte(a, l, r))

    case (_, TKw("lambda")) =>
      call parse_lambda(in notation, params, out expr, ref toks)

    case (_, TKw("match")) =>
      local a: At[Expr], cases: List[At[Branch[At[Expr]]]]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out a, ref toks)
      call   parse_cases(in notation, params, parse_expr, "match", pos, out cases, ref toks)
      assign expr := AOk(pos, span_from(pos, toks), EMatch(a, cases))

    case (_, TKw("(")) =>
      local exprs: List[At[Expr]]
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_arg, ")", out exprs, ref toks)
      match exprs
        case List(inner) =>
          assign expr := inner
        case _ =>
          assign expr := AOk(pos, span_from(pos, toks), ETuple(exprs))
      end

    case _ if form_at(toks) != None =>
      call parse_form(in notation, params, out expr, ref toks)

    case (_, TName(name)) if form_of(name) != None =>
      raise no_value(name, pos)

    case (_, TName(name)) if not is_operator(notation, name) =>
      call   advance(ref toks)
      assign expr := AOk(pos, span_from(pos, toks), EName(unqualified(name), THole))

    case _ =>
      raise expected("expression", toks)
  end

// let p := e, q := f in body binds in parallel
procedure parse_let(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  local pos := head_pos(toks), bindings: List[At[Pat] * At[Expr]], body: At[Expr]
  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_binding, at_comma, out bindings, ref toks)
  call   expect(in TKw("in"), ref toks)
  call   parse_expr(in notation, params, out body, ref toks)
  assign expr := AOk(pos, span_from(pos, toks), ELet(bindings, body))

// p := e
procedure parse_binding(
  in  notation: Notation,
      params: List[Id],
  out binding: At[Pat] * At[Expr],
  ref toks: Tokens
) :=
  local pat: At[Pat], expr: At[Expr]
  call   parse_pattern(in notation, params, out pat, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_expr(in notation, params, out expr, ref toks)
  assign binding := (pat, expr)

// lambda x, y => e is a function, and lambda in x, out y, ref z => body end a procedure, told apart by the modes, where
// the formals of a function may be patterns, which it matches as let does
procedure parse_lambda(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  local pos := head_pos(toks)
  call advance(ref toks)
  if at_mode(toks) then
    local ins: List[At[Var]], outs: List[At[Var]], refs: List[At[Var]], body: At[Stmt]
    call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   parse_body(in notation, params, out body, ref toks)
    call   expect_end(in "lambda", pos, ref toks)
    assign expr := AOk(pos, span_from(pos, toks), EProc(ins, outs, refs, THole, body))
  else
    if head_token(toks) == TKw("=>") then
      local inner: At[Expr]
      call   expect(in TKw("=>"), ref toks)
      call   parse_expr(in notation, params, out inner, ref toks)
      assign expr := AOk(pos, span_from(pos, toks), ELam(List(), inner))
    else
      local pats: List[At[Pat]], inner: At[Expr]
      call   parse_separated(in notation, params, parse_pattern, at_comma, out pats, ref toks)
      call   expect(in TKw("=>"), ref toks)
      call   parse_expr(in notation, params, out inner, ref toks)
      assign expr := AOk(pos, span_from(pos, toks), ELam(pats, inner))
    end
  end

// the form that starts the tokens, List(…) and the like, where a name of a form is one only before (, and else names a type
function form_at(toks: Tokens): Option[Form] :=
  match (head_token(toks), second_token(toks))
    case (TName(name), TKw("(")) =>
      form_of(name)
    case _ =>
      None
  end

// the names of the forms are no values, so that no declaration takes them and no expression names one alone
procedure check_value_name(in name: Id, pos: Pos) :=
  if form_of(name) != None then
    raise no_value(name, pos)
  end

function no_value(name: Id, pos: Pos): ParseError :=
  ParseError(name ++ "(…) is a form, which is no value", pos)

function form_of(name: Str): Option[Form] :=
  match name
    case "List" =>
      Some(FList)

    case "Set" =>
      Some(FSet)

    case "Map" =>
      Some(FMap)

    case "Array" =>
      Some(FArray)

    case _ =>
      None
  end

function no_yield(pos: Pos): ParseError :=
  ParseError("yield is needed after several generators, or after a generator whose pattern is no value", pos)

// List(a, b; r), with the container r that the elements are added to, List(for gens yield e; r), and List(), where map takes
// entries k => v, and arrays have no rest
procedure parse_form(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  local form := value_or(form_at(toks), FList), pos := head_pos(toks), rest: Option[At[Expr]]
  call advance(ref toks)
  call expect(in TKw("("), ref toks)
  if at_kw(toks, "for") then
    local elem: Yield, gens: List[Gen]
    call parse_gens(in notation, params, out gens, ref toks)
    if at_kw(toks, "yield") then
      call advance(ref toks)
      call parse_elem(in notation, params, form, out elem, ref toks)
    else
      match implicit_elem(form, gens)
        case Some(e) =>
          assign elem := e
        case None =>
          raise no_yield(pos)
      end
    end
    call   parse_optional(in notation, params, TKw(";"), parse_expr, out rest, ref toks)
    assign expr := AOk(pos, span_from(pos, toks), EFor(form, gens, elem, rest))
  else
    local elems: List[Yield]
    if at_kw(toks, ")") then
      assign elems := List(), rest := None
    else
      call parse_separated(in notation, params, lambda in n, ps, out e, ref ts =>
        call parse_elem(in n, ps, form, out e, ref ts)
      end, at_comma, out elems, ref toks)
      call parse_optional(in notation, params, TKw(";"), parse_expr, out rest, ref toks)
    end
    assign expr := AOk(pos, span_from(pos, toks), EForm(form, elems, rest))
  end
  if form == FArray and rest != None then
    raise ParseError("arrays have no rest", pos)
  end
  call expect(in TKw(")"), ref toks)

// an element e, or an entry k => v of a map
procedure parse_elem(
  in  notation: Notation,
      params: List[Id],
      form: Form,
  out elem: Yield,
  ref toks: Tokens
) :=
  local k: At[Expr]
  call parse_expr(in notation, params, out k, ref toks)
  if form == FMap then
    local v: At[Expr]
    if not at_kw(toks, "=>") then
      raise ParseError("=> expected but " ++ format_token(head_token(toks)) ++ " found; a Map yields entries k => v", head_pos(toks))
    end
    call   expect(in TKw("=>"), ref toks)
    call   parse_expr(in notation, params, out v, ref toks)
    assign elem := YPair(k, v)
  else
    assign elem := YVal(k)
  end

// generators for p in c and for k => v in m, and guards if q, from left to right, starting with a generator
procedure parse_gens(
  in  notation: Notation,
      params: List[Id],
  out gens: List[Gen],
  ref toks: Tokens
) :=
  local found: Buffer[Gen] := empty(), p: At[Pat], v: At[Pat], c: At[Expr]
  while at_kw(toks, "for") or size(found) > 0 and at_kw(toks, "if") do
    if at_kw(toks, "for") then
      call advance(ref toks)
      call parse_pattern(in notation, params, out p, ref toks)
      if at_kw(toks, "=>") then
        call   advance(ref toks)
        call   parse_pattern(in notation, params, out v, ref toks)
        call   expect(in TKw("in"), ref toks)
        call   parse_expr(in notation, params, out c, ref toks)
        assign found := found ++ List(GPair(p, v, c))
      else
        call   expect(in TKw("in"), ref toks)
        call   parse_expr(in notation, params, out c, ref toks)
        assign found := found ++ List(GVal(p, c))
      end
    else
      call   advance(ref toks)
      call   parse_expr(in notation, params, out c, ref toks)
      assign found := found ++ List(GIf(c))
    end
  end
  assign gens := List(for g in found)

// case p if g => b, up to end, each at its keyword case
procedure parse_cases[B](
  in  notation: Notation,
      params: List[Id],
      body: (in Notation, List[Id], out B, ref Tokens) raises ParseError,
      opener: Str,
      start: Pos,
  out cases: List[At[Branch[B]]],
  ref toks: Tokens
) :=
  local found: Buffer[At[Branch[B]]] := empty(), pat: At[Pat], g: Option[At[Expr]], b: B, pos: Pos
  while at_case(toks) do
    assign pos := head_pos(toks)
    call   advance(ref toks)
    call   parse_pattern(in notation, params, out pat, ref toks)
    call   parse_optional(in notation, params, TKw("if"), parse_expr, out g, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   body(in notation, params, out b, ref toks)
    assign found := found ++ List(AOk(pos, span_from(pos, toks), Branch(pat, g, b)))
  end
  call   expect_end(in opener, start, ref toks)
  assign cases := List(for c in found)

// patterns, where operators are constructors, at the position of the operator
function pat_apply(f: Fixity, op: Id, pos: Pos, args: List[At[Pat]]): At[Pat] :=
  match args
    case List(AOk(_, span, PLit(LInt(num)))) if f == FPrefix and op == "-" =>
      AOk(pos, span_union(op_span(op, pos), span), PLit(LInt(0 - num)))

    case List(AOk(_, span, PLit(LHex(num)))) if f == FPrefix and op == "-" =>
      AOk(pos, span_union(op_span(op, pos), span), PLit(LHex(0 - num)))

    case List(pat) =>
      AOk(pos, span_union(op_span(op, pos), pat.span), PApp(unqualified(op), List(pat)))

    case List(pat; more) =>
      pat_infix(op, pos, pat, more)

    case List() =>
      AOk(pos, op_span(op, pos), PApp(unqualified(op), List()))
  end

// lhs and the operands rs, applied from the left
function pat_infix(op: Id, pos: Pos, lhs: At[Pat], rs: List[At[Pat]]): At[Pat] :=
  match rs
    case List() =>
      lhs
    case List(r; more) =>
      pat_infix(op, pos, AOk(pos, span_over(lhs, r), PApp(unqualified(op), List(lhs, r))), more)
  end

// the cells of a list pattern, at the position of its form List and over its span
function pat_cons(pos: Pos, span: Span): (At[Pat], At[Pat]) -> At[Pat] :=
  lambda a, b => AOk(pos, span, PApp(unqualified("Cons"), List(a, b)))

function pat_nil(pos: Pos, span: Span): At[Pat] :=
  AOk(pos, span, PApp(unqualified("Nil"), List()))

function starts_pattern(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) =>
      not is_operator(notation, name)

    case TKw(kw) =>
      contains(kw, List("_", "true", "false", "("))

    case TNum(_) =>
      true

    case THex(_) =>
      true

    case TStr(_) =>
      true

    case TChar(_) =>
      true

    case _ =>
      false
  end

procedure parse_pattern(
  in  notation: Notation,
      params: List[Id],
  out pat: At[Pat],
  ref toks: Tokens
) :=
  call parse_operators(in notation, params, pat_ops(), out pat, ref toks)

procedure parse_pattern_atom(
  in  notation: Notation,
      params: List[Id],
  out pat: At[Pat],
  ref toks: Tokens
) :=
  local pos := head_pos(toks)
  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign pat := AOk(pos, span_from(pos, toks), PLit(v))

    case (_, TKw("_")) =>
      call   advance(ref toks)
      assign pat := AOk(pos, span_from(pos, toks), PWild)

    case (_, TKw("(")) =>
      local pats: List[At[Pat]]
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_pattern, ")", out pats, ref toks)
      match pats
        case List(inner) =>
          assign pat := inner
        case _ =>
          assign pat := AOk(pos, span_from(pos, toks), PTuple(pats))
      end

    // List(), List(a, b), and List(a, b; rest), since only lists have free constructors
    case _ if form_at(toks) == Some(FList) =>
      call advance(ref toks)
      call expect(in TKw("("), ref toks)
      if at_kw(toks, ")") then
        call   advance(ref toks)
        assign pat := pat_nil(pos, span_from(pos, toks))
      else
        local pats: List[At[Pat]], rest: Option[At[Pat]]
        call   parse_display(in notation, params, parse_pattern, out pats, rest, ref toks)
        call   expect(in TKw(")"), ref toks)
        assign pat := cons_all(pat_cons(pos, span_from(pos, toks)), pats, value_or(rest, pat_nil(pos, span_from(pos, toks))))
      end

    case _ =>
      local name: Id
      call parse_plain_name(in notation, params, out name, ref toks)
      if at_kw(toks, "(") then
        local pats: List[At[Pat]]
        call   advance(ref toks)
        call   parse_enclosed(in notation, params, parse_pattern, ")", out pats, ref toks)
        assign pat := AOk(pos, span_from(pos, toks), PApp(unqualified(name), pats))
      else
        assign pat := AOk(pos, span_from(pos, toks), PName(unqualified(name), THole))
      end
  end

function starts_stmt(tok: Token): Bool :=
  match tok
    case TKw(kw) =>
      contains(kw, List(
        "skip",
        "if",
        "while",
        "for",
        "call",
        "match",
        "assert",
        "assign",
        "raise",
        "try"))

    case _ =>
      false
  end

function handlers(cases: List[At[Branch[At[Stmt]]]]): List[At[Catch]] :=
  List(for d in cases yield map_at(d, lambda b => Catch(THole, b.pat, b.guard, b.body)))

// the body of an if, while, case, or procedure, at its first token, which may declare variables first, up to what ends it,
// end, else, catch, case, or a command
// where local x := e initializes x by an assignment at the start of the block, in order, such that its type can be inferred
procedure parse_body(
  in  notation: Notation,
      params: List[Id],
  out body: At[Stmt],
  ref toks: Tokens
) :=
  local pos := head_pos(toks), xs: List[At[Var]] := List(), inits: List[At[Stmt]] := List(), decls: List[At[Var] * List[At[Stmt]]], found: Buffer[At[Stmt]] := empty(), stmt: At[Stmt]
  while at_kw(toks, "local") do
    call   advance(ref toks)
    call   parse_separated(in notation, params, parse_local, at_comma, out decls, ref toks)
    assign xs := xs ++ firsts(decls), inits := inits ++ concat(seconds(decls))
  end
  while at_stmt(toks) do
    call   parse_stmt_recovering(in notation, params, out stmt, ref toks)
    assign found := found ++ List(stmt)
  end
  assign body := AOk(pos, span_from(pos, toks), SBlock(xs, inits ++ List(for t in found)))

// whether the next token starts a statement, or something else that is neither a command nor ends a body, which a
// statement that does not parse then is
function at_stmt(toks: Tokens): Bool :=
  match head_token(toks)
    case TKw(kw) =>
      starts_stmt(TKw(kw)) or not ends_body(kw) and not is_command_kw(kw)

    case TEnd =>
      false

    case tok =>
      not is_elif(tok)
  end

function ends_body(kw: Str): Bool :=
  contains(kw, List("end", "else", "catch", "case"))

// elif ends the body of an if, which reports it, as else would
function is_elif(tok: Token): Bool :=
  tok == TName("elif")

function ends_body_token(tok: Token): Bool :=
  match tok
    case TKw(kw) =>
      ends_body(kw)
    case _ =>
      false
  end

// a statement, or after an error the statement as written up to the next line at its column or to its left, from the
// start of the statement, as the handler sees the tokens
procedure parse_stmt_recovering(
  in  notation: Notation,
      params: List[Id],
  out stmt: At[Stmt],
  ref toks: Tokens
) :=
  local pos := head_pos(toks)
  try
    call parse_stmt(in notation, params, out stmt, ref toks)
  catch
    case ParseError(message, at) =>
      local text: Str
      call   skip_stmt(in notation, out text, ref toks)
      assign stmt := AUnparsed(pos, span_from(pos, toks), text, parse_diagnostic(ParseError(message, at)))
  end

// the tokens of a statement, at least its first, up to the next statement, what ends the body, or a command, outside
// the brackets and blocks of the statement, joined by spaces, where a statement that opens a block takes its end, and one
// of two names, as return x, takes both
procedure skip_stmt(in notation: Notation, out text: Str, ref toks: Tokens) :=
  local skipped: Buffer[Str] := empty(), prev := TKw("skip"), blocks := 0, brackets := 0, ites := 0, done := false, first := true
  if is_name_token(head_token(toks)) and is_name_token(second_token(toks)) then
    assign skipped := skipped ++ List(format_token(head_token(toks)), format_token(second_token(toks))), prev := second_token(toks), first := false
    call   advance(ref toks)
    call   advance(ref toks)
  end
  while not done do
    if head_token(toks) == TEnd or at_command(toks) or not first and blocks == 0 and brackets == 0 and at_next(notation, prev, ites, toks) then
      assign done := true
    else
      call   nest(in prev, toks, ref blocks, brackets, ites)
      assign skipped := skipped ++ List(format_token(head_token(toks))), prev := head_token(toks), first := false
      call   advance(ref toks)
    end
  end
  assign text := joined(List(for t in skipped))

function is_name_token(tok: Token): Bool :=
  match tok
    case TName(_) =>
      true
    case _ =>
      false
  end

// whether toks start what follows a statement after prev: the next statement or what ends the body, where an else
// is of one of the ites if expressions that are open
function at_next(notation: Notation, prev: Token, ites: Int, toks: Tokens): Bool :=
  match head_token(toks)
    case TKw("else") =>
      ites == 0

    case TKw(kw) if ends_body(kw) =>
      true

    case tok =>
      is_elif(tok) or starts_stmt_after(notation, prev, tok)
  end

// whether tok starts a statement after prev, where if and match start one only after what ends a statement or opens a
// body, since they also start expressions, and a name that is no operator after what ends an expression, which no
// expression continues by a name
function starts_stmt_after(notation: Notation, prev: Token, tok: Token): Bool :=
  match tok
    case TKw("if") =>
      is_stmt_end(prev)

    case TKw("match") =>
      is_stmt_end(prev)

    case TKw("local") =>
      true

    case TName(name) =>
      ends_expr(prev) and not is_operator(notation, name)

    case _ =>
      starts_stmt(tok)
  end

// whether tok ends an expression or a statement
function ends_expr(tok: Token): Bool :=
  match tok
    case TName(_) =>
      true

    case TNum(_) =>
      true

    case THex(_) =>
      true

    case TStr(_) =>
      true

    case TChar(_) =>
      true

    case TKw(kw) =>
      contains(kw, List(")", "]", "end", "skip", "true", "false"))

    case _ =>
      false
  end

// whether a statement may start after tok, which ends an expression or a statement, or opens a body
function is_stmt_end(tok: Token): Bool :=
  ends_expr(tok) or contains(tok, List(TKw("then"), TKw("else"), TKw("do"), TKw("=>"), TKw("try")))

// the depths of the blocks that end closes, of the brackets, and of the if expressions that else closes after the next
// token, which follows prev, where a block opens outside brackets, which enclose what is inside, at while, for, match,
// try, an if that starts a statement, assert raises, and a lambda of a procedure
procedure nest(
  in  prev: Token,
      toks: Tokens,
  ref blocks: Int,
      brackets: Int,
      ites: Int
) :=
  match head_token(toks)
    case TKw(kw) if kw == "(" or kw == "[" =>
      assign brackets := brackets + 1

    case TKw(kw) if (kw == ")" or kw == "]") and brackets > 0 =>
      assign brackets := brackets - 1

    case _ if brackets > 0 =>
      skip

    case TKw("end") if blocks > 0 =>
      assign blocks := blocks - 1

    case TKw(kw) if contains(kw, List("while", "for", "match", "try")) =>
      assign blocks := blocks + 1

    case TKw("if") if is_stmt_end(prev) =>
      assign blocks := blocks + 1

    case TKw("if") =>
      assign ites := ites + 1

    case TKw("else") if ites > 0 =>
      assign ites := ites - 1

    case TKw("assert") if second_token(toks) == TKw("raises") =>
      assign blocks := blocks + 1

    case TKw("lambda") if is_mode(second_token(toks)) =>
      assign blocks := blocks + 1

    case _ =>
      skip
  end

function is_mode(tok: Token): Bool :=
  tok == TKw("in") or tok == TKw("out") or tok == TKw("ref")

// x: T, x := e, or x: T := e, where the checker requires a type or an initial value
procedure parse_local(
  in  notation: Notation,
      params: List[Id],
  out decl: At[Var] * List[At[Stmt]],
  ref toks: Tokens
) :=
  local pos := head_pos(toks), x: At[Var], init: Option[At[Expr]]
  call parse_formal(in notation, params, out x, ref toks)
  call parse_optional(in notation, params, TKw(":="), parse_expr, out init, ref toks)
  match init
    case Some(expr) =>
      assign decl := (x, List(
        AOk(pos, span_from(pos, toks), SAssign(List((Var(x.that.name, THole), expr))))))

    case None =>
      assign decl := (x, List())
  end

// for p in c if q do body end, or for k => v in m do body end, of one generator and an optional guard
procedure parse_for(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), gens: List[Gen], body: At[Stmt]
  call parse_gens(in notation, params, out gens, ref toks)
  if not is_loop(gens) then
    raise ParseError("for takes one generator and an optional condition", pos)
  end
  call   expect(in TKw("do"), ref toks)
  call   parse_body(in notation, params, out body, ref toks)
  call   expect_end(in "for", pos, ref toks)
  assign stmt := SFor(gens, body)

// whether gens are one generator and an optional guard, which a for statement takes
function is_loop(gens: List[Gen]): Bool :=
  match gens
    case List(GIf(_); _) =>
      false

    case List(_) =>
      true

    case List(_, GIf(_)) =>
      true

    case _ =>
      false
  end

// a statement at its keyword
procedure parse_stmt(
  in  notation: Notation,
      params: List[Id],
  out stmt: At[Stmt],
  ref toks: Tokens
) :=
  local pos := head_pos(toks), node: Stmt
  match head_token(toks)
    case TKw("skip") =>
      call   advance(ref toks)
      assign node := SSkip

    case TKw("if") =>
      call parse_if(in notation, params, out node, ref toks)

    case TKw("while") =>
      local expr: At[Expr], body: At[Stmt]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   expect(in TKw("do"), ref toks)
      call   parse_body(in notation, params, out body, ref toks)
      call   expect_end(in "while", pos, ref toks)
      assign node := SWhile(expr, body)

    case TKw("for") =>
      call parse_for(in notation, params, out node, ref toks)

    case TKw("call") =>
      call parse_call(in notation, params, out node, ref toks)

    case TKw("match") =>
      local expr: At[Expr], cases: List[At[Branch[At[Stmt]]]]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   parse_cases(in notation, params, parse_body, "match", pos, out cases, ref toks)
      assign node := SMatch(expr, cases)

    case TKw("assert") =>
      call advance(ref toks)
      call parse_assert(in notation, params, out node, ref toks)

    case TKw("assign") =>
      call parse_assign(in notation, params, out node, ref toks)

    case TKw("raise") =>
      local expr: At[Expr]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      assign node := SRaise(expr, THole)

    case TKw("try") =>
      local body: At[Stmt], cases: List[At[Branch[At[Stmt]]]]
      call   advance(ref toks)
      call   parse_body(in notation, params, out body, ref toks)
      call   expect(in TKw("catch"), ref toks)
      call   parse_cases(in notation, params, parse_body, "try", pos, out cases, ref toks)
      assign node := STry(body, handlers(cases))

    case _ =>
      raise expected("statement", toks)
  end
  assign stmt := AOk(pos, span_from(pos, toks), node)

// assert c, or assert raises p do … end
procedure parse_assert(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  if at_kw(toks, "raises") then
    local pat: At[Pat], body: At[Stmt], pos := head_pos(toks)
    call   advance(ref toks)
    call   parse_pattern(in notation, params, out pat, ref toks)
    call   expect(in TKw("do"), ref toks)
    call   parse_body(in notation, params, out body, ref toks)
    call   expect_end(in "assert raises", pos, ref toks)
    assign stmt := SAssertRaises(THole, pat, body)
  else
    local expr: At[Expr]
    call   parse_expr(in notation, params, out expr, ref toks)
    assign stmt := SAssert(expr)
  end

// then ends the condition, and an if after else is nested, with an end of its own
procedure parse_if(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), cond: At[Expr], l: At[Stmt], r: At[Stmt]
  call advance(ref toks)
  call parse_expr(in notation, params, out cond, ref toks)
  call expect(in TKw("then"), ref toks)
  call parse_body(in notation, params, out l, ref toks)
  if head_token(toks) == TName("elif") then
    raise expected("else or end", toks)
  end
  if at_kw(toks, "else") then
    call advance(ref toks)
    call parse_body(in notation, params, out r, ref toks)
  else
    assign r := AOk(head_pos(toks), span_at(head_pos(toks)), SSkip)
  end
  call   expect_end(in "if", pos, ref toks)
  assign stmt := SIf(cond, l, r)

procedure parse_assign(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local assignments: List[Var * At[Expr]]
  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_assignment, at_comma, out assignments, ref toks)
  assign stmt := SAssign(assignments)

// x := e
procedure parse_assignment(
  in  notation: Notation,
      params: List[Id],
  out assignment: Var * At[Expr],
  ref toks: Tokens
) :=
  local x: Var, expr: At[Expr]
  call   parse_variable(in notation, params, out x, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_expr(in notation, params, out expr, ref toks)
  assign assignment := (x, expr)

// the next section starts with keyword w, after a comma unless it is the first section
function section_starts(toks: Tokens, w: Str, first: Bool): Bool :=
  if first then
    at_kw(toks, w)
  else
    at_kw(toks, ",") and second_token(toks) == TKw(w)

// a comma before another item of a section, not before the keyword of a section, which may be out of order
function section_continues(toks: Tokens): Bool :=
  at_kw(toks, ",") and not contains(second_token(toks), List(TKw("in"), TKw("out"), TKw("ref")))

// call p(in ins, out outs, ref refs)
procedure parse_call(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local p: Id, ins: List[At[Expr]], outs: List[Var], refs: List[Var]
  call   advance(ref toks)
  call   parse_name(out p, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_arg, parse_variable, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  assign stmt := SCall(unqualified(p), ins, outs, refs)

// in ins, out outs, ref refs of calls, declarations, lambdas, and types, where each section starts with its keyword,
// and empty sections are omitted
procedure parse_sections[A, B](
  in  notation: Notation,
      params: List[Id],
      item_in: (in Notation, List[Id], out A, ref Tokens) raises ParseError,
      item: (in Notation, List[Id], out B, ref Tokens) raises ParseError,
  out ins: List[A],
      outs: List[B],
      refs: List[B],
  ref toks: Tokens
) :=
  local first := true
  assign ins := List(), outs := List(), refs := List()
  if at_kw(toks, "in") then
    call   advance(ref toks)
    call   parse_separated(in notation, params, item_in, section_continues, out ins, ref toks)
    assign first := false
  end
  if section_starts(toks, "out", first) then
    call   skip_section_start(in first, ref toks)
    call   parse_separated(in notation, params, item, section_continues, out outs, ref toks)
    assign first := false
  end
  if section_starts(toks, "ref", first) then
    call skip_section_start(in first, ref toks)
    call parse_separated(in notation, params, item, section_continues, out refs, ref toks)
  end

// the comma before a section unless it is the first, and the keyword of the section
procedure skip_section_start(in first: Bool, ref toks: Tokens) :=
  if not first then
    call advance(ref toks)
  end
  call advance(ref toks)

procedure parse_variable(
  in  notation: Notation,
      params: List[Id],
  out x: Var,
  ref toks: Tokens
) :=
  local name: Id
  call   parse_plain_name(in notation, params, out name, ref toks)
  assign x := Var(unqualified(name), THole)

// only parameters and locals have type annotations
procedure parse_formal(
  in  notation: Notation,
      params: List[Id],
  out x: At[Var],
  ref toks: Tokens
) :=
  local pos := head_pos(toks), name: Id, typ: Option[Type]
  call   parse_plain_name(in notation, params, out name, ref toks)
  call   parse_optional(in notation, params, TKw(":"), parse_type, out typ, ref toks)
  assign x := AOk(pos, span_from(pos, toks), Var(unqualified(name), value_or(typ, THole)))

// formals in parentheses, which may be empty
procedure parse_formals(
  in  notation: Notation,
      params: List[Id],
  out xs: List[At[Var]],
  ref toks: Tokens
) :=
  call expect(in TKw("("), ref toks)
  call parse_enclosed(in notation, params, parse_formal, ")", out xs, ref toks)

// the module d without its tests, lemmas, and examples, which only its own tests and proofs use, as an import loads it
function without_tests_of(d: Mod): Mod :=
  d with exported := unexampled(d.exported), builtins := unexampled(d.builtins), implemented := unexampled(untested(d.implemented))

function unexampled(cmds: List[At[Cmd]]): List[At[Cmd]] :=
  List(for c in cmds yield map_at(c, without_examples))

function without_examples(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, _, body) =>
      CFun(name, params, formals, typ, no_spec(), body)

    case CFunSig(name, params, formals, typ, _) =>
      CFunSig(name, params, formals, typ, no_spec())

    case CProc(name, params, ins, outs, refs, raised, _, stmt) =>
      CProc(name, params, ins, outs, refs, raised, no_spec(), stmt)

    case CProcSig(name, params, ins, outs, refs, raised, _) =>
      CProcSig(name, params, ins, outs, refs, raised, no_spec())

    case _ =>
      cmd
  end

function is_test(c: At[Cmd]): Bool :=
  match c
    case AOk(_, _, CTest(_, _, _)) =>
      true

    case AOk(_, _, CLemma(_, _, _, _, _, _)) =>
      true

    case _ =>
      false
  end

function untested(cmds: List[At[Cmd]]): List[At[Cmd]] :=
  List(for c in cmds if not is_test(c))

// the type parameters [A, B] of a declaration, if any
procedure parse_params(
  in  notation: Notation,
  out params: List[Id],
  ref toks: Tokens
) :=
  if at_kw(toks, "[") then
    call advance(ref toks)
    call parse_separated(in notation, List(), parse_param, at_comma, out params, ref toks)
    call expect(in TKw("]"), ref toks)
  else
    assign params := List()
  end

procedure parse_param(
  in  notation: Notation,
      params: List[Id],
  out name: Id,
  ref toks: Tokens
) :=
  call parse_name(out name, ref toks)

procedure parse_notation(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local f := FInfix, prec: Int, ops: List[Id]
  match head_token(toks)
    case TKw("prefix") =>
      assign f := FPrefix

    case TKw("postfix") =>
      assign f := FPostfix

    case _ =>
      match second_token(toks)
        case TName("left") =>
          assign f := FLeft
          call   advance(ref toks)

        case TName("right") =>
          assign f := FRight
          call   advance(ref toks)

        case _ =>
          skip
      end
  end
  call advance(ref toks)
  match head_token(toks)
    case TNum(num) =>
      assign prec := num
      call   advance(ref toks)

    case _ =>
      raise expected("precedence", toks)
  end
  call   parse_repeated(in notation, List(), parse_operator, at_operator, out ops, ref toks)
  assign cmd := CNotation(f, prec, ops)

// an operator or a name, as operators are declared
function at_operator(toks: Tokens): Bool :=
  match head_token(toks)
    case TOp(_) =>
      true

    case TName(_) =>
      true

    case _ =>
      false
  end

procedure parse_operator(
  in  notation: Notation,
      params: List[Id],
  out op: Id,
  ref toks: Tokens
) :=
  if at_operator(toks) then
    assign op := format_token(head_token(toks))
    call   advance(ref toks)
  else
    raise expected("operator", toks)
  end

// C or C(name: T, rest: U), whose arguments are named fields, a constructor of the datatype after the constructors
// with the fields seen, whose errors are at the field
procedure parse_constr(
  in  notation: Notation,
      params: List[Id],
      datatype: Id,
      seen: List[Field],
  out constr: Constr,
  ref toks: Tokens
) :=
  local name: Id, placed: List[Pos * Field] := List(), before: List[Field] := List(), pos := head_pos(toks)
  call parse_name_or_op(out name, ref toks)
  call check_value_name(in name, pos)
  if at_kw(toks, "(") then
    call advance(ref toks)
    call parse_enclosed(in notation, params, parse_field, ")", out placed, ref toks)
  end
  for (at, field) in placed do
    if exists(before, lambda other => other.name == field.name) then
      raise ParseError("repeated field " ++ field.name ++ " of " ++ name, at)
    end
    if exists(seen, lambda other => conflicts(field, other)) then
      raise ParseError("field " ++ field.name ++ " of " ++ datatype ++ " has different types", at)
    end
    assign before := before ++ List(field)
  end
  assign constr := Constr(unqualified(name), before)

// a field of a constructor, name: T, at its name
procedure parse_field(
  in  notation: Notation,
      params: List[Id],
  out placed: Pos * Field,
  ref toks: Tokens
) :=
  local name: Id, typ: Type, pos := head_pos(toks)
  if second_token(toks) != TKw(":") then
    raise ParseError("fields of constructors have names, as in C(name: T)", pos)
  end
  call   parse_name(out name, ref toks)
  call   advance(ref toks)
  call   parse_type(in notation, params, out typ, ref toks)
  assign placed := (pos, Field(name, typ))

// data T[A] := case C(f: A) case D, with at least one constructor, as the cases of a match over T, whose fields the
// checker gives the accessors T.f and the updaters T.f:=
procedure parse_data(
  in  notation: Notation,
  out cmds: List[Cmd],
  ref toks: Tokens
) :=
  local name: Id, params: List[Id], constrs: List[At[Constr]]
  call advance(ref toks)
  call parse_name(out name, ref toks)
  call parse_params(in notation, out params, ref toks)
  call expect(in TKw(":="), ref toks)
  if not at_case(toks) then
    raise ParseError("each constructor follows case, as in data T := case C", head_pos(toks))
  end
  call   parse_constrs(in notation, params, name, List(), out constrs, ref toks)
  assign cmds := List(CData(unqualified(name), params, constrs))

// the constructors of the datatype after those with the fields seen, each after case, at its keyword case
procedure parse_constrs(
  in  notation: Notation,
      params: List[Id],
      datatype: Id,
      seen: List[Field],
  out constrs: List[At[Constr]],
  ref toks: Tokens
) :=
  if at_case(toks) then
    local constr: Constr, pos := head_pos(toks), span: Span, rest: List[At[Constr]]
    call   advance(ref toks)
    call   parse_constr(in notation, params, datatype, seen, out constr, ref toks)
    assign span := span_from(pos, toks)
    call   parse_constrs(in notation, params, datatype, seen ++ constr.fields, out rest, ref toks)
    assign constrs := List(AOk(pos, span, constr); rest)
  else
    assign constrs := List()
  end

function conflicts(field: Field, other: Field): Bool :=
  other.name == field.name and other.typ != field.typ

// a function, which is a signature without :=, or with := and a spec that the next command follows
procedure parse_function(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], xs: List[At[Var]], r: Type, pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name_or_op(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   parse_formals(in notation, params, out xs, ref toks)
  if at_kw(toks, "(") then
    raise ParseError("a function has one list of formals", head_pos(toks))
  end
  call expect(in TKw(":"), ref toks)
  call parse_type(in notation, params, out r, ref toks)
  if head_token(toks) == TKw(":=") then
    local spec: Spec
    call advance(ref toks)
    call parse_spec(in notation, params, false, out spec, ref toks)
    if spec != no_spec() and starts_command(toks) then
      assign cmd := CFunSig(unqualified(name), params, xs, r, spec)
    else
      local body: At[Expr]
      call   parse_expr_recovering(in notation, params, out body, ref toks)
      assign cmd := CFun(unqualified(name), params, xs, r, spec, body)
    end
  else
    assign cmd := CFunSig(unqualified(name), params, xs, r, no_spec())
  end

// the body of a function, or after an error the body as written up to the next command, from its start, as the handler sees
// the tokens, so that the function keeps its signature
procedure parse_expr_recovering(
  in  notation: Notation,
      params: List[Id],
  out expr: At[Expr],
  ref toks: Tokens
) :=
  local pos := head_pos(toks), skipped: Buffer[Str] := empty()
  try
    call parse_expr(in notation, params, out expr, ref toks)
  catch
    case ParseError(message, at) =>
      while not starts_command(toks) do
        assign skipped := skipped ++ List(format_token(head_token(toks)))
        call   advance(ref toks)
      end
      assign expr := AUnparsed(pos, span_from(pos, toks), joined(List(for t in skipped)), parse_diagnostic(ParseError(message, at)))
  end

procedure parse_pat_alias(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], xs: List[At[Var]], r: Type, pat: At[Pat], pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   parse_formals(in notation, params, out xs, ref toks)
  call   expect(in TKw(":"), ref toks)
  call   parse_type(in notation, params, out r, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_pattern(in notation, params, out pat, ref toks)
  assign cmd := CPatAlias(unqualified(name), params, xs, r, pat)

// a procedure, which is a signature without :=, or with := and a spec that the next command follows
procedure parse_procedure(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], ins: List[At[Var]], outs: List[At[Var]], refs: List[At[Var]], raised: List[Type], pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  call   parse_raises(in notation, params, out raised, ref toks)
  if head_token(toks) == TKw(":=") then
    local spec: Spec
    call advance(ref toks)
    call parse_spec(in notation, params, true, out spec, ref toks)
    if spec != no_spec() and starts_command(toks) then
      assign cmd := CProcSig(unqualified(name), params, ins, outs, refs, raised, spec)
    else
      local body: At[Stmt]
      call   parse_body(in notation, params, out body, ref toks)
      assign cmd := CProc(unqualified(name), params, ins, outs, refs, raised, spec, body)
    end
  else
    assign cmd := CProcSig(unqualified(name), params, ins, outs, refs, raised, no_spec())
  end

// raises T, … after the formals of a procedure or the modes of a procedure type, or nothing, where a comma followed by
// name : ends the types, since it starts the next formal around a procedure type
procedure parse_raises(
  in  notation: Notation,
      params: List[Id],
  out raised: List[Type],
  ref toks: Tokens
) :=
  assign raised := List()
  if at_kw(toks, "raises") then
    call advance(ref toks)
    call parse_separated(in notation, params, parse_type, at_raised_type, out raised, ref toks)
  end

// the spec after := of a function or, if of_proc, a procedure: the contract of a procedure, requires a, … and ensures b,
// each optional, then the lines example …, each at its keyword
procedure parse_spec(
  in  notation: Notation,
      params: List[Id],
      of_proc: Bool,
  out spec: Spec,
  ref toks: Tokens
) :=
  local found: Buffer[At[Example]] := empty(), pre: List[At[Expr]] := List(), post: Option[At[Expr]] := None
  if not of_proc and (at_kw(toks, "requires") or at_kw(toks, "ensures")) then
    raise ParseError("a function has no contract yet, its properties are lemmas", head_pos(toks))
  end
  if at_kw(toks, "requires") then
    call advance(ref toks)
    call parse_separated(in notation, params, parse_expr, at_comma, out pre, ref toks)
  end
  if at_kw(toks, "ensures") then
    local concl: At[Expr]
    call   advance(ref toks)
    call   parse_expr(in notation, params, out concl, ref toks)
    assign post := Some(concl)
  end
  while at_kw(toks, "example") do
    local x: At[Example], pos: Pos := head_pos(toks)
    call   advance(ref toks)
    call   parse_example(in notation, params, of_proc, pos, out x, ref toks)
    assign found := found ++ List(x)
  end
  assign spec := Spec(pre, post, List(for x in found))

// the example at pos after its keyword, as far as its expression goes, so that a body after the examples starts with
// what cannot continue it, or one that does not parse, whose test fails, which fails no declaration, up to the next example
// if one follows before the next command, else up to its error, where the body then starts
procedure parse_example(
  in  notation: Notation,
      params: List[Id],
      of_proc: Bool,
      pos: Pos,
  out x: At[Example],
  ref toks: Tokens
) :=
  local claim: Example, skipped: Buffer[Str] := empty(), next := has_next_example(toks), start := toks, invalid: Option[ParseError] := None
  try
    if of_proc then
      call parse_proc_example(in notation, params, pos, out claim, invalid, ref toks)
    else
      call parse_fun_example(in notation, params, out claim, ref toks)
    end
    match invalid
      case Some(e) =>
        assign x := AUnparsed(pos, span_from(pos, toks), joined(List(for (_, tok, _) in take(size(start) - size(toks), start) yield format_token(tok))), parse_diagnostic(e))
      case None =>
        assign x := AOk(pos, span_from(pos, toks), claim)
    end
  catch
    case ParseError(message, at) =>
      while not (at_kw(toks, "example") or starts_command(toks) or not next and not head_pos(toks) < at) do
        assign skipped := skipped ++ List(format_token(head_token(toks)))
        call   advance(ref toks)
      end
      assign x := AUnparsed(pos, span_from(pos, toks), joined(List(for t in skipped)), parse_diagnostic(ParseError(message, at)))
  end

// whether another example follows before the next command
function has_next_example(toks: Tokens): Bool :=
  match toks
    case List((_, TKw("example"), _); _) =>
      true

    case List((_, tok, _); more) if not is_command_token(tok) =>
      has_next_example(more)

    case _ =>
      false
  end

// the texts of tokens as the source usually spaces them, the text of a part that does not parse: without spaces inside
// brackets, before , and ., after ., and between a name and the ( of its arguments
function joined(parts: List[Str]): Str :=
  match parts
    case List(a, b; more) =>
      a ++ (if is_tight(a, b) then "" else " ") ++ joined(List(b; more))

    case List(a) =>
      a

    case List() =>
      ""
  end

function is_tight(a: Str, b: Str): Bool :=
  contains(b, List(")", "]", ",", ".")) or contains(a, List("(", "[", ".")) or b == "(" and is_name_text(a)

function is_name_text(a: Str): Bool :=
  a != "" and is_letter(at(0, a)) and not is_keyword(a)

// e or e raises p, after example
procedure parse_fun_example(
  in  notation: Notation,
      params: List[Id],
  out x: Example,
  ref toks: Tokens
) :=
  local expr: At[Expr]
  call parse_expr(in notation, params, out expr, ref toks)
  if at_kw(toks, "raises") then
    local pat: At[Pat]
    call   advance(ref toks)
    call   parse_pattern(in notation, params, out pat, ref toks)
    assign x := XRaises(expr, pat)
  else
    assign x := XHolds(expr)
  end

// p(in a, …, out b, …, ref c => d, …), or p(in a, …, out _, …, ref c, …) raises q, after example at pos
// where invalid is the error of an example that parses but does not fit its procedure, which ends where its parse ends
procedure parse_proc_example(
  in  notation: Notation,
      params: List[Id],
      pos: Pos,
  out x: Example,
      invalid: Option[ParseError],
  ref toks: Tokens
) :=
  local p: Id, ins: List[At[Expr]], outs: List[Option[At[Expr]] * Option[At[Expr]]], refs: List[Option[At[Expr]] * Option[At[Expr]]]
  assign invalid := None
  call   parse_name(out p, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_expr, parse_example_arg, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  if at_kw(toks, "raises") then
    local pat: At[Pat]
    call advance(ref toks)
    call parse_pattern(in notation, params, out pat, ref toks)
    match (raising_outs(outs), ref_befores(refs))
      case (Some(n), Some(before)) =>
        assign x := XCallRaises(unqualified(p), ins, n, before, pat)

      case _ =>
        assign x := XCallRaises(unqualified(p), ins, 0, List(), pat)
        assign invalid := Some(ParseError("an example that raises has _ for each out and each ref as before the call", pos))
    end
  else
    match (expected_outs(outs), before_after(refs))
      case (Some(values), Some(changes)) =>
        assign x := XCall(unqualified(p), ins, values, changes)

      case _ =>
        assign x := XCall(unqualified(p), ins, List(), List())
        assign invalid := Some(ParseError("an example of a procedure has the value of each out and each ref as before => after", pos))
    end
  end

// an out or ref of an example of a procedure: _ or a value, and the value after the call of a ref, after =>
procedure parse_example_arg(
  in  notation: Notation,
      params: List[Id],
  out arg: Option[At[Expr]] * Option[At[Expr]],
  ref toks: Tokens
) :=
  local value: Option[At[Expr]] := None, after: Option[At[Expr]] := None
  if at_kw(toks, "_") then
    call advance(ref toks)
  else
    local expr: At[Expr]
    call   parse_expr(in notation, params, out expr, ref toks)
    assign value := Some(expr)
  end
  if at_kw(toks, "=>") then
    local expr: At[Expr]
    call   advance(ref toks)
    call   parse_expr(in notation, params, out expr, ref toks)
    assign after := Some(expr)
  end
  assign arg := (value, after)

// the number of outs if each is _
function raising_outs(args: List[Option[At[Expr]] * Option[At[Expr]]]): Option[Int] :=
  if forall(args, lambda a => a == (None, None)) then Some(size(args)) else None

// the refs if each is given only as before the call
function ref_befores(args: List[Option[At[Expr]] * Option[At[Expr]]]): Option[List[At[Expr]]] :=
  match args
    case List() =>
      Some(List())

    case List((Some(before), None); more) =>
      map_option(ref_befores(more), lambda rest => List(before; rest))

    case _ =>
      None
  end

// the outs if each is a value
function expected_outs(args: List[Option[At[Expr]] * Option[At[Expr]]]): Option[List[At[Expr]]] :=
  match args
    case List() =>
      Some(List())

    case List((Some(value), None); more) =>
      map_option(expected_outs(more), lambda rest => List(value; rest))

    case _ =>
      None
  end

// the refs if each is given as before => after
function before_after(args: List[Option[At[Expr]] * Option[At[Expr]]]): Option[List[At[Expr] * At[Expr]]] :=
  match args
    case List() =>
      Some(List())

    case List((Some(before), Some(after)); more) =>
      map_option(before_after(more), lambda rest => List((before, after); rest))

    case _ =>
      None
  end

// lemma l[A](in x: A, …) := requires a, … ensures b, where requires is optional, or := correct p(…), whose head has the
// modes of a procedure without refs, where outs wait for proofs that give their witnesses
procedure parse_lemma(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], ins: List[At[Var]], outs: List[At[Var]], refs: List[At[Var]], claim: Claim, pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  if refs != List() then
    raise ParseError("a lemma has no ref formals, since it has no state", pos)
  end
  call expect(in TKw(":="), ref toks)
  call parse_claim(in notation, params, out claim, ref toks)
  if at_step(toks) then
    local proof: Proof
    call   parse_proof(in notation, params, out proof, ref toks)
    assign cmd := CLemma(unqualified(name), params, ins, outs, claim, Some(proof))
  else
    assign cmd := CLemma(unqualified(name), params, ins, outs, claim, None)
  end

// requires a, … ensures b, where requires is optional, or correct p(in a, …, out y, …)
procedure parse_claim(
  in  notation: Notation,
      params: List[Id],
  out claim: Claim,
  ref toks: Tokens
) :=
  if at_kw(toks, "correct") then
    local pos := head_pos(toks), stmt: Stmt
    call parse_call(in notation, params, out stmt, ref toks)
    match stmt
      case SCall(proc, ins, outs, List()) =>
        assign claim := ClaimCorrect(proc, ins, outs)
      case _ =>
        raise ParseError("a claim correct p(…) has no refs, since a lemma has none", pos)
    end
  else
    local assms: List[At[Expr]] := List(), concl: At[Expr]
    if at_kw(toks, "requires") then
      call advance(ref toks)
      call parse_separated(in notation, params, parse_expr, at_comma, out assms, ref toks)
    end
    call   expect(in TKw("ensures"), ref toks)
    call   parse_expr(in notation, params, out concl, ref toks)
    assign claim := ClaimHolds(assms, concl)
  end

// whether the next token starts a step or a split of a proof
function at_step(toks: Tokens): Bool :=
  exists(List(
    "local",
    "call",
    "assert",
    "assign",
    "invariant",
    "induction",
    "match",
    "if"), lambda kw => at_kw(toks, kw))

// the steps of a proof, the locals first, then the calls, cuts, and assignments, which are parsed as statements, and at
// most one split, which ends the proof, see ideas/prove.md, section 4, where a proof ends at a token that starts no step
procedure parse_proof(
  in  notation: Notation,
      params: List[Id],
  out proof: Proof,
  ref toks: Tokens
) :=
  local steps: Buffer[At[Step]] := empty(), split: Option[At[Split]] := None
  while at_kw(toks, "local") do
    local decls: List[At[Var] * List[At[Stmt]]], at := head_pos(toks)
    call   advance(ref toks)
    call   parse_separated(in notation, params, parse_local, at_comma, out decls, ref toks)
    assign steps := steps ++ List(for (x, inits) in decls yield AOk(at, span_from(at, toks), StepLocal(x, initial_value(inits))))
  end
  while exists(List("call", "assert", "assign", "invariant"), lambda kw => at_kw(toks, kw)) do
    if at_kw(toks, "invariant") then
      local cond: At[Expr], at := head_pos(toks)
      call   advance(ref toks)
      call   parse_expr(in notation, params, out cond, ref toks)
      assign steps := steps ++ List(AOk(at, span_from(at, toks), StepInvariant(cond)))
    else
      local stmt: At[Stmt], step: Step
      call   parse_stmt(in notation, params, out stmt, ref toks)
      call   step_of(in stmt, out step)
      assign steps := steps ++ List(AOk(stmt.pos, stmt.span, step))
    end
  end
  if exists(List("induction", "match", "if"), lambda kw => at_kw(toks, kw)) then
    local s: At[Split]
    call   parse_split(in notation, params, out s, ref toks)
    assign split := Some(s)
  end
  if at_step(toks) then
    raise ParseError(if split == None then
      "the locals of a proof come before its other steps"
    else
      "a split ends its proof, so no step follows it", head_pos(toks))
  end
  assign proof := Proof(List(for step in steps), split)

// the value of a local from the assignment that parse_local gives for it
function initial_value(inits: List[At[Stmt]]): Option[At[Expr]] :=
  match inits
    case List(AOk(_, _, SAssign(List((_, e))))) =>
      Some(e)
    case _ =>
      None
  end

// a statement that is a step of a proof, a call without refs, a cut, or an assignment
procedure step_of(in stmt: At[Stmt], out step: Step) raises ParseError :=
  match stmt.that
    case SCall(name, ins, outs, List()) =>
      assign step := StepCall(name, ins, outs)

    case SAssert(cond) =>
      assign step := StepAssert(cond)

    case SAssign(upd) =>
      assign step := StepAssign(upd)

    case SCall(_, _, _, _) =>
      raise ParseError("a call of a lemma has no refs", stmt.pos)

    case _ =>
      raise ParseError("assert raises is no step of a proof", stmt.pos)
  end

// induction x, match e, or if c, with their cases, each a proof
procedure parse_split(
  in  notation: Notation,
      params: List[Id],
  out split: At[Split],
  ref toks: Tokens
) :=
  local pos := head_pos(toks)
  match head_token(toks)
    case TKw("induction") =>
      local x: Id, cases: List[At[Branch[Proof]]]
      call   advance(ref toks)
      call   parse_name(out x, ref toks)
      call   parse_cases(in notation, params, parse_proof, "induction", pos, out cases, ref toks)
      assign split := AOk(pos, span_from(pos, toks), SplitInduction(Var(Name(None, x), THole), cases))

    case TKw("match") =>
      local expr: At[Expr], cases: List[At[Branch[Proof]]]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   parse_cases(in notation, params, parse_proof, "match", pos, out cases, ref toks)
      assign split := AOk(pos, span_from(pos, toks), SplitMatch(expr, cases))

    case _ =>
      local cond: At[Expr], left: Proof, right: Option[Proof] := None
      call advance(ref toks)
      call parse_expr(in notation, params, out cond, ref toks)
      call expect(in TKw("then"), ref toks)
      call parse_proof(in notation, params, out left, ref toks)
      if at_kw(toks, "else") then
        local r: Proof
        call   advance(ref toks)
        call   parse_proof(in notation, params, out r, ref toks)
        assign right := Some(r)
      end
      call   expect_end(in "if", pos, ref toks)
      assign split := AOk(pos, span_from(pos, toks), SplitIf(cond, left, right))
  end

// the commands of one declaration
procedure parse_command(
  in  notation: Notation,
  out cmds: List[Cmd],
  ref toks: Tokens
) :=
  match head_token(toks)
    case TKw(kw) if contains(kw, List("prefix", "postfix", "infix")) =>
      local cmd: Cmd, pos: Pos := head_pos(toks)
      call   parse_notation(in notation, out cmd, ref toks)
      call   check_duplicates(in notation, List(cmd), pos)
      assign cmds := List(cmd)

    case TKw("type") =>
      local name: Id, params: List[Id]
      call advance(ref toks)
      call parse_name(out name, ref toks)
      call parse_params(in notation, out params, ref toks)
      if head_token(toks) == TKw(":=") then
        local typ: Type
        call   advance(ref toks)
        call   parse_type(in notation, params, out typ, ref toks)
        assign cmds := List(CSort(unqualified(name), params, typ))
      else
        assign cmds := List(CAbstract(unqualified(name), params))
      end

    case TKw("data") =>
      call parse_data(in notation, out cmds, ref toks)

    case TKw("function") =>
      local cmd: Cmd
      call   parse_function(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("procedure") =>
      local cmd: Cmd
      call   parse_procedure(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("pattern") =>
      local cmd: Cmd
      call   parse_pat_alias(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("lemma") =>
      local cmd: Cmd
      call   parse_lemma(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("test") =>
      local name: Id, body: At[Stmt], xs: List[At[Var]]
      call   advance(ref toks)
      call   parse_name(out name, ref toks)
      call   parse_formals(in notation, List(), out xs, ref toks)
      call   expect(in TKw(":="), ref toks)
      call   parse_body(in notation, List(), out body, ref toks)
      assign cmds := List(CTest(unqualified(name), xs, body))

    case _ =>
      raise expected("declaration", toks)
  end

// the module of id of mods, the modules loaded so far
function loaded_mod(id: Id, mods: List[Mod]): Option[Mod] :=
  find(mods, lambda d => d.name == id)

// the notation with those that the modules members of mods export, which must not declare an operator differently
procedure import_notation(
  in  members: List[Id],
      mods: List[Mod],
      pos: Pos,
  ref notation: Notation
) :=
  for m in members do
    match loaded_mod(m, mods)
      case Some(d) =>
        call   check_imported(in notation, exported_notation(d), pos)
        assign notation := notation ++ exported_notation(d)

      case None =>
        skip
    end
  end

// the package id of import id, as parse_import gives it, loaded into source unless it is loaded already, where loading
// are the packages being loaded, of which an import is cyclic, root is the root of the project, and dir the directory of
// the importing file from the root, or None for the library, which is imported only implicitly
procedure import_package(
  in  id: Id,
      root: Str,
      dir: Option[Str],
      loading: List[Id],
      pos: Pos,
  ref source: Source
) :=
  local found: Bool
  if dir == Some(id) then
    raise ParseError("import of the own package " ++ id ++ ", which the files of its directory see without importing it", pos)
  end
  if contains(id, loading) then
    raise ParseError("cyclic import of the package " ++ id, pos)
  end
  if dir == None then
    raise ParseError("the library imports nothing", pos)
  end
  if id == "prelude" then
    raise ParseError(library_import(), pos)
  end
  call os_is_dir(in os_join(root, id), out found)
  if not found then
    local in_library: Bool
    call is_library_file(in id, out in_library)
    raise ParseError(if in_library then library_import() else "unknown package " ++ id, pos)
  end
  call load_package(in root, Some(id), None, loading, ref source)
  if package_members(id, source.packages) == List() then
    raise ParseError("the package " ++ id ++ " has no members, .u files", pos)
  end

// whether name is the name of a file name.u of the library, which an import of name hints at
procedure is_library_file(in name: Str, out found: Bool) :=
  local text: Str
  try
    call   os_library(in name, out text)
    assign found := true
  catch
    case OsError(_) =>
      assign found := false
  end

function library_import(): Str :=
  "import of the library, which every module sees without importing it"

function package_members(id: Id, packages: List[Package]): List[Id] :=
  match find(packages, lambda p => p.id == id)
    case Some(p) =>
      p.members
    case None =>
      List()
  end

// the module of name in dir, both from the root
function module_id(dir: Str, name: Str): Id :=
  if dir == "" then name else dir ++ "/" ++ name

// the package of the directory dir from the root, None for the library
function package_id(dir: Option[Str]): Id :=
  value_or(dir, "prelude")

// the members of the package of the directory dir from root, with their texts: the .u files of the directory other than
// project.u, by their names, or those of the directory of the library for None, where main, the text of the main file,
// replaces that of its file and comes last
procedure package_files(
  in  root: Str,
      dir: Option[Str],
      main: Option[Id * Str],
  out files: List[Id * Str]
) :=
  local found: Buffer[Id * Str] := empty(), main_id := ""
  match main
    case Some((id, _)) =>
      assign main_id := id
    case None =>
      skip
  end
  match dir
    case Some(d) =>
      local entries: List[Str * Bool], text: Str
      call os_list(in if d == "" then root else os_join(root, d), out entries)
      for (file, is_dir) in entries do
        if not is_dir and is_source(file) and file != "project.u" and module_id(d, module_name(file)) != main_id then
          call   os_read_utf8(in os_join(os_join(root, d), file), out text)
          assign found := found ++ List((module_id(d, module_name(file)), text))
        end
      end

    case None =>
      local text: Str, lib: Str, entries: List[Str * Bool]
      call os_library_dir(out lib)
      call os_list(in lib, out entries)
      for (file, is_dir) in entries do
        if not is_dir and is_source(file) and library_module(module_name(file)) != main_id then
          call   library_text(in library_module(module_name(file)), Pos(1, 1), out text)
          assign found := found ++ List((library_module(module_name(file)), text))
        end
      end
  end
  for m in main do
    assign found := found ++ List(m)
  end
  assign files := List(for f in found)

// the package of the directory dir from root, None for the library, loaded into source unless it is loaded or being
// loaded already, after the packages that its members import: its members are lexed, the notations of
// their export sections collected, and each parsed with those of the others, where main is the text of the main file, with
// which all members keep their tests, while without it, for imports, they lose them
procedure load_package(
  in  root: Str,
      dir: Option[Str],
      main: Option[Id * Str],
      loading: List[Id],
  ref source: Source
) :=
  if not exists(source.packages, lambda p => p.id == package_id(dir)) and not contains(package_id(dir), loading) then
    local files: List[Id * Str]
    call package_files(in root, dir, main, out files)
    call load_members(in root, dir, files, main, loading, ref source)
  end

// the package of the directory dir from root of the members files, each its module and text, as load_package loads it
procedure load_members(
  in  root: Str,
      dir: Option[Str],
      files: List[Id * Str],
      main: Option[Id * Str],
      loading: List[Id],
  ref source: Source
) :=
  local id := package_id(dir), lexed: List[Id * Tokens * List[Comment]], notations: List[Id * Notation], own: Mod, mods: Buffer[Mod] := empty()
  call lex_members(in files, main, out lexed, notations)
  for (m, toks, comments) in lexed do
    call   parse_member(in m, toks, comments, others_notation(m, notations), root, dir, is_main(m, main), main != None, List(id; loading), out own, ref source)
    assign mods := mods ++ List(own)
  end
  assign source := source with mods := source.mods ++ List(for d in mods), packages := source.packages ++ List(Package(id, firsts(files)))

procedure parse_texts(
  in  root: Str,
      dir: Str,
      members: List[Id * Str],
      main: Id * Str,
  out source: Source
) raises ParseError, OsError :=
  match main
    case (id, text) =>
      assign source := Source(List(), List(), id)
      call   load_members(in root, Some(dir), List(for (m, t) in members if m != id yield (m, t)) ++ List(main), Some(main), List(), ref source)
  end

procedure load_after_library(
  in  dir: Str,
      members: List[Id * Str],
  ref source: Source
) raises ParseError, OsError :=
  local before := source.mods
  call   load_members(in "", Some(dir), members, None, List(), ref source)
  assign source := source with mods := List(for d in source.mods if is_library_module(d.name)) ++ List(for d in drop(size(before), source.mods) if not is_library_module(d.name)) ++ List(for d in before if not is_library_module(d.name))

function is_main(id: Id, main: Option[Id * Str]): Bool :=
  match main
    case Some((m, _)) =>
      m == id
    case None =>
      false
  end

// the notation that the other members of a package than m export
function others_notation(m: Id, notations: List[Id * Notation]): Notation :=
  foldl(notations, empty_notation(), lambda notation, (other, ops) => if other == m then notation else notation ++ ops)

// the tokens of the members files, with the notations of their export sections
procedure lex_members(
  in  files: List[Id * Str],
      main: Option[Id * Str],
  out lexed: List[Id * Tokens * List[Comment]],
      notations: List[Id * Notation]
) :=
  local toks: Tokens, comments: List[Comment], ops: Notation
  assign lexed := List(), notations := List()
  for (m, text) in files do
    call   lex_member(in m, text, is_main(m, main), out toks, comments)
    call   exported_ops(in toks, out ops)
    assign lexed := lexed ++ List((m, toks, comments)), notations := notations ++ List((m, ops))
  end

// the tokens and comments of module id of text, where an error of a module other than the main one is located in it
procedure lex_member(
  in  id: Id,
      text: Str,
      main: Bool,
  out toks: Tokens,
      comments: List[Comment]
) :=
  try
    call lex_all(in text, out toks, comments)
  catch
    case LexError(message, pos) if main =>
      raise ParseError(message, pos)
    case LexError(message, pos) =>
      raise ImportError(id, message, pos)
  end

// the notation of the commands of the export section of the tokens of a module, read before the module is parsed, of the
// notation commands, whose keywords occur only at commands, which parse without notation, where those that do not parse
// are left to the parse of the module
procedure exported_ops(in toks: Tokens, out notation: Notation) :=
  local rest := toks, inside := false
  assign notation := empty_notation()
  while head_token(rest) != TEnd do
    match head_token(rest)
      case TKw("export") =>
        assign inside := true
        call   advance(ref rest)

      case TKw(kw) if contains(kw, List("builtin", "implementation")) =>
        assign rest := List()

      case TKw(kw) if inside and contains(kw, List("prefix", "postfix", "infix")) =>
        try
          local cmd: Cmd
          call   parse_notation(in empty_notation(), out cmd, ref rest)
          assign notation := with_notation(notation, List(cmd))
        catch
          case ParseError(_, _) =>
            call advance(ref rest)
        end

      case _ =>
        call advance(ref rest)
    end
  end

// the module id of a package, of the tokens toks and the comments, parsed with the notation that the other members export, where main
// tells whether it is the main file, whose errors are its own, and tested whether it keeps its tests, as the members of
// the package of the main file do
procedure parse_member(
  in  id: Id,
      toks: Tokens,
      comments: List[Comment],
      notation: Notation,
      root: Str,
      dir: Option[Str],
      main: Bool,
      tested: Bool,
      loading: List[Id],
  out own: Mod,
  ref source: Source
) :=
  local rest := toks
  try
    if not is_library_module(id) then
      call load_package(in root, None, None, loading, ref source)
    end
    call parse_mod(in id, comments, implicit_imports(id, source.packages), notation, root, dir, loading, out own, ref source, rest)
  catch
    case ParseError(message, pos) if not main =>
      raise ImportError(id, message, pos)
    case ParseErrors(List(ParseError(message, pos); _)) if not main =>
      raise ImportError(id, message, pos)
  end
  if not tested then
    assign own := without_tests_of(own)
  end

procedure import_all(
  in  names: List[Id],
      root: Str,
      loading: List[Id],
  ref source: Source
) :=
  if names != List() then
    call load_package(in root, None, None, loading, ref source)
  end

procedure import_notations(
  in  names: List[Id],
      mods: List[Mod],
  ref notation: Notation
) :=
  call import_notation(in names, mods, Pos(1, 1), ref notation)

data Section :=
  case Opening
  case InExport
  case InBuiltin
  case InImplementation
  case NoSections

// the module name of the tokens toks and the comments, which starts with the notation of its implicit imports and the notation of its
// package, that its siblings export, after the packages that its imports load into source, from the directory dir of root
// as import_package reads them, where notations apply to the commands after them, imports come first, and each command
// has the position where it starts; after an error the parser resumes at the next command, from the start of this one, as
// the handler sees the tokens, where the command stays as a part that does not parse, so that the module holds its errors
procedure parse_mod(
  in  name: Id,
      comments: List[Comment],
      implicit: List[Id],
      package: Notation,
      root: Str,
      dir: Option[Str],
      loading: List[Id],
  out own: Mod,
  ref source: Source,
      toks: Tokens
) :=
  local imports: List[Id] := List(), notation := empty_notation(), plain: List[At[Cmd]] := List(), exported: List[At[Cmd]] := List(), builtins: List[At[Cmd]] := List(), implemented: List[At[Cmd]] := List(), more: List[Cmd], section := Opening, pos: Pos, imported: Id, placed: List[At[Cmd]], text: Str, names: List[Id] := List()
  call   import_all(in implicit, root, loading, ref source)
  call   import_notations(in implicit, source.mods, ref notation)
  assign notation := notation ++ package
  while head_token(toks) != TEnd do
    assign pos := head_pos(toks), more := List(), placed := List()
    try
      call parse_section_or_command(in root, dir, loading, pos, out more, ref notation, section, imports, source, toks)
    catch
      case ParseError(message, at) =>
        match head_token(toks)
          case TKw(kw) if section_named(kw) != None =>
            call   advance(ref toks)
            assign section := value_or(section_named(kw), section), text := kw, names := List()

          case _ =>
            assign names := declared_names(toks)
            call   skip_command(out text, ref toks)
        end
        assign placed := List(
          AUnparsed(pos, span_from(pos, toks), text, declaring(parse_diagnostic(ParseError(message, at)), names)))
    end
    match more
      case List(c; rest) =>
        assign placed := List(
          AOk(pos, span_from(pos, toks), c); List(for d in rest yield AOk(pos, span_from(pos, toks), d)))

      case _ =>
        skip
    end
    match section
      case InExport =>
        assign exported := reverse_onto(placed, exported)

      case InBuiltin =>
        assign builtins := reverse_onto(placed, builtins)

      case InImplementation =>
        assign implemented := reverse_onto(placed, implemented)

      case _ =>
        assign plain := reverse_onto(placed, plain)
    end
  end
  assign implemented := reverse(implemented) ++ reverse(plain)
  assign own := Mod(name, imports, reverse(exported), reverse(builtins), implemented, comments)

// a section keyword, an import, or the commands of a declaration at pos, which more gives
procedure parse_section_or_command(
  in  root: Str,
      dir: Option[Str],
      loading: List[Id],
      pos: Pos,
  out more: List[Cmd],
  ref notation: Notation,
      section: Section,
      imports: List[Id],
      source: Source,
      toks: Tokens
) :=
  local imported: Id
  assign more := List()
  match head_token(toks)
    case TKw("export") =>
      if section == InExport or section == InBuiltin or section == InImplementation then
        raise ParseError("a module has one export section", pos)
      else
        if section != Opening then
          raise ParseError("export comes first, after the imports", pos)
        end
      end
      call   advance(ref toks)
      assign section := InExport

    case TKw("builtin") =>
      if section != InExport then
        raise ParseError("builtin follows export", pos)
      end
      call   advance(ref toks)
      assign section := InBuiltin

    case TKw("implementation") =>
      if section != InExport and section != InBuiltin then
        raise ParseError("implementation follows export", pos)
      end
      call   advance(ref toks)
      assign section := InImplementation

    case TKw("import") if section == NoSections =>
      raise ParseError("imports come first", pos)

    case TKw("import") if section != Opening =>
      raise ParseError("imports come before export", pos)

    case TKw("import") =>
      call   advance(ref toks)
      call   parse_import(out imported, ref toks)
      call   import_package(in imported, root, dir, loading, pos, ref source)
      call   import_notation(in package_members(imported, source.packages), source.mods, pos, ref notation)
      assign imports := imports ++ List(imported)

    case _ =>
      call   parse_command(in notation, out more, ref toks)
      call   enter_section(in more, pos, ref section)
      assign notation := with_notation(notation, more)
  end

// the section that the keyword kw opens, which a keyword in the wrong place opens too, so that its commands are not errors
function section_named(kw: Str): Option[Section] :=
  if kw == "export" then
    Some(InExport)
  else if kw == "builtin" then
    Some(InBuiltin)
  else if kw == "implementation" then
    Some(InImplementation)
  else
    None

// the tokens from the next keyword that starts a command after the first token, and those before, joined by
// spaces
procedure skip_command(out text: Str, ref toks: Tokens) :=
  local skipped: Buffer[Str] := empty()
  assign skipped := skipped ++ List(format_token(head_token(toks)))
  call   advance(ref toks)
  while not starts_command(toks) do
    assign skipped := skipped ++ List(format_token(head_token(toks)))
    call   advance(ref toks)
  end
  assign text := joined(List(for t in skipped))

function starts_command(toks: Tokens): Bool :=
  head_token(toks) == TEnd or at_command(toks)

// whether the next token is a keyword that starts a command, which never occurs inside one
function at_command(toks: Tokens): Bool :=
  match head_token(toks)
    case TKw(kw) =>
      is_command_kw(kw)
    case _ =>
      false
  end

function is_command_kw(kw: Str): Bool :=
  contains(kw, List(
    "function",
    "procedure",
    "data",
    "type",
    "test",
    "lemma",
    "pattern",
    "prefix",
    "postfix",
    "infix",
    "export",
    "builtin",
    "implementation",
    "import"))

// the section after the commands of one declaration, which must belong to the section
procedure enter_section(in cmds: List[Cmd], pos: Pos, ref section: Section) :=
  match (cmds, section)
    case (List(CFunSig(_, _, _, _, _); _), InBuiltin) =>
      skip

    case (List(CProcSig(_, _, _, _, _, _, _); _), InBuiltin) =>
      skip

    case (List(CAbstract(_, _); _), InBuiltin) =>
      skip

    case (_, InBuiltin) =>
      raise ParseError("builtin sections have signatures and types without a definition only", pos)

    case (List(CNotation(_, _, _); _), InImplementation) =>
      raise ParseError("notations belong to the export section", pos)

    case (List(CFunSig(_, _, _, _, spec); _), s) if s != InExport and spec != no_spec() =>
      raise ParseError("signatures belong to the export section; the last example takes what continues its expression, so a body after examples cannot start with (, -, an operator, ., or with, which can be bound by a let, as in let r := -x in r", pos)

    case (List(CFunSig(_, _, _, _, _); _), s) if s != InExport =>
      raise ParseError("signatures belong to the export section", pos)

    case (List(CProcSig(_, _, _, _, _, _, _); _), s) if s != InExport =>
      raise ParseError("signatures belong to the export section", pos)

    case (List(CAbstract(_, _); _), s) if s != InExport =>
      raise ParseError("types without a definition belong to the export or builtin section", pos)

    case (List(CFun(_, _, _, _, _, _); _), InExport) =>
      raise ParseError("definitions belong to the implementation section", pos)

    case (List(CProc(_, _, _, _, _, _, _, _); _), InExport) =>
      raise ParseError("definitions belong to the implementation section", pos)

    case (List(CTest(_, _, _); _), InExport) =>
      raise ParseError("tests belong to the implementation section", pos)

    case (List(CLemma(_, _, _, _, _, _); _), InExport) =>
      raise ParseError("lemmas belong to the implementation section", pos)

    case (_, Opening) =>
      assign section := NoSections

    case _ =>
      skip
  end

procedure library_text(in id: Id, pos: Pos, out text: Str) :=
  try
    call os_library(in library_file(id), out text)
  catch
    case OsError(_) =>
      raise ParseError("unknown module " ++ id, pos)
  end

procedure lex_text(in text: Str, out toks: Tokens, comments: List[Comment]) :=
  try
    call lex_all(in text, out toks, comments)
  catch
    case LexError(message, pos) =>
      raise ParseError(message, pos)
  end

procedure parse_file_text(
  in  path: Str,
      text: Str,
  out source: Source
) raises ParseError, OsError :=
  local place: Place
  call   place_of(in path, out place)
  assign source := Source(List(), List(), place.id)
  call   load_package(in place.root, place.dir, Some((place.id, text)), List(), ref source)

procedure parse_file(
  in  path: Str,
  out source: Source
) raises ParseError, OsError :=
  local text: Str
  call os_read_utf8(in path, out text)
  call parse_file_text(in path, text, out source)

procedure parse_text(in text: Str, out own: Mod) raises ParseError, OsError :=
  local source: Source
  call   parse_text_recovering(in text, out source)
  call   require_parsed(in source)
  assign own := source.mods.head

procedure parse_text_recovering(
  in  text: Str,
  out source: Source
) raises ParseError, OsError :=
  local toks: Tokens, comments: List[Comment], own: Mod, loaded := Source(List(), List(), "main")
  call   lex_text(in text, out toks, comments)
  call   parse_mod(in "main", comments, List(), empty_notation(), "", None, List(), out own, ref loaded, toks)
  assign source := Source(List(own), List(), "main")

// the file of a module: its id, the root of its project, and its directory from the root, None for the library
data Place :=
  case Place(id: Id, root: Str, dir: Option[Str])

// the place of the file at path, whose root is the nearest directory above it with project.u, else its own directory,
// where a directory with prelude.u is the library, whose modules are known by their names
procedure place_of(in path: Str, out place: Place) :=
  local cwd: Str, file: Str, home: Str, library: Bool, name := module_name(path)
  call   os_cwd(out cwd)
  assign file := normal_path(if starts_with(path, "/") then path else os_join(cwd, path))
  assign home := os_dirname(file)
  call   has_file(in home, "prelude.u", out library)
  if library then
    assign place := Place(library_module(name), home, None)
  else
    local root: Str
    call   project_root(in home, out root)
    assign place := Place(module_id(relative_path(root, home), name), root, Some(relative_path(root, home)))
  end

procedure project_root(in dir: Str, out root: Str) raises OsError :=
  local found := false, here := dir
  assign root := dir
  while not found do
    call has_file(in here, "project.u", out found)
    if found then
      assign root := here
    else
      if here == "/" then
        assign found := true
      else
        assign here := os_dirname(here)
      end
    end
  end

procedure has_file(in dir: Str, name: Str, out found: Bool) :=
  try
    local entries: List[Str * Bool]
    call   os_list(in dir, out entries)
    assign found := contains((name, false), entries)
  catch
    case OsError(_) =>
      assign found := false
  end

function normal_path(path: Str): Str :=
  "/" ++ join("/", reverse(foldl(split(path, '/'), List(), normal_step)))

function normal_step(parts: List[Str], part: Str): List[Str] :=
  match (part, parts)
    case ("", _) =>
      parts

    case (".", _) =>
      parts

    case ("..", List(_; rest)) =>
      rest

    case ("..", List()) =>
      List()

    case _ =>
      List(part; parts)
  end

// dir from root, which is root or above it, both normal, as "" for root itself
function relative_path(root: Str, dir: Str): Str :=
  if dir == root then
    ""
  else if root == "/" then
    slice(dir, 1, size(dir))
  else
    slice(dir, size(root) + 1, size(dir))

// the name of the module of the file at path, without its directory and .u
function module_name(path: Str): Str :=
  let f := os_basename(path) in
  if is_source(f) then slice(f, 0, size(f) - 2) else f

function is_source(path: Str): Bool :=
  let f := os_basename(path) in
  size(f) > 2 and ends_with(f, ".u")

// the parser, tested by the trees of single constructs, parsed with their own notation from the empty context, which reads no
// files
function test_notation(): Str :=
  "infix right 8 ++\ninfix 6 ==\ninfix left 9 + -\ninfix left 10 *\nprefix 5 not\nprefix 11 -\n"

// the body of a function of e, with every position Pos(0, 0)
procedure parsed(in e: Str, out body: At[Expr]) :=
  call   parsed_placed(in e, out body)
  assign body := strip_expr(body)

// the body of a function of e, whose text starts at column 3 of line 8
procedure parsed_placed(in e: Str, out body: At[Expr]) :=
  local d: Mod
  call   parse_text(in test_notation() ++ "function f(): Int :=\n  " ++ e, out d)
  assign body := nowhere(ELit(LUnit))
  match reverse(commands_of(placed_of(d)))
    case List(CFun(_, _, _, _, _, b); _) =>
      assign body := b
    case _ =>
      skip
  end

// the span on line from column start to column stop
function span_in(line: Int, start: Int, stop: Int): Span :=
  example span_in(8, 3, 7) == Span(Pos(8, 3), Pos(8, 7))
  Span(Pos(line, start), Pos(line, stop))

// the uses of names, also of operators, and accesses of fields are at the token that names them, and a call at its name,
// while the span of each goes from its first token to the end of its last
test parsed_positions() :=
  local expr: At[Expr]
  call parsed_placed(in "f(a) + b.g", out expr)
  assert expr == AOk(Pos(8, 8), span_in(8, 3, 13), ECall(Pos(8, 8), span_in(8, 8, 9), unqualified("+"), THole, List(
    AOk(Pos(8, 3), span_in(8, 3, 7), EApp(AOk(Pos(8, 3), span_in(8, 3, 4), EName(unqualified("f"), THole)), List(AOk(Pos(8, 5), span_in(8, 5, 6), EName(unqualified("a"), THole))))),
    AOk(Pos(8, 11), span_in(8, 10, 13), EField(AOk(Pos(8, 10), span_in(8, 10, 11), EName(unqualified("b"), THole)), "g")))))

// a command and a statement span from their first token to the end of their last, also of the end of a block
test parsed_spans() :=
  local d: Mod
  call parse_text(in "procedure p(in x: Int, out y: Int) :=\n  if x then\n    assign y := x\n  else\n    assign y := 0\n  end\n\nfunction f(x: Int): Int :=\n  g(x).h", out d)
  match placed_of(d)
    case List(
      AOk(_, proc_span, CProc(_, _, _, _, _, _, _, AOk(_, block_span, SBlock(_, List(stmt))))),
      AOk(_, fun_span, CFun(_, _, _, _, _, body))) =>
      assert proc_span == Span(Pos(1, 1), Pos(6, 6)) and block_span == Span(Pos(2, 3), Pos(6, 6))
      assert stmt.span == Span(Pos(2, 3), Pos(6, 6))
      assert fun_span == Span(Pos(8, 1), Pos(9, 9)) and body.span == Span(Pos(9, 3), Pos(9, 9))

    case _ =>
      assert false
  end

// a comma followed by name : ends the types that a procedure type raises, since it starts the next formal
test parsed_raises() :=
  local d: Mod, found: List[List[Type] * List[Type]] := List(), e := TSort(unqualified("E"), List()), f := TSort(unqualified("F"), List()), int := TSort(unqualified("Int"), List())
  call parse_text(in "procedure p(in q: (in Int) raises E, F, n: Int) raises F := skip\nprocedure r() raises E, F := skip\n", out d)
  for c in commands_of(d.implemented) do
    match c
      case CProc(_, _, ins, _, _, raised, _, _) =>
        assign found := found ++ List((List(for x in ins yield x.that.typ), raised))
      case _ =>
        skip
    end
  end
  assert found == List(
    (List(TProc(List(int), List(), List(), TTuple(List(e, f))), int), List(f)),
    (List(), List(e, f)))

// the doc of a declaration is the run of comments right above it, without a blank line between
test parsed_docs() :=
  local d: Mod, text := "// the answer\n// in two lines\nfunction f(): Int := 42\n\n\n\n"
  call parse_text(in text ++ "// detached\n\nfunction g(): Int := 1 // after\nfunction h(): Int := 2\n", out d)
  assert List(for c in d.implemented yield doc_of(d.comments, c.span)) == List(Some("the answer\nin two lines"), None, None)
  assert List(for c in d.implemented yield c.pos) == List(Pos(3, 1), Pos(9, 1), Pos(10, 1))
  assert List(for c in d.comments yield c.text) == List("the answer", "in two lines", "detached", "after")

// comments stand anywhere, also where no part could hold them: after code, before end, else, and catch, on a local line,
// between arguments, elements, and cases, and above a blank line, and the parse is the same without them
test parsed_comments() :=
  local d: Mod, plain: Mod, text := "procedure p(in x: Int) := // head\n  local y := f(x, // arg\n  2) // local\n  if x then\n    skip\n    // before else\n  else\n    // after else\n\n    skip\n  end\n  try\n    skip\n    // before catch\n  catch\n    case _ =>\n      skip\n  // before end\n  end\n"
  call parse_text(in text, out d)
  call parse_text(in "procedure p(in x: Int) :=\n  local y := f(x, 2)\n  if x then\n    skip\n  else\n    skip\n  end\n  try\n    skip\n  catch\n    case _ =>\n      skip\n  end\n", out plain)
  assert List(for c in commands_of(d.implemented) yield strip_cmd(c)) == List(for c in commands_of(plain.implemented) yield strip_cmd(c))
  assert List(for c in d.comments yield (c.pos.line, c.own_line, c.blank_after)) == List(
    (1, false, false),
    (2, false, false),
    (3, false, false),
    (6, true, false),
    (8, true, true),
    (14, true, false),
    (18, true, false))

test parsed_operators() :=
  local expr: At[Expr], a := expr_var("a"), b := expr_var("b"), c := expr_var("c")
  call parsed(in "a - b - c", out expr)
  assert expr == expr_app("-", List(expr_app("-", List(a, b)), c))
  call parsed(in "a ++ b ++ c", out expr)
  assert expr == expr_app("++", List(a, expr_app("++", List(b, c))))
  call parsed(in "a + b * c - a", out expr)
  assert expr == expr_app("-", List(expr_app("+", List(a, expr_app("*", List(b, c)))), a))
  call parsed(in "not a == b", out expr)
  assert expr == expr_app("not", List(expr_app("==", List(a, b))))
  call parsed(in "-a * b", out expr)
  assert expr == expr_app("*", List(expr_app("-", List(a)), b))
  call parsed(in "a - -1", out expr)
  assert expr == expr_app("-", List(a, expr_int(-1)))
  call parsed(in "a - -0x10", out expr)
  assert expr == expr_app("-", List(a, nowhere(ELit(LHex(-16)))))
  call parsed(in "- -a", out expr)
  assert expr == expr_app("-", List(expr_app("-", List(a))))
  call parsed(in "-a.f", out expr)
  assert expr == expr_app("-", List(nowhere(EField(a, "f"))))
  call parsed(in "a with f := 1, g := b.f", out expr)
  assert expr == nowhere(EUpdate(nowhere(EUpdate(a, "f", expr_int(1))), "g", nowhere(EField(b, "f"))))

test parsed_forms() :=
  local expr: At[Expr], a := expr_var("a"), b := expr_var("b"), c := expr_var("c"), tail := nowhere(PApp(unqualified("Cons"), List(nowhere(PLit(LInt(-1))), nowhere(PWild))))
  call parsed(in "List(a, b; c)", out expr)
  assert expr == nowhere(EForm(FList, List(YVal(a), YVal(b)), Some(c)))
  call parsed(in "match a case List(x, -1; _) => x end", out expr)
  assert expr == nowhere(EMatch(a, List(
    nowhere(Branch(nowhere(PApp(unqualified("Cons"), List(pat_var("x"), tail))), None, expr_var("x"))))))
  call parsed(in "Set()", out expr)
  assert expr == nowhere(EForm(FSet, List(), None))
  call parsed(in "Map(a => b, a => c)", out expr)
  assert expr == nowhere(EForm(FMap, List(YPair(a, b), YPair(a, c)), None))
  call parsed(in "Array(for x in a if x yield b)", out expr)
  assert expr == nowhere(EFor(FArray, List(GVal(pat_var("x"), a), GIf(expr_var("x"))), YVal(b), None))
  call parsed(in "Map(for k => v in a)", out expr)
  assert expr == nowhere(EFor(FMap, List(GPair(pat_var("k"), pat_var("v"), a)), YPair(expr_var("k"), expr_var("v")), None))
