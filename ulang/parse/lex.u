// the lexer of ulang, which splits source code into tokens with their positions, where a symbol is always the longest run
// of symbol characters, and which tells keywords from names and operators

import "ulang/syntax"

export

data Token :=
  // names that are not keywords, which are operators only if the notation in effect declares them
  case TName(name: Str)
  // runs of symbol characters that are not keywords, which are always operators
  case TOp(op: Str)
  // names and symbols with a fixed meaning, and punctuation
  case TKw(kw: Str)
  case TNum(num: Int)
  // 0x and hexadecimal digits of either case
  case THex(num: Int)
  case TStr(text: Str)
  case TChar(char: Char)
  case TEnd

// tokens with their positions, each with the stop of the token of code before it, which is where a part ends that ends
// before the token, where comments are no code, and Pos(1, 1) before the first
type Tokens :=
  List[Pos * Token * Pos]

data LexError :=
  case LexError(message: Str, pos: Pos)

function is_keyword(w: Str): Bool

procedure lex(in text: Str, out toks: Tokens) raises LexError

// the tokens of text and its comments, which the tokens do not hold, in the order of the text
procedure lex_all(
  in  text: Str,
  out toks: Tokens,
      comments: List[Comment]
) raises LexError

implementation

function keywords(): Set[Str] :=
  Set(
    "_",
    "assert",
    "builtin",
    "case",
    "catch",
    "correct",
    "data",
    "do",
    "else",
    "end",
    "ensures",
    "example",
    "export",
    "false",
    "for",
    "function",
    "if",
    "implementation",
    "import",
    "in",
    "induction",
    "invariant",
    "infix",
    "lambda",
    "lemma",
    "let",
    "match",
    "out",
    "pattern",
    "postfix",
    "prefix",
    "procedure",
    "raise",
    "raises",
    "ref",
    "requires",
    "skip",
    "test",
    "then",
    "true",
    "type",
    "try",
    "var",
    "while",
    "with",
    "yield")

function is_keyword(w: Str): Bool :=
  contains(w, keywords())

// symbols with a fixed meaning, which cannot be operators
function fixed_symbols(): Set[Str] :=
  Set("=>", ":=", ":")

function is_punct(c: Char): Bool :=
  contains(c, "()[],;.")

function is_name_char(c: Char): Bool :=
  is_letter(c) or is_digit(c) or c == '_'

// the character at offset, or the character 0 after the end of text
function peek(text: Str, offset: Int): Char :=
  if offset < size(text) then at(offset, text) else chr(0)

function unescape(c: Char): Option[Char] :=
  map_option(find(escapes(), lambda (e, _) => e == c), second)

// the run of characters from offset that satisfy p, where start is the offset before it, and offset ends after it
procedure scan(in text: Str, p: Char -> Bool, out start: Int, ref offset: Int) :=
  start := offset
  while p(peek(text, offset)) do
    offset := offset + 1
  end

// the line and column of offset to in text, from those of offset from
procedure lex_move_position(
  in  text: Str,
      from: Int,
      to: Int,
  ref line: Int,
      column: Int
) :=
  var j := from
  while j < to do
    if at(j, text) == '\n' then
      line := line + 1, column := 1
    else
      column := column + 1
    end
    j := j + 1
  end

function position_of(text: Str, offset: Int): Pos :=
  let lines := split(slice(text, 0, offset), '\n') in
  match last(lines)
    case Some(line) =>
      Pos(size(lines), size(line) + 1)
    case None =>
      Pos(1, 1)
  end

// the contents of the literal delimited by q at offset, with its escapes resolved, where offset ends after the closing quote
procedure lex_literal(in text: Str, q: Char, out contents: Str, ref offset: Int) :=
  let start := offset
  var from := offset + 1, parts: List[Str] := List(), c: Char
  offset := offset + 1
  while peek(text, offset) != q do
    c := peek(text, offset)
    if c == '\n' or offset >= size(text) then
      raise LexError("unterminated literal", position_of(text, start))
    end
    if c == '\\' then
      match unescape(peek(text, offset + 1))
        case Some(d) =>
          parts := List(str(List(d)), slice(text, from, offset); parts), offset := offset + 2
          from := offset

        case None =>
          raise LexError("invalid escape", position_of(text, offset))
      end
    else
      offset := offset + 1
    end
  end
  contents := join("", reverse(List(slice(text, from, offset); parts))), offset := offset + 1

procedure lex_name(in text: Str, out tok: Token, ref offset: Int) :=
  var from: Int
  scan(in text, is_name_char, out from, ref offset)
  tok := let w := slice(text, from, offset) in
  if contains(w, keywords()) then TKw(w) else TName(w)

procedure lex_number(in text: Str, out tok: Token, ref offset: Int) :=
  var from: Int
  scan(in text, is_digit, out from, ref offset)
  if slice(text, from, offset) == "0" and peek(text, offset) == 'x' then
    var digits: Int
    offset := offset + 1
    scan(in text, lambda c => hex_digit(c) != None, out digits, ref offset)
    if digits == offset then
      raise LexError("invalid number; a hexadecimal number has digits after 0x, as in 0xFF", position_of(text, from))
    end
    tok := THex(hex_value(slice(text, digits, offset)))
  else
    match number(slice(text, from, offset))
      case Some(n) =>
        tok := TNum(n)
      case None =>
        raise LexError("invalid number", position_of(text, from))
    end
  end

// the value of a hexadecimal digit, of either case, if c is one
function hex_digit(c: Char): Option[Int] :=
  example hex_digit('B') == Some(11)
  or_else(index_of(c, chars("0123456789abcdef")), index_of(c, chars("0123456789ABCDEF")))

function hex_value(digits: Str): Int :=
  example hex_value("D800") == 55296
  foldl(chars(digits), 0, lambda n, c => 16 * n + value_or(hex_digit(c), 0))

// the hint for an unexpected character c before next, after "; ", or ""
function character_hint(c: Char, next: Char): Str :=
  if c == '|' and next == '|' then
    "; the operators of Bool are and, or, and not"
  else if c == '|' then
    "; an operator consists of the characters " ++ str(List(for i in range(33, 127) if is_op_char(chr(i)) yield chr(i)))
  else
    ""

procedure lex_symbol(in text: Str, out tok: Token, ref offset: Int) :=
  var from: Int
  scan(in text, is_op_char, out from, ref offset)
  tok := let s := slice(text, from, offset) in
  if contains(s, fixed_symbols()) then TKw(s) else TOp(s)

procedure lex_string(in text: Str, out tok: Token, ref offset: Int) :=
  var contents: Str
  lex_literal(in text, '"', out contents, ref offset)
  tok := TStr(contents)

procedure lex_char(in text: Str, out tok: Token, ref offset: Int) :=
  let start := offset
  var contents: Str
  lex_literal(in text, '\'', out contents, ref offset)
  if size(contents) != 1 then
    raise LexError("invalid character", position_of(text, start))
  end
  tok := TChar(at(0, contents))

function margin_before(text: Str, offset: Int): Int :=
  next_margin(line_margin(text, offset - 1))

function has_space_before(text: Str, offset: Int): Bool :=
  at(offset - 1, text) == ' '

function at_line_start(text: Str, offset: Int): Bool :=
  offset == 0 or at(offset - 1, text) == '\n'

// the number of spaces before offset on its line, or -1 if anything else comes before it
function line_margin(text: Str, offset: Int): Int :=
  if at_line_start(text, offset) then
    0
  else if has_space_before(text, offset) then
    margin_before(text, offset)
  else
    -1

function next_margin(margin: Int): Int :=
  if margin < 0 then -1 else margin + 1

// the offset of the first character after the spaces at offset
// the text of the comment at offset, which starts with //, without them and the space after them, where offset ends at the
// end of its line
procedure lex_comment(in text: Str, out comment: Str, ref offset: Int) :=
  var from: Int, line: Str
  scan(in text, lambda c => c != '\n', out from, ref offset)
  line := without_return(slice(text, from + 2, offset))
  comment := if starts_with(line, " ") then slice(line, 1, size(line)) else line

// the line without the \r of a CRLF line end, so that a file with CRLF line ends has the comments of one with LF
function without_return(line: Str): Str :=
  example without_return(" a\r") == " a"
  if ends_with(line, "\r") then slice(line, 0, size(line) - 1) else line

// whether the line after the end of the line at offset is blank and something that is not a space follows it, where the
// lexer takes \r and \t for spaces
function is_blank_after(text: Str, offset: Int): Bool :=
  example is_blank_after("// a\n\nb", 4)
  example not is_blank_after("// a\n\n", 4)
  offset + 1 < size(text) and is_blank_line(text, offset + 1) and not is_space_from(text, offset + 1)

// whether the line at offset holds only spaces
function is_blank_line(text: Str, offset: Int): Bool :=
  let first := after_blanks(text, offset) in
  first >= size(text) or at(first, text) == '\n'

// the offset of the first character after the spaces at offset within its line
function after_blanks(text: Str, offset: Int): Int :=
  let c := peek(text, offset) in
  if c != '\n' and is_space(c) then after_blanks(text, offset + 1) else offset

// whether only spaces follow offset
function is_space_from(text: Str, offset: Int): Bool :=
  offset >= size(text) or is_space(at(offset, text)) and is_space_from(text, offset + 1)

// the text of a keyword, a name, or an operator, else "", of which a comment notes the next one
function word_of(tok: Token): Str :=
  match tok
    case TKw(kw) =>
      kw

    case TName(name) =>
      name

    case TOp(op) =>
      op

    case _ =>
      ""
  end

// the comments before a token at pos, which they hold as the next one
function comments_before(pending: List[Pos * Str * Bool * Bool], pos: Pos, tok: Token): List[Comment] :=
  List(for (p, text, own_line, blank_after) in pending yield Comment(p, text, own_line, blank_after, pos, word_of(tok)))

// the token at offset, where offset ends after it
procedure lex_token(in text: Str, out tok: Token, ref offset: Int) :=
  let c := at(offset, text)
  match c
    case _ if is_letter(c) or c == '_' =>
      lex_name(in text, out tok, ref offset)

    case _ if is_digit(c) =>
      lex_number(in text, out tok, ref offset)

    case _ if is_op_char(c) =>
      lex_symbol(in text, out tok, ref offset)

    case '"' =>
      lex_string(in text, out tok, ref offset)

    case '\'' =>
      lex_char(in text, out tok, ref offset)

    case _ if is_punct(c) =>
      tok := TKw(str(List(c))), offset := offset + 1

    case _ =>
      raise LexError("unexpected character" ++ character_hint(c, peek(text, offset + 1)), position_of(text, offset))
  end

procedure lex(in text: Str, out toks: Tokens) raises LexError :=
  var comments: List[Comment]
  lex_all(in text, out toks, comments)

// the tokens of text with their positions, which end with TEnd at the end of text, where line and column are those of
// offset last, and stop is the end of the last token of code, which has no newline, and the comments wait in pending for
// the next token
procedure lex_all(
  in  text: Str,
  out toks: Tokens,
      comments: List[Comment]
) raises LexError :=
  var offset := 0, found: Buffer[Pos * Token * Pos] := empty(), noted: Buffer[Comment] := empty(), pending: List[Pos * Str * Bool * Bool] := List(), start: Int, tok: Token, last := 0, line := 1, column := 1, comment: Str, stop := Pos(1, 1)
  while offset < size(text) do
    start := offset
    if is_space(at(offset, text)) then
      offset := offset + 1
    else
      if at(offset, text) == '/' and peek(text, offset + 1) == '/' then
        let own_line := line_margin(text, offset) >= 0
        lex_move_position(in text, last, start, ref line, column)
        lex_comment(in text, out comment, ref offset)
        pending := pending ++ List(
          (Pos(line, column), comment, own_line, is_blank_after(text, offset))), last := start
      else
        lex_token(in text, out tok, ref offset)
        lex_move_position(in text, last, start, ref line, column)
        found := found ++ List((Pos(line, column), tok, stop)), last := start
        noted := noted ++ comments_before(pending, Pos(line, column), tok), pending := List()
        stop := Pos(line, column + offset - start)
      end
    end
  end
  lex_move_position(in text, last, offset, ref line, column)
  toks := List(for t in found ++ List((Pos(line, column), TEnd, stop)))
  comments := List(for c in noted ++ comments_before(pending, Pos(line, column), TEnd))

function tokens(toks: Tokens): List[Token] :=
  List(for (_, tok, _) in toks yield tok)

function token_positions(toks: Tokens): List[Pos] :=
  List(for (pos, _, _) in toks yield pos)

test lex_tokens() :=
  var toks: Tokens
  lex(in "function f(x: Int): Int := x+-1\n  y", out toks)
  assert toks == List(
    (Pos(1, 1), TKw("function"), Pos(1, 1)),
    (Pos(1, 10), TName("f"), Pos(1, 9)),
    (Pos(1, 11), TKw("("), Pos(1, 11)),
    (Pos(1, 12), TName("x"), Pos(1, 12)),
    (Pos(1, 13), TKw(":"), Pos(1, 13)),
    (Pos(1, 15), TName("Int"), Pos(1, 14)),
    (Pos(1, 18), TKw(")"), Pos(1, 18)),
    (Pos(1, 19), TKw(":"), Pos(1, 19)),
    (Pos(1, 21), TName("Int"), Pos(1, 20)),
    (Pos(1, 25), TKw(":="), Pos(1, 24)),
    (Pos(1, 28), TName("x"), Pos(1, 27)),
    (Pos(1, 29), TOp("+-"), Pos(1, 29)),
    (Pos(1, 31), TNum(1), Pos(1, 31)),
    (Pos(2, 3), TName("y"), Pos(1, 32)),
    (Pos(2, 4), TEnd, Pos(2, 4)))

// the comments of text, by lex_all
procedure lexed_comments(
  in  text: Str,
  out toks: Tokens,
      comments: List[Comment]
) :=
  try
    lex_all(in text, out toks, comments)
  catch
    case LexError(_, _) =>
      toks := List(), comments := List()
  end

// comments are no tokens, each line one comment, which notes the next token, after code or above a blank line too
test lex_comments() :=
  var toks: Tokens, comments: List[Comment]
  lexed_comments(in "// a\n//  b\n//\nf // c\n\n  // d\n\ng", out toks, comments)
  assert tokens(toks) == List(TName("f"), TName("g"), TEnd)
  assert token_positions(toks) == List(Pos(4, 1), Pos(8, 1), Pos(8, 2))
  assert comments == List(
    Comment(Pos(1, 1), "a", true, false, Pos(4, 1), "f"),
    Comment(Pos(2, 1), " b", true, false, Pos(4, 1), "f"),
    Comment(Pos(3, 1), "", true, false, Pos(4, 1), "f"),
    Comment(Pos(4, 3), "c", false, true, Pos(8, 1), "g"),
    Comment(Pos(6, 3), "d", true, true, Pos(8, 1), "g"))
  lexed_comments(in "x\n// e\n", out toks, comments)
  assert comments == List(Comment(Pos(2, 1), "e", true, false, Pos(3, 1), ""))

test lex_comments_of_crlf() :=
  var lf: Tokens, crlf: Tokens, lf_comments: List[Comment], crlf_comments: List[Comment]
  lexed_comments(in "// a\n//  b\n//\nf\n", out lf, lf_comments)
  lexed_comments(in "// a\r\n//  b\r\n//\r\nf\r\n", out crlf, crlf_comments)
  assert crlf == lf and crlf_comments == lf_comments

function list_tokens(): List[Token] :=
  List(
    TName("List"),
    TKw("("),
    TName("x"),
    TKw(";"),
    TName("xs"),
    TKw(")"),
    TEnd)

test lex_literals() :=
  var toks: Tokens
  lex(in "\"a\\\"b\\n\" \"\" 'c' '\\'' List(x; xs)", out toks)
  assert tokens(toks) == List(TStr("a\"b\n"), TStr(""), TChar('c'), TChar('\'')) ++ list_tokens()
  lex(in "0xD800 0x00ff 0x0 0", out toks)
  assert tokens(toks) == List(THex(55296), THex(255), THex(0), TNum(0), TEnd)

// every escape as show writes it, in the interpreter by format_lit of ulang/format/format.u and quote, in compiled programs by
// the runtime, and read back by the lexer
test escapes_round_trip() :=
  var toks: Tokens
  for (_, c) in escapes() do
    assert show(c) == "'" ++ escape(c, '\'') ++ "'"
    assert show(str(List('a', c))) == "\"a" ++ escape(c, '"') ++ "\""
    lex(in show(c) ++ " " ++ show(str(List('a', c))), out toks)
    assert tokens(toks) == List(TChar(c), TStr(str(List('a', c))), TEnd)
  end

// the error of lexing text, or LexError("none", Pos(0, 0)) if there is none
procedure lex_error(in text: Str, out e: LexError) :=
  e := LexError("none", Pos(0, 0))
  try
    var toks: Tokens
    lex(in text, out toks)
  catch
    case LexError(message, pos) =>
      e := LexError(message, pos)
  end

test lex_errors() :=
  var e: LexError
  lex_error(in "x := \"ab", out e)
  assert e == LexError("unterminated literal", Pos(1, 6))
  lex_error(in "'\\q'", out e)
  assert e == LexError("invalid escape", Pos(1, 2))
  lex_error(in "'ab'", out e)
  assert e == LexError("invalid character", Pos(1, 1))
  lex_error(in "x := 0x", out e)
  assert e == LexError("invalid number; a hexadecimal number has digits after 0x, as in 0xFF", Pos(1, 6))

test lex_position() :=
  assert position_of("ab\ncd", 4) == Pos(2, 2)
  assert position_of("ab\n", 3) == Pos(2, 1)
  assert position_of("", 0) == Pos(1, 1)
