// the lexer of ulang, which splits source code into tokens with their positions, where a symbol is always the longest run
// of symbol characters, and which tells keywords from names and operators

import "ulang/syntax"

export

data Token :=
  // names that are not keywords, which are operators only if the notation in effect declares them
  case TName(name: Str)
  // runs of symbol characters that are not keywords, which are always operators
  case TOp(op: Str)
  // names and symbols with a fixed meaning, and punctuation
  case TKw(kw: Str)
  case TNum(num: Int)
  case TStr(text: Str)
  case TChar(char: Char)
  // the lines of a run of comments at the start of lines, in any column, without their markers, joined by newlines,
  // directly above a line that is not blank, or at the start of the text, where the parser decides by what follows whether
  // it documents it
  case TDoc(text: Str)
  // a comment that documents nothing, after code on its line or above a blank line, which the parser reports and ignores
  case TMisplaced
  case TEnd

// tokens with their positions
type Tokens :=
  List[Pos * Token]

data LexError :=
  case LexError(message: Str, pos: Pos)

function is_keyword(w: Str): Bool

procedure lex(in text: Str, out toks: Tokens) raises LexError

// the error of a comment that documents nothing
function misplaced_comment(): Str

implementation

function keywords(): Set[Str] :=
  Set(
    "_",
    "assert",
    "assign",
    "builtin",
    "call",
    "case",
    "catch",
    "data",
    "do",
    "else",
    "end",
    "ensures",
    "example",
    "export",
    "false",
    "for",
    "function",
    "if",
    "implementation",
    "import",
    "in",
    "induction",
    "infix",
    "lambda",
    "lemma",
    "let",
    "local",
    "match",
    "out",
    "pattern",
    "postfix",
    "prefix",
    "procedure",
    "raise",
    "raises",
    "ref",
    "requires",
    "skip",
    "test",
    "then",
    "true",
    "type",
    "try",
    "while",
    "with",
    "yield")

function is_keyword(w: Str): Bool :=
  contains(w, keywords())

// symbols with a fixed meaning, which cannot be operators
function fixed_symbols(): Set[Str] :=
  Set("=>", ":=", ":")

function is_punct(c: Char): Bool :=
  contains(c, "()[],;.")

function is_name_char(c: Char): Bool :=
  is_letter(c) or is_digit(c) or c == '_'

// the character at offset, or the character 0 after the end of text
function peek(text: Str, offset: Int): Char :=
  if offset < size(text) then at(offset, text) else chr(0)

function unescape(c: Char): Option[Char] :=
  map_option(find(escapes(), lambda (e, _) => e == c), second)

// the run of characters from offset that satisfy p, where start is the offset before it, and offset ends after it
procedure scan(in text: Str, p: Char -> Bool, out start: Int, ref offset: Int) :=
  assign start := offset
  while p(peek(text, offset)) do
    assign offset := offset + 1
  end

// the line and column of offset to in text, from those of offset from
procedure lex_move_position(
  in  text: Str,
      from: Int,
      to: Int,
  ref line: Int,
      column: Int
) :=
  local j := from
  while j < to do
    if at(j, text) == '\n' then
      assign line := line + 1, column := 1
    else
      assign column := column + 1
    end
    assign j := j + 1
  end

function position_of(text: Str, offset: Int): Pos :=
  let lines := split(slice(text, 0, offset), '\n') in
  match last(lines)
    case Some(line) =>
      Pos(size(lines), size(line) + 1)
    case None =>
      Pos(1, 1)
  end

// the contents of the literal delimited by q at offset, with its escapes resolved, where offset ends after the closing quote
procedure lex_literal(in text: Str, q: Char, out contents: Str, ref offset: Int) :=
  local start := offset, from := offset + 1, parts: List[Str] := List(), c: Char
  assign offset := offset + 1
  while peek(text, offset) != q do
    assign c := peek(text, offset)
    if c == '\n' or offset >= size(text) then
      raise LexError("unterminated literal", position_of(text, start))
    end
    if c == '\\' then
      match unescape(peek(text, offset + 1))
        case Some(d) =>
          assign parts := List(str(List(d)), slice(text, from, offset); parts), offset := offset + 2
          assign from := offset

        case None =>
          raise LexError("invalid escape", position_of(text, offset))
      end
    else
      assign offset := offset + 1
    end
  end
  assign contents := join("", reverse(List(slice(text, from, offset); parts))), offset := offset + 1

procedure lex_name(in text: Str, out tok: Token, ref offset: Int) :=
  local from: Int
  call   scan(in text, is_name_char, out from, ref offset)
  assign tok := let w := slice(text, from, offset) in
  if contains(w, keywords()) then TKw(w) else TName(w)

procedure lex_number(in text: Str, out tok: Token, ref offset: Int) :=
  local from: Int
  call scan(in text, is_digit, out from, ref offset)
  match number(slice(text, from, offset))
    case Some(n) =>
      assign tok := TNum(n)
    case None =>
      raise LexError("invalid number", position_of(text, from))
  end

procedure lex_symbol(in text: Str, out tok: Token, ref offset: Int) :=
  local from: Int
  call   scan(in text, is_op_char, out from, ref offset)
  assign tok := let s := slice(text, from, offset) in
  if contains(s, fixed_symbols()) then TKw(s) else TOp(s)

procedure lex_string(in text: Str, out tok: Token, ref offset: Int) :=
  local contents: Str
  call   lex_literal(in text, '"', out contents, ref offset)
  assign tok := TStr(contents)

procedure lex_char(in text: Str, out tok: Token, ref offset: Int) :=
  local start := offset, contents: Str
  call lex_literal(in text, '\'', out contents, ref offset)
  if size(contents) != 1 then
    raise LexError("invalid character", position_of(text, start))
  end
  assign tok := TChar(at(0, contents))

function margin_before(text: Str, offset: Int): Int :=
  next_margin(line_margin(text, offset - 1))

function has_space_before(text: Str, offset: Int): Bool :=
  at(offset - 1, text) == ' '

function at_line_start(text: Str, offset: Int): Bool :=
  offset == 0 or at(offset - 1, text) == '\n'

// the number of spaces before offset on its line, or -1 if anything else comes before it
function line_margin(text: Str, offset: Int): Int :=
  if at_line_start(text, offset) then
    0
  else if has_space_before(text, offset) then
    margin_before(text, offset)
  else
    -1

function next_margin(margin: Int): Int :=
  if margin < 0 then -1 else margin + 1

// the offset of the first character after the spaces at offset
function after_spaces(text: Str, offset: Int): Int :=
  if peek(text, offset) == ' ' then after_spaces(text, offset + 1) else offset

function has_slashes_at(text: Str, offset: Int): Bool :=
  peek(text, offset) == '/' and peek(text, offset + 1) == '/'

function starts_at(text: Str, offset: Int, part: Str): Bool :=
  offset + size(part) <= size(text) and slice(text, offset, offset + size(part)) == part

// the lines of the run of comments at offset, which is at the start of a line after spaces, each line in any column, with
// the markers // and the space after them removed, joined by newlines, where offset ends at the start of the line after
// the run, and above tells whether that line is not blank
procedure lex_doc(in text: Str, out doc: Str, above: Bool, ref offset: Int) :=
  local lines: List[Str] := List(), from: Int, line: Str, more := true
  while more do
    call   scan(in text, lambda c => c != '\n', out from, ref offset)
    assign line := slice(text, from + 2, offset)
    assign lines := List(
      if starts_with(line, " ") then slice(line, 1, size(line)) else line; lines)
    assign offset := if offset < size(text) then offset + 1 else offset
    assign more := has_slashes_at(text, after_spaces(text, offset))
    if more then
      assign offset := after_spaces(text, offset)
    end
  end
  assign doc := join("\n", reverse(lines)), above := is_doc_above(text, offset)

function is_doc_above(text: Str, offset: Int): Bool :=
  let first := after_spaces(text, offset) in
  first < size(text) and at(first, text) != '\n'

// the offset of the end of the line at offset
function line_end(text: Str, offset: Int): Int :=
  if offset < size(text) and at(offset, text) != '\n' then
    line_end(text, offset + 1)
  else
    offset

function misplaced_comment(): Str :=
  "a comment is the doc of the command, statement, or case below it, from the start of a line and without a blank line between"

// the token at offset, where offset ends after it
procedure lex_token(in text: Str, out tok: Token, ref offset: Int) :=
  local c := at(offset, text)
  match c
    case _ if is_letter(c) or c == '_' =>
      call lex_name(in text, out tok, ref offset)

    case _ if is_digit(c) =>
      call lex_number(in text, out tok, ref offset)

    case _ if is_op_char(c) =>
      call lex_symbol(in text, out tok, ref offset)

    case '"' =>
      call lex_string(in text, out tok, ref offset)

    case '\'' =>
      call lex_char(in text, out tok, ref offset)

    case _ if is_punct(c) =>
      assign tok := TKw(str(List(c))), offset := offset + 1

    case _ =>
      raise LexError("unexpected character", position_of(text, offset))
  end

// the tokens of text with their positions, which end with TEnd at the end of text, where line and column are those of
// offset last
procedure lex(in text: Str, out toks: Tokens) raises LexError :=
  local offset := 0, found: Buffer[Pos * Token] := empty(), start: Int, tok: Token, last := 0, line := 1, column := 1, doc: Str, above: Bool
  while offset < size(text) do
    assign start := offset
    if is_space(at(offset, text)) then
      assign offset := offset + 1
    else
      if at(offset, text) == '/' and peek(text, offset + 1) == '/' then
        call lex_move_position(in text, last, start, ref line, column)
        if line_margin(text, offset) >= 0 then
          call   lex_doc(in text, out doc, above, ref offset)
          assign found := found ++ List(
            (Pos(line, column), if above or start == 0 then TDoc(doc) else TMisplaced)), last := start
        else
          assign offset := line_end(text, offset)
          assign found := found ++ List((Pos(line, column), TMisplaced)), last := start
        end
      else
        call   lex_token(in text, out tok, ref offset)
        call   lex_move_position(in text, last, start, ref line, column)
        assign found := found ++ List((Pos(line, column), tok)), last := start
      end
    end
  end
  call   lex_move_position(in text, last, offset, ref line, column)
  assign toks := List(for t in found ++ List((Pos(line, column), TEnd)))

function tokens(toks: Tokens): List[Token] :=
  seconds(toks)

test lex_tokens() :=
  local toks: Tokens
  call lex(in "function f(x: Int): Int := x+-1\n  y", out toks)
  assert toks == List(
    (Pos(1, 1), TKw("function")),
    (Pos(1, 10), TName("f")),
    (Pos(1, 11), TKw("(")),
    (Pos(1, 12), TName("x")),
    (Pos(1, 13), TKw(":")),
    (Pos(1, 15), TName("Int")),
    (Pos(1, 18), TKw(")")),
    (Pos(1, 19), TKw(":")),
    (Pos(1, 21), TName("Int")),
    (Pos(1, 25), TKw(":=")),
    (Pos(1, 28), TName("x")),
    (Pos(1, 29), TOp("+-")),
    (Pos(1, 31), TNum(1)),
    (Pos(2, 3), TName("y")),
    (Pos(2, 4), TEnd))

test lex_docs() :=
  local toks: Tokens
  call lex(in "// a\n//  b\n//\nf\n\n\n\ng\n\nh\ni", out toks)
  assert tokens(toks) == List(TDoc("a\n b\n"), TName("f"), TName("g"), TName("h"), TName("i"), TEnd)
  assert firsts(toks) == List(Pos(1, 1), Pos(4, 1), Pos(8, 1), Pos(10, 1), Pos(11, 1), Pos(11, 2))

function rest_of_docs(): List[Token] :=
  List(TName("C"), TName("g"), TKw("case"), TName("D"), TEnd)

test lex_docs_of_modules_and_constructors() :=
  local toks: Tokens
  call lex(in "// head\n\nf", out toks)
  assert tokens(toks) == List(TDoc("head"), TName("f"), TEnd)
  call lex(in "data T :=\n  // c\n  //\n  case C\n  g\n  case D", out toks)
  assert tokens(toks) == List(TKw("data"), TName("T"), TKw(":="), TDoc("c\n"), TKw("case")) ++ rest_of_docs()

test lex_docs_of_cases() :=
  local toks: Tokens, text := "match x\n    // c\n    case 1 =>\n    y\n" ++ "    // e\n    case 2 =>\n    case 3", first := List(
    TKw("match"),
    TName("x"),
    TDoc("c"),
    TKw("case"),
    TNum(1),
    TKw("=>"),
    TName("y")), second := List(TDoc("e"), TKw("case"), TNum(2), TKw("=>"), TKw("case"), TNum(3), TEnd)
  call lex(in text, out toks)
  assert tokens(toks) == first ++ second

function list_tokens(): List[Token] :=
  List(
    TName("List"),
    TKw("("),
    TName("x"),
    TKw(";"),
    TName("xs"),
    TKw(")"),
    TEnd)

test lex_literals() :=
  local toks: Tokens
  call lex(in "\"a\\\"b\\n\" \"\" 'c' '\\'' List(x; xs)", out toks)
  assert tokens(toks) == List(TStr("a\"b\n"), TStr(""), TChar('c'), TChar('\'')) ++ list_tokens()

// every escape as show writes it, in the interpreter by format_lit of ulang/format/format.u and quote, in compiled programs by
// the runtime, and read back by the lexer
test escapes_round_trip() :=
  local toks: Tokens
  for (_, c) in escapes() do
    assert show(c) == "'" ++ escape(c, '\'') ++ "'"
    assert show(str(List('a', c))) == "\"a" ++ escape(c, '"') ++ "\""
    call lex(in show(c) ++ " " ++ show(str(List('a', c))), out toks)
    assert tokens(toks) == List(TChar(c), TStr(str(List('a', c))), TEnd)
  end

// the error of lexing text, or LexError("none", Pos(0, 0)) if there is none
procedure lex_error(in text: Str, out e: LexError) :=
  assign e := LexError("none", Pos(0, 0))
  try
    local toks: Tokens
    call lex(in text, out toks)
  catch
    case LexError(message, pos) =>
      assign e := LexError(message, pos)
  end

test lex_errors() :=
  local e: LexError
  call lex_error(in "x := \"ab", out e)
  assert e == LexError("unterminated literal", Pos(1, 6))
  call lex_error(in "'\\q'", out e)
  assert e == LexError("invalid escape", Pos(1, 2))
  call lex_error(in "'ab'", out e)
  assert e == LexError("invalid character", Pos(1, 1))

// comments after code and detached by a blank line document nothing, while a doc in any column is one
test lex_misplaced_comments() :=
  local toks: Tokens
  call lex(in "x // one\ny", out toks)
  assert toks == List(
    (Pos(1, 1), TName("x")),
    (Pos(1, 3), TMisplaced),
    (Pos(2, 1), TName("y")),
    (Pos(2, 2), TEnd))
  call lex(in "f\n// a\n\ng", out toks)
  assert tokens(toks) == List(TName("f"), TMisplaced, TName("g"), TEnd)
  call lex(in "match x\n  // a\n    case 3", out toks)
  assert tokens(toks) == List(TKw("match"), TName("x"), TDoc("a"), TKw("case"), TNum(3), TEnd)

test lex_position() :=
  assert position_of("ab\ncd", 4) == Pos(2, 2)
  assert position_of("ab\n", 3) == Pos(2, 1)
  assert position_of("", 0) == Pos(1, 1)
