// the lints of ulang: checks of the parsed program, each a rule of Lint, which the command lint reports as warnings, where
// the parsed program keeps the source that format prints, and a file is linted only if it checks, so that the names of
// a pattern, such as Some and value_or, are those of the library unless a module declares them again; the walks judge
// variables by their names, since no local hides another, and declarations by their base names, so overloads count as
// one

import ulang.syntax

export

// the rules, whose names are the codes of their warnings
data Lint :=
  // an if of true and false, or of false and true, which is its condition or not of it
  case BoolIte
  // a match that spells out value_or
  case Folded
  // a list that a generator only iterates, of the elements of a container, which is that container
  case CopiedContainer
  // a for whose body only appends one element to a list that starts empty, which is a form List(for …)
  case CollectingLoop
  // a handler whose body is skip, which swallows what it catches
  case SwallowedException
  // a private function, procedure, or pattern alias that no export, test, lemma, hook, or procedure without formals
  // reaches
  case UnusedPrivate
  // a local that is neither read nor passed as an out or ref, or a pattern variable that is never read
  case UnusedVariable
  // a name with a numeric index, such as e1, instead of a name by its role
  case NumberedName
  // a declaration show_x, where show is text that parses back and format_x prints into another language
  case ShowName
  // a local without an initial value that only one if, match, or try uses, so that its branches declare it
  case LocalTooHigh
  // a var with a value that no statement after it assigns, which is a let
  case UnassignedVar
  // a part of an expression that repeats an earlier one of the same declaration, of at least repeat_threshold parts,
  // modulo positions and the names of the variables bound inside it
  case RepeatedExpr
  // a function or procedure whose definition repeats an earlier one of its module, modulo positions and the names of its
  // formals, type parameters, and the variables bound inside
  case DuplicateDefinition

// a warning of lint at pos of a module, with the expression to write instead if there is one, and the edit that removes
// it if there is one, which needs no choice
data Warning :=
  case Warning(lint: Lint, pos: Pos, message: Str, replacement: Option[At[Expr]], edit: Option[Edit])

// the warnings of module d, of its commands in the order of the module, then of its unused private declarations, of the
// parts that repeat in a declaration, and of the definitions that repeat another
function lints(d: Mod): List[Warning]

implementation

function lints(d: Mod): List[Warning] :=
  List(for cmd in d.exported ++ d.builtins ++ d.implemented for w in cmd_lints(cmd) yield w) ++ unused_privates(d) ++ List(for cmd in d.implemented for w in repeated_exprs(cmd) yield w) ++ duplicate_definitions(d)

function cmd_lints(cmd: At[Cmd]): List[Warning] :=
  match cmd
    case AOk(pos, _, that) =>
      placed_cmd_lints(pos, that)

    case AErr(pos, _, that, _) =>
      placed_cmd_lints(pos, that)

    case AUnparsed(_, _, _, _) =>
      List()
  end

// fun is the function that a body defines, whose own definition no lint replaces by a call of it, as of not or value_or;
// the names of exported declarations are judged at their definitions, which repeat the signatures
function placed_cmd_lints(pos: Pos, cmd: Cmd): List[Warning] :=
  match cmd
    case CFun(name, _, formals, typ, _, body) =>
      decl_name_lints(pos, name.base, List(typ)) ++ vars_lints(pos, formals) ++ expr_lints(name.base, body)

    case CProc(name, _, ins, outs, refs, _, _, stmt) =>
      decl_name_lints(pos, name.base, List(for x in outs yield x.that.typ)) ++ vars_lints(pos, ins ++ outs ++ refs) ++ stmt_lints("", stmt)

    case CTest(_, _, stmt) =>
      stmt_lints("", stmt)

    case CLemma(_, _, ins, outs, claim, _) =>
      vars_lints(pos, ins ++ outs) ++ exprs_lints("", claim_exprs(claim))

    case CPatAlias(name, _, formals, _, _) =>
      decl_name_lints(pos, name.base, List()) ++ vars_lints(pos, formals)

    case CSort(_, _, _) =>
      List()

    case CData(_, _, _) =>
      List()

    case CNotation(_, _, _) =>
      List()

    case CFunSig(_, _, _, _, _) =>
      List()

    case CProcSig(_, _, _, _, _, _, _) =>
      List()

    case CAbstract(_, _) =>
      List()
  end

// the lints of the part expr, the construct at its position and its parts, where an unparsed part has none
function expr_lints(fun: Id, expr: At[Expr]): List[Warning] :=
  match expr
    case AOk(pos, span, that) =>
      placed_lints(fun, pos, span, that) ++ part_lints(fun, that)

    case AErr(pos, span, that, _) =>
      placed_lints(fun, pos, span, that) ++ part_lints(fun, that)

    case AUnparsed(_, _, _, _) =>
      List()
  end

function part_lints(fun: Id, expr: Expr): List[Warning] :=
  match expr
    case ELit(_) =>
      List()

    case EVar(_) =>
      List()

    case EApp(f, args) =>
      expr_lints(fun, f) ++ exprs_lints(fun, args)

    case EField(base, _) =>
      expr_lints(fun, base)

    case EUpdate(base, _, value) =>
      expr_lints(fun, base) ++ expr_lints(fun, value)

    case ELam(formals, body) =>
      binder_lints(formals, expr_names(body)) ++ expr_lints(fun, body)

    case EProc(ins, _, _, _, stmt) =>
      ins_lints(ins, stmt_names(stmt)) ++ stmt_lints(fun, stmt)

    case ELet(bindings, body) =>
      let_binder_lints(bindings, body) ++ exprs_lints(fun, List(for (_, e) in bindings yield e)) ++ expr_lints(fun, body)

    case EIte(cond, then_expr, else_expr) =>
      exprs_lints(fun, List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      expr_lints(fun, arg) ++ List(for br in parts(cases) for w in expr_branch_lints(fun, br) yield w)

    case ETuple(args) =>
      exprs_lints(fun, args)

    case EAnnotated(inner, _) =>
      expr_lints(fun, inner)

    case EForm(_, elems, rest) =>
      List(for y in elems for w in yield_lints(fun, y) yield w) ++ option_lints(fun, rest)

    case EFor(_, gens, elem, rest) =>
      gens_binder_lints(gens, yield_names(elem)) ++ gens_lints(fun, gens) ++ yield_lints(fun, elem) ++ option_lints(fun, rest)
  end

// the warnings of the variables of the bindings of a let, each read by the values of the bindings after it or by the body
function let_binder_lints(bindings: List[(At[Pat], At[Expr])], body: At[Expr]): List[Warning] :=
  match bindings
    case List() =>
      List()
    case List((pat, _); more) =>
      binder_lints(List(pat), exprs_names(List(for (_, e) in more yield e)) ++ expr_names(body)) ++ let_binder_lints(more, body)
  end

function expr_branch_lints(fun: Id, br: Branch[At[Expr]]): List[Warning] :=
  binder_lints(List(br.pat), option_names(br.guard) ++ expr_names(br.body)) ++ option_lints(fun, br.guard) ++ expr_lints(fun, br.body)

function exprs_lints(fun: Id, exprs: List[At[Expr]]): List[Warning] :=
  List(for e in exprs for w in expr_lints(fun, e) yield w)

function option_lints(fun: Id, expr: Option[At[Expr]]): List[Warning] :=
  List(for e in expr for w in expr_lints(fun, e) yield w)

function yield_lints(fun: Id, elem: Yield): List[Warning] :=
  match elem
    case YVal(value) =>
      expr_lints(fun, value)
    case YPair(key, value) =>
      expr_lints(fun, key) ++ expr_lints(fun, value)
  end

function gens_lints(fun: Id, gens: List[Gen]): List[Warning] :=
  List(for g in gens for w in gen_lints(fun, g) yield w)

function gen_lints(fun: Id, g: Gen): List[Warning] :=
  match g
    case GVal(_, over, _) =>
      iterated_list(over) ++ expr_lints(fun, over)

    case GPair(_, _, over, _) =>
      expr_lints(fun, over)

    case GIf(cond) =>
      expr_lints(fun, cond)
  end

function stmt_lints(fun: Id, stmt: At[Stmt]): List[Warning] :=
  match stmt
    case AOk(pos, _, that) =>
      part_stmt_lints(fun, pos, that)

    case AErr(pos, _, that, _) =>
      part_stmt_lints(fun, pos, that)

    case AUnparsed(_, _, _, _) =>
      List()
  end

function stmts_lints(fun: Id, stmts: List[At[Stmt]]): List[Warning] :=
  List(for s in stmts for w in stmt_lints(fun, s) yield w)

// the lints of stmt at pos, where the locals of a block are judged at the position of the block, since a Var has none
function part_stmt_lints(fun: Id, pos: Pos, stmt: Stmt): List[Warning] :=
  match stmt
    case SSkip =>
      List()

    case SAssign(upd) =>
      exprs_lints(fun, List(for (_, e) in upd yield e))

    case SBlock(locals, stmts) =>
      locals_lints(pos, locals, stmts) ++ declared_lints(stmts) ++ collecting_loops(stmts) ++ stmts_lints(fun, stmts)

    case SLocal(_, decls) =>
      exprs_lints(fun, List(for (_, init) in decls for e in init yield e))

    case SIf(cond, left, right) =>
      expr_lints(fun, cond) ++ stmts_lints(fun, List(left, right))

    case SWhile(cond, body) =>
      expr_lints(fun, cond) ++ stmt_lints(fun, body)

    case SCall(_, ins, _, _) =>
      exprs_lints(fun, ins)

    case SMatch(arg, cases) =>
      expr_lints(fun, arg) ++ List(for br in parts(cases) for w in stmt_branch_lints(fun, br) yield w)

    case SAssert(cond) =>
      expr_lints(fun, cond)

    case SAssertRaises(_, pat, guard, body) =>
      binder_lints(List(pat), option_names(guard)) ++ option_lints(fun, guard) ++ stmt_lints(fun, body)

    case SRaise(value, _) =>
      expr_lints(fun, value)

    case STry(body, catches) =>
      stmt_lints(fun, body) ++ List(for c in catches for w in catch_lints(fun, c) yield w)

    case SFor(gens, body) =>
      gens_binder_lints(gens, stmt_names(body)) ++ gens_lints(fun, gens) ++ stmt_lints(fun, body)
  end

function stmt_branch_lints(fun: Id, br: Branch[At[Stmt]]): List[Warning] :=
  binder_lints(List(br.pat), option_names(br.guard) ++ stmt_names(br.body)) ++ option_lints(fun, br.guard) ++ stmt_lints(fun, br.body)

function catch_lints(fun: Id, c: At[Catch]): List[Warning] :=
  let handler := c.that in
  let scope := option_names(handler.guard) ++ stmt_names(handler.body) in
  swallowed(c.pos, handler.body) ++ binder_lints(List(handler.pat), scope) ++ option_lints(fun, handler.guard) ++ stmt_lints(fun, handler.body)

// the lints of the construct expr at pos, which its parts do not include
function placed_lints(fun: Id, pos: Pos, span: Span, expr: Expr): List[Warning] :=
  match expr
    case EIte(cond, then_expr, else_expr) =>
      match (literal_bool(then_expr), literal_bool(else_expr))
        case (Some(true), Some(false)) =>
          List(
            rewritten(BoolIte, pos, span, "an if of true and false is its condition", cond))

        case (Some(false), Some(true)) if fun != "not" =>
          List(
            rewritten(BoolIte, pos, span, "an if of false and true is not of its condition", expr_app("not", List(cond))))

        case _ =>
          List()
      end

    case EMatch(arg, cases) if fun != "value_or" =>
      match option_default(parts(cases))
        case Some(d) =>
          List(
            rewritten(Folded, pos, span, "a match that gives the value of an option, or else a default, is value_or", expr_app("value_or", List(arg, d))))

        case None =>
          List()
      end

    case _ =>
      List()
  end

// a warning whose edit writes expr instead of the part at span
function rewritten(lint: Lint, pos: Pos, span: Span, message: Str, expr: At[Expr]): Warning :=
  Warning(lint, pos, message, Some(expr), Some(EditExpr(span, expr)))

function literal_bool(expr: At[Expr]): Option[Bool] :=
  match strip_expr(expr)
    case AOk(_, _, ELit(LBool(b))) =>
      Some(b)
    case _ =>
      None
  end

// a list that a generator iterates, which is the elements of its container in the order of its fold, as the generator
// takes them from the container itself, where a map gives its pairs to a single pattern
function iterated_list(over: At[Expr]): List[Warning] :=
  match over
    case AOk(pos, span, EFor(FList, List(g), elem, None)) if is_identity(g, elem) =>
      List(
        rewritten(CopiedContainer, pos, span, "a list that is only iterated, of the elements of a container, is that container", gen_over(g)))

    case _ =>
      List()
  end

// whether elem is what the single generator g yields without yield
function is_identity(g: Gen, elem: Yield): Bool :=
  match implicit_elem(FList, List(g))
    case Some(implicit) =>
      strip_yield(implicit) == strip_yield(elem)
    case None =>
      false
  end

function gen_over(g: Gen): At[Expr] :=
  match g
    case GVal(_, over, _) =>
      over

    case GPair(_, _, over, _) =>
      over

    case GIf(cond) =>
      cond
  end

// the default d of cases Some(x) => x and None => d, in either order, without guards, where d is a plain value, so that
// value_or, which takes d evaluated, computes nothing that the match would not
function option_default(cases: List[Branch[At[Expr]]]): Option[At[Expr]] :=
  match cases
    case List(Branch(some, None, x), Branch(none, None, d)) if is_some_of(some, x) and is_none(none) and is_plain(d) =>
      Some(d)

    case List(Branch(none, None, d), Branch(some, None, x)) if is_some_of(some, x) and is_none(none) and is_plain(d) =>
      Some(d)

    case _ =>
      None
  end

// whether pat is Some(x) and body the variable x
function is_some_of(pat: At[Pat], body: At[Expr]): Bool :=
  match (strip_pat(pat), strip_expr(body))
    case (AOk(_, _, PApp(Name(List(), "Some"), List(AOk(_, _, PVar(v))))), AOk(_, _, EVar(w))) =>
      v.name == w.name
    case _ =>
      false
  end

// whether pat is None, bare, as a variable that the checker resolves, or with ()
function is_none(pat: At[Pat]): Bool :=
  match strip_pat(pat)
    case AOk(_, _, PVar(v)) =>
      v.name == Name(List(), "None")

    case AOk(_, _, PApp(Name(List(), "None"), List())) =>
      true

    case _ =>
      false
  end

// whether expr is a literal, a variable, or a tuple or constructor of plain values, which evaluates without calling a function
function is_plain(expr: At[Expr]): Bool :=
  match strip_expr(expr)
    case AOk(_, _, ELit(_)) =>
      true

    case AOk(_, _, EVar(_)) =>
      true

    case AOk(_, _, ETuple(args)) =>
      forall(args, is_plain)

    case AOk(_, _, ECall(_, _, name, _, args)) =>
      name.path == List() and is_capitalized(name.base) and forall(args, is_plain)

    case _ =>
      false
  end

function is_capitalized(name: Id): Bool :=
  size(name) > 0 and int(at(0, name)) >= int('A') and int(at(0, name)) <= int('Z')

// the handler at pos swallows what it catches if its body is skip
function swallowed(pos: Pos, body: At[Stmt]): List[Warning] :=
  if is_skip(body) then
    List(
      Warning(SwallowedException, pos, "a handler that only skips swallows what it catches", None, None))
  else
    List()

function is_skip(stmt: At[Stmt]): Bool :=
  match stmt_part(stmt)
    case SSkip =>
      true

    case SBlock(List(), stmts) =>
      forall(stmts, is_skip)

    case _ =>
      false
  end

// the warnings of the locals xs of a block at pos, whose statements are stmts, starting with the assignments of the locals
// that have initial values
// the warnings of the locals xs of a block at pos, each at its declaration
function locals_lints(pos: Pos, xs: List[At[Var]], stmts: List[At[Stmt]]): List[Warning] :=
  let inits := initialized(vars(xs), stmts) in
  List(for x in xs for w in local_lints(decl_pos(pos, x.pos), x.that.name.base, contains(x.that.name.base, inits), None, stmts) yield w)

// the warnings of the locals that the SLocal statements of stmts declare, each read by the declarations after it in its
// statement and by the statements after that
function declared_lints(stmts: List[At[Stmt]]): List[Warning] :=
  match stmts
    case List() =>
      List()

    case List(stmt; rest) =>
      match stmt_part(stmt)
        case SLocal(mutable, decls) =>
          decls_lints(stmt.span, decls, rest) ++ (if mutable then unassigned_vars(stmt.span, decls, rest) else List()) ++ declared_lints(rest)
        case _ =>
          declared_lints(rest)
      end
  end

// the declarations with values of a var over local whose variables no statement in rest assigns, which are a let, an edit
// of the keyword if they are all its declarations
function unassigned_vars(local: Span, decls: List[(At[Pat], Option[At[Expr]])], rest: List[At[Stmt]]): List[Warning] :=
  let changed := Set(for s in rest for x in assigned(s) ++ call_outs(s) yield x) in
  let unassigned := List(for (pat, init) in decls if init != None and forall(pat_vars(pat), lambda (_, x) => not contains(x, changed)) yield pat) in
  let edit := if size(unassigned) == size(decls) then Some(EditLet(local)) else None in
  List(for pat in unassigned yield Warning(UnassignedVar, pat.pos, "the var " ++ join(", ", List(for (_, x) in pat_vars(pat) yield x)) ++ " is never assigned after its value, declare it by let", None, edit))

function decls_lints(local: Span, decls: List[(At[Pat], Option[At[Expr]])], rest: List[At[Stmt]]): List[Warning] :=
  match decls
    case List() =>
      List()

    case List((pat, init); more) =>
      let decl := Span(pat.span.start, match init
        case Some(value) =>
          value.span.stop
        case None =>
          pat.span.stop
      end) in
      decl_lints(pat, init != None, exprs_names(List(for (_, i) in more for e in i yield e)), (local, decl), rest) ++ decls_lints(local, more, rest)
  end

// a local that is a variable, also with an annotation, as a local of a block, and the variables of a pattern as those of
// other patterns
// where site is the span of the statement and of the declaration
function decl_lints(pat: At[Pat], has_init: Bool, later: Set[Id], site: (Span, Span), rest: List[At[Stmt]]): List[Warning] :=
  match pat_vars(pat)
    case List((pos, name)) if is_variable(pat) =>
      if contains(name, later) then
        name_lints(pos, name)
      else
        local_lints(pos, name, has_init, Some(site), rest)

    case xs =>
      List(for (pos, name) in xs for w in var_lints(pos, name, later ++ Set(for s in rest for x in stmt_names(s) ++ call_outs(s) yield x)) yield w)
  end

function is_variable(pat: At[Pat]): Bool :=
  match pat.that
    case PVar(_) =>
      true

    case PAnnotated(inner, _) =>
      is_variable(inner)

    case _ =>
      false
  end

// the locals of xs that the assignments at the start of stmts initialize, as format_body prints them
function initialized(xs: List[Var], stmts: List[At[Stmt]]): Set[Id] :=
  match (xs, stmts)
    case (List(x; more), List(AOk(_, _, SAssign(List((y, _)))); rest)) if y == Var(x.name, THole) =>
      Set(x.name.base) ++ initialized(more, rest)

    case (List(_; more), _) =>
      initialized(more, stmts)

    case (List(), _) =>
      Set()
  end

// a local that is neither read nor an out or ref of a call is unused, as is one that is only an out, which out _ drops
// without a local, and one without an initial value that only a
// branching statement names, outside its condition, is declared too high, where site, the spans of the statement and of
// the declaration of a let or var, places the edits
function local_lints(pos: Pos, name: Id, has_init: Bool, site: Option[(Span, Span)], stmts: List[At[Stmt]]): List[Warning] :=
  name_lints(pos, name) ++ (if not exists(stmts, lambda s => contains(name, stmt_names(s) ++ call_outs(s))) then
    List(
      Warning(UnusedVariable, pos, "the local " ++ name ++ " is never read", None, map_option(site, lambda (local, decl) => EditMove(local, decl, List()))))
  else if not exists(stmts, lambda s => contains(name, stmt_names(s))) then
    let assigns := exists(stmts, lambda s => contains(name, assigned(s))) in
    let edit := if assigns then
      None
    else
      map_option(site, lambda (local, decl) => EditDropOuts(local, decl, List(for s in stmts for span in out_calls(name, s) yield span), name)) in
    List(
      Warning(UnusedVariable, pos, "the local " ++ name ++ " is never read, write _ at the outs that receive it", None, edit))
  else if has_init then
    List()
  else
    too_high(pos, name, site, List(for s in stmts if is_named(name, s))))

function too_high(pos: Pos, name: Id, site: Option[(Span, Span)], users: List[At[Stmt]]): List[Warning] :=
  match users
    case List(s) if is_branching(name, stmt_part(s)) =>
      let bodies := List(for body in branch_bodies(stmt_part(s)) if is_named(name, body) yield body.span) in
      let edit := map_option(site, lambda (local, decl) => EditMove(local, decl, bodies)) in
      List(
        Warning(LocalTooHigh, pos, "the local " ++ name ++ " is used only in the branches of one statement, which declare it where they use it", None, edit))

    case _ =>
      List()
  end

// the bodies of the branches of stmt, of an if, a match, or a try
function branch_bodies(stmt: Stmt): List[At[Stmt]] :=
  match stmt
    case SIf(_, left, right) =>
      List(left, right)

    case SMatch(_, cases) =>
      List(for br in parts(cases) yield br.body)

    case STry(body, catches) =>
      List(body; List(for c in parts(catches) yield c.body))

    case _ =>
      List()
  end

// whether stmt branches without naming name in its condition, an argument or guard of a match, or the head of a try
function is_branching(name: Id, stmt: Stmt): Bool :=
  match stmt
    case SIf(cond, _, _) =>
      not contains(name, expr_names(cond))

    case SMatch(arg, cases) =>
      not contains(name, expr_names(arg)) and forall(parts(cases), lambda br => not contains(name, option_names(br.guard)))

    case STry(_, catches) =>
      forall(parts(catches), lambda c => not contains(name, option_names(c.guard)))

    case _ =>
      false
  end

// whether stmt reads, assigns, or passes the variable name
function is_named(name: Id, stmt: At[Stmt]): Bool :=
  contains(name, stmt_names(stmt) ++ call_outs(stmt) ++ assigned(stmt))

// the loops of stmts that only append one element to a local that an earlier statement sets to List(), where no statement
// between names the local
function collecting_loops(stmts: List[At[Stmt]]): List[Warning] :=
  match stmts
    case List() =>
      List()
    case List(s; rest) =>
      List(for x in emptied(stmt_part(s)) for w in collecting_loop(x, rest) yield w) ++ collecting_loops(rest)
  end

function emptied(stmt: Stmt): List[Id] :=
  match stmt
    case SAssign(upd) =>
      List(for (x, e) in upd if is_empty_list(e) yield x.name.base)
    case _ =>
      List()
  end

function is_empty_list(expr: At[Expr]): Bool :=
  match strip_expr(expr)
    case AOk(_, _, EForm(FList, List(), None)) =>
      true
    case _ =>
      false
  end

// the warning of the first statement of stmts that names x, if it is a loop that only appends to x
function collecting_loop(x: Id, stmts: List[At[Stmt]]): List[Warning] :=
  match List(for s in stmts if is_named(x, s))
    case List(AOk(pos, span, SFor(gens, body)); _) if not contains(x, gens_names(gens)) =>
      List(for elem in appended(x, body) yield collected(pos, x, AOk(pos, span, EFor(FList, gens, YVal(elem), None))))
    case _ =>
      List()
  end

function collected(pos: Pos, x: Id, list: At[Expr]): Warning :=
  Warning(CollectingLoop, pos, "a loop that only appends to " ++ x ++ " is the list that it builds, which " ++ x ++ " can be assigned", Some(list), None)

// the element e of a body assign x := x ++ List(e) that does not name x
function appended(x: Id, body: At[Stmt]): Option[At[Expr]] :=
  match stmt_part(body)
    case SBlock(List(), List(only)) =>
      appended(x, only)

    case SAssign(List(
      (y, AOk(_, _, ECall(_, _, Name(List(), "++"), _, List(AOk(_, _, EVar(z)), AOk(_, _, EForm(FList, List(YVal(e)), None)))))))) if y.name.base == x and z.name.base == x and not contains(x, expr_names(e)) =>
      Some(e)

    case _ =>
      None
  end

// the private functions, procedures, and pattern aliases of d that no export, test, lemma, hook, or procedure without
// formals reaches, by the names that their bodies read, where the exported names are the roots, also of overloads
function unused_privates(d: Mod): List[Warning] :=
  let exported := exported_names(d), cmds := commands_of(d.implemented) in
  let reached := reach(uses_graph(cmds), List(for x in exported ++ conventional(d.name) ++ root_names(cmds)), Set()) in
  List(for c in d.implemented for (kind, name) in private_decl(c) if not contains(name, exported ++ reached) yield unused(c.pos, kind, name))

function unused(pos: Pos, kind: Str, name: Id): Warning :=
  Warning(UnusedPrivate, pos, "nothing reaches the private " ++ kind ++ " " ++ name, None, Some(EditDrop(pos)))

function exported_names(d: Mod): Set[Id] :=
  Set(for c in commands_of(d.exported ++ d.builtins) for n in declared_name(c) yield n)

// the declarations of cmds by their base names, each to the names that the bodies of its overloads read
function uses_graph(cmds: List[Cmd]): Map[Id, Set[Id]] :=
  Map(for n in Set(for c in cmds for m in declared_name(c) yield m) yield n => overload_names(n, cmds))

function overload_names(name: Id, cmds: List[Cmd]): Set[Id] :=
  Set(for c in cmds if declared_name(c) == Some(name) for x in cmd_names(c) yield x)

function root_names(cmds: List[Cmd]): Set[Id] :=
  Set(for c in cmds if is_root(c) for x in cmd_names(c) ++ Set(for n in declared_name(c) yield n) yield x)

// the names reachable from todo in graph, which maps each declaration to the names that it reads, besides seen
function reach(graph: Map[Id, Set[Id]], todo: List[Id], seen: Set[Id]): Set[Id] :=
  match todo
    case List() =>
      seen

    case List(n; rest) =>
      if contains(n, seen) then
        reach(graph, rest, seen)
      else
        reach(graph, List(for x in value_or(get(n, graph), Set())) ++ rest, Set(n) ++ seen)
  end

// the names that the language uses without a use in the module: the hooks, and project of project.u
function conventional(m: Path): Set[Id] :=
  Set("show", "compare", "==") ++ (if m == List("project") then Set("project") else Set())

// whether cmd is used where it is, as a test, a lemma, a declaration with examples, which are tests, or a procedure without
// formals, which run and test may call
function is_root(cmd: Cmd): Bool :=
  match cmd
    case CTest(_, _, _) =>
      true

    case CLemma(_, _, _, _, _, _) =>
      true

    case CProc(_, _, List(), List(), List(), _, _, _) =>
      true

    case CFun(_, _, _, _, spec, _) =>
      spec.examples != List()

    case CProc(_, _, _, _, _, _, spec, _) =>
      spec.examples != List()

    case CNoCode =>
      false
  end

function declared_name(cmd: Cmd): Option[Id] :=
  match cmd
    case CFun(name, _, _, _, _, _) =>
      Some(name.base)

    case CProc(name, _, _, _, _, _, _, _) =>
      Some(name.base)

    case CFunSig(name, _, _, _, _) =>
      Some(name.base)

    case CProcSig(name, _, _, _, _, _, _) =>
      Some(name.base)

    case CPatAlias(name, _, _, _, _) =>
      Some(name.base)

    case CSort(_, _, _)
       | CData(_, _, _)
       | CAbstract(_, _)
       | CNotation(_, _, _)
       | CTest(_, _, _)
       | CLemma(_, _, _, _, _, _) =>
      None
  end

// the kind and name of a declaration that may be private
function private_decl(cmd: At[Cmd]): Option[(Str, Id)] :=
  match cmd
    case AOk(_, _, CFun(name, _, _, _, _, _)) =>
      Some(("function", name.base))

    case AOk(_, _, CProc(name, _, _, _, _, _, _, _)) =>
      Some(("procedure", name.base))

    case AOk(_, _, CPatAlias(name, _, _, _, _)) =>
      Some(("pattern alias", name.base))

    case _ =>
      None
  end

// the names that the body of cmd reads, and its examples
function cmd_names(cmd: Cmd): Set[Id] :=
  match cmd
    case CFun(_, _, _, _, spec, body) =>
      spec_names(spec) ++ expr_names(body)

    case CProc(_, _, _, _, _, _, spec, stmt) =>
      spec_names(spec) ++ stmt_names(stmt)

    case CTest(_, _, stmt) =>
      stmt_names(stmt)

    case CLemma(_, _, _, _, claim, proof) =>
      claim_names(claim) ++ Set(for p in proof for x in proof_names(p) yield x)

    case CPatAlias(_, _, _, _, pat) =>
      pat_names(pat)

    case CSort(_, _, _)
       | CData(_, _, _)
       | CAbstract(_, _)
       | CNotation(_, _, _)
       | CSig =>
      Set()
  end

function spec_names(spec: Spec): Set[Id] :=
  exprs_names(spec.pre ++ List(for e in spec.post)) ++ Set(for x in spec.examples if is_parsed(x) for n in example_names(x.that) yield n)

function claim_names(claim: Claim): Set[Id] :=
  match claim
    case ClaimHolds(assms, concl) =>
      exprs_names(assms) ++ expr_names(concl)
    case ClaimCorrect(proc, ins, _) =>
      Set(proc.base) ++ exprs_names(ins)
  end

function example_names(x: Example): Set[Id] :=
  match x
    case XHolds(expr) =>
      expr_names(expr)

    case XRaises(expr, pat) =>
      expr_names(expr) ++ pat_names(pat)

    case XCall(proc, ins, outs, refs) =>
      Set(proc.base) ++ exprs_names(ins ++ outs ++ List(for (before, after) in refs for e in List(before, after) yield e))

    case XCallRaises(proc, ins, _, befores, pat) =>
      Set(proc.base) ++ exprs_names(ins ++ befores) ++ pat_names(pat)
  end

// the warnings of the variables that pats bind, which scope reads or not
function binder_lints(pats: List[At[Pat]], scope: Set[Id]): List[Warning] :=
  List(for p in pats for (pos, x) in pat_vars(p) for w in var_lints(pos, x, scope) yield w)

function var_lints(pos: Pos, name: Id, scope: Set[Id]): List[Warning] :=
  name_lints(pos, name) ++ unread_lints(pos, name, scope)

function unread_lints(pos: Pos, name: Id, scope: Set[Id]): List[Warning] :=
  if contains(name, scope) then
    List()
  else
    List(
      Warning(UnusedVariable, pos, "the variable " ++ name ++ " is never read, write _", None, Some(EditWild(Span(pos, Pos(pos.line, pos.col + size(name)))))))

// the ins of a procedure lambda that its body never reads, which may be _, while its outs and refs are assigned
function ins_lints(ins: List[At[Var]], scope: Set[Id]): List[Warning] :=
  List(for x in ins if not is_dropped(x.that) for w in unread_lints(x.pos, x.that.name.base, scope) yield w)

// the warnings of the variables of the generators gens, each read in the generators after it or in scope
function gens_binder_lints(gens: List[Gen], scope: Set[Id]): List[Warning] :=
  match gens
    case List() =>
      List()
    case List(g; rest) =>
      binder_lints(gen_pats(g), gens_names(rest) ++ scope) ++ gens_binder_lints(rest, scope)
  end

function gen_pats(g: Gen): List[At[Pat]] :=
  match g
    case GVal(pat, _, _) =>
      List(pat)

    case GPair(key, value, _, _) =>
      List(key, value)

    case GIf(_) =>
      List()
  end

// the warnings of the names of the formals xs of a declaration at pos, each at the formal
function vars_lints(pos: Pos, xs: List[At[Var]]): List[Warning] :=
  List(for x in xs for w in name_lints(decl_pos(pos, x.pos), x.that.name.base) yield w)

// the position of a declaration, or else of what declares it, outer, if the parser did not read it
function decl_pos(outer: Pos, pos: Pos): Pos :=
  if pos == Pos(0, 0) then outer else pos

// the warnings of the name of a declaration whose results are of the types results, where show_ is a name only of what
// gives no text, as show_ref of a hook
function decl_name_lints(pos: Pos, name: Id, results: List[Type]): List[Warning] :=
  name_lints(pos, name) ++ (if starts_with(name, "show_") and exists(results, is_str) then
    List(
      Warning(ShowName, pos, "the name " ++ name ++ " is show if it gives text that parses back, else format_ if it prints into another language", None, None))
  else
    List())

function is_str(typ: Type): Bool :=
  match typ
    case TSort(Name(List(), "Str"), List()) =>
      true
    case _ =>
      false
  end

function name_lints(pos: Pos, name: Id): List[Warning] :=
  if is_numbered(name) then
    List(
      Warning(NumberedName, pos, "the name " ++ name ++ " has a numeric index, name it by its role", None, None))
  else
    List()

// whether name ends in a digit after a letter, as e1 or stmt2, but in a standard name after its last _, whose digit is no
// index, as os_read_utf8, while those of more digits, as sha256 or x86, end in no digit after a letter
function is_numbered(name: Id): Bool :=
  example is_numbered("stmt2")
  example is_numbered("os_read_utf8") == false
  match reverse(chars(name))
    case List(c, d; _) =>
      is_digit(c) and is_letter(d) and not contains(value_or(last(split(name, '_')), name), standard_names())
    case _ =>
      false
  end

// the names of encodings, hashes, and protocols that end in a digit after a letter
function standard_names(): Set[Id] :=
  Set(
    "utf8",
    "md5",
    "sha1",
    "ipv4",
    "ipv6",
    "pop3",
    "http2",
    "http3",
    "int8",
    "uint8")

// the variables that pat binds, each at its position, where a capitalized name is a constructor or an alias without
// formals
function pat_vars(pat: At[Pat]): List[(Pos, Id)] :=
  match pat
    case AOk(pos, _, that) =>
      placed_pat_vars(pos, that)

    case AErr(pos, _, that, _) =>
      placed_pat_vars(pos, that)

    case AUnparsed(_, _, _, _) =>
      List()
  end

function placed_pat_vars(pos: Pos, pat: Pat): List[(Pos, Id)] :=
  match pat
    case PVar(v) if not is_capitalized(v.name.base) =>
      List((pos, v.name.base))

    case PApp(_, args) =>
      List(for p in args for x in pat_vars(p) yield x)

    case PTuple(args) =>
      List(for p in args for x in pat_vars(p) yield x)

    case PAnnotated(inner, _) =>
      pat_vars(inner)

    // those of the first alternative, which all bind, so that an unread one is reported once
    case POr(alts) =>
      List(for p in take(1, alts) for x in pat_vars(p) yield x)

    case PWild | PLit(_) | PVar(_) =>
      List()
  end

function stmt_part(stmt: At[Stmt]): Stmt :=
  match stmt
    case AOk(_, _, that) =>
      that

    case AErr(_, _, that, _) =>
      that

    case AUnparsed(_, _, _, _) =>
      SSkip
  end

// the statements directly inside stmt, without those of procedures inside its expressions, which assign only their own
// outs and refs
function child_stmts(stmt: Stmt): List[At[Stmt]] :=
  match stmt
    case SSkip =>
      List()

    case SAssign(_) =>
      List()

    case SBlock(_, stmts) =>
      stmts

    case SLocal(_, _) =>
      List()

    case SIf(_, left, right) =>
      List(left, right)

    case SWhile(_, body) =>
      List(body)

    case SCall(_, _, _, _) =>
      List()

    case SMatch(_, cases) =>
      List(for br in parts(cases) yield br.body)

    case SAssert(_) =>
      List()

    case SAssertRaises(_, _, _, body) =>
      List(body)

    case SRaise(_, _) =>
      List()

    case STry(body, catches) =>
      List(body; List(for c in parts(catches) yield c.body))

    case SFor(_, body) =>
      List(body)
  end

// the variables that stmt passes as outs or refs of calls
function call_outs(stmt: At[Stmt]): Set[Id] :=
  let part := stmt_part(stmt) in
  let own := match part
    case SCall(_, _, outs, refs) =>
      Set(for x in outs ++ refs yield x.name.base)
    case _ =>
      Set()
  end in
  own ++ Set(for s in child_stmts(part) for x in call_outs(s) yield x)

// the spans of the calls in stmt that pass name as an out
function out_calls(name: Id, stmt: At[Stmt]): List[Span] :=
  let part := stmt_part(stmt) in
  let own := match part
    case SCall(_, _, outs, _) =>
      if exists(outs, lambda x => x.name.base == name) then
        List(stmt.span)
      else
        List()

    case _ =>
      List()
  end in
  own ++ List(for s in child_stmts(part) for span in out_calls(name, s) yield span)

// the variables that the assignments of stmt assign
function assigned(stmt: At[Stmt]): Set[Id] :=
  let part := stmt_part(stmt) in
  let own := match part
    case SAssign(upd) =>
      Set(for (x, _) in upd yield x.name.base)
    case _ =>
      Set()
  end in
  own ++ Set(for s in child_stmts(part) for x in assigned(s) yield x)

// the names that expr reads, of locals and declarations as written, also inside its lambdas, and the constructors and
// aliases that its patterns name
function expr_names(expr: At[Expr]): Set[Id] :=
  match expr
    case AOk(_, _, that) =>
      part_names(that)

    case AErr(_, _, that, _) =>
      part_names(that)

    case AUnparsed(_, _, _, _) =>
      Set()
  end

function part_names(expr: Expr): Set[Id] :=
  match expr
    case ELit(_) =>
      Set()

    case EVar(v) =>
      Set(v.name.base)

    case EApp(f, args) =>
      expr_names(f) ++ exprs_names(args)

    case EField(base, _) =>
      expr_names(base)

    case EUpdate(base, _, value) =>
      expr_names(base) ++ expr_names(value)

    case ELam(formals, body) =>
      Set(for p in formals for x in pat_names(p) yield x) ++ expr_names(body)

    case EProc(_, _, _, _, stmt) =>
      stmt_names(stmt)

    case ELet(bindings, body) =>
      Set(for (p, e) in bindings for x in pat_names(p) ++ expr_names(e) yield x) ++ expr_names(body)

    case EIte(cond, then_expr, else_expr) =>
      exprs_names(List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      expr_names(arg) ++ Set(for br in parts(cases) for x in pat_names(br.pat) ++ option_names(br.guard) ++ expr_names(br.body) yield x)

    case ETuple(args) =>
      exprs_names(args)

    case EAnnotated(inner, _) =>
      expr_names(inner)

    case EForm(_, elems, rest) =>
      Set(for y in elems for x in yield_names(y) yield x) ++ option_names(rest)

    case EFor(_, gens, elem, rest) =>
      gens_names(gens) ++ yield_names(elem) ++ option_names(rest)
  end

function exprs_names(exprs: List[At[Expr]]): Set[Id] :=
  Set(for e in exprs for x in expr_names(e) yield x)

function option_names(expr: Option[At[Expr]]): Set[Id] :=
  Set(for e in expr for x in expr_names(e) yield x)

function yield_names(elem: Yield): Set[Id] :=
  match elem
    case YVal(value) =>
      expr_names(value)
    case YPair(key, value) =>
      expr_names(key) ++ expr_names(value)
  end

function gens_names(gens: List[Gen]): Set[Id] :=
  Set(for g in gens for x in gen_names(g) yield x)

function gen_names(g: Gen): Set[Id] :=
  match g
    case GVal(pat, over, _) =>
      pat_names(pat) ++ expr_names(over)

    case GPair(key, value, over, _) =>
      pat_names(key) ++ pat_names(value) ++ expr_names(over)

    case GIf(cond) =>
      expr_names(cond)
  end

// the constructors and aliases that pat names, without the variables that it binds
function pat_names(pat: At[Pat]): Set[Id] :=
  match pat
    case AOk(_, _, that) =>
      part_pat_names(that)

    case AErr(_, _, that, _) =>
      part_pat_names(that)

    case AUnparsed(_, _, _, _) =>
      Set()
  end

function part_pat_names(pat: Pat): Set[Id] :=
  match pat
    case PVar(v) if is_capitalized(v.name.base) =>
      Set(v.name.base)

    case PApp(constr, args) =>
      Set(constr.base) ++ Set(for p in args for x in pat_names(p) yield x)

    case PTuple(args) =>
      Set(for p in args for x in pat_names(p) yield x)

    case PAnnotated(inner, _) =>
      pat_names(inner)

    case POr(alts) =>
      Set(for p in alts for x in pat_names(p) yield x)

    case PWild | PLit(_) | PVar(_) =>
      Set()
  end

// the names that a proof reads, of its expressions and of the lemmas that it calls
function proof_names(proof: Proof): Set[Id] :=
  Set(for step in proof.steps for x in step_names(step.that) yield x) ++ Set(for split in proof.split for x in split_names(split.that) yield x)

function step_names(step: Step): Set[Id] :=
  match step
    case StepLocal(_, value) =>
      option_names(value)

    case StepCall(name, ins, _) =>
      Set(name.base) ++ exprs_names(ins)

    case StepAssert(cond) =>
      expr_names(cond)

    case StepInvariant(cond) =>
      expr_names(cond)

    case StepAssign(upd) =>
      Set(for (_, e) in upd for x in expr_names(e) yield x)
  end

function split_names(split: Split): Set[Id] :=
  match split
    case SplitInduction(_, cases) =>
      branches_proof_names(cases)

    case SplitMatch(arg, cases) =>
      expr_names(arg) ++ branches_proof_names(cases)

    case SplitIf(cond, left, right) =>
      expr_names(cond) ++ proof_names(left) ++ Set(for p in right for x in proof_names(p) yield x)
  end

function branches_proof_names(cases: List[At[Branch[Proof]]]): Set[Id] :=
  Set(for br in parts(cases) for x in pat_names(br.pat) ++ option_names(br.guard) ++ proof_names(br.body) yield x)

// the names that stmt reads, of its expressions, of the procedures it calls, and of the refs that it passes
function stmt_names(stmt: At[Stmt]): Set[Id] :=
  let part := stmt_part(stmt) in
  own_names(part) ++ Set(for s in child_stmts(part) for x in stmt_names(s) yield x)

// the names that stmt reads itself, without its statements
function own_names(stmt: Stmt): Set[Id] :=
  match stmt
    case SSkip =>
      Set()

    case SAssign(upd) =>
      Set(for (_, e) in upd for x in expr_names(e) yield x)

    case SBlock(_, _) =>
      Set()

    case SLocal(_, decls) =>
      exprs_names(List(for (_, init) in decls for e in init yield e))

    case SIf(cond, _, _) =>
      expr_names(cond)

    case SWhile(cond, _) =>
      expr_names(cond)

    case SCall(proc, ins, _, refs) =>
      Set(proc.base) ++ exprs_names(ins) ++ Set(for r in refs yield r.name.base)

    case SMatch(arg, cases) =>
      expr_names(arg) ++ Set(for br in parts(cases) for x in pat_names(br.pat) ++ option_names(br.guard) yield x)

    case SAssert(cond) =>
      expr_names(cond)

    case SAssertRaises(_, pat, guard, _) =>
      pat_names(pat) ++ option_names(guard)

    case SRaise(value, _) =>
      expr_names(value)

    case STry(_, catches) =>
      Set(for c in parts(catches) for x in pat_names(c.pat) ++ option_names(c.guard) yield x)

    case SFor(gens, _) =>
      gens_names(gens)
  end

// the smallest size of a part that RepeatedExpr reports, in parts of expressions, so that x.name, f(a, b), and
// g(x.f, y.f) repeat freely
function repeat_threshold(): Int :=
  8

// a part of an expression in a declaration, as canon_expr writes it, with its size in parts of expressions, the locals
// bound outside it that it reads, each at its binder, and the branches that lead to it, each the position of its if,
// match, or try and that of the branch
data Occurrence :=
  case Occurrence(canon: At[Expr], size: Int, pos: Pos, span: Span, bindings: List[(Id, Pos)], path: List[(Pos, Pos)])

// the size of a part in parts of expressions, and the occurrences of its parts of at least repeat_threshold parts
data Measured :=
  case Measured(size: Int, found: List[Occurrence])

// the warnings of the parts of expressions that repeat on one path of the function or procedure cmd, each at an occurrence
// that no larger repeated part contains, naming the first on its path, where a part of a procedure counts only if it reads
// no variable that the procedure assigns, since its value may change between its occurrences; tests, whose literal data
// repeat by design, and the parts in different branches of an if, a match, or a try, which no let before them can bind
// once, are not judged
function repeated_exprs(cmd: At[Cmd]): List[Warning] :=
  match cmd
    case AOk(_, _, CFun(_, _, _, _, _, body)) =>
      repeats(measured(Place(List(), Map()), body).found)

    case AOk(_, _, CProc(_, _, _, outs, refs, _, _, stmt)) =>
      let changed := Set(for x in outs ++ refs yield x.that.name.base) ++ assigned(stmt) ++ call_outs(stmt) in
      repeats(List(for o in measured_stmt(Place(List(), Map()), stmt).found if forall(expr_names(o.canon), lambda x => not contains(x, changed)) yield o))

    case _ =>
      List()
  end

// the occurrences grouped by their parts and the binders of the locals that they read, so that two parts that read
// variables of one name bound in different places do not repeat
function repeats(found: List[Occurrence]): List[Warning] :=
  let groups := foldl(found, (Map(): Map[(At[Expr], List[(Id, Pos)]), List[Occurrence]]), lambda m, o => put((o.canon, o.bindings), value_or(get((o.canon, o.bindings), m), List()) ++ List(o), m)) in
  let repeated := List(for _ => os in groups if size(os) > 1 for o in os yield o) in
  sort(List(for _ => os in groups if size(os) > 1 for w in repeat_warnings(List(), List(for (_, o) in sort(List(for o in os yield (o.pos, o))) yield o), repeated) yield w))

function repeat_warning(first: Occurrence, o: Occurrence): Warning :=
  Warning(RepeatedExpr, o.pos, "the expression repeats the one of line " ++ show(first.pos.line), None, None)

function is_within(inner: Span, outer: Span): Bool :=
  outer.start <= inner.start and inner.stop <= outer.stop

// whether the paths take different branches of one construct
function is_exclusive(path: List[(Pos, Pos)], path_: List[(Pos, Pos)]): Bool :=
  exists(path, lambda (at, branch) => exists(path_, lambda (at_, branch_) => at == at_ and branch != branch_))

function measured(place: Place, expr: At[Expr]): Measured :=
  match expr
    case AOk(pos, span, that) | AErr(pos, span, that, _) =>
      let inner := measured_parts(place, pos, that) in
      let size := inner.size + 1 in
      if size >= repeat_threshold() then
        let canon := canon_expr(Map(), 0, expr) in
        let bindings := List(for x in expr_names(canon) for binder in get(x, place.scope) yield (x, binder)) in
        Measured(size, List(
          Occurrence(canon, size, pos, span, bindings, place.path); inner.found))
      else
        Measured(size, inner.found)

    case AUnparsed(_, _, _, _) =>
      Measured(0, List())
  end

function measured_all(place: Place, exprs: List[At[Expr]]): Measured :=
  summed(List(for e in exprs yield measured(place, e)))

function summed(ms: List[Measured]): Measured :=
  Measured(foldl(ms, 0, lambda n, m => n + m.size), List(for m in ms for o in m.found yield o))

// the parts of expr at pos, where the branches of an if and the cases of a match extend the path, and binders the scope
function measured_parts(place: Place, pos: Pos, expr: Expr): Measured :=
  match expr
    case ELit(_) | EVar(_) =>
      Measured(0, List())

    case EApp(fun, args) =>
      measured_all(place, List(fun; args))

    case EField(base, _) =>
      measured(place, base)

    case EUpdate(base, _, value) =>
      measured_all(place, List(base, value))

    case ELam(formals, body) =>
      measured(with_pats(place, formals), body)

    case EProc(ins, outs, refs, _, stmt) =>
      measured_stmt(with_vars(place, ins ++ outs ++ refs), stmt)

    case ELet(bindings, body) =>
      measured_bindings(place, bindings, body)

    case EIte(cond, then_expr, else_expr) =>
      summed(List(
        measured(place, cond),
        measured(along(place, pos, then_expr.pos), then_expr),
        measured(along(place, pos, else_expr.pos), else_expr)))

    case EMatch(arg, cases) =>
      summed(List(
        measured(place, arg); List(for c in cases if is_parsed(c) yield measured_guarded(along(place, pos, c.pos), c.that.pat, c.that.guard, c.that.body, measured))))

    case ETuple(args) =>
      measured_all(place, args)

    case EAnnotated(inner, _) =>
      measured(place, inner)

    case EForm(_, elems, rest) =>
      measured_all(place, List(for y in elems for e in yield_exprs(y) yield e) ++ List(for e in rest))

    case EFor(_, gens, elem, rest) =>
      summed(List(
        measured_gens(place, gens, lambda inner => measured_all(inner, yield_exprs(elem))),
        measured_all(place, List(for e in rest))))
  end

function yield_exprs(elem: Yield): List[At[Expr]] :=
  match elem
    case YVal(value) =>
      List(value)
    case YPair(key, value) =>
      List(key, value)
  end

function measured_stmt(place: Place, stmt: At[Stmt]): Measured :=
  match stmt
    case AOk(pos, _, that) | AErr(pos, _, that, _) =>
      measured_statement(place, pos, that)
    case AUnparsed(_, _, _, _) =>
      Measured(0, List())
  end

// the statements of a block, each in the scope of the locals that those before it declare
function measured_stmts(place: Place, stmts: List[At[Stmt]]): Measured :=
  match stmts
    case List() =>
      Measured(0, List())

    case List(stmt; rest) =>
      match stmt_part(stmt)
        case SLocal(_, decls) =>
          summed(List(
            measured_decls(place, decls),
            measured_stmts(with_pats(place, List(for (pat, _) in decls yield pat)), rest)))

        case _ =>
          summed(List(measured_stmt(place, stmt), measured_stmts(place, rest)))
      end
  end

// the parts of the statement stmt at pos, where the branches of an if and a try and the cases of a match extend the path,
// and binders the scope
function measured_statement(place: Place, pos: Pos, stmt: Stmt): Measured :=
  match stmt
    case SSkip =>
      Measured(0, List())

    case SAssign(upd) =>
      measured_all(place, List(for (_, e) in upd yield e))

    case SBlock(locals, stmts) =>
      measured_stmts(with_vars(place, locals), stmts)

    case SLocal(_, decls) =>
      measured_decls(place, decls)

    case SIf(cond, left, right) =>
      summed(List(
        measured(place, cond),
        measured_stmt(along(place, pos, left.pos), left),
        measured_stmt(along(place, pos, right.pos), right)))

    case SWhile(cond, body) =>
      summed(List(measured(place, cond), measured_stmt(place, body)))

    case SCall(_, ins, _, _) =>
      measured_all(place, ins)

    case SMatch(arg, cases) =>
      summed(List(
        measured(place, arg); List(for c in cases if is_parsed(c) yield measured_guarded(along(place, pos, c.pos), c.that.pat, c.that.guard, c.that.body, measured_stmt))))

    case SAssert(cond) =>
      measured(place, cond)

    case SAssertRaises(_, pat, guard, body) =>
      summed(List(for g in guard yield measured(with_pats(place, List(pat)), g)) ++ List(measured_stmt(place, body)))

    case SRaise(value, _) =>
      measured(place, value)

    case STry(body, catches) =>
      summed(List(
        measured_stmt(along(place, pos, body.pos), body); List(for c in catches if is_parsed(c) yield measured_guarded(along(place, pos, c.pos), c.that.pat, c.that.guard, c.that.body, measured_stmt))))

    case SFor(gens, body) =>
      measured_gens(place, gens, lambda inner => measured_stmt(inner, body))
  end

// expr without positions, where each variable bound inside it is named by the number of the binders around it and before
// it, (0), (1), …, from level, and the variables of env as env names them, so that two parts that differ only in the
// names of the variables that they bind are equal, while their free variables keep their names
function canon_expr(env: Map[Id, Id], level: Int, expr: At[Expr]): At[Expr] :=
  match expr
    case AOk(_, _, that) | AErr(_, _, that, _) =>
      nowhere(canon_node(env, level, that))
    case AUnparsed(_, _, _, _) =>
      strip_expr(expr)
  end

function canon_exprs(env: Map[Id, Id], level: Int, exprs: List[At[Expr]]): List[At[Expr]] :=
  List(for e in exprs yield canon_expr(env, level, e))

function canon_node(env: Map[Id, Id], level: Int, expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(v) =>
      EVar(canon_var(env, v))

    case EApp(fun, args) =>
      EApp(canon_expr(env, level, fun), canon_exprs(env, level, args))

    case EField(base, field) =>
      EField(canon_expr(env, level, base), field)

    case EUpdate(base, field, value) =>
      EUpdate(canon_expr(env, level, base), field, canon_expr(env, level, value))

    case ELam(formals, body) =>
      let (inner, next) := bound(env, level, formals) in
      ELam(List(for p in formals yield canon_pat(inner, p)), canon_expr(inner, next, body))

    case EProc(ins, outs, refs, raised, stmt) =>
      let (inner, next) := bound_vars(env, level, ins ++ outs ++ refs) in
      EProc(canon_vars(inner, ins), canon_vars(inner, outs), canon_vars(inner, refs), raised, canon_stmt(inner, next, stmt))

    case ELet(bindings, body) =>
      let (bindings_, inner, next) := canon_bindings(env, level, bindings) in
      ELet(bindings_, canon_expr(inner, next, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(canon_expr(env, level, cond), canon_expr(env, level, then_expr), canon_expr(env, level, else_expr))

    case EMatch(arg, cases) =>
      EMatch(canon_expr(env, level, arg), List(for c in cases yield canon_case(env, level, c, canon_expr)))

    case ETuple(args) =>
      ETuple(canon_exprs(env, level, args))

    case EAnnotated(inner, typ) =>
      EAnnotated(canon_expr(env, level, inner), typ)

    case EForm(form, elems, rest) =>
      EForm(form, List(for y in elems yield canon_yield(env, level, y)), map_option(rest, lambda r => canon_expr(env, level, r)))

    case EFor(form, gens, elem, rest) =>
      let (gens_, inner, next) := canon_gens(env, level, gens) in
      EFor(form, gens_, canon_yield(inner, next, elem), map_option(rest, lambda r => canon_expr(env, level, r)))
  end

function canon_yield(env: Map[Id, Id], level: Int, elem: Yield): Yield :=
  match elem
    case YVal(value) =>
      YVal(canon_expr(env, level, value))
    case YPair(key, value) =>
      YPair(canon_expr(env, level, key), canon_expr(env, level, value))
  end

// the bindings of a let, each value in the scope of the patterns before it, with the scope after them
function canon_bindings(env: Map[Id, Id], level: Int, bindings: List[(At[Pat], At[Expr])]): (List[(At[Pat], At[Expr])], Map[Id, Id], Int) :=
  match bindings
    case List() =>
      (List(), env, level)

    case List((pat, value); more) =>
      let (inner, next) := bound(env, level, List(pat)) in
      let (rest, last, top) := canon_bindings(inner, next, more) in
      (List((canon_pat(inner, pat), canon_expr(env, level, value)); rest), last, top)
  end

// the generators of a form or a for, each in the scope of the patterns before it, with the scope after them
function canon_gens(env: Map[Id, Id], level: Int, gens: List[Gen]): (List[Gen], Map[Id, Id], Int) :=
  match gens
    case List() =>
      (List(), env, level)

    case List(g; more) =>
      let (inner, next) := bound(env, level, gen_pats(g)) in
      let (rest, last, top) := canon_gens(inner, next, more) in
      (List(canon_gen(env, level, inner, g); rest), last, top)
  end

// the generator g over the scope env, whose patterns bind the variables of inner
function canon_gen(env: Map[Id, Id], level: Int, inner: Map[Id, Id], g: Gen): Gen :=
  match g
    case GVal(pat, over, typ) =>
      GVal(canon_pat(inner, pat), canon_expr(env, level, over), typ)

    case GPair(key, value, over, typ) =>
      GPair(canon_pat(inner, key), canon_pat(inner, value), canon_expr(env, level, over), typ)

    case GIf(cond) =>
      GIf(canon_expr(env, level, cond))
  end

function canon_case[A](env: Map[Id, Id], level: Int, c: At[Branch[A]], canon_body: (Map[Id, Id], Int, A) -> A): At[Branch[A]] :=
  match c
    case AOk(_, _, br) | AErr(_, _, br, _) =>
      let (inner, next) := bound(env, level, List(br.pat)) in
      nowhere(Branch(canon_pat(inner, br.pat), map_option(br.guard, lambda g => canon_expr(inner, next, g)), canon_body(inner, next, br.body)))

    case AUnparsed(_, _, _, _) =>
      c
  end

function canon_handler(env: Map[Id, Id], level: Int, c: At[Catch]): At[Catch] :=
  match c
    case AOk(_, _, handler) | AErr(_, _, handler, _) =>
      let (inner, next) := bound(env, level, List(handler.pat)) in
      nowhere(Catch(handler.typ, canon_pat(inner, handler.pat), map_option(handler.guard, lambda g => canon_expr(inner, next, g)), canon_stmt(inner, next, handler.body)))

    case AUnparsed(_, _, _, _) =>
      c
  end

function canon_pat(env: Map[Id, Id], pat: At[Pat]): At[Pat] :=
  match pat
    case AOk(_, _, that) | AErr(_, _, that, _) =>
      nowhere(canon_pattern(env, that))
    case AUnparsed(_, _, _, _) =>
      strip_pat(pat)
  end

function canon_pattern(env: Map[Id, Id], pat: Pat): Pat :=
  match pat
    case PVar(v) =>
      PVar(canon_var(env, v))

    case PApp(constr, args) =>
      PApp(constr, List(for p in args yield canon_pat(env, p)))

    case PTuple(args) =>
      PTuple(List(for p in args yield canon_pat(env, p)))

    case PAnnotated(inner, typ) =>
      PAnnotated(canon_pat(env, inner), typ)

    case POr(alts) =>
      POr(List(for p in alts yield canon_pat(env, p)))

    case PWild | PLit(_) =>
      pat
  end

function canon_var(env: Map[Id, Id], v: Var): Var :=
  match get(v.name.base, env)
    case Some(base) if v.name.path == List() =>
      Var(unqualified(base), v.typ)
    case _ =>
      v
  end

function canon_vars(env: Map[Id, Id], xs: List[At[Var]]): List[At[Var]] :=
  List(for x in xs yield nowhere(canon_var(env, x.that)))

// env and level with the variables that pats bind, in the order of the source, where the alternatives of a pattern bind
// those of the first
function bound(env: Map[Id, Id], level: Int, pats: List[At[Pat]]): (Map[Id, Id], Int) :=
  binding(env, level, List(for p in pats for (_, x) in pat_vars(p) yield x))

function bound_vars(env: Map[Id, Id], level: Int, xs: List[At[Var]]): (Map[Id, Id], Int) :=
  binding(env, level, List(for x in xs yield x.that.name.base))

function binding(env: Map[Id, Id], level: Int, names: List[Id]): (Map[Id, Id], Int) :=
  match names
    case List() =>
      (env, level)
    case List(x; more) =>
      binding(put(x, "(" ++ show(level) ++ ")", env), level + 1, more)
  end

function canon_stmt(env: Map[Id, Id], level: Int, stmt: At[Stmt]): At[Stmt] :=
  match stmt
    case AOk(_, _, that) | AErr(_, _, that, _) =>
      nowhere(canon_statement(env, level, that))
    case AUnparsed(_, _, _, _) =>
      strip_stmt(stmt)
  end

// the statements of a block, each in the scope of the locals that the statements before it declare
function canon_stmts(env: Map[Id, Id], level: Int, stmts: List[At[Stmt]]): List[At[Stmt]] :=
  match stmts
    case List() =>
      List()

    case List(stmt; rest) =>
      let (inner, next) := match stmt_part(stmt)
        case SLocal(_, decls) =>
          bound(env, level, List(for (pat, _) in decls yield pat))
        case _ =>
          (env, level)
      end in
      List(canon_stmt(env, level, stmt); canon_stmts(inner, next, rest))
  end

// the declarations of a let or var, each value in the scope of the patterns before it
function canon_decls(env: Map[Id, Id], level: Int, decls: List[(At[Pat], Option[At[Expr]])]): List[(At[Pat], Option[At[Expr]])] :=
  match decls
    case List() =>
      List()

    case List((pat, init); more) =>
      let (inner, next) := bound(env, level, List(pat)) in
      List(
        (canon_pat(inner, pat), map_option(init, lambda e => canon_expr(env, level, e))); canon_decls(inner, next, more))
  end

function canon_statement(env: Map[Id, Id], level: Int, stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for (x, e) in upd yield (canon_var(env, x), canon_expr(env, level, e))))

    case SBlock(locals, stmts) =>
      let (inner, next) := bound_vars(env, level, locals) in
      SBlock(canon_vars(inner, locals), canon_stmts(inner, next, stmts))

    case SLocal(mutable, decls) =>
      SLocal(mutable, canon_decls(env, level, decls))

    case SIf(cond, left, right) =>
      SIf(canon_expr(env, level, cond), canon_stmt(env, level, left), canon_stmt(env, level, right))

    case SWhile(cond, body) =>
      SWhile(canon_expr(env, level, cond), canon_stmt(env, level, body))

    case SCall(proc, ins, outs, refs) =>
      SCall(canon_var(env, Var(proc, THole)).name, canon_exprs(env, level, ins), List(for x in outs yield canon_var(env, x)), List(for x in refs yield canon_var(env, x)))

    case SMatch(arg, cases) =>
      SMatch(canon_expr(env, level, arg), List(for c in cases yield canon_case(env, level, c, canon_stmt)))

    case SAssert(cond) =>
      SAssert(canon_expr(env, level, cond))

    case SAssertRaises(typ, pat, guard, body) =>
      let (inner, next) := bound(env, level, List(pat)) in
      SAssertRaises(typ, canon_pat(inner, pat), map_option(guard, lambda g => canon_expr(inner, next, g)), canon_stmt(env, level, body))

    case SRaise(value, typ) =>
      SRaise(canon_expr(env, level, value), typ)

    case STry(body, catches) =>
      STry(canon_stmt(env, level, body), List(for c in catches yield canon_handler(env, level, c)))

    case SFor(gens, body) =>
      let (gens_, inner, next) := canon_gens(env, level, gens) in
      SFor(gens_, canon_stmt(inner, next, body))
  end

// a function or procedure of a module, at pos, by its definition as canon_definition writes it
data Definition :=
  case Definition(kind: Str, name: Id, pos: Pos, canon: Canon)

// the types of the formals and the body of a definition, where the formals and the type parameters are named by their
// positions, as canon_expr names the variables bound inside
data Canon :=
  case CanonFun(formals: List[Type], typ: Type, body: At[Expr])
  case CanonProc(ins: List[Type], outs: List[Type], refs: List[Type], raised: List[Type], stmt: At[Stmt])

// the functions and procedures of d with formals whose definitions repeat an earlier one, each at its definition, where
// those without formals are named constants, whose names tell equal values apart, as name_offset and num_offset of
// ulang/compile/x86.u
function duplicate_definitions(d: Mod): List[Warning] :=
  duplicates(List(for c in d.implemented for decl in canon_definition(c) yield decl), Map())

function duplicates(decls: List[Definition], seen: Map[Canon, Definition]): List[Warning] :=
  match decls
    case List() =>
      List()

    case List(decl; rest) =>
      match get(decl.canon, seen)
        case Some(first) =>
          List(
            Warning(DuplicateDefinition, decl.pos, "the " ++ decl.kind ++ " " ++ decl.name ++ " repeats the definition of " ++ first.name ++ " at line " ++ show(first.pos.line), None, None); duplicates(rest, seen))

        case None =>
          duplicates(rest, put(decl.canon, decl, seen))
      end
  end

function canon_definition(cmd: At[Cmd]): Option[Definition] :=
  match cmd
    case AOk(pos, _, CFun(name, params, formals, typ, _, body)) if formals != List() =>
      let (env, level) := bound_vars(Map(), 0, formals) in
      Some(Definition("function", name.base, pos, CanonFun(canon_formals(params, formals), canon_type(params, typ), canon_expr(env, level, body))))

    case AOk(pos, _, CProc(name, params, ins, outs, refs, raised, _, stmt)) if ins ++ outs ++ refs != List() =>
      let (env, level) := bound_vars(Map(), 0, ins ++ outs ++ refs) in
      let canon := CanonProc(canon_formals(params, ins), canon_formals(params, outs), canon_formals(params, refs), canon_types(params, raised), canon_stmt(env, level, stmt)) in
      Some(Definition("procedure", name.base, pos, canon))

    case _ =>
      None
  end

function canon_formals(params: List[Id], formals: List[At[Var]]): List[Type] :=
  List(for x in formals yield canon_type(params, x.that.typ))

function canon_types(params: List[Id], types: List[Type]): List[Type] :=
  List(for t in types yield canon_type(params, t))

// typ with each type parameter of params named by its position
function canon_type(params: List[Id], typ: Type): Type :=
  match typ
    case TParam(param) =>
      match index_of(param, params)
        case Some(i) =>
          TParam("(" ++ show(i) ++ ")")
        case None =>
          typ
      end

    case TSort(name, args) =>
      TSort(name, canon_types(params, args))

    case TFun(args, res) =>
      TFun(canon_types(params, args), canon_type(params, res))

    case TProc(ins, outs, refs, raised) =>
      TProc(canon_types(params, ins), canon_types(params, outs), canon_types(params, refs), raised)

    case TTuple(types) =>
      TTuple(canon_types(params, types))

    case THole | TMeta(_) | TError =>
      typ
  end

// the warnings of the occurrences os of one part after those of earlier, in the order of the source, at each that no
// larger part of repeated contains, naming the first of earlier on its path
function repeat_warnings(earlier: List[Occurrence], os: List[Occurrence], repeated: List[Occurrence]): List[Warning] :=
  match os
    case List() =>
      List()

    case List(o; later) =>
      let covered := exists(repeated, lambda p => p.size > o.size and is_within(o.span, p.span)) in
      let found := if covered then
        List()
      else
        List(for p in find(earlier, lambda p => not is_exclusive(p.path, o.path)) yield repeat_warning(p, o)) in
      found ++ repeat_warnings(earlier ++ List(o), later, repeated)
  end

// where a part of a declaration stands: the branches that lead to it, as of Occurrence, and the locals in scope, each at its
// binder, where the formals of the declaration, which no local hides, are not
data Place :=
  case Place(path: List[(Pos, Pos)], scope: Map[Id, Pos])

// place with the variables that pats bind in scope
function with_pats(place: Place, pats: List[At[Pat]]): Place :=
  place with scope := place.scope ++ Map(for p in pats for (pos, x) in pat_vars(p) yield x => pos)

function with_vars(place: Place, xs: List[At[Var]]): Place :=
  place with scope := place.scope ++ Map(for x in xs yield x.that.name.base => x.pos)

// place in the branch at branch of the construct at at
function along(place: Place, at: Pos, branch: Pos): Place :=
  place with path := List((at, branch); place.path)

// the bindings of a let and its body, each value in the scope of the patterns before it
function measured_bindings(place: Place, bindings: List[(At[Pat], At[Expr])], body: At[Expr]): Measured :=
  match bindings
    case List() =>
      measured(place, body)

    case List((pat, value); more) =>
      summed(List(
        measured(place, value),
        measured_bindings(with_pats(place, List(pat)), more, body)))
  end

// the generators gens, each in the scope of the patterns before it, and then what inside measures in the scope of all
function measured_gens(place: Place, gens: List[Gen], inside: Place -> Measured): Measured :=
  match gens
    case List() =>
      inside(place)

    case List(g; more) =>
      summed(List(
        measured(place, gen_over(g)),
        measured_gens(with_pats(place, gen_pats(g)), more, inside)))
  end

// a case or handler of pattern pat, whose guard and body are in its scope
function measured_guarded[A](place: Place, pat: At[Pat], guard: Option[At[Expr]], body: A, measure: (Place, A) -> Measured): Measured :=
  let inner := with_pats(place, List(pat)) in
  summed(List(for g in guard yield measured(inner, g)) ++ List(measure(inner, body)))

// the declarations of a let or var, each value in the scope of the patterns before it
function measured_decls(place: Place, decls: List[(At[Pat], Option[At[Expr]])]): Measured :=
  match decls
    case List() =>
      Measured(0, List())

    case List((pat, init); more) =>
      summed(List(
        measured_all(place, List(for e in init)),
        measured_decls(with_pats(place, List(pat)), more)))
  end
