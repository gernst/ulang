// the lints of ulang: rewrites of the parsed program, each from a pattern to a simpler expression that keeps the meaning,
// which check --lint reports as warnings, where the parsed program keeps the positions and the source that format prints,
// and a file is linted only if it checks, so that the names of a pattern, such as Some and value_or, are those of the
// library unless a module declares them again

import "ulang/syntax"

export

// the expression at pos of a module is better written as replacement, for the reason of message
data Lint :=
  case Lint(pos: Pos, message: Str, replacement: Expr)

// the lints of the commands of module d, in the order of the module
function lints(d: Mod): List[Lint]

implementation

function lints(d: Mod): List[Lint] :=
  List(for top in d.exported ++ d.builtins ++ d.implemented for l in cmd_lints(top.cmd) yield l)

// fun is the function that a body defines, whose own definition no lint replaces by a call of it, as of not or value_or
function cmd_lints(cmd: Cmd): List[Lint] :=
  match cmd
    case CFun(name, _, _, _, body) =>
      expr_lints(name.base, body)

    case CProc(_, _, _, _, _, stmt) =>
      stmt_lints("", stmt)

    case CTest(_, _, stmt) =>
      stmt_lints("", stmt)

    case CLemma(_, _, _, assms, concl) =>
      exprs_lints("", assms) ++ expr_lints("", concl)

    case CSort(_, _, _) =>
      List()

    case CData(_, _, _) =>
      List()

    case CNotation(_, _, _) =>
      List()

    case CFunSig(_, _, _, _) =>
      List()

    case CProcSig(_, _, _, _, _) =>
      List()

    case CAbstract(_, _) =>
      List()

    case CPatAlias(_, _, _, _, _) =>
      List()
  end

// the lints of expr, where the parser places each construct that a lint rewrites, at its keyword or form, by EAt
function expr_lints(fun: Id, expr: Expr): List[Lint] :=
  match expr
    case EAt(pos, inner) =>
      placed_lints(fun, pos, inner) ++ expr_lints(fun, inner)

    case ELit(_) =>
      List()

    case EVar(_) =>
      List()

    case EApp(f, args) =>
      expr_lints(fun, f) ++ exprs_lints(fun, args)

    case EField(base, _) =>
      expr_lints(fun, base)

    case EUpdate(base, _, value) =>
      expr_lints(fun, base) ++ expr_lints(fun, value)

    case ELam(_, body) =>
      expr_lints(fun, body)

    case EProc(_, _, _, stmt) =>
      stmt_lints(fun, stmt)

    case ELet(bindings, body) =>
      exprs_lints(fun, List(for (_, e) in bindings yield e)) ++ expr_lints(fun, body)

    case EIte(cond, then_expr, else_expr) =>
      exprs_lints(fun, List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      expr_lints(fun, arg) ++ List(for br in cases for l in option_lints(fun, br.guard) ++ expr_lints(fun, br.body) yield l)

    case ETuple(args) =>
      exprs_lints(fun, args)

    case EForm(_, elems, rest) =>
      List(for y in elems for l in yield_lints(fun, y) yield l) ++ option_lints(fun, rest)

    case EFor(_, gens, elem, rest) =>
      gens_lints(fun, gens) ++ yield_lints(fun, elem) ++ option_lints(fun, rest)
  end

function exprs_lints(fun: Id, exprs: List[Expr]): List[Lint] :=
  List(for e in exprs for l in expr_lints(fun, e) yield l)

function option_lints(fun: Id, guard: Option[Expr]): List[Lint] :=
  List(for e in guard for l in expr_lints(fun, e) yield l)

function yield_lints(fun: Id, elem: Yield): List[Lint] :=
  match elem
    case YVal(value) =>
      expr_lints(fun, value)
    case YPair(key, value) =>
      expr_lints(fun, key) ++ expr_lints(fun, value)
  end

function gens_lints(fun: Id, gens: List[Gen]): List[Lint] :=
  List(for g in gens for l in gen_lints(fun, g) yield l)

function gen_lints(fun: Id, g: Gen): List[Lint] :=
  match g
    case GVal(_, over) =>
      iterated_list(over) ++ expr_lints(fun, over)

    case GPair(_, _, over) =>
      expr_lints(fun, over)

    case GIf(cond) =>
      expr_lints(fun, cond)
  end

function stmt_lints(fun: Id, stmt: Stmt): List[Lint] :=
  match stmt
    case SSkip =>
      List()

    case SAssign(upd) =>
      exprs_lints(fun, List(for (_, e) in upd yield e))

    case SBlock(_, stmts) =>
      List(for s in stmts for l in stmt_lints(fun, s) yield l)

    case SIf(cond, left, right) =>
      expr_lints(fun, cond) ++ stmt_lints(fun, left) ++ stmt_lints(fun, right)

    case SWhile(cond, body) =>
      expr_lints(fun, cond) ++ stmt_lints(fun, body)

    case SCall(_, ins, _, _) =>
      exprs_lints(fun, ins)

    case SMatch(arg, cases) =>
      expr_lints(fun, arg) ++ List(for br in cases for l in option_lints(fun, br.guard) ++ stmt_lints(fun, br.body) yield l)

    case SAssert(cond) =>
      expr_lints(fun, cond)

    case SAssertRaises(_, _, body) =>
      stmt_lints(fun, body)

    case SRaise(value, _) =>
      expr_lints(fun, value)

    case STry(body, catches) =>
      stmt_lints(fun, body) ++ List(for c in catches for l in option_lints(fun, c.guard) ++ stmt_lints(fun, c.body) yield l)

    case SFor(gens, body) =>
      gens_lints(fun, gens) ++ stmt_lints(fun, body)

    case SAt(_, inner) =>
      stmt_lints(fun, inner)
  end

// the lints of the construct expr at pos, which its parts do not include
function placed_lints(fun: Id, pos: Pos, expr: Expr): List[Lint] :=
  match expr
    case EIte(cond, ELit(LBool(true)), ELit(LBool(false))) =>
      List(Lint(pos, "an if of true and false is its condition", cond))

    case EIte(cond, ELit(LBool(false)), ELit(LBool(true))) if fun != "not" =>
      List(
        Lint(pos, "an if of false and true is not of its condition", EApp(expr_var("not"), List(cond))))

    case EMatch(arg, cases) if fun != "value_or" =>
      match option_default(cases)
        case Some(d) =>
          List(
            Lint(pos, "a match that gives the value of an option, or else a default, is value_or", EApp(expr_var("value_or"), List(arg, d))))

        case None =>
          List()
      end

    case _ =>
      List()
  end

// a list that a generator iterates, which is the elements of its container in the order of its fold, as the generator
// takes them from the container itself, where a map gives its pairs to a single pattern
function iterated_list(over: Expr): List[Lint] :=
  match over
    case EAt(pos, EFor(FList, List(g), elem, None)) if is_identity(g, elem) =>
      List(
        Lint(pos, "a list that is only iterated, of the elements of a container, is that container", gen_over(g)))

    case _ =>
      List()
  end

// whether elem is what the single generator g yields without yield
function is_identity(g: Gen, elem: Yield): Bool :=
  match implicit_elem(FList, List(g))
    case Some(implicit) =>
      strip_expr(EFor(FList, List(g), implicit, None)) == strip_expr(EFor(FList, List(g), elem, None))
    case None =>
      false
  end

function gen_over(g: Gen): Expr :=
  match g
    case GVal(_, over) =>
      over

    case GPair(_, _, over) =>
      over

    case GIf(cond) =>
      cond
  end

// the default d of cases Some(x) => x and None => d, in either order, without guards, where d is a plain value, so that
// value_or, which takes d evaluated, computes nothing that the match would not
function option_default(cases: List[Branch[Expr]]): Option[Expr] :=
  match cases
    case List(Branch(_, some, None, x), Branch(_, none, None, d)) if is_some_of(some, x) and is_none(none) and is_plain(d) =>
      Some(d)

    case List(Branch(_, none, None, d), Branch(_, some, None, x)) if is_some_of(some, x) and is_none(none) and is_plain(d) =>
      Some(d)

    case _ =>
      None
  end

// whether pat is Some(x) and body the variable x
function is_some_of(pat: Pat, body: Expr): Bool :=
  match (strip_pat(pat), strip_expr(body))
    case (PApp(Name(None, "Some"), List(PVar(v))), EVar(w)) =>
      v.name == w.name
    case _ =>
      false
  end

// whether pat is None, bare, as a variable that the checker resolves, or with ()
function is_none(pat: Pat): Bool :=
  match strip_pat(pat)
    case PVar(v) =>
      v.name == Name(None, "None")
    case p =>
      p == PApp(Name(None, "None"), List())
  end

// whether expr is a literal, a variable, or a tuple or constructor of plain values, which evaluates without calling a function
function is_plain(expr: Expr): Bool :=
  match strip_expr(expr)
    case ELit(_) =>
      true

    case EVar(_) =>
      true

    case ETuple(args) =>
      forall(args, is_plain)

    case EApp(EVar(v), args) =>
      v.name.module == None and is_capitalized(v.name.base) and forall(args, is_plain)

    case _ =>
      false
  end

function is_capitalized(name: Id): Bool :=
  size(name) > 0 and ord(at(0, name)) >= ord('A') and ord(at(0, name)) <= ord('Z')
