// the parser of ulang, which parses the tokens of ulang/lex.u into programs of ulang/syntax.u,
// where notation apply to the commands after them, and imports load the packages of directories of the project

export

data ParseError :=
  case ParseError(message: Str, pos: Pos)
  // an error of an imported module at its position in that module
  case ImportError(module: Id, message: Str, pos: Pos)

// the modules of the file at path, in load order, each after the modules it imports, with the module of the file last,
// where a module of a project is known by its path from the root without .u, the root being the nearest directory above
// it with project.u, else its own directory, and a module name.u of the library as prelude/name; loading a module loads
// its package, the files with sections of its directory, whose members see each other's exports and notations, and a
// file without sections, a program, sees those of the package of its directory; import "p" loads the package of the
// directory p from the root, whose exports and notations the importing file sees, packages do not import each other
// cyclically, and implicit imports are the library
procedure parse_file(in path: Str, out source: Source)

procedure parse_file_text(in path: Str, text: Str, out source: Source)

// whether path names a source file, name.u with a name
function is_source(path: Str): Bool

implementation

function type_ops(): Ops[List[Type]] :=
  Ops("type", starts_type, parse_type_atom, type_apply)

function expr_ops(): Ops[Expr] :=
  Ops("expression", starts_expr, parse_app, lambda in f, op, pos, args, out expr =>
    assign expr := expr_apply(f, op, pos, args)
  end)

function pat_ops(): Ops[Pat] :=
  Ops("pattern", starts_pattern, parse_pattern_atom, lambda in f, op, pos, args, out pat =>
    assign pat := pat_apply(f, op, pos, args)
  end)

// an operator of the notation cmds that already has a notation of the same kind
function duplicate(notation: Notation, cmds: List[Cmd]): Option[Id] :=
  find_map(cmds, lambda cmd => duplicate_op(notation, cmd))

function duplicate_op(notation: Notation, cmd: Cmd): Option[Id] :=
  match cmd
    case CNotation(fixity, _, ops) =>
      find(ops, lambda op => notation_of(notation, fixity, op) != None)
    case _ =>
      None
  end

function redeclared_fixed(notation: Notation, imported: Notation): List[Id] :=
  redeclared_postfix(notation, imported) ++ redeclared_infix(notation, imported)

function redeclared_prefix(notation: Notation, imported: Notation): List[Id] :=
  List(for op => prec in imported.prefix_ops if differs(prefix_prec(notation, op), prec) yield op)

function redeclared_postfix(notation: Notation, imported: Notation): List[Id] :=
  List(for op => prec in imported.postfix_ops if differs(postfix_prec(notation, op), prec) yield op)

function redeclared_infix(notation: Notation, imported: Notation): List[Id] :=
  List(for op => fp in imported.infix_ops if differs(infix_of(notation, op), fp) yield op)

// an operator of the notation of an imported module with another notation of the same kind, where imports may repeat a
// notation as it is
function redeclared(notation: Notation, imported: Notation): Option[Id] :=
  match redeclared_prefix(notation, imported) ++ redeclared_fixed(notation, imported)
    case List(op; _) =>
      Some(op)
    case List() =>
      None
  end

function differs[A](old: Option[A], a: A): Bool :=
  old != None and old != Some(a)

procedure check_duplicates(in notation: Notation, cmds: List[Cmd], pos: Pos) :=
  match duplicate(notation, cmds)
    case Some(op) =>
      raise ParseError("operator " ++ op ++ " is already declared", pos)
    case None =>
      skip
  end

procedure check_imported(in notation: Notation, imported: Notation, pos: Pos) :=
  match redeclared(notation, imported)
    case Some(op) =>
      raise ParseError("imported operator " ++ op ++ " is declared differently", pos)
    case None =>
      skip
  end

function head_token(toks: Tokens): Token :=
  match toks
    case List((_, tok); _) =>
      tok
    case _ =>
      TEnd
  end

// the comment at the start of the tokens, if it documents the module: a blank line, an import, export, or the end follows it
function module_doc(toks: Tokens): Option[Str] :=
  match toks
    case List((Pos(line, _), TDoc(text)), (Pos(next, _), tok); _) =>
      if documents_module(text, line, next, tok) then Some(text) else None
    case _ =>
      None
  end

function documents_module(text: Str, line: Int, next: Int, tok: Token): Bool :=
  next != line + size(split(text, '\n')) or tok == TKw("import") or tok == TKw("export") or tok == TEnd

function second_token(toks: Tokens): Token :=
  match toks
    case List(_, (_, tok); _) =>
      tok
    case _ =>
      TEnd
  end

function head_pos(toks: Tokens): Pos :=
  match toks
    case List((p, _); _) =>
      p
    case _ =>
      Pos(0, 0)
  end

function at_kw(toks: Tokens, w: Str): Bool :=
  head_token(toks) == TKw(w)

function at_doc(toks: Tokens): Bool :=
  match head_token(toks)
    case TDoc(_) =>
      true
    case _ =>
      false
  end

// a case, which a comment may document
function at_case(toks: Tokens): Bool :=
  at_kw(toks, "case") or at_doc(toks) and second_token(toks) == TKw("case")

function at_comma(toks: Tokens): Bool :=
  at_kw(toks, ",")

function at_mode(toks: Tokens): Bool :=
  at_kw(toks, "in") or at_kw(toks, "out") or at_kw(toks, "ref")

// a comma before another update
function at_update(toks: Tokens): Bool :=
  match toks
    case List((_, TKw(",")), (_, TName(_)), (_, TKw(":=")); _) =>
      true
    case _ =>
      false
  end

function format_token(tok: Token): Str :=
  match tok
    case TName(name) =>
      name

    case TOp(op) =>
      op

    case TKw(kw) =>
      kw

    case TNum(num) =>
      show(num)

    case TStr(text) =>
      quote(text)

    case TChar(char) =>
      "'" ++ str(List(char)) ++ "'"

    case TDoc(_) =>
      "a comment"

    case TEnd =>
      "end of input"
  end

// the error that what is expected but the next token is found, where a keyword is not a name
function expected(what: Str, toks: Tokens): ParseError :=
  match head_token(toks)
    case TKw(kw) if is_keyword(kw) and (what == "name" or what == "pattern") =>
      ParseError("keyword " ++ kw ++ " is not a name", head_pos(toks))
    case tok =>
      ParseError(what ++ " expected but " ++ format_token(tok) ++ " found", head_pos(toks))
  end

function literal_at(toks: Tokens): Option[Lit] :=
  match head_token(toks)
    case TKw("true") =>
      Some(LBool(true))

    case TKw("false") =>
      Some(LBool(false))

    case TNum(num) =>
      Some(LInt(num))

    case TStr(text) =>
      Some(LStr(text))

    case TChar(char) =>
      Some(LChar(char))

    case _ =>
      None
  end

// an operator, or a name that the notation in effect declares as one
function operator_at(notation: Notation, toks: Tokens): Option[Id] :=
  match head_token(toks)
    case TOp(op) =>
      Some(op)

    case TName(name) if is_operator(notation, name) =>
      Some(name)

    case _ =>
      None
  end

procedure advance(ref toks: Tokens) :=
  match toks
    case List(_; more) =>
      assign toks := more
    case _ =>
      skip
  end

procedure expect(in tok: Token, ref toks: Tokens) :=
  if head_token(toks) == tok then
    call advance(ref toks)
  else
    raise expected(format_token(tok), toks)
  end

procedure parse_name(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TName(m) =>
      assign name := m
      call   advance(ref toks)

    case _ =>
      raise expected("name", toks)
  end

// the package of import "p", the path of its directory from the root of the project, where names have letters, digits,
// and _, also keywords, and are separated by /
procedure parse_import(out name: Id, ref toks: Tokens) :=
  local pos := head_pos(toks)
  match head_token(toks)
    case TStr(path) if is_source(path) =>
      raise ParseError("an import names the directory of a package, not a file", pos)

    case TStr(path) if is_package_path(path) =>
      assign name := path
      call   advance(ref toks)

    case TStr(_) =>
      raise ParseError("an import names a package by its path from the root, of names of letters, digits, and _ only", pos)

    case _ =>
      raise expected("package", toks)
  end

function is_package_path(path: Str): Bool :=
  forall(split(path, '/'), lambda name => size(name) > 0 and is_module_name(name))

function is_module_name(name: Str): Bool :=
  forall(chars(name), lambda c => is_letter(c) or is_digit(c) or c == '_')

// a name that is not declared as an operator
procedure parse_plain_name(
  in  notation: Notation,
      params: List[Id],
  out name: Id,
  ref toks: Tokens
) :=
  match head_token(toks)
    case TName(m) if is_operator(notation, m) =>
      raise ParseError("operator " ++ m ++ " is not a name", head_pos(toks))
    case _ =>
      call parse_name(out name, ref toks)
  end

procedure parse_name_or_op(out name: Id, ref toks: Tokens) :=
  match head_token(toks)
    case TOp(op) =>
      assign name := op
      call   advance(ref toks)

    case _ =>
      call parse_name(out name, ref toks)
  end

// items, at least one, separated by the tokens that more finds
procedure parse_separated[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, found: Buffer[A] := empty()
  call   item(in notation, params, out x, ref toks)
  assign found := found ++ List(x)
  while more(toks) do
    call   advance(ref toks)
    call   item(in notation, params, out x, ref toks)
    assign found := found ++ List(x)
  end
  assign xs := List(for y in found)

// items, at least one, without separators, as long as more holds
procedure parse_repeated[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
      more: Tokens -> Bool,
  out xs: List[A],
  ref toks: Tokens
) :=
  local x: A, found: Buffer[A] := empty()
  call   item(in notation, params, out x, ref toks)
  assign found := found ++ List(x)
  while more(toks) do
    call   item(in notation, params, out x, ref toks)
    assign found := found ++ List(x)
  end
  assign xs := List(for y in found)

// items separated by commas until close, which may be empty
procedure parse_enclosed[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
      close: Str,
  out xs: List[A],
  ref toks: Tokens
) :=
  if at_kw(toks, close) then
    assign xs := List()
  else
    call parse_separated(in notation, params, item, at_comma, out xs, ref toks)
  end
  call expect(in TKw(close), ref toks)

// an item after tok, if tok is next
procedure parse_optional[A](
  in  notation: Notation,
      params: List[Id],
      tok: Token,
      item: (in Notation, List[Id], out A, ref Tokens),
  out x: Option[A],
  ref toks: Tokens
) :=
  local a: A
  if head_token(toks) == tok then
    call   advance(ref toks)
    call   item(in notation, params, out a, ref toks)
    assign x := Some(a)
  else
    assign x := None
  end

// the items a, b of a display [a, b], and the rest c of [a, b; c], read with brackets
procedure parse_display[A](
  in  notation: Notation,
      params: List[Id],
      item: (in Notation, List[Id], out A, ref Tokens),
  out items: List[A],
      rest: Option[A],
  ref toks: Tokens
) :=
  call parse_separated(in notation, params, item, at_comma, out items, ref toks)
  call parse_optional(in notation, params, TKw(";"), item, out rest, ref toks)

// the items in front of rest by cons, as displays build lists
function cons_all[A](cons: (A, A) -> A, items: List[A], rest: A): A :=
  match items
    case List() =>
      rest
    case List(a; more) =>
      cons(a, cons_all(cons, more, rest))
  end

type Operand[A] :=
  (in Notation, List[Id], out A, ref Tokens)

// an operator applied to its operands, which raises a ParseError if they do not fit
type Apply[A] :=
  (in Fixity, Id, Pos, List[A], out A)

// precedence climbing over the tokens, as Mixfix of easyparse in cuvee, where prefix operators bind their operand
// with their own precedence, and a left associative operator is applied to all operands of a chain at once
data Ops[A] :=
  case Ops(what: Str, starts: (Notation, Token) -> Bool, operand: Operand[A], apply: Apply[A])

// operands and operators, where an operator that cannot be applied is an error
procedure parse_operators[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
  out a: A,
  ref toks: Tokens
) :=
  call climb(in notation, params, ops, 0, out a, ref toks)
  match operator_at(notation, toks)
    case Some(op) =>
      raise ParseError("unexpected operator " ++ op, head_pos(toks))
    case None =>
      skip
  end

// an operand and the operators after it of precedence min or above
procedure climb[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      min: Int,
  out a: A,
  ref toks: Tokens
) :=
  local lhs: A
  call climb_operand(in notation, params, ops, out lhs, ref toks)
  call climb_rest(in notation, params, ops, min, lhs, out a, ref toks)

// an operand, or a prefix operator applied to an operand
procedure climb_operand[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
  out a: A,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), operand := ops.operand, apply := ops.apply
  match operator_at(notation, toks)
    case Some(op) =>
      local b: A
      match prefix_prec(notation, op)
        case Some(prec) =>
          call advance(ref toks)
          call climb(in notation, params, ops, prec, out b, ref toks)
          call apply(in FPrefix, op, pos, List(b), out a)

        case None if is_operator(notation, op) =>
          raise ParseError(op ++ " is not a prefix operator", pos)

        case None =>
          raise ParseError("undeclared operator " ++ op, pos)
      end

    case None if ops.starts(notation, head_token(toks)) =>
      call operand(in notation, params, out a, ref toks)

    case None =>
      raise expected(ops.what, toks)
  end

// lhs and the operators after it of precedence min or above
procedure climb_rest[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      min: Int,
      lhs: A,
  out a: A,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), apply := ops.apply
  match operator_at(notation, toks)
    case Some(op) =>
      local args: List[A], b: A
      match (postfix_prec(notation, op), infix_of(notation, op))
        case (Some(prec), _) if prec >= min =>
          call advance(ref toks)
          call apply(in FPostfix, op, pos, List(lhs), out b)
          call climb_rest(in notation, params, ops, min, b, out a, ref toks)

        case (_, Some((f, prec))) if prec >= min =>
          call advance(ref toks)
          call climb_infix(in notation, params, ops, op, f, prec, out args, ref toks)
          call apply(in f, op, pos, List(lhs; args), out b)
          call climb_rest(in notation, params, ops, min, b, out a, ref toks)

        case _ if not is_operator(notation, op) =>
          raise ParseError("undeclared operator " ++ op, pos)

        case _ =>
          assign a := lhs
      end

    case None =>
      assign a := lhs
  end

// the operands after the infix operator op, where a right associative op takes the operators of its own precedence,
// a left associative op takes further operands after more occurrences of op, and a non-associative op only one
procedure climb_infix[A](
  in  notation: Notation,
      params: List[Id],
      ops: Ops[A],
      op: Id,
      f: Fixity,
      prec: Int,
  out args: List[A],
  ref toks: Tokens
) :=
  local next := (if f == FRight then prec else prec + 1)
  call parse_separated(in notation, params, lambda in ns, ps, out b, ref ts =>
    call climb(in ns, ps, ops, next, out b, ref ts)
  end, lambda ts => f == FLeft and operator_at(notation, ts) == Some(op), out args, ref toks)
  match operator_at(notation, toks)
    case Some(other) if f == FInfix and is_prec(infix_of(notation, other), prec) =>
      raise ParseError("operator " ++ op ++ " is not associative", head_pos(toks))
    case _ =>
      skip
  end

function is_prec(fp: Option[Fixity * Int], prec: Int): Bool :=
  match fp
    case Some((_, q)) =>
      q == prec
    case _ =>
      false
  end

// types, whose operands are lists of types, since the arguments of a function are written (A, B),
// and where a chain A * B * C is one tuple type, while (A * B) * C stays nested
//
// the type of an operand, which is a list of other than one type only as the arguments of a function
procedure as_type(in types: List[Type], pos: Pos, out typ: Type) :=
  match types
    case List(t) =>
      assign typ := t

    case List() =>
      assign typ := TTuple(List())

    case _ =>
      raise ParseError("tuple types are written A * B", pos)
  end

procedure as_types(in args: List[List[Type]], pos: Pos, out types: List[Type]) :=
  assign types := List()
  for a in args do
    local typ: Type
    call   as_type(in a, pos, out typ)
    assign types := types ++ List(typ)
  end

// a chain of -> or another infix operator applied from the left, where the first operand of -> is the list of
// arguments of a function
procedure type_apply(
  in  f: Fixity,
      op: Id,
      pos: Pos,
      args: List[List[Type]],
  out r: List[Type]
) :=
  match args
    case List(a) =>
      local typ: Type
      call   as_type(in a, pos, out typ)
      assign r := List(TSort(unqualified(op), List(typ)))

    case _ if op == "*" =>
      local types: List[Type]
      call   as_types(in args, pos, out types)
      assign r := List(TTuple(types))

    case List(a; more) if op == "->" =>
      local types: List[Type]
      call   as_types(in more, pos, out types)
      assign r := foldl(types, a, lambda lhs, typ => List(TFun(lhs, typ)))

    case List(a; more) =>
      local first: Type, types: List[Type]
      call   as_type(in a, pos, out first)
      call   as_types(in more, pos, out types)
      assign r := List(
        foldl(types, first, lambda lhs, typ => TSort(unqualified(op), List(lhs, typ))))

    case List() =>
      assign r := List()
  end

function starts_type(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) =>
      not is_operator(notation, name)

    case TKw("(") =>
      true

    case _ =>
      false
  end

procedure parse_type(
  in  notation: Notation,
      params: List[Id],
  out typ: Type,
  ref toks: Tokens
) :=
  local start := head_pos(toks), r: List[Type]
  call parse_operators(in notation, params, type_ops(), out r, ref toks)
  call as_type(in r, start, out typ)

// a type, a type in parentheses, the arguments (A, B) of a function, or (), where params are the type parameters in scope,
// which distinguish TParam from TSort
procedure parse_type_atom(
  in  notation: Notation,
      params: List[Id],
  out r: List[Type],
  ref toks: Tokens
) :=
  if at_kw(toks, "(") and contains(second_token(toks), List(TKw("in"), TKw("out"), TKw("ref"))) then
    local ins: List[Type], outs: List[Type], refs: List[Type]
    call   advance(ref toks)
    call   parse_sections(in notation, params, parse_type, parse_type, out ins, outs, refs, ref toks)
    call   expect(in TKw(")"), ref toks)
    assign r := List(TProc(ins, outs, refs))
  else
    if at_kw(toks, "(") then
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_type, ")", out r, ref toks)
    else
      local name: Id, args: List[Type]
      call parse_plain_name(in notation, params, out name, ref toks)
      if at_kw(toks, "[") then
        call   advance(ref toks)
        call   parse_separated(in notation, params, parse_type, at_comma, out args, ref toks)
        call   expect(in TKw("]"), ref toks)
        assign r := List(TSort(unqualified(name), args))
      else
        if contains(name, params) then
          assign r := List(TParam(name))
        else
          assign r := List(TSort(unqualified(name), List()))
        end
      end
    end
  end

// -n for a number n is the negative literal, in patterns and expressions, and otherwise an operator is applied
function expr_apply(f: Fixity, op: Id, pos: Pos, args: List[Expr]): Expr :=
  match args
    case List(ELit(LInt(num))) if f == FPrefix and op == "-" =>
      ELit(LInt(0 - num))

    case List(a) =>
      expr_app(op, List(a))

    case List(a; more) =>
      expr_infix(op, a, more)

    case List() =>
      expr_app(op, List())
  end

// lhs and the operands rs, applied from the left
function expr_infix(op: Id, lhs: Expr, rs: List[Expr]): Expr :=
  match rs
    case List() =>
      lhs
    case List(r; more) =>
      expr_infix(op, expr_app(op, List(lhs, r)), more)
  end

function starts_expr(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) =>
      not is_operator(notation, name)

    case TKw(kw) =>
      contains(kw, List("let", "if", "lambda", "match", "true", "false", "("))

    case TNum(_) =>
      true

    case TStr(_) =>
      true

    case TChar(_) =>
      true

    case _ =>
      false
  end

procedure parse_expr(
  in  notation: Notation,
      params: List[Id],
  out expr: Expr,
  ref toks: Tokens
) :=
  local updates: List[Id * Expr]
  call parse_operators(in notation, params, expr_ops(), out expr, ref toks)
  if at_kw(toks, "with") then
    call   advance(ref toks)
    call   parse_separated(in notation, params, parse_update, at_update, out updates, ref toks)
    assign expr := apply_updates(expr, updates)
  end

// f := a in e with f := a
procedure parse_update(
  in  notation: Notation,
      params: List[Id],
  out update: Id * Expr,
  ref toks: Tokens
) :=
  local f: Id, a: Expr
  call   parse_name(out f, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_operators(in notation, params, expr_ops(), out a, ref toks)
  assign update := (f, a)

// e with the updates in order, from the left
function apply_updates(expr: Expr, updates: List[Id * Expr]): Expr :=
  match updates
    case List() =>
      expr
    case List((f, a); more) =>
      apply_updates(EUpdate(expr, f, a), more)
  end

// f(x) and e.f
procedure parse_app(
  in  notation: Notation,
      params: List[Id],
  out expr: Expr,
  ref toks: Tokens
) :=
  local args: List[Expr], f: Id
  call parse_expr_atom(in notation, params, out expr, ref toks)
  while at_kw(toks, "(") or at_kw(toks, ".") do
    if at_kw(toks, "(") then
      call   advance(ref toks)
      call   parse_enclosed(in notation, params, parse_expr, ")", out args, ref toks)
      assign expr := EApp(expr, args)
    else
      call   advance(ref toks)
      call   parse_name(out f, ref toks)
      assign expr := EField(expr, f)
    end
  end

procedure parse_expr_atom(
  in  notation: Notation,
      params: List[Id],
  out expr: Expr,
  ref toks: Tokens
) :=
  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign expr := ELit(v)

    case (_, TKw("let")) =>
      call parse_let(in notation, params, out expr, ref toks)

    case (_, TKw("if")) =>
      local a: Expr, l: Expr, r: Expr
      call   advance(ref toks)
      call   parse_expr(in notation, params, out a, ref toks)
      call   expect(in TKw("then"), ref toks)
      call   parse_expr(in notation, params, out l, ref toks)
      call   expect(in TKw("else"), ref toks)
      call   parse_expr(in notation, params, out r, ref toks)
      assign expr := EIte(a, l, r)

    case (_, TKw("lambda")) =>
      call parse_lambda(in notation, params, out expr, ref toks)

    case (_, TKw("match")) =>
      local a: Expr, cases: List[Branch[Expr]]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out a, ref toks)
      call   parse_cases(in notation, params, parse_expr, out cases, ref toks)
      assign expr := EMatch(a, cases)

    case (_, TKw("(")) =>
      local exprs: List[Expr]
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_expr, ")", out exprs, ref toks)
      match exprs
        case List(inner) =>
          assign expr := inner
        case _ =>
          assign expr := ETuple(exprs)
      end

    case _ if form_at(toks) != None =>
      call parse_form(in notation, params, out expr, ref toks)

    case (_, TName(name)) if form_of(name) != None =>
      raise no_value(name, head_pos(toks))

    case (_, TName(name)) if not is_operator(notation, name) =>
      call   advance(ref toks)
      assign expr := expr_var(name)

    case _ =>
      raise expected("expression", toks)
  end

// let p := e, q := f in body binds in parallel
procedure parse_let(
  in  notation: Notation,
      params: List[Id],
  out expr: Expr,
  ref toks: Tokens
) :=
  local bindings: List[Pat * Expr], body: Expr
  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_binding, at_comma, out bindings, ref toks)
  call   expect(in TKw("in"), ref toks)
  call   parse_expr(in notation, params, out body, ref toks)
  assign expr := ELet(bindings, body)

// p := e
procedure parse_binding(
  in  notation: Notation,
      params: List[Id],
  out binding: Pat * Expr,
  ref toks: Tokens
) :=
  local pat: Pat, expr: Expr
  call   parse_pattern(in notation, params, out pat, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_expr(in notation, params, out expr, ref toks)
  assign binding := (pat, expr)

// lambda x, y => e is a function, and lambda in x, out y, ref z => body end a procedure, told apart by the modes, where
// the formals of a function may be patterns, which it matches as let does
procedure parse_lambda(
  in  notation: Notation,
      params: List[Id],
  out expr: Expr,
  ref toks: Tokens
) :=
  call advance(ref toks)
  if at_mode(toks) then
    local ins: List[Var], outs: List[Var], refs: List[Var], body: Stmt
    call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   parse_body(in notation, params, out body, ref toks)
    call   expect(in TKw("end"), ref toks)
    assign expr := EProc(ins, outs, refs, body)
  else
    local inner: Expr
    if head_token(toks) == TKw("=>") then
      call   expect(in TKw("=>"), ref toks)
      call   parse_expr(in notation, params, out inner, ref toks)
      assign expr := ELam(List(), inner)
    else
      local pats: List[Pat]
      call   parse_separated(in notation, params, parse_pattern, at_comma, out pats, ref toks)
      call   expect(in TKw("=>"), ref toks)
      call   parse_expr(in notation, params, out inner, ref toks)
      assign expr := match pattern_vars(pats)
        case Some(xs) =>
          ELam(xs, inner)
        case None =>
          lambda_patterns(pats, inner)
      end
    end
  end

// the form that starts the tokens, List(…) and the like, where a name of a form is one only before (, and else names a type
function form_at(toks: Tokens): Option[Form] :=
  match (head_token(toks), second_token(toks))
    case (TName(name), TKw("(")) =>
      form_of(name)
    case _ =>
      None
  end

// the names of the forms are no values, so that no declaration takes them and no expression names one alone
procedure check_value_name(in name: Id, pos: Pos) :=
  if form_of(name) != None then
    raise no_value(name, pos)
  end

function no_value(name: Id, pos: Pos): ParseError :=
  ParseError(name ++ "(…) is a form, which is no value", pos)

function form_of(name: Str): Option[Form] :=
  match name
    case "List" =>
      Some(FList)

    case "Set" =>
      Some(FSet)

    case "Map" =>
      Some(FMap)

    case "Array" =>
      Some(FArray)

    case _ =>
      None
  end

function no_yield(pos: Pos): ParseError :=
  ParseError("yield is needed after several generators, or after a generator whose pattern is no value", pos)

// List(a, b; r), with the container r that the elements are added to, List(for gens yield e; r), and List(), where map takes
// entries k => v, and arrays have no rest
procedure parse_form(
  in  notation: Notation,
      params: List[Id],
  out expr: Expr,
  ref toks: Tokens
) :=
  local form := value_or(form_at(toks), FList), pos := head_pos(toks), elems: List[Yield], rest: Option[Expr], gens: List[Gen], elem: Yield
  call advance(ref toks)
  call expect(in TKw("("), ref toks)
  if at_kw(toks, "for") then
    call parse_gens(in notation, params, out gens, ref toks)
    if at_kw(toks, "yield") then
      call advance(ref toks)
      call parse_elem(in notation, params, form, out elem, ref toks)
    else
      match implicit_elem(form, gens)
        case Some(e) =>
          assign elem := e
        case None =>
          raise no_yield(pos)
      end
    end
    call   parse_optional(in notation, params, TKw(";"), parse_expr, out rest, ref toks)
    assign expr := EFor(form, gens, elem, rest)
  else
    if at_kw(toks, ")") then
      assign elems := List(), rest := None
    else
      call parse_separated(in notation, params, lambda in n, ps, out e, ref ts =>
        call parse_elem(in n, ps, form, out e, ref ts)
      end, at_comma, out elems, ref toks)
      call parse_optional(in notation, params, TKw(";"), parse_expr, out rest, ref toks)
    end
    assign expr := EForm(form, elems, rest)
  end
  if form == FArray and rest != None then
    raise ParseError("arrays have no rest", pos)
  end
  call expect(in TKw(")"), ref toks)

// an element e, or an entry k => v of a map
procedure parse_elem(
  in  notation: Notation,
      params: List[Id],
      form: Form,
  out elem: Yield,
  ref toks: Tokens
) :=
  local k: Expr, v: Expr
  call parse_expr(in notation, params, out k, ref toks)
  if form == FMap then
    call   expect(in TKw("=>"), ref toks)
    call   parse_expr(in notation, params, out v, ref toks)
    assign elem := YPair(k, v)
  else
    assign elem := YVal(k)
  end

// generators for p in c and for k => v in m, and guards if q, from left to right, starting with a generator
procedure parse_gens(
  in  notation: Notation,
      params: List[Id],
  out gens: List[Gen],
  ref toks: Tokens
) :=
  local found: Buffer[Gen] := empty(), p: Pat, v: Pat, c: Expr
  while at_kw(toks, "for") or size(found) > 0 and at_kw(toks, "if") do
    if at_kw(toks, "for") then
      call advance(ref toks)
      call parse_pattern(in notation, params, out p, ref toks)
      if at_kw(toks, "=>") then
        call   advance(ref toks)
        call   parse_pattern(in notation, params, out v, ref toks)
        call   expect(in TKw("in"), ref toks)
        call   parse_expr(in notation, params, out c, ref toks)
        assign found := found ++ List(GPair(p, v, c))
      else
        call   expect(in TKw("in"), ref toks)
        call   parse_expr(in notation, params, out c, ref toks)
        assign found := found ++ List(GVal(p, c))
      end
    else
      call   advance(ref toks)
      call   parse_expr(in notation, params, out c, ref toks)
      assign found := found ++ List(GIf(c))
    end
  end
  assign gens := List(for g in found)

// the comment before a case, or "" if there is none
procedure parse_doc(out doc: Str, ref toks: Tokens) :=
  match head_token(toks)
    case TDoc(text) =>
      assign doc := text
      call   advance(ref toks)

    case _ =>
      assign doc := ""
  end

// case p if g => b, up to end
procedure parse_cases[B](
  in  notation: Notation,
      params: List[Id],
      body: (in Notation, List[Id], out B, ref Tokens),
  out cases: List[Branch[B]],
  ref toks: Tokens
) :=
  local found: Buffer[Branch[B]] := empty(), pat: Pat, g: Option[Expr], b: B, doc: Str
  while at_case(toks) do
    call   parse_doc(out doc, ref toks)
    call   advance(ref toks)
    call   parse_pattern(in notation, params, out pat, ref toks)
    call   parse_optional(in notation, params, TKw("if"), parse_expr, out g, ref toks)
    call   expect(in TKw("=>"), ref toks)
    call   body(in notation, params, out b, ref toks)
    assign found := found ++ List(Branch(doc, pat, g, b))
  end
  call   expect(in TKw("end"), ref toks)
  assign cases := List(for c in found)

// patterns, where operators are constructors
function pat_apply(f: Fixity, op: Id, pos: Pos, args: List[Pat]): Pat :=
  match args
    case List(PLit(LInt(num))) if f == FPrefix and op == "-" =>
      PLit(LInt(0 - num))

    case List(pat) =>
      PApp(unqualified(op), List(pat))

    case List(pat; more) =>
      pat_infix(op, pat, more)

    case List() =>
      PApp(unqualified(op), List())
  end

// lhs and the operands rs, applied from the left
function pat_infix(op: Id, lhs: Pat, rs: List[Pat]): Pat :=
  match rs
    case List() =>
      lhs
    case List(r; more) =>
      pat_infix(op, PApp(unqualified(op), List(lhs, r)), more)
  end

function pat_cons(a: Pat, b: Pat): Pat :=
  PApp(unqualified("Cons"), List(a, b))

function pat_nil(): Pat :=
  PApp(unqualified("Nil"), List())

function starts_pattern(notation: Notation, tok: Token): Bool :=
  match tok
    case TName(name) =>
      not is_operator(notation, name)

    case TKw(kw) =>
      contains(kw, List("_", "true", "false", "("))

    case TNum(_) =>
      true

    case TStr(_) =>
      true

    case TChar(_) =>
      true

    case _ =>
      false
  end

procedure parse_pattern(
  in  notation: Notation,
      params: List[Id],
  out pat: Pat,
  ref toks: Tokens
) :=
  call parse_operators(in notation, params, pat_ops(), out pat, ref toks)

procedure parse_pattern_atom(
  in  notation: Notation,
      params: List[Id],
  out pat: Pat,
  ref toks: Tokens
) :=
  match (literal_at(toks), head_token(toks))
    case (Some(v), _) =>
      call   advance(ref toks)
      assign pat := PLit(v)

    case (_, TKw("_")) =>
      call   advance(ref toks)
      assign pat := PWild

    case (_, TKw("(")) =>
      local pats: List[Pat]
      call advance(ref toks)
      call parse_enclosed(in notation, params, parse_pattern, ")", out pats, ref toks)
      match pats
        case List(inner) =>
          assign pat := inner
        case _ =>
          assign pat := PTuple(pats)
      end

    // List(), List(a, b), and List(a, b; rest), since only lists have free constructors
    case _ if form_at(toks) == Some(FList) =>
      local pats: List[Pat], rest: Option[Pat]
      call advance(ref toks)
      call expect(in TKw("("), ref toks)
      if at_kw(toks, ")") then
        assign pat := pat_nil()
      else
        call   parse_display(in notation, params, parse_pattern, out pats, rest, ref toks)
        assign pat := cons_all(pat_cons, pats, value_or(rest, pat_nil()))
      end
      call expect(in TKw(")"), ref toks)

    case _ =>
      local name: Id, pats: List[Pat]
      call parse_plain_name(in notation, params, out name, ref toks)
      if at_kw(toks, "(") then
        call   advance(ref toks)
        call   parse_enclosed(in notation, params, parse_pattern, ")", out pats, ref toks)
        assign pat := PApp(unqualified(name), pats)
      else
        assign pat := pat_var(name)
      end
  end

function starts_stmt(tok: Token): Bool :=
  match tok
    case TKw(kw) =>
      contains(kw, List(
        "skip",
        "if",
        "while",
        "for",
        "call",
        "match",
        "assert",
        "assign",
        "raise",
        "try"))

    case _ =>
      false
  end

function handlers(cases: List[Branch[Stmt]]): List[Catch] :=
  List(for Branch(doc, pat, guard, body) in cases yield Catch(doc, THole, pat, guard, body))

// the body of an if, while, case, or procedure, which may declare variables first
// where local x := e initializes x by an assignment at the start of the block, in order, such that its type can be inferred
procedure parse_body(
  in  notation: Notation,
      params: List[Id],
  out body: Stmt,
  ref toks: Tokens
) :=
  local xs: List[Var] := List(), inits: List[Stmt] := List(), decls: List[Var * List[Stmt]], found: Buffer[Stmt] := empty(), stmt: Stmt
  while at_kw(toks, "local") do
    call   advance(ref toks)
    call   parse_separated(in notation, params, parse_local, at_comma, out decls, ref toks)
    assign xs := xs ++ firsts(decls), inits := inits ++ concat(seconds(decls))
  end
  while starts_stmt(head_token(toks)) do
    call   parse_stmt(in notation, params, out stmt, ref toks)
    assign found := found ++ List(stmt)
  end
  assign body := SBlock(xs, inits ++ List(for t in found))

// x: T, x := e, or x: T := e, where the checker requires a type or an initial value
procedure parse_local(
  in  notation: Notation,
      params: List[Id],
  out decl: Var * List[Stmt],
  ref toks: Tokens
) :=
  local x: Var, init: Option[Expr]
  call parse_formal(in notation, params, out x, ref toks)
  call parse_optional(in notation, params, TKw(":="), parse_expr, out init, ref toks)
  match init
    case Some(expr) =>
      assign decl := (x, List(SAssign(List((Var(x.name, THole), expr)))))
    case None =>
      assign decl := (x, List())
  end

// for p in c if q do body end, or for k => v in m do body end, see ForBlock of ulang/syntax.u
procedure parse_for(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local pos := head_pos(toks), gens: List[Gen], q: Option[Expr] := None, pat: Pat, c: Expr, body: Stmt, guarded: Stmt
  call parse_gens(in notation, params, out gens, ref toks)
  match gens
    case List(GVal(p, e)) =>
      assign pat := p, c := e

    case List(GVal(p, e), GIf(g)) =>
      assign pat := p, c := e, q := Some(g)

    case List(GPair(k, v, e)) =>
      assign pat := PTuple(List(k, v)), c := e

    case List(GPair(k, v, e), GIf(g)) =>
      assign pat := PTuple(List(k, v)), c := e, q := Some(g)

    case _ =>
      raise ParseError("for takes one generator and an optional condition", pos)
  end
  call expect(in TKw("do"), ref toks)
  call parse_body(in notation, params, out body, ref toks)
  call expect(in TKw("end"), ref toks)
  match q
    case Some(g) =>
      assign guarded := SIf(g, body, SSkip)
    case None =>
      assign guarded := body
  end
  assign stmt := ForBlock(pat, c, guarded)

procedure parse_stmt(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  match head_token(toks)
    case TKw("skip") =>
      call   advance(ref toks)
      assign stmt := SSkip

    case TKw("if") =>
      call parse_if(in notation, params, out stmt, ref toks)

    case TKw("while") =>
      local expr: Expr, body: Stmt
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   expect(in TKw("do"), ref toks)
      call   parse_body(in notation, params, out body, ref toks)
      call   expect(in TKw("end"), ref toks)
      assign stmt := SWhile(expr, body)

    case TKw("for") =>
      call parse_for(in notation, params, out stmt, ref toks)

    case TKw("call") =>
      call parse_call(in notation, params, out stmt, ref toks)

    case TKw("match") =>
      local expr: Expr, cases: List[Branch[Stmt]]
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      call   parse_cases(in notation, params, parse_body, out cases, ref toks)
      assign stmt := SMatch(expr, cases)

    case TKw("assert") =>
      local expr: Expr
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      assign stmt := SAssert(expr)

    case TKw("assign") =>
      call parse_assign(in notation, params, out stmt, ref toks)

    case TKw("raise") =>
      local expr: Expr
      call   advance(ref toks)
      call   parse_expr(in notation, params, out expr, ref toks)
      assign stmt := SRaise(expr, THole)

    case TKw("try") =>
      local body: Stmt, cases: List[Branch[Stmt]]
      call   advance(ref toks)
      call   parse_body(in notation, params, out body, ref toks)
      call   expect(in TKw("catch"), ref toks)
      call   parse_cases(in notation, params, parse_body, out cases, ref toks)
      assign stmt := STry(body, handlers(cases))

    case _ =>
      raise expected("statement", toks)
  end

// then ends the condition, and an if after else is nested, with an end of its own
procedure parse_if(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local cond: Expr, l: Stmt, r: Stmt
  call advance(ref toks)
  call parse_expr(in notation, params, out cond, ref toks)
  call expect(in TKw("then"), ref toks)
  call parse_body(in notation, params, out l, ref toks)
  if at_kw(toks, "else") then
    call advance(ref toks)
    call parse_body(in notation, params, out r, ref toks)
    call expect(in TKw("end"), ref toks)
  else
    call   expect(in TKw("end"), ref toks)
    assign r := SSkip
  end
  assign stmt := SIf(cond, l, r)

procedure parse_assign(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local assignments: List[Var * Expr]
  call   advance(ref toks)
  call   parse_separated(in notation, params, parse_assignment, at_comma, out assignments, ref toks)
  assign stmt := SAssign(assignments)

// x := e
procedure parse_assignment(
  in  notation: Notation,
      params: List[Id],
  out assignment: Var * Expr,
  ref toks: Tokens
) :=
  local x: Var, expr: Expr
  call   parse_variable(in notation, params, out x, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_expr(in notation, params, out expr, ref toks)
  assign assignment := (x, expr)

// the next section starts with keyword w, after a comma unless it is the first section
function section_starts(toks: Tokens, w: Str, first: Bool): Bool :=
  if first then
    at_kw(toks, w)
  else
    at_kw(toks, ",") and second_token(toks) == TKw(w)

// a comma before another item of a section, not before the keyword of the next section
function section_continues(toks: Tokens): Bool :=
  at_kw(toks, ",") and second_token(toks) != TKw("out") and second_token(toks) != TKw("ref")

// call p(in ins, out outs, ref refs)
procedure parse_call(
  in  notation: Notation,
      params: List[Id],
  out stmt: Stmt,
  ref toks: Tokens
) :=
  local p: Id, ins: List[Expr], outs: List[Var], refs: List[Var]
  call   advance(ref toks)
  call   parse_name(out p, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_expr, parse_variable, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  assign stmt := SCall(unqualified(p), ins, outs, refs)

// in ins, out outs, ref refs of calls, declarations, lambdas, and types, where each section starts with its keyword,
// and empty sections are omitted
procedure parse_sections[A, B](
  in  notation: Notation,
      params: List[Id],
      item_in: (in Notation, List[Id], out A, ref Tokens),
      item: (in Notation, List[Id], out B, ref Tokens),
  out ins: List[A],
      outs: List[B],
      refs: List[B],
  ref toks: Tokens
) :=
  local first := true
  assign ins := List(), outs := List(), refs := List()
  if at_kw(toks, "in") then
    call   advance(ref toks)
    call   parse_separated(in notation, params, item_in, section_continues, out ins, ref toks)
    assign first := false
  end
  if section_starts(toks, "out", first) then
    call   skip_section_start(in first, ref toks)
    call   parse_separated(in notation, params, item, section_continues, out outs, ref toks)
    assign first := false
  end
  if section_starts(toks, "ref", first) then
    call skip_section_start(in first, ref toks)
    call parse_separated(in notation, params, item, section_continues, out refs, ref toks)
  end

// the comma before a section unless it is the first, and the keyword of the section
procedure skip_section_start(in first: Bool, ref toks: Tokens) :=
  if not first then
    call advance(ref toks)
  end
  call advance(ref toks)

procedure parse_variable(
  in  notation: Notation,
      params: List[Id],
  out x: Var,
  ref toks: Tokens
) :=
  local name: Id
  call   parse_plain_name(in notation, params, out name, ref toks)
  assign x := Var(unqualified(name), THole)

// only parameters and locals have type annotations
procedure parse_formal(
  in  notation: Notation,
      params: List[Id],
  out x: Var,
  ref toks: Tokens
) :=
  local name: Id, typ: Option[Type]
  call   parse_plain_name(in notation, params, out name, ref toks)
  call   parse_optional(in notation, params, TKw(":"), parse_type, out typ, ref toks)
  assign x := Var(unqualified(name), value_or(typ, THole))

// formals in parentheses, which may be empty
procedure parse_formals(
  in  notation: Notation,
      params: List[Id],
  out xs: List[Var],
  ref toks: Tokens
) :=
  call expect(in TKw("("), ref toks)
  call parse_enclosed(in notation, params, parse_formal, ")", out xs, ref toks)

// the module d without its tests, as an import loads it
function without_tests_of(d: Mod): Mod :=
  d with implemented := untested(d.implemented)

function is_test(c: Top): Bool :=
  match c
    case Top(_, _, CTest(_, _, _)) =>
      true
    case _ =>
      false
  end

function untested(cmds: List[Top]): List[Top] :=
  List(for c in cmds if not is_test(c))

// the type parameters [A, B] of a declaration, if any
procedure parse_params(
  in  notation: Notation,
  out params: List[Id],
  ref toks: Tokens
) :=
  if at_kw(toks, "[") then
    call advance(ref toks)
    call parse_separated(in notation, List(), parse_param, at_comma, out params, ref toks)
    call expect(in TKw("]"), ref toks)
  else
    assign params := List()
  end

procedure parse_param(
  in  notation: Notation,
      params: List[Id],
  out name: Id,
  ref toks: Tokens
) :=
  call parse_name(out name, ref toks)

procedure parse_notation(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local f := FInfix, prec: Int, ops: List[Id]
  match head_token(toks)
    case TKw("prefix") =>
      assign f := FPrefix

    case TKw("postfix") =>
      assign f := FPostfix

    case _ =>
      match second_token(toks)
        case TName("left") =>
          assign f := FLeft
          call   advance(ref toks)

        case TName("right") =>
          assign f := FRight
          call   advance(ref toks)

        case _ =>
          skip
      end
  end
  call advance(ref toks)
  match head_token(toks)
    case TNum(num) =>
      assign prec := num
      call   advance(ref toks)

    case _ =>
      raise expected("precedence", toks)
  end
  call   parse_repeated(in notation, List(), parse_operator, at_operator, out ops, ref toks)
  assign cmd := CNotation(f, prec, ops)

// an operator or a name, as operators are declared
function at_operator(toks: Tokens): Bool :=
  match head_token(toks)
    case TOp(_) =>
      true

    case TName(_) =>
      true

    case _ =>
      false
  end

procedure parse_operator(
  in  notation: Notation,
      params: List[Id],
  out op: Id,
  ref toks: Tokens
) :=
  if at_operator(toks) then
    assign op := format_token(head_token(toks))
    call   advance(ref toks)
  else
    raise expected("operator", toks)
  end

// C or C(name: T, rest: U), whose arguments are named fields
procedure parse_constr(
  in  notation: Notation,
      params: List[Id],
      doc: Str,
  out constr: Constr,
  ref toks: Tokens
) :=
  local name: Id, fields: List[Field] := List(), pos := head_pos(toks)
  call parse_name_or_op(out name, ref toks)
  call check_value_name(in name, pos)
  if at_kw(toks, "(") then
    call advance(ref toks)
    call parse_enclosed(in notation, params, parse_field, ")", out fields, ref toks)
  end
  assign constr := Constr(doc, unqualified(name), fields)
  match repeated(List(for field in fields yield field.name))
    case Some(f) =>
      raise ParseError("repeated field " ++ f ++ " of " ++ name, head_pos(toks))
    case None =>
      skip
  end

// a field of a constructor, name: T
procedure parse_field(
  in  notation: Notation,
      params: List[Id],
  out field: Field,
  ref toks: Tokens
) :=
  local name: Id, typ: Type
  if second_token(toks) != TKw(":") then
    raise ParseError("fields of constructors have names, as in C(name: T)", head_pos(toks))
  end
  call   parse_name(out name, ref toks)
  call   advance(ref toks)
  call   parse_type(in notation, params, out typ, ref toks)
  assign field := Field(name, typ)

// data T[A] := case C(f: A) case D, with at least one constructor, as the cases of a match over T, whose fields the
// checker gives the accessors T.f and the updaters T.f:=
procedure parse_data(
  in  notation: Notation,
  out cmds: List[Cmd],
  ref toks: Tokens
) :=
  local name: Id, params: List[Id], constrs: List[Constr]
  call advance(ref toks)
  call parse_name(out name, ref toks)
  call parse_params(in notation, out params, ref toks)
  call expect(in TKw(":="), ref toks)
  if not at_case(toks) then
    raise ParseError("each constructor follows case, as in data T := case C", head_pos(toks))
  end
  call parse_constrs(in notation, params, out constrs, ref toks)
  match differing_field(List(for k in constrs for field in k.fields yield field))
    case Some(f) =>
      raise ParseError("field " ++ f ++ " of " ++ name ++ " has different types", head_pos(toks))
    case None =>
      skip
  end
  assign cmds := List(CData(unqualified(name), params, constrs))

// the constructors of a datatype, each after case
procedure parse_constrs(
  in  notation: Notation,
      params: List[Id],
  out constrs: List[Constr],
  ref toks: Tokens
) :=
  local constr: Constr, rest: List[Constr], doc: Str
  if at_case(toks) then
    call   parse_doc(out doc, ref toks)
    call   advance(ref toks)
    call   parse_constr(in notation, params, doc, out constr, ref toks)
    call   parse_constrs(in notation, params, out rest, ref toks)
    assign constrs := List(constr; rest)
  else
    assign constrs := List()
  end

function conflicts(field: Field, other: Field): Bool :=
  other.name == field.name and other.typ != field.typ

// a field with different types in different constructors, if any
function differing_field(fields: List[Field]): Option[Id] :=
  match fields
    case List() =>
      None

    case List(field; rest) =>
      if exists(rest, lambda other => conflicts(field, other)) then
        Some(field.name)
      else
        differing_field(rest)
  end

procedure parse_function(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], xs: List[Var], r: Type, body: Expr, pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name_or_op(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   parse_formals(in notation, params, out xs, ref toks)
  if at_kw(toks, "(") then
    raise ParseError("a function has one list of formals", head_pos(toks))
  end
  call expect(in TKw(":"), ref toks)
  call parse_type(in notation, params, out r, ref toks)
  if head_token(toks) == TKw(":=") then
    call   advance(ref toks)
    call   parse_expr(in notation, params, out body, ref toks)
    assign cmd := CFun(unqualified(name), params, xs, r, body)
  else
    assign cmd := CFunSig(unqualified(name), params, xs, r)
  end

procedure parse_pat_alias(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], xs: List[Var], r: Type, pat: Pat, pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   parse_formals(in notation, params, out xs, ref toks)
  call   expect(in TKw(":"), ref toks)
  call   parse_type(in notation, params, out r, ref toks)
  call   expect(in TKw(":="), ref toks)
  call   parse_pattern(in notation, params, out pat, ref toks)
  assign cmd := CPatAlias(unqualified(name), params, xs, r, pat)

procedure parse_procedure(in notation: Notation, out cmd: Cmd, ref toks: Tokens) :=
  local name: Id, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var], body: Stmt, pos: Pos
  call   advance(ref toks)
  assign pos := head_pos(toks)
  call   parse_name(out name, ref toks)
  call   check_value_name(in name, pos)
  call   parse_params(in notation, out params, ref toks)
  call   expect(in TKw("("), ref toks)
  call   parse_sections(in notation, params, parse_formal, parse_formal, out ins, outs, refs, ref toks)
  call   expect(in TKw(")"), ref toks)
  if head_token(toks) == TKw(":=") then
    call   advance(ref toks)
    call   parse_body(in notation, params, out body, ref toks)
    assign cmd := CProc(unqualified(name), params, ins, outs, refs, body)
  else
    assign cmd := CProcSig(unqualified(name), params, ins, outs, refs)
  end

// the commands of one declaration
procedure parse_command(
  in  notation: Notation,
  out cmds: List[Cmd],
  ref toks: Tokens
) :=
  match head_token(toks)
    case TKw(kw) if contains(kw, List("prefix", "postfix", "infix")) =>
      local cmd: Cmd, pos: Pos := head_pos(toks)
      call   parse_notation(in notation, out cmd, ref toks)
      call   check_duplicates(in notation, List(cmd), pos)
      assign cmds := List(cmd)

    case TKw("type") =>
      local name: Id, params: List[Id], typ: Type
      call advance(ref toks)
      call parse_name(out name, ref toks)
      call parse_params(in notation, out params, ref toks)
      if head_token(toks) == TKw(":=") then
        call   advance(ref toks)
        call   parse_type(in notation, params, out typ, ref toks)
        assign cmds := List(CSort(unqualified(name), params, typ))
      else
        assign cmds := List(CAbstract(unqualified(name), params))
      end

    case TKw("data") =>
      call parse_data(in notation, out cmds, ref toks)

    case TKw("function") =>
      local cmd: Cmd
      call   parse_function(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("procedure") =>
      local cmd: Cmd
      call   parse_procedure(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("pattern") =>
      local cmd: Cmd
      call   parse_pat_alias(in notation, out cmd, ref toks)
      assign cmds := List(cmd)

    case TKw("test") =>
      local name: Id, body: Stmt, xs: List[Var]
      call   advance(ref toks)
      call   parse_name(out name, ref toks)
      call   parse_formals(in notation, List(), out xs, ref toks)
      call   expect(in TKw(":="), ref toks)
      call   parse_body(in notation, List(), out body, ref toks)
      assign cmds := List(CTest(name, xs, body))

    case _ =>
      raise expected("declaration", toks)
  end

// the module of id of mods, the modules loaded so far
function loaded_mod(id: Id, mods: List[Mod]): Option[Mod] :=
  find(mods, lambda d => d.name == id)

// the notation with those that the modules members of mods export, which must not declare an operator differently
procedure import_notation(
  in  members: List[Id],
      mods: List[Mod],
      pos: Pos,
  ref notation: Notation
) :=
  for m in members do
    match loaded_mod(m, mods)
      case Some(d) =>
        call   check_imported(in notation, exported_notation(d), pos)
        assign notation := notation ++ exported_notation(d)

      case None =>
        skip
    end
  end

// the package id of import id, as parse_import gives it, loaded into source unless it is loaded already, where loading
// are the packages being loaded, of which an import is cyclic, root is the root of the project, and dir the directory of
// the importing file from the root, or None for the library, which is imported only implicitly
procedure import_package(
  in  id: Id,
      root: Str,
      dir: Option[Str],
      loading: List[Id],
      pos: Pos,
  ref source: Source
) :=
  local found: Bool
  if dir == Some(id) then
    raise ParseError("import of the own package " ++ id ++ ", which the files of its directory see without importing it", pos)
  end
  if contains(id, loading) then
    raise ParseError("cyclic import of the package " ++ id, pos)
  end
  if dir == None then
    raise ParseError("the library imports nothing", pos)
  end
  if id == "prelude" then
    raise ParseError(library_import(), pos)
  end
  try
    call os_is_dir(in os_join(root, id), out found)
  catch
    case OsError(_) =>
      assign found := false
  end
  if not found then
    raise ParseError(unknown_package(id), pos)
  end
  call load_package(in root, Some(id), None, loading, ref source)
  if package_members(id, source.packages) == List() then
    raise ParseError("the package " ++ id ++ " has no members, files with sections", pos)
  end

// the message of an import of id that names no directory, where the names of the members of the library hint at it
function unknown_package(id: Id): Str :=
  if contains(library_module(id), library_modules()) then
    library_import()
  else
    "unknown package " ++ id

function library_import(): Str :=
  "import of the library, which every module sees without importing it"

function package_members(id: Id, packages: List[Package]): List[Id] :=
  match find(packages, lambda p => p.id == id)
    case Some(p) =>
      p.members
    case None =>
      List()
  end

// the module of name in dir, both from the root
function module_id(dir: Str, name: Str): Id :=
  if dir == "" then name else dir ++ "/" ++ name

// the package of the directory dir from the root, None for the library
function package_id(dir: Option[Str]): Id :=
  value_or(dir, "prelude")

// whether text has sections, as members of packages have, by a line that starts with export, builtin, or implementation,
// which is known before the text is lexed, and so also of a file that does not lex
function has_sections(text: Str): Bool :=
  exists(split(text, '\n'), lambda line => contains(first_word(line), List("export", "builtin", "implementation")))

function first_word(line: Str): Str :=
  match split(line, ' ')
    case List(word; _) =>
      word
    case List() =>
      ""
  end

// the members of the package of the directory dir from root, with their texts: the files of the directory with sections
// other than project.u, by their names, or the modules of the library for None, where main, the text of the main file,
// replaces that of its file and comes last if it has sections
procedure package_files(
  in  root: Str,
      dir: Option[Str],
      main: Option[Id * Str],
  out files: List[Id * Str]
) :=
  local entries: List[Str * Bool], text: Str, found: Buffer[Id * Str] := empty(), main_id := ""
  match main
    case Some((id, _)) =>
      assign main_id := id
    case None =>
      skip
  end
  match dir
    case Some(d) =>
      call os_list(in if d == "" then root else os_join(root, d), out entries)
      for (file, is_dir) in entries do
        if not is_dir and is_source(file) and file != "project.u" and module_id(d, module_name(file)) != main_id then
          call os_read(in os_join(os_join(root, d), file), out text)
          if has_sections(text) then
            assign found := found ++ List((module_id(d, module_name(file)), text))
          end
        end
      end

    case None =>
      for id in library_modules() do
        if id != main_id then
          call   library_text(in id, Pos(1, 1), out text)
          assign found := found ++ List((id, text))
        end
      end
  end
  match main
    case Some((id, main_text)) if has_sections(main_text) =>
      assign found := found ++ List((id, main_text))
    case _ =>
      skip
  end
  assign files := List(for f in found)

// the package of the directory dir from root, None for the library, loaded into source unless it is loaded or being
// loaded already, after the packages and programs that its members import: its members are lexed, the notations of
// their export sections collected, and each parsed with those of the others, where main is the text of the main file,
// which keeps its tests, and the other members are loaded without theirs
procedure load_package(
  in  root: Str,
      dir: Option[Str],
      main: Option[Id * Str],
      loading: List[Id],
  ref source: Source
) :=
  local id := package_id(dir), files: List[Id * Str], lexed: List[Id * Tokens], notations: List[Id * Notation], own: Mod, mods: Buffer[Mod] := empty()
  if not exists(source.packages, lambda p => p.id == id) and not contains(id, loading) then
    call package_files(in root, dir, main, out files)
    call lex_members(in files, main, out lexed, notations)
    for (m, toks) in lexed do
      call   parse_member(in m, toks, others_notation(m, notations), root, dir, is_main(m, main), List(id; loading), out own, ref source)
      assign mods := mods ++ List(own)
    end
    assign source := source with mods := source.mods ++ List(for d in mods), packages := source.packages ++ List(Package(id, firsts(files)))
  end

function is_main(id: Id, main: Option[Id * Str]): Bool :=
  match main
    case Some((m, _)) =>
      m == id
    case None =>
      false
  end

// the notation that the other members of a package than m export
function others_notation(m: Id, notations: List[Id * Notation]): Notation :=
  foldl(notations, empty_notation(), lambda notation, (other, ops) => if other == m then notation else notation ++ ops)

// the tokens of the members files, with the notations of their export sections
procedure lex_members(
  in  files: List[Id * Str],
      main: Option[Id * Str],
  out lexed: List[Id * Tokens],
      notations: List[Id * Notation]
) :=
  local toks: Tokens, ops: Notation
  assign lexed := List(), notations := List()
  for (m, text) in files do
    call   lex_member(in m, text, is_main(m, main), out toks)
    call   exported_ops(in toks, out ops)
    assign lexed := lexed ++ List((m, toks)), notations := notations ++ List((m, ops))
  end

// the tokens of module id of text, where an error of a module other than the main one is located in it
procedure lex_member(in id: Id, text: Str, main: Bool, out toks: Tokens) :=
  try
    call lex(in text, out toks)
  catch
    case LexError(message, pos) if main =>
      raise ParseError(message, pos)
    case LexError(message, pos) =>
      raise ImportError(id, message, pos)
  end

// the notation of the commands of the export section of the tokens of a module, read before the module is parsed, of the
// notation commands at the start of a line, which parse without notation, where those that do not parse are left to the
// parse of the module
procedure exported_ops(in toks: Tokens, out notation: Notation) :=
  local rest := toks, inside := false
  assign notation := empty_notation()
  while head_token(rest) != TEnd do
    match (head_pos(rest).col, head_token(rest))
      case (1, TKw("export")) =>
        assign inside := true
        call   advance(ref rest)

      case (1, TKw(kw)) if contains(kw, List("builtin", "implementation")) =>
        assign rest := List()

      case (1, TKw(kw)) if inside and contains(kw, List("prefix", "postfix", "infix")) =>
        local cmd: Cmd
        try
          call   parse_notation(in empty_notation(), out cmd, ref rest)
          assign notation := with_notation(notation, List(cmd))
        catch
          case ParseError(_, _) =>
            call advance(ref rest)
        end

      case _ =>
        call advance(ref rest)
    end
  end

// the module id of a package, of the tokens toks, parsed with the notation that the other members export, where main
// tells whether it is the main file, which keeps its tests, and whose errors are its own
procedure parse_member(
  in  id: Id,
      toks: Tokens,
      notation: Notation,
      root: Str,
      dir: Option[Str],
      main: Bool,
      loading: List[Id],
  out own: Mod,
  ref source: Source
) :=
  local rest := toks
  try
    call parse_mod(in id, implicit_imports(id), notation, root, dir, loading, out own, ref source, rest)
  catch
    case ParseError(message, pos) if not main =>
      raise ImportError(id, message, pos)
  end
  if not main then
    assign own := without_tests_of(own)
  end

// the main program id of text, a file without sections, loaded into source after the package of its directory, whose
// exports it sees and with whose notation it is parsed; no other file imports it
procedure load_program(in id: Id, text: Str, root: Str, ref source: Source) :=
  local dir := module_dir(id), toks: Tokens, own: Mod
  call   load_package(in root, Some(dir), None, List(), ref source)
  call   lex_member(in id, text, true, out toks)
  call   parse_member(in id, toks, members_notation(package_members(dir, source.packages), source.mods), root, Some(dir), true, List(), out own, ref source)
  assign source := source with mods := source.mods ++ List(own)

// the notation that the modules names of mods export
function members_notation(names: List[Id], mods: List[Mod]): Notation :=
  foldl(List(for d in mods if contains(d.name, names)), empty_notation(), lambda notation, d => notation ++ exported_notation(d))

procedure import_all(
  in  names: List[Id],
      root: Str,
      loading: List[Id],
  ref source: Source
) :=
  if names != List() then
    call load_package(in root, None, None, loading, ref source)
  end

procedure import_notations(
  in  names: List[Id],
      mods: List[Mod],
  ref notation: Notation
) :=
  call import_notation(in names, mods, Pos(1, 1), ref notation)

data Section :=
  case Opening
  case InExport
  case InBuiltin
  case InImplementation
  case NoSections

// the module name of the tokens toks, which starts with the notation of its implicit imports and the notation of its
// package, that its siblings export, after the packages that its imports load into source, from the directory dir of root
// as import_package reads them, where notations apply to the commands after them, imports come first, and each command
// has the position where it starts
procedure parse_mod(
  in  name: Id,
      implicit: List[Id],
      package: Notation,
      root: Str,
      dir: Option[Str],
      loading: List[Id],
  out own: Mod,
  ref source: Source,
      toks: Tokens
) :=
  local imports: List[Id] := List(), notation := empty_notation(), plain: List[Top] := List(), exported: List[Top] := List(), builtins: List[Top] := List(), implemented: List[Top] := List(), more: List[Cmd], section := Opening, pos: Pos, imported: Id, placed: List[Top], doc: Str, mod_doc := ""
  match module_doc(toks)
    case Some(text) =>
      assign mod_doc := text
      call   advance(ref toks)

    case None =>
      skip
  end
  call   import_all(in implicit, root, loading, ref source)
  call   import_notations(in implicit, source.mods, ref notation)
  assign notation := notation ++ package
  while head_token(toks) != TEnd do
    assign doc := ""
    match head_token(toks)
      case TDoc(text) =>
        assign doc := text
        call   advance(ref toks)

      case _ =>
        skip
    end
    assign pos := head_pos(toks), more := List()
    match head_token(toks)
      case TKw("export") =>
        if section == InExport or section == InBuiltin or section == InImplementation then
          raise ParseError("a module has one export section", pos)
        else
          if section != Opening then
            raise ParseError("export comes first, after the imports", pos)
          end
        end
        call   advance(ref toks)
        assign section := InExport

      case TKw("builtin") =>
        if section != InExport then
          raise ParseError("builtin follows export", pos)
        end
        call   advance(ref toks)
        assign section := InBuiltin

      case TKw("implementation") =>
        if section != InExport and section != InBuiltin then
          raise ParseError("implementation follows export", pos)
        end
        call   advance(ref toks)
        assign section := InImplementation

      case TKw("import") if section == NoSections =>
        raise ParseError("imports come first", pos)

      case TKw("import") if section != Opening =>
        raise ParseError("imports come before export", pos)

      case TKw("import") =>
        call   advance(ref toks)
        call   parse_import(out imported, ref toks)
        call   import_package(in imported, root, dir, loading, pos, ref source)
        call   import_notation(in package_members(imported, source.packages), source.mods, pos, ref notation)
        assign imports := imports ++ List(imported)

      case _ =>
        call   parse_command(in notation, out more, ref toks)
        call   enter_section(in more, pos, ref section)
        assign notation := with_notation(notation, more)
    end
    match more
      case List(c; rest) =>
        assign placed := List(Top(pos, doc, c); List(for d in rest yield Top(pos, "", d)))
      case _ =>
        assign placed := List()
    end
    match section
      case InExport =>
        assign exported := reverse_onto(placed, exported)

      case InBuiltin =>
        assign builtins := reverse_onto(placed, builtins)

      case InImplementation =>
        assign implemented := reverse_onto(placed, implemented)

      case _ =>
        assign plain := reverse_onto(placed, plain)
    end
  end
  assign implemented := reverse(implemented) ++ reverse(plain)
  assign own := Mod(name, mod_doc, imports, reverse(exported), reverse(builtins), implemented)

// the section after the commands of one declaration, which must belong to the section
procedure enter_section(in cmds: List[Cmd], pos: Pos, ref section: Section) :=
  match (cmds, section)
    case (List(CFunSig(_, _, _, _); _), InBuiltin) =>
      skip

    case (List(CProcSig(_, _, _, _, _); _), InBuiltin) =>
      skip

    case (List(CAbstract(_, _); _), InBuiltin) =>
      skip

    case (_, InBuiltin) =>
      raise ParseError("builtin sections have signatures and types without a definition only", pos)

    case (List(CNotation(_, _, _); _), InImplementation) =>
      raise ParseError("notations belong to the export section", pos)

    case (List(CFunSig(_, _, _, _); _), s) if s != InExport =>
      raise ParseError("signatures belong to the export section", pos)

    case (List(CProcSig(_, _, _, _, _); _), s) if s != InExport =>
      raise ParseError("signatures belong to the export section", pos)

    case (List(CAbstract(_, _); _), s) if s != InExport =>
      raise ParseError("types without a definition belong to the export or builtin section", pos)

    case (List(CFun(_, _, _, _, _); _), InExport) =>
      raise ParseError("definitions belong to the implementation section", pos)

    case (List(CProc(_, _, _, _, _, _); _), InExport) =>
      raise ParseError("definitions belong to the implementation section", pos)

    case (List(CTest(_, _, _); _), InExport) =>
      raise ParseError("tests belong to the implementation section", pos)

    case (_, Opening) =>
      assign section := NoSections

    case _ =>
      skip
  end

procedure library_text(in id: Id, pos: Pos, out text: Str) :=
  try
    call os_library(in library_file(id), out text)
  catch
    case OsError(_) =>
      raise ParseError("unknown module " ++ id, pos)
  end

procedure lex_text(in text: Str, out toks: Tokens) :=
  try
    call lex(in text, out toks)
  catch
    case LexError(message, pos) =>
      raise ParseError(message, pos)
  end

procedure parse_file_text(in path: Str, text: Str, out source: Source) :=
  local place: Place
  call   place_of(in path, out place)
  assign source := Source(List(), List(), place.id)
  if place.dir == None or has_sections(text) then
    call load_package(in place.root, place.dir, Some((place.id, text)), List(), ref source)
  else
    call load_program(in place.id, text, place.root, ref source)
  end

procedure parse_file(in path: Str, out source: Source) :=
  local text: Str
  call os_read(in path, out text)
  call parse_file_text(in path, text, out source)

// the module of text without implicit imports and imports, which reads no files, for the tests
procedure parse_text(in text: Str, out own: Mod) :=
  local toks: Tokens, source := Source(List(), List(), "main")
  call lex_text(in text, out toks)
  call parse_mod(in "main", List(), empty_notation(), "", None, List(), out own, ref source, toks)

// the file of a module: its id, the root of its project, and its directory from the root, None for the library
data Place :=
  case Place(id: Id, root: Str, dir: Option[Str])

// the place of the file at path, whose root is the nearest directory above it with project.u, else its own directory,
// where a directory with prelude.u is the library, whose modules are known by their names
procedure place_of(in path: Str, out place: Place) :=
  local cwd: Str, file: Str, home: Str, root: Str, library: Bool, name := module_name(path)
  call   os_cwd(out cwd)
  assign file := normal_path(if starts_with(path, "/") then path else os_join(cwd, path))
  assign home := os_dirname(file)
  call   has_file(in home, "prelude.u", out library)
  if library then
    assign place := Place(library_module(name), home, None)
  else
    call   project_root(in home, out root)
    assign place := Place(module_id(relative_path(root, home), name), root, Some(relative_path(root, home)))
  end

// the nearest directory from dir upward with project.u, or else dir, where dir is absolute and normal
procedure project_root(in dir: Str, out root: Str) :=
  local found := false, here := dir
  assign root := dir
  while not found do
    call has_file(in here, "project.u", out found)
    if found then
      assign root := here
    else
      if here == "/" then
        assign found := true
      else
        assign here := os_dirname(here)
      end
    end
  end

procedure has_file(in dir: Str, name: Str, out found: Bool) :=
  local entries: List[Str * Bool]
  try
    call   os_list(in dir, out entries)
    assign found := contains((name, false), entries)
  catch
    case OsError(_) =>
      assign found := false
  end

// the absolute path without . and .. and repeated /
function normal_path(path: Str): Str :=
  "/" ++ join("/", reverse(foldl(split(path, '/'), List(), normal_step)))

function normal_step(parts: List[Str], part: Str): List[Str] :=
  match (part, parts)
    case ("", _) =>
      parts

    case (".", _) =>
      parts

    case ("..", List(_; rest)) =>
      rest

    case ("..", List()) =>
      List()

    case _ =>
      List(part; parts)
  end

// dir from root, which is root or above it, both normal, as "" for root itself
function relative_path(root: Str, dir: Str): Str :=
  if dir == root then
    ""
  else if root == "/" then
    slice(dir, 1, size(dir))
  else
    slice(dir, size(root) + 1, size(dir))

// the name of the module of the file at path, without its directory and .u
function module_name(path: Str): Str :=
  let f := os_basename(path) in
  if is_source(f) then slice(f, 0, size(f) - 2) else f

function is_source(path: Str): Bool :=
  let f := os_basename(path) in
  size(f) > 2 and ends_with(f, ".u")

// the parser, tested by the trees of single constructs, parsed with their own notation from the empty context, which reads no
// files
function test_notation(): Str :=
  "infix right 8 ++\ninfix 6 ==\ninfix left 9 + -\ninfix left 10 *\nprefix 5 not\nprefix 11 -\n"

// the body of a function that is e
procedure parsed(in e: Str, out body: Expr) :=
  local d: Mod
  call   parse_text(in test_notation() ++ "function f(): Int :=\n  " ++ e, out d)
  assign body := ELit(LUnit)
  match reverse(commands_of(placed_of(d)))
    case List(CFun(_, _, _, _, b); _) =>
      assign body := b
    case _ =>
      skip
  end

test parsed_docs() :=
  local d: Mod, text := "// the answer\n// in two lines\nfunction f(): Int := 42\n\n\n\n"
  call parse_text(in text ++ "function g(): Int := 1\nfunction h(): Int := 2\n", out d)
  assert List(for top in d.implemented yield top.doc) == List("the answer\nin two lines", "", "")
  assert List(for top in d.implemented yield top.pos) == List(Pos(3, 1), Pos(7, 1), Pos(8, 1))

test parsed_docs_of_modules_and_constructors() :=
  local d: Mod, docs: List[Str] := List(), then_f := "// then\nfunction f(): Int := 1\n"
  call parse_text(in "// the module\n//\n// more\n\n// the function\nfunction f(): Int := 1\n", out d)
  assert d.doc == "the module\n\nmore"
  assert List(for top in d.implemented yield top.doc) == List("the function")
  call parse_text(in "// the function\nfunction f(): Int := 1\n", out d)
  assert d.doc == "" and List(for top in d.implemented yield top.doc) == List("the function")
  call parse_text(in "// the module\nexport\n", out d)
  assert d.doc == "the module"
  call parse_text(in "data T :=\n  // first\n  // line\n  case A\n  case B(x: Int)\n\n" ++ then_f, out d)
  match d.implemented
    case List(Top(_, _, CData(_, _, constrs)), Top(_, doc, _)) =>
      assign docs := List(for k in constrs yield k.doc) ++ List(doc)
    case _ =>
      skip
  end
  assert docs == List("first\nline", "", "then")

test parsed_docs_of_cases() :=
  local d: Mod, docs: List[Str] := List(), fun_f := "function f(x: Int): Int :=\n  match x\n    // zero\n    // or one\n    case 0 => 1\n    case _ => 2\n  end\n\n", proc_p := "procedure p() :=\n  match 1\n    // a\n    case 1 =>\n      skip\n  end\n  try\n    skip\n  catch\n    // b\n    case _ =>\n      skip\n  end\n"
  call parse_text(in fun_f ++ proc_p, out d)
  match commands_of(d.implemented)
    case List(
      CFun(_, _, _, _, EMatch(_, bs)),
      CProc(_, _, _, _, _, SBlock(_, List(SMatch(_, cs), STry(_, hs))))) =>
      assign docs := List(for b in bs yield b.doc) ++ List(for c in cs yield c.doc) ++ List(for h in hs yield h.doc)

    case _ =>
      skip
  end
  assert docs == List("zero\nor one", "", "a", "b")

test parsed_operators() :=
  local expr: Expr, a := expr_var("a"), b := expr_var("b"), c := expr_var("c")
  call parsed(in "a - b - c", out expr)
  assert expr == expr_app("-", List(expr_app("-", List(a, b)), c))
  call parsed(in "a ++ b ++ c", out expr)
  assert expr == expr_app("++", List(a, expr_app("++", List(b, c))))
  call parsed(in "a + b * c - a", out expr)
  assert expr == expr_app("-", List(expr_app("+", List(a, expr_app("*", List(b, c)))), a))
  call parsed(in "not a == b", out expr)
  assert expr == expr_app("not", List(expr_app("==", List(a, b))))
  call parsed(in "-a * b", out expr)
  assert expr == expr_app("*", List(expr_app("-", List(a)), b))
  call parsed(in "a - -1", out expr)
  assert expr == expr_app("-", List(a, expr_int(-1)))
  call parsed(in "- -a", out expr)
  assert expr == expr_app("-", List(expr_app("-", List(a))))
  call parsed(in "-a.f", out expr)
  assert expr == expr_app("-", List(EField(a, "f")))
  call parsed(in "a with f := 1, g := b.f", out expr)
  assert expr == EUpdate(EUpdate(a, "f", expr_int(1)), "g", EField(b, "f"))

test parsed_forms() :=
  local expr: Expr, a := expr_var("a"), b := expr_var("b"), c := expr_var("c"), tail := PApp(unqualified("Cons"), List(PLit(LInt(-1)), PWild))
  call parsed(in "List(a, b; c)", out expr)
  assert expr == EForm(FList, List(YVal(a), YVal(b)), Some(c))
  call parsed(in "match a case List(x, -1; _) => x end", out expr)
  assert expr == EMatch(a, List(
    Branch("", PApp(unqualified("Cons"), List(pat_var("x"), tail)), None, expr_var("x"))))
  call parsed(in "Set()", out expr)
  assert expr == EForm(FSet, List(), None)
  call parsed(in "Map(a => b, a => c)", out expr)
  assert expr == EForm(FMap, List(YPair(a, b), YPair(a, c)), None)
  call parsed(in "Array(for x in a if x yield b)", out expr)
  assert expr == EFor(FArray, List(GVal(pat_var("x"), a), GIf(expr_var("x"))), YVal(b), None)
  call parsed(in "Map(for k => v in a)", out expr)
  assert expr == EFor(FMap, List(GPair(pat_var("k"), pat_var("v"), a)), YPair(expr_var("k"), expr_var("v")), None)
