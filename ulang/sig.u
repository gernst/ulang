// the signatures of modules, the types of their declarations by name, made of the signatures of the declarations, which the
// checker fills

import "syntax.u"

export

// a type over params, the unknowns that each use instantiates fresh: of functions and locals, of the candidates of
// overloading, where constructors and procedures have the types of their values, and of the constructors of patterns,
// where it is the type that they match
data Scheme :=
  case Scheme(params: List[Type], typ: Type)

data TypeAlias :=
  case TypeAlias(params: List[Id], typ: Type)

data ProcSig :=
  case ProcSig(params: List[Type], ins: List[Type], outs: List[Type], refs: List[Type])

// a constructor of the datatype typ over params, with the types of its fields in their order
data ConstrSig :=
  case ConstrSig(params: List[Type], fields: List[Type], typ: Type)

// a pattern alias over params, whose checked pattern pat of type typ has the formals for its variables, each once, and
// whose constructors are qualified, so that a use in another module expands it without resolving them again
data PatAlias :=
  case PatAlias(params: List[Type], formals: List[Var], typ: Type, pat: Pat)

// named has the declarations of each base name, of any kind and module
data Sig :=
  case Sig(type_aliases: Map[Name, TypeAlias], funs: Map[Name, List[Scheme]], procs: Map[Name, ProcSig], datas: Map[Name, Int], members: Map[Name, List[Name]], constrs: Map[Name, ConstrSig], pat_aliases: Map[Name, PatAlias], named: Map[Id, List[Name]])

function empty(): Sig

function restrict(sig: Sig, ms: List[Id]): Sig

function union(a: Sig, b: Sig): Sig

function exported(sig: Sig, values: Set[Name], sorts: Set[Name]): Sig

function type_alias_of(sig: Sig, n: Name): Option[TypeAlias]

function schemes_of(sig: Sig, n: Name): List[Scheme]

function proc_of(sig: Sig, n: Name): Option[ProcSig]

function data_of(sig: Sig, n: Name): Option[Int]

function members_of(sig: Sig, n: Name): Option[List[Name]]

function constr_of(sig: Sig, n: Name): Option[ConstrSig]

function is_fun(sig: Sig, n: Name): Bool

function is_proc(sig: Sig, n: Name): Bool

function is_data(sig: Sig, n: Name): Bool

function is_type_alias(sig: Sig, n: Name): Bool

function is_constr(sig: Sig, n: Name): Bool

function pat_alias_of(sig: Sig, n: Name): Option[PatAlias]

function is_pat_alias(sig: Sig, n: Name): Bool

function is_sort(sig: Sig, n: Name): Bool

function names_of(sig: Sig, b: Id): List[Name]

function with_type_alias(sig: Sig, n: Name, alias: TypeAlias): Sig

function with_fun(sig: Sig, n: Name, sc: Scheme): Sig

function with_proc(sig: Sig, n: Name, proc: ProcSig): Sig

function with_data(sig: Sig, n: Name, arity: Int): Sig

function with_members(sig: Sig, n: Name, cs: List[Name]): Sig

function with_constr(sig: Sig, n: Name, constr: ConstrSig): Sig

function with_pat_alias(sig: Sig, n: Name, alias: PatAlias): Sig

implementation

function empty(): Sig :=
  Sig(empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty())

function restrict(sig: Sig, ms: List[Id]): Sig :=
  Sig(owned_map(sig.type_aliases, ms), owned_map(sig.funs, ms), owned_map(sig.procs, ms), owned_map(sig.datas, ms), owned_map(sig.members, ms), owned_map(sig.constrs, ms), owned_map(sig.pat_aliases, ms), map(for (k, v) in owned_named(list(for k => v in sig.named), ms)))

function owned_map[V](m: Map[Name, V], ms: List[Id]): Map[Name, V] :=
  map(for (k, v) in owned(list(for k => v in m), ms))

function owned[V](es: List[Name * V], ms: List[Id]): List[Name * V] :=
  list(for (n, v) in es if in_modules(n, ms))

function owned_named(es: List[Id * List[Name]], ms: List[Id]): List[Id * List[Name]] :=
  match es
    case list() =>
      list()
    case list((b, ns); rest) =>
      let ks := list(for n in ns if in_modules(n, ms)) in if ks == list() then owned_named(rest, ms) else list((b, ks); owned_named(rest, ms))
  end

function in_modules(n: Name, ms: List[Id]): Bool :=
  match n.module
    case Some(m) =>
      contains(m, ms)
    case None =>
      false
  end

// the declarations of both, whose names differ since they are qualified by their modules
function union(a: Sig, b: Sig): Sig :=
  Sig(a.type_aliases ++ b.type_aliases, a.funs ++ b.funs, a.procs ++ b.procs, a.datas ++ b.datas, a.members ++ b.members, a.constrs ++ b.constrs, a.pat_aliases ++ b.pat_aliases, union_named(list(for k => v in b.named), a.named))

// the signature without the private functions, procedures, and constructors, values, and without the private sorts, each kind
// of declaration filtered by its own names, since a datatype and its constructor may share a name, where an abstract type,
// whose constructors are private, has no members
function exported(sig: Sig, values: Set[Name], sorts: Set[Name]): Sig :=
  let members := without(sig.members, sorts) in let kept := Sig(without(sig.type_aliases, sorts), without(sig.funs, values), without(sig.procs, values), without(sig.datas, sorts), map(for k => v in members if not hidden(v, values)), without(sig.constrs, values), without(sig.pat_aliases, values), empty()) in kept with named := map(for k => v in sig.named yield k => declared(kept, v))

function without[V](m: Map[Name, V], names: Set[Name]): Map[Name, V] :=
  map(for k => v in m if not contains(k, names))

function declares(sig: Sig, n: Name): Bool :=
  is_type_alias(sig, n) or is_fun(sig, n) or is_proc(sig, n) or is_data(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n)

function union_named(es: List[Id * List[Name]], bs: Map[Id, List[Name]]): Map[Id, List[Name]] :=
  match es
    case list() =>
      bs

    case list((k, ns); rest) =>
      match get(k, bs)
        case Some(ms) =>
          union_named(rest, put(k, ms ++ ns, bs))
        case None =>
          union_named(rest, put(k, ns, bs))
      end
  end

function type_alias_of(sig: Sig, n: Name): Option[TypeAlias] :=
  get(n, sig.type_aliases)

function schemes_of(sig: Sig, n: Name): List[Scheme] :=
  value_or(get(n, sig.funs), list())

function proc_of(sig: Sig, n: Name): Option[ProcSig] :=
  get(n, sig.procs)

function data_of(sig: Sig, n: Name): Option[Int] :=
  get(n, sig.datas)

function members_of(sig: Sig, n: Name): Option[List[Name]] :=
  get(n, sig.members)

function constr_of(sig: Sig, n: Name): Option[ConstrSig] :=
  get(n, sig.constrs)

function pat_alias_of(sig: Sig, n: Name): Option[PatAlias] :=
  get(n, sig.pat_aliases)

function is_pat_alias(sig: Sig, n: Name): Bool :=
  contains(n, sig.pat_aliases)

function is_fun(sig: Sig, n: Name): Bool :=
  contains(n, sig.funs)

function is_proc(sig: Sig, n: Name): Bool :=
  contains(n, sig.procs)

function is_data(sig: Sig, n: Name): Bool :=
  contains(n, sig.datas)

function is_type_alias(sig: Sig, n: Name): Bool :=
  contains(n, sig.type_aliases)

function is_constr(sig: Sig, n: Name): Bool :=
  contains(n, sig.constrs)

function is_sort(sig: Sig, n: Name): Bool :=
  is_data(sig, n) or is_type_alias(sig, n)

// the declarations with base name b, of any kind and module, in the order of their declaration
function names_of(sig: Sig, b: Id): List[Name] :=
  value_or(get(b, sig.named), list())

function with_named(bs: Map[Id, List[Name]], n: Name): Map[Id, List[Name]] :=
  match get(n.base, bs)
    case Some(ns) =>
      if contains(n, ns) then bs else put(n.base, ns ++ list(n), bs)
    case None =>
      put(n.base, list(n), bs)
  end

function with_type_alias(sig: Sig, n: Name, alias: TypeAlias): Sig :=
  sig with type_aliases := put(n, alias, sig.type_aliases), named := with_named(sig.named, n)

function with_fun(sig: Sig, n: Name, sc: Scheme): Sig :=
  sig with funs := put(n, schemes_of(sig, n) ++ list(sc), sig.funs), named := with_named(sig.named, n)

function with_proc(sig: Sig, n: Name, proc: ProcSig): Sig :=
  sig with procs := put(n, proc, sig.procs), named := with_named(sig.named, n)

function with_data(sig: Sig, n: Name, arity: Int): Sig :=
  sig with datas := put(n, arity, sig.datas), named := with_named(sig.named, n)

function with_members(sig: Sig, n: Name, cs: List[Name]): Sig :=
  sig with members := put(n, cs, sig.members)

function with_constr(sig: Sig, n: Name, constr: ConstrSig): Sig :=
  sig with constrs := put(n, constr, sig.constrs), named := with_named(sig.named, n)

function with_pat_alias(sig: Sig, n: Name, alias: PatAlias): Sig :=
  sig with pat_aliases := put(n, alias, sig.pat_aliases), named := with_named(sig.named, n)

function declared(sig: Sig, names: List[Name]): List[Name] :=
  list(for name in names if declares(sig, name))

function hidden(names: List[Name], values: Set[Name]): Bool :=
  exists(names, lambda name => contains(name, values))
