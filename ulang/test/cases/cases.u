// the phases of ulang over cases, source texts given by their lines, for the tests of errors in ulang/test/errors/, which
// assert by assert raises the exception of the phase where a case fails: parse_file_text and parse_texts raise ParseError,
// check_tested Located, require_formatted Unformatted, run_program the RuntimeError of a test, and prove_program
// OpenTermination or OpenLemma; a case sits at a path from the working directory, the root, where the tests run, so that it imports the
// packages of the project as files; each case is loaded as test loads a file, with the tests of its lemmas

import ulang.syntax
import ulang.parse
import ulang.check
import ulang.format
import ulang.run
import ulang.prove
import ulang.test

export

// parses and checks the case as the file at path, which must be formatted, after the errors of parsing and checking
procedure load_text(
  in  path: Str,
      lines: List[Str],
  out main: Path,
      q: Prog
) raises ParseError, TypeError, Unformatted, InternalError, OsError

// load_text without its results
procedure check_text(
  in  path: Str,
      lines: List[Str]
) raises ParseError, TypeError, Unformatted, InternalError, OsError

// the errors of parsing the case and of checking its commands that parse, as check does for a file with parse errors
procedure check_text_partial(
  in  path: Str,
      lines: List[Str],
  out parsing: List[ParseError],
      errors: List[TypeError]
) raises ParseError, OsError, InternalError

// the checked program of the case, which holds its errors, and the errors of checking it, all of them, in the order of the
// commands
procedure checked_text(
  in  path: Str,
      lines: List[Str],
  out q: Prog,
      errors: List[TypeError]
) raises ParseError, OsError, InternalError

// load_text, then the tests of the case
procedure run_text(
  in  path: Str,
      lines: List[Str]
) raises ParseError, TypeError, Unformatted, InternalError, OsError, Thrown, RuntimeError

// the tests of the case despite its errors of types, as test runs a unit with errors, where a test that reaches a part or
// a definition that checking rejected raises Deferred
procedure run_text_despite_errors(
  in  path: Str,
      lines: List[Str]
) raises ParseError, InternalError, OsError, Thrown, RuntimeError

// the tests of main, the name and lines of a file in dir, despite the errors of types of main and of the packages of
// imported, each its directory and the names and lines of its members, which main imports, as test runs a unit with
// errors, where a test that reaches a part or a definition that checking rejected raises Deferred
procedure run_texts_despite_errors(
  in  dir: Str,
      imported: List[(Str, List[(Str, List[Str])])],
      main: (Str, List[Str])
) raises ParseError, InternalError, OsError, Thrown, RuntimeError

// the tests of the case despite its errors of parsing and of types, as test runs a unit with errors, where a test that
// reaches a part that does not parse raises Deferred there
procedure run_text_partial(
  in  path: Str,
      lines: List[Str]
) raises ParseError, InternalError, OsError, Thrown, RuntimeError

// load_text, then the lemmas of the case
procedure prove_text(
  in  path: Str,
      lines: List[Str]
) raises ParseError, TypeError, Unformatted, InternalError, OsError, OpenLemma, OpenTermination

// the lemmas of the case despite its errors of types, as check --prove proves those of a unit with errors, without the
// lemmas whose statements have errors and the proofs that have errors
procedure prove_text_despite_errors(
  in  path: Str,
      lines: List[Str]
) raises ParseError, InternalError, OsError, OpenLemma, OpenTermination

// load_text of several modules: the members of the package of the directory dir from the root, each its name and lines,
// and main, the name and lines of the main file, which is one of them or a program in dir, each of them formatted
procedure load_texts(
  in  dir: Str,
      members: List[(Str, List[Str])],
      main: (Str, List[Str]),
  out q: Prog
) raises ParseError, TypeError, Unformatted, InternalError, OsError

// load_texts without its result
procedure check_texts(
  in  dir: Str,
      members: List[(Str, List[Str])],
      main: (Str, List[Str])
) raises ParseError, TypeError, Unformatted, InternalError, OsError

// load_texts, then the tests of main
procedure run_texts(
  in  dir: Str,
      members: List[(Str, List[Str])],
      main: (Str, List[Str])
) raises ParseError, TypeError, Unformatted, InternalError, OsError, Thrown, RuntimeError

implementation

// the module of the file name.u in dir
function module_in(dir: Str, name: Str): Path :=
  dir_path(dir) ++ List(slice(name, 0, size(name) - 2))

// the source of the case as the file at path, the only member of the package of its directory, so that the other files
// there are not loaded, with the enumeration that the tests of its lemmas call
procedure parse_case(
  in  path: Str,
      text: Str,
  out source: Source
) raises ParseError, OsError :=
  var here: Str, root: Str
  os_cwd(out here)
  project_root(in normal_path(here), out root)
  parse_texts(in root, os_dirname(path), List(), List(), (module_in(os_dirname(path), os_basename(path)), text), false, out source)
  load_tester(ref source)

// check_program with the tests of the lemmas
procedure check_tested(
  in  source: Source,
  out q: Prog
) raises TypeError, InternalError :=
  var errors: List[TypeError]
  check_all(in source, enumerated_tests, out q, errors)
  require_kept(in q, errors)
  for e in take(1, errors) do
    raise e
  end

function text_of(lines: List[Str]): Str :=
  join("\n", lines) ++ "\n"

procedure load_text(
  in  path: Str,
      lines: List[Str],
  out main: Path,
      q: Prog
) raises ParseError, TypeError, Unformatted, InternalError, OsError :=
  var source: Source
  parse_case(in path, text_of(lines), out source)
  require_parsed(in source)
  check_tested(in source, out q)
  require_formatted(in source, source.main, text_of(lines))
  main := source.main

procedure check_text(
  in  path: Str,
      lines: List[Str]
) raises ParseError, TypeError, Unformatted, InternalError, OsError :=
  load_text(in path, lines, out _, _)

procedure check_text_partial(
  in  path: Str,
      lines: List[Str],
  out parsing: List[ParseError],
      errors: List[TypeError]
) raises ParseError, OsError, InternalError :=
  var source: Source
  parse_case(in path, text_of(lines), out source)
  check_partial(in without_unparsed(source), unparsed_names(source), enumerated_tests, out _, errors)
  parsing := parse_errors(source)

procedure checked_text(
  in  path: Str,
      lines: List[Str],
  out q: Prog,
      errors: List[TypeError]
) raises ParseError, OsError, InternalError :=
  var source: Source
  parse_case(in path, text_of(lines), out source)
  require_parsed(in source)
  check_all(in source, enumerated_tests, out q, errors)

procedure run_text(
  in  path: Str,
      lines: List[Str]
) raises ParseError, TypeError, Unformatted, InternalError, OsError, Thrown, RuntimeError :=
  var q: Prog
  load_text(in path, lines, out _, q)
  run_program(in q)

procedure run_text_despite_errors(
  in  path: Str,
      lines: List[Str]
) raises ParseError, InternalError, OsError, Thrown, RuntimeError :=
  var q: Prog
  checked_text(in path, lines, out q, _)
  run_program(in q)

procedure run_text_partial(
  in  path: Str,
      lines: List[Str]
) raises ParseError, InternalError, OsError, Thrown, RuntimeError :=
  var source: Source, q: Prog
  parse_case(in path, text_of(lines), out source)
  check_partial(in without_unparsed(source), unparsed_names(source), enumerated_tests, out q, _)
  run_program(in q)

procedure run_texts_despite_errors(
  in  dir: Str,
      imported: List[(Str, List[(Str, List[Str])])],
      main: (Str, List[Str])
) raises ParseError, InternalError, OsError, Thrown, RuntimeError :=
  var here: Str, root: Str, source: Source, q: Prog
  os_cwd(out here)
  project_root(in normal_path(here), out root)
  match main
    case (name, lines) =>
      parse_texts(in root, dir, List(for (d, files) in imported yield (d, List(for (m, ls) in files yield (module_in(d, m), text_of(ls))))), List(), (module_in(dir, name), text_of(lines)), false, out source)
  end
  require_parsed(in source)
  load_tester(ref source)
  check_all(in source, enumerated_tests, out q, _)
  run_program(in q)

procedure prove_text(
  in  path: Str,
      lines: List[Str]
) raises ParseError, TypeError, Unformatted, InternalError, OsError, OpenLemma, OpenTermination :=
  var main: Path, q: Prog
  load_text(in path, lines, out main, q)
  prove_program(in q, main)

procedure prove_text_despite_errors(
  in  path: Str,
      lines: List[Str]
) raises ParseError, InternalError, OsError, OpenLemma, OpenTermination :=
  var q: Prog
  checked_text(in path, lines, out q, _)
  prove_program(in q, q.main)

procedure load_texts(
  in  dir: Str,
      members: List[(Str, List[Str])],
      main: (Str, List[Str]),
  out q: Prog
) raises ParseError, TypeError, Unformatted, InternalError, OsError :=
  var here: Str, root: Str
  os_cwd(out here)
  project_root(in normal_path(here), out root)
  match main
    case (name, lines) =>
      var source: Source
      parse_texts(in root, dir, List(), List(for (m, ls) in members yield (module_in(dir, m), text_of(ls))), (module_in(dir, name), text_of(lines)), false, out source)
      require_parsed(in source)
      load_tester(ref source)
      check_tested(in source, out q)
      for (m, ls) in members do
        require_formatted(in source, module_in(dir, m), text_of(ls))
      end
      require_formatted(in source, source.main, text_of(lines))
  end

procedure check_texts(
  in  dir: Str,
      members: List[(Str, List[Str])],
      main: (Str, List[Str])
) raises ParseError, TypeError, Unformatted, InternalError, OsError :=
  load_texts(in dir, members, main, out _)

procedure run_texts(
  in  dir: Str,
      members: List[(Str, List[Str])],
      main: (Str, List[Str])
) raises ParseError, TypeError, Unformatted, InternalError, OsError, Thrown, RuntimeError :=
  var q: Prog
  load_texts(in dir, members, main, out q)
  run_program(in q)

// fails unless each error of the checker is a diagnostic of q, which check prints, by its position and code, so that a
// case catches an error that the tree of the checked program loses; the diagnostics come in the order of the tree,
// where a part that finds an error after checking its parts, a call, a match, or a command, stands before them, while
// the checker lists its errors in the order that it finds them, so the first of each may differ
procedure require_kept(in q: Prog, errors: List[TypeError]) raises InternalError :=
  let ds := diagnostics(q)
  for e in errors do
    let d := type_diagnostic(e)
    if not exists(ds, lambda k => k.pos == d.pos and k.code == d.code) then
      raise Unexpected("the error "
        ++ located_message(e)
        ++ " of the checker, which no diagnostic of the checked program has")
    end
  end
