// the running of tests: the tests of a module, each on its own in the interpreter of ulang/run/run.u, the proofs of its
// lemmas by ulang/prove/lemma.u, and the enumeration that the tests of lemmas of ulang/test/generate.u call, which
// load_tester loads into the program under test

import ulang.syntax
import ulang.check
import ulang.format
import ulang.parse
import ulang.run
import ulang.prove

export

// loads the enumeration of ulang/test/enumerate/enumerate.u into source, as the module enumerate_module, after the
// library, read through os_library from the directory next to the library, so that no second path is compiled in
procedure load_tester(ref source: Source) raises ParseError, OsError

// runs the tests of the module m of q, all or the named ones, each on its own, also after a failed one, printing a line per
// test after label, where passed tells whether all pass, and falsified are the lemmas whose tests found a counterexample,
// which prove_module neither proves nor takes as facts, and the line of a test that fails only by reaching an error of
// listed, the errors already printed with their files, names only its position (failure_text), and a test fails with
// TimedOut of ulang/syntax/error.u when it runs longer than timeout, its seconds; run is the interpreter of q, which the
// files of a unit share, and cache the values of its functions without parameters, which each test that passes keeps
// for the tests after it, since such a function has no effects and its value depends on nothing that a test changes,
// while a test that fails leaves it as before, as a ref is
procedure test_module(
  in  q: Prog,
      run: Run,
      m: Path,
      names: List[Str],
      timeout: Option[Int],
      label: Str,
      listed: List[(Str, Diagnostic)],
  out passed: Bool,
      falsified: Set[Str],
  ref cache: Map[Name, Val]
)

// the outcome of a test, its name, its error, "" if it passed, and the text of the error of checking that it reached,
// Deferred of ulang/syntax/error.u, if it failed by one
data Outcome :=
  case Outcome(name: Str, message: Str, reached: Option[Str])

// the outcomes of the tests of the module m of q, all or the named ones, run as test_module runs them by run and cache,
// without printing
procedure test_outcomes(
  in  q: Prog,
      run: Run,
      m: Path,
      names: List[Str],
  out outcomes: List[Outcome],
  ref cache: Map[Name, Val]
)

// the line of a test that failed, which names only the position of the error that it reached if listed, the errors
// printed before with their files, has it
function failure_text(o: Outcome, listed: List[(Str, Diagnostic)]): Str

// the prover of a checked program, which the files of a unit share: the program that the prover takes of it and the
// symbols of its translation
data Prover :=
  case Prover(provable: Provable, symbols: Symbols)

function prover_of(q: Prog): Prover

// proves the lemmas of the module m of the program of prover, of the file, all or the named ones, in their order, where
// those before are facts, but the falsified ones, which a test found false and which are neither proven nor facts,
// printing whether each is proven, open, or falsified, with an error of a proof for each gap and for each function
// that they reach whose termination is not proven, and whether all are proven
procedure prove_module(
  in  prover: Prover,
      m: Path,
      file: Str,
      names: List[Str],
      falsified: Set[Str],
      label: Str,
  out proven: Bool
)

// whether reached, the text of the error that a run reached, is that of d, of the file path, which a run names without its
// module if it is in the main module of the run, and else with it
function reaches(reached: Option[Str], path: Str, d: Diagnostic): Bool

implementation

procedure load_tester(ref source: Source) raises ParseError, OsError :=
  var text: Str
  os_library(in "../test/enumerate/enumerate", out text)
  load_after_library(in join("/", module_dir(enumerate_module())), List((enumerate_module(), text)), ref source)

procedure test_module(
  in  q: Prog,
      run: Run,
      m: Path,
      names: List[Str],
      timeout: Option[Int],
      label: Str,
      listed: List[(Str, Diagnostic)],
  out passed: Bool,
      falsified: Set[Str],
  ref cache: Map[Name, Val]
) :=
  var tests: List[Cmd], message: Str, refuted: Bool, reached: Option[Str]
  tests := List(for c in definitions(q) if is_selected_test(c, m, names)), passed := true, falsified := empty()
  for n in names if not exists(tests, lambda c => cmd_name(c) == n) do
    os_println(in label ++ error_text(RuntimeKind, "there is no test " ++ n))
    passed := false
  end
  for c in tests do
    var now: Int
    os_clock(out now)
    test_message(in run with deadline := map_option(timeout, lambda s => Deadline(now + s * 1000000000, s)), q, c, out message, refuted, reached, ref cache)
    falsified := if refuted then Set(lemma_of_test(cmd_name(c)); falsified) else falsified
    if message == "" then
      os_println(in label ++ "test " ++ cmd_name(c) ++ " passed")
    else
      os_println(in label ++ failure_text(Outcome(cmd_name(c), message, reached), listed))
      passed := false
    end
  end

function failure_text(o: Outcome, listed: List[(Str, Diagnostic)]): Str :=
  match find(listed, lambda (path, d) => reaches(o.reached, path, d))
    case Some((path, d)) =>
      "test "
        ++ o.name
        ++ " failed by reaching "
        ++ path
        ++ ":"
        ++ show(d.pos.line)
        ++ "."
        ++ show(d.pos.col)
        ++ ", listed above"

    case None =>
      "test " ++ o.name ++ " failed: " ++ o.message
  end

function reaches(reached: Option[Str], path: Str, d: Diagnostic): Bool :=
  match reached
    case Some(text) =>
      text == deferred_text(List(d with module := None))
        or text == deferred_text(List(
          d with module := Some(value_or(d.module, dir_path(slice(path, 0, size(path) - 2))))))

    case None =>
      false
  end

procedure test_outcomes(
  in  q: Prog,
      run: Run,
      m: Path,
      names: List[Str],
  out outcomes: List[Outcome],
  ref cache: Map[Name, Val]
) :=
  var message: Str, reached: Option[Str], found: Buffer[Outcome] := empty()
  for c in definitions(q) if is_selected_test(c, m, names) do
    test_message(in run with diverted := true, q, c, out message, _, reached, ref cache)
    found := found ++ List(Outcome(cmd_name(c), message, reached))
  end
  outcomes := List(for o in found)

// the error of the test cmd, or else "", whether it is a test of a lemma that found a counterexample, Falsified of the
// enumeration, which lemma_stmt of ulang/test/generate.u raises, and the text of the error of checking that it reached,
// where cache keeps the values of the functions without parameters that the test computed only if it passed
procedure test_message(
  in  run: Run,
      q: Prog,
      cmd: Cmd,
  out message: Str,
      falsified: Bool,
      reached: Option[Str],
  ref cache: Map[Name, Val]
) :=
  message := "", falsified := false, reached := None
  try
    run_cmd(in run, cmd, ref cache)
  catch
    case Uncaught(text) =>
      message := error_text(RuntimeKind, runtime_message(Uncaught(text))), falsified := ends_with(cmd_name(cmd), lemma_suffix())
        and starts_with(text, "Falsified(")

    case Deferred(text) =>
      message := error_text(RuntimeKind, runtime_message(Deferred(text))), reached := Some(text)

    case e =>
      message := value_or(example_failure(q, cmd, e), error_text(RuntimeKind, runtime_message(e)))

    case e =>
      message := error_text(InternalKind, internal_message(e))
  end

// the failure of the test of an example whose call gave another value than the example expects, by the call and both
// values, in the notation of the checked program q, as gcd(12, 18) gave 3, expected 6, and None of other failures
function example_failure(q: Prog, cmd: Cmd, e: RuntimeError): Option[Str] :=
  match (cmd, e)
    case (CTest(Owned(_, List(_, "example"), _), _, stmt), AssertionUnequal(left, right)) =>
      map_option(example_call(with_notation(builtin_notation(), commands_of(q.cmds ++ q.builtins)), stmt.that), lambda call => call ++ " gave " ++ left ++ ", expected " ++ right)
    case _ =>
      None
  end

// the call of the test of an example, the side of its equation that applies the function, or the call of the procedure
// with its ins and the refs before it, as example_stmt of ulang/check/check.u makes them
function example_call(notation: Notation, stmt: Stmt): Option[Str] :=
  match stmt
    case SAssert(AOk(_, _, ECall(_, _, Name(List(), "=="), _, List(lhs, _)))) =>
      Some(format_expr(notation, List(), "", lhs))

    case SBlock(_, stmts) =>
      let befores := List(for s in stmts for (_, before) in assigned(s.that) yield before) in
      let calls := List(for s in stmts for (proc, ins) in called(s.that) yield (proc, ins)) in
      match calls
        case List((proc, ins)) =>
          Some(proc.base
            ++ "("
            ++ join(", ", List(for (mode, exprs) in List(("in ", ins), ("ref ", befores)) if exprs != List() yield mode
              ++ join(", ", List(for expr in exprs yield format_expr(notation, List(), "", expr)))))
            ++ ")")

        case _ =>
          None
      end

    case _ =>
      None
  end

function assigned(stmt: Stmt): List[(Var, At[Expr])] :=
  match stmt
    case SAssign(upd) =>
      upd
    case _ =>
      List()
  end

function called(stmt: Stmt): Option[(Name, List[At[Expr]])] :=
  match stmt
    case SCall(proc, ins, _, _) =>
      Some((proc, ins))
    case _ =>
      None
  end

function prover_of(q: Prog): Prover :=
  let p := provable(q) in
  Prover(p, symbols_of(p.prog))

procedure prove_module(
  in  prover: Prover,
      m: Path,
      file: Str,
      names: List[Str],
      falsified: Set[Str],
      label: Str,
  out proven: Bool
) :=
  let
    p := prover.provable,
    t := translate_module(prover.symbols, m),
    refuted := Set(for l in t.lemmas if contains(l.name.base, falsified) yield l.name),
    selected := List(for l in t.lemmas if is_named(l.name.base, names) yield l),
    targets := Set(for l in selected if not contains(l.name, refuted) and not contains(l.name, p.broken) yield l.name),
    proofs := prove_lemmas(t.decls, t.contracts, Lemmas(t.lemmas, targets, refuted, p.broken, p.erroneous)),
    ds: List[Diagnostic] := proof_diagnostics(with_proofs(p.prog, m, proofs, names), m)
  proven := ds == List() and not exists(selected, lambda l => contains(l.name, refuted))
  for n in names if not exists(t.lemmas, lambda l => l.name.base == n) do
    os_println(in label ++ error_text(RuntimeKind, "there is no lemma " ++ n))
    proven := false
  end
  for d in ds if d.code == "OpenTermination" do
    os_println(in format_diagnostic(file, d))
  end
  // a lemma whose proof has errors is not proven, which its errors report
  for l in selected if not contains(l.name, p.broken) do
    match find(proofs.lemmas, lambda proved => proved.name == l.name)
      case Some(Proved(name, List())) =>
        match get(name, proofs.assumed)
          case Some(basis) =>
            os_println(in label
              ++ "lemma "
              ++ name.base
              ++ " proved, assuming "
              ++ basis.base
              ++ ", which is not established")
            for d in ds if get("lemma", d.details) == Some(name.base) do
              os_println(in format_diagnostic(file, d))
            end
            proven := false

          case None =>
            os_println(in label ++ "lemma " ++ name.base ++ " proved")
        end

      case Some(Proved(name, _)) =>
        os_println(in label ++ "lemma " ++ name.base ++ " open")
        for d in ds if d.code != "OpenTermination"
          and get("lemma", d.details) == Some(name.base) do
          os_println(in format_diagnostic(file, d))
        end

      case None =>
        os_println(in label ++ "lemma " ++ l.name.base ++ " falsified")
    end
  end

// whether names selects the lemma or test of the base name, all for List()
function is_named(base: Id, names: List[Str]): Bool :=
  names == List() or contains(base, names)

// the lemma l of its test l.lemma
function lemma_of_test(test_name: Str): Str :=
  example lemma_of_test("sorted.lemma") == "sorted"
  slice(test_name, 0, size(test_name) - size(lemma_suffix()))

// whether cmd is a test of the module m that names selects, all of them for List(), where a test with formals runs as
// the test that the tester generates of it
function is_selected_test(cmd: Cmd, m: Path, names: List[Str]): Bool :=
  match cmd
    case CTest(name, List(), _) =>
      name.path == m and (names == List() or contains(owned_text(name), names))
    case _ =>
      false
  end

function cmd_name(cmd: Cmd): Str :=
  match cmd
    case CTest(name, _, _) =>
      owned_text(name)
    case _ =>
      ""
  end

// the failure of an example names its call with the value that it gave and the value that the example expects
test example_failures() :=
  var
    own: Mod,
    q: Prog,
    outcomes: List[Outcome],
    cache: Map[Name, Val] := empty()
  let text := "data D :=\n  case A\n  case B\n\nfunction f(d: D): D :=\n  example f(A) == B\n  d\n\nprocedure p(in d: D, out e: D, ref r: D) :=\n  example p(in A, out B, ref A => B)\n  e := d\n"
  parse_text(in text, out own)
  check_program(in Source(List(own), List(), List("main")), out q)
  test_outcomes(in q, load(q), List("main"), List(), out outcomes, ref cache)
  assert outcomes == List(
    Outcome("f.example.1", "f(A) gave A, expected B", None),
    Outcome("p.example.1", "p(in A, ref A) gave (A, A), expected (B, B)", None))
