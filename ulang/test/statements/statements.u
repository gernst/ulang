// procedures, statements, and locals, the statement for over containers, and exceptions, raised and caught

procedure sum(in n: Int, out s: Int) :=
  var i: Int
  i := 0, s := 0
  while i < n do
    i := i + 1, s := s + i
  end

procedure total(in xs: List[Int], out s: Int) :=
  var ys: List[Int]
  s := 0, ys := xs
  while ys != List() do
    match ys
      case List(y; zs) =>
        s := s + y
        ys := zs

      case List() =>
        skip
    end
  end

procedure swap[A](ref x: A, y: A) :=
  x := y, y := x

procedure inc(ref x: Int) :=
  x := x + 1

procedure main(out a: Int, b: Int, c: Int) :=
  var f: Int -> Int
  a := 1, b := 2
  swap(ref a, b)
  inc(ref a)
  sum(in a, out c)
  f := lambda x => x + a
  if a > b then
    c := f(c)
  else
    if a == b then
      skip
    else
      c := 0
    end
  end

procedure capture(out r: Int) :=
  var i := 1
  let f := lambda x => x + i
  i := 10
  r := f(0)

test procedures() :=
  var a: Int, b: Int, c: Int
  sum(in 10, out c)
  assert c == 45
  total(in List(1, 2, 3), out c)
  assert c == 6
  a := 1, b := 2
  swap(ref a, b)
  assert (a, b) == (2, 1)
  inc(ref a)
  assert a == 3
  main(out a, b, c)
  assert (a, b, c) == (3, 1, 6)

// closures capture values, not variables
test closures_capture_values() :=
  var r: Int
  capture(out r)
  assert r == 1

test sums() :=
  var x: Int, y: Int
  sum(in 4, out x)
  y := x * 2
  assert (x, y) == (6, 12)

// the bodies of cases may declare variables, like those of if and while
test locals_in_cases() :=
  var n: Int
  match Some(3)
    case Some(m) =>
      let k := m * 2
      n := k + 1

    case None =>
      n := 0
  end
  assert n == 7
  try
    raise "x"
  catch
    case s =>
      let t := s
      assert t == "x"
  end

// procedures as values of the types (in A, out B, ref C), named or as lambdas
procedure double(in x: Int, out y: Int) :=
  y := 2 * x

procedure twice(in p: (in Int, out Int), x: Int, out z: Int) :=
  var y: Int
  p(in x, out y)
  p(in y, out z)

procedure each[A](in p: (in A, ref Int), xs: List[A], ref n: Int) :=
  match xs
    case List() =>
      skip

    case List(x; rest) =>
      p(in x, ref n)
      each(in p, rest, ref n)
  end

function step(by_two: Bool): (in Int, out Int) :=
  if by_two then
    double
  else
    lambda in x, out y =>
      y := x + 1
    end

test procedure_values() :=
  var z: Int, n := 0
  let k := 10, p := step(false)
  twice(in double, 3, out z)
  assert z == 12
  twice(in lambda in x, out y =>
    y := x + k
  end, 1, out z)
  assert z == 21
  each(in lambda in s, ref m =>
    m := m + size(s)
  end, List("a", "bc"), ref n)
  assert n == 3
  p(in 1, out z)
  assert z == 2
  twice(in step(true), 1, out z)
  assert z == 4

procedure sum_all(in xs: List[Int], out t: Int) :=
  var rest := xs, sum := 0
  while rest != List() do
    match rest
      case List(x; more) =>
        sum := sum + x, rest := more
      case List() =>
        skip
    end
  end
  t := sum

// the initial values are assigned in order, so each may refer to the locals before it
// a doc stands before a statement, also in a case and after else, at its indentation
procedure documented(in n: Int, out s: Int) :=
  let m := n
  // the first value
  s := 1
  if m > 0 then
    // a positive n
    s := 2
  else
    // nested, below else
    if m == 0 then
      skip
    end
  end
  match m
    case 3 =>
      // the third
      s := 3

    case _ =>
      skip
  end

test documented_statements() :=
  var s: Int
  documented(in 3, out s)
  assert s == 3

test initialized_locals() :=
  let a := 1, b := a + 1, c: Int := b * 2, s := "x"
  var t: Int
  sum_all(in List(a, b, c), out t)
  assert (a, b, c, s, t) == (1, 2, 4, "x", 7)

test inferred_types() :=
  let xs := List(Some(1), None), m := get("a", List(("a", true)))
  assert size(xs) == 2 and m == Some(true)

data Failed :=
  case Failed

// the outs of sign are assigned on every path, where a path that raises does not continue
procedure sign(in n: Int, out s: Int) raises Failed :=
  if n < 0 then
    s := -1
  else
    if n == 0 then
      raise Failed
    else
      s := 1
    end
  end

procedure first(in xs: List[Int], out x: Int) raises Failed :=
  match xs
    case List(y; _) =>
      x := y
    case List() =>
      raise Failed
  end

// an if after else is nested, with an end of its own, and statements may follow it in the else
procedure classify(in n: Int, out c: Str) :=
  if n < 0 then
    c := "negative"
  else
    if n == 0 then
      c := "zero"
    else
      c := "positive"
    end
    c := c ++ "!"
  end

test nested_ifs() :=
  var a: Str, b: Str, c: Str
  classify(in -1, out a)
  classify(in 0, out b)
  classify(in 12, out c)
  assert (a, b, c) == ("negative", "zero!", "positive!")

// a variable may be read where it is assigned on every path to the read
test definite_assignment() :=
  var a: Int, b: Int, c: Int, d: Int
  sign(in -5, out a)
  first(in List(7, 8), out b)
  try
    sign(in 0, out c)
  catch
    case Failed =>
      c := 0
  end
  if a < 0 then
    d := 1
  else
    d := 2
  end
  assert (a, b, c, d) == (-1, 7, 0, 1)

test keywords_after_conditions() :=
  var n := 0, m := 0
  while n < 3 do
    n := n + 1
  end
  while m < 2 do
    m := m + 1
  end
  if n == 3 then
    n := 10
  else
    if m == 1 then
      n := 20
    else
      n := 30
    end
  end
  if n == 10 then
    m := 0
  end
  assert n == 10 and m == 0

procedure split_at(
  in  n: Int,
      xs: List[Int],
  out before: List[Int],
      after: List[Int]
) :=
  before := take(n, xs), after := drop(n, xs)

// a local is declared where it stands, to the end of its body, each of a line in scope of those before it, and a pattern
// destructures its value
test locals_anywhere() :=
  var n := 1
  n := n + 1
  let m := n * 2, k: Int := m + 1
  assert (n, m, k) == (2, 4, 5)
  if n > 1 then
    n := 0
    // a doc of a local
    let (a, b) := (m, k), (c, _): Int * Int := (a + b, 0)
    assert c == 9
  end
  var xs, ys
  split_at(in 1, List(1, 2, 3), out xs, ys)
  assert (xs, ys, n) == (List(1), List(2, 3), 0)

// for p in c if q do … end runs its body for the elements of a container in the order of its fold
test for_lists() :=
  var sum := 0, seen: List[Int] := List()
  for x in List(1, 2, 3) do
    sum := sum + x
  end
  for x in List(1, 2, 3, 4) if x % 2 == 0 do
    seen := List(x; seen)
  end
  assert sum == 6 and seen == List(4, 2)

test for_patterns() :=
  var total := 0
  for (a, b) in List((1, 2), (3, 4)) do
    total := total + a * b
  end
  for (x, _) in List((5, 0), (6, 7)) do
    total := total + x
  end
  assert total == 2 + 12 + 5 + 6

test for_sets_and_maps() :=
  var text := "", sum := 0
  for x in Set(3, 1, 2) do
    text := text ++ show(x)
  end
  for (k, v) in Map(1 => 10, 2 => 20) if k > 1 do
    sum := sum + v
  end
  assert text == "123" and sum == 20

// for k => v in m binds key and value, and format keeps it so
test for_keys_arrays_and_options() :=
  var sum := 0, text := ""
  for k => v in Map(1 => 10, 2 => 20) if k > 1 do
    sum := sum + k + v
  end
  for c in Array('a', 'b') do
    text := text ++ str(List(c))
  end
  for x in Some(5) do
    sum := sum + x
  end
  assert sum == 27 and text == "ab"

test for_nested() :=
  var pairs: List[Int * Int] := List()
  for x in List(1, 2) do
    for y in Set(5, 6) do
      pairs := List((x, y); pairs)
    end
  end
  assert pairs == List((2, 6), (2, 5), (1, 6), (1, 5))

data Token :=
  case Num(num: Int)
  case Sym(op: Str)

data ParseError :=
  case Expected(what: Str)
  case Trailing(toks: List[Token])

procedure accept(in s: Str, ref ts: List[Token]) raises ParseError :=
  match ts
    case List(Sym(op); us) =>
      if op == s then
        ts := us
      else
        raise Expected(s)
      end

    case _ =>
      raise Expected(s)
  end

procedure number(out n: Int, ref ts: List[Token]) :=
  match ts
    case List(Num(num); us) =>
      n := num, ts := us
    case _ =>
      raise Expected("number")
  end

// (n), where the parentheses are optional
procedure atom(out n: Int, ref ts: List[Token]) :=
  try
    number(out n, ref ts)
  catch
    case Expected(_) =>
      accept(in "(", ref ts)
      atom(out n, ref ts)
      accept(in ")", ref ts)
  end

procedure parse(in ts: List[Token], out n: Int) :=
  var rest := ts
  atom(out n, ref rest)
  if rest != List() then
    raise Trailing(rest)
  end

// the result, or 0 if ts is not a number
procedure value(in ts: List[Token], out n: Int) :=
  try
    parse(in ts, out n)
  catch
    case Expected(_) =>
      n := 0
    case Trailing(_) =>
      n := 0
  end

data Fail :=
  case Fail

// the assignment to k does not reach the caller, which gets refs and outs only when a procedure returns
procedure count(ref k: Int) :=
  k := k + 1
  raise Fail

test parse_errors() :=
  var n: Int, k := 0
  parse(in List(Sym("("), Sym("("), Num(3), Sym(")"), Sym(")")), out n)
  assert n == 3
  assert raises Expected(")") do
    parse(in List(Sym("("), Num(3)), out n)
  end
  assert raises Trailing(List(Num(2))) do
    parse(in List(Num(1), Num(2)), out n)
  end
  value(in List(Sym(")")), out n)
  assert n == 0
  assert raises Fail do
    count(ref k)
  end
  assert k == 0

// assert raises passes if its body raises an exception that its pattern matches, of any type for _, where the variables
// after it are those before it, as in a handler, an exception that a try inside handles does not count, and one that
// the pattern does not match is raised further
test assert_raises() :=
  var k := 0, s := "a"
  assert raises Fail do
    k := 1, s := "b"
    count(ref k)
  end
  assert (k, s) == (0, "a")
  assert raises "x" do
    raise "x"
  end
  assert raises _ do
    raise 42
  end
  assert raises Expected("x") do
    try
      raise Expected("y")
    catch
      case Expected("y") =>
        raise Expected("x")
    end
  end
  assert raises Expected("y") do
    assert raises Expected("x") do
      raise Expected("y")
    end
  end

// a function without parameters whose computation raises computes again at its next use, instead of needing itself
function failing_constant(): Int :=
  1 / 0

test constant_raises_again() :=
  var n := 0
  assert raises DivisionByZero do
    n := failing_constant()
  end
  assert raises DivisionByZero do
    n := failing_constant()
  end

// handlers see the variables as they were before the try, also when compiled with optimizations
test restored_by_raise() :=
  var k := 0, n := 0
  try
    k := 1
    while n < 3 do
      n := n + 1
    end
    count(ref k)
  catch
    case Fail =>
      k := k + 10
  end
  assert (k, n) == (10, 0)

procedure half(out r: Int) :=
  r := 1
  raise Fail

procedure through(ref z: Int) :=
  half(out z)

// outs and refs assigned before an exception do not reach the caller
test atomic_outs_and_refs() :=
  var x := 0, y := 5
  try
    through(ref x)
  catch
    case Fail =>
      skip
  end
  try
    half(out y)
  catch
    case Fail =>
      skip
  end
  assert (x, y) == (0, 5)

// an exception that no case matches is raised further
test unmatched_raised_further() :=
  var e: Str
  try
    try
      raise Expected("x")
    catch
      case Expected("y") =>
        e := "y"
    end
  catch
    case Expected(what) =>
      e := what
  end
  assert e == "x"

// raises n if it is positive, and else a text
procedure positive(in n: Int) :=
  if n > 0 then
    raise n
  end
  raise "not positive"

// exceptions of any type, which cases catch only if the types agree, while _ catches all
test any_type() :=
  var n: Int, s: Str
  try
    raise 42
  catch
    case k =>
      n := k
  end
  assert n == 42
  try
    try
      positive(in 1)
    catch
      case t =>
        s := t ++ "!"
    end
  catch
    case k =>
      n := k + 1
  end
  assert n == 2
  try
    raise "x"
  catch
    case _ =>
      s := "caught"
  end
  assert s == "caught"

// a procedure value raises what its type allows, which a lambda takes from the formal it is given to
procedure attempt(in step: (in Int) raises Failed, n: Int, out ok: Bool) :=
  try
    step(in n)
    ok := true
  catch
    case Failed =>
      ok := false
  end

test procedure_values_raise() :=
  var ok: Bool
  let fails_below := lambda in n =>
    if n < 0 then
      raise Failed
    end
  end
  attempt(in fails_below, -1, out ok)
  assert not ok
  attempt(in fails_below, 1, out ok)
  assert ok

// handlers apply if their guards hold
test guarded_handlers() :=
  var n: Int
  try
    raise 2
  catch
    case k if k < 2 =>
      n := 0
    case k =>
      n := k
  end
  assert n == 2

data Shape :=
  case Circle(label: Str, radius: Int)
  case Box(label: Str)

// builtins and accessors of fields raise exceptions of the prelude
procedure failure(in k: Int, out m: Str) :=
  var x := 0
  m := "none"
  try
    match k
      case 0 =>
        x := 1 / 0

      case 1 =>
        x := 1 % 0

      case 2 =>
        x := int(at(2, "ab"))

      case 3 =>
        x := size(slice("ab", 1, 3))

      case 4 =>
        x := size(slice("ab", 2, 1))

      case 5 =>
        x := int(chr(-1))

      case _ =>
        x := Box("b").radius
    end
  catch
    case DivisionByZero =>
      m := "division"

    case OutOfBounds(index, count) =>
      m := show(index) ++ " of " ++ show(count)

    case NoCharacter(code) =>
      m := show(code)

    case MissingField(field) =>
      m := field
  end
  if m == "none" then
    m := show(x)
  end

test builtin_exceptions() :=
  var m: Str
  failure(in 0, out m)
  assert m == "division"
  failure(in 1, out m)
  assert m == "division"
  failure(in 2, out m)
  assert m == "2 of 2"
  failure(in 3, out m)
  assert m == "3 of 2"
  failure(in 4, out m)
  assert m == "2 of 2"
  failure(in 5, out m)
  assert m == "-1"
  failure(in 6, out m)
  assert m == "Shape.radius"
  assert slice("ab", 0, 2) == "ab" and slice("ab", 2, 2) == ""
