// procedures, statements, and locals, the statement for over containers, and exceptions, raised and caught

procedure sum(in n: Int, out s: Int) :=
  local i: Int
  assign i := 0, s := 0
  while i < n do
    assign i := i + 1, s := s + i
  end

procedure total(in xs: List[Int], out s: Int) :=
  local ys: List[Int]
  assign s := 0, ys := xs
  while ys != List() do
    match ys
      case List(y; zs) =>
        assign s := s + y
        assign ys := zs

      case List() =>
        skip
    end
  end

procedure swap[A](ref x: A, y: A) :=
  assign x := y, y := x

procedure inc(ref x: Int) :=
  assign x := x + 1

procedure main(out a: Int, b: Int, c: Int) :=
  local f: Int -> Int
  assign a := 1, b := 2
  call   swap(ref a, b)
  call   inc(ref a)
  call   sum(in a, out c)
  assign f := lambda x => x + a
  if a > b then
    assign c := f(c)
  else
    if a == b then
      skip
    else
      assign c := 0
    end
  end

procedure capture(out r: Int) :=
  local i := 1, f := (lambda x => x + i)
  assign i := 10
  assign r := f(0)

test procedures() :=
  local a: Int, b: Int, c: Int
  call sum(in 10, out c)
  assert c == 45
  call total(in List(1, 2, 3), out c)
  assert c == 6
  assign a := 1, b := 2
  call   swap(ref a, b)
  assert (a, b) == (2, 1)
  call inc(ref a)
  assert a == 3
  call main(out a, b, c)
  assert (a, b, c) == (3, 1, 6)

// closures capture values, not variables
test closures_capture_values() :=
  local r: Int
  call capture(out r)
  assert r == 1

test sums() :=
  local x: Int, y: Int
  call   sum(in 4, out x)
  assign y := x * 2
  assert (x, y) == (6, 12)

// the bodies of cases may declare variables, like those of if and while
test locals_in_cases() :=
  local n: Int
  match Some(3)
    case Some(m) =>
      local k := m * 2
      assign n := k + 1

    case None =>
      assign n := 0
  end
  assert n == 7
  try
    raise "x"
  catch
    case s =>
      local t := s
      assert t == "x"
  end

// procedures as values of the types (in A, out B, ref C), named or as lambdas
procedure double(in x: Int, out y: Int) :=
  assign y := 2 * x

procedure twice(in p: (in Int, out Int), x: Int, out z: Int) :=
  local y: Int
  call p(in x, out y)
  call p(in y, out z)

procedure each[A](in p: (in A, ref Int), xs: List[A], ref n: Int) :=
  match xs
    case List() =>
      skip

    case List(x; rest) =>
      call p(in x, ref n)
      call each(in p, rest, ref n)
  end

function step(by_two: Bool): (in Int, out Int) :=
  if by_two then
    double
  else
    lambda in x, out y =>
      assign y := x + 1
    end

test procedure_values() :=
  local z: Int, n := 0, k := 10, p := step(false)
  call twice(in double, 3, out z)
  assert z == 12
  call twice(in lambda in x, out y =>
    assign y := x + k
  end, 1, out z)
  assert z == 21
  call each(in lambda in s, ref m =>
    assign m := m + size(s)
  end, List("a", "bc"), ref n)
  assert n == 3
  call p(in 1, out z)
  assert z == 2
  call twice(in step(true), 1, out z)
  assert z == 4

procedure sum_all(in xs: List[Int], out t: Int) :=
  local rest := xs, sum := 0
  while rest != List() do
    match rest
      case List(x; more) =>
        assign sum := sum + x, rest := more
      case List() =>
        skip
    end
  end
  assign t := sum

// the initial values are assigned in order, so each may refer to the locals before it
test initialized_locals() :=
  local a := 1, b := a + 1, c: Int := b * 2, s := "x", t: Int
  call sum_all(in List(a, b, c), out t)
  assert (a, b, c, s, t) == (1, 2, 4, "x", 7)

test inferred_types() :=
  local xs := List(Some(1), None), m := get("a", List(("a", true)))
  assert size(xs) == 2 and m == Some(true)

data Failed :=
  case Failed

// the outs of sign are assigned on every path, where a path that raises does not continue
procedure sign(in n: Int, out s: Int) :=
  if n < 0 then
    assign s := -1
  else
    if n == 0 then
      raise Failed
    else
      assign s := 1
    end
  end

procedure first(in xs: List[Int], out x: Int) :=
  match xs
    case List(y; _) =>
      assign x := y
    case List() =>
      raise Failed
  end

// an if after else is nested, with an end of its own, and statements may follow it in the else
procedure classify(in n: Int, out c: Str) :=
  if n < 0 then
    assign c := "negative"
  else
    if n == 0 then
      assign c := "zero"
    else
      assign c := "positive"
    end
    assign c := c ++ "!"
  end

test nested_ifs() :=
  local a: Str, b: Str, c: Str
  call classify(in -1, out a)
  call classify(in 0, out b)
  call classify(in 12, out c)
  assert (a, b, c) == ("negative", "zero!", "positive!")

// a variable may be read where it is assigned on every path to the read
test definite_assignment() :=
  local a: Int, b: Int, c: Int, d: Int
  call sign(in -5, out a)
  call first(in List(7, 8), out b)
  try
    call sign(in 0, out c)
  catch
    case Failed =>
      assign c := 0
  end
  if a < 0 then
    assign d := 1
  else
    assign d := 2
  end
  assert (a, b, c, d) == (-1, 7, 0, 1)

test keywords_after_conditions() :=
  local n := 0, m := 0
  while n < 3 do
    assign n := n + 1
  end
  while m < 2 do
    assign m := m + 1
  end
  if n == 3 then
    assign n := 10
  else
    if m == 1 then
      assign n := 20
    else
      assign n := 30
    end
  end
  if n == 10 then
    assign m := 0
  end
  assert n == 10 and m == 0

// for p in c if q do … end runs its body for the elements of a container in the order of its fold
test for_lists() :=
  local sum := 0, seen: List[Int] := List()
  for x in List(1, 2, 3) do
    assign sum := sum + x
  end
  for x in List(1, 2, 3, 4) if x % 2 == 0 do
    assign seen := List(x; seen)
  end
  assert sum == 6 and seen == List(4, 2)

test for_patterns() :=
  local total := 0
  for (a, b) in List((1, 2), (3, 4)) do
    assign total := total + a * b
  end
  for (x, _) in List((5, 0), (6, 7)) do
    assign total := total + x
  end
  assert total == 2 + 12 + 5 + 6

test for_sets_and_maps() :=
  local text := "", sum := 0
  for x in Set(3, 1, 2) do
    assign text := text ++ show(x)
  end
  for (k, v) in Map(1 => 10, 2 => 20) if k > 1 do
    assign sum := sum + v
  end
  assert text == "123" and sum == 20

test for_nested() :=
  local pairs: List[Int * Int] := List()
  for x in List(1, 2) do
    for y in Set(5, 6) do
      assign pairs := List((x, y); pairs)
    end
  end
  assert pairs == List((2, 6), (2, 5), (1, 6), (1, 5))

data Token :=
  case Num(num: Int)
  case Sym(op: Str)

data ParseError :=
  case Expected(what: Str)
  case Trailing(toks: List[Token])

procedure accept(in s: Str, ref ts: List[Token]) :=
  match ts
    case List(Sym(op); us) =>
      if op == s then
        assign ts := us
      else
        raise Expected(s)
      end

    case _ =>
      raise Expected(s)
  end

procedure number(out n: Int, ref ts: List[Token]) :=
  match ts
    case List(Num(num); us) =>
      assign n := num, ts := us
    case _ =>
      raise Expected("number")
  end

// (n), where the parentheses are optional
procedure atom(out n: Int, ref ts: List[Token]) :=
  try
    call number(out n, ref ts)
  catch
    case Expected(_) =>
      call accept(in "(", ref ts)
      call atom(out n, ref ts)
      call accept(in ")", ref ts)
  end

procedure parse(in ts: List[Token], out n: Int) :=
  local rest := ts
  call atom(out n, ref rest)
  if rest != List() then
    raise Trailing(rest)
  end

// the result, or 0 if ts is not a number
procedure value(in ts: List[Token], out n: Int) :=
  try
    call parse(in ts, out n)
  catch
    case Expected(_) =>
      assign n := 0
    case Trailing(_) =>
      assign n := 0
  end

data Fail :=
  case Fail

// the assignment to k does not reach the caller, which gets refs and outs only when a procedure returns
procedure count(ref k: Int) :=
  assign k := k + 1
  raise Fail

test parse_errors() :=
  local n: Int, k := 0
  call parse(in List(Sym("("), Sym("("), Num(3), Sym(")"), Sym(")")), out n)
  assert n == 3
  assert raises Expected(")") do
    call parse(in List(Sym("("), Num(3)), out n)
  end
  assert raises Trailing(List(Num(2))) do
    call parse(in List(Num(1), Num(2)), out n)
  end
  call value(in List(Sym(")")), out n)
  assert n == 0
  assert raises Fail do
    call count(ref k)
  end
  assert k == 0

// assert raises passes if its body raises an exception that its pattern matches, of any type for _, where the variables
// after it are those before it, as in a handler, and an exception that a try inside handles does not count
test assert_raises() :=
  local k := 0, s := "a"
  assert raises Fail do
    assign k := 1, s := "b"
    call   count(ref k)
  end
  assert (k, s) == (0, "a")
  assert raises "x" do
    raise "x"
  end
  assert raises _ do
    raise 42
  end
  assert raises Expected("x") do
    try
      raise Expected("y")
    catch
      case Expected("y") =>
        raise Expected("x")
    end
  end

// handlers see the variables as they were before the try, also when compiled with optimizations
test restored_by_raise() :=
  local k := 0, n := 0
  try
    assign k := 1
    while n < 3 do
      assign n := n + 1
    end
    call count(ref k)
  catch
    case Fail =>
      assign k := k + 10
  end
  assert (k, n) == (10, 0)

procedure half(out r: Int) :=
  assign r := 1
  raise Fail

procedure through(ref z: Int) :=
  call half(out z)

// outs and refs assigned before an exception do not reach the caller
test atomic_outs_and_refs() :=
  local x := 0, y := 5
  try
    call through(ref x)
  catch
    case Fail =>
      skip
  end
  try
    call half(out y)
  catch
    case Fail =>
      skip
  end
  assert (x, y) == (0, 5)

// an exception that no case matches is raised further
test unmatched_raised_further() :=
  local e: Str
  try
    try
      raise Expected("x")
    catch
      case Expected("y") =>
        assign e := "y"
    end
  catch
    case Expected(what) =>
      assign e := what
  end
  assert e == "x"

// exceptions of any type, which cases catch only if the types agree, while _ catches all
test any_type() :=
  local n: Int, s: Str
  try
    raise 42
  catch
    case k =>
      assign n := k
  end
  assert n == 42
  try
    try
      raise Some(1)
    catch
      case Some(t) =>
        assign s := t
    end
  catch
    case Some(k) =>
      assign n := k + 1
  end
  assert n == 2
  try
    raise "x"
  catch
    case _ =>
      assign s := "caught"
  end
  assert s == "caught"

// handlers apply if their guards hold
test guarded_handlers() :=
  local n: Int
  try
    raise 2
  catch
    case k if k < 2 =>
      assign n := 0
    case k =>
      assign n := k
  end
  assert n == 2

data Shape :=
  case Circle(label: Str, radius: Int)
  case Box(label: Str)

// builtins and accessors of fields raise exceptions of the prelude
procedure failure(in k: Int, out m: Str) :=
  local x := 0
  assign m := "none"
  try
    match k
      case 0 =>
        assign x := 1 / 0

      case 1 =>
        assign x := 1 % 0

      case 2 =>
        assign x := ord(at(2, "ab"))

      case 3 =>
        assign x := size(slice("ab", 1, 3))

      case 4 =>
        assign x := size(slice("ab", 2, 1))

      case 5 =>
        assign x := ord(chr(-1))

      case _ =>
        assign x := Box("b").radius
    end
  catch
    case DivisionByZero =>
      assign m := "division"

    case OutOfBounds(index, count) =>
      assign m := show(index) ++ " of " ++ show(count)

    case NoCharacter(code) =>
      assign m := show(code)

    case MissingField(field) =>
      assign m := field
  end
  if m == "none" then
    assign m := show(x)
  end

test builtin_exceptions() :=
  local m: Str
  call failure(in 0, out m)
  assert m == "division"
  call failure(in 1, out m)
  assert m == "division"
  call failure(in 2, out m)
  assert m == "2 of 2"
  call failure(in 3, out m)
  assert m == "3 of 2"
  call failure(in 4, out m)
  assert m == "2 of 2"
  call failure(in 5, out m)
  assert m == "-1"
  call failure(in 6, out m)
  assert m == "Shape.radius"
  assert slice("ab", 0, 2) == "ab" and slice("ab", 2, 2) == ""
