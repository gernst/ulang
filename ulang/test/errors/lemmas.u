// the lemmas that the default proof of ulang/prove/lemma.u leaves open, or whose tests on enumerated values fail, and the
// tests with formals that fail on enumerated values, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/prove"
import "ulang/test/cases"

test append_commutes() :=
  assert raises OpenLemma("append_commutes", "forall xs, ys => (ys ++ xs) == (xs ++ ys)") do
    prove_text(in "ulang/test/errors/append-commutes.u", List(
      "lemma append_commutes[A](in xs: List[A], ys: List[A]) :=",
      "  ensures xs ++ ys == ys ++ xs"))
  end

test falsified() :=
  assert raises Uncaught("Falsified(\"xs = List(1, 0), ys = List()\")") do
    run_text(in "ulang/test/errors/falsified.u", List(
      "lemma reverse_same(in xs: List[Int], ys: List[Int]) :=",
      "  ensures reverse(xs) ++ ys == xs ++ ys"))
  end

// a test with formals fails with the values of its formals and both sides of the equation
test falsified_test() :=
  assert raises Uncaught("Falsified(\"xs = List(0, 0, 1): List(1, 0, 0) != List(0, 0, 1)\")") do
    run_text(in "ulang/test/errors/falsified-test.u", List("test reverse_same(xs: List[Int]) :=", "  assert reverse(xs) == xs"))
  end

// an assertion in the body of a try fails as an assertion, which the handler cannot catch, without the values
test falsified_in_try() :=
  assert raises AssertionUnequal("1", "0") do
    run_text(in "ulang/test/errors/falsified-in-try.u", List(
      "test caught(n: Int) :=",
      "  try",
      "    assert n == 0",
      "    raise n",
      "  catch",
      "    case _ =>",
      "      skip",
      "  end"))
  end

// a test with a formal of a type without enumeration fails with those formals
test unenumerable() :=
  assert raises Uncaught("Unenumerable(\"f\")") do
    run_text(in "ulang/test/errors/unenumerable.u", List("test applied(f: Int -> Int, n: Int) :=", "  assert f(n) == f(n)"))
  end

// an out of the lemma bound by a call is no longer existential, so that its fact does not hold of another variable
test call_binds_out() :=
  assert raises OpenLemma("bound_out", "forall x => false at 7.3") do
    prove_text(in "ulang/test/errors/call-binds-out.u", List(
      "lemma shifted(in x: Int, out y: Int) :=",
      "  ensures y == x + 5",
      "  y := x + 5",
      "",
      "lemma bound_out(in x: Int, out y: Int) :=",
      "  ensures y != y",
      "  let z := x + 1",
      "  shifted(in x, out y)"))
  end

test irreflexive() :=
  assert raises OpenLemma("irreflexive", "forall a => false") do
    prove_text(in "ulang/test/errors/irreflexive.u", List("lemma irreflexive(in a: Int) :=", "  ensures a < a"))
  end

test less_by_two() :=
  assert raises OpenLemma("less_by_two", "forall a, b => a < b ==> b < (a + 2)") do
    prove_text(in "ulang/test/errors/less-by-two.u", List(
      "lemma less_by_two(in a: Int, b: Int) :=",
      "  requires a < b",
      "  ensures  b < a + 2"))
  end

test integer_infeasible() :=
  assert raises OpenLemma("integer_infeasible", "forall x, y => 27 <= (11 * x + 13 * y) and (11 * x + 13 * y) <= 45 and (-10) <= (7 * x - 9 * y) and (7 * x - 9 * y) <= 4 ==> false") do
    prove_text(in "ulang/test/errors/integer-infeasible.u", List(
      "lemma integer_infeasible(in x: Int, y: Int) :=",
      "  requires 27 <= 11 * x + 13 * y, 11 * x + 13 * y <= 45, (-10) <= 7 * x - 9 * y, 7 * x - 9 * y <= 4",
      "  ensures  false"))
  end

// equal sets of different shapes, which would be refuted as distinct constructors if those of abstract types were free
test abstract_constructors() :=
  assert raises OpenLemma("abstract_constructors", "Node(Node(Leaf, 1, Leaf, 1), 2, Leaf, 2) != Node(Leaf, 1, Node(Leaf, 2, Leaf, 1), 2)") do
    prove_text(in "ulang/test/errors/abstract-constructors.u", List("lemma abstract_constructors() :=", "  ensures Set(1, 2) != Set(2, 1)"))
  end

// the recursive functions of the library whose termination the prover does not prove: distinct recurses on a
// comprehension, sort on take and drop of half its list, and separated on joined_pairs, which need lemmas of their
// sizes, and list_count and list_values of the enumeration, which load_text loads with the library, count n down to
// n == 0, so they do not terminate for a negative n, while gcd terminates by the absolute value of its divisor
test library_terminates() :=
  var main: Id, q: Prog, open: List[Str] := List()
  load_text(in "ulang/test/errors/library-terminates.u", List("lemma trivial() :=", "  ensures true"), out main, q)
  match translate(q, main)
    case Translation(decls, _, _) =>
      open := List(for t in terminations(decls, Set(for k => d in decls.defs if d.recursive yield k)) if not is_terminating(t) for (n, _) in t.names yield n.base)
  end
  assert Set(for n in open) == Set("distinct", "separated", "sort", "list_count", "list_values")

// a function that does not terminate is open, one that counts down to a guard terminates by its Int measure
test terminations_of_program() :=
  var main: Id, q: Prog, open: List[Str] := List(), proven: List[Str] := List()
  load_text(in "ulang/test/errors/terminations-of-program.u", List(
    "function loop(x: Int): Int :=",
    "  loop(x) + 1",
    "",
    "function down(n: Int): Int :=",
    "  if n <= 0 then 0 else down(n - 1) + 1"), out main, q)
  match translate(q, main)
    case Translation(decls, _, _) =>
      let ts := terminations(decls, Set((Name(Some(main), "loop"), 1), (Name(Some(main), "down"), 1)))
      open := List(for t in ts if not is_terminating(t) for (n, _) in t.names yield n.base), proven := List(for t in ts if is_terminating(t) for (n, _) in t.names yield n.base)
  end
  assert open == List("loop") and proven == List("down")

// a function that a lemma reaches and whose termination is not proven is an error at the call that does not decrease,
// and stays uninterpreted for the lemma, though the if of its body is decided, so that loop(0) == 0 stays open
test nonterminating_function() :=
  assert raises OpenTermination("loop", "loop(x) where x == x") do
    prove_text(in "ulang/test/errors/nonterminating-function.u", List(
      "function loop(x: Int): Int :=",
      "  if x == x then loop(x) + 1 else 0",
      "",
      "lemma loop_zero() :=",
      "  ensures loop(0) == 0"))
  end

test vacuous() :=
  assert raises Uncaught("Vacuous") do
    run_text(in "ulang/test/errors/vacuous.u", List("lemma large(in n: Int) :=", "  requires n > 100", "  ensures  n > 0"))
  end

// the sign of a remainder follows that of its dividend, since / truncates towards zero, so it is open without it
test remainder_unsigned() :=
  assert raises OpenLemma("remainder_unsigned", "forall m => 0 <= (m % 3)") do
    prove_text(in "ulang/test/errors/remainder-unsigned.u", List("lemma remainder_unsigned(in m: Int) :=", "  ensures m % 3 >= 0"))
  end

// only squares are at least 0
test product_unsigned() :=
  assert raises OpenLemma("product_unsigned", "forall x, y => 0 <= (x * y)") do
    prove_text(in "ulang/test/errors/product-unsigned.u", List("lemma product_unsigned(in x: Int, y: Int) :=", "  ensures x * y >= 0"))
  end

// disequalities in conclusions are assumptions, also in a disjunction, where the one-point rule then eliminates the
// variables that their equations give, so that the counterexample a == b, xs == List() leaves false
test distinct_open() :=
  assert raises OpenLemma("distinct_open", "forall a => false") do
    prove_text(in "ulang/test/errors/distinct-open.u", List(
      "lemma distinct_open(in a: Int, b: Int, xs: List[Int]) :=",
      "  ensures a != b or xs != List()"))
  end

// an open goal keeps the call of a function that is not recursive whose body stays undecided, while the proof unfolds it
test lazy_goal() :=
  assert raises OpenLemma("maximum_open", "forall a, b, c => c <= maximum(a, b)") do
    prove_text(in "ulang/test/errors/lazy-goal.u", List(
      "function maximum(a: Int, b: Int): Int :=",
      "  if a < b then b else a",
      "",
      "lemma maximum_open(in a: Int, b: Int, c: Int) :=",
      "  ensures maximum(a, b) >= c"))
  end

// a cut that does not follow, at its step
test proof_open_assert() :=
  assert raises OpenLemma("open_assert", "forall x => 0 < x at 3.3") do
    prove_text(in "ulang/test/errors/proof-open-assert.u", List(
      "lemma open_assert(in x: Int) :=",
      "  ensures x == x",
      "  assert x > 0"))
  end

// an open goal names the definitions of the proof where it has their values, and leaves out those that it no longer has,
// here p, whose value a * b is folded into q first
test proof_definitions_named() :=
  assert raises OpenLemma("named", "forall a, b, q => b < q at 4.3") do
    prove_text(in "ulang/test/errors/proof-definitions-named.u", List(
      "lemma named(in a: Int, b: Int) :=",
      "  ensures true",
      "  let p := a * b, q := p + a",
      "  assert q > b"))
  end

// a call of the lemma itself outside the case of an induction
test proof_self_call() :=
  assert raises OpenLemma("self_call", "the lemma calls itself only at a recursive field of the case of its induction, with the formals of the inductions before it unchanged at 3.3") do
    prove_text(in "ulang/test/errors/proof-self-call.u", List(
      "lemma self_call(in x: Int) :=",
      "  ensures x == x",
      "  self_call(in x)"))
  end

// a call of a lemma that comes after the one that calls it
test proof_later_call() :=
  assert raises OpenLemma("early", "the lemma late is not proven before this one at 3.3") do
    prove_text(in "ulang/test/errors/proof-later-call.u", List(
      "lemma early(in x: Int) :=",
      "  ensures x == x",
      "  late(in x)",
      "",
      "lemma late(in x: Int) :=",
      "  ensures x == x"))
  end

// a case of an induction that is not written must close by simplification
test proof_open_case() :=
  assert raises OpenLemma("open_case", "forall head, tail => size(tail) == 0 ==> false at 3.3") do
    prove_text(in "ulang/test/errors/proof-open-case.u", List(
      "lemma open_case(in xs: List[Int]) :=",
      "  ensures size(xs) == 0",
      "  induction xs",
      "  end"))
  end

// a witness for which the ensures does not hold
test proof_false_witness() :=
  assert raises OpenLemma("false_witness", "forall x => false at 3.3") do
    prove_text(in "ulang/test/errors/proof-false-witness.u", List(
      "lemma false_witness(in x: Int, out y: Int) :=",
      "  ensures y == x + 1",
      "  y := x"))
  end

// induction on an integer without the requires that n >= 0 leaves the case n < 0
test proof_int_negative() :=
  assert raises OpenLemma("replicate_any", "forall n, x => n < 0 ==> false at 3.3") do
    prove_text(in "ulang/test/errors/proof-int-negative.u", List(
      "lemma replicate_any(in n: Int, x: Int) :=",
      "  ensures size(replicate(n, x)) == n",
      "  induction n",
      "    case _ =>",
      "      replicate_any(in n - 1, x)",
      "  end"))
  end

// a claim whose ensures does not follow from the invariant at the exit of the loop, open at the ensures
test claim_wrong_ensures() :=
  assert raises OpenLemma("sum_correct", "forall s, n, i, i' => i <= n and (-i' + (i' * i')) == (2 * s) and i' <= n and n <= i' ==> (2 * s) == (2 * s + 2 * i') at 3.18") do
    prove_text(in "ulang/test/errors/claim-wrong-ensures.u", List(
      "procedure sum(in n: Int, out s: Int) :=",
      "  requires n >= 0",
      "  ensures  2 * s == n * (n + 1)",
      "  var i := 0",
      "  s := 0",
      "  while i < n do",
      "    s := s + i, i := i + 1",
      "  end",
      "",
      "lemma sum_correct(in n: Int, out s: Int) :=",
      "  correct sum(in n, out s)",
      "  invariant 2 * s == i * (i - 1) and i <= n"))
  end

// an invariant that the body of its loop does not preserve, open at the invariant
test claim_not_preserved() :=
  assert raises OpenLemma("p_correct", "forall y, y', y'' => y' <= 3 and y' < 3 ==> y'' <= 3 at 10.15") do
    prove_text(in "ulang/test/errors/claim-not-preserved.u", List(
      "procedure p(out y: Int) :=",
      "  ensures y == 3",
      "  y := 0",
      "  while y < 3 do",
      "    y := y + 2",
      "  end",
      "",
      "lemma p_correct(out y: Int) :=",
      "  correct p(out y)",
      "  invariant y <= 3"))
  end

// the requires of a call, which the caller must establish
test claim_call_requires() :=
  assert raises OpenLemma("q_correct", "forall x, y => (exists y' => 0 < x) at 7.3") do
    prove_text(in "ulang/test/errors/claim-call-requires.u", List(
      "procedure p(in x: Int, out y: Int) :=",
      "  requires x > 0",
      "  ensures  y == x",
      "  y := x",
      "",
      "procedure q(in x: Int, out y: Int) :=",
      "  p(in x, out y)",
      "",
      "lemma q_correct(in x: Int, out y: Int) :=",
      "  correct q(in x, out y)"))
  end

// a claim holds for the runs that end, so ensures false of a loop that does not end is proven, but is no fact of the
// lemmas after it, which would else all be proven
test claim_no_fact() :=
  assert raises OpenLemma("after", "forall n => false") do
    prove_text(in "ulang/test/errors/claim-no-fact.u", List(
      "procedure forever(out x: Int) :=",
      "  ensures false",
      "  x := 0",
      "  while true do",
      "    skip",
      "  end",
      "",
      "lemma forever_correct(out x: Int) :=",
      "  correct forever(out x)",
      "",
      "lemma after(in n: Int) :=",
      "  ensures n == n + 1"))
  end

// nested inductions on different formals argue in a cycle, (List(), List(1)) from (List(1), List()) from (List(),
// List(1)), unless the inner hypothesis keeps the formal of the outer one at its value
test nested_inductions() :=
  assert raises OpenLemma("nested", "the lemma calls itself only at a recursive field of the case of its induction, with the formals of the inductions before it unchanged at 7.11") do
    prove_text(in "ulang/test/errors/nested-inductions.u", List(
      "lemma nested(in xs: List[Int], ys: List[Int]) :=",
      "  ensures xs == List() and ys == List()",
      "  induction xs",
      "    case List() =>",
      "      induction ys",
      "        case List(y; t) =>",
      "          nested(in List(1), t)",
      "      end",
      "",
      "    case List(h; t) =>",
      "      nested(in t, List(1))",
      "  end"))
  end

// inductions on different formals in different cases argue in a cycle as nested ones do, so the order of the formals
// is that of their first inductions in the whole proof
test sibling_inductions() :=
  assert raises OpenLemma("sibling", "the lemma calls itself only at a recursive field of the case of its induction, with the formals of the inductions before it unchanged at 13.11") do
    prove_text(in "ulang/test/errors/sibling-inductions.u", List(
      "lemma sibling(in xs: List[Int], ys: List[Int]) :=",
      "  ensures xs == List() and ys == List()",
      "  match ys",
      "    case List() =>",
      "      induction xs",
      "        case List(h; t) =>",
      "          sibling(in t, List(1))",
      "      end",
      "",
      "    case List(y; r) =>",
      "      induction ys",
      "        case List(z; t) =>",
      "          sibling(in List(1), t)",
      "      end",
      "  end"))
  end
