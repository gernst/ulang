// the lemmas that the default proof of ulang/prove/lemma.u leaves open, or whose tests on enumerated values fail, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/prove"
import "ulang/test/cases"

test append_commutes() :=
  assert raises OpenLemma("append_commutes", "forall xs, ys => (ys ++ xs) == (xs ++ ys)") do
    call prove_text(in "ulang/test/errors/append-commutes.u", List(
      "lemma append_commutes[A](in xs: List[A], ys: List[A]) :=",
      "  ensures xs ++ ys == ys ++ xs"))
  end

test falsified() :=
  assert raises Uncaught("Falsified(\"xs = List(1, 0), ys = List()\")") do
    call run_text(in "ulang/test/errors/falsified.u", List(
      "lemma reverse_same(in xs: List[Int], ys: List[Int]) :=",
      "  ensures reverse(xs) ++ ys == xs ++ ys"))
  end

test irreflexive() :=
  assert raises OpenLemma("irreflexive", "forall a => false") do
    call prove_text(in "ulang/test/errors/irreflexive.u", List("lemma irreflexive(in a: Int) :=", "  ensures a < a"))
  end

test less_by_two() :=
  assert raises OpenLemma("less_by_two", "forall a, b => a < b ==> b < (a + 2)") do
    call prove_text(in "ulang/test/errors/less-by-two.u", List(
      "lemma less_by_two(in a: Int, b: Int) :=",
      "  requires a < b",
      "  ensures  b < a + 2"))
  end

test integer_infeasible() :=
  assert raises OpenLemma("integer_infeasible", "forall x, y => (not (11 * x + 13 * y) < 27) and (not 45 < (11 * x + 13 * y)) and (not (7 * x - 9 * y) < (-10)) and (not 4 < (7 * x - 9 * y)) ==> false") do
    call prove_text(in "ulang/test/errors/integer-infeasible.u", List(
      "lemma integer_infeasible(in x: Int, y: Int) :=",
      "  requires 27 <= 11 * x + 13 * y, 11 * x + 13 * y <= 45, (-10) <= 7 * x - 9 * y, 7 * x - 9 * y <= 4",
      "  ensures  false"))
  end

// equal sets of different shapes, which would be refuted as distinct constructors if those of abstract types were free
test abstract_constructors() :=
  assert raises OpenLemma("abstract_constructors", "not Node(Node(Leaf, 1, Leaf, 1), 2, Leaf, 2) == Node(Leaf, 1, Node(Leaf, 2, Leaf, 1), 2)") do
    call prove_text(in "ulang/test/errors/abstract-constructors.u", List("lemma abstract_constructors() :=", "  ensures Set(1, 2) != Set(2, 1)"))
  end

// the recursive functions of the library whose termination the prover does not prove: distinct recurses on a
// comprehension, sort on take and drop of half its list, and separated on joined_pairs, which need lemmas of their
// sizes, gcd on a remainder, which needs its bounds (prover.md, D6), and list_count and list_values of
// ulang/prelude/enumerate.u count n down to n == 0, so they do not terminate for a negative n
test library_terminates() :=
  local main: Id, q: Prog, open: List[Str] := List()
  call load_text(in "ulang/test/errors/library-terminates.u", List("lemma trivial() :=", "  ensures true"), out main, q)
  match translate(q, main)
    case Translation(decls, _) =>
      assign open := List(for t in terminations(decls, Set(for k => d in decls.defs if d.recursive yield k)) if not is_terminating(t) for (n, _) in t.names yield n.base)
  end
  assert Set(for n in open) == Set("distinct", "separated", "sort", "gcd", "list_count", "list_values")

// a function that does not terminate is open, one that counts down to a guard terminates by its Int measure
test terminations_of_program() :=
  local main: Id, q: Prog, open: List[Str] := List(), proven: List[Str] := List()
  call load_text(in "ulang/test/errors/terminations-of-program.u", List(
    "function loop(x: Int): Int :=",
    "  loop(x) + 1",
    "",
    "function down(n: Int): Int :=",
    "  if n <= 0 then 0 else down(n - 1) + 1"), out main, q)
  match translate(q, main)
    case Translation(decls, _) =>
      local ts := terminations(decls, Set((Name(Some(main), "loop"), 1), (Name(Some(main), "down"), 1)))
      assign open := List(for t in ts if not is_terminating(t) for (n, _) in t.names yield n.base), proven := List(for t in ts if is_terminating(t) for (n, _) in t.names yield n.base)
  end
  assert open == List("loop") and proven == List("down")

// a function that a lemma reaches and whose termination is not proven is an error at the call that does not decrease,
// and stays uninterpreted for the lemma, though the if of its body is decided, so that loop(0) == 0 stays open
test nonterminating_function() :=
  assert raises OpenTermination("loop", "loop(x) where x == x") do
    call prove_text(in "ulang/test/errors/nonterminating-function.u", List(
      "function loop(x: Int): Int :=",
      "  if x == x then loop(x) + 1 else 0",
      "",
      "lemma loop_zero() :=",
      "  ensures loop(0) == 0"))
  end

test vacuous() :=
  assert raises Uncaught("Vacuous") do
    call run_text(in "ulang/test/errors/vacuous.u", List("lemma large(in n: Int) :=", "  requires n > 100", "  ensures  n > 0"))
  end

// the sign of a remainder follows that of its dividend, since / truncates towards zero, so it is open without it
test remainder_unsigned() :=
  assert raises OpenLemma("remainder_unsigned", "forall m => (m % 3) < 0 ==> false") do
    call prove_text(in "ulang/test/errors/remainder-unsigned.u", List("lemma remainder_unsigned(in m: Int) :=", "  ensures m % 3 >= 0"))
  end

// only squares are at least 0
test product_unsigned() :=
  assert raises OpenLemma("product_unsigned", "forall x, y => (x * y) < 0 ==> false") do
    call prove_text(in "ulang/test/errors/product-unsigned.u", List("lemma product_unsigned(in x: Int, y: Int) :=", "  ensures x * y >= 0"))
  end

// a cut that does not follow, at its step
test proof_open_assert() :=
  assert raises OpenLemma("open_assert", "forall x => 0 < x at 3.3") do
    call prove_text(in "ulang/test/errors/proof-open-assert.u", List(
      "lemma open_assert(in x: Int) :=",
      "  ensures x == x",
      "  assert x > 0"))
  end

// a call of the lemma itself outside the case of an induction
test proof_self_call() :=
  assert raises OpenLemma("self_call", "the lemma calls itself only at a recursive field of the case of its induction at 3.3") do
    call prove_text(in "ulang/test/errors/proof-self-call.u", List(
      "lemma self_call(in x: Int) :=",
      "  ensures x == x",
      "  call self_call(in x)"))
  end

// a call of a lemma that comes after the one that calls it
test proof_later_call() :=
  assert raises OpenLemma("early", "the lemma late is not proven before this one at 3.3") do
    call prove_text(in "ulang/test/errors/proof-later-call.u", List(
      "lemma early(in x: Int) :=",
      "  ensures x == x",
      "  call late(in x)",
      "",
      "lemma late(in x: Int) :=",
      "  ensures x == x"))
  end

// a case of an induction that is not written must close by simplification
test proof_open_case() :=
  assert raises OpenLemma("open_case", "forall head, tail => size(tail) == 0 ==> false at 3.3") do
    call prove_text(in "ulang/test/errors/proof-open-case.u", List(
      "lemma open_case(in xs: List[Int]) :=",
      "  ensures size(xs) == 0",
      "  induction xs",
      "  end"))
  end
