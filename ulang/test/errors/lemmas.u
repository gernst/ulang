// the lemmas that the default proof of ulang/prove/lemma.u leaves open, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/prove"
import "ulang/test/cases"

test append_commutes() :=
  assert raises OpenLemma("append_commutes", "forall xs, ys => (ys ++ xs) == (xs ++ ys)") do
    call prove_text(in "ulang/test/errors/append-commutes.u", List(
      "lemma append_commutes[A](xs: List[A], ys: List[A]) :=",
      "  ensures xs ++ ys == ys ++ xs"))
  end

test irreflexive() :=
  assert raises OpenLemma("irreflexive", "forall a => false") do
    call prove_text(in "ulang/test/errors/irreflexive.u", List("lemma irreflexive(a: Int) :=", "  ensures a < a"))
  end

test less_by_two() :=
  assert raises OpenLemma("less_by_two", "forall a, b => a < b ==> b < (a + 2)") do
    call prove_text(in "ulang/test/errors/less-by-two.u", List(
      "lemma less_by_two(a: Int, b: Int) :=",
      "  requires a < b",
      "  ensures  b < a + 2"))
  end

test square_nonnegative() :=
  assert raises OpenLemma("square_nonnegative", "forall x => (x * x) < 0 ==> false") do
    call prove_text(in "ulang/test/errors/square-nonnegative.u", List("lemma square_nonnegative(x: Int) :=", "  ensures x * x >= 0"))
  end

test distributive() :=
  assert raises OpenLemma("distributive", "forall x, y, z => (x * (y + z)) == ((x * y) + (x * z))") do
    call prove_text(in "ulang/test/errors/distributive.u", List(
      "lemma distributive(x: Int, y: Int, z: Int) :=",
      "  ensures x * (y + z) == x * y + x * z"))
  end

test division_remainder() :=
  assert raises OpenLemma("division_remainder", "forall m => ((m % 3) + 3 * (m / 3)) == m") do
    call prove_text(in "ulang/test/errors/division-remainder.u", List(
      "lemma division_remainder(m: Int) :=",
      "  ensures m == m / 3 * 3 + m % 3"))
  end

test remainder_bound() :=
  assert raises OpenLemma("remainder_bound", "forall m => (not m < 0) ==> (m % 2) < 2") do
    call prove_text(in "ulang/test/errors/remainder-bound.u", List(
      "lemma remainder_bound(m: Int) :=",
      "  requires m >= 0",
      "  ensures  m % 2 < 2"))
  end

test integer_infeasible() :=
  assert raises OpenLemma("integer_infeasible", "forall x, y => (not (11 * x + 13 * y) < 27) and (not 45 < (11 * x + 13 * y)) and (not (7 * x - 9 * y) < (-10)) and (not 4 < (7 * x - 9 * y)) ==> false") do
    call prove_text(in "ulang/test/errors/integer-infeasible.u", List(
      "lemma integer_infeasible(x: Int, y: Int) :=",
      "  requires 27 <= 11 * x + 13 * y, 11 * x + 13 * y <= 45, (-10) <= 7 * x - 9 * y, 7 * x - 9 * y <= 4",
      "  ensures  false"))
  end

test unit_clause() :=
  assert raises OpenLemma("unit_clause", "forall p, q => (p or q) and (not p) ==> q") do
    call prove_text(in "ulang/test/errors/unit-clause.u", List(
      "lemma unit_clause(p: Bool, q: Bool) :=",
      "  requires p or q, not p",
      "  ensures  q"))
  end

test disjunctive_bound() :=
  assert raises OpenLemma("disjunctive_bound", "forall a => (a == 1 or a == 2) ==> 0 < a") do
    call prove_text(in "ulang/test/errors/disjunctive-bound.u", List(
      "lemma disjunctive_bound(a: Int) :=",
      "  requires a == 1 or a == 2",
      "  ensures  a > 0"))
  end

test boolean_equivalence() :=
  assert raises OpenLemma("boolean_equivalence", "forall a, b => ((a and b) or ((not a) and (not b))) == (b == a)") do
    call prove_text(in "ulang/test/errors/boolean-equivalence.u", List(
      "lemma boolean_equivalence(a: Bool, b: Bool) :=",
      "  ensures (a == b) == (a and b or not a and not b)"))
  end

test boolean_below_true() :=
  assert raises OpenLemma("boolean_below_true", "forall b => b < true ==> b == false") do
    call prove_text(in "ulang/test/errors/boolean-below-true.u", List(
      "lemma boolean_below_true(b: Bool) :=",
      "  requires b < true",
      "  ensures  b == false"))
  end

// equal sets of different shapes, which would be refuted as distinct constructors if those of abstract types were free
test abstract_constructors() :=
  assert raises OpenLemma("abstract_constructors", "not Node(Node(Leaf, 1, Leaf, 1), 2, Leaf, 2) == Node(Leaf, 1, Node(Leaf, 2, Leaf, 1), 2)") do
    call prove_text(in "ulang/test/errors/abstract-constructors.u", List("lemma abstract_constructors() :=", "  ensures Set(1, 2) != Set(2, 1)"))
  end

// the recursive functions of the library whose termination the prover does not prove: distinct recurses on a
// comprehension, sort on take and drop of half its list, and separated on joined_pairs, which need lemmas of their
// sizes, and gcd on a remainder, which needs its bounds (prover.md, D6)
test library_terminates() :=
  local main: Id, q: Prog, open: List[Str] := List()
  call load_text(in "ulang/test/errors/library-terminates.u", List("lemma trivial() :=", "  ensures true"), out main, q)
  match translate(q, main)
    case Translation(decls, _) =>
      assign open := List(for t in terminations(decls, Set(for k => d in decls.defs if d.recursive yield k)) if not is_terminating(t) for (n, _) in t.names yield n.base)
  end
  assert Set(for n in open) == Set("distinct", "separated", "sort", "gcd")

// a function that does not terminate is open, one that counts down to a guard terminates by its Int measure
test terminations_of_program() :=
  local main: Id, q: Prog, open: List[Str] := List(), proven: List[Str] := List()
  call load_text(in "ulang/test/errors/terminations-of-program.u", List(
    "function loop(x: Int): Int :=",
    "  loop(x) + 1",
    "",
    "function down(n: Int): Int :=",
    "  if n <= 0 then 0 else down(n - 1) + 1"), out main, q)
  match translate(q, main)
    case Translation(decls, _) =>
      local ts := terminations(decls, Set((Name(Some(main), "loop"), 1), (Name(Some(main), "down"), 1)))
      assign open := List(for t in ts if not is_terminating(t) for (n, _) in t.names yield n.base), proven := List(for t in ts if is_terminating(t) for (n, _) in t.names yield n.base)
  end
  assert open == List("loop") and proven == List("down")

// a function whose termination is not proven stays uninterpreted, though the if of its body is decided
test nonterminating_uninterpreted() :=
  assert raises OpenLemma("loop_zero", "loop(0) == 0") do
    call prove_text(in "ulang/test/errors/nonterminating-uninterpreted.u", List(
      "function loop(x: Int): Int :=",
      "  if x == x then loop(x) + 1 else 0",
      "",
      "lemma loop_zero() :=",
      "  ensures loop(0) == 0"))
  end
