// the errors of modules and packages: imports, sections, and what they export and hide, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/parse"
import "ulang/check"
import "ulang/test/cases"

test abstract_arity() :=
  assert raises SignatureMismatch(Name(Some("ulang/test/errors/abstract-arity"), "T")) do
    call check_text(in "ulang/test/errors/abstract-arity.u", List(
      "export",
      "",
      "type T[A]",
      "",
      "implementation",
      "",
      "data T :=",
      "  case T"))
  end

test abstract_outside_export() :=
  assert raises ParseError("types without a definition belong to the export or builtin section", Pos(5, 1)) do
    call check_text(in "ulang/test/errors/abstract-outside-export.u", List("export", "", "implementation", "", "type T"))
  end

test abstract_undefined() :=
  assert raises MissingDefinition(Name(Some("ulang/test/errors/abstract-undefined"), "T")) do
    call check_text(in "ulang/test/errors/abstract-undefined.u", List("export", "", "type T", "", "implementation", "", "type T :=", "  Int"))
  end

test builtin_before_export() :=
  assert raises ParseError("builtin follows export", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/builtin-before-export.u", List("builtin", "", "function f(): Int"))
  end

test builtin_data() :=
  assert raises ParseError("builtin sections have signatures and types without a definition only", Pos(7, 1)) do
    call check_text(in "ulang/test/errors/builtin-data.u", List(
      "export",
      "",
      "function g(): Int",
      "",
      "builtin",
      "",
      "data T :=",
      "  case T",
      "",
      "implementation",
      "",
      "function g(): Int :=",
      "  1"))
  end

test definition_in_export() :=
  assert raises ParseError("definitions belong to the implementation section", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/definition-in-export.u", List("export", "", "function f(): Int :=", "  1"))
  end

test duplicate_signature() :=
  assert raises AlreadyDefined(Name(Some("ulang/test/errors/duplicate-signature"), "f")) do
    call check_text(in "ulang/test/errors/duplicate-signature.u", List(
      "export",
      "",
      "function f(n: Int): Int",
      "",
      "function f(m: Int): Int",
      "",
      "implementation",
      "",
      "function f(n: Int): Int :=",
      "  n"))
  end

test example_on_definition() :=
  assert raises Located(None, Pos(8, 3), ExampleOnDefinition(Name(Some("ulang/test/errors/example-on-definition"), "f"))) do
    call check_text(in "ulang/test/errors/example-on-definition.u", List(
      "export",
      "",
      "function f(x: Int): Int",
      "",
      "implementation",
      "",
      "function f(x: Int): Int :=",
      "  example f(1) == 1",
      "  x"))
  end

test example_private() :=
  assert raises Located(None, Pos(4, 13), UnknownVariable(Name(None, "g"))) do
    call check_text(in "ulang/test/errors/example-private.u", List(
      "export",
      "",
      "function f(x: Int): Int :=",
      "  example f(g()) == 1",
      "",
      "implementation",
      "",
      "function f(x: Int): Int :=",
      "  x",
      "",
      "function g(): Int :=",
      "  1"))
  end

test export_late() :=
  assert raises ParseError("export comes first, after the imports", Pos(4, 1)) do
    call check_text(in "ulang/test/errors/export-late.u", List("function f(): Int :=", "  1", "", "export"))
  end

test implementation_without_export() :=
  assert raises ParseError("implementation follows export", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/implementation-without-export.u", List("implementation"))
  end

test import_after_declaration() :=
  assert raises ParseError("imports come first", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/import-after-declaration.u", List("function f(): Int := 1", "", "import \"ulang/test/modules/left\""))
  end

test import_after_export() :=
  assert raises ParseError("imports come before export", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/import-after-export.u", List("export", "", "import \"ulang/test/modules/left\""))
  end

test lemma_in_export() :=
  assert raises ParseError("lemmas belong to the implementation section", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/lemma-in-export.u", List("export", "", "lemma l(in x: Int) :=", "  ensures x == x"))
  end

test library_import() :=
  assert raises ParseError("import of the library, which every module sees without importing it", Pos(2, 1)) do
    call check_text(in "ulang/test/errors/library-import.u", List(
      "// the library is imported only implicitly",
      "import \"prelude\"",
      "",
      "procedure main() :=",
      "  skip"))
  end

// the names of the members of the library hint at it
test library_member() :=
  assert raises ParseError("import of the library, which every module sees without importing it", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/library-member.u", List("import \"set\""))
  end

test missing_definition() :=
  assert raises MissingDefinition(Name(Some("ulang/test/errors/missing-definition"), "f")) do
    call check_text(in "ulang/test/errors/missing-definition.u", List("export", "", "function f(n: Int): Int"))
  end

// a directory of programs only is no package
test no_members() :=
  assert raises ParseError("the package ulang/test/modules/programs_only has no members, files with sections", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/no-members.u", List("import \"ulang/test/modules/programs_only\""))
  end

test notation_in_implementation() :=
  assert raises ParseError("notations belong to the export section", Pos(5, 1)) do
    call check_text(in "ulang/test/errors/notation-in-implementation.u", List("export", "", "implementation", "", "infix 6 <=>"))
  end

test own_name() :=
  assert raises Located(None, Pos(7, 10), Ambiguous(Name(None, "helper"), _)) do
    call check_text(in "ulang/test/errors/own-name.u", List(
      "import \"ulang/test/modules/left\"",
      "",
      "function helper(n: Int): Int :=",
      "  n + 2",
      "",
      "test r() :=",
      "  assert helper(1) == 3"))
  end

// the programs of a directory see its package without importing it
test own_package() :=
  assert raises ParseError("import of the own package ulang/test/errors, which the files of its directory see without importing it", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/own-package.u", List("import \"ulang/test/errors\""))
  end

test partly_exported() :=
  assert raises PartlyExported(Name(Some("ulang/test/errors/partly-exported"), "f")) do
    call check_text(in "ulang/test/errors/partly-exported.u", List(
      "export",
      "",
      "function f(n: Int): Int",
      "",
      "implementation",
      "",
      "function f(n: Int): Int :=",
      "  n",
      "",
      "function f(n: Int, m: Int): Int :=",
      "  n + m"))
  end

test pattern_alias_abstract() :=
  assert raises Located(None, Pos(7, 1), PrivateConstructor(_, _)) do
    call check_text(in "ulang/test/errors/pattern-alias-abstract.u", List(
      "export",
      "",
      "type Box",
      "",
      "function box(n: Int): Box",
      "",
      "pattern Small(): Box :=",
      "  Box(0)",
      "",
      "implementation",
      "",
      "data Box :=",
      "  case Box(n: Int)",
      "",
      "function box(n: Int): Box :=",
      "  Box(n)"))
  end

test private_constructor() :=
  assert raises Located(None, Pos(4, 14), UnknownVariable(Name(None, "Full"))) do
    call check_text(in "ulang/test/errors/private-constructor.u", List(
      "import \"ulang/test/modules/hiding\"",
      "",
      "test t() :=",
      "  local b := Full(1)"))
  end

test private_field() :=
  assert raises Located(None, Pos(4, 16), UnknownField(_)) do
    call check_text(in "ulang/test/errors/private-field.u", List(
      "import \"ulang/test/modules/hiding\"",
      "",
      "test t() :=",
      "  assert box(1).contents == 1"))
  end

test private_name() :=
  assert raises Located(None, Pos(4, 10), UnknownVariable(Name(None, "secret"))) do
    call check_text(in "ulang/test/errors/private-name.u", List(
      "import \"ulang/test/modules/hiding\"",
      "",
      "test t() :=",
      "  assert secret(1) == 1"))
  end

test private_pattern() :=
  assert raises Located(None, Pos(5, 10), UnknownConstructor(Name(None, "Full"))) do
    call check_text(in "ulang/test/errors/private-pattern.u", List(
      "import \"ulang/test/modules/hiding\"",
      "",
      "function f(b: Box): Int :=",
      "  match b",
      "    case Full(contents) =>",
      "      contents",
      "  end"))
  end

test private_type() :=
  assert raises PrivateType(Name(Some("ulang/test/errors/private-type"), "f"), Name(Some("ulang/test/errors/private-type"), "Hidden")) do
    call check_text(in "ulang/test/errors/private-type.u", List(
      "export",
      "",
      "function f(): Hidden",
      "",
      "implementation",
      "",
      "data Hidden :=",
      "  case Hidden",
      "",
      "function f(): Hidden :=",
      "  Hidden"))
  end

test repeated_export() :=
  assert raises ParseError("a module has one export section", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/repeated-export.u", List("export", "", "export"))
  end

test same_sort_name() :=
  assert raises Located(None, Pos(7, 3), Mismatch(_, _, "the result of f")) do
    call check_text(in "ulang/test/errors/same-sort-name.u", List(
      "import \"ulang/test/modules/hiding\"",
      "",
      "data Box :=",
      "  case Empty",
      "",
      "function f(): Box :=",
      "  box(1)"))
  end

test signature_mismatch() :=
  assert raises SignatureMismatch(Name(Some("ulang/test/errors/signature-mismatch"), "f")) do
    call check_text(in "ulang/test/errors/signature-mismatch.u", List(
      "export",
      "",
      "function f(n: Int): Int",
      "",
      "implementation",
      "",
      "function f(m: Int): Int :=",
      "  m"))
  end

test signature_outside_export() :=
  assert raises ParseError("signatures belong to the export section", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/signature-outside-export.u", List("function f(): Int"))
  end

test test_in_export() :=
  assert raises ParseError("tests belong to the implementation section", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/test-in-export.u", List("export", "", "test t() :=", "  assert true"))
  end

test transitive_field() :=
  assert raises Located(None, Pos(4, 17), UnknownField(_)) do
    call check_text(in "ulang/test/errors/transitive-field.u", List(
      "import \"ulang/test/modules/wrapper\"",
      "",
      "test t() :=",
      "  assert cell(1).contents == 1"))
  end

test transitive_name() :=
  assert raises Located(None, Pos(4, 24), UnknownVariable(Name(None, "twice"))) do
    call check_text(in "ulang/test/errors/transitive-name.u", List(
      "import \"ulang/test/modules/wrapper\"",
      "",
      "test r() :=",
      "  local v := quad(1) + twice(1)"))
  end

test transitive_notation() :=
  assert raises ParseError("undeclared operator <+>", Pos(4, 16)) do
    call check_text(in "ulang/test/errors/transitive-notation.u", List(
      "import \"ulang/test/modules/wrapper\"",
      "",
      "test r() :=",
      "  local v := 1 <+> 2"))
  end

test unexported_order() :=
  assert raises Located(None, Pos(15, 1), UnexportedOrder(Name(Some("ulang/test/errors/unexported-order"), "compare"), Name(Some("ulang/test/errors/unexported-order"), "T"))) do
    call check_text(in "ulang/test/errors/unexported-order.u", List(
      "export",
      "",
      "type T",
      "",
      "function make(): T",
      "",
      "implementation",
      "",
      "data T :=",
      "  case T(value: Int)",
      "",
      "function make(): T :=",
      "  T(1)",
      "",
      "function compare(a: T, b: T): Int :=",
      "  0"))
  end

test unknown_package() :=
  assert raises ParseError("unknown package missing", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/unknown-package.u", List("import \"missing\""))
  end

// a path from the root names no file
test unknown_path() :=
  assert raises ParseError("unknown package ulang/test/errors/missing/nowhere", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/unknown-path.u", List("import \"ulang/test/errors/missing/nowhere\""))
  end

test visible_equality() :=
  assert raises Located(None, Pos(4, 1), VisibleEquality(Name(Some("ulang/test/errors/visible-equality"), "Pair"))) do
    call check_text(in "ulang/test/errors/visible-equality.u", List(
      "data Pair :=",
      "  case Pair(first: Int, second: Int)",
      "",
      "function ==(a: Pair, b: Pair): Bool :=",
      "  true"))
  end

// a member of a package builds the abstract type of its sibling by its private constructor
test sibling_constructor() :=
  assert raises Located(None, Pos(8, 3), UnknownVariable(Name(None, "Box"))) do
    call check_texts(in "ulang/test/errors/sibling-constructor", List(
      ("boxes.u", List(
        "export",
        "",
        "type Box",
        "",
        "function box(n: Int): Box",
        "",
        "implementation",
        "",
        "data Box :=",
        "  case Box(contents: Int)",
        "",
        "function box(n: Int): Box :=",
        "  Box(n)")),
      ("sibling-constructor.u", List(
        "export",
        "",
        "function other(): Box",
        "",
        "implementation",
        "",
        "function other(): Box :=",
        "  Box(0)"))), ("sibling-constructor.u", List(
      "export",
      "",
      "function other(): Box",
      "",
      "implementation",
      "",
      "function other(): Box :=",
      "  Box(0)")))
  end

// a member of a package uses the private function of its sibling
test sibling_private() :=
  assert raises Located(None, Pos(8, 3), UnknownVariable(Name(None, "secret"))) do
    call check_texts(in "ulang/test/errors/sibling-private", List(
      ("secrets.u", List(
        "export",
        "",
        "function shown(n: Int): Int",
        "",
        "implementation",
        "",
        "function shown(n: Int): Int :=",
        "  secret(n)",
        "",
        "function secret(n: Int): Int :=",
        "  n + 1")),
      ("sibling-private.u", List(
        "export",
        "",
        "function revealed(n: Int): Int",
        "",
        "implementation",
        "",
        "function revealed(n: Int): Int :=",
        "  secret(n)"))), ("sibling-private.u", List(
      "export",
      "",
      "function revealed(n: Int): Int",
      "",
      "implementation",
      "",
      "function revealed(n: Int): Int :=",
      "  secret(n)")))
  end

// a program sees two members of its package with functions of the same name and type
test sibling_ambiguous() :=
  assert raises Located(None, Pos(2, 27), Ambiguous(Name(None, "twice"), _)) do
    call check_texts(in "ulang/test/errors/sibling-ambiguous", List(
      ("one.u", List(
        "export",
        "",
        "function twice(n: Int): Int",
        "",
        "implementation",
        "",
        "function twice(n: Int): Int :=",
        "  2 * n")),
      ("two.u", List(
        "export",
        "",
        "function twice(n: Int): Int",
        "",
        "implementation",
        "",
        "function twice(n: Int): Int :=",
        "  n + n"))), ("sibling-ambiguous.u", List("procedure main() :=", "  call os_println(in show(twice(1)))")))
  end

// a program matches by a private pattern alias of a member of its package
test pattern_alias_private() :=
  assert raises Located(None, Pos(3, 10), UnknownConstructor(Name(None, "Minus"))) do
    call check_texts(in "ulang/test/errors/pattern-alias-private", List(
      ("aliases.u", List(
        "export",
        "",
        "data Tm :=",
        "  case Op(name: Str, args: List[Tm])",
        "  case Leaf(n: Int)",
        "",
        "implementation",
        "",
        "pattern Minus(a: Tm): Tm :=",
        "  Op(\"-\", List(a))"))), ("pattern-alias-private.u", List(
      "function f(t: Tm): Int :=",
      "  match t",
      "    case Minus(_) =>",
      "      1",
      "    case _ =>",
      "      0",
      "  end")))
  end

// a program sees a helper of a member of its package and one of the same name and type of an imported package
test ambiguous_name() :=
  assert raises Located(None, Pos(4, 14), Ambiguous(Name(None, "helper"), _)) do
    call check_texts(in "ulang/test/errors/ambiguous-name", List(
      ("right.u", List(
        "export",
        "",
        "function helper(n: Int): Int",
        "",
        "implementation",
        "",
        "function helper(n: Int): Int :=",
        "  n * 2"))), ("ambiguous-name.u", List(
      "import \"ulang/test/modules/left\"",
      "",
      "test r() :=",
      "  local v := helper(1)")))
  end

// a program sees a notation of a member of its package that an imported package declares differently
test imported_notation() :=
  assert raises ParseError("imported operator <+> is declared differently", Pos(1, 1)) do
    call check_texts(in "ulang/test/errors/imported-notation", List(
      ("notation.u", List(
        "export",
        "",
        "infix left 9 <+>",
        "",
        "function <+>(a: Int, b: Int): Int",
        "",
        "implementation",
        "",
        "function <+>(a: Int, b: Int): Int :=",
        "  a + b"))), ("imported-notation.u", List("import \"ulang/test/modules/notation_right\"")))
  end

// packages do not import each other cyclically: inner imports wrapper, which imports inner
test cycle() :=
  assert raises ImportError("ulang/test/modules/wrapper/wrapper", "cyclic import of the package ulang/test/modules/inner", Pos(5, 1)) do
    call check_texts(in "ulang/test/modules/inner", List(
      ("inner.u", List(
        "import \"ulang/test/modules/wrapper\"",
        "",
        "export",
        "",
        "function one(): Int",
        "",
        "implementation",
        "",
        "function one(): Int :=",
        "  1"))), ("inner.u", List(
      "import \"ulang/test/modules/wrapper\"",
      "",
      "export",
      "",
      "function one(): Int",
      "",
      "implementation",
      "",
      "function one(): Int :=",
      "  1")))
  end

// the parse error of a member is reported in it, for the other members of its package
test broken_sibling() :=
  assert raises ImportError("ulang/test/errors/broken-sibling/broken", "keyword then is not a name", Pos(8, 7)) do
    call check_texts(in "ulang/test/errors/broken-sibling", List(
      ("broken.u", List(
        "export",
        "",
        "function f(): Int",
        "",
        "implementation",
        "",
        "function f(): Int :=",
        "  let then := 1 in then")),
      ("user.u", List(
        "export",
        "",
        "function g(): Int",
        "",
        "implementation",
        "",
        "function g(): Int :=",
        "  f()"))), ("user.u", List(
      "export",
      "",
      "function g(): Int",
      "",
      "implementation",
      "",
      "function g(): Int :=",
      "  f()")))
  end

// the test of a member of a package fails
test failing_member() :=
  assert raises AssertionUnequal("3", "4") do
    call run_texts(in "ulang/test/errors/failing-member", List(
      ("failing.u", List(
        "export",
        "",
        "function three(): Int",
        "",
        "implementation",
        "",
        "function three(): Int :=",
        "  3",
        "",
        "test failing() :=",
        "  assert three() == 4"))), ("failing.u", List(
      "export",
      "",
      "function three(): Int",
      "",
      "implementation",
      "",
      "function three(): Int :=",
      "  3",
      "",
      "test failing() :=",
      "  assert three() == 4")))
  end
