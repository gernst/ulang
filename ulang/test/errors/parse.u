// the parse errors of the language, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/parse"
import "ulang/test/cases"

test argument_list() :=
  assert raises ParseError("tuple types are written A * B", Pos(1, 15)) do
    call check_text(in "ulang/test/errors/argument-list.u", List("function f(p: (Int, Int)): Int :=", "  1"))
  end

// a doc stands before a statement, but not before what ends a body, a local line, or a part of an expression
test comment_before_end() :=
  assert raises ParseError("a comment is the doc of the command, statement, or case on the next line, from the start of a line with its indentation", Pos(4, 3)) do
    call check_text(in "ulang/test/errors/comment-before-end.u", List(
      "procedure main() :=",
      "  if true then",
      "    skip",
      "  // the end",
      "  end"))
  end

test comment_before_else() :=
  assert raises ParseError("a comment is the doc of the command, statement, or case on the next line, from the start of a line with its indentation", Pos(4, 3)) do
    call check_text(in "ulang/test/errors/comment-before-else.u", List(
      "procedure main() :=",
      "  if true then",
      "    skip",
      "  // otherwise",
      "  else",
      "    skip",
      "  end"))
  end

test comment_before_local() :=
  assert raises ParseError("a comment is the doc of the command, statement, or case on the next line, from the start of a line with its indentation", Pos(2, 3)) do
    call check_text(in "ulang/test/errors/comment-before-local.u", List("procedure main() :=", "  // one", "  local x := 1", "  skip"))
  end

test comment_in_argument() :=
  assert raises ParseError("a comment is the doc of the command, statement, or case on the next line, from the start of a line with its indentation", Pos(3, 5)) do
    call check_text(in "ulang/test/errors/comment-in-argument.u", List(
      "procedure main() :=",
      "  call os_println(in show(1,",
      "    // two",
      "    2))"))
  end

test data_bar() :=
  assert raises ParseError("each constructor follows case, as in data T := case C", Pos(3, 3)) do
    call check_text(in "ulang/test/errors/data-bar.u", List(
      "// the constructors of a datatype follow case, as the cases of a match do, not |",
      "data Shape :=",
      "  Array( Circle(radius: Int)",
      "  ) Square(side: Int)"))
  end

test detached_comment() :=
  assert raises ParseError("a comment is the doc of the command, statement, or case on the next line, from the start of a line with its indentation", Pos(3, 1)) do
    call check_text(in "ulang/test/errors/detached-comment.u", List(
      "function f(): Int := 1",
      "",
      "// detached",
      "",
      "function g(): Int := 2"))
  end

test duplicate_notation() :=
  assert raises ParseError("operator + is already declared", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/duplicate-notation.u", List("infix left 9 +"))
  end

test example_out_blank() :=
  assert raises ParseError("an example of a procedure has the value of each out and each ref as before => after", Pos(2, 3)) do
    call check_text(in "ulang/test/errors/example-out-blank.u", List("procedure p(out x: Int) :=", "  example p(out _)", "  assign x := 1"))
  end

test example_end() :=
  assert raises ParseError("the end of the example expected but x found", Pos(2, 21)) do
    call check_text(in "ulang/test/errors/example-end.u", List("function f(x: Int): Int :=", "  example f(1) == 1 x", "  x"))
  end

test example_raises_after() :=
  assert raises ParseError("an example that raises has _ for each out and each ref as before the call", Pos(2, 3)) do
    call check_text(in "ulang/test/errors/example-raises-after.u", List(
      "procedure p(ref x: Int) :=",
      "  example p(ref 1 => 2) raises DivisionByZero",
      "  assign x := x / 0"))
  end

test field_types() :=
  assert raises ParseError("field v of T has different types", Pos(4, 1)) do
    call check_text(in "ulang/test/errors/field-types.u", List("data T :=", "  case A(v: Int)", "  case B(v: Str)"))
  end

test form_constructor() :=
  assert raises ParseError("Set(…) is a form, which is no value", Pos(2, 8)) do
    call check_text(in "ulang/test/errors/form-constructor.u", List("data Bag :=", "  case Set(n: Int)"))
  end

test form_value() :=
  assert raises ParseError("List(…) is a form, which is no value", Pos(2, 23)) do
    call check_text(in "ulang/test/errors/form-value.u", List("function f(xs: List[Int]): Int :=", "  size(foldr(xs, Nil, List))"))
  end

test formal_lists() :=
  assert raises ParseError("a function has one list of formals", Pos(1, 19)) do
    call check_text(in "ulang/test/errors/formal-lists.u", List("function f(a: Int)(b: Int): Int :=", "  a + b"))
  end

test if_without_then() :=
  assert raises ParseError("then expected but skip found", Pos(3, 5)) do
    call check_text(in "ulang/test/errors/if-without-then.u", List("test t() :=", "  if true", "    skip", "  end"))
  end

// an import names a package, not a file
test import_file() :=
  assert raises ParseError("an import names the directory of a package, not a file", Pos(1, 8)) do
    call check_text(in "ulang/test/errors/import-file.u", List("import \"ulang/test/modules/stack.u\""))
  end

// the names of the path of a package are names
test import_file_name() :=
  assert raises ParseError("an import names a package by its path from the root, of names of letters, digits, and _ only", Pos(1, 8)) do
    call check_text(in "ulang/test/errors/import-file-name.u", List("import \"my-set\""))
  end

// imports name packages by strings, so that their names may be keywords
test import_name() :=
  assert raises ParseError("package expected but set found", Pos(1, 8)) do
    call check_text(in "ulang/test/errors/import-name.u", List("import set"))
  end

// an import names a path from the root of the project, without .. segments
test import_parent() :=
  assert raises ParseError("an import names a package by its path from the root, of names of letters, digits, and _ only", Pos(1, 8)) do
    call check_text(in "ulang/test/errors/import-parent.u", List("import \"../modules/left\""))
  end

test keyword_name() :=
  assert raises ParseError("keyword in is not a name", Pos(2, 7)) do
    call check_text(in "ulang/test/errors/keyword-name.u", List("function f(): Int :=", "  let in := 1 in in"))
  end

test lemma_ensures_first() :=
  assert raises ParseError("declaration expected but requires found", Pos(3, 3)) do
    call check_text(in "ulang/test/errors/lemma-ensures-first.u", List("lemma l(in x: Int) :=", "  ensures  x == x", "  requires x > 0"))
  end

test lemma_without_ensures() :=
  assert raises ParseError("ensures expected but test found", Pos(4, 1)) do
    call check_text(in "ulang/test/errors/lemma-without-ensures.u", List(
      "lemma l(in x: Int) :=",
      "  requires x > 0",
      "",
      "test t() :=",
      "  skip"))
  end

test list_without_elements() :=
  assert raises ParseError("expression expected but ; found", Pos(2, 8)) do
    call check_text(in "ulang/test/errors/list-without-elements.u", List("function f(xs: List[Int]): List[Int] :=", "  List(; xs)"))
  end

test mixed_literal() :=
  assert raises ParseError("=> expected but , found", Pos(2, 19)) do
    call check_text(in "ulang/test/errors/mixed-literal.u", List("test r() :=", "  local v := Map(1, 2 => 3)"))
  end

test not_associative() :=
  assert raises ParseError("operator == is not associative", Pos(2, 17)) do
    call check_text(in "ulang/test/errors/not-associative.u", List("test not_associative() :=", "  assert 1 == 1 == true"))
  end

test not_prefix() :=
  assert raises ParseError("* is not a prefix operator", Pos(2, 10)) do
    call check_text(in "ulang/test/errors/not-prefix.u", List("test not_prefix() :=", "  assert * 2 == 2"))
  end

test notation_without_precedence() :=
  assert raises ParseError("precedence expected but ++ found", Pos(1, 12)) do
    call check_text(in "ulang/test/errors/notation-without-precedence.u", List("infix left ++"))
  end

test number_as_name() :=
  assert raises ParseError("name expected but 1 found", Pos(1, 10)) do
    call check_text(in "ulang/test/errors/number-as-name.u", List("function 1(): Int :=", "  1"))
  end

test operator_before_declaration() :=
  assert raises ParseError("undeclared operator +++", Pos(2, 18)) do
    call check_text(in "ulang/test/errors/operator-before-declaration.u", List(
      "test operator_before_declaration() :=",
      "  assert List(1) +++ List(2) == List(1, 2)",
      "",
      "infix right 8 +++",
      "",
      "function +++[A](xs: List[A], ys: List[A]): List[A] :=",
      "  xs ++ ys"))
  end

test pattern_alias_builtin() :=
  assert raises ParseError("builtin sections have signatures and types without a definition only", Pos(5, 1)) do
    call check_text(in "ulang/test/errors/pattern-alias-builtin.u", List("export", "", "builtin", "", "pattern Z(): Int := 0"))
  end

test prefix_as_infix() :=
  assert raises ParseError("unexpected operator not", Pos(2, 5)) do
    call check_text(in "ulang/test/errors/prefix-as-infix.u", List("function f(a: Bool, b: Bool): Bool :=", "  a not b"))
  end

test raises_without_do() :=
  assert raises ParseError("do expected but local found", Pos(3, 5)) do
    call check_text(in "ulang/test/errors/raises-without-do.u", List(
      "test missing_do() :=",
      "  assert raises DivisionByZero",
      "    local n := 1 / 0",
      "  end"))
  end

test repeated_field() :=
  assert raises ParseError("repeated field v of A", Pos(3, 3)) do
    call check_text(in "ulang/test/errors/repeated-field.u", List("data T :=", "  case A(v: Int, v: Int)", "  case B"))
  end

test set_literal_rest() :=
  assert raises ParseError(") expected but => found", Pos(2, 17)) do
    call check_text(in "ulang/test/errors/set-literal-rest.u", List(
      "function f(m: Map[Int, Int]): Map[Int, Int] :=",
      "  Map(1 => 2; 3 => 4)"))
  end

test statement_as_declaration() :=
  assert raises ParseError("declaration expected but assign found", Pos(1, 1)) do
    call check_text(in "ulang/test/errors/statement-as-declaration.u", List("assign x := 1"))
  end

test string_escape() :=
  assert raises ParseError("invalid escape", Pos(2, 12)) do
    call check_text(in "ulang/test/errors/string-escape.u", List("test bad_escape() :=", "  assert \"a\\qb\" == \"\""))
  end

test trailing_comment() :=
  assert raises ParseError("a comment is the doc of the command, statement, or case on the next line, from the start of a line with its indentation", Pos(1, 24)) do
    call check_text(in "ulang/test/errors/trailing-comment.u", List("function f(): Int := 1 // one"))
  end

test undeclared_operator() :=
  assert raises ParseError("undeclared operator <+>", Pos(2, 12)) do
    call check_text(in "ulang/test/errors/undeclared-operator.u", List("test undeclared_operator() :=", "  assert 1 <+> 2 == 3"))
  end

test unnamed_field() :=
  assert raises ParseError("fields of constructors have names, as in C(name: T)", Pos(2, 25)) do
    call check_text(in "ulang/test/errors/unnamed-field.u", List("data Pair :=", "  case Pair(first: Int, Int)"))
  end

test while_without_do() :=
  assert raises ParseError("do expected but skip found", Pos(3, 5)) do
    call check_text(in "ulang/test/errors/while-without-do.u", List("test t() :=", "  while false", "    skip", "  end"))
  end

test wildcard_name() :=
  assert raises ParseError("expression expected but _ found", Pos(2, 17)) do
    call check_text(in "ulang/test/errors/wildcard-name.u", List("function f(): Int :=", "  let _ := 1 in _"))
  end

// the parser resumes at the next command after an error, and reports the errors of all commands
// a statement that does not parse ends at the next line at its column, after the end of a block that it opens, so that the
// statements after it are parsed
test several_statement_errors() :=
  assert raises ParseErrors(List(
    ParseError("statement expected but x found; a statement starts with its keyword, as in assign x := e", Pos(3, 3)),
    ParseError("expression expected but then found", Pos(4, 11)),
    ParseError("expression expected but while found", Pos(10, 3)),
    ParseError("statement expected but return found; a function is the value of its body, and a procedure gives its results by assigning its outs", Pos(11, 5)))) do
    call check_text(in "ulang/test/errors/several-statement-errors.u", List(
      "procedure p() :=",
      "  local x := 1",
      "  x := 2",
      "  if x == then",
      "    assign x := 3",
      "  else",
      "    assign x := 4",
      "  end",
      "  assign x := x +",
      "  while x < 3 do",
      "    return x",
      "  end"))
  end

// an argument that does not parse ends at the next , or ) outside its brackets, so that the arguments after it are parsed,
// and one that does not end there is an error of its statement
test several_argument_errors() :=
  assert raises ParseErrors(List(
    ParseError("expression expected but , found", Pos(2, 19)),
    ParseError("* is not a prefix operator", Pos(2, 26)),
    ParseError("expression expected but assign found", Pos(4, 3)))) do
    call check_text(in "ulang/test/errors/several-argument-errors.u", List(
      "procedure p() :=",
      "  local x := f(1 +, g(2, * 3), 4)",
      "  call os_println(in show(x +",
      "  assign x := 5"))
  end

// the hints of habits of other languages, the form to write instead, after the error
test habits() :=
  assert raises ParseErrors(List(
    ParseError("statement expected but x found; a statement starts with its keyword, as in assign x := e", Pos(3, 3)),
    ParseError(":= expected but += found; write assign x := x + e", Pos(4, 12)),
    ParseError("statement expected but print found; a procedure is called by call print(in a, out x), and a function only in an expression", Pos(5, 3)),
    ParseError("statement expected but return found; a function is the value of its body, and a procedure gives its results by assigning its outs", Pos(6, 3)),
    ParseError("else or end expected but elif found; write else, then if c then … end on the next line, with an end of its own", Pos(9, 3)),
    ParseError("expression expected but [ found; containers are forms, List(1, 2), Set(…), Map(k => v), and Array(…), and [ ] holds only type arguments", Pos(12, 16)),
    ParseError("undeclared operator ::; a list is built and matched as List(x; rest)", Pos(13, 18)),
    ParseError("undeclared operator &&; the operators of Bool are and, or, and not", Pos(14, 24)),
    ParseError("statement expected but break found; a loop ends by its condition or by an exception", Pos(16, 5)),
    ParseError("statement expected but local found; locals are declared at the start of a body, before its statements", Pos(19, 3)))) do
    call check_text(in "ulang/test/errors/habits.u", List(
      "procedure main() :=",
      "  local x := 1, xs := List(1)",
      "  x := 2",
      "  assign x += 1",
      "  print(x)",
      "  return x",
      "  if x == 1 then",
      "    skip",
      "  elif x == 2 then",
      "    skip",
      "  end",
      "  assign xs := [1, 2]",
      "  assign xs := x :: xs",
      "  assign x := if x > 1 && x < 3 then 1 else 2",
      "  while x < 3 do",
      "    break",
      "  end",
      "  skip",
      "  local y := 2"))
  end

// a missing end is reported at the construct that it closes, found at the next line to the left of its body
test missing_end() :=
  assert raises ParseError("the if has no end: end expected but assign found at line 4", Pos(2, 3)) do
    call check_text(in "ulang/test/errors/missing-end.u", List("procedure main() :=", "  if true then", "    skip", "  assign x := 3"))
  end

test several_parse_errors() :=
  assert raises ParseErrors(List(
    ParseError(_, Pos(4, 1)),
    ParseError(_, Pos(5, 3)),
    ParseError(_, Pos(9, 3)))) do
    call check_text(in "ulang/test/errors/several-parse-errors.u", List(
      "function f(n: Int): Int :=",
      "  n +",
      "",
      "function g(): Int :=",
      "  [1, 2]",
      "",
      "procedure p() :=",
      "  skip",
      "  local x := 1",
      "",
      "function h(): Int :=",
      "  1"))
  end

test proof_step_after_split() :=
  assert raises ParseError("a split ends its proof, so no step follows it", Pos(5, 3)) do
    call check_text(in "ulang/test/errors/proof-step-after-split.u", List(
      "lemma a(in x: Int) :=",
      "  ensures x == x",
      "  if x > 0 then",
      "  end",
      "  assert true"))
  end

test proof_local_after_step() :=
  assert raises ParseError("the locals of a proof come before its other steps", Pos(4, 3)) do
    call check_text(in "ulang/test/errors/proof-local-after-step.u", List(
      "lemma a(in x: Int) :=",
      "  ensures x == x",
      "  assert true",
      "  local y := x"))
  end

test proof_call_refs() :=
  assert raises ParseError("a call of a lemma has no refs", Pos(3, 3)) do
    call check_text(in "ulang/test/errors/proof-call-refs.u", List("lemma a(in x: Int) :=", "  ensures x == x", "  call b(in x, ref y)"))
  end

test proof_assert_raises() :=
  assert raises ParseError("assert raises is no step of a proof", Pos(3, 3)) do
    call check_text(in "ulang/test/errors/proof-assert-raises.u", List(
      "lemma a(in x: Int) :=",
      "  ensures x == x",
      "  assert raises Failed do",
      "    skip",
      "  end"))
  end
