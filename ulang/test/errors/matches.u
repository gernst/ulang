// the errors of patterns and matches: cases that are missing, useless, or of the wrong type, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/check"
import "ulang/test/cases"

test empty_match() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PWild)) do
    call check_text(in "empty-match.u", List("function f(x: Int): Int :=", "  match x", "  end"))
  end

test guard_not_exhaustive() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PLit(LBool(true)))) do
    call check_text(in "guard-not-exhaustive.u", List(
      "function f(b: Bool): Int :=",
      "  match b",
      "    case true if b =>",
      "      1",
      "    case false =>",
      "      0",
      "  end"))
  end

test lambda_pattern() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PApp(Name(Some("prelude/option"), "None"), List()))) do
    call check_text(in "lambda-pattern.u", List("function value(): Option[Int] -> Int :=", "  lambda Some(x) => x"))
  end

test missing_cons() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PApp(Name(Some("prelude/list"), "Cons"), List(PWild, PWild)))) do
    call check_text(in "missing-cons.u", List(
      "function f(x: List[Option[Int]]): Int :=",
      "  match x",
      "    case List() =>",
      "      0",
      "  end"))
  end

test missing_false() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PLit(LBool(false)))) do
    call check_text(in "missing-false.u", List(
      "function f(x: Bool): Int :=",
      "  match x",
      "    case true =>",
      "      0",
      "  end"))
  end

test missing_int() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PWild)) do
    call check_text(in "missing-int.u", List(
      "function f(x: Int): Int :=",
      "  match x",
      "    case 0 =>",
      "      0",
      "  end"))
  end

test missing_nested_zero() :=
  assert raises Located(None, Pos(5, 1), NotExhaustive(_)) do
    call check_text(in "missing-nested-zero.u", List(
      "data Nat :=",
      "  case Zero",
      "  case Succ(pred: Nat)",
      "",
      "function f(n: Nat): Nat :=",
      "  match n",
      "    case Zero =>",
      "      Zero",
      "    case Succ(Succ(pred)) =>",
      "      pred",
      "  end"))
  end

test missing_nil() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PApp(Name(Some("prelude/list"), "Nil"), List()))) do
    call check_text(in "missing-nil.u", List(
      "function f(x: List[Option[Int]]): Int :=",
      "  match x",
      "    case List(_; _) =>",
      "      0",
      "  end"))
  end

test missing_pair_case() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PTuple(List(PLit(LBool(false)), PLit(LBool(true)))))) do
    call check_text(in "missing-pair-case.u", List(
      "function f(p: Bool * Bool): Int :=",
      "  match p",
      "    case (true, _) =>",
      "      0",
      "    case (false, false) =>",
      "      1",
      "  end"))
  end

test missing_some() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(_)) do
    call check_text(in "missing-some.u", List(
      "function f(x: List[Option[Int]]): Int :=",
      "  match x",
      "    case List() =>",
      "      0",
      "    case List(None; _) =>",
      "      1",
      "  end"))
  end

test missing_some_literal() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(_)) do
    call check_text(in "missing-some-literal.u", List(
      "function f(x: List[Option[Int]]): Int :=",
      "  match x",
      "    case List() =>",
      "      0",
      "",
      "    case List(Some(1); _) =>",
      "      1",
      "",
      "    case List(None; _) =>",
      "      2",
      "  end"))
  end

test missing_statement_case() :=
  assert raises Located(None, Pos(1, 1), NotExhaustive(PLit(LBool(false)))) do
    call check_text(in "missing-statement-case.u", List(
      "procedure p(in x: Bool, out r: Int) :=",
      "  match x",
      "    case true =>",
      "      assign r := 0",
      "  end"))
  end

test missing_successor() :=
  assert raises Located(None, Pos(5, 1), NotExhaustive(_)) do
    call check_text(in "missing-successor.u", List(
      "data Nat :=",
      "  case Zero",
      "  case Succ(pred: Nat)",
      "",
      "function f(n: Nat): Nat :=",
      "  match n",
      "    case Zero =>",
      "      Zero",
      "  end"))
  end

test pattern_alias_missing() :=
  assert raises Located(None, Pos(4, 1), NotExhaustive(_)) do
    call check_text(in "pattern-alias-missing.u", List(
      "pattern Yes(): Option[Bool] :=",
      "  Some(true)",
      "",
      "function f(b: Option[Bool]): Int :=",
      "  match b",
      "    case Yes() =>",
      "      1",
      "    case None =>",
      "      0",
      "  end"))
  end

test pattern_alias_unreachable() :=
  assert raises Located(None, Pos(4, 1), Unreachable(_)) do
    call check_text(in "pattern-alias-unreachable.u", List(
      "pattern Yes(): Option[Bool] :=",
      "  Some(true)",
      "",
      "function f(b: Option[Bool]): Int :=",
      "  match b",
      "    case Some(_) =>",
      "      1",
      "",
      "    case Yes() =>",
      "      2",
      "",
      "    case None =>",
      "      0",
      "  end"))
  end

test unreachable_after_wildcard() :=
  assert raises Located(None, Pos(1, 1), Unreachable(PLit(LBool(true)))) do
    call check_text(in "unreachable-after-wildcard.u", List(
      "function f(b: Bool): Int :=",
      "  match b",
      "    case _ =>",
      "      0",
      "    case true =>",
      "      1",
      "  end"))
  end

test unreachable_covered() :=
  assert raises Located(None, Pos(1, 1), Unreachable(PTuple(List(PLit(LBool(true)), PLit(LBool(true)))))) do
    call check_text(in "unreachable-covered.u", List(
      "function f(p: Bool * Bool): Int :=",
      "  match p",
      "    case (true, _) =>",
      "      0",
      "",
      "    case (_, false) =>",
      "      1",
      "",
      "    case (true, true) =>",
      "      2",
      "",
      "    case (false, true) =>",
      "      3",
      "  end"))
  end

test unreachable_literal() :=
  assert raises Located(None, Pos(1, 1), Unreachable(PLit(LInt(0)))) do
    call check_text(in "unreachable-literal.u", List(
      "function f(n: Int): Int :=",
      "  match n",
      "    case 0 =>",
      "      0",
      "",
      "    case _ =>",
      "      1",
      "",
      "    case 0 =>",
      "      2",
      "  end"))
  end

test unreachable_repeated() :=
  assert raises Located(None, Pos(1, 1), Unreachable(PApp(Name(Some("prelude/list"), "Nil"), List()))) do
    call check_text(in "unreachable-repeated.u", List(
      "function f(xs: List[Int]): Int :=",
      "  match xs",
      "    case List() =>",
      "      0",
      "",
      "    case List(_; _) =>",
      "      1",
      "",
      "    case List() =>",
      "      2",
      "  end"))
  end

test unreachable_wildcard() :=
  assert raises Located(None, Pos(1, 1), Unreachable(PWild)) do
    call check_text(in "unreachable-wildcard.u", List(
      "function f(b: Bool): Int :=",
      "  match b",
      "    case true =>",
      "      0",
      "",
      "    case false =>",
      "      1",
      "",
      "    case _ =>",
      "      2",
      "  end"))
  end
