// the runtime errors that are no exceptions of the program: failed assertions, uncaught exceptions, and the errors of the evaluator, each a case, the lines of a source text at a path of this directory, which the procedures of
// ulang/test/cases/cases.u run through the phases until one raises the error that assert raises expects

import "ulang/syntax"
import "ulang/test/cases"

test assertion() :=
  assert raises AssertionUnequal("24", "120") do
    call run_text(in "ulang/test/errors/assertion.u", List(
      "function fact(n: Int): Int :=",
      "  if n == 0 then 1 else n * fact(n - 1)",
      "",
      "test assertion() :=",
      "  assert fact(4) == 120"))
  end

test assertion_shown() :=
  assert raises AssertionUnequal("(List(), 1 EUR)", "(List(), 2 EUR)") do
    call run_text(in "ulang/test/errors/assertion-shown.u", List(
      "data Money :=",
      "  case Money(amount: Int)",
      "",
      "function show(m: Money): Str :=",
      "  match m",
      "    case Money(amount) =>",
      "      show(amount) ++ \" EUR\"",
      "  end",
      "",
      "test shown() :=",
      "  assert (List(), Money(1)) == (List(), Money(2))"))
  end

test compare_functions() :=
  assert raises CompareFunctions do
    call run_text(in "ulang/test/errors/compare-functions.u", List(
      "test compare_functions() :=",
      "  local f := (lambda x => x + 1)",
      "  assert compare(f, f) == 0"))
  end

test compare_procedures() :=
  assert raises CompareProcedures do
    call run_text(in "ulang/test/errors/compare-procedures.u", List(
      "procedure p() :=",
      "  skip",
      "",
      "test compare_procedures() :=",
      "  assert p == p"))
  end

test initialization() :=
  assert raises RecursiveInitialization("ulang/test/errors/initialization.loop") do
    call run_text(in "ulang/test/errors/initialization.u", List(
      "function loop(): Int :=",
      "  loop() + 1",
      "",
      "test initialization() :=",
      "  assert loop() == 1"))
  end

test not_raised() :=
  assert raises AssertionNotRaised("DivisionByZero") do
    call run_text(in "ulang/test/errors/not-raised.u", List(
      "test nothing_raised() :=",
      "  assert raises DivisionByZero do",
      "    local n := 1 / 1",
      "  end"))
  end

test raise_uncaught() :=
  assert raises Uncaught("Fail(2)") do
    call run_text(in "ulang/test/errors/raise-uncaught.u", List(
      "data Fail :=",
      "  case Fail(code: Int)",
      "",
      "test raise_uncaught() :=",
      "  try",
      "    raise Fail(1)",
      "  catch",
      "    case Fail(1) =>",
      "      raise Fail(2)",
      "  end"))
  end

test string_display() :=
  assert raises AssertionUnequal("\"a\\\"b\\n\"", "\"c\"") do
    call run_text(in "ulang/test/errors/string-display.u", List("test shown() :=", "  assert \"a\\\"b\\n\" == \"c\""))
  end

test uncaught_shown() :=
  assert raises Uncaught("Some(1 EUR)") do
    call run_text(in "ulang/test/errors/uncaught-shown.u", List(
      "data Money :=",
      "  case Money(amount: Int)",
      "",
      "function show(m: Money): Str :=",
      "  match m",
      "    case Money(amount) =>",
      "      show(amount) ++ \" EUR\"",
      "  end",
      "",
      "test shown() :=",
      "  raise Some(Money(1))"))
  end
