// a module for ulang/test/fail/modules/private-name.u, private-constructor.u, private-pattern.u, private-field.u,
// incomparable.u, and same-sort-name.u, with an abstract type without an order

export

type Box

function box(n: Int): Box

implementation

data Box :=
  case Full(contents: Int)

function box(n: Int): Box :=
  Full(secret(n))

function secret(n: Int): Int :=
  n
