// a module for ulang/test/fail/modules/transitive-name.u, transitive-notation.u, and transitive-field.u, whose exports
// ulang/test/fail/modules/wrapper/wrapper.u sees, but not the modules that import it

export

infix left 5 <+>

data Cell :=
  case Cell(contents: Int)

function <+>(m: Int, n: Int): Int

function twice(n: Int): Int

implementation

function <+>(m: Int, n: Int): Int :=
  m + n

function twice(n: Int): Int :=
  n <+> n
