// a module for the tests ambiguous_name, own_name, import_after_declaration, and import_after_export of
// ulang/test/errors/modules.u, which exports a helper that a member of the package of a case or the case itself declares
// too, or that a case imports where imports are misplaced

export

function helper(n: Int): Int

implementation

function helper(n: Int): Int :=
  n + 1
