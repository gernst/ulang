// a module for the tests transitive_name, transitive_notation, and transitive_field of ulang/test/errors/modules.u, whose
// exports
// ulang/test/modules/wrapper/wrapper.u sees, but not the modules that import it

export

infix left 5 <+>

data Cell :=
  case Cell(contents: Int)

function <+>(m: Int, n: Int): Int

function twice(n: Int): Int

implementation

function <+>(m: Int, n: Int): Int :=
  m + n

function twice(n: Int): Int :=
  n <+> n
