// a module for the tests transitive_name, transitive_notation, transitive_field, and cycle of ulang/test/errors/modules.u,
// which imports
// the package ulang/test/modules/inner and exports only its own functions, one with a result of a type of inner.u

import "ulang/test/modules/inner"

export

function quad(n: Int): Int

function cell(n: Int): Cell

implementation

function quad(n: Int): Int :=
  twice(twice(n))

function cell(n: Int): Cell :=
  Cell(n)
