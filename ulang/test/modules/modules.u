// packages are loaded once, and their notations apply after their import, and each module sees its own declarations, its
// direct imports, and the prelude, where its own declarations do not hide those of other modules; with export sections,
// importers see the exported declarations with the notations, but not the private ones, whose names may repeat in other
// modules, and abstract types are compared only through their modules, where comparing a type whose module declares no
// order raises Unordered, and comparing one without an equality either raises Incomparable

import "ulang/test/modules/counter"
import "ulang/test/modules/counter"

export

// pairs of an abstract type of this module, which declares neither an order nor an equality
type Pair

function pair(a: Int, b: Int): Pair

implementation

data Pair :=
  case Pair(first: Int, second: Int)

function pair(a: Int, b: Int): Pair :=
  Pair(a, b)

test imported_notations() :=
  assert top(2 <+ 1 <+ Empty) == Some(2)
  assert peek(Empty, 3) == 3

test exported_declarations() :=
  local c := start()
  call bump(ref c)
  assert count(next(c)) == 2 and 2 ** 3 ** 2 == 512 and level(Green(3)) == 3 and level(Red) == 0

// the helper of counter, since that of exported is private, although it has the same type
test private_names() :=
  assert helper(1) == 2

// annotations by imported abstract types, whose constructors have the names of their types
function counted(c: Counter): Int :=
  count(c)

test abstract_annotations() :=
  local t: Tally := tally(List(1, 2))
  assert counted(next(start())) == 1 and t == tally(List(3))

test exported_fields() :=
  assert Green(3).level == 3 and (Green(3) with level := 4) == Green(4)

test equality_without_order() :=
  assert tally(List(1, 2)) == tally(List(3)) and tally(List(1)) != tally(List(2)) and contains(tally(List(4)), List(tally(List(1, 3))))
  assert raises Unordered("ulang/test/modules/exported.Tally") do
    local r := compare(tally(List(1)), tally(List(2)))
  end
  assert raises Unordered("ulang/test/modules/exported.Tally") do
    local r := tally(List(1)) < tally(List(2))
  end

test incomparable() :=
  assert raises Incomparable("ulang/test/modules/exported.Counter") do
    local r := start() == start()
  end

// also in the module of the type, and inside other values
test incomparable_inside() :=
  assert raises Incomparable("ulang/test/modules/modules.Pair") do
    local r := List(Pair(1, 2)) == List(pair(1, 2))
  end
