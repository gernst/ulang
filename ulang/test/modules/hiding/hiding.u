// a module for the tests private_name, private_constructor, private_pattern, private_field, and same_sort_name of
// ulang/test/errors/modules.u, with an abstract type without an order

export

type Box

function box(n: Int): Box

implementation

data Box :=
  case Full(contents: Int)

function box(n: Int): Box :=
  Full(secret(n))

function secret(n: Int): Int :=
  n
