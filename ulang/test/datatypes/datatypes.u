function range(n: Int): List[Int] :=
  if n == 0 then List() else List(n; range(n - 1))

function head[A](xs: List[A]): Option[A] :=
  match xs
    case List(x; _) =>
      Some(x)
    case _ =>
      None
  end

function nested(xs: List[Option[Int]]): Int :=
  match xs
    case List(Some(1), None; _) =>
      1
    case _ =>
      0
  end

function word(x: Int): Str :=
  match x
    case 0 =>
      "zero"
    case _ =>
      "other"
  end

function flip(b: Bool): Int :=
  match b
    case true =>
      0
    case false =>
      1
  end

function unit(u: ()): Int :=
  match u
    case () =>
      0
  end

test ranges() :=
  assert range(3) == List(3, 2, 1)
  assert size(range(3)) == 3
  assert List(for x in range(3) yield x * x) == List(9, 4, 1)
  assert head(range(2)) == Some(2)
  assert head(List()) == None
  assert nested(List(Some(1), None)) == 1
  assert nested(List()) == 0
  assert word(0) == "zero"
  assert word(7) == "other"
  assert flip(false) == 1
  assert unit(()) == 0
  assert range(2) != List()

// association lists, where the first pair of a key counts
test association_lists() :=
  let m := List(("b", 2), ("a", 1), ("a", 3))
  assert get("a", m) == Some(1) and get("b", m) == Some(2) and get("c", m) == None

// mutually recursive datatypes, and a type definition before the datatype it uses
data Tree[A] :=
  case Node(label: A, children: Forest[A])

data Forest[A] :=
  case Leaf
  case Grow(tree: Tree[A], rest: Forest[A])

type Pair[A] :=
  Tuple[A, A]

data Tuple[A, B] :=
  case Tuple(first: A, second: B)

function size[A](t: Tree[A]): Int :=
  match t
    case Node(_, children) =>
      1 + sizes(children)
  end

function sizes[A](f: Forest[A]): Int :=
  match f
    case Leaf =>
      0
    case Grow(tree, rest) =>
      size(tree) + sizes(rest)
  end

function swap[A](p: Pair[A]): Pair[A] :=
  match p
    case Tuple(first, second) =>
      Tuple(second, first)
  end

test mutual_recursion() :=
  assert size(Node(1, Grow(Node(2, Leaf), Grow(Node(3, Leaf), Leaf)))) == 3
  assert swap(Tuple(1, 2)) == Tuple(2, 1)

// the natural numbers of Peano
data Nat :=
  case Zero
  case Succ(pred: Nat)

function add(m: Nat, n: Nat): Nat :=
  match m
    case Zero =>
      n
    case Succ(pred) =>
      Succ(add(pred, n))
  end

function even(n: Nat): Bool :=
  match n
    case Zero =>
      true

    case Succ(Zero) =>
      false

    case Succ(Succ(pred)) =>
      even(pred)
  end

function int(n: Nat): Int :=
  match n
    case Zero =>
      0
    case Succ(pred) =>
      1 + int(pred)
  end

test nat() :=
  assert int(add(Succ(Succ(Zero)), Succ(Zero))) == 3
  assert even(add(Succ(Zero), Succ(Zero)))
  assert even(Succ(Succ(Succ(Zero)))) == false

// cases apply if their guards hold, and else is the last case
function sign(n: Int): Int :=
  match n
    case m if m < 0 =>
      -1

    case 0 =>
      0

    case _ =>
      1
  end

test guards() :=
  var s: Str
  assert sign(-5) == -1 and sign(0) == 0 and sign(7) == 1
  match List(1, 2)
    case List(x; _) if x > 1 =>
      s := "big"

    case List(x; _) if x == 1 =>
      s := "one"

    case _ =>
      s := "other"
  end
  assert s == "one"

// List(a, b) is Cons(a, Cons(b, Nil)) and List(a, b; c) is Cons(a, Cons(b, c)), in patterns and expressions
function sum_pairs(xs: List[Int]): Int :=
  match xs
    case List() =>
      0

    case List(x) =>
      x

    case List(x, y; rest) =>
      x * y + sum_pairs(rest)
  end

test list_patterns() :=
  assert sum_pairs(List(1, 2, 3, 4, 5)) == 19
  assert sum_pairs(List()) == 0
  assert List(1; List(2, 3)) == List(1, 2, 3)
  assert List(1, 2; List(3)) == Cons(1, Cons(2, Cons(3, List())))

// compare orders values of a type, constructors by their declaration and then by their fields
test comparisons() :=
  assert compare(1, 2) == -1 and compare(2, 1) == 1 and compare(3, 3) == 0
  assert compare("ab", "b") == -1 and compare('b', 'a') == 1 and compare(false, true) == -1
  assert compare((1, "b"), (1, "a")) == 1 and compare((), ()) == 0
  assert compare(None, Some(0)) == -1 and compare(Some(2), Some(1)) == 1
  assert compare(Zero, Succ(Zero)) == -1 and compare(List(1, 2), List(1)) == 1 and compare(List(1), List(1, 2)) == -1
  assert compare(100000000000000000000, 99999999999999999999) == 1 and compare(-100000000000000000000, 1) == -1

data Point :=
  case Point(x: Int, y: Int)

// label is a field of both constructors, and radius only of circles, whose accessor is partial
data Shape :=
  case Circle(label: Str, center: Point, radius: Int)
  case Box(label: Str, corner: Point, opposite: Point)

data Couple[A, B] :=
  case Couple(left: A, right: B)

function area(s: Shape): Int :=
  match s
    case Circle(_, _, radius) =>
      3 * radius * radius
    case Box(_, corner, opposite) =>
      (opposite.x - corner.x) * (opposite.y - corner.y)
  end

test fields() :=
  let p := Point(1, 2), c := Circle("c", Point(0, 0), 2), b := Box("b", Point(1, 1), Point(3, 4))
  assert p.x == 1 and p.y == 2
  assert c.label == "c" and b.label == "b" and c.radius == 2 and c.center.y == 0
  assert area(b) == 6 and b.corner.x == 1
  assert raises MissingField("Shape.radius") do
    let r := b.radius
  end

// the type of p is that of the argument of the lambda applied at once
test unknown_type() :=
  let v := (lambda p => p.x)(Point(1, 2))
  assert v == 1

test lambda_arguments() :=
  let ps := List(Point(1, 2), Point(3, 4))
  assert exists(ps, lambda q => q.x == 3) and not forall(ps, lambda q => q.y < 4) and List(for q in ps yield q.y) == List(2, 4)

test annotated_lambda() :=
  let g: Point -> Int := lambda p => p.x
  assert g(Point(5, 6)) == 5

test generic_fields() :=
  let q := Couple(1, "one")
  assert q.left == 1 and q.right == "one" and Couple(q, true).left.right == "one"

test updates() :=
  let p := Point(1, 2), c := Circle("c", Point(0, 0), 2)
  var b := Box("b", Point(1, 1), Point(3, 4))
  assert (p with x := 3) == Point(3, 2) and (p with y := 0, x := p.y + 3) == Point(5, 0)
  assert (c with radius := 3) == Circle("c", Point(0, 0), 3) and (b with label := "a", corner := p) == Box("a", p, Point(3, 4))
  assert (c with center := (c.center with x := 1)).center == Point(1, 0)
  assert (Couple(1, "one") with right := "two") == Couple(1, "two")
  assert raises MissingField("Shape.radius") do
    b := b with radius := 1
  end

data Token :=
  case TNum(num: Int)
  case TNeg(num: Int)
  case TPlus
  case TMinus
  case TEnd

// alternatives that bind the same variables share one body
function token_value(t: Token): Int :=
  match t
    case TNum(n) | TNeg(n) =>
      n
    case TPlus | TMinus | TEnd =>
      0
  end

// nested alternatives, in a constructor and in a tuple
function is_operator(t: Option[Token]): Bool :=
  match t
    case Some(TPlus | TMinus) =>
      true
    case Some(TNum(_) | TNeg(_) | TEnd) | None =>
      false
  end

// alternatives whose variables are in other orders and positions
function first_of(p: (Int, Token)): Int :=
  match p
    case (k, TPlus | TEnd) | (_, TNum(k) | TNeg(k)) =>
      k
    case (k, TMinus) =>
      -k
  end

// a guard that fails on one alternative tries the next, as the cases of the alternatives do
function non_zero(p: (Int, Int)): Int :=
  match p
    case (x, 0) | (0, x) if x != 0 =>
      x
    case _ =>
      -1
  end

test alternatives() :=
  assert List(for t in List(TNum(3), TNeg(4), TPlus, TEnd) yield token_value(t)) == List(3, 4, 0, 0)
  assert List(for t in List(Some(TPlus), Some(TMinus), Some(TEnd), None) yield is_operator(t)) == List(true, true, false, false)
  assert List(
    first_of((1, TPlus)),
    first_of((1, TNum(5))),
    first_of((1, TNeg(6))),
    first_of((2, TMinus))) == List(1, 5, 6, -2)
  assert List(non_zero((3, 0)), non_zero((0, 4)), non_zero((0, 0)), non_zero((1, 2))) == List(3, 4, -1, -1)

// the last case of a match takes what the cases before leave, with alternatives as with case _, also after a guard
function token_weight(t: Token): Int :=
  match t
    case TNum(n) if n > 9 =>
      100

    case TPlus | TMinus | TEnd =>
      1

    case TNum(n) | TNeg(n) =>
      n
  end

procedure token_count(in t: Token, out k: Int) :=
  match t
    case TNum(n) | TNeg(n) if n > 0 =>
      k := n
    case TNum(_) | TNeg(_) | TPlus | TMinus | TEnd =>
      k := 0
  end

test last_alternatives() :=
  assert List(for t in List(TNum(12), TNum(3), TNeg(4), TEnd) yield token_weight(t)) == List(100, 3, 4, 1)
  var a: Int, b: Int, c: Int, d: Int
  token_count(in TNum(2), out a)
  token_count(in TNeg(0), out b)
  token_count(in TNum(-1), out c)
  token_count(in TMinus, out d)
  assert List(a, b, c, d) == List(2, 0, 0, 0)

test alternatives_in_irrefutable_patterns() :=
  assert (let (n, 0) | (_, n) := (4, 1) in
  n) == 1
  assert List(for (n, 0) | (_, n) in List((1, 0), (5, 2)) yield n) == List(1, 2)
  assert (lambda (n, 0) | (_, n) => n)((7, 0)) == 7
