// the lints of parsed texts, with their positions and the replacements as format writes them, where the texts are not
// checked, as the command lint checks them first

import ulang.syntax
import ulang.parse
import ulang.format
import ulang.lint

// the warnings of the selected lints of the program of the lines, each its position and the text of its replacement, else
// its message
procedure linted(
  in  selected: List[Lint],
      lines: List[Str],
  out found: List[(Pos, Str)]
) :=
  var d: Mod
  parse_text(in join("\n", lines) ++ "\n", out d)
  found := List(for w in lints(d) if contains(w.lint, selected) yield (w.pos, warning_text(d, w)))

function warning_text(d: Mod, w: Warning): Str :=
  match w.replacement
    case Some(r) =>
      format_module_expr(Source(List(d), List(), d.name), d.name, r)
    case None =>
      w.message
  end

test lints_of_ifs() :=
  var found: List[(Pos, Str)]
  linted(in List(BoolIte), List(
    "function f(c: Bool): Bool :=",
    "  if c then true else false",
    "function g(c: Bool): Bool :=",
    "  if c then false else true",
    "function not(b: Bool): Bool :=",
    "  if b then false else true"), out found)
  assert found == List((Pos(2, 3), "c"), (Pos(4, 3), "not c"))

test lints_of_matches() :=
  var found: List[(Pos, Str)]
  linted(in List(Folded), List(
    "function h(o: Option[Int], d: Int): Int :=",
    "  match o",
    "    case None =>",
    "      d",
    "    case Some(x) =>",
    "      x",
    "  end",
    "function k(o: Option[Int]): Int :=",
    "  match o",
    "    case Some(x) =>",
    "      x",
    "    case None =>",
    "      size(List())",
    "  end",
    "function value_or(o: Option[Int], d: Int): Int :=",
    "  match o",
    "    case Some(x) =>",
    "      x",
    "    case None() =>",
    "      Pair(d, (0, \"a\"))",
    "  end"), out found)
  assert found == List((Pos(2, 3), "value_or(o, d)"))

test lints_of_iterated_lists() :=
  var found: List[(Pos, Str)]
  linted(in List(CopiedContainer), List(
    "function l(xs: Set[Int]): List[Int] :=",
    "  List(for y in List(for x in xs) yield y)",
    "function m(xs: Set[Int]): List[Int] :=",
    "  List(for y in List(for x in xs if is_odd(x)) yield y)",
    "function n(m: Map[Int, Str]): List[Int] :=",
    "  List(for (k, v) in List(for k => v in m) yield k)",
    "procedure p(in xs: Set[Int], out n: Int) :=",
    "  n := 0",
    "  for y in List(for x in xs yield x) do",
    "    n := plus(n, y)",
    "  end"), out found)
  assert found == List((Pos(2, 17), "xs"), (Pos(6, 22), "m"), (Pos(9, 12), "xs"))

test lints_of_variables() :=
  var found: List[(Pos, Str)]
  linted(in List(UnusedVariable), List(
    "infix 6 >",
    "function f(o: Option[List[Int]]): Int :=",
    "  match o",
    "    case Some(List(a, b)) =>",
    "      a",
    "    case None =>",
    "      let (c, d) := (1, 2) in exists(List(1), lambda x => c > 0)",
    "  end",
    "function g(n: Int): Int :=",
    "  let a := n, b := a, e := 0 in b",
    "procedure p(in xs: List[Int], out n: Int) :=",
    "  var unread := 1, written: Int, passed: Int",
    "  n := 0, written := 2",
    "  q(in 1, out passed)",
    "  for x in xs do",
    "    n := n",
    "  end",
    "  var got: Int",
    "  q(in 2, out got)",
    "  n := got"), out found)
  assert found == List(
    (Pos(4, 23), "the variable b is never read, write _"),
    (Pos(7, 15), "the variable d is never read, write _"),
    (Pos(7, 54), "the variable x is never read, write _"),
    (Pos(10, 23), "the variable e is never read, write _"),
    (Pos(12, 7), "the local unread is never read"),
    (Pos(12, 20), "the local written is never read"),
    (Pos(12, 34), "the local passed is never read, write _ at the outs that receive it"),
    (Pos(15, 7), "the variable x is never read, write _"))

// an in of a procedure lambda that its body never reads may be _, also in a lambda inside another, which may read it
test lints_of_lambda_ins() :=
  var found: List[(Pos, Str)]
  linted(in List(UnusedVariable), List(
    "procedure p(out n: Int) :=",
    "  let f := lambda in a, b, _, out m =>",
    "    m := b",
    "  end",
    "  let g := lambda in c, out m =>",
    "    let h := lambda in d, out k =>",
    "      k := c",
    "    end",
    "    h(in 1, out m)",
    "  end",
    "  f(in 1, 2, 3, out n)",
    "  g(in 1, out n)"), out found)
  assert found == List(
    (Pos(2, 22), "the variable a is never read, write _"),
    (Pos(6, 24), "the variable d is never read, write _"))

test lints_of_locals_too_high() :=
  var found: List[(Pos, Str)]
  linted(in List(LocalTooHigh), List(
    "procedure p(in c: Bool, out n: Int) :=",
    "  var a: Int, b: Int",
    "  if c then",
    "    a := 1",
    "    n := a",
    "  else",
    "    n := 2",
    "  end",
    "  b := n",
    "  n := b"), out found)
  assert found == List(
    (Pos(2, 7), "the local a is used only in the branches of one statement, which declare it where they use it"))

test lints_of_collecting_loops() :=
  var found: List[(Pos, Str)]
  linted(in List(CollectingLoop), List(
    "infix 6 >",
    "infix left 9 +",
    "infix right 8 ++",
    "procedure p(in xs: List[Int], out ys: List[Int], zs: List[Int]) :=",
    "  ys := List(), zs := List()",
    "  for x in xs if x > 0 do",
    "    ys := ys ++ List(x + 1)",
    "  end",
    "  for x in xs do",
    "    zs := zs ++ List(x)",
    "    r(in zs)",
    "  end"), out found)
  assert found == List((Pos(6, 3), "List(for x in xs if x > 0 yield x + 1)"))

test lints_of_handlers() :=
  var found: List[(Pos, Str)]
  linted(in List(SwallowedException), List(
    "procedure p() :=",
    "  try",
    "    q()",
    "  catch",
    "    case Fail =>",
    "      skip",
    "    case _ =>",
    "      r()",
    "  end"), out found)
  assert found == List((Pos(5, 5), "a handler that only skips swallows what it catches"))

test lints_of_privates() :=
  var found: List[(Pos, Str)]
  linted(in List(UnusedPrivate), List(
    "export",
    "function f(x: Int): Int",
    "implementation",
    "function f(x: Int): Int :=",
    "  g(x)",
    "function g(x: Int): Int :=",
    "  x",
    "function h(x: Int): Int :=",
    "  k(x)",
    "function k(x: Int): Int :=",
    "  h(x)",
    "function t(x: Int): Int :=",
    "  x",
    "procedure main() :=",
    "  skip",
    "test uses_t() :=",
    "  assert t(1) == 1"), out found)
  assert found == List(
    (Pos(8, 1), "nothing reaches the private function h"),
    (Pos(10, 1), "nothing reaches the private function k"))

test lints_of_names() :=
  var found: List[(Pos, Str)]
  linted(in List(NumberedName, ShowName), List(
    "function show_it(e1: Int): Str :=",
    "  show(e1)",
    "function f(x: Int): Int :=",
    "  let y2 := x in y2",
    "function show_ref(x: Int): Int :=",
    "  x"), out found)
  assert found == List(
    (Pos(1, 1), "the name show_it is show if it gives text that parses back, else format_ if it prints into another language"),
    (Pos(1, 18), "the name e1 has a numeric index, name it by its role"),
    (Pos(4, 7), "the name y2 has a numeric index, name it by its role"))

// a part repeats modulo the names that it binds, with the same free variables, bound at the same places, if it has at least
// repeat_threshold parts, only where no larger repeated part contains it, and only on one path, and in a procedure only if
// it reads no variable that the procedure assigns
test lints_of_repeated_parts() :=
  var found: List[(Pos, Str)]
  linted(in List(RepeatedExpr), List(
    "infix left 9 +",
    "infix right 8 ++",
    "function f(xs: List[Int], y: Int, z: Int): Int :=",
    "  g(h(size(xs), y), k(y)) + g(h(size(xs), y), k(y))",
    "function free(xs: List[Int], y: Int, z: Int): Int :=",
    "  g(h(size(xs), y), k(y)) + g(h(size(xs), z), k(z))",
    "function small(a: Int, b: Int): Int :=",
    "  f(a, b) + f(a, b)",
    "function bound(xs: List[Int]): List[Int] :=",
    "  List(for x in xs yield h(x, x, x, x)) ++ List(for z in xs yield h(z, z, z, z))",
    "function lambdas(): List[Int -> Int] :=",
    "  List(lambda a => h(a, a, a, a, a), lambda b => h(b, b, b, b, b))",
    "function largest(xs: List[Int], y: Int): Int :=",
    "  p(g(h(size(xs), y), k(y)), 1) + p(g(h(size(xs), y), k(y)), 1)",
    "function branches(c: Bool, xs: List[Int], y: Int): Int :=",
    "  if c then g(h(size(xs), y), k(y)) else g(h(size(xs), y), k(y))",
    "procedure q(in xs: List[Int], y: Int, out n: Int) :=",
    "  n := g(h(size(xs), y), k(y))",
    "  r(in g(h(size(xs), y), k(y)), out n)",
    "function siblings(xs: List[Int], ys: List[Int]): List[Int] :=",
    "  List(for x in xs yield g(h(x, x, x, x, x, x, x))) ++ List(for x in ys yield h(x, x, x, x, x, x, x))",
    "procedure t(in xs: List[Int], out n: Int) :=",
    "  var y := 1",
    "  n := g(h(size(xs), y), k(y))",
    "  y := 2",
    "  n := g(h(size(xs), y), k(y))"), out found)
  assert found == List(
    (Pos(4, 29), "the expression repeats the one of line 4"),
    (Pos(10, 44), "the expression repeats the one of line 10"),
    (Pos(12, 38), "the expression repeats the one of line 12"),
    (Pos(14, 35), "the expression repeats the one of line 14"),
    (Pos(19, 8), "the expression repeats the one of line 18"))

// two definitions are duplicates if their types and bodies are equal modulo the names of their formals and type parameters,
// and of the variables bound inside
test lints_of_duplicate_definitions() :=
  var found: List[(Pos, Str)]
  linted(in List(DuplicateDefinition), List(
    "infix left 9 +",
    "function f[A](xs: List[A], n: Int): Int :=",
    "  size(xs) + n",
    "function g[B](ys: List[B], m: Int): Int :=",
    "  size(ys) + m",
    "function h(ys: List[Int], m: Int): Int :=",
    "  size(ys) + m",
    "function k[B](m: Int, ys: List[B]): Int :=",
    "  size(ys) + m",
    "function l[B](ys: List[B], m: Int): Int :=",
    "  size(ys) + 1",
    "procedure p(in a: Int, out b: Int) :=",
    "  let c := a + 1",
    "  b := c",
    "procedure q(in x: Int, out y: Int) :=",
    "  let z := x + 1",
    "  y := z",
    "function four(): Int :=",
    "  4",
    "function vier(): Int :=",
    "  4"), out found)
  assert found == List(
    (Pos(4, 1), "the function g repeats the definition of f at line 2"),
    (Pos(15, 1), "the procedure q repeats the definition of p at line 12"))
