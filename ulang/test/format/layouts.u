// the layouts of format past 80 columns, over texts parsed without the library, which declare the operators they use
import ulang.syntax
import ulang.parse
import ulang.format

// a chain of infix operators, the bindings of a let, the declarations of a let or var, and the fields of a constructor
// are each spread one on each line past 80 columns, where a chain puts each operand after the first after its operator,
// one deeper, and the spread text formats as itself
test spread_layouts() :=
  var p: Source, q: Source
  let
    flat := join("\n", List(
      "infix right 8 ++",
      "",
      "infix left 9 + -",
      "",
      "infix left 10 *",
      "",
      "data Entry :=",
      "  case Entry(name: Str, description: Str, arguments: List[Str], examples: List[Str])",
      "  case Short(name: Str)",
      "",
      "function f(a: Str, b: Str): Str :=",
      "  \"the first part of the text\" ++ a ++ \"the second part of the text\" ++ b ++ \"the end\"",
      "",
      "function g(x: Int, y: Int): Int :=",
      "  x + 1000000000000 - y + 2000000000000 - x * 3000000000000 + (y - 4000000000000) - 50000000",
      "",
      "function h(a: Str, b: Str): Bool :=",
      "  a == \"the first part of the text\" ++ a ++ \"the second part of the text\" ++ b ++ \"the end\"",
      "",
      "function l(a: Str): Str :=",
      "  let first_binding := a ++ \"first\", second_binding := a ++ \"second\", third := a in",
      "  let x := a, y := match a case \"\" => \"empty\" case _ => a end in",
      "  first_binding ++ second_binding ++ third ++ x ++ y",
      "",
      "procedure m(in a: Str, out b: Str) :=",
      "  var first_variable := a, second_variable := a ++ \"second\", third_variable: List[Str]",
      "  let short := a, other := a",
      "  third_variable := List(short ++ other)",
      "  b := first_variable ++ second_variable ++ third_variable",
      "")),
    spread := join("\n", List(
      "infix right 8 ++",
      "",
      "infix left 9 + -",
      "",
      "infix left 10 *",
      "",
      "data Entry :=",
      "  case Entry(",
      "    name: Str,",
      "    description: Str,",
      "    arguments: List[Str],",
      "    examples: List[Str])",
      "  case Short(name: Str)",
      "",
      "function f(a: Str, b: Str): Str :=",
      "  \"the first part of the text\"",
      "    ++ a",
      "    ++ \"the second part of the text\"",
      "    ++ b",
      "    ++ \"the end\"",
      "",
      "function g(x: Int, y: Int): Int :=",
      "  x",
      "    + 1000000000000",
      "    - y",
      "    + 2000000000000",
      "    - x * 3000000000000",
      "    + (y - 4000000000000)",
      "    - 50000000",
      "",
      "function h(a: Str, b: Str): Bool :=",
      "  a == \"the first part of the text\"",
      "    ++ a",
      "    ++ \"the second part of the text\"",
      "    ++ b",
      "    ++ \"the end\"",
      "",
      "function l(a: Str): Str :=",
      "  let",
      "    first_binding := a ++ \"first\",",
      "    second_binding := a ++ \"second\",",
      "    third := a in",
      "  let",
      "    x := a,",
      "    y := match a",
      "      case \"\" =>",
      "        \"empty\"",
      "      case _ =>",
      "        a",
      "    end in",
      "  first_binding ++ second_binding ++ third ++ x ++ y",
      "",
      "procedure m(in a: Str, out b: Str) :=",
      "  var",
      "    first_variable := a,",
      "    second_variable := a ++ \"second\",",
      "    third_variable: List[Str]",
      "  let short := a, other := a",
      "  third_variable := List(short ++ other)",
      "  b := first_variable ++ second_variable ++ third_variable",
      ""))
  parse_text_recovering(in flat, out p)
  assert parse_errors(p) == List()
  assert format_program(p) == spread
  parse_text_recovering(in spread, out q)
  assert format_program(q) == spread
