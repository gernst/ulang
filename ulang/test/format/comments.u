// the placement of comments by format, over texts parsed without the library, which declare the operators they use
import ulang.syntax
import ulang.parse
import ulang.format

// comments stand anywhere, and format keeps them where they are, at the end of a line, before end, else, and catch, on
// a local line, between arguments, elements, and cases, and above a blank line
test formatted_comments() :=
  var p: Source
  let text := join("\n", List(
    "// the module",
    "",
    "infix 6 >",
    "",
    "infix left 9 +",
    "",
    "// a function",
    "function f(x: Int): Int := // after the head",
    "  g(",
    "    x, // between arguments",
    "    2)",
    "",
    "data T := // after data",
    "  // A",
    "  case A // after A",
    "  case B(x: Int)",
    "",
    "function g(x: Int, y: Int): Int :=",
    "  example g(1, 2) == 3 // after an example",
    "  let z := x + y in",
    "  // the body",
    "  match z",
    "    // zero",
    "    case 0 =>",
    "      1 // one",
    "",
    "    // between cases",
    "    case _ =>",
    "      List(",
    "        1, // between elements",
    "        2,",
    "        // before an element",
    "        3)",
    "  end",
    "",
    "// detached",
    "",
    "procedure main() :=",
    "  let x := 1 // on a local line",
    "  if x == 1 then // after then",
    "    os_println(in \"a\") // after a call",
    "    // before else",
    "  else",
    "    // after else",
    "",
    "    skip",
    "  end",
    "  while x > 1 do",
    "    skip",
    "    // before the end of a while",
    "  end",
    "  try",
    "    skip",
    "    // before catch",
    "  catch",
    "    case _ =>",
    "      skip",
    "    // before the end of a try",
    "  end",
    "// at the end")) ++ "\n"
  parse_text_recovering(in text, out p)
  assert parse_errors(p) == List()
  assert format_program(p) == text

// a comment that the layout of its part has no place for stands above the line of the part, from where it stays
test moved_comments() :=
  var p: Source
  let
    text := "procedure main() :=\n  let (a, // inner\n  b) := (1, 2)\n  assert a == b\n",
    moved := "procedure main() :=\n  // inner\n  let (a, b) := (1, 2)\n  assert a == b\n"
  parse_text_recovering(in text, out p)
  assert format_program(p) == moved
  parse_text_recovering(in moved, out p)
  assert format_program(p) == moved

// a comment inside a constructor, between the operands of a chain, or between the declarations of a let spreads them,
// so that it stays above the field, operand, or declaration that it precedes, or at the end of the line of the one
// before
test comments_of_spread_parts() :=
  var p: Source, q: Source
  let
    text := join("\n", List(
      "infix right 8 ++",
      "",
      "data T :=",
      "  case Noted(",
      "    // the name",
      "    name: Str, size: Int)",
      "",
      "function k(a: Str, b: Str): Str :=",
      "  a ++ // after a",
      "  b ++",
      "  // above c",
      "  \"c\"",
      "",
      "function l(a: Str): Str :=",
      "  let p := a, // after p",
      "  // above q",
      "  q := a in",
      "  p ++ q",
      "",
      "procedure n(in a: Str, out b: Str) :=",
      "  let first := a, // after first",
      "  // above second",
      "  second := a",
      "  b := first ++ second",
      "")),
    spread := join("\n", List(
      "infix right 8 ++",
      "",
      "data T :=",
      "  case Noted(",
      "    // the name",
      "    name: Str,",
      "    size: Int)",
      "",
      "function k(a: Str, b: Str): Str :=",
      "  a // after a",
      "    ++ b",
      "    // above c",
      "    ++ \"c\"",
      "",
      "function l(a: Str): Str :=",
      "  let",
      "    p := a, // after p",
      "    // above q",
      "    q := a in",
      "  p ++ q",
      "",
      "procedure n(in a: Str, out b: Str) :=",
      "  let",
      "    first := a, // after first",
      "    // above second",
      "    second := a",
      "  b := first ++ second",
      ""))
  parse_text_recovering(in text, out p)
  assert parse_errors(p) == List()
  assert format_program(p) == spread
  parse_text_recovering(in spread, out q)
  assert format_program(q) == spread
