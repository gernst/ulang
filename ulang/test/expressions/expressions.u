// expressions: arithmetic, let, conditionals, lambdas, tuples, overloading, and notations, and the characters and strings
// with their builtins

// arithmetic and precedence
test arithmetic_precedence() :=
  assert 1 + 2 * 3 - 4 / 2 == 5
  assert (-2) * -3 == 6
  assert 7 % 3 == 1
  assert (-7) % 3 == -1
  assert not 1 < 2 or 1 + 1 == 2 and true
  assert (not true and false) == false
  assert (1 < 2) == (2 > 1)

// integers are unbounded, also beyond 64 bits, where the runtime of compiled programs switches to GMP
test big_integers() :=
  assert 9223372036854775807 + 1 == 9223372036854775808
  assert (-9223372036854775807) - 2 == -9223372036854775809
  assert 9223372036854775807 * 2 == 18446744073709551614
  assert 4294967296 * 4294967296 == 18446744073709551616
  assert ((-9223372036854775807) - 1) / -1 == 9223372036854775808
  assert ((-9223372036854775807) - 1) % -1 == 0
  assert 18446744073709551616 / 4294967296 == 4294967296
  assert (-18446744073709551617) % 10 == -7
  assert 18446744073709551616 - 18446744073709551615 == 1
  assert 9223372036854775808 > 9223372036854775807 and (-9223372036854775809) < 0
  assert show(100000000000000000000) == "100000000000000000000"

// the bindings of a let are sequential, each in scope of those before it, and a tuple binds in parallel
test let_sequential() :=
  assert (let x := 1, y := x + 1 in
  x + y * 3) == 7
  assert (let x := 1, y := 2 in
  let (a, b) := (y, x) in
  a * 10 + b) == 21

test conditionals() :=
  assert (if not 1 < 2 then 0 else 1) == 1

// a function has one list of formals, and returns a lambda to be applied partially
function plus(a: Int): Int -> Int :=
  lambda b => a + b

function sum3(a: Int): (Int, Int) -> () -> Int :=
  lambda b, c => lambda => a + b + c

test lambdas() :=
  assert (lambda f => f(f(1)))(lambda x => x * 2) == 4
  assert (lambda f, x => f(x))(lambda y => y + 1, 1) == 2
  assert plus(1)(2) == 3 and twice(plus(3), 1) == 7
  assert sum3(1)(2, 3)() == 6
  assert (let f := plus in
  f(1)(2)) == 3

// the formals of a lambda may be patterns, which it matches as let does
test lambda_patterns() :=
  assert foldl(List((1, 2), (3, 4)), 0, lambda n, (a, b) => n + a * b) == 14
  assert (lambda (a, b), c => a + b + c)((1, 2), 3) == 6
  assert (lambda (a, _) => a)((1, "b")) == 1

// a pattern may have a type, also inside, which the checker unifies with the type it matches
test annotated_patterns() :=
  assert (lambda p: Int * Int => first(p))((1, 2)) == 1
  assert (lambda (a: Int, b), c: Str => a + b + size(c))((1, 2), "ab") == 5
  assert List(for (x: Int, s) in List((1, "a")) yield show(x) ++ s) == List("1a")
  assert (let n: Int := 2, (a, b): Int * Int := (n, 3) in
  a * b) == 6

test literals() :=
  assert "a" == "a"
  assert () == ()
  assert 1 != 2

// and, or are not strict
test non_strict_and_or() :=
  assert (false and 1 / 0 == 0) == false
  assert true or 1 / 0 == 0

type Pair[A] :=
  A * A

function swap[A](p: Pair[A]): Pair[A] :=
  match p
    case (x, y) =>
      (y, x)
  end

// a function of one pair, whose type Int * Int -> Int differs from (Int, Int) -> Int of add
function sum(p: Int * Int): Int :=
  match p
    case (x, y) =>
      x + y
  end

function add(x: Int, y: Int): Int :=
  x + y

function apply(f: Int * Int -> Int): Int :=
  f((1, 2))

function xor(p: Bool * Bool): Bool :=
  match p
    case (true, false) =>
      true

    case (false, true) =>
      true

    case _ =>
      false
  end

// tuples are flat, unlike nested ones
function last(t: Int * Bool * Str): Str :=
  match t
    case (_, _, s) =>
      s
  end

function nested(t: Int * (Bool * Str)): Str :=
  match t
    case (_, (_, s)) =>
      s
  end

function divmod(a: Int, b: Int): Int * Int :=
  (a / b, a % b)

test tuples() :=
  assert swap((1, 2)) == (2, 1)
  assert sum((3, 4)) == 7
  assert apply(sum) == 3
  assert add(1, 2) == sum((1, 2))
  assert xor((true, false))
  assert xor((true, true)) == false
  assert last((1, true, "x")) == "x"
  assert nested((1, (true, "x"))) == "x"
  assert 1 == 1
  assert () == ()

// let binds one value per binder, patterns destructure them
test let_patterns() :=
  assert (let (q, r) := divmod(7, 2) in
  q * 10 + r) == 31
  assert (let (x, y) := (1, 2), z := 3 in
  x + y + z) == 6
  assert (let _ := 1, z := 2 in
  z) == 2

// overloads are told apart by their numbers of parameters
function pick(p: Int * Int): Int :=
  1

function pick(x: Int, y: Int): Int :=
  2

test overloads_by_parameters() :=
  local p := (3, 4)
  assert pick(p) == 1
  assert pick(3, 4) == 2
  assert pick((3, 4)) == 1

// -n for a number n is a negative literal, also in patterns, and - x applies the prefix operator
function sign_name(n: Int): Str :=
  match compare(n, 0)
    case -1 =>
      "negative"

    case 0 =>
      "zero"

    case _ =>
      "positive"
  end

test negative_literals() :=
  local x := 3
  assert (-2) + 5 == 3 and 2 * -3 == -6 and -x == -3 and -(1 + 2) == -3
  assert List(sign_name(-5), sign_name(0), sign_name(7)) == List("negative", "zero", "positive")

// 0x and hexadecimal digits of either case are a number, also negative and in patterns, which show writes in decimal
function hex_name(n: Int): Str :=
  match n
    case 0xFF =>
      "byte"

    case -0x10 =>
      "minus sixteen"

    case _ =>
      show(n)
  end

test hex_literals() :=
  assert 0xFF == 255 and 0xD800 == 55296 and 0x0 == 0 and (-0x10) == -16 and 0x10 - 1 == 15
  assert List(hex_name(255), hex_name(-16), hex_name(0x11)) == List("byte", "minus sixteen", "17")
  assert 0xFFFFFFFFFFFFFFFFFF == 4722366482869645213695

function fact(n: Int): Int :=
  if n == 0 then 1 else n * fact(n - 1)

function twice[A](f: A -> A, x: A): A :=
  f(f(x))

type Pred[A] :=
  A -> Bool

function pos(): Pred[Int] :=
  lambda x => x > 0

test functions() :=
  assert fact(5) == 120
  assert twice(lambda x => x * 3, 1) == 9
  assert pos()(1)
  assert pos()(0) == false

// operators are declared before their use, and defined as functions
infix left 11 **

function **(m: Int, n: Int): Int :=
  if n == 0 then 1 else m * m ** (n - 1)

// types use the same operators, -> associates to the right
function curry(f: (Int, Int) -> Int): Int -> Int -> Int :=
  lambda x => lambda y => f(x, y)

// functions are overloaded by their number of arguments
function length(xs: List[Int]): Int :=
  match xs
    case List() =>
      0
    case List(_; ys) =>
      1 + length(ys)
  end

function length(xs: List[Int], ys: List[Int]): Int :=
  length(xs) + length(ys)

test notations() :=
  assert List(1; List(2) ++ List(3)) == List(1, 2, 3)
  assert 2 ** 3 + 1 == 9
  assert 2 * 3 ** 2 == 18
  assert (-2) * -3 == 6
  assert curry(lambda a, b => a - b)(5)(3) == 2
  assert false ==> false
  assert not (true ==> false)
  assert length(List(1, 2)) == 2
  assert length(List(1), List(2, 3)) == 3

// characters, escapes, and the builtins on strings and characters
test characters() :=
  assert int('a') == 97
  assert chr(98) == 'b'
  assert chars("ab") == List('a', 'b')
  assert str(List('h', 'i')) == "hi"
  assert chars("\"\\\n\t") == List('"', '\\', '\n', '\t')
  assert '\'' != '"'

function vowel(c: Char): Bool :=
  match c
    case 'a' =>
      true

    case 'e' =>
      true

    case _ =>
      false
  end

test char_patterns() :=
  assert vowel('a') and not vowel('b')

test string_functions() :=
  assert "ab" ++ "c" == "abc" and "ab" ++ "c" ++ "" == "abc" and List(1) ++ List(2) == List(1, 2)
  assert size("hello") == 5
  assert join(", ", List("a", "b", "c")) == "a, b, c"
  assert join(", ", List()) == ""
  assert slice("hello", 1, 3) == "el"
  assert split("a,b,,c", ',') == List("a", "b", "", "c")
  assert at(0, "abc") == 'a' and at(2, "abc") == 'c'
  assert contains('b', "abc") and not contains('d', "abc")
  assert compare("ab", "b") == -1 and compare("b", "ab") == 1 and compare("a", "a") == 0 and compare("", "a") == -1
  assert show(42) == "42" and show(-7) == "-7" and show(0) == "0"
  assert quote("a\"b\\c\n") == "\"a\\\"b\\\\c\\n\"" and quote("it's") == "\"it's\""
  assert number("123") == Some(123) and number("-5") == Some(-5)
  assert number("1a") == None and number("") == None
  assert is_digit('7') and is_letter('Q') and is_space(' ')

// strings are sequences of code points, of which a character is one, in UTF-8 in files
test code_points() :=
  assert size("ä→") == 2 and at(0, "ä→") == 'ä' and at(1, "ä→") == '→' and get(1, "ä→") == Some('→')
  assert int('ä') == 228 and int('→') == 8594 and chr(8594) == '→' and int(chr(128512)) == 128512
  assert chars("aä→") == List('a', 'ä', '→') and str(chars("aä→😀")) == "aä→😀" and str(List(chr(1000))) == "Ϩ"
  assert slice("aä→😀b", 1, 4) == "ä→😀" and slice("a→b", 2, 3) == "b" and slice("→b", 1, 2) == "b"
  assert contains('→', "a→") and not contains('ä', "a→") and split("a→b→", '→') == List("a", "b", "")
  assert "ä" ++ "→" ++ "😀" == "ä→😀" and join("→", List("a", "ä")) == "a→ä" and size("😀" ++ "a") == 2
  assert compare("ä", "→") == -1 and "→" < "😀" and "a" < "ä" and compare("😀", "→a") == 1
  assert show("ä→") == "\"ä→\"" and show('→') == "'→'" and quote("→\n") == "\"→\\n\""
  assert number("１") == None and is_letter('ä') == false

test no_characters() :=
  assert raises NoCharacter(55296) do
    local c := chr(55296)
  end
  assert raises NoCharacter(1114112) do
    local c := chr(1114112)
  end
  assert int(chr(1114111)) == 1114111 and int(chr(57344)) == 57344

// bytes, made from and read as integers, and the UTF-8 of strings
test bytes() :=
  assert int(byte(0)) == 0 and int(byte(255)) == 255 and byte(1) < byte(2) and compare(byte(7), byte(7)) == 0
  assert show(byte(65)) == "byte(65)" and show(Array(byte(1), byte(2))) == "Array(byte(1), byte(2))"
  assert encode_utf8("aä→😀") == Array(for n in List(97, 195, 164, 226, 134, 146, 240, 159, 152, 128) yield byte(n))
  assert decode_utf8(encode_utf8("aä→😀")) == Some("aä→😀") and decode_utf8(Array()) == Some("")
  assert decode_utf8(Array(byte(255))) == None and decode_utf8(Array(byte(195))) == None
  assert decode_utf8(Array(byte(237), byte(160), byte(128))) == None
  assert raises NoByte(256) do
    local b := byte(256)
  end
  assert raises NoByte(-1) do
    local b := byte(-1)
  end

test division_by_zero() :=
  assert raises DivisionByZero do
    local n := 1 / 0
  end
  assert raises DivisionByZero do
    local n := 1 % 0
  end
