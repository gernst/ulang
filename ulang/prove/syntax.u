// the terms of the prover, over the names, literals, types, variables, and patterns of ulang/syntax/syntax.u, see ideas/prove.md
//
// Variables are de Bruijn indices for the binders inside a term (ELam, EMatch, and Seq and Concl of simp.u),
// and de Bruijn levels for the variables of the opened sequents, counted from the root.
// A list of binders binds from left to right, the last one is EBound(0).

import "ulang/syntax"

export

data Term :=
  case EBound(index: Int)
  case ELevel(level: Int)
  case ELit(lit: Lit)
  case EFun(name: Name)
  // of any head, a symbol, a variable, or a lambda, where tuples are constructors as well
  case EApp(fun: Term, args: List[Term])
  case ELam(formals: List[Var], body: Term)
  case EIte(cond: Term, then_expr: Term, else_expr: Term)
  case EMatch(arg: Term, cases: List[TermBranch])
  // c + k1·t1 + … + kn·tn, canonical: the ti sorted by compare and distinct, no ki == 0, no ti a Sum or a Const,
  // and neither c alone (a Const) nor 0 + 1·t (just t)
  case ESum(constant: Int, summands: List[Summand])

// factor·term in a sum
data Summand :=
  case Summand(term: Term, factor: Int)

// the variables of the pattern bind in the guard and the body, from left to right
data TermBranch :=
  case TermBranch(pat: Pat, guard: Option[Term], body: Term)

// a linear sum k + k1·t1 + … as it is computed with, which sum_term makes canonical
data Lin :=
  case Lin(k: Int, summands: List[Summand])

// a function by its formals, which bind in the body, whether it calls itself, also through others, its equations, and the
// definitions that it reaches by its body, by name and arity
data Def :=
  case Def(recursive: Bool, formals: List[Var], body: Term, equations: List[DefEquation], reaches: Set[Name * Int])

// an equation of one case of a definition, f(args) == rhs where the conds hold, over the variables vars, which bind in
// the other fields as the formals of a lemma do, the first one outermost; decided if rhs is the match or if of a case
// that is not refined further, which only unfolds where it is decided
data DefEquation :=
  case DefEquation(vars: List[Var], conds: List[Term], args: List[Term], rhs: Term, decided: Bool)

// a constructor by its datatype and its fields, where a field of the datatype itself is recursive
data ConstrDecl :=
  case ConstrDecl(datatype: Name, fields: List[Var])

// the symbols of a program: the definitions of functions by name and arity, as Defs.funs of ulang/check/defs.u, the
// constructors, the datatypes with their constructors in order, and the rank of each symbol in the order of
// declarations, the precedence of the term order, the abstract types, whose constructors are a representation that
// == need not respect, so that they are neither injective nor distinct, and the datatypes that are not ordered by
// their structure, the abstract types and those with a declared compare, and the recursive functions whose termination
// is proven, the only recursive ones that unfold
data Decls :=
  case Decls(defs: Map[Name * Int, Def], constrs: Map[Name, ConstrDecl], datatypes: Map[Name, List[Name]], ranks: Map[Name, Int], abstracts: Set[Name], ordered: Set[Name], terminating: Set[Name * Int])

data Rebind :=
  // the count outermost binders at depth become the levels from depth on
  case Open(depth: Int, count: Int)
  // the levels become binders, the first one outermost
  case Close(levels: List[Int])
  // indices of the binders around the term are increased by n
  case Shift(n: Int)

// the builtins of the prover by the names that checked programs carry: ==, <, and, and or have no module, and the
// operators of the prelude are those of prelude/prelude, where != and unary - are functions of the prelude that unfold
// to these, while <=, >, and >= are functions of the prelude that the prover takes as builtins, so that no comparison is
// negated: > and >= are < and <= with their sides swapped, and a negation moves into the comparison
pattern Not(a: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "not")), List(a))

pattern Implies(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "==>")), List(a, b))

pattern And(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "and")), List(a, b))

pattern Or(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "or")), List(a, b))

pattern Eq(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "==")), List(a, b))

// on integers only
pattern Less(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "<")), List(a, b))

pattern LessEq(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "<=")), List(a, b))

pattern Greater(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), ">")), List(a, b))

pattern GreaterEq(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), ">=")), List(a, b))

pattern Compare(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "compare")), List(a, b))

// the structural size of a value of any datatype, a builtin of the prover only, without a module, so that no checked
// program carries it and the size functions of the library stay apart, the measure of termination proofs
pattern Size(a: Term): Term :=
  EApp(EFun(Name(None, "size")), List(a))

pattern Plus(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "+")), List(a, b))

pattern Minus(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "-")), List(a, b))

pattern Times(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "*")), List(a, b))

pattern Div(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "/")), List(a, b))

pattern Mod(a: Term, b: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "%")), List(a, b))

pattern EBool(b: Bool): Term :=
  ELit(LBool(b))

pattern EInt(n: Int): Term :=
  ELit(LInt(n))

pattern Abs(a: Term): Term :=
  EApp(EFun(Name(Some("prelude/prelude"), "abs")), List(a))

// the constructors of lists and their concatenation, as checked programs name them
pattern ENil(): Term :=
  EFun(Name(Some("prelude/list"), "Nil"))

pattern ECons(head: Term, tail: Term): Term :=
  EApp(EFun(Name(Some("prelude/list"), "Cons")), List(head, tail))

pattern Append(xs: Term, ys: Term): Term :=
  EApp(EFun(Name(Some("prelude/list"), "++")), List(xs, ys))

// the quantifiers, which checked programs do not have yet
pattern Forall(formals: List[Var], body: Term): Term :=
  EApp(EFun(Name(None, "forall")), List(ELam(formals, body)))

pattern Exists(formals: List[Var], body: Term): Term :=
  EApp(EFun(Name(None, "exists")), List(ELam(formals, body)))

// the constructor of tuples of n components, as which ETuple is translated and PTuple matched, by a name that users
// cannot write
function tuple_name(n: Int): Name

// the term of the constructor c applied to its fields, the constructor alone if it has none
function constr_term(c: Name, args: List[Term]): Term

// the tuple of the components, a constructor of tuple_name
function tuple_term(args: List[Term]): Term

function is_tuple_term(t: Term): Bool

function empty_decls(): Decls

function is_constr(decls: Decls, f: Name): Bool

function constr_head(decls: Decls, e: Term): Option[Name * List[Term]]

// the field of an accessor T.f, whose name has a dot and no :=, which an updater T.f:= has
function field_of_accessor(name: Name): Option[Id]

function free_head(decls: Decls, e: Term): Option[Name * List[Term]]

function value_order(decls: Decls, a: Term, b: Term): Option[Int]

function rebind(op: Rebind, c: Int, e: Term): Term

// a variable that a proof defines by local x := e, which the simplifier keeps as a name, so that an open goal shows x
// where it has e, marked by a module that no program has, so that the mark survives rebinding and the simplification of
// the sequents that bind it
function defined_var(x: Var): Var

function is_defined_var(x: Var): Bool

function binders(p: Pat): Int

function pattern_vars(p: Pat): List[Var]

function shift(n: Int, e: Term): Term

function subst(c: Int, t: Term, e: Term): Term

function beta(args: List[Term], e: Term): Term

function replace(a: Term, b: Term, e: Term): Term

function occurs(a: Term, e: Term): Bool

function loose(c: Int, e: Term): List[Int]

// the symbols of the functions, constructors, and builtins that e names, each with the number of its arguments, or -1
// where it is passed without them
function symbols_in(e: Term): Set[Name * Int]

function lin_of(e: Term): Lin

function lin_add(a: Lin, b: Lin): Lin

function lin_scale(n: Int, a: Lin): Lin

function lin_sub(a: Lin, b: Lin): Lin

function sum_term(a: Lin): Term

function is_greater(decls: Decls, s: Term, t: Term): Bool

function print_term(names: List[Id], e: Term): Str

implementation

function tuple_name(n: Int): Name :=
  Name(None, "(" ++ str(List(for _ in range(1, n) yield ',')) ++ ")")

function constr_term(c: Name, args: List[Term]): Term :=
  if args == List() then EFun(c) else EApp(EFun(c), args)

function tuple_term(args: List[Term]): Term :=
  EApp(EFun(tuple_name(size(args))), args)

function is_tuple_term(t: Term): Bool :=
  match t
    case EApp(EFun(name), args) =>
      name == tuple_name(size(args))
    case _ =>
      false
  end

function empty_decls(): Decls :=
  Decls(empty(), empty(), empty(), empty(), empty(), empty(), empty())

function is_constr(decls: Decls, f: Name): Bool :=
  contains(f, decls.constrs)

// the constructor and the arguments of a constructor term
function constr_head(decls: Decls, e: Term): Option[Name * List[Term]] :=
  match e
    case EFun(name) if is_constr(decls, name) =>
      Some((name, List()))

    case EApp(EFun(name), args) if is_constr(decls, name) or is_tuple_term(e) =>
      Some((name, args))

    case _ =>
      None
  end

function field_of_accessor(name: Name): Option[Id] :=
  match split(name.base, '.')
    case List(_, f) =>
      if ends_with(f, ":=") then None else Some(f)
    case _ =>
      None
  end

// the constructor and the arguments of a constructor term whose constructors are free, injective and distinct for ==,
// which those of abstract types are not
function free_head(decls: Decls, e: Term): Option[Name * List[Term]] :=
  match constr_head(decls, e)
    case Some((f, args)) =>
      match get(f, decls.constrs)
        case Some(decl) if contains(decl.datatype, decls.abstracts) =>
          None
        case _ =>
          Some((f, args))
      end

    case None =>
      None
  end

// compare(a, b) where it is decided: 0 for equal terms, else for values of integers, booleans, tuples, and datatypes
// ordered by their structure, where constructors are ordered by their position in the declaration and then by their
// arguments from the left; strings and characters are left out
function value_order(decls: Decls, a: Term, b: Term): Option[Int] :=
  if a == b then
    Some(0)
  else
    match (a, b)
      case (EInt(m), EInt(n)) =>
        Some(compare(m, n))

      case (EBool(x), EBool(y)) =>
        Some(compare(x, y))

      case _ =>
        match (constr_head(decls, a), constr_head(decls, b))
          case (Some((f, xs)), Some((g, ys))) =>
            match (constr_position(decls, f), constr_position(decls, g))
              case (Some(i), Some(j)) =>
                if i != j then
                  Some(compare(i, j))
                else
                  values_order(decls, xs, ys)

              case _ =>
                None
            end

          case _ =>
            None
        end
    end

// the position of a constructor in its datatype, if that is ordered by its structure, 0 for tuples
function constr_position(decls: Decls, f: Name): Option[Int] :=
  match get(f, decls.constrs)
    case Some(decl) =>
      if contains(decl.datatype, decls.ordered) then
        None
      else
        match get(decl.datatype, decls.datatypes)
          case Some(constrs) =>
            index_of(f, constrs)
          case None =>
            None
        end

    case None =>
      if base_is_tuple(f) then Some(0) else None
  end

function base_is_tuple(f: Name): Bool :=
  f.module == None and starts_with(f.base, "(")

// the lexicographic order of the arguments, decided as soon as a pair is unequal
function values_order(decls: Decls, xs: List[Term], ys: List[Term]): Option[Int] :=
  match (xs, ys)
    case (List(), List()) =>
      Some(0)

    case (List(x; xs_), List(y; ys_)) =>
      match value_order(decls, x, y)
        case Some(0) =>
          values_order(decls, xs_, ys_)
        case other =>
          other
      end

    case _ =>
      None
  end

function rebind(op: Rebind, c: Int, e: Term): Term :=
  match e
    case EBound(index) =>
      rebind_bound(op, c, index)

    case ELevel(level) =>
      rebind_level(op, c, level)

    case EApp(fun, args) =>
      EApp(rebind(op, c, fun), List(for a in args yield rebind(op, c, a)))

    case ELam(formals, body) =>
      ELam(formals, rebind(op, c + size(formals), body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(rebind(op, c, cond), rebind(op, c, then_expr), rebind(op, c, else_expr))

    case EMatch(expr, cases) =>
      EMatch(rebind(op, c, expr), List(for br in cases yield rebind_branch(op, c, br)))

    // rebuilt, since opening and closing change the order of the atoms
    case ESum(constant, summands) =>
      sum_term(rebind_summands(op, c, summands, Lin(constant, List())))

    case _ =>
      e
  end

function rebind_bound(op: Rebind, c: Int, i: Int): Term :=
  if i < c then
    EBound(i)
  else
    match op
      case Open(depth, count) =>
        if i - c < count then
          ELevel(depth + count - 1 - (i - c))
        else
          EBound(i - count)

      case Close(levels) =>
        EBound(i + size(levels))

      case Shift(n) =>
        EBound(i + n)
    end

function rebind_level(op: Rebind, c: Int, l: Int): Term :=
  match op
    case Close(levels) =>
      match index_of(l, levels)
        case Some(j) =>
          EBound(c + size(levels) - 1 - j)
        case None =>
          ELevel(l)
      end

    case _ =>
      ELevel(l)
  end

function rebind_summands(op: Rebind, c: Int, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      rebind_summands(op, c, rest, lin_add(acc, lin_scale(summand.factor, lin_of(rebind(op, c, summand.term)))))
  end

function rebind_branch(op: Rebind, c: Int, br: TermBranch): TermBranch :=
  match br
    case TermBranch(pat, guard, body) =>
      let inner := c + binders(pat) in
      match guard
        case Some(h) =>
          TermBranch(pat, Some(rebind(op, inner, h)), rebind(op, inner, body))
        case None =>
          TermBranch(pat, None, rebind(op, inner, body))
      end
  end

function defined_var(x: Var): Var :=
  x with name := Name(Some("(definition)"), x.name.base)

function is_defined_var(x: Var): Bool :=
  x.name.module == Some("(definition)")

function binders(p: Pat): Int :=
  size(pattern_vars(p))

function pattern_vars(p: Pat): List[Var] :=
  match p
    case PVar(var) =>
      List(var)

    case PApp(_, pats) =>
      List(for q in pats for x in pattern_vars(q.that) yield x)

    case PTuple(args) =>
      List(for q in args for x in pattern_vars(q.that) yield x)

    case _ =>
      List()
  end

function shift(n: Int, e: Term): Term :=
  if n == 0 then e else rebind(Shift(n), 0, e)

// e with the binder c replaced by t, whose own free indices are those around e, and the binders above c moved down
function subst(c: Int, t: Term, e: Term): Term :=
  match e
    case EBound(index) =>
      if index == c then
        shift(c, t)
      else if index > c then
        EBound(index - 1)
      else
        e

    case EApp(fun, args) =>
      EApp(subst(c, t, fun), List(for a in args yield subst(c, t, a)))

    case ELam(formals, body) =>
      ELam(formals, subst(c + size(formals), t, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(subst(c, t, cond), subst(c, t, then_expr), subst(c, t, else_expr))

    case EMatch(expr, cases) =>
      EMatch(subst(c, t, expr), List(for br in cases yield subst_branch(c, t, br)))

    case ESum(constant, summands) =>
      sum_term(subst_summands(c, t, summands, Lin(constant, List())))

    case _ =>
      e
  end

function subst_summands(c: Int, t: Term, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      subst_summands(c, t, rest, lin_add(acc, lin_scale(summand.factor, lin_of(subst(c, t, summand.term)))))
  end

function subst_branch(c: Int, t: Term, br: TermBranch): TermBranch :=
  match br
    case TermBranch(pat, guard, body) =>
      let inner := c + binders(pat) in
      match guard
        case Some(h) =>
          TermBranch(pat, Some(subst(inner, t, h)), subst(inner, t, body))
        case None =>
          TermBranch(pat, None, subst(inner, t, body))
      end
  end

// the body of as many binders as there are arguments, applied to them, where the last argument is EBound(0)
function beta(args: List[Term], e: Term): Term :=
  match reverse(args)
    case List() =>
      e
    case List(a; rest) =>
      beta(reverse(rest), subst(0, shift(size(rest), a), e))
  end

// e with every occurrence of a replaced by b, where a and b have no free indices
function replace(a: Term, b: Term, e: Term): Term :=
  if e == a then
    b
  else
    match e
      case EApp(fun, args) =>
        EApp(replace(a, b, fun), List(for x in args yield replace(a, b, x)))

      case ELam(formals, body) =>
        ELam(formals, replace(a, b, body))

      case EIte(cond, then_expr, else_expr) =>
        EIte(replace(a, b, cond), replace(a, b, then_expr), replace(a, b, else_expr))

      case EMatch(expr, cases) =>
        EMatch(replace(a, b, expr), List(for br in cases yield replace_branch(a, b, br)))

      case ESum(constant, summands) =>
        sum_term(replace_summands(a, b, summands, Lin(constant, List())))

      case _ =>
        e
    end

function replace_summands(a: Term, b: Term, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      replace_summands(a, b, rest, lin_add(acc, lin_scale(summand.factor, lin_of(replace(a, b, summand.term)))))
  end

function replace_branch(a: Term, b: Term, br: TermBranch): TermBranch :=
  match br
    case TermBranch(pat, guard, body) =>
      match guard
        case Some(h) =>
          TermBranch(pat, Some(replace(a, b, h)), replace(a, b, body))
        case None =>
          TermBranch(pat, None, replace(a, b, body))
      end
  end

function occurs(a: Term, e: Term): Bool :=
  if e == a then
    true
  else
    match e
      case EApp(fun, args) =>
        occurs(a, fun) or exists(args, lambda x => occurs(a, x))

      case ELam(_, body) =>
        occurs(a, body)

      case EIte(cond, then_expr, else_expr) =>
        occurs(a, cond) or occurs(a, then_expr) or occurs(a, else_expr)

      case EMatch(expr, cases) =>
        occurs(a, expr) or exists(cases, lambda br => occurs_branch(a, br))

      case ESum(_, summands) =>
        exists(summands, lambda summand => occurs(a, summand.term))

      case _ =>
        false
    end

function occurs_branch(a: Term, br: TermBranch): Bool :=
  match br
    case TermBranch(_, Some(h), body) =>
      occurs(a, h) or occurs(a, body)
    case TermBranch(_, None, body) =>
      occurs(a, body)
  end

function symbols_in(e: Term): Set[Name * Int] :=
  match e
    case EBound(_) =>
      empty()

    case ELevel(_) =>
      empty()

    case ELit(_) =>
      empty()

    case EFun(name) =>
      Set((name, -1))

    case EApp(EFun(name), args) =>
      insert((name, size(args)), Set(for a in args for n in symbols_in(a) yield n))

    case EApp(fun, args) =>
      symbols_in(fun) ++ Set(for a in args for n in symbols_in(a) yield n)

    case ELam(_, body) =>
      symbols_in(body)

    case EIte(cond, then_expr, else_expr) =>
      symbols_in(cond) ++ symbols_in(then_expr) ++ symbols_in(else_expr)

    case EMatch(arg, cases) =>
      symbols_in(arg) ++ Set(for br in cases for n in symbols_in_branch(br) yield n)

    case ESum(_, summands) =>
      Set(for summand in summands for n in symbols_in(summand.term) yield n)
  end

function symbols_in_branch(br: TermBranch): Set[Name * Int] :=
  match br
    case TermBranch(_, Some(guard), body) =>
      symbols_in(guard) ++ symbols_in(body)
    case TermBranch(_, None, body) =>
      symbols_in(body)
  end

// the free indices of e below c binders, relative to them
function loose(c: Int, e: Term): List[Int] :=
  match e
    case EBound(index) =>
      if index >= c then List(index - c) else List()

    case EApp(fun, args) =>
      loose(c, fun) ++ List(for a in args for i in loose(c, a) yield i)

    case ELam(formals, body) =>
      loose(c + size(formals), body)

    case EIte(cond, then_expr, else_expr) =>
      loose(c, cond) ++ loose(c, then_expr) ++ loose(c, else_expr)

    case EMatch(expr, cases) =>
      loose(c, expr) ++ List(for br in cases for i in loose_branch(c, br) yield i)

    case ESum(_, summands) =>
      List(for summand in summands for i in loose(c, summand.term) yield i)

    case _ =>
      List()
  end

function loose_branch(c: Int, br: TermBranch): List[Int] :=
  match br
    case TermBranch(pat, guard, body) =>
      let inner := c + binders(pat) in
      match guard
        case Some(h) =>
          loose(inner, h) ++ loose(inner, body)
        case None =>
          loose(inner, body)
      end
  end

function lin_of(e: Term): Lin :=
  match e
    case ESum(constant, summands) =>
      Lin(constant, summands)

    case EInt(num) =>
      Lin(num, List())

    case _ =>
      Lin(0, List(Summand(e, 1)))
  end

function lin_add(a: Lin, b: Lin): Lin :=
  Lin(a.k + b.k, merge_summands(a.summands, b.summands))

function merge_summands(ts: List[Summand], us: List[Summand]): List[Summand] :=
  match (ts, us)
    case (List(), _) =>
      us

    case (_, List()) =>
      ts

    case (List(t; ts_), List(u; us_)) =>
      match compare(t.term, u.term)
        case -1 =>
          List(t; merge_summands(ts_, us))

        case 1 =>
          List(u; merge_summands(ts, us_))

        case _ =>
          if t.factor + u.factor == 0 then
            merge_summands(ts_, us_)
          else
            List(t with factor := t.factor + u.factor; merge_summands(ts_, us_))
      end
  end

function lin_scale(n: Int, a: Lin): Lin :=
  if n == 0 then
    Lin(0, List())
  else
    Lin(n * a.k, List(for summand in a.summands yield summand with factor := n * summand.factor))

function lin_sub(a: Lin, b: Lin): Lin :=
  lin_add(a, lin_scale(-1, b))

function sum_term(a: Lin): Term :=
  match a
    case Lin(k, List()) =>
      EInt(k)

    case Lin(0, List(Summand(t, 1))) =>
      t

    case Lin(k, summands) =>
      ESum(k, summands)
  end

function is_greater(decls: Decls, s: Term, t: Term): Bool :=
  if s == t then
    false
  else
    match (s, t)
      case (_, EBound(_)) =>
        occurs(t, s)

      case (EBound(_), _) =>
        false

      case _ =>
        if exists(args_of(s), lambda a => a == t or is_greater(decls, a, t)) then
          true
        else
          let c := compare(head_key(decls, s), head_key(decls, t)) in
          if c > 0 then
            dominates(decls, s, args_of(t))
          else if c == 0 then
            is_lex_greater(decls, args_of(s), args_of(t)) and dominates(decls, s, args_of(t))
          else
            false
    end

function dominates(decls: Decls, s: Term, ts: List[Term]): Bool :=
  forall(ts, lambda t => is_greater(decls, s, t))

function is_lex_greater(decls: Decls, ss: List[Term], ts: List[Term]): Bool :=
  match (ss, ts)
    case (List(s; ss_), List(t; ts_)) =>
      if s == t then
        is_lex_greater(decls, ss_, ts_)
      else
        is_greater(decls, s, t)

    case _ =>
      false
  end

function head_key(decls: Decls, e: Term): Int * Int :=
  match e
    case ELit(_) =>
      (0, 0)

    case ELevel(level) =>
      (1, level)

    case ESum(_, _) =>
      (2, 0)

    case EFun(name) =>
      (3, rank(decls, name))

    case EApp(EFun(name), _) =>
      (3, rank(decls, name))

    case EApp(_, _) =>
      (4, 0)

    case EIte(_, _, _) =>
      (5, 0)

    case EMatch(_, _) =>
      (6, 0)

    case _ =>
      (7, 0)
  end

function rank(decls: Decls, f: Name): Int :=
  value_or(get(f, decls.ranks), -1)

function args_of(e: Term): List[Term] :=
  match e
    case EApp(EFun(_), args) =>
      args

    case EApp(fun, args) =>
      List(fun; args)

    case ESum(_, summands) =>
      List(for summand in summands yield summand.term)

    case EIte(cond, then_expr, else_expr) =>
      List(cond, then_expr, else_expr)

    case EMatch(expr, _) =>
      List(expr)

    case _ =>
      List()
  end

function infix_ops(): List[Id] :=
  List(
    "==>",
    "or",
    "and",
    "==",
    "!=",
    "<",
    "<=",
    ">",
    ">=",
    "++",
    "+",
    "-",
    "*",
    "/",
    "%")

function print_term(names: List[Id], e: Term): Str :=
  print_in(names, List(), e)

function print_in(names: List[Id], bound: List[Id], e: Term): Str :=
  match e
    case EBound(index) =>
      if index < size(bound) then
        at(index, from_list(bound))
      else
        "#" ++ show(index)

    case ELevel(level) =>
      if level < size(names) then
        at(level, from_list(names))
      else
        "@" ++ show(level)

    case ELit(lit) =>
      print_val(lit)

    case ENil() =>
      "[]"

    case EFun(Name(_, base)) =>
      base

    case ECons(a, b) =>
      "[" ++ print_in(names, bound, a) ++ "; " ++ print_in(names, bound, b) ++ "]"

    case Not(a) =>
      "not " ++ print_arg(names, bound, a)

    case Forall(formals, body) =>
      "forall " ++ print_binders(formals) ++ " => " ++ print_in(names, bound_names(formals, bound), body)

    case Exists(formals, body) =>
      "exists " ++ print_binders(formals) ++ " => " ++ print_in(names, bound_names(formals, bound), body)

    case EApp(EFun(Name(_, base)), List(a, b)) if contains(base, infix_ops()) =>
      print_arg(names, bound, a) ++ " " ++ base ++ " " ++ print_arg(names, bound, b)

    case EApp(fun, args) =>
      print_arg(names, bound, fun) ++ "(" ++ join(", ", List(for a in args yield print_in(names, bound, a))) ++ ")"

    case ELam(formals, body) =>
      "lambda " ++ print_binders(formals) ++ " => " ++ print_in(names, bound_names(formals, bound), body)

    case EIte(cond, then_expr, else_expr) =>
      "if " ++ print_in(names, bound, cond) ++ " then " ++ print_in(names, bound, then_expr) ++ " else " ++ print_in(names, bound, else_expr)

    case EMatch(expr, cases) =>
      "match " ++ print_in(names, bound, expr) ++ join("", List(for br in cases yield print_branch(names, bound, br))) ++ " end"

    case ESum(constant, summands) =>
      print_sum(names, bound, constant, summands)
  end

function bound_names(xs: List[Var], bound: List[Id]): List[Id] :=
  reverse(List(for x in xs yield x.name.base)) ++ bound

function print_binders(xs: List[Var]): Str :=
  join(", ", List(for x in xs yield x.name.base))

function print_arg(names: List[Id], bound: List[Id], e: Term): Str :=
  match e
    case EApp(EFun(Name(_, base)), List(_, _)) if contains(base, infix_ops()) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case Not(_) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case Forall(_, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case Exists(_, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case ESum(_, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case EIte(_, _, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case ELam(_, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case EInt(num) if num < 0 =>
      "(" ++ show(num) ++ ")"

    case _ =>
      print_in(names, bound, e)
  end

function print_branch(names: List[Id], bound: List[Id], br: TermBranch): Str :=
  match br
    case TermBranch(pat, g, body) =>
      let inner := bound_names(pattern_vars(pat), bound) in
      let guard := match g
        case Some(h) =>
          " if " ++ print_in(names, inner, h)
        case None =>
          ""
      end in
      " case " ++ print_pat(pat) ++ guard ++ " => " ++ print_in(names, inner, body)
  end

function print_pat(p: Pat): Str :=
  match p
    case PWild =>
      "_"

    case PLit(lit) =>
      print_val(lit)

    case PVar(var) =>
      var.name.base

    case PNil() =>
      "[]"

    case PCons(a, b) =>
      "[" ++ print_pat(a.that) ++ "; " ++ print_pat(b.that) ++ "]"

    case PApp(Name(_, base), List()) =>
      base

    case PApp(Name(_, base), pats) =>
      base ++ "(" ++ join(", ", List(for q in pats yield print_pat(q.that))) ++ ")"

    case PTuple(args) =>
      "(" ++ join(", ", List(for q in args yield print_pat(q.that))) ++ ")"
  end

// the atoms first, as written, then the constant
function print_sum(names: List[Id], bound: List[Id], k: Int, ts: List[Summand]): Str :=
  let first_summand := match ts
    case List(Summand(t, n); _) =>
      if n == 1 then
        print_arg(names, bound, t)
      else if n == -1 then
        "-" ++ print_arg(names, bound, t)
      else
        show(n) ++ " * " ++ print_arg(names, bound, t)

    case List() =>
      show(k)
  end in
  let rest := match ts
    case List(_; more) =>
      join("", List(for summand in more yield print_summand(names, bound, summand)))
    case List() =>
      ""
  end in
  let constant := if ts == List() or k == 0 then
    ""
  else if k > 0 then
    " + " ++ show(k)
  else
    " - " ++ show(0 - k) in
  first_summand ++ rest ++ constant

function print_summand(names: List[Id], bound: List[Id], summand: Summand): Str :=
  let t := summand.term, n := summand.factor in
  if n == 1 then
    " + " ++ print_arg(names, bound, t)
  else if n == -1 then
    " - " ++ print_arg(names, bound, t)
  else if n > 0 then
    " + " ++ show(n) ++ " * " ++ print_arg(names, bound, t)
  else
    " - " ++ show(0 - n) ++ " * " ++ print_arg(names, bound, t)

function print_val(v: Lit): Str :=
  match v
    case LUnit =>
      "()"

    case LBool(bool) =>
      show(bool)

    case LInt(num) =>
      show(num)

    case LStr(text) =>
      quote(text)

    case LChar(char) =>
      show(char)
  end
