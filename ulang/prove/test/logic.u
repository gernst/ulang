// lemmas of the connectives, of equality, and of the order on values other than integers

lemma excluded_middle(b: Bool) :=
  ensures b or not b

lemma equal_booleans(a: Bool, b: Bool) :=
  requires a == b, a
  ensures  b

lemma congruence(f: Int -> Int, x: Int, y: Int) :=
  requires x == y
  ensures  f(x) == f(y)

lemma congruence_closure(g: Int -> Int, a: Int) :=
  requires g(g(g(a))) == a, g(g(g(g(g(a))))) == a
  ensures  g(a) == a

lemma transitive_equality(a: Int, b: Int, c: Int) :=
  requires a == b, b == c
  ensures  a == c

lemma conditional_same(c: Bool, x: Int) :=
  ensures (if c then x else x) == x

lemma irreflexive_values(xs: List[Int], b: Bool, x: Int) :=
  ensures not xs < xs and not b < b and not (x, x) < (x, x)

lemma asymmetric_lists(xs: List[Int], ys: List[Int]) :=
  requires xs < ys
  ensures  not ys < xs

lemma irreflexive_under_lambda(xs: List[Int]) :=
  ensures forall(xs, lambda y => not y < y) and not exists(xs, lambda y => y < y)

function pick(o: Option[Int]): Bool :=
  match o
    case Some(y) =>
      not y < y
    case None =>
      true
  end

lemma irreflexive_in_case(o: Option[Int]) :=
  ensures pick(o)
