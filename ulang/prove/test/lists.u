// lemmas about the lists of the library, which the prover proves by its default proof

lemma evaluation() :=
  ensures size(List(1, 2, 3) ++ List(4)) == 4 and reverse(List(1, 2, 3)) == List(3, 2, 1)

lemma evaluation_take_drop() :=
  ensures take(2, List(1, 2, 3)) ++ drop(2, List(1, 2, 3)) == List(1, 2, 3)

lemma size_cons[A](x: A, xs: List[A]) :=
  ensures size(List(x; xs)) == 1 + size(xs)

lemma cons_injective[A](x: A, y: A, xs: List[A], ys: List[A]) :=
  requires List(x; xs) == List(y; ys)
  ensures  x == y and xs == ys

lemma cons_acyclic[A](x: A, xs: List[A]) :=
  ensures List(x; xs) != xs and List(x; xs) != List()

lemma append_nil[A](xs: List[A]) :=
  ensures xs ++ List() == xs

lemma append_assoc[A](xs: List[A], ys: List[A], zs: List[A]) :=
  ensures (xs ++ ys) ++ zs == xs ++ ys ++ zs

lemma size_append[A](xs: List[A], ys: List[A]) :=
  ensures size(xs ++ ys) == size(xs) + size(ys)

// by size_append, which is a fact of the lemmas after it
lemma size_twice[A](xs: List[A]) :=
  ensures size(xs ++ xs) == 2 * size(xs)

lemma size_reverse_onto[A](xs: List[A], ys: List[A]) :=
  ensures size(reverse_onto(xs, ys)) == size(xs) + size(ys)

lemma take_drop[A](n: Int, xs: List[A]) :=
  ensures take(n, xs) ++ drop(n, xs) == xs

lemma size_positive[A](xs: List[A]) :=
  ensures 0 <= size(xs)

// by size_positive
lemma size_cons_positive[A](x: A, xs: List[A]) :=
  ensures 0 < size(List(x; xs))

lemma reverse_onto_twice[A](xs: List[A], ys: List[A]) :=
  ensures reverse_onto(reverse_onto(xs, ys), List()) == reverse_onto(ys, xs)

// by reverse_onto_twice
lemma reverse_twice[A](xs: List[A]) :=
  ensures reverse(reverse(xs)) == xs

lemma reverse_onto_concat[A](xs: List[A], ys: List[A], zs: List[A]) :=
  ensures reverse_onto(xs ++ ys, zs) == reverse_onto(ys, reverse_onto(xs, zs))

// by size_append, which does not orient as a rule but is used as a fact of the sums
lemma size_append_commutes[A](xs: List[A], ys: List[A]) :=
  ensures size(xs ++ ys) == size(ys ++ xs)

lemma evaluation_range() :=
  ensures size(range(0, 30)) == 30

lemma identity_comprehension(xs: List[Int]) :=
  ensures List(for y in xs yield y) == xs

// by splits on xs and on its tail, where the unfolding of take and drop is stuck
lemma excluded_constructor(xs: List[Int]) :=
  requires xs != List()
  ensures  take(1, xs) ++ drop(1, xs) == xs

// by the equations of range, beyond the depth of 64 unfoldings of before
lemma evaluation_deep() :=
  ensures size(range(0, 100)) == 100
