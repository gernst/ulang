// lemmas of linear arithmetic over the integers and of splits on conditions

lemma successor(in a: Int, b: Int) :=
  requires a < b
  ensures  a + 1 <= b

lemma transitive(in a: Int, b: Int, c: Int) :=
  requires a < b, b < c
  ensures  a + 2 <= c

lemma linear(in a: Int, b: Int) :=
  ensures 2 * a + b == b + a + a

lemma antisymmetric(in a: Int, b: Int) :=
  requires a <= b, b <= a
  ensures  a == b

function maximum(a: Int, b: Int): Int :=
  if a < b then b else a

lemma maximum_bounds(in a: Int, b: Int) :=
  ensures maximum(a, b) >= a and maximum(a, b) >= b

lemma irreflexive(in x: Int) :=
  ensures not x < x

// as an implication, since its tests would be Vacuous with x < x as an assumption
lemma irreflexive_assumption(in x: Int) :=
  ensures x < x ==> false

lemma irreflexive_atoms[A](in xs: List[A], x: Int, y: Int, g: Int -> Int) :=
  ensures not size(xs) < size(xs) and not x * y < x * y and not x / 2 < x / 2 and not g(x) < g(x)

lemma unequal_ordered(in x: Int, y: Int) :=
  requires x != y
  ensures  x < y or y < x

lemma trichotomy(in x: Int, y: Int) :=
  ensures x < y or x == y or y < x

lemma parity(in x: Int, y: Int) :=
  ensures 2 * x != 2 * y + 1

lemma scaled_sum(in x: Int, y: Int) :=
  ensures 3 * (x + y) == 3 * x + 3 * y

lemma maximum_commutes(in a: Int, b: Int) :=
  ensures maximum(a, b) == maximum(b, a)

lemma maximum_of_less(in a: Int, b: Int) :=
  requires a < b
  ensures  maximum(a, b) == b

function fib(n: Int): Int :=
  if n < 2 then n else fib(n - 1) + fib(n - 2)

lemma fib_evaluation() :=
  ensures fib(15) == 610

// unary minus is not recursive, though its body applies the binary minus of the same name
lemma unary_minus(in x: Int) :=
  ensures -x == 0 - x and -x + x == 0

// by m == 3 * (m / 3) + m % 3 and the bounds of m % 3, which the atoms of division by a literal come with
lemma division_remainder(in m: Int) :=
  ensures m == m / 3 * 3 + m % 3

lemma remainder_bound(in m: Int) :=
  requires m >= 0
  ensures  m % 2 < 2

lemma halving(in m: Int) :=
  ensures 2 * m / 2 == m

lemma remainder_sign(in m: Int) :=
  requires m >= 0
  ensures  m % 3 >= 0

lemma remainder_negative(in m: Int) :=
  requires m < 0
  ensures  m % 3 <= 0

// by products distributed into sums of monomials, whose atoms are ordered, and squares at least 0
lemma square_nonnegative(in x: Int) :=
  ensures x * x >= 0

lemma distributive(in x: Int, y: Int, z: Int) :=
  ensures x * (y + z) == x * y + x * z

lemma associative(in x: Int, y: Int, z: Int) :=
  ensures x * y * z == x * (y * z)

lemma difference_of_squares(in x: Int, y: Int) :=
  ensures (x + y) * (x - y) == x * x - y * y

lemma binomial(in x: Int) :=
  ensures (x + 1) * (x + 1) == x * x + 2 * x + 1

// by the facts of division by a variable divisor, which the sign of the divisor bounds, as the literal one does
lemma remainder_below(in m: Int, n: Int) :=
  requires n > 0
  ensures  m % n < n

lemma remainder_above(in m: Int, n: Int) :=
  requires n < 0
  ensures  n < m % n

// the sign of the remainder by that of the dividend, where the divisor is only known not to be 0
lemma remainder_of_nonnegative(in m: Int, n: Int) :=
  requires m >= 0, n != 0
  ensures  m % n >= 0

lemma quotient_and_remainder(in m: Int, n: Int) :=
  requires n != 0
  ensures  n * (m / n) + m % n == m

// gcd unfolds, since it terminates by the absolute value of its divisor
lemma gcd_zero(in a: Int) :=
  ensures gcd(a, 0) == abs(a)
