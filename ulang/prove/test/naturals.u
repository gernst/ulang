// lemmas of a datatype of naturals, where commutativity, which does not orient, is an equation of the saturation of
// simp_eq of ulang/prove/simp.u, as the induction hypothesis of add_commutes and as a fact of the lemma after it

data Nat :=
  case Zero
  case Succ(pred: Nat)

function add(m: Nat, n: Nat): Nat :=
  match m
    case Zero =>
      n
    case Succ(p) =>
      Succ(add(p, n))
  end

lemma add_zero(in m: Nat) :=
  ensures add(m, Zero) == m

lemma add_succ(in m: Nat, n: Nat) :=
  ensures add(m, Succ(n)) == Succ(add(m, n))

lemma add_commutes(in m: Nat, n: Nat) :=
  ensures add(m, n) == add(n, m)

lemma add_commutes_inside(in a: Nat, b: Nat, c: Nat) :=
  ensures add(c, add(a, b)) == add(add(b, a), c)

// nested inductions, whose inner hypothesis keeps m, the formal of the outer one, at its value, Zero or Succ(p)
lemma add_commutes_nested(in m: Nat, n: Nat) :=
  ensures add(m, n) == add(n, m)
  induction m
    case Zero =>
      induction n
        case Succ(k) =>
          call add_commutes_nested(in Zero, k)
      end

    case Succ(p) =>
      induction n
        case Zero =>
          call add_commutes_nested(in p, Zero)

        case Succ(k) =>
          call add_commutes_nested(in p, Succ(k))
          call add_commutes_nested(in Succ(p), k)
          call add_commutes_nested(in p, k)
      end
  end
