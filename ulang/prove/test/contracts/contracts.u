// the contract of an exported procedure is on its signature in export, which its definition does not repeat, and which
// a claim of the implementation proves

export

procedure double(in x: Int, out y: Int) :=
  requires x >= 0
  ensures  y == 2 * x and y >= x

implementation

procedure double(in x: Int, out y: Int) :=
  y := x + x

lemma double_correct(in x: Int, out y: Int) :=
  correct double(in x, out y)

test double_three() :=
  var y: Int
  double(in 3, out y)
  assert y == 6
