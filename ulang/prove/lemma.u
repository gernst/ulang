// the default proof of lemmas, until proofs have syntax, see prove.md, which is not versioned

import "ulang/syntax"

export

// a lemma with the gaps that its proof leaves, none if it is proven
data Proved :=
  case Proved(name: Name, gaps: List[Gap])

// the lemmas with their goals after the proofs, and the terminations of the recursive functions that they reach
data Proofs :=
  case Proofs(lemmas: List[Proved], terminations: List[Termination])

// the lemmas in their order, each by simplification, else by induction on the first of its formals by which all cases
// close, where the lemmas proven before are assumptions, and the recursive functions that they reach unfold only if
// their termination is proven
function prove_lemmas(decls: Decls, lemmas: List[Lemma]): Proofs

function is_proven(proved: Proved): Bool

// an open lemma, or a recursive function that a lemma reaches whose termination is not proven
function has_errors(proofs: Proofs): Bool

// a call that no measure of the termination of its function decreases, as the call and the conditions before it
function print_open_call(site: CallSite): Str

// a gap as text, its goal if it has one, else its message, with its position if it has one
function print_gap(gap: Gap): Str

// a gap of the lemma as an error of a proof
function gap_diagnostic(name: Name, gap: Gap): Diagnostic

// a function whose termination is not proven, of module m, the main module of the run, as an error of a proof, at its
// call that no measure decreases
function termination_diagnostic(m: Id, site: CallSite): Diagnostic

// a lemma that its proof leaves open, with its first gap as print_gap writes it
data OpenLemma :=
  case OpenLemma(name: Str, goal: Str)

// a recursive function whose termination is not proven, with the first call that no measure decreases
data OpenTermination :=
  case OpenTermination(name: Str, recursion: Str)

// proves the lemmas of the module m of the checked program q in their order, raising OpenTermination for the first
// function that they reach whose termination is not proven, else OpenLemma for the first lemma that is open
procedure prove_program(in q: Prog, m: Id) raises OpenLemma, OpenTermination

implementation

procedure prove_program(in q: Prog, m: Id) raises OpenLemma, OpenTermination :=
  local t := translate(q, m), proofs := prove_lemmas(t.decls, t.lemmas)
  for tm in proofs.terminations do
    match tm.open
      case List(site; _) =>
        raise OpenTermination(first(site.caller).base, print_open_call(site))
      case List() =>
        skip
    end
  end
  for p in proofs.lemmas do
    match p.gaps
      case List(gap; _) =>
        raise OpenLemma(p.name.base, print_gap(gap))
      case List() =>
        skip
    end
  end

function prove_lemmas(decls: Decls, lemmas: List[Lemma]): Proofs :=
  let roots := Set(for l in lemmas for k in defined_in(decls, lemma_symbols(l)) yield k) in
  let ts := terminations(decls, roots) in
  let proven := Set(for t in ts if is_terminating(t) for k in t.names yield k) in
  Proofs(proofs(decls with terminating := proven, lemmas, List()), ts)

function has_errors(proofs: Proofs): Bool :=
  exists(proofs.lemmas, lambda p => not is_proven(p)) or exists(proofs.terminations, lambda t => not is_terminating(t))

function print_open_call(site: CallSite): Str :=
  let r := site.recursion in
  let names := List(for x in r.vars yield x.name.base) in
  let text := match r.args
    case Some(args) =>
      print_term(names, EApp(EFun(first(r.name)), args))
    case None =>
      first(r.name).base ++ " under a lambda or in a condition"
  end in
  if r.path == List() then
    text
  else
    text ++ " where " ++ join(" and ", List(for c in r.path yield print_term(names, c)))

// the definitions that the symbols name, by name and arity, where a name without arguments names all its arities
function defined_in(decls: Decls, symbols: Set[Name * Int]): List[Name * Int] :=
  List(for (n, k) => _ in decls.defs if contains((n, k), symbols) or contains((n, -1), symbols) yield (n, k))

// the symbols of the statement of the lemma and of its proof, whose steps unfold the functions that they name too
function lemma_symbols(l: Lemma): Set[Name * Int] :=
  seq_symbols(l.goal) ++ match l.proof
    case Some(p) =>
      proof_symbols(p)
    case None =>
      empty()
  end

function proof_symbols(p: ProofTerm): Set[Name * Int] :=
  Set(for step in p.steps for k in step_symbols(step) yield k) ++ match p.split
    case Some(split) =>
      split_symbols(split)
    case None =>
      empty()
  end

function step_symbols(step: StepTerm): Set[Name * Int] :=
  match step
    case DefineTerm(_, value, _) =>
      symbols_in(value)

    case WitnessTerm(_, _) =>
      empty()

    case CallTerm(_, args, _, _) =>
      Set(for a in args for k in symbols_in(a) yield k)

    case AssignTerm(_, value, _) =>
      symbols_in(value)

    case AssertTerm(cond, _) =>
      symbols_in(cond)

    case UnsupportedTerm(_, _) =>
      empty()
  end

function split_symbols(split: SplitTerm): Set[Name * Int] :=
  match split
    case InductionTerm(_, cases, _) =>
      cases_symbols(cases)

    case MatchTerm(arg, cases, _) =>
      symbols_in(arg) ++ cases_symbols(cases)

    case IfTerm(cond, left, right, _) =>
      symbols_in(cond) ++ proof_symbols(left) ++ match right
        case Some(p) =>
          proof_symbols(p)
        case None =>
          empty()
      end
  end

function cases_symbols(cases: List[CaseTerm]): Set[Name * Int] :=
  Set(for c in cases for k in Set(for g in c.guard for j in symbols_in(g) yield j) ++ proof_symbols(c.proof) yield k)

function seq_symbols(s: Seq): Set[Name * Int] :=
  match s
    case Atom(term) =>
      symbols_in(term)
    case Seq(_, assms, concls) =>
      Set(for a in assms for k in seq_symbols(a) yield k) ++ Set(for c in concls for b in c.body for k in seq_symbols(b) yield k)
  end

// the lemmas in their order, where proven are the lemmas proven before, whose goals are the facts of the default proof
function proofs(decls: Decls, lemmas: List[Lemma], proven: List[Lemma]): List[Proved] :=
  match lemmas
    case List() =>
      List()

    case List(target; rest) =>
      let gaps := match target.proof
        case Some(proof) =>
          check_proof(decls, proven, target, proof)
        case None =>
          default_gaps(decls, List(for l in proven yield l.goal), target.goal)
      end in
      let proved := Proved(target.name, gaps) in
      List(
        proved; proofs(decls, rest, if is_proven(proved) then proven ++ List(target) else proven))
  end

function default_gaps(decls: Decls, facts: List[Seq], goal: Seq): List[Gap] :=
  let after := default_proof(decls, facts, goal) in
  if after == true_seq() then
    List()
  else
    List(
      Gap(Pos(0, 0), "OpenLemma", "the default proof leaves the goal open", Some(print_seq(printable(decls, for_printing(decls, goal, after))))))

function is_proven(proved: Proved): Bool :=
  proved.gaps == List()

function print_gap(gap: Gap): Str :=
  let text := value_or(gap.goal, gap.message) in
  if gap.pos == Pos(0, 0) then
    text
  else
    text ++ " at " ++ show(gap.pos.line) ++ "." ++ show(gap.pos.col)

function gap_diagnostic(name: Name, gap: Gap): Diagnostic :=
  let message := "lemma " ++ name.base ++ ": " ++ gap.message ++ match gap.goal
    case Some(goal) =>
      ", " ++ goal
    case None =>
      ""
  end in
  Diagnostic(ProofKind, gap.code, None, gap.pos, message, List(("lemma", name.base)) ++ List(for goal in gap.goal yield ("goal", goal)))

function termination_diagnostic(m: Id, site: CallSite): Diagnostic :=
  let f := first(site.caller), call_text := print_open_call(site) in
  Diagnostic(ProofKind, "OpenTermination", if f.module == Some(m) then None else f.module, Pos(0, 0), "the termination of " ++ f.base ++ " is not proven, no measure decreases " ++ call_text, List(("function", f.base), ("call", call_text)))

// the goal with the facts as assumptions, which are closed, so that they stay valid under its binders
function with_facts(goal: Seq, facts: List[Seq]): Seq :=
  match goal
    case Seq(fixed, assms, concls) =>
      Seq(fixed, facts ++ assms, concls)
    case Atom(_) =>
      Seq(List(), facts, List(Concl(List(), List(goal))))
  end

// true_seq() if the goal is proven, else the goal simplified without the facts, which would only clutter it; the facts
// are added after induction, since in the induction hypotheses they would be conditions that never hold
function default_proof(decls: Decls, facts: List[Seq], goal: Seq): Seq :=
  if is_true(decls, with_facts(goal, facts)) then
    true_seq()
  else
    match goal
      case Seq(fixed, _, _) =>
        if exists(range(0, size(fixed)), lambda p => is_true(decls, with_facts(induct(decls, goal, p), facts))) then
          true_seq()
        else
          simplify(decls, goal)

      case Atom(_) =>
        simplify(decls, goal)
    end

function is_true(decls: Decls, goal: Seq): Bool :=
  simplify(decls, goal) == true_seq()
