// the proving of lemmas in their order, each by its proof, which ulang/prove/proof.u checks, else by the default proof,
// simplification and then induction, with the terminations of the recursive functions that they reach, and the gaps
// and open terminations as errors of proofs on their commands

import ulang.syntax

export

// a lemma with the gaps that its proof leaves, none if it is proven
data Proved :=
  case Proved(name: Name, gaps: List[Gap])

// the lemmas with their goals after the proofs, and the terminations of the recursive functions that they reach
data Proofs :=
  case Proofs(lemmas: List[Proved], terminations: List[Termination])

// the targets, each on its own, by its proof, else by simplification and then induction on the first of its formals by
// which all cases close, where the lemmas before it are facts, but the falsified ones and the claims, and the recursive
// functions that they reach unfold only if their termination is proven
function prove_lemmas(decls: Decls, contracts: List[Lemma], lemmas: Lemmas): Proofs

function is_proven(proved: Proved): Bool

// an open lemma, or a recursive function that a lemma reaches whose termination is not proven
function has_errors(proofs: Proofs): Bool

// a call that no measure of the termination of its function decreases, as the call and the conditions before it
function print_open_call(site: CallSite): Str

// a gap as text, its goal if it has one, else its message, with its position if it has one
function print_gap(gap: Gap): Str

// a gap of the lemma as an error of a proof
function gap_diagnostic(name: Name, gap: Gap): Diagnostic

// a function whose termination is not proven, of module m, the main module of the run, as an error of a proof, at its
// call that no measure decreases
function termination_diagnostic(m: Path, site: CallSite): Diagnostic

// q with the errors of the proofs on their commands: the gaps of the lemmas of the module m, all or the named ones, each
// on its lemma, and the first call of a function whose termination is not proven on its definition, at its declaration,
// since the terms of the prover keep no positions
function with_proofs(q: Prog, m: Path, proofs: Proofs, names: List[Str]): Prog

// the errors of the proofs that q holds, with the module of each, None for m
function proof_diagnostics(q: Prog, m: Path): List[Diagnostic]

// a lemma that its proof leaves open, with its first gap as print_gap writes it
data OpenLemma :=
  case OpenLemma(name: Str, goal: Str)

// a recursive function whose termination is not proven, with the first call that no measure decreases
data OpenTermination :=
  case OpenTermination(name: Str, recursion: Str)

// proves the lemmas of the module m of the checked program q in their order, raising OpenTermination for the first
// function that they reach whose termination is not proven, else OpenLemma for the first lemma that is open
procedure prove_program(in q: Prog, m: Path) raises OpenLemma, OpenTermination

// the lemmas of a module for the prover: all whose statements check, in the order of the source, of which a proof cites
// any but the claims, also those after it and those that are open or falsified, since a proof looks only at the
// statements that it cites; the names of the ones to prove; those that a test falsified, which are no facts; and the
// names of the lemmas whose statements have errors, which no proof can cite
data Lemmas :=
  case Lemmas(all: List[Lemma], targets: Set[Name], falsified: Set[Name], erroneous: Set[Name])

// the program that the prover takes of a checked one, where a lemma whose errors are only in its proof has lost the
// proof, broken, which is not proven but citable and a fact, and a lemma whose statement has errors is left out,
// erroneous, which no proof can cite
data Provable :=
  case Provable(prog: Prog, erroneous: Set[Name], broken: Set[Name])

function provable(q: Prog): Provable

implementation

procedure prove_program(in q: Prog, m: Path) raises OpenLemma, OpenTermination :=
  let p := provable(q), t := translate(p.prog, m), proofs := prove_lemmas(t.decls, t.contracts, Lemmas(t.lemmas, Set(for l in t.lemmas if not contains(l.name, p.broken) yield l.name), empty(), p.erroneous))
  for tm in proofs.terminations do
    match tm.open
      case List(site; _) =>
        raise OpenTermination(first(site.caller).base, print_open_call(site))
      case List() =>
        skip
    end
  end
  for proved in proofs.lemmas do
    match proved.gaps
      case List(gap; _) =>
        raise OpenLemma(proved.name.base, print_gap(gap))
      case List() =>
        skip
    end
  end

function prove_lemmas(decls: Decls, contracts: List[Lemma], lemmas: Lemmas): Proofs :=
  let roots := Set(for l in reached_lemmas(lemmas) ++ contracts for k in defined_in(decls, lemma_symbols(l)) yield k) in
  let ts := terminations(decls, roots) in
  let proven := Set(for t in ts if is_terminating(t) for k in t.names yield k) in
  Proofs(proofs(decls with terminating := proven, contracts, lemmas), ts)

function has_errors(proofs: Proofs): Bool :=
  exists(proofs.lemmas, lambda p => not is_proven(p)) or exists(proofs.terminations, lambda t => not is_terminating(t))

function print_open_call(site: CallSite): Str :=
  let r := site.recursion in
  let names := List(for x in r.vars yield x.name.base) in
  let text := match r.args
    case Some(args) =>
      print_term(names, EApp(EFun(first(r.name)), args))
    case None =>
      first(r.name).base ++ " under a lambda, in a condition, or through a function value"
  end in
  if r.path == List() then
    text
  else
    text ++ " where " ++ join(" and ", List(for c in r.path yield print_term(names, c)))

// the definitions that the symbols name, by name and arity, where a name without arguments names all its arities
function defined_in(decls: Decls, symbols: Set[(Name, Int)]): List[(Name, Int)] :=
  List(for (n, k) => _ in decls.defs if contains((n, k), symbols) or contains((n, -1), symbols) yield (n, k))

// the symbols of the statement of the lemma and of its proof, whose steps unfold the functions that they name too
function lemma_symbols(l: Lemma): Set[(Name, Int)] :=
  Set(for t in lemma_terms(l) for k in symbols_in(t) yield k)

function default_gaps(decls: Decls, facts: List[Seq], goal: Seq): List[Gap] :=
  let after := default_proof(decls, facts, goal) in
  if after == TrueSeq() then
    List()
  else
    List(
      Gap(Pos(0, 0), "OpenLemma", "the default proof leaves the goal open", Some(print_seq(printable(decls, for_printing(decls, goal, after))))))

function is_proven(proved: Proved): Bool :=
  proved.gaps == List()

function print_gap(gap: Gap): Str :=
  let text := value_or(gap.goal, gap.message) in
  if gap.pos == Pos(0, 0) then
    text
  else
    text ++ " at " ++ show(gap.pos.line) ++ "." ++ show(gap.pos.col)

function gap_diagnostic(name: Name, gap: Gap): Diagnostic :=
  let message := "lemma " ++ name.base ++ ": " ++ gap.message ++ match gap.goal
    case Some(goal) =>
      ", " ++ goal
    case None =>
      ""
  end in
  Diagnostic(ProofKind, gap.code, None, gap.pos, message, List(("lemma", name.base)) ++ List(for goal in gap.goal yield ("goal", goal)))

function termination_diagnostic(m: Path, site: CallSite): Diagnostic :=
  let f := first(site.caller), call_text := print_open_call(site) in
  Diagnostic(ProofKind, "OpenTermination", if f.path == m then None else name_module(f), Pos(0, 0), "the termination of " ++ f.base ++ " is not proven, no measure decreases " ++ call_text, List(("function", f.base), ("call", call_text)))

function with_proofs(q: Prog, m: Path, proofs: Proofs, names: List[Str]): Prog :=
  let gaps := Map(for Proved(name, gaps) in proofs.lemmas if names == List() or contains(name.base, names) yield name => List(for gap in gaps yield gap_diagnostic(name, gap))) in
  let open := Map(for tm in proofs.terminations for site in take(1, tm.open) yield site.caller => site) in
  q with cmds := List(for cmd in q.cmds yield with_proof_errors(m, gaps, open, cmd))

function with_proof_errors(m: Path, gaps: Map[Name, List[Diagnostic]], open: Map[(Name, Int), CallSite], cmd: At[Cmd]): At[Cmd] :=
  match cmd
    case AOk(pos, span, that) =>
      let errors := proof_errors(m, gaps, open, pos, that) in
      if errors == List() then cmd else AErr(pos, span, that, errors)

    case AErr(pos, span, that, errors) =>
      AErr(pos, span, that, errors ++ proof_errors(m, gaps, open, pos, that))

    // the checked program has no commands that do not parse
    case AUnparsed(_, _, _, _) =>
      cmd
  end

function proof_errors(m: Path, gaps: Map[Name, List[Diagnostic]], open: Map[(Name, Int), CallSite], pos: Pos, cmd: Cmd): List[Diagnostic] :=
  match cmd
    case CLemma(name, _, _, _, _, _) =>
      value_or(get(name, gaps), List())

    case CFun(name, _, formals, _, _, _) =>
      List(for site in get((name, size(formals)), open) yield termination_diagnostic(m, site) with pos := pos)

    case _ =>
      List()
  end

function proof_diagnostics(q: Prog, m: Path): List[Diagnostic] :=
  List(for cmd in q.cmds if is_parsed(cmd) for d in cmd_errors(cmd) if d.kind == ProofKind yield relative_to(m, or_else(d.module, cmd_module(cmd.that)), d))

// d of module n, as an error in the module m, which has no module of its own
function relative_to(m: Path, n: Option[Path], d: Diagnostic): Diagnostic :=
  d with module := (if n == Some(m) then None else n)

// TrueSeq() if the goal is proven, else the goal simplified without the facts, which would only clutter it; the facts
// are added after induction, since in the induction hypotheses they would be conditions that never hold
function default_proof(decls: Decls, facts: List[Seq], goal: Seq): Seq :=
  if is_true(decls, with_facts(goal, facts)) then
    TrueSeq()
  else
    match goal
      case Seq(fixed, _, _) =>
        if exists(range(0, size(fixed)), lambda p => is_true(decls, with_facts(induct(decls, goal, p), facts))) then
          TrueSeq()
        else
          simplify(decls, goal)

      case Atom(_) =>
        simplify(decls, goal)
    end

function is_true(decls: Decls, goal: Seq): Bool :=
  simplify(decls, goal) == TrueSeq()

function provable(q: Prog): Provable :=
  let lemmas := List(for c in q.cmds for name in lemma_name(c.that) yield (name, c)) in
  Provable(q with cmds := List(for c in q.cmds for kept in provable_cmd(c) yield kept), Set(for (name, c) in lemmas if has_statement_errors(c) yield name), Set(for (name, c) in lemmas if cmd_errors(c) != List() and not has_statement_errors(c) yield name))

// the command, where a lemma whose errors are only in its proof has lost the proof, None for a lemma whose statement has
// errors
function provable_cmd(cmd: At[Cmd]): Option[At[Cmd]] :=
  match cmd.that
    case CLemma(name, params, ins, outs, claim, _) =>
      if cmd_errors(cmd) == List() then
        Some(cmd)
      else if has_statement_errors(cmd) then
        None
      else
        Some(AOk(cmd.pos, cmd.span, CLemma(name, params, ins, outs, claim, None)))

    case _ =>
      Some(cmd)
  end

// whether the lemma has errors outside its proof
function has_statement_errors(cmd: At[Cmd]): Bool :=
  match cmd.that
    case CLemma(_, _, _, _, _, proof) =>
      size(cmd_errors(cmd)) > size(List(for p in proof for e in errors_in_proof(p) yield e))
    case _ =>
      false
  end

function lemma_name(cmd: Cmd): Option[Name] :=
  match cmd
    case CLemma(name, _, _, _, _, _) =>
      Some(name)
    case _ =>
      None
  end

// the lemmas up to the last target that no test falsified, which the targets prove or take as facts
function reached_lemmas(lemmas: Lemmas): List[Lemma] :=
  let indexed := zip(range(0, size(lemmas.all)), lemmas.all) in
  let last := foldl(indexed, -1, lambda k, (i, l) => if contains(l.name, lemmas.targets) then i else k) in
  List(for (i, l) in indexed if i <= last and not contains(l.name, lemmas.falsified) yield l)

// the targets in their order, each on its own, since a proof looks only at the statements that it cites and at its
// facts, so that proved means proved from them, whatever their own proofs give
function proofs(decls: Decls, contracts: List[Lemma], lemmas: Lemmas): List[Proved] :=
  let indexed := zip(range(0, size(lemmas.all)), lemmas.all) in
  let statements := List(for l in lemmas.all if not l.claim yield l) in
  List(for (i, target) in indexed if contains(target.name, lemmas.targets) yield Proved(target.name, lemma_gaps(decls, contracts, Citations(statements, facts_before(lemmas, i), lemmas.erroneous), target)))

// the goals of the lemmas before the one at i, the facts of its proof: neither the claims, which hold only for the runs
// that end, so that ensures false of a loop that does not end would prove every lemma after it, nor the falsified ones,
// since a fact is used without being named, so that a false one would close every default proof after it unseen
function facts_before(lemmas: Lemmas, i: Int): List[Seq] :=
  List(for l in take(i, lemmas.all) if not l.claim and not contains(l.name, lemmas.falsified) yield l.goal)

function lemma_gaps(decls: Decls, contracts: List[Lemma], citations: Citations, target: Lemma): List[Gap] :=
  match target.proof
    case Some(proof) =>
      check_proof(decls, citations, contracts, target, proof)
    case None =>
      default_gaps(decls, citations.facts, target.goal)
  end
