// contextual simplification of sequents, see Simplification in prove.md, which is not versioned
//
// Every part of a sequent is replaced by one that is equivalent to it in its context, for all values of the
// variables bound around it. Hence simplifying never turns a provable goal into an unprovable one, and the same
// steps apply to assumptions and conclusions alike: polarity only decides what true and false mean for the
// sequent around them, which conjoin and disjoin handle, and which facts the context gains, by assume and refute.
//
// The traversal goes down the sequent and carries the context:
// - the variables of the sequents above, as de Bruijn levels, onto which a sequent opens its own binders on entry,
//   so that terms of outer sequents and the facts about them stay valid inside, and which it closes again on exit,
// - facts: the assumptions before, the conjuncts before in a conclusion, and the negated conclusions before,
//   where siblings only see those before them, since each seeing all others would simplify A and A to true and true.
//
// Ground facts are equations in an e-graph (ulang/prove/egraph.u), whose congruences are merged by the theories, where
// constructors are injective, distinct, and acyclic, and linear sums are solved for an atom, whose class then extracts
// as the sum, and inequalities over sums, decided by Fourier–Motzkin, as the CC(X) of the plan. A term is rewritten to
// the best term of its class. Facts with variables are rewrite rules.

import "ulang/syntax"

export

// nested sequents:
//   forall fixed. A1 and … and Ak ==> (exists vars1. C11 and … and C1m) or …
// where the fixed variables bind in the assumptions and conclusions, and the variables of a conclusion in its body.
// Normal forms have no connectives, quantifiers, or literals as atoms: false is Seq(Nil, Nil, Nil),
// true is Seq(Nil, Nil, [Concl(Nil, Nil)]), and not A is Seq(Nil, [A], Nil).
data Seq :=
  case Atom(term: Term)
  case Seq(fixed: List[Var], assms: List[Seq], concls: List[Concl])

data Concl :=
  case Concl(vars: List[Var], body: List[Seq])

function true_seq(): Seq

function false_seq(): Seq

function simplify(decls: Decls, s: Seq): Seq

// the cases of structural induction on the fixed variable at position p of the goal s, each with the hypotheses for
// the recursive fields of its constructor, which are the goal for them, for all values of the other fixed variables
function induction(decls: Decls, s: Seq, p: Int): Seq

function print_seq(s: Seq): Str

implementation

// a fact with variables, which rewrites instances of lhs to rhs if the instances of the conditions simplify to true
data Rule :=
  case Rule(vars: List[Var], conds: List[Seq], lhs: Term, rhs: Term)

// the limits of the simplifier, which leave a goal equivalent but not normalized where they are reached:
// - merges: the equations that one fact may solve, also of the facts that solving it solves again, in one budget for
//   the cycle of merge, equate, join, and add_ineq, so that a fact solves at most this many,
// - probe_merges: the merges of a trial merge that decides an equation, and probes: the trial merges nested,
// - splits: the internal splits nested, unfolds: the unfoldings and rewrites nested,
// - eliminations: the variables that Fourier–Motzkin eliminates, and constraints: the inequalities it works on,
// - rounds: the rounds of a saturation by the equations among the rules, and nodes: the nodes of its e-graph
data Limits :=
  case Limits(merges: Int, probe_merges: Int, probes: Int, splits: Int, unfolds: Int, eliminations: Int, constraints: Int, rounds: Int, nodes: Int)

function limits(): Limits :=
  Limits(20, 5, 2, 3, 64, 20, 60, 3, 400)

// the variables of the opened sequents, the last one first, such that level l is at depth - 1 - l, the e-graph of the
// ground equations, the inequalities t >= 0, the rules, whether the facts are inconsistent, and
// what is left of the limits: of the merges of the current fact, of internal splits, of trial merges, and the unfoldings
// and rewrites so far
data Ctx :=
  case Ctx(decls: Decls, vars: List[Var], graph: EGraph, ineqs: List[Lin], rules: List[Rule], inconsistent: Bool, merges: Int, splits: Int, unfolds: Int, probes: Int)

// a simplified conjunction with the context after it, or Refuted if a conjunct is false
data Conj :=
  case Conj(ctx: Ctx, seqs: List[Seq])
  case Refuted

// a simplified disjunction, or Proven if a disjunct is true
data Disj :=
  case Disj(concls: List[Concl])
  case Proven

data PatMatch :=
  case Matched(exprs: List[Term])
  case Failed
  case Stuck

// a split on a condition, or on the constructors of a value, which costs splits from the limit, more for one that only
// unfolding asks for
data Split :=
  case SplitIf(cond: Term)
  case SplitMatch(expr: Term, datatype: Name, cost: Int)

function true_seq(): Seq :=
  Seq(List(), List(), List(Concl(List(), List())))

function false_seq(): Seq :=
  Seq(List(), List(), List())

function new_ctx(decls: Decls): Ctx :=
  let l := limits() in
  Ctx(decls, List(), empty_graph(), List(), List(), false, l.merges, l.splits, 0, l.probes)

// the context with a new budget of merges, for a fact or a term that the simplification of a sequent adds, not one
// that solving adds
function refuel(ctx: Ctx): Ctx :=
  ctx with merges := limits().merges

function depth(ctx: Ctx): Int :=
  size(ctx.vars)

function enter(ctx: Ctx, xs: List[Var]): Ctx :=
  ctx with vars := reverse(xs) ++ ctx.vars

// the variables of the levels from d on
function vars_from(ctx: Ctx, d: Int): List[Var] :=
  reverse(take(depth(ctx) - d, ctx.vars))

function contradiction(ctx: Ctx): Ctx :=
  ctx with inconsistent := true

function simplify(decls: Decls, s: Seq): Seq :=
  simp_seq(new_ctx(decls), s)

function rebind_seq(op: Rebind, c: Int, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      Atom(rebind(op, c, expr))

    case Seq(fixed, assms, concls) =>
      let inner := c + size(fixed) in
      Seq(fixed, List(for a in assms yield rebind_seq(op, inner, a)), List(for d in concls yield rebind_concl(op, inner, d)))
  end

function rebind_concl(op: Rebind, c: Int, d: Concl): Concl :=
  match d
    case Concl(vars, body) =>
      Concl(vars, List(for s in body yield rebind_seq(op, c + size(vars), s)))
  end

function replace_seq(a: Term, b: Term, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      Atom(replace(a, b, expr))
    case Seq(fixed, assms, concls) =>
      Seq(fixed, List(for x in assms yield replace_seq(a, b, x)), List(for d in concls yield replace_concl(a, b, d)))
  end

function replace_concl(a: Term, b: Term, d: Concl): Concl :=
  match d
    case Concl(vars, body) =>
      Concl(vars, List(for s in body yield replace_seq(a, b, s)))
  end

function subst_seq(c: Int, t: Term, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      Atom(subst(c, t, expr))

    case Seq(fixed, assms, concls) =>
      let inner := c + size(fixed) in
      Seq(fixed, List(for a in assms yield subst_seq(inner, t, a)), List(for d in concls yield subst_concl(inner, t, d)))
  end

function subst_concl(c: Int, t: Term, d: Concl): Concl :=
  match d
    case Concl(vars, body) =>
      Concl(vars, List(for s in body yield subst_seq(c + size(vars), t, s)))
  end

function beta_seq(args: List[Term], s: Seq): Seq :=
  match reverse(args)
    case List() =>
      s
    case List(a; rest) =>
      beta_seq(reverse(rest), subst_seq(0, shift(size(rest), a), s))
  end

function loose_seq(c: Int, s: Seq): List[Int] :=
  match s
    case Atom(expr) =>
      loose(c, expr)

    case Seq(fixed, assms, concls) =>
      let inner := c + size(fixed) in
      List(for a in assms for i in loose_seq(inner, a) yield i) ++ List(for d in concls for i in loose_concl(inner, d) yield i)
  end

function loose_concl(c: Int, d: Concl): List[Int] :=
  match d
    case Concl(vars, body) =>
      List(for s in body for i in loose_seq(c + size(vars), s) yield i)
  end

function to_seq(e: Term): Seq :=
  match e
    case ELit(LBool(true)) =>
      true_seq()

    case ELit(LBool(false)) =>
      false_seq()

    case Not(a) =>
      Seq(List(), List(to_seq(a)), List())

    case And(a, b) =>
      Seq(List(), List(), List(Concl(List(), List(to_seq(a), to_seq(b)))))

    case Or(a, b) =>
      Seq(List(), List(), List(Concl(List(), List(to_seq(a))), Concl(List(), List(to_seq(b)))))

    case Implies(a, b) =>
      Seq(List(), List(to_seq(a)), List(Concl(List(), List(to_seq(b)))))

    case Forall(formals, body) =>
      Seq(formals, List(), List(Concl(List(), List(to_seq(body)))))

    case Exists(formals, body) =>
      Seq(List(), List(), List(Concl(formals, List(to_seq(body)))))

    case EIte(cond, then_expr, else_expr) =>
      let t := to_seq(cond) in
      Seq(List(), List(), List(
        Concl(List(), List(
          Seq(List(), List(t), List(Concl(List(), List(to_seq(then_expr))))),
          Seq(List(), List(Seq(List(), List(t), List())), List(Concl(List(), List(to_seq(else_expr)))))))))

    case _ =>
      Atom(e)
  end

// a sequent equivalent to s in the context, where s has no free indices
function simp_seq(ctx: Ctx, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      let t := simp_term(refuel(ctx), expr) in
      let n := to_seq(t) in
      match n
        case Atom(_) =>
          n
        case _ =>
          simp_seq(ctx, n)
      end

    case Seq(fixed, assms, concls) =>
      simp_sequent(ctx, fixed, assms, concls)
  end

// its binders are opened, its assumptions simplified as a conjunction, which may add binders, its conclusions in the
// context of all assumptions, and the result closed again, or else split on a condition if all cases are closed
function simp_sequent(ctx: Ctx, xs: List[Var], assms: List[Seq], concls: List[Concl]): Seq :=
  let d := depth(ctx), k := size(xs) in
  let cs := List(for c in concls yield rebind_concl(Open(d, k), 0, c)) in
  match conjoin(enter(ctx, xs), List(for a in assms yield rebind_seq(Open(d, k), 0, a)))
    case Refuted =>
      true_seq()

    case Conj(after, seqs) =>
      match one_point(d, seqs)
        case Some((l, t, rest)) =>
          let levels := List(for m in range(d, depth(after)) if m != l) in
          simp_seq(ctx, Seq(List(for m in levels yield at(m - d, from_list(vars_from(after, d)))), List(for b in rest yield rebind_seq(Close(levels), 0, replace_seq(ELevel(l), t, b))), List(for c in cs yield rebind_concl(Close(levels), 0, replace_concl(ELevel(l), t, c)))))

        case None =>
          match disjoin(after, cs)
            case Proven =>
              true_seq()

            case Disj(goals) =>
              let levels := range(d, depth(after)), ys := vars_from(after, d) in
              let closed := List(for b in seqs yield rebind_seq(Close(levels), 0, b)), ends := List(for c in goals yield rebind_concl(Close(levels), 0, c)) in
              let result := sequent(ys, closed, ends) in
              split_on(ctx, levels, ys, closed, ends, split_candidate(ctx.decls, seqs, goals), result)
          end
      end
  end

// a sequent that only wraps a single conjunct is that conjunct, not not A is A, and a single conclusion that is a sequent without
// existential variables is merged, since A ==> (forall y. B ==> C) is forall y. A and B ==> C
function sequent(xs: List[Var], assms: List[Seq], concls: List[Concl]): Seq :=
  match (xs, assms, concls)
    case (List(), List(), List(Concl(List(), List(s)))) =>
      s

    case (List(), List(Seq(List(), List(s), List())), List()) =>
      s

    case (_, _, List(Concl(List(), List(Seq(fixed, bs, cs))))) =>
      Seq(xs ++ fixed, List(for a in assms yield rebind_seq(Shift(size(fixed)), 0, a)) ++ bs, cs)

    case _ =>
      Seq(xs, assms, concls)
  end

// an equation of a variable of the levels from d on with a term without it, by which it is eliminated
function one_point(d: Int, ss: List[Seq]): Option[Int * Term * List[Seq]] :=
  match ss
    case List() =>
      None

    case List(s; rest) =>
      match equation_of(d, s)
        case Some((l, t)) =>
          Some((l, t, rest))

        case None =>
          match one_point(d, rest)
            case Some((l, t, more)) =>
              Some((l, t, List(s; more)))
            case None =>
              None
          end
      end
  end

function equation_of(d: Int, s: Seq): Option[Int * Term] :=
  match s
    case Atom(Eq(ELevel(level), t)) if level >= d and not occurs(ELevel(level), t) =>
      Some((level, t))

    case Atom(Eq(t, ELevel(level))) if level >= d and not occurs(ELevel(level), t) =>
      Some((level, t))

    case _ =>
      None
  end

// each conjunct in the context of those before it, since A and B is A and (A ==> B), where true conjuncts are dropped,
// for assumptions and the bodies of conclusions alike, and conjunctions and existentials among them are spliced in,
// whose variables become levels after those of the context
function conjoin(ctx: Ctx, ss: List[Seq]): Conj :=
  match ss
    case List() =>
      Conj(ctx, List())

    case List(s; rest) =>
      let t := simp_seq(ctx, s) in
      match t
        case Seq(List(), List(), List(Concl(List(), List()))) =>
          conjoin(ctx, rest)

        case Seq(List(), List(), List()) =>
          Refuted

        case Seq(List(), List(), List(Concl(vars, body))) =>
          let d := depth(ctx) in
          conjoin(enter(ctx, vars), List(for b in body yield rebind_seq(Open(d, size(vars)), 0, b)) ++ rest)

        case _ =>
          let next := assume(ctx, t) in
          if next.inconsistent then
            Refuted
          else
            match conjoin(next, rest)
              case Conj(c, seqs) =>
                Conj(c, List(t; seqs))
              case Refuted =>
                Refuted
            end
      end
  end

// each disjunct in the context of the negations of those before it, where false disjuncts are dropped
function disjoin(ctx: Ctx, cs: List[Concl]): Disj :=
  match cs
    case List() =>
      Disj(List())

    case List(c; rest) =>
      match simp_concl(ctx, c)
        case None =>
          disjoin(ctx, rest)

        case Some(Concl(_, List())) =>
          Proven

        case Some(Concl(List(), List(Seq(List(), List(), concls)))) =>
          disjoin(ctx, concls ++ rest)

        case Some(d) =>
          let next := refute(ctx, d) in
          if next.inconsistent then
            Proven
          else
            match disjoin(next, rest)
              case Disj(concls) =>
                Disj(List(d; concls))
              case Proven =>
                Proven
            end
      end
  end

// the conclusion, or None if it is false, whose existential variables are opened like fixed ones, which is sound
// since simplification is an equivalence for all their values, but they are never instantiated here, except by
// the one-point rule
function simp_concl(ctx: Ctx, c: Concl): Option[Concl] :=
  match c
    case Concl(vars, body) =>
      let d := depth(ctx), k := size(vars) in
      match conjoin(enter(ctx, vars), List(for s in body yield rebind_seq(Open(d, k), 0, s)))
        case Refuted =>
          None

        case Conj(after, seqs) =>
          match one_point(d, seqs)
            case Some((l, t, rest)) =>
              let levels := List(for m in range(d, depth(after)) if m != l) in
              simp_concl(ctx, Concl(List(for m in levels yield at(m - d, from_list(vars_from(after, d)))), List(for s in rest yield rebind_seq(Close(levels), 0, replace_seq(ELevel(l), t, s)))))

            case None =>
              let levels := range(d, depth(after)) in
              Some(Concl(vars_from(after, d), List(for t in seqs yield rebind_seq(Close(levels), 0, t))))
          end
      end
  end

// the context with s known to be true: atoms and their negations are facts, and sequents with a single atomic
// conclusion rules, while other ground sequents, which would be clauses, are not used yet
function assume(ctx: Ctx, s: Seq): Ctx :=
  match s
    case Atom(expr) =>
      assume_term(refuel(ctx), expr, true)

    case Seq(List(), List(Atom(expr)), List()) =>
      assume_term(refuel(ctx), expr, false)

    case Seq(fixed, assms, List(Concl(List(), List(Atom(expr))))) =>
      add_rule(ctx, fixed, assms, expr, true)

    case Seq(fixed, assms, List(Concl(List(), List(Seq(List(), List(Atom(expr)), List()))))) =>
      add_rule(ctx, fixed, assms, expr, false)

    // forall xs. A1 and … and Ak ==> false, as the rule Ak == false under the others
    case Seq(fixed, List(a; more), List()) =>
      match reverse(List(a; more))
        case List(Atom(expr); conds) =>
          add_rule(ctx, fixed, reverse(conds), expr, false)
        case _ =>
          ctx
      end

    case _ =>
      ctx
  end

// the context with c known to be false, for the conclusions after it, since A ==> C1 or C2 is A and not C1 ==> C2,
// where the negation of an existential is a rule
function refute(ctx: Ctx, c: Concl): Ctx :=
  match c
    case Concl(List(), List(Atom(expr))) =>
      assume_term(refuel(ctx), expr, false)

    case Concl(List(), List(Seq(List(), List(Atom(expr)), List()))) =>
      assume_term(refuel(ctx), expr, true)

    case Concl(vars, List(Atom(expr))) =>
      add_rule(ctx, vars, List(), expr, false)

    case _ =>
      ctx
  end

function add_rule(ctx: Ctx, xs: List[Var], conds: List[Seq], e: Term, b: Bool): Ctx :=
  let rule := match e
    case Eq(l, r) if b =>
      if is_greater(ctx.decls, l, r) then
        Rule(xs, conds, l, r)
      else if is_greater(ctx.decls, r, l) then
        Rule(xs, conds, r, l)
      else
        Rule(xs, conds, e, bool_term(true))

    case _ =>
      Rule(xs, conds, e, bool_term(b))
  end in
  if is_valid_rule(rule) then ctx with rules := List(rule; ctx.rules) else ctx

// the variables of the right side and of the conditions occur in the left side, which is not a variable
function is_valid_rule(r: Rule): Bool :=
  match r.lhs
    case EBound(_) =>
      false

    case ELit(_) =>
      false

    case _ =>
      let bound := loose(0, r.lhs) in
      forall(loose(0, r.rhs) ++ List(for c in r.conds for k in loose_seq(0, c) yield k), lambda i => contains(i, bound))
  end

function assume_term(ctx: Ctx, e: Term, b: Bool): Ctx :=
  if ctx.inconsistent then
    ctx
  else
    match e
      case ELit(LBool(bool)) =>
        if bool == b then ctx else contradiction(ctx)

      case Not(a) =>
        assume_term(ctx, a, not b)

      case And(x, y) if b =>
        assume_term(assume_term(ctx, x, true), y, true)

      case Or(x, y) if not b =>
        assume_term(assume_term(ctx, x, false), y, false)

      case Eq(x, y) if b =>
        merge(ctx, x, y)

      case Less(x, y) =>
        if b then
          add_ineq(ctx, lin_add(lin_sub(lin_of(y), lin_of(x)), Lin(-1, List())))
        else
          add_ineq(ctx, lin_sub(lin_of(x), lin_of(y)))

      case _ =>
        merge(ctx, e, bool_term(b))
    end

function is_value(decls: Decls, e: Term): Bool :=
  match e
    case ELit(_) =>
      true
    case _ =>
      free_head(decls, e) != None
  end

function is_sum(e: Term): Bool :=
  match e
    case ESum(_, _) =>
      true
    case _ =>
      false
  end

// whether a occurs in v below constructors only, such that a == v has no solution
function occurs_constr(decls: Decls, a: Term, v: Term): Bool :=
  if a == v then
    true
  else
    match free_head(decls, v)
      case Some((_, args)) =>
        exists(args, lambda x => occurs_constr(decls, a, x))
      case None =>
        false
    end

// the context with a == b for canonical a and b, solved by the theories into equations of atoms with their values
function merge(ctx: Ctx, a: Term, b: Term): Ctx :=
  if ctx.merges <= 0 or ctx.inconsistent or a == b then
    ctx
  else if is_sum(a) or is_sum(b) then
    merge_lin(ctx, lin_sub(lin_of(a), lin_of(b)))
  else
    match (free_head(ctx.decls, a), free_head(ctx.decls, b))
      case (Some((f, xs)), Some((g, ys))) =>
        if f == g and size(xs) == size(ys) then
          merge_all(ctx, xs, ys)
        else
          contradiction(ctx)

      case _ =>
        if is_value(ctx.decls, a) and is_value(ctx.decls, b) then
          contradiction(ctx)
        else if is_value(ctx.decls, b) then
          if occurs_constr(ctx.decls, a, b) then
            contradiction(ctx)
          else
            equate(ctx, a, b)
        else if is_value(ctx.decls, a) then
          if occurs_constr(ctx.decls, b, a) then
            contradiction(ctx)
          else
            equate(ctx, b, a)
        else if is_greater(ctx.decls, a, b) then
          equate(ctx, a, b)
        else if is_greater(ctx.decls, b, a) then
          equate(ctx, b, a)
        else if compare(a, b) > 0 then
          equate(ctx, a, b)
        else
          equate(ctx, b, a)
    end

function merge_all(ctx: Ctx, xs: List[Term], ys: List[Term]): Ctx :=
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) =>
      merge_all(merge(ctx, simp_term(ctx, x), simp_term(ctx, y)), xs_, ys_)
    case _ =>
      ctx
  end

// the context with d == 0, solved for its greatest atom with a coefficient 1 or -1, or else kept as the equation
// of its atoms, divided by their greatest common divisor, with the constant
function merge_lin(ctx: Ctx, d: Lin): Ctx :=
  match d
    case Lin(k, List()) =>
      if k == 0 then ctx else contradiction(ctx)

    case Lin(k, summands) =>
      match greatest_unit(ctx.decls, summands, None)
        case Some(unit) =>
          let rest := lin_sub(d, Lin(0, List(unit))) in
          equate(ctx, unit.term, sum_term(if unit.factor == 1 then lin_scale(-1, rest) else rest))

        case None =>
          let g := gcd_all(summands) in
          if k % g != 0 then
            contradiction(ctx)
          else
            equate(ctx, sum_term(Lin(0, divided(summands, g))), int_term(0 - k / g))
      end
  end

function greatest_unit(decls: Decls, summands: List[Summand], best: Option[Summand]): Option[Summand] :=
  match summands
    case List() =>
      best

    case List(summand; rest) =>
      if summand.factor != 1 and summand.factor != -1 then
        greatest_unit(decls, rest, best)
      else
        match best
          case Some(other) if not is_greater(decls, summand.term, other.term) =>
            greatest_unit(decls, rest, best)
          case _ =>
            greatest_unit(decls, rest, Some(summand))
        end
  end

function gcd_all(summands: List[Summand]): Int :=
  match summands
    case List() =>
      0
    case List(summand; rest) =>
      gcd(summand.factor, gcd_all(rest))
  end

// the summands with their factors divided by g, which divides them all
function divided(summands: List[Summand], g: Int): List[Summand] :=
  List(for summand in summands yield summand with factor := summand.factor / g)

// the context with l == r in the e-graph, where the inequalities are solved again after the classes that it merges
function equate(ctx: Ctx, l: Term, r: Term): Ctx :=
  let (g, i) := add_term(ctx.graph, l) in
  let (h, j) := add_term(g, r) in
  readd_ineqs(join(ctx with graph := h, ineqs := List(), i, j), ctx.ineqs)

// the context with the classes i and j merged, where the classes that congruence makes equal are merged by the theories,
// and the parents of the merged classes are simplified again, so that a value of a class reaches the terms above it
function join(ctx: Ctx, i: Int, j: Int): Ctx :=
  if ctx.merges <= 0 or ctx.inconsistent or class_of(ctx.graph, i) == class_of(ctx.graph, j) then
    ctx
  else
    let u := unite(ctx.graph, i, j) in
    resimplify(congruent(ctx with graph := u.graph, merges := ctx.merges - 1, u.pending), u.parents)

function congruent(ctx: Ctx, pairs: List[Int * Int]): Ctx :=
  match pairs
    case List() =>
      ctx
    case List((p, q); rest) =>
      congruent(merge_classes(ctx, p, q), rest)
  end

// the classes merged, and their terms by the theories, which take the terms from before
function merge_classes(ctx: Ctx, p: Int, q: Int): Ctx :=
  let a := extract(ctx, p), b := extract(ctx, q) in
  merge(join(ctx, p, q), a, b)

function resimplify(ctx: Ctx, parents: List[ENode * Int]): Ctx :=
  match parents
    case List() =>
      ctx

    case List((node, i); rest) =>
      if ctx.inconsistent then
        ctx
      else
        let t := node_term(node, List(for a in node.args yield extract(ctx, a))) in
        let u := simp_term(ctx, t) in
        if u == t then
          resimplify(ctx, rest)
        else
          let (g, k) := add_term(ctx.graph, u) in
          let a := extract(ctx, i) in
          resimplify(merge(join(ctx with graph := g, i, k), a, u), rest)
  end

// the best term of the class of i: a literal, else a value, else a sum, the solved form of an atom, else the least in
// the term order; a class always has a node whose arguments are in other classes, its oldest node, so this is total
function extract(ctx: Ctx, i: Int): Term :=
  match extract_in(ctx.decls, ctx.graph, class_of(ctx.graph, i), List())
    case Some(t) =>
      t
    case None =>
      ELevel(i)
  end

// the best term of the class c, from the nodes without arguments in the classes of the stack, which are being extracted
function extract_in(decls: Decls, g: EGraph, c: Int, stack: List[Int]): Option[Term] :=
  let inner := List(c; stack) in
  let terms := List(for node in class_nodes(g, c) if not exists(node.args, lambda a => contains(a, inner)) for t in node_extract(decls, g, node, inner) yield t) in
  best_term(decls, terms, None)

function node_extract(decls: Decls, g: EGraph, node: ENode, stack: List[Int]): Option[Term] :=
  match extract_all(decls, g, node.args, stack, List())
    case Some(args) =>
      Some(node_term(node, args))
    case None =>
      None
  end

function extract_all(decls: Decls, g: EGraph, cs: List[Int], stack: List[Int], acc: List[Term]): Option[List[Term]] :=
  match cs
    case List() =>
      Some(reverse(acc))

    case List(c; rest) =>
      match extract_in(decls, g, c, stack)
        case Some(t) =>
          extract_all(decls, g, rest, stack, List(t; acc))
        case None =>
          None
      end
  end

function best_term(decls: Decls, ts: List[Term], best: Option[Term]): Option[Term] :=
  match (ts, best)
    case (List(), _) =>
      best

    case (List(t; rest), Some(u)) =>
      best_term(decls, rest, if is_better(decls, t, u) then Some(t) else best)

    case (List(t; rest), None) =>
      best_term(decls, rest, Some(t))
  end

function is_better(decls: Decls, t: Term, u: Term): Bool :=
  let r := term_rank(decls, t), s := term_rank(decls, u) in
  r < s or r == s and (is_greater(decls, u, t) or not is_greater(decls, t, u) and compare(t, u) < 0)

function term_rank(decls: Decls, t: Term): Int :=
  match t
    case ELit(_) =>
      0

    case ESum(_, _) =>
      2

    case _ =>
      if free_head(decls, t) != None then 1 else 3
  end

function readd_ineqs(ctx: Ctx, ls: List[Lin]): Ctx :=
  match ls
    case List() =>
      ctx
    case List(l; rest) =>
      readd_ineqs(add_ineq(ctx, lin_of(simp_term(ctx, sum_term(l)))), rest)
  end

function floor_div(a: Int, b: Int): Int :=
  if a >= 0 then a / b else 0 - (0 - a + b - 1) / b

function tighten(t: Lin): Lin :=
  let g := gcd_all(t.summands) in
  if g <= 1 then t else Lin(floor_div(t.k, g), divided(t.summands, g))

// t < 0, that is -t - 1 >= 0
function negated(t: Lin): Lin :=
  lin_add(lin_scale(-1, t), Lin(-1, List()))

function coefficient(x: Term, t: Lin): Int :=
  match List(for summand in t.summands if summand.term == x yield summand.factor)
    case List(n; _) =>
      n
    case List() =>
      0
  end

// whether the inequalities have no integer solution, by Fourier–Motzkin with tightening, which may miss some
function is_unsat(cs: List[Lin], fuel: Int): Bool :=
  if exists(cs, lambda c => c.summands == List() and c.k < 0) then
    true
  else
    match List(for c in cs if c.summands != List())
      case List() =>
        false

      case List(c; more) =>
        if fuel <= 0 or size(more) > limits().constraints then
          false
        else
          let rest := List(c; more), x := at(0, from_list(c.summands)).term in
          let pos := List(for t in rest if coefficient(x, t) > 0), neg := List(for t in rest if coefficient(x, t) < 0) in
          let none := List(for t in rest if coefficient(x, t) == 0) in
          is_unsat(none ++ List(for p in pos for n in neg yield combine(x, p, n)), fuel - 1)
    end

function combine(x: Term, p: Lin, n: Lin): Lin :=
  tighten(lin_add(lin_scale(0 - coefficient(x, n), p), lin_scale(coefficient(x, p), n)))

function is_entailed(ctx: Ctx, t: Lin): Bool :=
  ctx.inconsistent or is_unsat(List(tighten(negated(t)); ctx.ineqs ++ bounds(ctx, t)), limits().eliminations)

// the instances of rules p < q without conditions, for the atoms of t and of the inequalities, with a single atom
// p - q that binds all variables of the rule
function bounds(ctx: Ctx, t: Lin): List[Lin] :=
  let atoms := List(for summand in t.summands yield summand.term) ++ List(for l in ctx.ineqs for summand in l.summands yield summand.term) in
  List(for a in atoms for r in ctx.rules for b in bound_of(r, a) yield b)

function bound_of(r: Rule, a: Term): List[Lin] :=
  match (r.conds, r.lhs, r.rhs)
    case (List(), Less(p, q), ELit(LBool(bool))) =>
      match lin_sub(lin_of(p), lin_of(q))
        case Lin(_, List(Summand(atom, _))) =>
          match match_term(size(r.vars), atom, a, empty())
            case Some(sub) =>
              let n := size(r.vars) in
              let args := List(for i in range(0, n) yield lookup_index(n - 1 - i, sub)) in
              let d := lin_sub(lin_of(beta(args, q)), lin_of(beta(args, p))) in
              if bool then
                List(lin_add(d, Lin(-1, List())))
              else
                List(lin_scale(-1, d))

            case None =>
              List()
          end

        case _ =>
          List()
      end

    case _ =>
      List()
  end

function add_ineq(ctx: Ctx, d: Lin): Ctx :=
  if ctx.inconsistent then
    ctx
  else
    let t := tighten(d) in
    match t
      case Lin(k, List()) =>
        if k >= 0 then ctx else contradiction(ctx)

      case _ =>
        if is_entailed(ctx, t) then
          ctx
        else if is_unsat(List(t; ctx.ineqs), limits().eliminations) then
          contradiction(ctx)
        else
          let next := ctx with ineqs := List(t; ctx.ineqs) in
          if is_entailed(next, lin_scale(-1, t)) then
            merge_lin(next, t)
          else
            next
    end

// a term equal to e in the context, in normal form: the subterms are simplified here, the branches of an if under its
// condition and its negation, and a function for each kind of term combines the results, where binders are left alone
function simp_term(ctx: Ctx, e: Term): Term :=
  match e
    case EApp(fun, args) =>
      let g := simp_term(ctx, fun), bs := List(for a in args yield simp_term(ctx, a)) in
      simp_app(ctx, g, bs)

    case EIte(cond, then_expr, else_expr) =>
      let t := simp_term(ctx, cond) in
      match t
        case ELit(LBool(true)) =>
          simp_term(ctx, then_expr)

        case ELit(LBool(false)) =>
          simp_term(ctx, else_expr)

        case _ =>
          let u := simp_term(assume_term(ctx, t, true), then_expr), v := simp_term(assume_term(ctx, t, false), else_expr) in
          simp_ite(t, u, v)
      end

    case EMatch(expr, cases) =>
      let t := simp_term(ctx, expr) in
      match select(ctx, t, cases)
        case Some(b) =>
          simp_term(ctx, b)
        case None =>
          EMatch(t, cases)
      end

    case ESum(constant, summands) =>
      rewrite(ctx, sum_term(simp_summands(ctx, summands, Lin(constant, List()))))

    case EFun(name) =>
      match get((name, 0), ctx.decls.defs)
        case Some(d) =>
          unfold(ctx, e, d, List())
        case None =>
          rewrite(ctx, e)
      end

    case ELevel(_) =>
      rewrite(ctx, e)

    case _ =>
      e
  end

function simp_summands(ctx: Ctx, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      simp_summands(ctx, rest, lin_add(acc, lin_scale(summand.factor, lin_of(simp_term(ctx, summand.term)))))
  end

function simp_ite(c: Term, a: Term, b: Term): Term :=
  if a == b then
    a
  else
    match (a, b)
      case (ELit(LBool(true)), ELit(LBool(false))) =>
        c

      case (ELit(LBool(false)), ELit(LBool(true))) =>
        Not(c)

      case _ =>
        EIte(c, a, b)
    end

function simp_app(ctx: Ctx, f: Term, args: List[Term]): Term :=
  match f
    case ELam(formals, body) if size(formals) == size(args) =>
      simp_term(ctx, beta(args, body))

    case EFun(name) =>
      match simp_builtin(ctx, EApp(f, args))
        case Some(t) =>
          t

        case None =>
          match get((name, size(args)), ctx.decls.defs)
            case Some(d) =>
              unfold(ctx, EApp(f, args), d, args)
            case None =>
              rewrite(ctx, EApp(f, args))
          end
      end

    case _ =>
      rewrite(ctx, EApp(f, args))
  end

// e simplified if it is an application of a builtin, whose arguments are simplified, which takes precedence over a
// definition of the same name, as of not and ==> in the prelude
function simp_builtin(ctx: Ctx, e: Term): Option[Term] :=
  match e
    case Plus(a, b) =>
      Some(rewrite(ctx, sum_term(lin_add(lin_of(a), lin_of(b)))))

    case Minus(a, b) =>
      Some(rewrite(ctx, sum_term(lin_sub(lin_of(a), lin_of(b)))))

    case Times(ELit(LInt(num)), b) =>
      Some(rewrite(ctx, sum_term(lin_scale(num, lin_of(b)))))

    case Times(a, ELit(LInt(num))) =>
      Some(rewrite(ctx, sum_term(lin_scale(num, lin_of(a)))))

    case Times(a, b) =>
      match ordered(a, b)
        case (x, y) =>
          Some(rewrite(ctx, Times(x, y)))
      end

    case Div(ELit(LInt(m)), ELit(LInt(n))) if n != 0 =>
      Some(int_term(m / n))

    case Div(_, _) =>
      Some(rewrite(ctx, e))

    case Mod(ELit(LInt(m)), ELit(LInt(n))) if n != 0 =>
      Some(int_term(m % n))

    case Mod(_, _) =>
      Some(rewrite(ctx, e))

    case Eq(a, b) =>
      Some(simp_eq(ctx, a, b))

    case Less(a, b) =>
      Some(simp_less(ctx, a, b))

    case Compare(a, b) =>
      Some(simp_compare(ctx, a, b))

    case Not(a) =>
      Some(simp_not(ctx, a))

    case And(a, b) =>
      if a == bool_term(false) or b == bool_term(false) then
        Some(bool_term(false))
      else if a == bool_term(true) or a == b then
        Some(b)
      else if b == bool_term(true) then
        Some(a)
      else
        Some(rewrite(ctx, e))

    case Or(a, b) =>
      if a == bool_term(true) or b == bool_term(true) then
        Some(bool_term(true))
      else if a == bool_term(false) or a == b then
        Some(b)
      else if b == bool_term(false) then
        Some(a)
      else
        Some(rewrite(ctx, e))

    case Implies(a, b) =>
      if a == bool_term(false) or b == bool_term(true) or a == b then
        Some(bool_term(true))
      else if a == bool_term(true) then
        Some(b)
      else if b == bool_term(false) then
        Some(simp_not(ctx, a))
      else
        Some(rewrite(ctx, e))

    case _ =>
      None
  end

function simp_not(ctx: Ctx, a: Term): Term :=
  match a
    case ELit(LBool(bool)) =>
      bool_term(not bool)

    case Not(b) =>
      b

    case _ =>
      rewrite(ctx, Not(a))
  end

// the sides of an equation, the greater in the term order first
function oriented(decls: Decls, a: Term, b: Term): Term * Term :=
  if is_greater(decls, b, a) then
    (b, a)
  else if is_greater(decls, a, b) then
    (a, b)
  else
    ordered(a, b)

function ordered(a: Term, b: Term): Term * Term :=
  if compare(a, b) > 0 then (b, a) else (a, b)

// true if equal in normal form, false if assuming it is inconsistent, as for distinct constructors
function simp_eq(ctx: Ctx, a: Term, b: Term): Term :=
  if a == b then
    bool_term(true)
  else if ctx.probes > 0 and merge(ctx with probes := ctx.probes - 1, merges := (if ctx.merges < limits().probe_merges then
    ctx.merges
  else
    limits().probe_merges), a, b).inconsistent then
    bool_term(false)
  else if is_equal_by_rules(ctx, a, b) then
    bool_term(true)
  else
    match oriented(ctx.decls, a, b)
      case (x, y) =>
        rewrite(ctx, Eq(x, y))
    end

// an equation between patterns over the variables below vars, used from left to right
data Equation :=
  case Equation(vars: Int, lhs: Term, rhs: Term)

// whether a == b follows from the equations among the rules, by saturating a copy of the e-graph with their instances,
// in rounds that first match all and then add all, within the limits, so that the order of the rules does not matter;
// rules with conditions take no part, and neither do the theories, which only the e-graph of the context has
function is_equal_by_rules(ctx: Ctx, a: Term, b: Term): Bool :=
  match equations(ctx.rules)
    case List() =>
      false

    case eqs =>
      let (g, i) := add_term(ctx.graph, a) in
      let (h, j) := add_term(g, b) in
      is_saturated_equal(h, eqs, i, j, limits().rounds)
  end

function is_saturated_equal(g: EGraph, eqs: List[Equation], i: Int, j: Int, rounds: Int): Bool :=
  if class_of(g, i) == class_of(g, j) then
    true
  else if rounds <= 0 or node_count(g) > limits().nodes then
    false
  else
    let next := apply_matches(g, matches(g, eqs)) in
    if node_count(next) == node_count(g) and size(class_ids(next)) == size(class_ids(g)) then
      false
    else
      is_saturated_equal(next, eqs, i, j, rounds - 1)

// the instances of the equations in the e-graph: the class of an instance of the left side and the substitution
function matches(g: EGraph, eqs: List[Equation]): List[Int * Equation * Map[Int, Int]] :=
  List(for e in eqs for c in class_ids(g) for sub in ematch(g, e.vars, e.lhs, c, empty()) yield (c, e, sub))

function apply_matches(g: EGraph, ms: List[Int * Equation * Map[Int, Int]]): EGraph :=
  match ms
    case List() =>
      g

    case List((c, e, sub); rest) =>
      if node_count(g) > limits().nodes then
        g
      else
        let (h, k) := add_instance(g, e.vars, e.rhs, sub) in
        apply_matches(close_union(h, c, k), rest)
  end

// the unconditional rules as equations: an oriented rule from left to right, and an equation that does not orient in
// both directions where the variables allow, while rules of atoms that are true or false are none
function equations(rules: List[Rule]): List[Equation] :=
  List(for r in rules if r.conds == List() for e in rule_equations(r) yield e)

function rule_equations(r: Rule): List[Equation] :=
  let n := size(r.vars) in
  match (r.lhs, r.rhs)
    case (Eq(l, q), ELit(LBool(true))) =>
      List(for (x, y) in List((l, q), (q, l)) if is_pattern_of(x, y) yield Equation(n, x, y))

    case (_, ELit(LBool(_))) =>
      List()

    case (l, q) =>
      List(Equation(n, l, q))
  end

// whether lhs is a pattern that is not a variable and binds the variables of rhs
function is_pattern_of(lhs: Term, rhs: Term): Bool :=
  match lhs
    case EBound(_) =>
      false

    case _ =>
      let bound := loose(0, lhs) in
      forall(loose(0, rhs), lambda i => contains(i, bound))
  end

function simp_less(ctx: Ctx, a: Term, b: Term): Term :=
  let d := lin_sub(lin_of(b), lin_of(a)) in
  match (d, value_order(ctx.decls, a, b))
    case (Lin(k, List()), _) =>
      bool_term(k >= 1)

    case (_, Some(c)) =>
      bool_term(c < 0)

    case _ =>
      if is_entailed(ctx, lin_add(d, Lin(-1, List()))) then
        bool_term(true)
      else if is_entailed(ctx, lin_scale(-1, d)) then
        bool_term(false)
      else
        rewrite(ctx, Less(a, b))
  end

// -1, 0, or 1 where the order of the values or the context decides it, consistent with simp_less and simp_eq
function simp_compare(ctx: Ctx, a: Term, b: Term): Term :=
  match value_order(ctx.decls, a, b)
    case Some(c) =>
      int_term(c)

    case None =>
      match (simp_less(ctx, a, b), simp_less(ctx, b, a))
        case (ELit(LBool(true)), _) =>
          int_term(-1)

        case (_, ELit(LBool(true))) =>
          int_term(1)

        case (ELit(LBool(false)), ELit(LBool(false))) =>
          int_term(0)

        case _ =>
          rewrite(ctx, Compare(a, b))
      end
  end

// the application of a function to its arguments, unfolded always if it is not recursive, and else where the match or
// if of its body is decided, which terminates since functions do
function unfold(ctx: Ctx, t: Term, d: Def, args: List[Term]): Term :=
  if size(d.formals) != size(args) or ctx.unfolds > limits().unfolds then
    rewrite(ctx, t)
  else
    let body := beta(args, d.body), inner := ctx with unfolds := ctx.unfolds + 1 in
    if not d.recursive then
      simp_term(inner, body)
    else
      match body
        case EMatch(expr, cases) =>
          match select(inner, simp_term(inner, expr), cases)
            case Some(b) =>
              simp_term(inner, b)
            case None =>
              rewrite(ctx, t)
          end

        case EIte(cond, then_expr, else_expr) =>
          match simp_term(inner, cond)
            case ELit(LBool(true)) =>
              simp_term(inner, then_expr)

            case ELit(LBool(false)) =>
              simp_term(inner, else_expr)

            case _ =>
              rewrite(ctx, t)
          end

        case _ =>
          rewrite(ctx, t)
      end

// the body of the first branch that matches t, with the values of its variables, or None if that is not decided
function select(ctx: Ctx, t: Term, bs: List[TermBranch]): Option[Term] :=
  match bs
    case List() =>
      None

    case List(TermBranch(pat, guard, body); rest) =>
      match match_pat(ctx.decls, pat, t)
        case Failed =>
          select(ctx, t, rest)

        case Stuck =>
          None

        case Matched(exprs) =>
          match guard
            case None =>
              Some(beta(exprs, body))

            case Some(h) =>
              match simp_term(ctx, beta(exprs, h))
                case ELit(LBool(true)) =>
                  Some(beta(exprs, body))

                case ELit(LBool(false)) =>
                  select(ctx, t, rest)

                case _ =>
                  None
              end
          end
      end
  end

function match_pat(decls: Decls, p: Pat, t: Term): PatMatch :=
  match p
    case PWild =>
      Matched(List())

    case PVar(_) =>
      Matched(List(t))

    case PLit(lit) =>
      match t
        case ELit(w) =>
          if lit == w then Matched(List()) else Failed
        case _ =>
          Stuck
      end

    case PApp(constr, pats) =>
      match constr_head(decls, t)
        case Some((f, args)) =>
          if f == constr and size(pats) == size(args) then
            match_pats(decls, List(for q in pats yield q.that), args)
          else
            Failed

        case None =>
          Stuck
      end

    case PTuple(args) =>
      match_pat(decls, PApp(tuple_name(size(args)), args), t)
  end

function match_pats(decls: Decls, ps: List[Pat], ts: List[Term]): PatMatch :=
  match (ps, ts)
    case (List(p; ps_), List(t; ts_)) =>
      match (match_pat(decls, p, t), match_pats(decls, ps_, ts_))
        case (Failed, _) =>
          Failed

        case (_, Failed) =>
          Failed

        case (Matched(xs), Matched(ys)) =>
          Matched(xs ++ ys)

        case _ =>
          Stuck
      end

    case _ =>
      Matched(List())
  end

// the best term of the class of a canonical atom in the e-graph, or else the atom by the first rule that applies
function rewrite(ctx: Ctx, t: Term): Term :=
  let v := match lookup_term(ctx.graph, t)
    case Some(c) =>
      extract(ctx, c)
    case None =>
      t
  end in
  if v != t or ctx.unfolds > limits().unfolds then
    v
  else
    apply_rules(ctx, ctx.rules, t)

function apply_rules(ctx: Ctx, rules: List[Rule], t: Term): Term :=
  match rules
    case List() =>
      t

    case List(r; rest) =>
      match instance(ctx, r, t)
        case Some(u) =>
          u
        case None =>
          apply_rules(ctx, rest, t)
      end
  end

// the rule applied to t: the instances of its left side are matched first syntactically, then modulo the equations of
// the e-graph with t, where the head of t is that of the left side, and the first whose conditions hold is taken
function instance(ctx: Ctx, r: Rule, t: Term): Option[Term] :=
  let n := size(r.vars) in
  let syntactic := match match_term(n, r.lhs, t, empty())
    case Some(sub) =>
      List(List(for i in range(0, n) yield lookup_index(n - 1 - i, sub)))
    case None =>
      List()
  end in
  let modulo := if first(shape(t)) != first(shape(r.lhs)) then
    List()
  else
    let (g, c) := add_term(ctx.graph, t) in
    List(for sub in ematch(g, n, r.lhs, c, empty()) for args in extract_args(ctx.decls, g, n, sub) yield args) in
  first_instance(ctx with unfolds := ctx.unfolds + 1, r, syntactic ++ modulo)

// the terms of the classes of a substitution of ematch, in the order of beta, where a variable that the left side does
// not bind stays, as in lookup_index
function extract_args(decls: Decls, g: EGraph, n: Int, sub: Map[Int, Int]): Option[List[Term]] :=
  let terms := List(for i in range(0, n) yield match get(n - 1 - i, sub)
    case Some(c) =>
      extract_in(decls, g, c, List())
    case None =>
      Some(EBound(n - 1 - i))
  end) in
  if exists(terms, lambda t => t == None) then
    None
  else
    Some(List(for t in terms for u in t yield u))

function first_instance(inner: Ctx, r: Rule, candidates: List[List[Term]]): Option[Term] :=
  match candidates
    case List() =>
      None

    case List(args; rest) =>
      if forall(r.conds, lambda c => simp_seq(inner, beta_seq(args, c)) == true_seq()) then
        Some(simp_term(inner, beta(args, r.rhs)))
      else
        first_instance(inner, r, rest)
  end

function lookup_index(i: Int, sub: Map[Int, Term]): Term :=
  match get(i, sub)
    case Some(e) =>
      e
    case None =>
      EBound(i)
  end

// the values of the variables below n of the pattern p such that it is t, first order
function match_term(n: Int, p: Term, t: Term, sub: Map[Int, Term]): Option[Map[Int, Term]] :=
  match (p, t)
    case (EBound(index), _) if index < n =>
      match get(index, sub)
        case Some(u) =>
          if u == t then Some(sub) else None
        case None =>
          Some(put(index, t, sub))
      end

    case (EApp(f, ps), EApp(g, ts)) if size(ps) == size(ts) =>
      match_terms(n, List(f; ps), List(g; ts), sub)

    case (ESum(k, ps), ESum(m, ts)) if k == m and size(ps) == size(ts) =>
      if List(for q in ps yield q.factor) == List(for q in ts yield q.factor) then
        match_terms(n, List(for q in ps yield q.term), List(for q in ts yield q.term), sub)
      else
        None

    case _ =>
      if p == t then Some(sub) else None
  end

function match_terms(n: Int, ps: List[Term], ts: List[Term], sub: Map[Int, Term]): Option[Map[Int, Term]] :=
  match (ps, ts)
    case (List(p; ps_), List(t; ts_)) =>
      match match_term(n, p, t, sub)
        case Some(next) =>
          match_terms(n, ps_, ts_, next)
        case None =>
          None
      end

    case _ =>
      Some(sub)
  end

function split_on(ctx: Ctx, levels: List[Int], ys: List[Var], assms: List[Seq], concls: List[Concl], cand: Option[Split], result: Seq): Seq :=
  if ctx.splits <= 0 then
    result
  else
    match cand
      case None =>
        result

      case Some(SplitIf(cond)) =>
        let t := Atom(rebind(Close(levels), 0, cond)), inner := ctx with splits := ctx.splits - 1 in
        if simp_seq(inner, Seq(ys, List(t; assms), concls)) == true_seq() and simp_seq(inner, Seq(ys, List(Seq(List(), List(t), List()); assms), concls)) == true_seq() then
          true_seq()
        else
          result

      case Some(SplitMatch(_, _, cost)) if cost > ctx.splits =>
        result

      case Some(SplitMatch(expr, datatype, cost)) =>
        let t := rebind(Close(levels), 0, expr), inner := ctx with splits := ctx.splits - cost in
        match get(datatype, ctx.decls.datatypes)
          case Some(cs) =>
            if forall(cs, lambda c => simp_seq(inner, split_case(ctx.decls, ys, assms, concls, t, c)) == true_seq()) then
              true_seq()
            else
              result

          case None =>
            result
        end
    end

// the case of the constructor c for the value t, with the fields of c as fixed variables outside the others
function split_case(decls: Decls, ys: List[Var], assms: List[Seq], concls: List[Concl], t: Term, c: Name): Seq :=
  match get(c, decls.constrs)
    case Some(ConstrDecl(_, fields)) =>
      let k := size(ys), n := size(fields) in
      let value := if n == 0 then
        EFun(c)
      else
        EApp(EFun(c), List(for i in range(0, n) yield EBound(k + n - 1 - i))) in
      Seq(fields ++ ys, List(Atom(Eq(t, value)); assms), concls)

    case None =>
      Seq(ys, assms, concls)
  end

// the first if or match of the sequent whose condition or argument is ground, else the first application whose unfolding
// is stuck, so that the splits that the terms ask for come before those that only unfolding would need
function split_candidate(decls: Decls, ss: List[Seq], cs: List[Concl]): Option[Split] :=
  or_else(candidate_in(decls, false, ss, cs), candidate_in(decls, true, ss, cs))

function candidate_in(decls: Decls, stuck: Bool, ss: List[Seq], cs: List[Concl]): Option[Split] :=
  or_else(first_of(List(for s in ss yield candidate_seq(decls, stuck, s))), first_of(List(for c in cs yield candidate_concl(decls, stuck, c))))

function first_of(os: List[Option[Split]]): Option[Split] :=
  match os
    case List() =>
      None

    case List(Some(s); _) =>
      Some(s)

    case List(None; rest) =>
      first_of(rest)
  end

function candidate_seq(decls: Decls, stuck: Bool, s: Seq): Option[Split] :=
  match s
    case Atom(expr) =>
      candidate(decls, stuck, expr)
    case Seq(_, assms, concls) =>
      candidate_in(decls, stuck, assms, concls)
  end

function candidate_concl(decls: Decls, stuck: Bool, c: Concl): Option[Split] :=
  first_of(List(for s in c.body yield candidate_seq(decls, stuck, s)))

function candidate(decls: Decls, stuck: Bool, e: Term): Option[Split] :=
  match e
    case EIte(cond, then_expr, else_expr) =>
      or_else(candidate(decls, stuck, cond), if loose(0, cond) == List() then
        Some(SplitIf(positive(cond)))
      else
        or_else(candidate(decls, stuck, then_expr), candidate(decls, stuck, else_expr)))

    case EMatch(expr, cases) =>
      match (loose(0, expr), datatype_of(decls, cases))
        case (List(), Some(t)) =>
          or_else(candidate(decls, stuck, expr), Some(SplitMatch(expr, t, 1)))
        case _ =>
          candidate(decls, stuck, expr)
      end

    case EApp(fun, args) =>
      or_else(first_of(List(for a in List(fun; args) yield candidate(decls, stuck, a))), if stuck then stuck_split(decls, e) else None)

    case ESum(_, summands) =>
      first_of(List(for summand in summands yield candidate(decls, stuck, summand.term)))

    case _ =>
      None
  end

// the split that would unfold an application of a recursive function, whose unfolding stopped since the argument of the
// match of its body is a variable, where splits on other terms cost too much for the goals that they close
function stuck_split(decls: Decls, e: Term): Option[Split] :=
  match e
    case EApp(EFun(name), args) =>
      match get((name, size(args)), decls.defs)
        case Some(d) if d.recursive =>
          match d.body
            case EMatch(expr, cases) =>
              let arg := beta(args, expr) in
              match (arg, datatype_of(decls, cases))
                case (ELevel(_), Some(t)) =>
                  Some(SplitMatch(arg, t, 2))
                case _ =>
                  None
              end

            case _ =>
              None
          end

        case _ =>
          None
      end

    case _ =>
      None
  end

function positive(c: Term): Term :=
  match c
    case Not(a) =>
      positive(a)
    case _ =>
      c
  end

function datatype_of(decls: Decls, bs: List[TermBranch]): Option[Name] :=
  match bs
    case List() =>
      None

    case List(TermBranch(PApp(constr, _), _, _); rest) =>
      match get(constr, decls.constrs)
        case Some(decl) =>
          Some(decl.datatype)
        case None =>
          datatype_of(decls, rest)
      end

    case List(_; rest) =>
      datatype_of(decls, rest)
  end

function induction(decls: Decls, s: Seq, p: Int): Seq :=
  match normal(s)
    case Seq(fixed, assms, concls) if p < size(fixed) =>
      match at(p, from_list(fixed)).typ
        case TSort(name, _) =>
          match get(name, decls.datatypes)
            case Some(cs) =>
              let k := size(fixed) in
              let assms_ := List(for a in assms yield rebind_seq(Open(0, k), 0, a)), concls_ := List(for c in concls yield rebind_concl(Open(0, k), 0, c)) in
              Seq(List(), List(), List(
                Concl(List(), List(for c in cs yield induction_case(decls, name, fixed, p, assms_, concls_, c)))))

            case None =>
              s
          end

        case _ =>
          s
      end

    case _ =>
      s
  end

// formulas as sequents, at the top only
function normal(s: Seq): Seq :=
  match s
    case Atom(expr) =>
      to_seq(expr)
    case _ =>
      s
  end

function induction_case(decls: Decls, t: Name, xs: List[Var], p: Int, assms: List[Seq], concls: List[Concl], c: Name): Seq :=
  match get(c, decls.constrs)
    case Some(ConstrDecl(_, fs)) =>
      let k := size(xs), n := size(fs) in
      let fields := List(for i in range(0, n) yield ELevel(k + i)) in
      let value := if n == 0 then EFun(c) else EApp(EFun(c), fields) in
      let v := ELevel(p), others := List(for l in range(0, k) if l != p) in
      let vars := List(for (x, l) in numbered(xs) if l != p yield x) in
      let ihs := List(for (f, i) in numbered(fs) if is_recursive(t, f) yield hypothesis(vars, others, v, ELevel(k + i), assms, concls)) in
      let levels := others ++ range(k, k + n) in
      Seq(vars ++ fs, List(for h in ihs ++ List(for a in assms yield replace_seq(v, value, a)) yield rebind_seq(Close(levels), 0, h)), List(for d in concls yield rebind_concl(Close(levels), 0, replace_concl(v, value, d))))

    case None =>
      false_seq()
  end

function is_recursive(t: Name, field: Var): Bool :=
  match field.typ
    case TSort(name, _) =>
      name == t
    case _ =>
      false
  end

function hypothesis(vars: List[Var], others: List[Int], v: Term, y: Term, assms: List[Seq], concls: List[Concl]): Seq :=
  Seq(vars, List(for a in assms yield rebind_seq(Close(others), 0, replace_seq(v, y, a))), List(for d in concls yield rebind_concl(Close(others), 0, replace_concl(v, y, d))))

function print_seq(s: Seq): Str :=
  print_open(List(), s)

function fresh(names: List[Id], x: Id): Id :=
  if contains(x, names) then fresh(names, x ++ "'") else x

function fresh_all(names: List[Id], xs: List[Var]): List[Id] :=
  match xs
    case List() =>
      List()

    case List(x; rest) =>
      let y := fresh(names, x.name.base) in
      List(y; fresh_all(names ++ List(y), rest))
  end

function print_open(names: List[Id], s: Seq): Str :=
  match s
    case Atom(expr) =>
      print_term(names, expr)

    case Seq(List(), List(), List(Concl(List(), List()))) =>
      "true"

    case Seq(List(), List(), List()) =>
      "false"

    case Seq(List(), List(a), List()) =>
      "not " ++ print_part(names, a)

    case Seq(fixed, assms, concls) =>
      let ys := fresh_all(names, fixed), d := size(names), k := size(fixed) in
      let inner := names ++ ys in
      let binder := if fixed == List() then "" else "forall " ++ join(", ", ys) ++ " => " in
      let premises := join(" and ", List(for a in assms yield print_part(inner, rebind_seq(Open(d, k), 0, a)))) in
      let ends := if concls == List() then
        "false"
      else
        join(" or ", List(for c in concls yield print_concl(inner, size(concls) > 1, rebind_concl(Open(d, k), 0, c)))) in
      binder ++ (if assms == List() then ends else premises ++ " ==> " ++ ends)
  end

function print_part(names: List[Id], s: Seq): Str :=
  match s
    case Atom(_) =>
      print_open(names, s)
    case _ =>
      "(" ++ print_open(names, s) ++ ")"
  end

function print_concl(names: List[Id], several: Bool, c: Concl): Str :=
  match c
    case Concl(vars, body) =>
      let ys := fresh_all(names, vars), d := size(names), k := size(vars) in
      let inner := names ++ ys in
      let parts := List(for s in body yield rebind_seq(Open(d, k), 0, s)) in
      let text := if parts == List() then
        "true"
      else if size(parts) == 1 and vars == List() and not several then
        print_open(inner, at(0, from_list(parts)))
      else
        join(" and ", List(for t in parts yield print_part(inner, t))) in
      if vars == List() then
        if several and size(parts) > 1 then "(" ++ text ++ ")" else text
      else
        "(exists " ++ join(", ", ys) ++ " => " ++ text ++ ")"
  end
