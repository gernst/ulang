// the translation of the programs that ulang/check/check.u checks into the terms of the prover, see ideas/prove.md
//
// Checked programs have resolved names, which the terms keep: only the formals and the variables of lambdas, lets, and
// patterns become indices, by an environment of their names, the innermost first.

import "ulang/syntax"
import "ulang/check"

export

// a lemma as the sequent that the prover proves, and its proof, None for the default proof, where a claim correct p(…)
// holds only for the runs that end, so that it is no fact of other lemmas, and the contract of a procedure is a lemma
// that is assumed, not proven
data Lemma :=
  case Lemma(name: Name, goal: Seq, proof: Option[ProofTerm], claim: Bool)

// a proof over the terms of the prover, whose variables are the formals, the locals, and the variables of the cases
// around it, as indices, the innermost first, at the position where it starts, see ideas/prove.md, section 4
data ProofTerm :=
  case ProofTerm(steps: List[StepTerm], split: Option[SplitTerm], pos: Pos)

data StepTerm :=
  // local x := e, a variable with the fact x == e
  case DefineTerm(var: Var, value: Term, pos: Pos)
  // local q: T, a witness
  case WitnessTerm(var: Var, pos: Pos)
  // call l(a, …, out q, …), the instance of the lemma l, with the witnesses as the indices of the locals q, …
  case CallTerm(name: Name, args: List[Term], outs: List[Int], pos: Pos)
  // assign q := e, the witness of the out q, by its index
  case AssignTerm(witness: Int, value: Term, pos: Pos)
  // assert e
  case AssertTerm(cond: Term, pos: Pos)
  // a part of a proof that the prover does not take yet, with what it is
  case UnsupportedTerm(what: Str, pos: Pos)

data SplitTerm :=
  // induction on the formal at the position formal from the first
  case InductionTerm(formal: Int, cases: List[CaseTerm], pos: Pos)
  case MatchTerm(arg: Term, cases: List[CaseTerm], pos: Pos)
  case IfTerm(cond: Term, left: ProofTerm, right: Option[ProofTerm], pos: Pos)
  // the loop while cond do … end of a procedure with the invariant inv: the variables that the loop assigns, havoc, by the
  // indices of their values before it, inv and cond over the variables around and havoc as the innermost, body the proof
  // that the body leads from inv and cond to inv, over the variables around, havoc, and their values after the body,
  // which it assigns as witnesses, and after the proof of the rest from inv and not cond, over those around and havoc
  case InvariantTerm(vars: List[Int], havoc: List[Var], inv: Term, cond: Term, body: ProofTerm, after: ProofTerm, pos: Pos)

// a case of a split: its pattern, its guard, and the variables of the pattern in the order in which they bind, which
// bind in the guard and the proof
data CaseTerm :=
  case CaseTerm(pat: Pat, guard: Option[Term], vars: List[Var], proof: ProofTerm, pos: Pos)

// the symbols, the lemmas of the module in their order, and the contracts of the procedures with the contract of raise,
// which the proofs of claims call
data Translation :=
  case Translation(decls: Decls, lemmas: List[Lemma], contracts: List[Lemma])

// the symbols of the checked program q and the lemmas of its module m in their order
function translate(q: Prog, m: Id): Translation

// the name of the contract of raise, which ends a run that the claim of a procedure no longer covers
function raise_name(): Name

implementation

function translate(q: Prog, m: Id): Translation :=
  let cmds := definitions(q) in
  let ranked := zip(range(0, size(cmds)), cmds) in
  let defined := List(for cmd in cmds for d in definition(cmd) yield d) in
  let datas := List(for (rank, cmd) in ranked for d in datatype(rank, cmd) yield d) in
  let ranks := Map(for (rank, cmd) in ranked for n in fun_name(cmd) yield n => rank) in
  let defs := defs_of(q) in
  let decls := datas_decls(datas) with abstracts := defs.abstracts, ordered := defs.abstracts ++ Set(for t => _ in defs.orders yield t) in
  let procs := Map(for cmd in cmds for (k, p) in proc_of(cmd) yield k => p) in
  let contracts := Map(for cmd in cmds for (k, c) in contract_of(cmd) yield k => c) in
  let known := Set(for k => _ in contracts yield k) in
  Translation(with_defs(decls, defined, ranks), List(for cmd in cmds for l in lemma_of(m, procs, known, cmd) yield l), List(raise_contract(); List(for _ => c in contracts yield c)))

function fun_name(cmd: Cmd): Option[Name] :=
  match cmd
    case CFun(name, _, _, _, _, _) =>
      Some(name)
    case _ =>
      None
  end

// a function by its name and arity, as Defs.funs of ulang/check/defs.u, with its formals and body
function definition(cmd: Cmd): Option[(Name * Int) * (List[Var] * Term)] :=
  match cmd
    case CFun(name, _, formals, _, _, body) =>
      let xs := vars(formals) in
      Some(((name, size(xs)), (xs, term_of(bind(xs, List()), body))))

    case _ =>
      None
  end

function datatype(rank: Int, cmd: Cmd): Option[Int * (Name * List[Constr])] :=
  match cmd
    case CData(t, _, constrs) =>
      Some((rank, (t, parts(constrs))))
    case _ =>
      None
  end

function datas_decls(datas: List[Int * (Name * List[Constr])]): Decls :=
  match datas
    case List() =>
      empty_decls()

    case List((rank, (t, constrs)); rest) =>
      let decls := datas_decls(rest) in
      let constr_decls := Map(for k in constrs yield k.name => ConstrDecl(t, List(for field in k.fields yield Var(Name(None, field.name), field.typ)))) in
      decls with constrs := decls.constrs ++ constr_decls, datatypes := put(t, List(for k in constrs yield k.name), decls.datatypes), ranks := decls.ranks ++ Map(for k in constrs yield k.name => rank)
  end

// the definitions, each recursive if it reaches itself by the symbols in the bodies, also through other functions, where
// a name passed without its arguments reaches the definitions of all its arities
function with_defs(decls: Decls, defined: List[(Name * Int) * (List[Var] * Term)], ranks: Map[Name, Int]): Decls :=
  let calls := Map(for ((n, k), (_, body)) in defined yield (n, k) => symbols_in(body)) in
  let arities := Map(for ((n, _), _) in defined yield n => List(for ((m, k), _) in defined if m == n yield k)) in
  let reached := Map(for ((n, k), _) in defined yield (n, k) => reachable(calls, arities, callees(arities, value_or(get((n, k), calls), empty())), empty())) in
  let defs := Map(for ((n, k), (formals, body)) in defined yield (n, k) => definition_of((n, k), formals, body, decls, value_or(get((n, k), reached), empty()))) in
  decls with defs := defs, ranks := decls.ranks ++ ranks

function definition_of(key: Name * Int, formals: List[Var], body: Term, decls: Decls, reaches: Set[Name * Int]): Def :=
  Def(contains(key, reaches), formals, body, def_equations(decls, formals, body), reaches)

// the definitions that the symbols name, by the arities of the defined names
function callees(arities: Map[Name, List[Int]], symbols: Set[Name * Int]): List[Name * Int] :=
  List(for (n, k) in symbols for j in value_or(get(n, arities), List()) if k == j or k == -1 yield (n, j))

// the definitions that those of todo reach, with seen, which grows within the keys of calls, so that this ends
function reachable(calls: Map[Name * Int, Set[Name * Int]], arities: Map[Name, List[Int]], todo: List[Name * Int], seen: Set[Name * Int]): Set[Name * Int] :=
  match todo
    case List() =>
      seen

    case List(f; rest) =>
      match get(f, calls)
        case Some(called) if not contains(f, seen) =>
          reachable(calls, arities, callees(arities, called) ++ rest, insert(f, seen))
        case _ =>
          reachable(calls, arities, rest, seen)
      end
  end

// the lemma of cmd if it belongs to module m, for all formals that satisfy its assumptions, where procs are the
// procedures with bodies and contracts the keys of those with contracts, by name and arity
function lemma_of(m: Id, procs: Map[Name * Int, Cmd], contracts: Set[Name * Int], cmd: Cmd): Option[Lemma] :=
  match cmd
    case CLemma(name, _, formals, outs, ClaimHolds(assms, concl), proof) if name.module == Some(m) =>
      let xs := vars(formals), ys := vars(outs) in
      let env := bind(xs, List()), all := bind(xs ++ ys, List()) in
      let atoms := List(for a in assms yield Atom(term_of(env, a))), goal := Atom(term_of(all, concl)) in
      Some(Lemma(name, Seq(xs, atoms, List(Concl(ys, List(goal)))), map_option(proof, lambda p => proof_term(xs, all, p, Pos(0, 0))), false))

    case CLemma(name, _, formals, outs, ClaimCorrect(proc, args, _), proof) if name.module == Some(m) =>
      Some(claim_of(name, vars(formals), vars(outs), args, get((proc, size(args) + size(outs)), procs), contracts, value_or(proof, Proof(List(), None))))

    case _ =>
      None
  end

// a procedure with a body by its name and arity
function proc_of(cmd: Cmd): Option[(Name * Int) * Cmd] :=
  match cmd
    case CProc(name, _, ins, outs, refs, _, _, _) =>
      Some(((name, size(ins) + size(outs) + size(refs)), cmd))
    case _ =>
      None
  end

// the contract of a procedure as a lemma, assumed, not proven, over its ins and the values of its refs before as formals,
// and its outs and the values of its refs after as outs, where its requires sees the refs before and its ensures after
function contract_of(cmd: Cmd): Option[(Name * Int) * Lemma] :=
  match cmd
    case CProc(name, _, in_decls, out_decls, ref_decls, _, spec, _) if spec.pre != List() or spec.post != None =>
      let ins := vars(in_decls), outs := vars(out_decls), refs := vars(ref_decls) in
      let before := List(for r in refs yield Var(Name(None, "(before)" ++ r.name.base), r.typ)) in
      let pre := bind(ins ++ refs, List()), post := bind(ins ++ before ++ outs ++ refs, List()) in
      let atoms := List(for a in spec.pre yield Atom(term_of(pre, a))) in
      let concl := match spec.post
        case Some(e) =>
          term_of(post, e)
        case None =>
          bool_term(true)
      end in
      let key := (name, size(ins) + size(outs) + size(refs)) in
      Some((key, Lemma(contract_name(key), Seq(ins ++ refs, atoms, List(Concl(outs ++ refs, List(Atom(concl))))), None, false)))

    case _ =>
      None
  end

// a name of the contract of a procedure, which users cannot write
function contract_name(key: Name * Int): Name :=
  match key
    case (name, arity) =>
      Name(name.module, "(contract)" ++ name.base ++ "/" ++ show(arity))
  end

function raise_name(): Name :=
  Name(None, "(raise)")

function raise_contract(): Lemma :=
  Lemma(raise_name(), Seq(List(), List(), List(Concl(List(), List(Atom(bool_term(false)))))), None, false)

// the claim correct p(args, out outs) of the lemma name over formals: the requires of p at the arguments as its
// assumptions, the ensures of p at them and the outs as its conclusion, and the proof that runs the body of p from the
// arguments, by its invariants, to the values of its outs, which are the witnesses of the outs of the lemma
function claim_of(name: Name, formals: List[Var], outs: List[Var], args: List[At[Expr]], proc: Option[Cmd], contracts: Set[Name * Int], proof: Proof): Lemma :=
  let env := bind(formals, List()), all := bind(formals ++ outs, List()) in
  let at_formals := List(for a in args yield term_of(env, a)), at_all := List(for a in args yield term_of(all, a)) in
  let results := List(for i in range(0, size(outs)) yield EBound(size(outs) - 1 - i)) in
  match proc
    case Some(CProc(_, _, in_decls, out_decls, _, _, spec, stmt)) =>
      let ins := vars(in_decls), proc_outs := vars(out_decls) in
      let atoms := List(for a in spec.pre yield Atom(beta(at_formals, term_of(bind(ins, List()), a)))) in
      let concl := match spec.post
        case Some(e) =>
          beta(at_all ++ results, term_of(bind(ins ++ proc_outs, List()), e))
        case None =>
          bool_term(true)
      end in
      let invariants := Map(for (pos, step) in zip(loop_positions(stmt), proof.steps) for e in invariant_of(step.that) yield pos => e) in
      let exec := Exec(invariants, contracts) in
      let start := List(for (x, (a, i)) in zip(ins, zip(at_all, range(0, size(ins)))) yield DefineTerm(x, shift(i, a), stmt.pos)) in
      let finish := IFinish(range(size(formals), size(formals) + size(outs)), List(for x in proc_outs yield x.name), ensures_pos(spec, stmt.pos)) in
      Lemma(name, Seq(formals, atoms, List(Concl(outs, List(Atom(concl))))), Some(run(exec, bind(ins, all), List(IStmt(stmt), finish), start, stmt.pos)), true)

    // a builtin procedure, which has no body
    case _ =>
      Lemma(name, Seq(formals, List(), List(Concl(outs, List(Atom(bool_term(true)))))), Some(ProofTerm(List(UnsupportedTerm("a claim of a procedure without a body", Pos(0, 0))), None, Pos(0, 0))), true)
  end

function invariant_of(step: Step): Option[At[Expr]] :=
  match step
    case StepInvariant(cond) =>
      Some(cond)
    case _ =>
      None
  end

function ensures_pos(spec: Spec, pos: Pos): Pos :=
  match spec.post
    case Some(e) =>
      e.pos
    case None =>
      pos
  end

// what the run of the body of a procedure knows: the invariants of its loops by their positions, and the procedures with
// contracts by name and arity
data Exec :=
  case Exec(invariants: Map[Pos, At[Expr]], contracts: Set[Name * Int])

// what is left of a run: a statement, or the end of a body, which assigns the variables of sources to the witnesses at the
// levels targets, the outs of the lemma at the end of the procedure, the values after the body of a loop at its end
data Item :=
  case IStmt(stmt: At[Stmt])
  case IFinish(targets: List[Int], sources: List[Name], pos: Pos)

// the proof of the run of items under env after steps, where each assignment is a definition of a new variable of its
// name, so that a name stands for the last value assigned to it, and a branch of an if or a case of a match carries the
// rest of the run, so that each path through the body is a path through the proof; a call is the call of the contract of
// its procedure, else its outs and refs become values that nothing is known of, and a raise ends its path, since a claim
// is about the runs that end normally
function run(exec: Exec, env: List[Name], items: List[Item], steps: List[StepTerm], pos: Pos): ProofTerm :=
  match items
    case List() =>
      ProofTerm(steps, None, pos)

    case List(IFinish(targets, sources, at); _) =>
      ProofTerm(steps ++ List(for (t, x) in zip(targets, sources) yield AssignTerm(size(env) - 1 - t, var_term(env, x), at)), None, at)

    case List(IStmt(stmt); rest) =>
      run_stmt(exec, env, stmt, rest, steps, pos)
  end

// checked programs with parts that do not parse are not proven, so stmt is parsed
function run_stmt(exec: Exec, env: List[Name], stmt: At[Stmt], rest: List[Item], steps: List[StepTerm], pos: Pos): ProofTerm :=
  match stmt.that
    case SSkip =>
      run(exec, env, rest, steps, pos)

    // in parallel, so that each value is of the variables before the assignment, shifted over the definitions before it
    case SAssign(upd) =>
      let defs := List(for ((x, e), i) in zip(upd, range(0, size(upd))) yield DefineTerm(x, shift(i, term_of(env, e)), stmt.pos)) in
      run(exec, bind(List(for (x, _) in upd yield x), env), rest, steps ++ defs, pos)

    case SBlock(_, stmts) =>
      run(exec, env, List(for d in stmts yield IStmt(d.at)) ++ rest, steps, pos)

    case SIf(cond, left, right) =>
      let c := term_of(env, cond) in
      let yes := run(exec, env, List(IStmt(left); rest), List(), left.pos), no := run(exec, env, List(IStmt(right); rest), List(), right.pos) in
      ProofTerm(steps, Some(IfTerm(c, yes, Some(no), stmt.pos)), pos)

    case SMatch(arg, cases) =>
      let a := term_of(env, arg) in
      let typed_cases := List(for d in cases yield run_case(exec, env, d, rest)) in
      ProofTerm(steps, Some(MatchTerm(a, typed_cases, stmt.pos)), pos)

    case SWhile(cond, body) =>
      run_loop(exec, env, stmt.pos, cond, body, rest, steps, pos)

    case SCall(proc, ins, outs, refs) =>
      let key := (proc, size(ins) + size(outs) + size(refs)), results := outs ++ refs in
      let args := List(for a in ins yield term_of(env, a)) ++ List(for r in refs yield var_term(env, r.name)) in
      let witnesses := List(for x in results yield WitnessTerm(x, stmt.pos)) in
      let called := if contains(key, exec.contracts) then
        List(
          CallTerm(contract_name(key), List(for a in args yield shift(size(results), a)), List(for i in range(0, size(results)) yield size(results) - 1 - i), stmt.pos))
      else
        List() in
      run(exec, bind(results, env), rest, steps ++ witnesses ++ called, pos)

    case SAssert(cond) =>
      run(exec, env, rest, steps ++ List(AssertTerm(term_of(env, cond), stmt.pos)), pos)

    case SRaise(_, _) =>
      ProofTerm(steps ++ List(CallTerm(raise_name(), List(), List(), stmt.pos)), None, stmt.pos)

    case SAssertRaises(_, _, _) =>
      unsupported("assert raises in a procedure", stmt.pos, steps)

    case STry(_, _) =>
      unsupported("try in a procedure", stmt.pos, steps)

    case SFor(_, _) =>
      unsupported("for in a procedure", stmt.pos, steps)
  end

// a statement that the run does not take, after which its path ends, as after a raise
function unsupported(what: Str, pos: Pos, steps: List[StepTerm]): ProofTerm :=
  ProofTerm(steps ++ List(UnsupportedTerm(what, pos), CallTerm(raise_name(), List(), List(), pos)), None, pos)

function run_case(exec: Exec, env: List[Name], d: Doc[Branch[At[Stmt]]], rest: List[Item]): CaseTerm :=
  let br := d.at.that, pos := d.at.pos in
  let vars := pattern_vars(br.pat.that) in
  let inner := bind(vars, env) in
  CaseTerm(br.pat.that, map_option(br.guard, lambda g => term_of(inner, g)), vars, run(exec, inner, List(IStmt(br.body); rest), List(), pos), pos)

// the loop at pos by its invariant, true if it has none: the variables that it assigns and that are known before it are
// the havoc, and its body runs over them and the witnesses of their values after it, named (next)x, up to their
// assignment at its end
function run_loop(exec: Exec, env: List[Name], pos: Pos, cond: At[Expr], body: At[Stmt], rest: List[Item], steps: List[StepTerm], start: Pos): ProofTerm :=
  let havoc := List(for x in distinct_vars(assigned_vars(body)) if index_of(x.name, env) != None yield x) in
  let around := bind(havoc, env) in
  let next := List(for x in havoc yield Var(Name(None, "(next)" ++ x.name.base), x.typ)) in
  let inner := bind(next, around) in
  let written := get(pos, exec.invariants) in
  let inv := match written
    case Some(e) =>
      term_of(around, e)
    case None =>
      bool_term(true)
  end in
  let at := match written
    case Some(e) =>
      e.pos
    case None =>
      pos
  end in
  let finish := IFinish(range(size(around), size(inner)), List(for x in havoc yield x.name), at) in
  let body_term := run(exec, inner, List(IStmt(body), finish), List(), body.pos) in
  let after := run(exec, around, rest, List(), start) in
  ProofTerm(steps, Some(InvariantTerm(List(for x in havoc yield value_or(index_of(x.name, env), 0)), havoc, inv, term_of(around, cond), body_term, after, at)), start)

// the value of the variable x under env, which is assigned where it is read, as the checker ensures
function var_term(env: List[Name], x: Name): Term :=
  match index_of(x, env)
    case Some(i) =>
      EBound(i)
    case None =>
      EFun(x)
  end

// the variables that stmt assigns, also as outs and refs of calls, in its loops and branches
function assigned_vars(stmt: At[Stmt]): List[Var] :=
  if not is_parsed(stmt) then List() else assigned_in(stmt.that)

function assigned_in(stmt: Stmt): List[Var] :=
  match stmt
    case SAssign(upd) =>
      List(for (x, _) in upd yield x)

    case SCall(_, _, outs, refs) =>
      outs ++ refs

    case SBlock(_, stmts) =>
      List(for d in stmts for x in assigned_vars(d.at) yield x)

    case SIf(_, left, right) =>
      assigned_vars(left) ++ assigned_vars(right)

    case SWhile(_, body) =>
      assigned_vars(body)

    case SMatch(_, cases) =>
      List(for d in cases for x in assigned_vars(d.at.that.body) yield x)

    case SAssertRaises(_, _, body) =>
      assigned_vars(body)

    case STry(body, catches) =>
      assigned_vars(body) ++ List(for d in catches for x in assigned_vars(d.at.that.body) yield x)

    case SFor(_, body) =>
      assigned_vars(body)

    case SSkip =>
      List()

    case SAssert(_) =>
      List()

    case SRaise(_, _) =>
      List()
  end

// the variables by their first occurrence of each name
function distinct_vars(xs: List[Var]): List[Var] :=
  match xs
    case List() =>
      List()
    case List(x; rest) =>
      List(x; distinct_vars(List(for y in rest if y.name != x.name yield y)))
  end

// a proof under env, which starts at pos if it has no steps
function proof_term(formals: List[Var], env: List[Name], proof: Proof, pos: Pos): ProofTerm :=
  let start := match (proof.steps, proof.split)
    case (List(step; _), _) =>
      step.pos

    case (List(), Some(split)) =>
      split.pos

    case _ =>
      pos
  end in
  match steps_term(formals, env, proof.steps, List())
    case (steps, inner) =>
      ProofTerm(steps, map_option(proof.split, lambda split => split_term(formals, inner, split)), start)
  end

// the steps under env, each local binding inside the steps after it, and the environment after them
function steps_term(formals: List[Var], env: List[Name], steps: List[At[Step]], acc: List[StepTerm]): List[StepTerm] * List[Name] :=
  match steps
    case List() =>
      (reverse(acc), env)

    case List(step; rest) =>
      match step.that
        case StepLocal(x, Some(value)) =>
          steps_term(formals, List(x.that.name; env), rest, List(DefineTerm(x.that, term_of(env, value), step.pos); acc))

        case StepLocal(x, None) =>
          steps_term(formals, List(x.that.name; env), rest, List(WitnessTerm(x.that, step.pos); acc))

        case StepCall(name, ins, outs) =>
          let witnesses := List(for y in outs yield value_or(index_of(y.name, env), 0)) in
          steps_term(formals, env, rest, List(
            CallTerm(name, List(for a in ins yield term_of(env, a)), witnesses, step.pos); acc))

        case StepAssert(cond) =>
          steps_term(formals, env, rest, List(AssertTerm(term_of(env, cond), step.pos); acc))

        // the assignments in parallel, of distinct outs, each a term of its own
        case StepAssign(upd) =>
          steps_term(formals, env, rest, reverse(List(for (y, e) in upd yield AssignTerm(value_or(index_of(y.name, env), 0), term_of(env, e), step.pos))) ++ acc)

        // the checker allows invariants only in the proofs of claims, which claim_of translates
        case StepInvariant(_) =>
          steps_term(formals, env, rest, List(UnsupportedTerm("an invariant outside a claim", step.pos); acc))
      end
  end

function split_term(formals: List[Var], env: List[Name], split: At[Split]): SplitTerm :=
  match split.that
    case SplitInduction(x, cases) =>
      InductionTerm(value_or(index_of(x.name, List(for f in formals yield f.name)), 0), List(for c in cases yield case_term(formals, env, c)), split.pos)

    case SplitMatch(arg, cases) =>
      MatchTerm(term_of(env, arg), List(for c in cases yield case_term(formals, env, c)), split.pos)

    case SplitIf(cond, left, right) =>
      IfTerm(term_of(env, cond), proof_term(formals, env, left, split.pos), map_option(right, lambda p => proof_term(formals, env, p, split.pos)), split.pos)
  end

function case_term(formals: List[Var], env: List[Name], d: Doc[Branch[Proof]]): CaseTerm :=
  let br := d.at.that, pos := d.at.pos in
  let vars := pattern_vars(br.pat.that) in
  let inner := bind(vars, env) in
  CaseTerm(br.pat.that, map_option(br.guard, lambda g => term_of(inner, g)), vars, proof_term(formals, inner, br.body, pos), pos)

// the environment env with the variables xs bound inside it, the last one innermost
function bind(xs: List[Var], env: List[Name]): List[Name] :=
  reverse(List(for x in xs yield x.name)) ++ env

function term_of(env: List[Name], expr: At[Expr]): Term :=
  match expr.that
    case ELit(lit) =>
      ELit(lit)

    case EVar(Var(name, _)) =>
      match index_of(name, env)
        case Some(i) =>
          EBound(i)
        case None =>
          EFun(name)
      end

    case EApp(fun, args) =>
      let f := term_of(env, fun), terms := List(for a in args yield term_of(env, a)) in
      EApp(f, terms)

    case ELam(formals, body) =>
      let xs := lambda_vars(formals) in
      let inner := term_of(bind(xs, env), body) in
      ELam(xs, inner)

    case ELet(bindings, body) =>
      let_term(env, bindings, body)

    case EIte(cond, then_expr, else_expr) =>
      let c := term_of(env, cond), a := term_of(env, then_expr), b := term_of(env, else_expr) in
      EIte(c, a, b)

    case EMatch(arg, cases) =>
      let a := term_of(env, arg), bs := List(for br in cases yield branch_term(env, br)) in
      EMatch(a, bs)

    case ETuple(args) =>
      let terms := List(for a in args yield term_of(env, a)) in
      EApp(EFun(tuple_name(size(args))), terms)

    // procedure values are atoms, told apart by their text
    case EProc(_, _, _, _, _) =>
      EFun(Name(Some("(procedure)"), show(expr.that)))

    // the checker translates accesses, updates, and forms, so checked programs have none
    case EField(_, _) =>
      unchecked(expr)

    case EUpdate(_, _, _) =>
      unchecked(expr)

    case EForm(_, _, _) =>
      unchecked(expr)

    case EFor(_, _, _, _) =>
      unchecked(expr)
  end

function unchecked(expr: At[Expr]): Term :=
  EFun(Name(Some("(unchecked)"), show(expr.that)))

// a let of variables by substitution, else the match of its patterns, of a tuple if there are several
function let_term(env: List[Name], bindings: List[At[Pat] * At[Expr]], body: At[Expr]): Term :=
  let values := List(for (_, a) in bindings yield term_of(env, a)), pats := List(for (p, _) in bindings yield p) in
  match pattern_vars(pats)
    case Some(xs) =>
      let inner := term_of(bind(xs, env), body) in
      beta(values, inner)

    case None =>
      let_match(env, if size(pats) == 1 then at(0, from_list(pats)).that else PTuple(pats), if size(values) == 1 then
        at(0, from_list(values))
      else
        EApp(EFun(tuple_name(size(values))), values), body)
  end

// the match of value against the irrefutable pat, which binds in body
function let_match(env: List[Name], pat: Pat, value: Term, body: At[Expr]): Term :=
  let inner := term_of(bind(pattern_vars(pat), env), body) in
  EMatch(value, List(TermBranch(pat, None, inner)))

function branch_term(env: List[Name], d: Doc[Branch[At[Expr]]]): TermBranch :=
  let br := d.at.that in
  let inner := bind(pattern_vars(br.pat.that), env) in
  let guard := map_option(br.guard, lambda g => term_of(inner, g)), body := term_of(inner, br.body) in
  TermBranch(br.pat.that, guard, body)
