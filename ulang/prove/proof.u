// the proofs of lemmas, which walk the steps of a proof over the goal, see ideas/prove.md, section 4
//
// The state of a block is its fixed variables as levels, the first ones the formals, the facts and the goal over them,
// and the levels of the variables that the terms of the proof have as indices, the innermost first, which a translated
// term is opened at; a split has a case per leaf of the patterns of its cases (ulang/prove/patterns.u), which adds the
// variables of the leaf, also those that no pattern names, and checks each case that matches the leaf. Every step is simplified with the lemmas proven before as facts, which it may also call; the lemma itself is
// called only as an induction hypothesis, at a recursive field of the case.

import "ulang/syntax"

export

// what a proof leaves at pos: a goal that stays open, with the goal as text, or a step that it cannot take, by the code
// of the Diagnostic of ulang/syntax/error.u that reports it: OpenGoal, UnprovenCall, Unsupported, or OpenLemma of a
// lemma without a proof
data Gap :=
  case Gap(pos: Pos, code: Str, message: Str, goal: Option[Str])

// the gaps of the proof of the lemma target, none if it proves it, where proven are the lemmas proven before and
// contracts those of the procedures, which the proof of a claim calls at the calls of its procedure
function check_proof(decls: Decls, proven: List[Lemma], contracts: List[Lemma], target: Lemma, proof: ProofTerm): List[Gap]

implementation

// what a proof works with: the declarations, the lemmas proven before, the contracts of the procedures, and the lemma
// being proven
data Walk :=
  case Walk(decls: Decls, proven: List[Lemma], contracts: Map[Name, Seq], target: Lemma)

// the induction around a block: the position of its formal and the values of it at which the hypothesis holds, the
// recursive fields of the case of a datatype, or n - 1 for an integer n
data Around :=
  case Around(formal: Int, values: List[Term])

// the variables, the levels of the variables of the terms of the proof, the facts, the goal, the levels of the outs of
// the lemma that are not assigned yet, which are existential in the goal, and the induction around the block
data Scope :=
  case Scope(vars: List[Var], env: List[Int], facts: List[Seq], goal: Term, outs: List[Int], around: Option[Around])

function check_proof(decls: Decls, proven: List[Lemma], contracts: List[Lemma], target: Lemma, proof: ProofTerm): List[Gap] :=
  match target.goal
    case Seq(formals, atoms, List(Concl(outs, List(Atom(concl))))) =>
      let n := size(formals), m := size(outs) in
      let levels := List(for i in range(0, n) yield ELevel(i)), all := List(for i in range(0, n + m) yield ELevel(i)) in
      let facts := List(for a in atoms for t in atom_term(a) yield Atom(beta(levels, t))) in
      let scope := Scope(formals ++ outs, reverse(range(0, n + m)), facts, beta(all, concl), range(n, n + m), None) in
      block_gaps(Walk(decls, proven, Map(for c in contracts yield c.name => c.goal), target), scope, proof)

    // translate gives every lemma this shape
    case _ =>
      List(Gap(proof.pos, "Unsupported", "a lemma of another shape", None))
  end

function atom_term(s: Seq): Option[Term] :=
  match s
    case Atom(t) =>
      Some(t)
    case _ =>
      None
  end

// a translated term at the levels of its variables
function opened(scope: Scope, t: Term): Term :=
  beta(List(for l in reverse(scope.env) yield ELevel(l)), t)

// the steps in their order, then the split, or else the goal, which must close
function block_gaps(w: Walk, scope: Scope, proof: ProofTerm): List[Gap] :=
  match steps_gaps(w, scope, proof.steps, List())
    case (after, gaps) =>
      gaps ++ match proof.split
        case Some(split) =>
          split_gaps(w, after, split)
        case None =>
          closing(w, after, after.goal, proof.pos)
      end
  end

function steps_gaps(w: Walk, scope: Scope, steps: List[StepTerm], gaps: List[Gap]): Scope * List[Gap] :=
  match steps
    case List() =>
      (scope, gaps)

    case List(step; rest) =>
      match step_gaps(w, scope, step)
        case (after, more) =>
          steps_gaps(w, after, rest, gaps ++ more)
      end
  end

function step_gaps(w: Walk, scope: Scope, step: StepTerm): Scope * List[Gap] :=
  match step
    case DefineTerm(x, value, _) =>
      let k := size(scope.vars) in
      (scope with vars := scope.vars ++ List(defined_var(x)), env := List(k; scope.env), facts := scope.facts ++ List(Atom(Eq(ELevel(k), opened(scope, value)))), List())

    case WitnessTerm(x, _) =>
      let k := size(scope.vars) in
      (scope with vars := scope.vars ++ List(x), env := List(k; scope.env), List())

    case AssertTerm(cond, pos) =>
      let c := opened(scope, cond) in
      (scope with facts := scope.facts ++ List(Atom(c)), closing(w, scope, c, pos))

    case CallTerm(name, args, outs, pos) =>
      let terms := List(for a in args yield opened(scope, a)) in
      let witnesses := List(for i in outs yield ELevel(at(i, from_list(scope.env)))) in
      match called(w, scope, name, terms)
        case Some(Seq(_, atoms, List(Concl(_, List(Atom(concl)))))) =>
          let required := List(for a in atoms for t in atom_term(a) for g in closing(w, scope, beta(terms, t), pos) yield g) in
          (scope with facts := scope.facts ++ List(Atom(beta(terms ++ witnesses, concl))), required)

        case Some(_) =>
          (scope, List(Gap(pos, "Unsupported", "a lemma of another shape", None)))

        case None =>
          (scope, List(Gap(pos, "UnprovenCall", call_gap(w, name), None)))
      end

    case AssignTerm(witness, value, _) =>
      let l := at(witness, from_list(scope.env)) in
      (scope with facts := scope.facts ++ List(Atom(Eq(ELevel(l), opened(scope, value)))), outs := List(for o in scope.outs if o != l yield o), List())

    case UnsupportedTerm(what, pos) =>
      (scope, List(Gap(pos, "Unsupported", what ++ " is not supported yet", None)))
  end

// the statement of the lemma that a call names: the contract of a procedure, which the proof of a claim assumes at every
// call, also of the procedure itself, since a claim is about the runs that end, which call it only finitely often, one
// proven before, or the lemma itself at a recursive field of its induction, as its hypothesis
function called(w: Walk, scope: Scope, name: Name, args: List[Term]): Option[Seq] :=
  if get(name, w.contracts) != None then
    get(name, w.contracts)
  else if name == w.target.name then
    match scope.around
      case Some(around) if args != List() and exists(around.values, lambda v => is_same(w, scope, at(around.formal, from_list(args)), v)) =>
        Some(w.target.goal)
      case _ =>
        None
    end
  else
    match List(for l in w.proven if l.name == name yield l.goal)
      case List(goal; _) =>
        Some(goal)
      case List() =>
        None
    end

// whether the facts give a == b
function is_same(w: Walk, scope: Scope, a: Term, b: Term): Bool :=
  a == b or closing(w, scope, Eq(a, b), Pos(0, 0)) == List()

function call_gap(w: Walk, name: Name): Str :=
  if name == w.target.name then
    "the lemma calls itself only at a recursive field of the case of its induction"
  else
    "the lemma " ++ name.base ++ " is not proven before this one"

// no gap if c follows, without the lemmas proven before or with them as facts, since facts also change normal forms,
// else the goal simplified at pos
function closing(w: Walk, scope: Scope, c: Term, pos: Pos): List[Gap] :=
  let goal := sequent(scope, c) in
  let facts := List(for l in w.proven yield l.goal) in
  let alone := simplify(w.decls, goal) in
  if alone == true_seq() or simplify(w.decls, with_facts(goal, facts)) == true_seq() then
    List()
  else
    List(
      Gap(pos, "OpenGoal", "the goal stays open", Some(print_seq(printable(w.decls, for_printing(w.decls, goal, alone))))))

// the goal c under the facts of the scope, closed over its variables, where the outs that are not assigned are existential
function sequent(scope: Scope, c: Term): Seq :=
  let fixed := List(for l in range(0, size(scope.vars)) if not contains(l, scope.outs) yield l) in
  let names := from_list(scope.vars) in
  Seq(List(for l in fixed yield at(l, names)), List(for f in scope.facts yield rebind_seq(Close(fixed), 0, f)), List(
    Concl(List(for l in scope.outs yield at(l, names)), List(Atom(rebind(Close(fixed ++ scope.outs), 0, c))))))

function with_facts(goal: Seq, facts: List[Seq]): Seq :=
  match goal
    case Seq(fixed, assms, concls) =>
      Seq(fixed, facts ++ assms, concls)
    case Atom(_) =>
      Seq(List(), facts, List(Concl(List(), List(goal))))
  end

function split_gaps(w: Walk, scope: Scope, split: SplitTerm): List[Gap] :=
  match split
    case InductionTerm(p, cases, pos) =>
      match at(p, from_list(scope.vars)).typ
        case u if u == TInt() =>
          int_gaps(w, scope, cases, p, pos)

        // a type without constructors has no cases, which would prove the lemma vacuously
        case TSort(t, _) if value_or(get(t, w.decls.datatypes), List()) != List() =>
          leaves_gaps(w, scope, cases, ELevel(p), Some((p, t)), pos)

        case _ =>
          List(
            Gap(pos, "Unsupported", "induction on a formal that is not of a datatype with constructors or Int", None))
      end

    case MatchTerm(arg, cases, pos) =>
      leaves_gaps(w, scope, cases, opened(scope, arg), None, pos)

    case IfTerm(cond, left, right, pos) =>
      let c := opened(scope, cond) in
      let yes := scope with facts := scope.facts ++ List(Atom(c)) in
      let no := scope with facts := scope.facts ++ List(Seq(List(), List(Atom(c)), List())) in
      block_gaps(w, yes, left) ++ block_gaps(w, no, value_or(right, ProofTerm(List(), None, pos)))

    case InvariantTerm(vars, havoc, inv, cond, body, after, pos) =>
      invariant_gaps(w, scope, vars, havoc, inv, cond, body, after, pos)
  end

// the loop with the invariant inv: inv holds at the values of vars before the loop; from new values havoc of the
// variables that it assigns, where inv and cond hold, the body leads to values that the body proof assigns to the
// witnesses (next)x, at which inv holds; and the proof after continues at havoc from inv and not cond
function invariant_gaps(w: Walk, scope: Scope, vars: List[Int], havoc: List[Var], inv: Term, cond: Term, body: ProofTerm, after: ProofTerm, pos: Pos): List[Gap] :=
  let around := List(for l in reverse(scope.env) yield ELevel(l)) in
  let before := List(for i in vars yield ELevel(at(i, from_list(scope.env)))) in
  let k := size(scope.vars), n := size(havoc) in
  let fresh := List(for l in range(k, k + n) yield ELevel(l)), next := List(for l in range(k + n, k + 2 * n) yield ELevel(l)) in
  let holds := Atom(beta(around ++ fresh, inv)), guard := beta(around ++ fresh, cond) in
  let loop := scope with vars := scope.vars ++ havoc, env := reverse(range(k, k + n)) ++ scope.env in
  let step := loop with vars := loop.vars ++ List(for x in havoc yield x with name := Name(None, "(next)" ++ x.name.base)), env := reverse(range(k + n, k + 2 * n)) ++ loop.env, facts := scope.facts ++ List(holds, Atom(guard)), goal := beta(around ++ next, inv), outs := range(k + n, k + 2 * n), around := None in
  let exit := loop with facts := scope.facts ++ List(holds, Seq(List(), List(Atom(guard)), List())) in
  closing(w, scope, beta(around ++ before, inv), pos) ++ block_gaps(w, step, body) ++ block_gaps(w, exit, after)

// the cases of the value by the leaves of the patterns of the cases (ulang/prove/patterns.u), and for induction on the
// formal at the position p of the datatype t by its constructors, with the hypotheses for their recursive fields
function leaves_gaps(w: Walk, scope: Scope, cases: List[CaseTerm], value: Term, on_formal: Option[Int * Name], pos: Pos): List[Gap] :=
  let rows := List(for c in cases yield (c.pat, c.guard != None)) in
  let ls := leaves(w.decls, value, size(scope.vars), rows, map_option(on_formal, lambda (_, t) => t)) in
  List(for leaf in ls for g in leaf_gaps(w, scope, cases, value, on_formal, leaf, pos) yield g)

// a leaf with its variables, the equation of the value with it, its conditions, and the hypotheses of an induction for
// the recursive fields of its constructor, which a call of the lemma itself reaches at their values
function leaf_gaps(w: Walk, scope: Scope, cases: List[CaseTerm], value: Term, on_formal: Option[Int * Name], leaf: Leaf, pos: Pos): List[Gap] :=
  let size_after := size(scope.vars) + size(leaf.vars) in
  let recursive := match (on_formal, leaf.value)
    case (Some((_, t)), EApp(EFun(c), args)) =>
      List(for d in get(c, w.decls.constrs) for (arg, field) in zip(args, d.fields) if is_recursive_field(t, field) yield arg)
    case _ =>
      List()
  end in
  let hypotheses := match on_formal
    case Some((p, _)) =>
      List(for y in recursive yield hypothesis(w.target.goal, size_after, p, y))
    case None =>
      List()
  end in
  let equation := if leaf.value == value then List() else List(Atom(Eq(value, leaf.value))) in
  let facts := scope.facts ++ equation ++ List(for c in leaf.conds yield Atom(c)) ++ hypotheses in
  let inner := scope with vars := scope.vars ++ leaf.vars, facts := facts, around := map_option(on_formal, lambda (p, _) => Around(p, recursive)) in
  hits_gaps(w, inner, cases, leaf.hits, pos)

// the cases that match a leaf, in their order, each with the values of its variables, where a guard is a fact of its case
// and its negation one of the cases after it; a leaf that no case covers must close
function hits_gaps(w: Walk, scope: Scope, cases: List[CaseTerm], hits: List[Hit], pos: Pos): List[Gap] :=
  match hits
    case List() =>
      closing(w, scope, scope.goal, pos)

    case List(hit; rest) =>
      let c := at(hit.row, from_list(cases)) in
      let row := bound(scope, c.vars, hit.bindings) in
      match c.guard
        case Some(g) =>
          let guard := beta(List(for l in reverse(scope.env) yield ELevel(l)) ++ hit.bindings, g) in
          block_gaps(w, row with facts := row.facts ++ List(Atom(guard)), c.proof) ++ hits_gaps(w, scope with facts := scope.facts ++ List(Seq(List(), List(Atom(guard)), List())), cases, rest, pos)

        case None =>
          block_gaps(w, row, c.proof)
      end
  end

// the scope with the variables of a case at their values, a level where the value is one, else a new variable equal to it
function bound(scope: Scope, vars: List[Var], values: List[Term]): Scope :=
  match (vars, values)
    case (List(_; xs), List(ELevel(l); rest)) =>
      bound(scope with env := List(l; scope.env), xs, rest)

    case (List(x; xs), List(v; rest)) =>
      let k := size(scope.vars) in
      bound(scope with vars := scope.vars ++ List(x), env := List(k; scope.env), facts := scope.facts ++ List(Atom(Eq(ELevel(k), v))), xs, rest)

    case _ =>
      scope
  end

// induction on the integer formal at the position p: the case n < 0, which must close, the case 0, written as case 0
// or else closing, and the case n > 0, with the hypothesis for n - 1, written as a catch-all, whose variable is n; other
// cases are gaps
function int_gaps(w: Walk, scope: Scope, cases: List[CaseTerm], p: Int, pos: Pos): List[Gap] :=
  let n := ELevel(p), zero := ELit(LInt(0)) in
  let below := closing(w, scope with facts := scope.facts ++ List(Atom(Less(n, zero))), scope.goal, pos) in
  let base := scope with facts := scope.facts ++ List(Atom(Eq(n, zero))) in
  let previous := Minus(n, ELit(LInt(1))) in
  let step := scope with facts := scope.facts ++ List(
    Atom(Less(zero, n)),
    hypothesis(w.target.goal, size(scope.vars), p, previous)), around := Some(Around(p, List(previous))) in
  let at_zero := List(for c in cases if c.guard == None and c.pat == PLit(LInt(0)) yield c) in
  let above := List(for c in cases if is_catch_all(c) yield c) in
  let others := List(for c in cases if not is_catch_all(c) and not (c.guard == None and c.pat == PLit(LInt(0))) yield Gap(c.pos, "Unsupported", "a case of an induction on an integer other than case 0 and a catch-all", None)) in
  others ++ below ++ match at_zero
    case List(c; _) =>
      block_gaps(w, base, c.proof)
    case List() =>
      closing(w, base, base.goal, pos)
  end ++ match above
    case List(c; _) =>
      catch_all_gaps(w, step, c, n)
    case List() =>
      closing(w, step, step.goal, pos)
  end

function is_catch_all(c: CaseTerm): Bool :=
  c.guard == None and match c.pat
    case PVar(_) =>
      true

    case PWild =>
      true

    case _ =>
      false
  end

// a catch-all case for the value, whose variable, if it has one, is the value
function catch_all_gaps(w: Walk, scope: Scope, case_term: CaseTerm, value: Term): List[Gap] :=
  match case_term.vars
    case List(x) =>
      let k := size(scope.vars) in
      block_gaps(w, scope with vars := scope.vars ++ List(x), env := List(k; scope.env), facts := scope.facts ++ List(Atom(Eq(ELevel(k), value))), case_term.proof)

    case _ =>
      block_gaps(w, scope, case_term.proof)
  end

function is_recursive_field(t: Name, field: Var): Bool :=
  match field.typ
    case TSort(name, _) =>
      name == t
    case _ =>
      false
  end

// the statement of the lemma for the field y in place of its formal at the position p, for all values of the other
// formals, whose levels from base on are bound again as the variables of the hypothesis
function hypothesis(goal: Seq, base: Int, p: Int, y: Term): Seq :=
  match goal
    case Seq(formals, atoms, List(Concl(outs, List(Atom(concl))))) =>
      let n := size(formals), m := size(outs) in
      let levels := List(for i in range(0, n + m) yield ELevel(base + i)) in
      let others := List(for i in range(0, n) if i != p yield base + i) in
      let instance := lambda t => replace(ELevel(base + p), y, beta(levels, t)) in
      let assms := List(for a in atoms for t in atom_term(a) yield Atom(rebind(Close(others), 0, instance(t)))) in
      let conclusion := rebind(Close(others ++ range(base + n, base + n + m)), 0, instance(concl)) in
      Seq(List(for (x, i) in zip(formals, range(0, n)) if i != p yield x), assms, List(Concl(outs, List(Atom(conclusion)))))

    case _ =>
      goal
  end
