// the equations of a definition, one per case of its outer matches and conditionals, as Isabelle's function package
// makes them, so that a recursive function rewrites where the class of its argument has a constructor, see ideas/prove.md,
// section 6
//
// The walk keeps the variables of the equation as levels, the formals first, so that the value of a leaf replaces the
// variable that a match takes apart by plain replace, and closes them at the end. A match on a variable, or on a tuple of
// distinct variables, gives one equation per leaf of the patterns of its cases (ulang/prove/patterns.u) and per case
// that matches the leaf, whose guard is a condition, negated in the cases after it; an if gives its condition and its
// negation; anything else ends the walk.

import "ulang/syntax"

export

function def_equations(decls: Decls, formals: List[Var], body: Term): List[DefEquation]

implementation

// an equation being refined, over the levels below the size of vars
data Partial :=
  case Partial(vars: List[Var], conds: List[Term], args: List[Term], body: Term)

function def_equations(decls: Decls, formals: List[Var], body: Term): List[DefEquation] :=
  let levels := List(for i in range(0, size(formals)) yield ELevel(i)) in
  walk(decls, Partial(formals, List(), levels, beta(levels, body)))

function walk(decls: Decls, p: Partial): List[DefEquation] :=
  match p.body
    case EIte(cond, then_expr, else_expr) =>
      walk(decls, p with conds := p.conds ++ List(cond), body := then_expr) ++ walk(decls, p with conds := p.conds ++ List(Not(cond)), body := else_expr)

    case EMatch(arg, cases) =>
      match matched_levels(p, arg)
        case Some(levels) =>
          let rows := List(for br in cases yield (br.pat, br.guard != None)) in
          List(for leaf in leaves(decls, arg, size(p.vars), rows, None) for eq in leaf_equations(decls, p, levels, cases, leaf) yield eq)

        case None =>
          List(closed(p, true))
      end

    case _ =>
      List(closed(p, false))
  end

function closed(p: Partial, decided: Bool): DefEquation :=
  let op := Close(range(0, size(p.vars))) in
  DefEquation(p.vars, List(for c in p.conds yield rebind(op, 0, c)), List(for a in p.args yield rebind(op, 0, a)), rebind(op, 0, p.body), decided)

// the variables that a match takes apart: one, or the distinct components of a tuple
function matched_levels(p: Partial, arg: Term): Option[List[Int]] :=
  match arg
    case ELevel(level) if level < size(p.vars) =>
      Some(List(level))

    case EApp(EFun(name), args) if name == tuple_name(size(args)) =>
      let levels := List(for a in args for l in level_of(a) if l < size(p.vars) yield l) in
      if size(levels) == size(args) and size(Set(for l in levels)) == size(levels) then
        Some(levels)
      else
        None

    case _ =>
      None
  end

function level_of(t: Term): Option[Int] :=
  match t
    case ELevel(level) =>
      Some(level)
    case _ =>
      None
  end

// the values of the matched variables at the leaf: its value for one variable, the components of a tuple for several,
// or the variables themselves where the leaf leaves the tuple whole
function leaf_values(levels: List[Int], value: Term): List[Int * Term] :=
  match (levels, value)
    case (List(l), _) =>
      List((l, value))

    case (_, EApp(EFun(name), args)) if name == tuple_name(size(args)) and size(args) == size(levels) =>
      zip(levels, args)

    case _ =>
      List()
  end

function at_leaf(values: List[Int * Term], t: Term): Term :=
  foldl(values, t, lambda acc, (l, v) => replace(ELevel(l), v, acc))

// the equations of the cases that match the leaf, in their order, whose variables follow those of p
function leaf_equations(decls: Decls, p: Partial, levels: List[Int], cases: List[TermBranch], leaf: Leaf): List[DefEquation] :=
  let values := leaf_values(levels, leaf.value) in
  let q := Partial(p.vars ++ leaf.vars, List(for c in p.conds yield at_leaf(values, c)) ++ leaf.conds, List(for a in p.args yield at_leaf(values, a)), p.body) in
  hits_equations(decls, q, values, cases, leaf.hits)

function hits_equations(decls: Decls, q: Partial, values: List[Int * Term], cases: List[TermBranch], hits: List[Hit]): List[DefEquation] :=
  match hits
    case List() =>
      List()

    case List(hit; rest) =>
      let br := at(hit.row, from_list(cases)) in
      let body := at_leaf(values, beta(hit.bindings, br.body)) in
      match br.guard
        case Some(g) =>
          let guard := at_leaf(values, beta(hit.bindings, g)) in
          walk(decls, q with conds := q.conds ++ List(guard), body := body) ++ hits_equations(decls, q with conds := q.conds ++ List(Not(guard)), values, cases, rest)

        case None =>
          walk(decls, q with body := body)
      end
  end

// take, match xs case Nil => Nil case Cons(y, ys) => if n <= 0 then Nil else Cons(y, take(n - 1, ys)), where ys is
// the index 0, y 1, xs 2, and n 3 in the second case
test take_equations() :=
  local list := Name(Some("prelude/list"), "List"), nil := Name(Some("prelude/list"), "Nil"), cons := Name(Some("prelude/list"), "Cons"), take := Name(Some("prelude/list"), "take"), le := Name(Some("prelude/prelude"), "<="), var := (lambda base => Var(Name(None, base), THole)), decls := (empty_decls() with constrs := Map(
    nil => ConstrDecl(list, List()),
    cons => ConstrDecl(list, List(var("head"), var("tail")))), datatypes := Map(list => List(nil, cons))), pvar := (lambda base => AOk(Pos(0, 0), PVar(var(base)))), step := EApp(EFun(cons), List(
    EBound(1),
    EApp(EFun(take), List(Minus(EBound(3), ELit(LInt(1))), EBound(0))))), body := EMatch(EBound(0), List(
    TermBranch(PApp(nil, List()), None, EFun(nil)),
    TermBranch(PApp(cons, List(pvar("y"), pvar("ys"))), None, EIte(EApp(EFun(le), List(EBound(3), ELit(LInt(0)))), EFun(nil), step)))), eqs := def_equations(decls, List(var("n"), var("xs")), body)
  assert size(eqs) == 3 and forall(eqs, lambda eq => not eq.decided)
  match eqs
    case List(empty, short, long) =>
      assert empty.args == List(EBound(1), EFun(nil)) and empty.conds == List() and empty.rhs == EFun(nil)
      assert short.args == List(EBound(3), EApp(EFun(cons), List(EBound(1), EBound(0))))
      assert short.conds == List(EApp(EFun(le), List(EBound(3), ELit(LInt(0))))) and short.rhs == EFun(nil)
      assert long.conds == List(Not(EApp(EFun(le), List(EBound(3), ELit(LInt(0))))))
      assert long.rhs == EApp(EFun(cons), List(
        EBound(1),
        EApp(EFun(take), List(Minus(EBound(3), ELit(LInt(1))), EBound(0)))))

    case _ =>
      assert false
  end

// match xs case Cons(y, _) if p(y) => 1 case _ => 2, where y is the index 0 in the first case: the catch-all at Nil,
// then at Cons the guarded case and the catch-all with the negated guard, over the variables xs, y, and tail
test completed_equations() :=
  local list := Name(Some("prelude/list"), "List"), nil := Name(Some("prelude/list"), "Nil"), cons := Name(Some("prelude/list"), "Cons"), p := Name(None, "p"), var := (lambda base => Var(Name(None, base), THole)), decls := (empty_decls() with constrs := Map(
    nil => ConstrDecl(list, List()),
    cons => ConstrDecl(list, List(var("head"), var("tail")))), datatypes := Map(list => List(nil, cons))), guarded := TermBranch(PApp(cons, List(AOk(Pos(0, 0), PVar(var("y"))), AOk(Pos(0, 0), PWild))), Some(EApp(EFun(p), List(EBound(0)))), ELit(LInt(1))), eqs := def_equations(decls, List(var("xs")), EMatch(EBound(0), List(guarded, TermBranch(PWild, None, ELit(LInt(2))))))
  assert size(eqs) == 3
  match eqs
    case List(at_nil, first, at_cons) =>
      assert first.args == List(EApp(EFun(cons), List(EBound(1), EBound(0)))) and first.conds == List(EApp(EFun(p), List(EBound(1))))
      assert at_nil.args == List(EFun(nil)) and at_nil.conds == List() and at_nil.rhs == ELit(LInt(2))
      assert at_cons.conds == List(Not(EApp(EFun(p), List(EBound(1))))) and at_cons.rhs == ELit(LInt(2))

    case _ =>
      assert false
  end

// match (xs, n) case (Nil, _) => 0 case (Cons(_, t), m) => m: an equation per leaf, where the components of the tuple
// replace both formals, the second one by a new variable, in the second equation head, t, and m, of which m is the index 0
test tuple_equations() :=
  local list := Name(Some("prelude/list"), "List"), nil := Name(Some("prelude/list"), "Nil"), cons := Name(Some("prelude/list"), "Cons"), var := (lambda base => Var(Name(None, base), THole)), pat := (lambda p => AOk(Pos(0, 0), p)), decls := (empty_decls() with constrs := Map(
    nil => ConstrDecl(list, List()),
    cons => ConstrDecl(list, List(var("head"), var("tail")))), datatypes := Map(list => List(nil, cons))), empty := TermBranch(PTuple(List(pat(PApp(nil, List())), pat(PWild))), None, ELit(LInt(0))), nonempty := TermBranch(PTuple(List(
    pat(PApp(cons, List(pat(PWild), pat(PVar(var("t")))))),
    pat(PVar(var("m"))))), None, EBound(0)), eqs := def_equations(decls, List(var("xs"), var("n")), EMatch(EApp(EFun(tuple_name(2)), List(EBound(1), EBound(0))), List(empty, nonempty)))
  match eqs
    case List(at_nil, at_cons) =>
      assert at_nil.args == List(EFun(nil), EBound(0)) and at_nil.rhs == ELit(LInt(0))
      assert at_cons.args == List(EApp(EFun(cons), List(EBound(2), EBound(1))), EBound(0)) and at_cons.rhs == EBound(0)

    case _ =>
      assert false
  end
