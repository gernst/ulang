// a compiler from programs of ulang/syntax/syntax.u, which ulang/check/check.u has checked, to C in the syntax of ulang/compile/c.u,
// whose code calls the runtime in ulang/runtime, where every value has the C type u_value

import "ulang/syntax"
import "ulang/format"
import "ulang/parse"
import "ulang/check"

export

// what the function main of the C runs
data Entry :=
  // a procedure of the main module without parameters
  case EntryProc(proc: Id)
  // the tests of the files, in their order, which main selects by its arguments, as ulang test does, see u_run_tests of
  // ulang/runtime/ulang.c
  case EntryTests(files: List[TestFile])

// a file of tests: its path, as the arguments of the compiled program name it, and its module
data TestFile :=
  case TestFile(path: Str, module: Id)

procedure compile_file(
  in  source: Str,
      entry: Entry,
      target: Str
) raises ParseError, TypeError, EntryError, InternalError, OsError

// compile_file of the checked program q, whose entry is a procedure of its main module or the tests of its files
procedure compile_prog(
  in  q: Prog,
      entry: Entry,
      target: Str
) raises EntryError, InternalError, OsError

implementation

// the variables in scope with the C expressions they are accessed through
type Vars :=
  List[Name * CExpr]

data Gen :=
  case Gen(count: Int, lifted: List[CDecl])

function value_type(): CType :=
  CtNamed("u_value")

function value_ptr(): CType :=
  CtPtr(CtNamed("u_value"))

function var_name(n: Name): Str :=
  "v_" ++ mangle(n)

function ref_name(n: Name): Str :=
  "r_" ++ mangle(n)

// the descriptor of constructor n, which the runtime compares by its address
function descriptor(n: Name): CExpr :=
  CeUnary("&", CeVar(descriptor_name(n)))

// the shared value of constructor n without arguments
function unit_value(n: Name): CExpr :=
  CeUnary("&", CeVar("o_" ++ mangle(n)))

function linkage_of(t: Name): Linkage :=
  if contains(t, runtime_referenced()) then LkExtern else LkStatic

// the descriptor of constructor n at position i of its declaration, of datatype t
function descriptor_decl(n: Name, i: Int, t: Name): CDecl :=
  CdGlobal(linkage_of(t), CtNamed("const struct u_name"), descriptor_name(n), Some(CeInit(descriptor_fields(n, i, t))))

function descriptor_fields(n: Name, i: Int, t: Name): List[CExpr] :=
  match n
    case Name(Some(m), base) =>
      List(CeStr(m), CeStr(base), CeNum(i), CeUnary("&", CeVar(type_name(t))))

    case Name(None, base) =>
      List(
        CeVar("NULL"),
        CeStr(base),
        CeNum(i),
        CeUnary("&", CeVar(type_name(t))))
  end

// the shared value of constructor n without arguments, of datatype t
function unit_decl(n: Name, t: Name): CDecl :=
  CdGlobal(linkage_of(t), CtNamed("struct u_object"), "o_" ++ mangle(n), Some(unit_init(n, t)))

function unit_init(n: Name, t: Name): CExpr :=
  c_call("U_UNIT", List(CeVar(descriptor_name(n)), CeVar(type_name(t))))

// the descriptors of the datatypes of cs and their constructors that the runtime does not define, and the values of
// the constructors without arguments, where the descriptor of a datatype points to the functions compare, ==, and show
// that its module declares, and otherwise to the structural ones of the runtime
function descriptor_decls(defs: Defs, cmds: List[Cmd]): List[CDecl] :=
  data_decls(cmds, defs) ++ field_table_decls(defs)

function field_table_decls(defs: Defs): List[CDecl] :=
  List(for key => ps in defs.fields for d in field_decls(key, ps) yield d)

// the positions of the field of an accessor T.f in each constructor of T, by their index of struct u_name, and the
// name T.f, which MissingField carries, both shared by the updater T.f:=
function field_decls(key: Name * Int, ps: List[Int]): List[CDecl] :=
  match key
    case (n, 1) =>
      List(table_decl(n, ps), field_text_decl(n))
    case _ =>
      List()
  end

function table_decl(n: Name, ps: List[Int]): CDecl :=
  CdGlobal(LkStatic, CtNamed("const int"), table_name(n) ++ "[]", Some(CeInit(List(for p in ps yield CeNum(p)))))

function field_text_decl(n: Name): CDecl :=
  CdGlobal(LkStatic, CtNamed("struct u_object"), field_text_name(n), Some(c_call("U_LIT", List(CeStr(field_of(n))))))

// the field of the accessor or the updater n of the value of a, where y is the new value of an updater, directly if the
// field has the same position in every constructor, and else by the table of its positions
function field_call(n: Name, ps: List[Int], rs: List[CExpr]): CExpr :=
  match (rs, distinct(ps))
    case (List(a), List(p)) if p >= 0 =>
      c_call("u_field", List(a, CeNum(p)))

    case (List(a, y), _) =>
      c_call("u_update", List(a, CeVar(table_name(n)), CeUnary("&", CeVar(field_text_name(n))), y))

    // an accessor, of one argument
    case _ =>
      c_call("u_select", rs ++ List(CeVar(table_name(n)), CeUnary("&", CeVar(field_text_name(n)))))
  end

function data_decls(cmds: List[Cmd], defs: Defs): List[CDecl] :=
  match cmds
    case List() =>
      List()

    case List(CData(name, _, constrs); rest) =>
      type_decls(name, defs) ++ constructor_decls(name, parts(constrs), 0) ++ data_decls(rest, defs)

    case List(_; rest) =>
      data_decls(rest, defs)
  end

function type_decls(t: Name, defs: Defs): List[CDecl] :=
  if contains(t, runtime_types()) then List() else List(type_decl(t, defs))

function type_decl(t: Name, defs: Defs): CDecl :=
  CdGlobal(linkage_of(t), CtNamed("const struct u_type"), type_name(t), Some(type_init(t, defs)))

function type_init(t: Name, defs: Defs): CExpr :=
  CeInit(List(
    CeStr(c_text(t)),
    compare_ref(t, defs),
    equals_ref(t, defs),
    show_ref(t, defs)))

function compare_ref(t: Name, defs: Defs): CExpr :=
  CeVar(compare_symbol(t, defs))

function equals_ref(t: Name, defs: Defs): CExpr :=
  CeVar(equals_symbol(t, defs))

function show_ref(t: Name, defs: Defs): CExpr :=
  CeVar(symbol_of_show(t, defs))

function constructor_decls(t: Name, ks: List[Constr], i: Int): List[CDecl] :=
  match ks
    case List() =>
      List()

    case List(k; rest) if contains(k.name, runtime_constructors()) =>
      constructor_decls(t, rest, i + 1)

    case List(Constr(name, List()); rest) =>
      List(
        descriptor_decl(name, i, t),
        unit_decl(name, t); constructor_decls(t, rest, i + 1))

    case List(Constr(name, _); rest) =>
      List(descriptor_decl(name, i, t); constructor_decls(t, rest, i + 1))
  end

function in_scope(xs: List[Name]): Vars :=
  List(for x in xs yield (x, CeVar(var_name(x))))

function var_expr(env: Vars, x: Name): CExpr :=
  match get(x, env)
    case Some(c) =>
      c
    case _ =>
      CeVar(var_name(x))
  end

function address(c: CExpr): CExpr :=
  CeUnary("&", c)

// outs and refs are locals of a procedure, which start as NULL and as the value of the caller, and which go back to the caller
// only when it returns, so that an exception leaves the variables of the caller as they were
function copy_in(outs: List[Var], refs: List[Var]): List[CStmt] :=
  List(for x in var_names(outs) yield declare_null(x)) ++ List(for x in var_names(refs) yield declare_from_ref(x))

function declare_null(x: Name): CStmt :=
  CsDecl(value_type(), var_name(x), Some(CeVar("NULL")))

function declare_from_ref(x: Name): CStmt :=
  CsDecl(value_type(), var_name(x), Some(CeUnary("*", CeVar(ref_name(x)))))

function copy_out(xs: List[Var]): List[CStmt] :=
  List(for x in var_names(xs) yield CsAssign(CeUnary("*", CeVar(ref_name(x))), CeVar(var_name(x))))

function index(a: Str, i: Int): CExpr :=
  CeIndex(CeVar(a), CeNum(i))

function field(v: CExpr, i: Int): CExpr :=
  c_call("u_field", List(v, CeNum(i)))

function truth(v: CExpr): CExpr :=
  c_call("u_truth", List(v))

function conjunction(cs: List[CExpr]): CExpr :=
  match cs
    case List() =>
      CeNum(1)

    case List(d) =>
      d

    case List(d; rest) =>
      CeBinary("&&", d, conjunction(rest))
  end

function int_value(num: Int): CExpr :=
  if is_small(num) then
    c_call("u_mk_int", List(CeNum(num)))
  else
    c_call("u_mk_int_str", List(CeStr(show(num))))

function literal_value(l: Lit): CExpr :=
  match l
    case LUnit =>
      c_call("u_mk_tuple", List(CeNum(0)))

    case LBool(bool) =>
      c_call("u_mk_bool", List(CeNum(if bool then 1 else 0)))

    case LInt(num) =>
      int_value(num)

    // check translates hexadecimal numbers to LInt, and a function cannot raise Unexpected
    case LHex(num) =>
      int_value(num)

    case LStr(text) =>
      c_call("u_mk_lit", List(CeStr(text)))

    case LChar(char) =>
      c_call("u_mk_char", List(CeNum(int(char))))
  end

// the tests that v matches pat, in an order that checks a constructor before its fields
function pattern_tests(pat: Pat, v: CExpr): List[CExpr] :=
  match pat
    case PLit(lit) =>
      List(c_call("u_equals", List(v, literal_value(lit))))

    case PApp(constr, args) =>
      List(c_call("u_is_con", List(v, descriptor(constr)))) ++ field_tests(numbered(args), v)

    case PTuple(args) =>
      field_tests(numbered(args), v)

    case _ =>
      List()
  end

function field_tests(ps: List[At[Pat] * Int], v: CExpr): List[CExpr] :=
  List(for (p, i) in ps for t in pattern_tests(p.that, field(v, i)) yield t)

// the declarations of the variables of pat, where v matches pat
function pattern_binds(pat: Pat, v: CExpr): List[CStmt] :=
  match pat
    case PName(name, _) =>
      List(CsDecl(value_type(), var_name(name), Some(v)))

    case PApp(_, args) =>
      field_binds(numbered(args), v)

    case PTuple(args) =>
      field_binds(numbered(args), v)

    case _ =>
      List()
  end

function field_binds(ps: List[At[Pat] * Int], v: CExpr): List[CStmt] :=
  List(for (p, i) in ps for b in pattern_binds(p.that, field(v, i)) yield b)

procedure gen_name(in stem: Str, out x: Str, ref g: Gen) :=
  assign x := stem ++ show(g.count), g := g with count := g.count + 1

procedure lift(in d: CDecl, ref g: Gen) :=
  assign g := g with lifted := g.lifted ++ List(d)

// a function, constructor, or builtin of name n with type t as a value, which is a closure of its wrapper
function global_value(defs: Defs, n: Name, t: Type): CExpr :=
  if is_global_fun(defs, n, arity(t)) then
    closure("w_" ++ fun_name(n, arity(t)))
  else
    other_global(defs, n)

function closure(w: Str): CExpr :=
  c_call("u_mk_closure", List(CeVar(w), CeNum(0)))

function other_global(defs: Defs, n: Name): CExpr :=
  match fields_count(defs, n)
    case Some(0) =>
      unit_value(n)

    case Some(_) =>
      closure("wc_" ++ mangle(n))

    case None =>
      builtin_global(defs, n)
  end

function builtin_global(defs: Defs, n: Name): CExpr :=
  match get(n, builtin_functions())
    case Some((f, _)) =>
      closure("w" ++ f)

    // a procedure, since the checker resolves every other name
    case None =>
      c_call("u_mk_proc", List(CeVar("wp_" ++ mangle(n)), CeNum(0)))
  end

function declare_none(x: Str): CStmt :=
  CsDecl(value_type(), x, None)

function static_literal(x: Str, text: Str): CStmt :=
  CsDecl(CtNamed("static struct u_object"), x, Some(c_call("U_LIT", List(CeStr(text)))))

// the statements that compute expr in a scope with the local variables env, and its value r
procedure compile_expr(
  in  defs: Defs,
      env: Vars,
      expr: At[Expr],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  match expr.that
    case ELit(LStr(text)) =>
      local t: Str
      call   gen_name(in "l_" ++ mangle(unqualified(prefix_of(text))) ++ "_", out t, ref g)
      assign ss := List(static_literal(t, text)), r := CeUnary("&", CeVar(t))

    case ELit(lit) =>
      assign ss := List(), r := literal_value(lit)

    case EName(name, typ) =>
      match get(name, env)
        case Some(c) =>
          assign ss := List(), r := c
        case None =>
          assign ss := List(), r := global_value(defs, name, typ)
      end

    case ECall(_, _, name, typ, args) if get(name, env) == None =>
      match fusion_of(name, args)
        case Some(FusedArray((gs, q, e))) =>
          call compile_array_comprehension(in defs, env, gs, q, e, out ss, r, ref g)

        case Some(FusedLiteral(es)) =>
          local rs: List[CExpr]
          call   compile_exprs(in defs, env, es, out ss, rs, ref g)
          assign r := c_call("u_mk_array", List(CeNum(size(rs))) ++ rs)

        // [e for x in c, y in d if q] over lists and arrays, nested folds into which comprehensions translate, are nested
        // loops that build the list in order
        case Some(FusedList((gs, q, e), init)) =>
          call compile_list_comprehension(in defs, env, gs, q, e, init, out ss, r, ref g)

        case None =>
          call compile_named(in defs, env, name, typ, args, out ss, r, ref g)
      end

    case EField(_, field) =>
      raise UnresolvedField(field)

    case EUpdate(_, field, _) =>
      raise UnresolvedField(field)

    case EForm(form, _, _) =>
      raise UntranslatedForm(form_name(form))

    case EFor(form, _, _, _) =>
      raise UntranslatedForm(form_name(form))

    case EApp(fun, args) =>
      local as: List[CStmt], bs: List[CStmt], ra: CExpr, rs: List[CExpr]
      call   compile_expr(in defs, env, fun, out as, ra, ref g)
      call   compile_exprs(in defs, env, args, out bs, rs, ref g)
      assign ss := as ++ bs, r := c_call("u_apply", List(ra, CeNum(size(args))) ++ rs)

    // the checker makes the formals variables
    case ELam(formals, body) =>
      match pattern_vars(formals)
        case Some(xs) =>
          call compile_lambda(in defs, env, xs, body, out ss, r, ref g)
        case None =>
          raise Unexpected("lambda of patterns")
      end

    case EProc(ins, outs, refs, _, stmt) =>
      call compile_proc_lambda(in defs, env, vars(ins), vars(outs), vars(refs), stmt, out ss, r, ref g)

    case ELet(bindings, body) =>
      local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], rb: CExpr, rs: List[CExpr], t: Str, names := bound_by(firsts(bindings))
      call   compile_exprs(in defs, env, seconds(bindings), out as, rs, ref g)
      call   compile_expr(in defs, in_scope(names) ++ env, body, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      call   temps(in rs, out cs, ref g)
      assign ss := as ++ cs ++ List(
        declare_none(t),
        CsBlock(let_binds(firsts(bindings), cs) ++ bs ++ List(set_var(t, rb))))
      assign r := CeVar(t)

    case EIte(cond, then_expr, else_expr) =>
      local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], ra: CExpr, rb: CExpr, rc: CExpr, t: Str
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_expr(in defs, env, then_expr, out as, ra, ref g)
      call   compile_expr(in defs, env, else_expr, out bs, rb, ref g)
      call   gen_name(in "t", out t, ref g)
      assign ss := cs ++ List(
        declare_none(t),
        CsIf(truth(rc), as ++ List(set_var(t, ra)), bs ++ List(set_var(t, rb))))
      assign r := CeVar(t)

    case EMatch(arg, cases) =>
      local as: List[CStmt], bs: List[CStmt], ra: CExpr, t: Str, d: Str
      call   compile_expr(in defs, env, arg, out as, ra, ref g)
      call   gen_name(in "s", out d, ref g)
      call   gen_name(in "t", out t, ref g)
      call   expr_cases(in defs, env, cases, CeVar(d), t, out bs, ref g)
      assign ss := as ++ List(
        CsDecl(value_type(), d, Some(ra)),
        CsDecl(value_type(), t, Some(CeVar("NULL")))) ++ bs
      assign ss := ss ++ List(
        CsIf(CeUnary("!", CeVar(t)), List(CsExpr(c_call("u_no_case", List(CeVar(d))))), List()))
      assign r := CeVar(t)

    case ETuple(args) =>
      local rs: List[CExpr]
      call   compile_exprs(in defs, env, args, out ss, rs, ref g)
      assign r := c_call("u_mk_tuple", List(CeNum(size(args))) ++ rs)
  end

procedure compile_exprs(
  in  defs: Defs,
      env: Vars,
      exprs: List[At[Expr]],
  out ss: List[CStmt],
      rs: List[CExpr],
  ref g: Gen
) :=
  local as: List[CStmt], r: CExpr
  assign ss := List(), rs := List()
  for e in exprs do
    call   compile_expr(in defs, env, e, out as, r, ref g)
    assign ss := ss ++ as, rs := rs ++ List(r)
  end

// the values rs in fresh variables, which later expressions do not change, as declarations
procedure temps(in rs: List[CExpr], out ss: List[CStmt], ref g: Gen) :=
  local t: Str
  assign ss := List()
  for r in rs do
    call   gen_name(in "t", out t, ref g)
    assign ss := ss ++ List(CsDecl(value_type(), t, Some(r)))
  end

// the variables of the patterns of a let, bound to the parts of the temporaries declared by ts, which they match
function let_binds(pats: List[At[Pat]], ts: List[CStmt]): List[CStmt] :=
  match (pats, ts)
    case (List(pat; more), List(CsDecl(_, name, _); rest)) =>
      pattern_binds(pat.that, CeVar(name)) ++ let_binds(more, rest)
    case _ =>
      List()
  end

// applications of functions, constructors, and builtins of their arities are direct calls
procedure compile_named(
  in  defs: Defs,
      env: Vars,
      n: Name,
      ty: Type,
      args: List[At[Expr]],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  match args
    // and, or are not strict
    case List(a, b) if n == unqualified("and") or n == unqualified("or") =>
      local as: List[CStmt], bs: List[CStmt], ra: CExpr, rb: CExpr, t: Str
      call compile_expr(in defs, env, a, out as, ra, ref g)
      call compile_expr(in defs, env, b, out bs, rb, ref g)
      call gen_name(in "t", out t, ref g)
      if n == unqualified("and") then
        assign ss := as ++ List(declare(t, ra), guarded(truth(CeVar(t)), t, bs, rb))
      else
        assign ss := as ++ List(declare(t, ra), guarded(CeUnary("!", truth(CeVar(t))), t, bs, rb))
      end
      assign r := CeVar(t)

    case _ =>
      local rs: List[CExpr]
      call compile_exprs(in defs, env, args, out ss, rs, ref g)
      if is_global_fun(defs, n, size(args)) and arity(ty) == size(args) then
        assign r := c_call(fun_name(n, size(args)), rs)
      else
        if contains((n, size(args)), defs.fields) then
          assign r := field_call(n, positions_of(defs, n, size(args)), rs)
        else
          if fields_count(defs, n) == Some(0) and args == List() then
            assign r := unit_value(n)
          else
            if fields_count(defs, n) == Some(size(args)) then
              assign r := c_call("u_mk_con", List(descriptor(n), CeNum(size(args))) ++ rs)
            else
              match get(n, builtin_functions())
                case Some((b, k)) if k == size(args) =>
                  assign r := c_call(b, rs)
                case _ =>
                  assign r := c_call("u_apply", List(global_value(defs, n, ty), CeNum(size(args))) ++ rs)
              end
            end
          end
        end
      end
  end

// a closure of a function lifted to the top level, which takes the captured values and the arguments
procedure compile_lambda(
  in  defs: Defs,
      env: Vars,
      xs: List[Var],
      b: At[Expr],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local names := var_names(xs), caps := captured(env, free_vars(b, names)), f: Str, bs: List[CStmt], rb: CExpr, decls: List[CStmt]
  call   gen_name(in "lam", out f, ref g)
  call   compile_expr(in defs, in_scope(caps ++ names), b, out bs, rb, ref g)
  assign decls := unpack(numbered(caps), "env") ++ unpack(numbered(names), "args")
  call   lift(in CdFunction(LkStatic, value_type(), f, closure_params(), decls ++ bs ++ List(CsReturn(Some(rb)))), ref g)
  assign ss := List(), r := make_closure("u_mk_closure", f, caps, env)

// a lambda in x, out y, ref z => body end is a lifted function of the captured values, the ins, and pointers to the outs and refs
procedure compile_proc_lambda(
  in  defs: Defs,
      env: Vars,
      ins: List[Var],
      outs: List[Var],
      refs: List[Var],
      stmt: At[Stmt],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local in_names := var_names(ins), pointer_names := var_names(outs ++ refs), caps := captured(env, free_in_stmt(stmt, in_names ++ pointer_names)), f: Str, bs: List[CStmt], decls: List[CStmt]
  call   gen_name(in "proc", out f, ref g)
  call   compile_stmt(in defs, in_scope(caps ++ in_names ++ pointer_names), stmt, out bs, ref g)
  assign decls := unpack(numbered(caps), "env") ++ unpack(numbered(in_names), "ins")
  assign decls := decls ++ unpack_pointers(numbered(pointer_names))
  assign decls := decls ++ copy_in(outs, refs)
  call   lift(in CdFunction(LkStatic, CtVoid, f, proc_params(), decls ++ bs ++ copy_out(outs ++ refs)), ref g)
  assign ss := List(), r := make_closure("u_mk_proc", f, caps, env)

function proc_params(): List[CType * Str] :=
  List((value_ptr(), "env"), (value_ptr(), "ins"), (CtPtr(value_ptr()), "outs"))

function unpack_pointers(xs: List[Name * Int]): List[CStmt] :=
  List(for (x, i) in xs yield CsDecl(value_ptr(), ref_name(x), Some(index("outs", i))))

// declarations of the variables xs with the values in the array a
function unpack(xs: List[Name * Int], a: Str): List[CStmt] :=
  List(for (x, i) in xs yield CsDecl(value_type(), var_name(x), Some(index(a, i))))

// the cases of a match of the value v, which assign the result to t, where t stays NULL if no case applies
procedure expr_cases(
  in  defs: Defs,
      env: Vars,
      cases: List[At[Branch[At[Expr]]]],
      v: CExpr,
      t: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  match cases
    case List() =>
      assign ss := List()

    case List(AOk(_, _, Branch(pat, guard, e)); more) =>
      local bs: List[CStmt], rb: CExpr, body: List[CStmt], rest: List[CStmt], env_: Vars := in_scope(pattern_names(pat)) ++ env
      call   compile_expr(in defs, env_, e, out bs, rb, ref g)
      assign body := bs ++ List(CsAssign(CeVar(t), rb))
      match guard
        case Some(c) =>
          local gs: List[CStmt], rg: CExpr
          call   compile_expr(in defs, env_, c, out gs, rg, ref g)
          assign body := gs ++ List(CsIf(truth(rg), body, List()))

        case None =>
          skip
      end
      call   expr_cases(in defs, env, more, v, t, out rest, ref g)
      assign ss := List(case_if(t, pattern_tests(pat.that, v), pat, v, body)) ++ rest

    // the parser and the checker make no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

// the loops of the generators gs, nested, in a scope with the local variables env, where the innermost adds the element e
// by add if the condition holds, and a list is walked by its cells and an array by its indices
procedure compile_loops(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * At[Expr] * Var],
      cond: Option[At[Expr]],
      e: At[Expr],
      add: CExpr -> List[CStmt],
  out ss: List[CStmt],
  ref g: Gen
) :=
  match gs
    case List() =>
      local es: List[CStmt], re: CExpr
      call   compile_expr(in defs, env, e, out es, re, ref g)
      assign ss := es ++ add(re)
      match cond
        case Some(q) =>
          local cs: List[CStmt], rc: CExpr
          call   compile_expr(in defs, env, q, out cs, rc, ref g)
          assign ss := cs ++ List(CsIf(truth(rc), ss, List()))

        case None =>
          skip
      end

    case List((f, c, x); rest) =>
      local cs: List[CStmt], rc: CExpr, body: List[CStmt], l: Str
      call compile_expr(in defs, env, c, out cs, rc, ref g)
      call compile_loops(in defs, in_scope(List(x.name)) ++ env, rest, cond, e, add, out body, ref g)
      call gen_name(in "l", out l, ref g)
      if f == list_foldr_name() then
        local item: CStmt := declare(var_name(x.name), field(CeVar(l), 0))
        assign ss := cs ++ List(declare(l, rc), walk_list(l, item, body))
      else
        local i: Str, item: CStmt, n: Str
        call   gen_name(in "n", out n, ref g)
        call   gen_name(in "i", out i, ref g)
        assign item := declare(var_name(x.name), CeIndex(CeArrow(CeVar(l), "items"), CeVar(i)))
        assign ss := cs ++ List(declare(l, rc), declare_size(n, l), declare_int(i, 0))
        assign ss := ss ++ List(walk_array(i, n, item, body))
      end
  end

// the list of a comprehension, built in order, where d points to the place of the next cell, first t and then the tail of the
// last cell, which is init at the end
procedure compile_list_comprehension(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * At[Expr] * Var],
      cond: Option[At[Expr]],
      e: At[Expr],
      init: At[Expr],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local is: List[CStmt], ri: CExpr, loops: List[CStmt], t: Str, d: Str
  call   gen_name(in "t", out t, ref g)
  call   gen_name(in "e", out d, ref g)
  call   compile_loops(in defs, env, gs, cond, e, lambda re => append_stmt(d, re), out loops, ref g)
  call   compile_expr(in defs, env, init, out is, ri, ref g)
  assign ss := List(
    declare(t, unit_value(nil_name())),
    declare_ptr(d, CeUnary("&", CeVar(t)))) ++ loops
  assign ss := ss ++ is ++ List(CsAssign(CeUnary("*", CeVar(d)), ri)), r := CeVar(t)

// the array t of a comprehension, with room for as many elements as the first container has, which is exact for one
// generator without a condition, into which the loops push the elements, where t grows if a later generator adds more, and
// is shrunk to its elements at the end unless it has exactly as many
procedure compile_array_comprehension(
  in  defs: Defs,
      env: Vars,
      gs: List[Name * At[Expr] * Var],
      cond: Option[At[Expr]],
      e: At[Expr],
  out ss: List[CStmt],
      r: CExpr,
  ref g: Gen
) :=
  local source := unqualified("(source)")
  match gs
    case List((f, c, x); rest) =>
      local cs: List[CStmt], rc: CExpr, loops: List[CStmt], t: Str, n: Str, l: Str, scope: Vars, inner: List[Name * At[Expr] * Var]
      call   compile_expr(in defs, env, c, out cs, rc, ref g)
      call   gen_name(in "t", out t, ref g)
      call   gen_name(in "n", out n, ref g)
      call   gen_name(in "l", out l, ref g)
      assign scope := List((source, CeVar(l)); env), inner := List((f, nowhere(EName(source, THole)), x); rest)
      call   compile_loops(in defs, scope, inner, cond, e, lambda re => push_stmt(t, re), out loops, ref g)
      assign ss := cs ++ List(declare(l, rc), declare_count(n, l), declare_array(t, n)) ++ loops
      assign r := CeVar(t)
      if rest != List() then
        assign ss := ss ++ List(
          CsAssign(CeVar(t), c_call("u_array_done", List(CeVar(t), CeNum(-1)))))
      else
        if cond != None then
          assign ss := ss ++ List(
            CsAssign(CeVar(t), c_call("u_array_done", List(CeVar(t), CeVar(n)))))
        end
      end

    case List() =>
      raise Unexpected("comprehension without generators")
  end

function declare(x: Str, init: CExpr): CStmt :=
  CsDecl(value_type(), x, Some(init))

function declare_int(x: Str, num: Int): CStmt :=
  CsDecl(CtInt, x, Some(CeNum(num)))

function set_var(x: Str, e: CExpr): CStmt :=
  CsAssign(CeVar(x), e)

function call_c(f: Str, args: List[CExpr]): CStmt :=
  CsExpr(c_call(f, args))

function not_flag(d: Str): CExpr :=
  CeUnary("!", CeVar(d))

function pop_handler(d: Str): CStmt :=
  call_c("u_pop", List(CeVar(d)))

function push_handler(d: Str): CStmt :=
  CsDecl(CtPtr(CtNamed("struct u_handler")), d, Some(c_call("u_push", List())))

function setjmp_zero(d: Str): CExpr :=
  CeBinary("==", c_call("setjmp", List(CeArrow(CeVar(d), "env"))), CeNum(0))

function null_decls(locals: List[Var]): List[CStmt] :=
  List(for x in locals yield declare_null(x.name))

function save_vars(env: Vars, xs: List[Name]): List[CStmt] :=
  List(for x in xs yield declare(saved_name(x), var_expr(env, x)))

function restore_vars(env: Vars, xs: List[Name]): List[CStmt] :=
  List(for x in xs yield CsAssign(var_expr(env, x), CeVar(saved_name(x))))

function address_args(env: Vars, outs: List[Var], refs: List[Var]): List[CExpr] :=
  List(for x in outs ++ refs yield address(var_expr(env, x.name)))

// the variables of names that are local variables of env
function captured(env: Vars, names: List[Name]): List[Name] :=
  List(for x in distinct(names) if get(x, env) != None)

function make_closure(kind: Str, f: Str, caps: List[Name], env: Vars): CExpr :=
  c_call(kind, List(CeVar(f), CeNum(size(caps))) ++ List(for x in caps yield var_expr(env, x)))

function guarded(c: CExpr, t: Str, bs: List[CStmt], rb: CExpr): CStmt :=
  CsIf(c, bs ++ List(set_var(t, rb)), List())

function case_if(flag: Str, tests: List[CExpr], pat: At[Pat], v: CExpr, body: List[CStmt]): CStmt :=
  CsIf(conjunction(List(not_flag(flag)) ++ tests), pattern_binds(pat.that, v) ++ body, List())

function declare_ptr(x: Str, init: CExpr): CStmt :=
  CsDecl(value_ptr(), x, Some(init))

function declare_size(n: Str, l: Str): CStmt :=
  CsDecl(CtInt, n, Some(CeArrow(CeVar(l), "size")))

function declare_count(n: Str, l: Str): CStmt :=
  CsDecl(CtInt, n, Some(c_call("u_count", List(CeVar(l)))))

function is_cell(l: Str): CExpr :=
  c_call("u_is_con", List(CeVar(l), descriptor(cons_name())))

function walk_list(l: Str, item: CStmt, body: List[CStmt]): CStmt :=
  CsWhile(is_cell(l), List(item) ++ body ++ List(set_var(l, field(CeVar(l), 1))))

function declare_array(t: Str, n: Str): CStmt :=
  declare(t, c_call("u_array_new", List(CeVar(n))))

function walk_array(i: Str, n: Str, item: CStmt, body: List[CStmt]): CStmt :=
  CsWhile(CeBinary("<", CeVar(i), CeVar(n)), List(item) ++ body ++ List(set_var(i, CeBinary("+", CeVar(i), CeNum(1)))))

function append_stmt(d: Str, re: CExpr): List[CStmt] :=
  List(set_var(d, c_call("u_append", List(CeVar(d), re))))

function push_stmt(t: Str, re: CExpr): List[CStmt] :=
  List(set_var(t, c_call("u_array_push", List(CeVar(t), re))))

function value_formals(xs: List[Var]): List[CType * Str] :=
  List(for x in var_names(xs) yield (value_type(), var_name(x)))

function pointer_formals(xs: List[Var]): List[CType * Str] :=
  List(for x in var_names(xs) yield (value_ptr(), ref_name(x)))

function prototypes(fs: List[CDecl]): List[CDecl] :=
  List(for d in fs for p in prototype(d) yield p)

function main_function(ms: List[CStmt]): CDecl :=
  CdFunction(LkExtern, CtInt, "main", main_formals(), main_body(ms))

function main_body(ms: List[CStmt]): List[CStmt] :=
  List(call_c("u_args", List(CeVar("argc"), CeVar("argv")))) ++ ms ++ List(CsReturn(Some(CeNum(0))))

function main_formals(): List[CType * Str] :=
  List((CtInt, "argc"), (CtPtr(CtPtr(CtNamed("char"))), "argv"))

// statements, whose variables are local variables of C, where procedures copy outs and refs back at their end
procedure compile_stmt(
  in  defs: Defs,
      env: Vars,
      stmt: At[Stmt],
  out ss: List[CStmt],
  ref g: Gen
) :=
  match stmt.that
    case SSkip =>
      assign ss := List()

    case SAssign(upd) =>
      local as: List[CStmt], cs: List[CStmt], rs: List[CExpr]
      call   compile_exprs(in defs, env, seconds(upd), out as, rs, ref g)
      call   temps(in rs, out cs, ref g)
      assign ss := as ++ cs ++ reassign(env, firsts(upd), cs)

    case SBlock(locals, stmts) =>
      local bs: List[CStmt]
      call   compile_stmts(in defs, in_scope(var_names(vars(locals))) ++ env, stmts, out bs, ref g)
      assign ss := List(CsBlock(null_decls(vars(locals)) ++ bs))

    case SIf(cond, left, right) =>
      local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], rc: CExpr
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_stmt(in defs, env, left, out as, ref g)
      call   compile_stmt(in defs, env, right, out bs, ref g)
      assign ss := cs ++ List(CsIf(truth(rc), as, bs))

    case SWhile(cond, body) =>
      local as: List[CStmt], bs: List[CStmt], cs: List[CStmt], ra: CExpr, rc: CExpr, t: Str
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      call   compile_stmt(in defs, env, body, out bs, ref g)
      call   gen_name(in "t", out t, ref g)
      call   compile_expr(in defs, env, cond, out as, ra, ref g)
      assign ss := cs ++ List(
        declare(t, rc),
        CsWhile(truth(CeVar(t)), bs ++ as ++ List(set_var(t, ra))))

    // a variable of a procedure type hides the procedures of that name
    case SCall(proc, ins, outs, refs) =>
      local as: List[CStmt], rs: List[CExpr], ps: List[CExpr]
      call   compile_exprs(in defs, env, ins, out as, rs, ref g)
      assign ps := address_args(env, outs, refs)
      if get(proc, env) != None then
        assign rs := List(var_expr(env, proc), CeNum(size(ins)), CeNum(size(outs ++ refs))) ++ rs ++ ps
        assign ss := as ++ List(call_c("u_call_proc", rs))
      else
        assign ss := as ++ List(call_c(proc_name(proc), rs ++ ps))
      end

    case SMatch(arg, cases) =>
      local as: List[CStmt], bs: List[CStmt], ra: CExpr, t: Str, d: Str
      call   compile_expr(in defs, env, arg, out as, ra, ref g)
      call   gen_name(in "stmt", out d, ref g)
      call   gen_name(in "d", out t, ref g)
      call   stmt_cases(in defs, env, cases, CeVar(d), t, out bs, ref g)
      assign ss := as ++ List(CsDecl(value_type(), d, Some(ra)), CsDecl(CtInt, t, Some(CeNum(0)))) ++ bs
      assign ss := ss ++ List(
        CsIf(CeUnary("!", CeVar(t)), List(CsExpr(c_call("u_no_case", List(CeVar(d))))), List()))

    // assertions of equations show both sides when they fail
    case SAssert(AOk(_, _, ECall(_, _, Name(None, "=="), _, List(a, b)))) =>
      local as: List[CStmt], bs: List[CStmt], ra: CExpr, rb: CExpr
      call   compile_expr(in defs, env, a, out as, ra, ref g)
      call   compile_expr(in defs, env, b, out bs, rb, ref g)
      assign ss := as ++ bs ++ List(CsExpr(c_call("u_assert_equal", List(ra, rb))))

    case SAssert(cond) =>
      local cs: List[CStmt], rc: CExpr
      call   compile_expr(in defs, env, cond, out cs, rc, ref g)
      assign ss := cs ++ List(CsExpr(c_call("u_assert_true", List(rc))))

    // exceptions carry their type, which handlers compare
    case SRaise(value, typ) =>
      local as: List[CStmt], ra: CExpr
      call   compile_expr(in defs, env, value, out as, ra, ref g)
      assign ss := as ++ List(CsExpr(c_call("u_raise", List(ra, CeStr(type_key(typ))))))

    case STry(body, catches) =>
      local bs: List[CStmt]
      call compile_stmt(in defs, env, body, out bs, ref g)
      call compile_try(in defs, env, body, bs, catches, out ss, ref g)

    // the checker gives the list of the items and patterns that match every item, so that the loop walks the list and binds
    // the pattern to each item
    case SFor(List(GVal(pat, over)), body) =>
      local cs: List[CStmt], rc: CExpr, bs: List[CStmt], l: Str
      call   compile_expr(in defs, env, over, out cs, rc, ref g)
      call   compile_stmt(in defs, in_scope(pattern_names(pat)) ++ env, body, out bs, ref g)
      call   gen_name(in "l", out l, ref g)
      assign ss := cs ++ List(
        CsBlock(List(
          declare(l, rc),
          CsWhile(is_cell(l), pattern_binds(pat.that, field(CeVar(l), 0)) ++ bs ++ List(set_var(l, field(CeVar(l), 1)))))))

    // the checker gives one generator over a list
    case SFor(_, _) =>
      raise Unexpected("for of other generators")

    // a try of one handler, whose body fails with the text of the pattern if it gets to its end
    case SAssertRaises(typ, pat, body) =>
      local bs: List[CStmt], ps: List[CStmt], rp: CExpr
      call   compile_stmt(in defs, env, body, out bs, ref g)
      call   compile_expr(in defs, env, nowhere(ELit(LStr(format_pat(pat.that)))), out ps, rp, ref g)
      assign bs := bs ++ ps ++ List(
        CsExpr(c_call("u_fail_text", List(CeVar("u_text_assertion_not_raised"), rp))))
      call   compile_try(in defs, env, body, bs, List(nowhere(Catch(typ, pat, None, nowhere(SSkip)))), out ss, ref g)
  end

// the body, compiled to bs, runs after setjmp returns 0, and the handlers after a raise jumps back, which raise again if
// none applies, where the handlers start from the variables before the try, which their copies, unchanged since setjmp,
// restore
procedure compile_try(
  in  defs: Defs,
      env: Vars,
      body: At[Stmt],
      bs: List[CStmt],
      catches: List[At[Catch]],
  out ss: List[CStmt],
  ref g: Gen
) :=
  local as: List[CStmt], cs: List[CStmt], t: Str, d: Str, xs: List[Name]
  call   gen_name(in "h", out d, ref g)
  call   gen_name(in "d", out t, ref g)
  call   handler_cases(in defs, env, catches, d, t, out cs, ref g)
  assign xs := List(for x in distinct(changed(body)) if get(x, env) != None)
  assign as := List(pop_handler(d)) ++ restore_vars(env, xs) ++ List(declare_int(t, 0))
  assign as := as ++ cs ++ List(CsIf(not_flag(t), List(call_c("u_reraise", List(CeVar(d)))), List()))
  assign ss := save_vars(env, xs) ++ List(push_handler(d))
  assign ss := List(
    CsBlock(ss ++ List(CsIf(setjmp_zero(d), bs ++ List(pop_handler(d)), as))))

function saved_name(x: Name): Str :=
  "was_" ++ var_name(x)

procedure compile_stmts(
  in  defs: Defs,
      env: Vars,
      xs: List[At[Stmt]],
  out ss: List[CStmt],
  ref g: Gen
) :=
  local as: List[CStmt]
  assign ss := List()
  for x in xs do
    call   compile_stmt(in defs, env, x, out as, ref g)
    assign ss := ss ++ as
  end

function reassign(env: Vars, xs: List[Var], ts: List[CStmt]): List[CStmt] :=
  match (xs, ts)
    case (List(x; more), List(CsDecl(_, name, _); rest)) =>
      List(
        CsAssign(var_expr(env, x.name), CeVar(name)); reassign(env, more, rest))

    case _ =>
      List()
  end

// the handlers of an exception caught by h, which set the flag d when one applies, where _ handles all types
procedure handler_cases(
  in  defs: Defs,
      env: Vars,
      hs: List[At[Catch]],
      h: Str,
      d: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  local v := c_call("u_caught", List(CeVar(h)))
  match hs
    case List() =>
      assign ss := List()

    case List(AOk(_, _, Catch(typ, pat, guard, s)); more) =>
      local bs: List[CStmt], body: List[CStmt], rest: List[CStmt], env_: Vars := in_scope(pattern_names(pat)) ++ env, tests: List[CExpr]
      call   compile_stmt(in defs, env_, s, out bs, ref g)
      assign body := List(CsAssign(CeVar(d), CeNum(1))) ++ bs
      match guard
        case Some(c) =>
          local gs: List[CStmt], rg: CExpr
          call   compile_expr(in defs, env_, c, out gs, rg, ref g)
          assign body := gs ++ List(CsIf(truth(rg), body, List()))

        case None =>
          skip
      end
      match pat.that
        case PWild =>
          assign tests := List()
        case _ =>
          assign tests := List(c_call("u_has_type", List(CeVar(h), CeStr(type_key(typ))))) ++ pattern_tests(pat.that, v)
      end
      call   handler_cases(in defs, env, more, h, d, out rest, ref g)
      assign ss := List(case_if(d, tests, pat, v, body)) ++ rest

    // the parser and the checker make no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

// the cases of a match statement, which set the flag d when one applies
procedure stmt_cases(
  in  defs: Defs,
      env: Vars,
      cases: List[At[Branch[At[Stmt]]]],
      v: CExpr,
      d: Str,
  out ss: List[CStmt],
  ref g: Gen
) :=
  match cases
    case List() =>
      assign ss := List()

    case List(AOk(_, _, Branch(pat, guard, s)); more) =>
      local bs: List[CStmt], body: List[CStmt], rest: List[CStmt], env_: Vars := in_scope(pattern_names(pat)) ++ env
      call   compile_stmt(in defs, env_, s, out bs, ref g)
      assign body := List(CsAssign(CeVar(d), CeNum(1))) ++ bs
      match guard
        case Some(c) =>
          local gs: List[CStmt], rg: CExpr
          call   compile_expr(in defs, env_, c, out gs, rg, ref g)
          assign body := gs ++ List(CsIf(truth(rg), body, List()))

        case None =>
          skip
      end
      call   stmt_cases(in defs, env, more, v, d, out rest, ref g)
      assign ss := List(case_if(d, pattern_tests(pat.that, v), pat, v, body)) ++ rest

    // the parser and the checker make no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

// the C functions of a command, a function of each test if tests are compiled
procedure compile_cmd(
  in  defs: Defs,
      tests: Bool,
      cmd: Cmd,
  out ds: List[CDecl],
      ms: List[CStmt],
  ref g: Gen
) :=
  match cmd
    case CFun(name, _, formals, _, _, body) =>
      local bs: List[CStmt], rb: CExpr, params: List[CType * Str]
      call   compile_expr(in defs, in_scope(var_names(vars(formals))), body, out bs, rb, ref g)
      assign params := value_formals(vars(formals))
      if formals == List() then
        assign bs := cached(format_name(name), bs, rb)
      else
        assign bs := bs ++ List(CsReturn(Some(rb)))
      end
      assign ds := List(
        CdFunction(LkStatic, value_type(), fun_name(name, size(formals)), params, bs)), ms := List()

    // outs and refs are pointers to the variables of the caller, which the procedure assigns when it returns
    case CProc(name, _, ins, outs, refs, _, _, stmt) =>
      local bs: List[CStmt], params: List[CType * Str]
      call   compile_stmt(in defs, in_scope(var_names(vars(ins ++ outs ++ refs))), stmt, out bs, ref g)
      assign params := value_formals(vars(ins)) ++ pointer_formals(vars(outs ++ refs))
      assign bs := copy_in(vars(outs), vars(refs)) ++ bs ++ copy_out(vars(outs ++ refs))
      assign ds := List(CdFunction(LkStatic, CtVoid, proc_name(name), params, bs)), ms := List()

    // a test with formals runs as the test that the tester generates of it
    case CTest(name, List(), stmt) if tests =>
      local bs: List[CStmt]
      call   compile_stmt(in defs, List(), stmt, out bs, ref g)
      assign ds := List(CdFunction(LkStatic, CtVoid, test_name(name), List(), bs)), ms := List()

    case _ =>
      assign ds := List(), ms := List()
  end

procedure compile_cmds(
  in  defs: Defs,
      tests: Bool,
      cmds: List[Cmd],
  out ds: List[CDecl],
      ms: List[CStmt],
  ref g: Gen
) :=
  local ds_: List[CDecl], ms_: List[CStmt], found_ds: Buffer[CDecl] := empty(), found_ms: Buffer[CStmt] := empty()
  for c in cmds do
    call   compile_cmd(in defs, tests, c, out ds_, ms_, ref g)
    assign found_ds := found_ds ++ ds_, found_ms := found_ms ++ ms_
  end
  assign ds := List(for d in found_ds), ms := List(for m in found_ms)

// the body of a function without arguments, whose value is computed once, since expressions are deterministic,
// where the cache is U_COMPUTING while the value is computed, which detects a value that needs itself,
// and an exception that leaves the computation resets the cache, such that the next call computes it again, as a test that
// fails does by the cache in the handler, since its failure jumps past the handler (run_test of ulang/runtime/ulang.c); the
// result is computed before the handler is popped, which then covers the whole computation
function cached(n: Str, bs: List[CStmt], r: CExpr): List[CStmt] :=
  cache_start(n) ++ bs ++ List(
    CsDecl(value_type(), "computed", Some(r)),
    pop_cache_handler(),
    CsAssign(CeVar("cache"), CeVar("computed")),
    CsReturn(Some(CeVar("cache"))))

function cache_handler(): CExpr :=
  CeVar("handler")

function cache_start(n: Str): List[CStmt] :=
  List(
    cache_decl(),
    cache_computing(n),
    cache_hit(),
    cache_mark(),
    cache_handler_decl(),
    cache_catch())

function cache_decl(): CStmt :=
  CsDecl(CtNamed("static u_value"), "cache", Some(CeVar("NULL")))

function cache_computing(n: Str): CStmt :=
  CsIf(CeBinary("==", CeVar("cache"), CeVar("U_COMPUTING")), List(fail_recursive(n)), List())

function cache_hit(): CStmt :=
  CsIf(CeVar("cache"), List(CsReturn(Some(CeVar("cache")))), List())

function cache_mark(): CStmt :=
  CsAssign(CeVar("cache"), CeVar("U_COMPUTING"))

function cache_handler_decl(): CStmt :=
  CsDecl(CtPtr(CtNamed("struct u_handler")), "handler", Some(c_call("u_push_cache", List(CeUnary("&", CeVar("cache"))))))

function cache_catch(): CStmt :=
  CsIf(CeBinary("!=", c_call("setjmp", List(CeArrow(cache_handler(), "env"))), CeNum(0)), cache_unwind(), List())

function pop_cache_handler(): CStmt :=
  CsExpr(c_call("u_pop", List(cache_handler())))

function fail_recursive(n: Str): CStmt :=
  CsExpr(c_call("u_fail", List(CeStr(runtime_message(RecursiveInitialization(n))))))

function cache_unwind(): List[CStmt] :=
  List(
    pop_cache_handler(),
    CsAssign(CeVar("cache"), CeVar("NULL")),
    CsExpr(c_call("u_reraise", List(cache_handler()))))

// closures of functions, constructors, and builtins, which take their arguments from an array
function wrappers(defs: Defs): List[CDecl] :=
  fun_wrappers(defs) ++ constr_wrappers(defs) ++ builtin_wrappers() ++ proc_wrappers(defs)

function fun_wrappers(defs: Defs): List[CDecl] :=
  List(for p in firsts(List(for x in defs.funs)) yield fun_wrapper(p))

function constr_wrappers(defs: Defs): List[CDecl] :=
  List(for p in constr_arities(defs) for w in constr_wrapper(p) yield w)

function builtin_wrappers(): List[CDecl] :=
  List(for p in distinct(seconds(List(for x in builtin_functions()))) yield builtin_wrapper(p))

function proc_wrappers(defs: Defs): List[CDecl] :=
  List(for p in proc_arities(defs) yield proc_wrapper(p))

function proc_call(n: Name, k: Int, m: Int): CStmt :=
  CsExpr(c_call(proc_name(n), indexed("ins", k) ++ indexed("outs", m)))

// procedures as values call the procedure with the values of the array ins and the pointers of the array outs
function proc_wrapper(p: Name * (Int * Int)): CDecl :=
  match p
    case (n, (k, m)) =>
      CdFunction(LkStatic, CtVoid, "wp_" ++ mangle(n), proc_params(), List(proc_call(n, k, m)))
  end

function fun_wrapper(p: Name * Int): CDecl :=
  match p
    case (n, k) =>
      wrapper("w_" ++ fun_name(n, k), fun_name(n, k), k)
  end

function builtin_wrapper(p: Str * Int): CDecl :=
  match p
    case (f, k) =>
      wrapper("w" ++ f, f, k)
  end

function wrapper(w: Str, f: Str, k: Int): CDecl :=
  CdFunction(LkStatic, value_type(), w, closure_params(), List(CsReturn(Some(c_call(f, indexed("args", k))))))

function closure_params(): List[CType * Str] :=
  List((value_ptr(), "env"), (value_ptr(), "args"))

function indexed(name: Str, k: Int): List[CExpr] :=
  List(for i in range(0, k) yield index(name, i))

function con_array(n: Name, k: Int): CExpr :=
  c_call("u_mk_con_array", List(descriptor(n), CeNum(k), CeVar("args")))

// constructors without fields are no functions
function constr_wrapper(p: Name * Int): List[CDecl] :=
  match p
    case (_, 0) =>
      List()

    case (n, k) =>
      List(
        CdFunction(LkStatic, value_type(), "wc_" ++ mangle(n), closure_params(), List(CsReturn(Some(con_array(n, k))))))
  end

function prototype(d: CDecl): List[CDecl] :=
  match d
    case CdFunction(linkage, typ, fun, formals, _) =>
      List(CdPrototype(linkage, typ, fun, formals))
    case _ =>
      List()
  end

// the C of q of module m, whose main calls the procedure of the entry without parameters, or runs the tests of its files
procedure compile_program(in q: Prog, m: Id, entry: Entry, out f: CFile) :=
  local g := Gen(0, List()), defs := defs_of(q), ds: List[CDecl], ms: List[CStmt], fs: List[CDecl], hs: List[CDecl], tables: List[CDecl]
  match entry
    case EntryProc(proc) =>
      call   require_entry(in q, Name(Some(m), proc))
      call   compile_cmds(in defs, false, definitions(q), out ds, ms, ref g)
      assign ms := List(CsExpr(c_call(proc_name(Name(Some(m), proc)), List()))), tables := List()

    case EntryTests(files) =>
      call   compile_cmds(in defs, true, definitions(q), out ds, ms, ref g)
      assign ms := List(
        CsReturn(Some(c_call("u_run_tests", List(CeVar("argc"), CeVar("argv"), CeVar("u_files"), CeVar("u_tests")))))), tables := test_tables(files, definitions(q))
  end
  assign fs := wrappers(defs) ++ ds ++ g.lifted
  assign hs := List(CdInclude("ulang.h")) ++ prototypes(fs) ++ descriptor_decls(defs, definitions(q)) ++ texts()
  assign f := CFile(hs ++ fs ++ tables ++ List(main_function(ms)))

// the paths of the files and their tests, each with the index of its file, in the order of the files and then of the
// commands, both ended by NULL, as u_run_tests of ulang/runtime/ulang.c takes them
function test_tables(files: List[TestFile], cmds: List[Cmd]): List[CDecl] :=
  let rows := List(for (file, i) in numbered(files) for c in cmds for name in tested_name(c, file.module) yield CeInit(List(CeNum(i), CeStr(name.base), CeVar(test_name(name))))) in
  List(
    CdGlobal(LkStatic, CtNamed("const char *const"), "u_files[]", Some(CeInit(List(for file in files yield CeStr(file.path)) ++ List(CeVar("NULL"))))),
    CdGlobal(LkStatic, CtNamed("const struct u_test"), "u_tests[]", Some(CeInit(rows ++ List(CeInit(List(CeNum(0), CeVar("NULL"), CeVar("NULL"))))))))

// the texts of the runtime errors that ulang/runtime/ulang.c prints
function texts(): List[CDecl] :=
  List(for p in runtime_formats() yield text_decl(p))

function text_decl(p: Str * Str): CDecl :=
  match p
    case (name, text) =>
      CdGlobal(LkExtern, CtNamed("const char *const"), name, Some(CeStr(text)))
  end

// checks the program of the file source, which is its module, and writes its translation to C to target, with the whole
// library, which every module sees, so also the module list, which the runtime needs
procedure compile_file(
  in  source: Str,
      entry: Entry,
      target: Str
) raises ParseError, TypeError, EntryError, InternalError, OsError :=
  local parsed: Source, q: Prog
  call parse_file(in source, out parsed)
  call require_parsed(in parsed)
  call check_program(in parsed, out q)
  call compile_prog(in q, entry, target)

procedure compile_prog(
  in  q: Prog,
      entry: Entry,
      target: Str
) raises EntryError, InternalError, OsError :=
  if ends_with(target, ".s") then
    local a: AsmFile
    call assemble_program(in q, q.main, entry, out a)
    call os_write_utf8(in target, format_asm(a))
  else
    if ends_with(target, ".o") then
      local a: AsmFile, bytes: Array[Byte]
      call assemble_program(in q, q.main, entry, out a)
      call encode_object(in a, out bytes)
      call os_write_bytes(in target, bytes)
    else
      local f: CFile
      call compile_program(in q, q.main, entry, out f)
      call os_write_utf8(in target, format_file(f))
    end
  end
