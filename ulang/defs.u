// the definitions of a program that ulang/check.u has checked, as the interpreter of ulang/run.u and the compiler of
// ulang/compile.u look them up, with the declared orders, equalities, and shows of its datatypes

import "builtins.u"
import "map.u"
import "syntax.u"

export

data FunDef :=
  case FunDef(formals: List[Var], body: Expr)

data ProcDef :=
  case ProcDef(ins: List[Var], outs: List[Var], refs: List[Var], stmt: Stmt)

// a constructor of datatype with arity fields, at position in its declaration, which orders values, see order_of
data ConstrDef :=
  case ConstrDef(arity: Int, position: Int, datatype: Name)

// fields has for the accessor T.f, of one argument, and the updater T.f:=, of two, of each field f of a datatype T, the
// position of f in each constructor of T, in the order of their declaration, or -1 for a constructor without f
data Defs :=
  case Defs(funs: Map[Name * Int, FunDef], procs: Map[Name, ProcDef], constrs: Map[Name, ConstrDef], fields: Map[Name * Int, List[Int]], orders: Map[Name, Name], equalities: Map[Name, Name], shows: Map[Name, Name])

function defs_of(q: Prog): Defs

function field_names(constrs: List[Constr]): List[Id]

function accessor_name(t: Name, f: Id): Name

function updater_name(t: Name, f: Id): Name

function field_of(n: Name): Str

function order_of(cmd: Cmd): Option[Id * Name]

function ordered(cmds: List[Cmd], op: Id): List[Name]

function ordered_by(cmds: List[Cmd], op: Id): List[Name * Name]

implementation

function defs_of(q: Prog): Defs :=
  Defs(map(for (k, v) in fun_defs(q.cmds)), map(for (k, v) in proc_defs(q.cmds)), map(for (k, v) in constr_defs(q.cmds)), map(for (k, v) in field_defs(q.cmds)), map(for (k, v) in ordered_by(q.cmds, "compare")), map(for (k, v) in ordered_by(q.cmds, "==")), map(for (k, v) in ordered_by(q.cmds, "show")))

// functions are overloaded by their number of arguments
function fun_defs(cmds: List[Cmd]): List[(Name * Int) * FunDef] :=
  match cmds
    case list() =>
      list()

    case list(CFun(name, _, formals, _, body); rest) =>
      list(((name, size(formals)), FunDef(formals, body)); fun_defs(rest))

    case list(_; rest) =>
      fun_defs(rest)
  end

function proc_defs(cmds: List[Cmd]): List[Name * ProcDef] :=
  match cmds
    case list() =>
      list()

    case list(CProc(name, _, ins, outs, refs, stmt); rest) =>
      list((name, ProcDef(ins, outs, refs, stmt)); proc_defs(rest))

    case list(_; rest) =>
      proc_defs(rest)
  end

function constr_defs(cmds: List[Cmd]): List[Name * ConstrDef] :=
  match cmds
    case list() =>
      list()

    case list(CData(name, _, constrs); rest) =>
      constrs_from(name, constrs, 0) ++ constr_defs(rest)

    case list(_; rest) =>
      constr_defs(rest)
  end

function constrs_from(t: Name, ks: List[Constr], i: Int): List[Name * ConstrDef] :=
  match ks
    case list() =>
      list()
    case list(Constr(_, name, fields); rest) =>
      list((name, ConstrDef(size(fields), i, t)); constrs_from(t, rest, i + 1))
  end

function field_defs(cmds: List[Cmd]): List[(Name * Int) * List[Int]] :=
  match cmds
    case list() =>
      list()

    case list(CData(name, _, constrs); rest) =>
      field_positions(name, constrs) ++ field_defs(rest)

    case list(_; rest) =>
      field_defs(rest)
  end

function field_positions(t: Name, constrs: List[Constr]): List[(Name * Int) * List[Int]] :=
  list(for f in field_names(constrs) for e in list(
    ((accessor_name(t, f), 1), positions(f, constrs)),
    ((updater_name(t, f), 2), positions(f, constrs))) yield e)

// the fields of the constructors of a datatype, each once
function field_names(constrs: List[Constr]): List[Id] :=
  distinct(list(for k in constrs for field in k.fields yield field.name))

function positions(f: Id, constrs: List[Constr]): List[Int] :=
  list(for k in constrs yield value_or(index_of(f, list(for field in k.fields yield field.name)), -1))

function accessor_name(t: Name, f: Id): Name :=
  Name(t.module, t.base ++ "." ++ f)

function updater_name(t: Name, f: Id): Name :=
  Name(t.module, t.base ++ "." ++ f ++ ":=")

// the name T.f of the field of the accessor T.f or the updater T.f:=, as MissingField has it
function field_of(n: Name): Str :=
  if ends_with(n.base, ":=") then slice(n.base, 0, size(n.base) - 2) else n.base

// the datatype whose order or equality c declares, with compare or ==, if c is compare or == of two values of a datatype
// T[A, …] of its own module with distinct parameters, which the interpreter and the runtime then use for all values of T,
// also in generic code, where the builtins compare structurally
// with the functions T.compare and T.== that the checker synthesizes for an abstract type T,
// and similarly the text of the values of T if c is show of one value of T with the result Str
function order_of(cmd: Cmd): Option[Id * Name] :=
  match cmd
    case CFun(Name(Some(m), "show"), _, list(Var(_, TSort(Name(Some(k), base), args))), typ, _) =>
      if k == m and distinct_params(args) and typ == type_str() then Some(("show", Name(Some(k), base))) else None

    case CFun(Name(Some(m), f), _, list(Var(_, TSort(Name(Some(k), b), args)), Var(_, u)), r, _) =>
      let op := order_op(f, b) in if k == m and u == TSort(Name(Some(k), b), args) and distinct_params(args) and order_result(op) == Some(r) then Some((op, Name(Some(k), b))) else None

    case _ =>
      None
  end

function order_op(f: Id, b: Id): Id :=
  if f == b ++ ".compare" then "compare" else if f == b ++ ".==" then "==" else f

function order_result(op: Id): Option[Type] :=
  match op
    case "compare" =>
      Some(type_int())

    case "==" =>
      Some(type_bool())

    case _ =>
      None
  end

function distinct_params(ts: List[Type]): Bool :=
  list(for t in ts if is_param(t)) == ts and distinct(ts) == ts

function is_param(t: Type): Bool :=
  match t
    case TParam(_) =>
      true
    case _ =>
      false
  end

// the datatypes of cs ordered, equated, or shown by op
function ordered(cmds: List[Cmd], op: Id): List[Name] :=
  firsts(ordered_by(cmds, op))

// the datatypes of cs ordered, equated, or shown by op, with the functions that do it
function ordered_by(cmds: List[Cmd], op: Id): List[Name * Name] :=
  match cmds
    case list() =>
      list()

    case list(c; rest) =>
      match (c, order_of(c))
        case (CFun(name, _, _, _, _), Some((o, t))) =>
          if o == op then list((t, name); ordered_by(rest, op)) else ordered_by(rest, op)
        case _ =>
          ordered_by(rest, op)
      end
  end
