// the definitions of a program that ulang/check.u has checked, as the interpreter of ulang/run.u and the compiler of
// ulang/compile.u look them up, with the declared orders, equalities, and shows of its datatypes

export

data FunDef :=
  case FunDef(formals: List[Var], body: Expr)

data ProcDef :=
  case ProcDef(ins: List[Var], outs: List[Var], refs: List[Var], stmt: Stmt)

// a constructor of datatype with arity fields, at position in its declaration, which orders values, see order_of
data ConstrDef :=
  case ConstrDef(arity: Int, position: Int, datatype: Name)

// fields has for the accessor T.f, of one argument, and the updater T.f:=, of two, of each field f of a datatype T, the
// position of f in each constructor of T, in the order of their declaration, or -1 for a constructor without f
data Defs :=
  case Defs(funs: Map[Name * Int, FunDef], procs: Map[Name, ProcDef], constrs: Map[Name, ConstrDef], fields: Map[Name * Int, List[Int]], orders: Map[Name, Name], equalities: Map[Name, Name], shows: Map[Name, Name])

function defs_of(q: Prog): Defs

// the procedure without parameters that run and compile call is not in the program
data EntryError :=
  case UnknownEntry(name: Name)

procedure require_entry(in q: Prog, n: Name)

function field_names(constrs: List[Constr]): List[Id]

function accessor_name(t: Name, f: Id): Name

function updater_name(t: Name, f: Id): Name

function field_of(n: Name): Str

// the functions of a datatype T that the builtins compare, ==, and show use for all values of T, see order_of, each of
// arity values T[A, …] of T, with the result type; its name is also the builtin of any values, of hook_scheme
data Hook :=
  case HookCompare
  case HookEquality
  case HookShow

function hooks(): List[Hook]

function hook_name(hook: Hook): Id

function hook_arity(hook: Hook): Int

function hook_result(hook: Hook): Type

function hook_scheme(hook: Hook): Scheme

function hook_of(f: Id, k: Int): Option[Hook]

function order_of(cmd: Cmd): Option[Hook * Name]

function ordered(cmds: List[Cmd], hook: Hook): List[Name]

function ordered_by(cmds: List[Cmd], hook: Hook): List[Name * Name]

implementation

procedure require_entry(in q: Prog, n: Name) :=
  if not exists(q.cmds, lambda c => is_entry(c, n)) then
    raise UnknownEntry(n)
  end

// a procedure without parameters
function is_entry(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, List(), List(), List(), _) =>
      name == n
    case _ =>
      false
  end

function defs_of(q: Prog): Defs :=
  Defs(Map(for (k, v) in fun_defs(q.cmds)), Map(for (k, v) in proc_defs(q.cmds)), Map(for (k, v) in constr_defs(q.cmds)), Map(for (k, v) in field_defs(q.cmds)), Map(for (k, v) in ordered_by(q.cmds, HookCompare)), Map(for (k, v) in ordered_by(q.cmds, HookEquality)), Map(for (k, v) in ordered_by(q.cmds, HookShow)))

// functions are overloaded by their number of arguments
function fun_defs(cmds: List[Cmd]): List[(Name * Int) * FunDef] :=
  match cmds
    case List() =>
      List()

    case List(CFun(name, _, formals, _, body); rest) =>
      List(((name, size(formals)), FunDef(formals, body)); fun_defs(rest))

    case List(_; rest) =>
      fun_defs(rest)
  end

function proc_defs(cmds: List[Cmd]): List[Name * ProcDef] :=
  match cmds
    case List() =>
      List()

    case List(CProc(name, _, ins, outs, refs, stmt); rest) =>
      List((name, ProcDef(ins, outs, refs, stmt)); proc_defs(rest))

    case List(_; rest) =>
      proc_defs(rest)
  end

function constr_defs(cmds: List[Cmd]): List[Name * ConstrDef] :=
  match cmds
    case List() =>
      List()

    case List(CData(name, _, constrs); rest) =>
      constrs_from(name, constrs, 0) ++ constr_defs(rest)

    case List(_; rest) =>
      constr_defs(rest)
  end

function constrs_from(t: Name, ks: List[Constr], i: Int): List[Name * ConstrDef] :=
  match ks
    case List() =>
      List()
    case List(Constr(_, name, fields); rest) =>
      List((name, ConstrDef(size(fields), i, t)); constrs_from(t, rest, i + 1))
  end

function field_defs(cmds: List[Cmd]): List[(Name * Int) * List[Int]] :=
  match cmds
    case List() =>
      List()

    case List(CData(name, _, constrs); rest) =>
      field_positions(name, constrs) ++ field_defs(rest)

    case List(_; rest) =>
      field_defs(rest)
  end

function field_positions(t: Name, constrs: List[Constr]): List[(Name * Int) * List[Int]] :=
  List(for f in field_names(constrs) for e in List(
    ((accessor_name(t, f), 1), positions(f, constrs)),
    ((updater_name(t, f), 2), positions(f, constrs))) yield e)

// the fields of the constructors of a datatype, each once
function field_names(constrs: List[Constr]): List[Id] :=
  distinct(List(for k in constrs for field in k.fields yield field.name))

function positions(f: Id, constrs: List[Constr]): List[Int] :=
  List(for k in constrs yield value_or(index_of(f, List(for field in k.fields yield field.name)), -1))

function accessor_name(t: Name, f: Id): Name :=
  Name(t.module, t.base ++ "." ++ f)

function updater_name(t: Name, f: Id): Name :=
  Name(t.module, t.base ++ "." ++ f ++ ":=")

// the name T.f of the field of the accessor T.f or the updater T.f:=, as MissingField has it
function field_of(n: Name): Str :=
  if ends_with(n.base, ":=") then slice(n.base, 0, size(n.base) - 2) else n.base

function hooks(): List[Hook] :=
  List(HookCompare, HookEquality, HookShow)

function hook_name(hook: Hook): Id :=
  match hook
    case HookCompare =>
      "compare"

    case HookEquality =>
      "=="

    case HookShow =>
      "show"
  end

function hook_arity(hook: Hook): Int :=
  match hook
    case HookCompare =>
      2

    case HookEquality =>
      2

    case HookShow =>
      1
  end

function hook_result(hook: Hook): Type :=
  match hook
    case HookCompare =>
      TInt()

    case HookEquality =>
      TBool()

    case HookShow =>
      TStr()
  end

// the builtin of the name of the hook, of any values
function hook_scheme(hook: Hook): Scheme :=
  let a := TParam("A") in Scheme(List(a), TFun(replicate(hook_arity(hook), a), hook_result(hook)))

// the hook that a function f of k arguments declares if it has the right type
function hook_of(f: Id, k: Int): Option[Hook] :=
  find(hooks(), lambda hook => hook_name(hook) == f and hook_arity(hook) == k)

// the datatype whose order, equality, or text cmd declares, if cmd is a hook of values T[A, …] of a datatype T of its own
// module with distinct parameters and the result of the hook, which the interpreter and the runtime then use for all
// values of T, also in generic code, where the builtins compare structurally and show the structure; the hook may be
// named T.compare or T.==, as the checker synthesizes them for an abstract type T
function order_of(cmd: Cmd): Option[Hook * Name] :=
  match cmd
    case CFun(Name(Some(m), f), _, List(Var(_, TSort(Name(Some(k), b), args)); more), r, _) =>
      let typ := TSort(Name(Some(k), b), args) in match hook_of(hook_base(f, b), 1 + size(more))
        case Some(hook) =>
          if k == m and forall(more, lambda x => x.typ == typ) and is_distinct_params(args) and r == hook_result(hook) then Some((hook, Name(Some(k), b))) else None
        case None =>
          None
      end

    case _ =>
      None
  end

// f without the prefix T. of the name b of T
function hook_base(f: Id, b: Id): Id :=
  if starts_with(f, b ++ ".") then slice(f, size(b) + 1, size(f)) else f

function is_distinct_params(ts: List[Type]): Bool :=
  List(for t in ts if is_param(t)) == ts and distinct(ts) == ts

function is_param(t: Type): Bool :=
  match t
    case TParam(_) =>
      true
    case _ =>
      false
  end

// the datatypes of cmds that declare the hook
function ordered(cmds: List[Cmd], hook: Hook): List[Name] :=
  firsts(ordered_by(cmds, hook))

// the datatypes of cmds that declare the hook, with the functions that declare it
function ordered_by(cmds: List[Cmd], hook: Hook): List[Name * Name] :=
  match cmds
    case List() =>
      List()

    case List(c; rest) =>
      match (c, order_of(c))
        case (CFun(name, _, _, _, _), Some((h, t))) =>
          if h == hook then List((t, name); ordered_by(rest, hook)) else ordered_by(rest, hook)
        case _ =>
          ordered_by(rest, hook)
      end
  end
