// the driver of ulang, out/ulang.bin, with the commands of usage: run, test, and check with the interpreter of
// ulang/run/run.u, prove by the default proof of ulang/prove/lemma.u, as test does after the tests, format by
// format_program of ulang/format/format.u, and compile to C, where a file passes if it loads, its tests pass, and its
// lemmas are proven, and the errors that the phases must raise are tested by the cases of ulang/test/errors/

import "ulang/syntax"
import "ulang/format"
import "ulang/parse"
import "ulang/check"
import "ulang/run"
import "ulang/compile"
import "ulang/prove"
import "ulang/lint"

// the command of the arguments, as request reads them
data Request :=
  case RRun(target: Target, args: List[Str])
  case RTest(targets: List[Target], args: List[Str])
  case RCheck(paths: List[Str])
  // the lints of the files that load, as warnings
  case RLint(paths: List[Str])
  case RProve(targets: List[Target])
  case RFormat(paths: List[Str])
  // the procedure of the target, main by default
  case RCompile(target: Target, output: Str)
  // the tests of the project
  case RCompileTests(output: Str)
  case RHelp(command: Option[Str])
  // arguments that request does not read, with what is wrong with them
  case RUsage(problem: Str)

// a file or a directory, or a file name.u with the name of a declaration after its last :
data Target :=
  case Target(path: Str, name: Option[Str])

procedure main() :=
  var args: List[Str], status := 0
  os_args(out args)
  match request(args)
    case RRun(target, rest) =>
      run_target(in target, rest, out status)

    case RTest(targets, rest) =>
      test_targets(in targets, rest, out status)

    case RCheck(paths) =>
      check_paths(in paths, false, out status)

    case RLint(paths) =>
      check_paths(in paths, true, out status)

    case RProve(targets) =>
      prove_targets(in targets, out status)

    case RFormat(paths) =>
      format_paths(in paths, out status)

    case RCompile(target, output) =>
      compile_target(in target, output, out status)

    case RCompileTests(output) =>
      compile_tests(in output, out status)

    case RHelp(None) =>
      os_println(in usage())

    case RHelp(Some(command)) =>
      os_println(in help(command))

    case RUsage(problem) =>
      os_print_error(in "ulang: " ++ problem ++ "\n" ++ usage())
      os_exit(in 2)
  end
  if status != 0 then
    os_exit(in status)
  end

// the arguments after -- are those of the program, for run and test
function request(args: List[Str]): Request :=
  match split_on(args, "--")
    case (List(command; words), rest) =>
      if rest != List() and command != "run" and command != "test" then
        RUsage(command ++ " takes no arguments after --")
      else
        command_request(command, words, rest)

    case (List(), _) =>
      RUsage("no command")
  end

function command_request(command: Str, words: List[Str], rest: List[Str]): Request :=
  match (command, words)
    case ("run", List(word)) =>
      let target := target_of(word) in
      if is_source(target.path) then
        RRun(target, rest)
      else
        RUsage("run takes a file name.u, not " ++ word)

    case ("run", _) =>
      RUsage("run takes one file")

    case ("test", _) =>
      options_request(command, words, RTest(List(for w in words yield target_of(w)), rest))

    case ("check", _) =>
      paths_request(command, words, RCheck(words))

    case ("lint", _) =>
      paths_request(command, words, RLint(words))

    case ("prove", _) =>
      options_request(command, words, RProve(List(for w in words yield target_of(w))))

    case ("format", _) =>
      paths_request(command, words, RFormat(words))

    case ("compile", _) =>
      compile_request(words, None, false, None)

    case ("help", List()) =>
      RHelp(None)

    case ("help", List(topic)) =>
      if contains(topic, commands()) then
        RHelp(Some(topic))
      else
        RUsage("unknown command " ++ topic)

    case _ =>
      if contains(command, commands()) then
        RUsage(command ++ " takes other arguments")
      else
        RUsage("unknown command " ++ command)
  end

// the request of a command that takes paths without names and no options
function paths_request(command: Str, paths: List[Str], request: Request): Request :=
  options_request(command, paths, if exists(paths, lambda w => target_of(w).name != None) then
    RUsage(command ++ " takes no names")
  else
    request)

// the request of a command that takes no options, where words are its arguments before --
function options_request(command: Str, words: List[Str], request: Request): Request :=
  if exists(words, lambda w => starts_with(w, "-")) then
    RUsage(command ++ " takes no options")
  else
    request

// the words of compile in any order, the file with its procedure or --tests, and -o with the target
function compile_request(words: List[Str], target: Option[Target], tests: Bool, output: Option[Str]): Request :=
  match words
    case List("-o", path; more) =>
      compile_request(more, target, tests, Some(path))

    case List("--tests"; more) =>
      compile_request(more, target, true, output)

    case List(word; more) =>
      if target == None and not starts_with(word, "-") then
        compile_request(more, Some(target_of(word)), tests, output)
      else
        RUsage("compile does not take " ++ word)

    case List() =>
      match (target, output)
        case (_, None) =>
          RUsage("compile takes -o <target.c> or -o <target.s>")

        case (Some(_), _) if tests =>
          RUsage("compile --tests takes no file, since it compiles the tests of the project")

        case (None, Some(path)) =>
          if tests then
            RCompileTests(path)
          else
            RUsage("compile takes a file or --tests")

        case (Some(t), Some(path)) =>
          if is_source(t.path) then
            RCompile(t, path)
          else
            RUsage("compile takes a file name.u, not " ++ t.path)
      end
  end

function target_of(word: Str): Target :=
  match reverse(split(word, ':'))
    case List(name, first; more) =>
      let path := join(":", reverse(List(first; more))) in
      if is_source(path) then Target(path, Some(name)) else Target(word, None)

    case _ =>
      Target(word, None)
  end

test requests() :=
  assert request(List("run", "a.u")) == RRun(Target("a.u", None), List())
  assert request(List("run", "a.u:go", "--", "x")) == RRun(Target("a.u", Some("go")), List("x"))
  assert request(List("test", "a.u:t", "dir", "b:c")) == RTest(List(Target("a.u", Some("t")), Target("dir", None), Target("b:c", None)), List())
  assert request(List("check")) == RCheck(List())
  assert request(List("lint", "a.u")) == RLint(List("a.u"))
  assert request(List("format", "a.u")) == RFormat(List("a.u"))
  assert request(List("compile", "-o", "a.c", "--tests")) == RCompileTests("a.c")
  assert request(List("compile", "a.u:go", "-o", "a.c")) == RCompile(Target("a.u", Some("go")), "a.c")
  assert request(List("help", "prove")) == RHelp(Some("prove"))

test usage_errors() :=
  assert request(List()) == RUsage("no command")
  assert request(List("frobnicate")) == RUsage("unknown command frobnicate")
  assert request(List("check", "a.u", "--", "x")) == RUsage("check takes no arguments after --")
  assert request(List("check", "a.u:t")) == RUsage("check takes no names")
  assert request(List("lint", "a.u:t")) == RUsage("lint takes no names")
  assert request(List("check", "--lint", "a.u")) == RUsage("check takes no options")
  assert request(List("format", "--check")) == RUsage("format takes no options")
  assert request(List("test", "-v")) == RUsage("test takes no options")
  assert request(List("prove", "a.u", "--x")) == RUsage("prove takes no options")
  assert request(List("test", "a.u", "--", "-v")) == RTest(List(Target("a.u", None)), List("-v"))
  assert request(List("run", "dir")) == RUsage("run takes a file name.u, not dir")
  assert request(List("compile", "a.u")) == RUsage("compile takes -o <target.c> or -o <target.s>")
  assert request(List("compile", "a.u", "--tests", "-o", "a.c")) == RUsage("compile --tests takes no file, since it compiles the tests of the project")
  assert request(List("compile", "-o", "a.c")) == RUsage("compile takes a file or --tests")

function commands(): List[Str] :=
  List("run", "test", "check", "lint", "prove", "format", "compile", "help")

function usage(): Str :=
  "usage:\n" ++ join("\n", List(for c in commands() yield "  ulang " ++ synopsis(c)))

function help(command: Str): Str :=
  "usage: ulang " ++ synopsis(command) ++ "\n\n" ++ description(command)

function synopsis(command: Str): Str :=
  match command
    case "run" =>
      "run <file>[:<procedure>] [-- args]"

    case "test" =>
      "test [<path>[:<name>] ...] [-- args]"

    case "check" =>
      "check [<path> ...]"

    case "lint" =>
      "lint [<path> ...]"

    case "prove" =>
      "prove [<path>[:<lemma>] ...]"

    case "format" =>
      "format [<path> ...]"

    case "compile" =>
      "compile (<file>[:<procedure>] | --tests) -o <target.c|target.s>"

    case _ =>
      "help [<command>]"
  end

function description(command: Str): Str :=
  match command
    case "run" =>
      "calls the procedure, main by default, which takes no parameters, where os_args gives the arguments after --"

    case "test" =>
      "runs the tests of the files, all or the named ones, also below directories, by default the project, in the working\n" ++ "directory, printing a line per test and lemma, where a file passes if it loads and its tests pass and its lemmas are\n" ++ "proven; with several files, it prints the files that do not pass and how many do"

    case "check" =>
      "checks the files, also below directories, by default the project"

    case "lint" =>
      "checks the files as check does and prints the lints of those that load, as warnings with the rule and, where it has\n" ++ "one, the simpler expression to write, which do not fail the check"

    case "prove" =>
      "proves the lemmas of the files, all or the named ones, also below directories, by default the project, where a\n" ++ "recursive function unfolds only if the prover proves that it terminates"

    case "format" =>
      "rewrites the files, also below directories, by default the project, as format_program writes them, where lint, check,\n" ++ "and test report the files that differ"

    case "compile" =>
      "translates the file to C, or to assembly for x86-64 if the target ends in .s, whose main calls the procedure, main by default, or with --tests the tests of the project,\n" ++ "whose main takes the arguments of test, without lemmas, and runs them as test does, from the root of the project"

    case _ =>
      "prints the usage of all commands, or of one"
  end

// calls the procedure of the target, main by default, without parameters, where os_args gives args
procedure run_target(in target: Target, args: List[Str], out status: Int) :=
  var q: Prog, errors: List[Diagnostic], entry := Name(None, value_or(target.name, "main")), cache: Map[Name, Val] := empty()
  check_file(in target.path, false, out q, errors)
  report(in target.path, errors, false)
  status := load_status(q, errors)
  if errors == List() or is_runnable(q, errors) then
    entry := Name(Some(q.main), entry.base)
    try
      require_entry(in q, entry)
      run_proc(in load(q) with args := args, entry, ref cache)
    catch
      case UnknownEntry(name) =>
        report(in target.path, List(no_entry(name)), false)
        status := max(status, 1)

      case e =>
        report(in target.path, List(diagnostic(RuntimeKind, runtime_message(e))), false)
        status := max(status, 3)

      case e =>
        report(in target.path, List(diagnostic(InternalKind, internal_message(e))), false)
        status := 4
    end
  end

// whether the program q, whose diagnostics are errors, runs despite them, where a run raises Deferred at the parts and
// definitions that they make unsafe: if its main module is checked, which it is not if a package that it imports has
// errors, and no error is internal
function is_runnable(q: Prog, errors: List[Diagnostic]): Bool :=
  not exists(errors, lambda d => d.kind == InternalKind) and exists(q.cmds, lambda c => is_parsed(c) and cmd_module(c.that) == Some(q.main))

// the exit status of loading the program q, whose diagnostics are errors: 0 for none, 1 for errors of the sources, and 4 for
// an internal error, where a run, a test, or a lemma that fails is 3 and a usage error 2, and the greatest of several counts
function load_status(q: Prog, errors: List[Diagnostic]): Int :=
  if exists(errors, lambda d => d.kind == InternalKind) then
    4
  else if has_errors(q) or errors != List() then
    1
  else
    0

function no_entry(name: Name): Diagnostic :=
  Diagnostic(RuntimeKind, "UnknownEntry", None, Pos(0, 0), "there is no procedure " ++ name.base ++ " without parameters", List())

// runs the tests of the targets, by default of the project, each unit loaded once, in the working directory, and the lemmas
// of each file whose tests all run, printing a line per test and lemma, labeled by its file if there are several files
procedure test_targets(
  in  targets: List[Target],
      args: List[Str],
  out status: Int
) :=
  var found: List[Target]
  targets_of(in targets, true, out found)
  visit_units(in found, true, lambda in source, q, unit, out failed =>
    test_unit(in q, unit, found, args, out failed)
  end, out status)

// runs the tests of the files of the unit, whose checked program is q, where failed are the files that do not pass
procedure test_unit(
  in  q: Prog,
      unit: List[Target],
      found: List[Target],
      args: List[Str],
  out failed: List[Str]
) :=
  var passed: Bool
  failed := List()
  for file in files_of(unit) do
    test_module(in q, sibling(q.main, file), file, names_of(file, unit), args, label_of(file, found), out passed)
    if not passed then
      failed := failed ++ List(file)
      if size(files_of(found)) > 1 then
        os_println(in file ++ ": failed")
      end
    end
  end

// checks each unit of the targets once, where the error of a unit that does not load is reported at its first file, and
// calls visit with the checked program of each unit that loads, which gives the files of the unit that fail, also of a
// unit with errors if deferred and it is runnable, whose files then fail, then prints how many files passed, where status
// is the exit status of the worst
procedure visit_units(
  in  found: List[Target],
      deferred: Bool,
      visit: (in Source, Prog, List[Target], out List[Str]) raises Thrown,
  out status: Int
) :=
  var units: List[List[Target]], source: Source, q: Prog, errors: List[Diagnostic], failed: Buffer[Str] := empty(), bad: List[Str]
  units_of(in found, out units)
  status := 0
  for unit in units do
    load_file(in first_path(unit), true, out source, q, errors)
    if errors != List() then
      report(in first_path(unit), errors, size(files_of(found)) > 1)
      failed := failed ++ files_of(unit), status := max(status, load_status(q, errors))
      if deferred and is_runnable(q, errors) then
        visit(in source, q, unit, out bad)
        status := if bad == List() then status else max(status, 3)
      end
    else
      visit(in source, q, unit, out bad)
      failed := failed ++ bad, status := if bad == List() then status else max(status, 3)
    end
  end
  summarize(in files_of(found), List(for f in failed))

// runs the tests of the module m of q, all or the named ones, each on its own, also after a failed one, and then its lemmas
// if all are run, where passed tells whether all pass and are proven
procedure test_module(
  in  q: Prog,
      m: Id,
      file: Str,
      names: List[Str],
      args: List[Str],
      label: Str,
  out passed: Bool
) :=
  let run := load(q) with args := args
  var tests: List[Cmd], message: Str
  tests := List(for c in definitions(q) if is_selected_test(c, m, names)), passed := true
  for n in names if not exists(tests, lambda c => cmd_name(c) == n) do
    os_println(in label ++ error_text(RuntimeKind, "there is no test " ++ n))
    passed := false
  end
  for c in tests do
    test_message(in run, c, out message)
    if message == "" then
      os_println(in label ++ "test " ++ cmd_name(c) ++ " passed")
    else
      os_println(in label ++ "test " ++ cmd_name(c) ++ " failed: " ++ message)
      passed := false
    end
  end
  if names == List() and not has_errors(q) then
    var proven: Bool
    prove_module(in q, m, file, List(), label, out proven)
    passed := passed and proven
  end

// the error of the test cmd, or else ""
procedure test_message(in run: Run, cmd: Cmd, out message: Str) :=
  var cache: Map[Name, Val] := empty()
  message := ""
  try
    run_cmd(in run, cmd, ref cache)
  catch
    case e =>
      message := error_text(RuntimeKind, runtime_message(e))
    case e =>
      message := error_text(InternalKind, internal_message(e))
  end

// checks the files of the paths, by default of the project, each unit once, where each file must be formatted
procedure check_paths(in paths: List[Str], lint: Bool, out status: Int) :=
  var found: List[Target]
  targets_of(in List(for p in paths yield Target(p, None)), false, out found)
  visit_units(in found, false, lambda in source, q, unit, out failed =>
    failed := List()
    if lint then
      print_lints(in source, q, unit)
    end
  end, out status)

// prints the warnings of the lints of the files of the unit, each with its code, the expression to write instead if it has
// one, and its position
procedure print_lints(in source: Source, q: Prog, unit: List[Target]) :=
  for file in files_of(unit) do
    for d in find(source.mods, lambda d => d.name == sibling(q.main, file)) do
      for w in lints(d) do
        os_println(in file ++ ": warning[" ++ show(w.lint) ++ "]: " ++ w.message ++ replacement_text(source, d.name, w) ++ at_pos(w.pos))
      end
    end
  end

function replacement_text(source: Source, m: Id, w: Warning): Str :=
  match w.replacement
    case Some(r) =>
      ", write " ++ format_module_expr(source, m, r)
    case None =>
      ""
  end

// proves the lemmas of the targets, all or the named ones, by default of the project, each unit loaded once
procedure prove_targets(in targets: List[Target], out status: Int) :=
  var found: List[Target]
  targets_of(in targets, false, out found)
  visit_units(in found, false, lambda in source, q, unit, out failed =>
    prove_unit(in q, unit, found, out failed)
  end, out status)

// proves the lemmas of the files of the unit, whose checked program is q, where failed are the files with open lemmas
procedure prove_unit(
  in  q: Prog,
      unit: List[Target],
      found: List[Target],
  out failed: List[Str]
) :=
  var proven: Bool
  failed := List()
  for file in files_of(unit) do
    prove_module(in q, sibling(q.main, file), file, names_of(file, unit), label_of(file, found), out proven)
    if not proven then
      failed := failed ++ List(file)
    end
  end

// the lemmas up to the last of the named ones, all if none are named, since those before are the facts of the named ones,
// while those after are not needed
function lemmas_upto(lemmas: List[Lemma], names: List[Str]): List[Lemma] :=
  if names == List() then
    lemmas
  else
    match index_of(true, reverse(List(for l in lemmas yield contains(l.name.base, names))))
      case Some(i) =>
        take(size(lemmas) - i, lemmas)
      case None =>
        lemmas
    end

// proves the lemmas of the module m of q, of the file, all or the named ones, in their order, where those before are
// facts, printing whether each is proven, with an error of a proof for each gap and for each function that they reach
// whose termination is not proven, and whether all are proven
procedure prove_module(
  in  q: Prog,
      m: Id,
      file: Str,
      names: List[Str],
      label: Str,
  out proven: Bool
) :=
  let t := translate(q, m), proofs := prove_lemmas(t.decls, t.contracts, lemmas_upto(t.lemmas, names)), ds: List[Diagnostic] := proof_diagnostics(with_proofs(q, m, proofs, names), m)
  proven := ds == List()
  for n in names if not exists(t.lemmas, lambda l => l.name.base == n) do
    os_println(in label ++ error_text(RuntimeKind, "there is no lemma " ++ n))
    proven := false
  end
  for d in ds if d.code == "OpenTermination" do
    os_println(in format_diagnostic(file, d))
  end
  for Proved(name, gaps) in proofs.lemmas if names == List() or contains(name.base, names) do
    if gaps == List() then
      os_println(in label ++ "lemma " ++ name.base ++ " proved")
    else
      os_println(in label ++ "lemma " ++ name.base ++ " open")
      for d in ds if d.code != "OpenTermination" and get("lemma", d.details) == Some(name.base) do
        os_println(in format_diagnostic(file, d))
      end
    end
  end

// translates the file of the target to C, whose main calls the procedure of the target, main by default
procedure compile_target(in target: Target, output: Str, out status: Int) :=
  var q: Prog, errors: List[Diagnostic]
  check_file(in target.path, false, out q, errors)
  report(in target.path, errors, false)
  status := load_status(q, errors)
  if errors == List() then
    try
      compile_prog(in q, EntryProc(value_or(target.name, "main")), output)
    catch
      case UnknownEntry(name) =>
        report(in target.path, List(no_entry(name)), false)
        status := 1

      case OsError(m) =>
        report(in target.path, List(diagnostic(RuntimeKind, m)), false)
        status := 1

      case e =>
        report(in target.path, List(diagnostic(InternalKind, internal_message(e))), false)
        status := 4
    end
  end

// translates the tests of the project to C, whose main runs them as test does, where each unit is checked as test checks
// it, and the commands of each module are taken from the unit that it is a member of, with its tests, or else from the
// first unit that loads it
procedure compile_tests(in output: Str, out status: Int) :=
  var root: Str, found: List[Target], units: List[List[Target]], q: Prog, errors: List[Diagnostic], files: Buffer[TestFile] := empty(), own: Buffer[At[Cmd]] := empty(), others: Map[Id, List[At[Cmd]]] := empty(), members: Set[Id] := empty()
  status := 0
  default_path(out root)
  targets_of(in List(), false, out found)
  units_of(in found, out units)
  for unit in units do
    check_file(in first_path(unit), true, out q, errors)
    if errors != List() then
      report(in first_path(unit), errors, true)
      status := max(status, load_status(q, errors))
    else
      let modules := List(for file in files_of(unit) yield sibling(q.main, file))
      files := files ++ List(for file in files_of(unit) yield TestFile(from_root(root, file), sibling(q.main, file))), own := own ++ List(for c in q.cmds if belongs(c.that, modules)), members := members ++ Set(for m in modules)
      others := others_of(q.cmds, modules, others)
    end
  end
  if status == 0 then
    try
      compile_prog(in Prog(List(for m => cs in others if not contains(m, members) for c in cs yield c) ++ List(for c in own), List(), ""), EntryTests(List(for f in files)), output)
    catch
      case OsError(m) =>
        report(in output, List(diagnostic(RuntimeKind, m)), false)
        status := 1

      case e =>
        report(in output, List(diagnostic(InternalKind, internal_message(e))), false)
        status := 4
    end
  end

// others with the commands of cmds of the modules that are neither in modules nor in others yet, by their modules
function others_of(cmds: List[At[Cmd]], modules: List[Id], others: Map[Id, List[At[Cmd]]]): Map[Id, List[At[Cmd]]] :=
  let fresh := List(for c in cmds for m in cmd_module(c.that) if not contains(m, modules) and get(m, others) == None yield (m, c)) in
  others ++ foldl(reverse(fresh), empty(), lambda found, (m, c) => put(m, List(c; value_or(get(m, found), List())), found))

// whether cmd is a command of one of the modules
function belongs(cmd: Cmd, modules: List[Id]): Bool :=
  match cmd_module(cmd)
    case Some(m) =>
      contains(m, modules)
    case None =>
      false
  end

// the path of file from the root, where file is a path from the working directory and root the root from there
function from_root(root: Str, file: Str): Str :=
  if starts_with(file, root ++ "/") then
    slice(file, size(root) + 1, size(file))
  else
    file

test paths_from_root() :=
  assert from_root(".", "./ulang/ulang.u") == "ulang/ulang.u" and from_root("../..", "../../a/b.u") == "a/b.u"

// the files of the paths, by default of the project, rewritten as format writes them
procedure format_paths(in paths: List[Str], out status: Int) :=
  var found: List[Target], done: Bool, errors: List[Diagnostic]
  targets_of(in List(for p in paths yield Target(p, None)), false, out found)
  status := 0
  for file in files_of(found) do
    errors := List(), done := false
    try
      format_file(in file, out done)
    catch
      case ParseErrors(broken) =>
        errors := List(for e in take(20, broken) yield parse_diagnostic(e))

      case e =>
        errors := List(parse_diagnostic(e))

      case OsError(m) =>
        errors := List(diagnostic(RuntimeKind, m))
    end
    if errors != List() then
      report(in file, errors, false)
      done := false
    end
    status := if done then status else max(status, 1)
  end

// rewrites file as source, if that parses to the same commands as file, so that formatting tests the parser and the printer
procedure format_file(in file: Str, out ok: Bool) :=
  var p: Source, text: Str, source: Str
  os_read_utf8(in file, out text)
  parse_file_text(in file, text, out p)
  require_parsed(in p)
  source := format_program(p), ok := false
  try
    var q: Source
    parse_file_text(in file, source, out q)
    match reformat_error(p, q)
      case Some(d) =>
        report(in file, List(d), false)

      case None =>
        if source != text then
          os_write_utf8(in file, source)
        end
        ok := true
    end
  catch
    case ParseError(message, _) =>
      report(in file, List(unparsable(message)), false)
  end

// the error of formatting the source p to the text whose parse is q, if q has errors or other commands than p
function reformat_error(p: Source, q: Source): Option[Diagnostic] :=
  match parse_errors(q)
    case List(e; _) =>
      Some(unparsable(e.message))

    case List() =>
      if same_mods(p.mods, q.mods) then
        None
      else
        Some(Diagnostic(FormatKind, "ParsesDifferently", None, Pos(0, 0), "the source parses differently", List()))
  end

function unparsable(message: Str): Diagnostic :=
  Diagnostic(FormatKind, "Unparsable", None, Pos(0, 0), "the source does not parse: " ++ message, List())

test reformat_errors() :=
  var p: Source, q: Source, other: Source
  parse_file_text(in "a.u", "procedure main() :=\n  skip\n", out p)
  parse_file_text(in "a.u", "procedure main() :=\n  x = 1\n", out q)
  parse_file_text(in "a.u", "procedure go() :=\n  skip\n", out other)
  assert reformat_error(p, p) == None
  assert map_option(reformat_error(p, q), lambda d => d.code) == Some("Unparsable")
  assert map_option(reformat_error(p, other), lambda d => d.code) == Some("ParsesDifferently")

function same_mod(d: Mod, e: Mod): Bool :=
  d.name == e.name and d.doc == e.doc and d.imports == e.imports and same_sections(d, e)

function same_sections(d: Mod, e: Mod): Bool :=
  same_cmds(d.exported, e.exported) and same_cmds(d.builtins, e.builtins) and same_cmds(d.implemented, e.implemented)

// whether the modules have the same names, imports, and commands with their documentation, whatever their positions
function same_mods(mods: List[Mod], others: List[Mod]): Bool :=
  size(mods) == size(others) and forall(zip(mods, others), lambda (d, e) => same_mod(d, e))

function same_cmds(cmds: List[Doc[Cmd]], others: List[Doc[Cmd]]): Bool :=
  size(cmds) == size(others) and forall(zip(cmds, others), lambda (c, other) => c.doc == other.doc and strip_cmd(c.at.that) == strip_cmd(other.at.that))

// the checked program of file and the errors of loading it, at most 20, where formatted requires each file of its unit, the
// members of its package or file alone if it is a program, to be formatted, after the errors of parsing and checking
procedure check_file(
  in  file: Str,
      formatted: Bool,
  out q: Prog,
      errors: List[Diagnostic]
) :=
  var source: Source
  load_file(in file, formatted, out source, q, errors)

// check_file with the parsed source, which has no modules if file does not parse
procedure load_file(
  in  file: Str,
      formatted: Bool,
  out source: Source,
      q: Prog,
      errors: List[Diagnostic]
) :=
  source := Source(List(), List(), ""), q := Prog(List(), List(), ""), errors := List()
  try
    var text: Str, typed: List[TypeError]
    parse_file(in file, out source)
    if has_errors(source) then
      check_partial(in without_unparsed(source), unparsed_names(source), out q, typed)
      errors := take(20, List(for e in parse_errors(source) yield parse_diagnostic(e)) ++ diagnostics(q))
    else
      check_all(in source, out q, typed)
      errors := take(20, diagnostics(q))
    end
    for m in unit_modules(source) if formatted and errors == List() do
      os_read_utf8(in os_join(os_dirname(file), module_file(m)), out text)
      try
        require_formatted(in source, m, text)
      catch
        case Unformatted(line) =>
          errors := List(
            Diagnostic(FormatKind, "Unformatted", if m == source.main then None else Some(m), Pos(line, 1), "the file differs from what ulang format writes", List()))
      end
    end
  catch
    case ParseErrors(found) =>
      errors := List(for e in take(20, found) yield parse_diagnostic(e))

    case e =>
      errors := List(parse_diagnostic(e))

    case OsError(m) =>
      errors := List(diagnostic(RuntimeKind, m))

    case e =>
      errors := List(diagnostic(InternalKind, internal_message(e)))
  end

// the modules of the unit of the main module of source: the members of its package, or main alone if it is a program
function unit_modules(source: Source): List[Id] :=
  match find(source.packages, lambda p => contains(source.main, p.members))
    case Some(p) =>
      p.members
    case None =>
      List(source.main)
  end

// the name of the file of the module m in its directory
function module_file(m: Id): Str :=
  os_basename(m) ++ ".u"

// the module of file, a file of the directory of the module main
function sibling(main: Id, file: Str): Id :=
  let name := slice(os_basename(file), 0, size(os_basename(file)) - 2) in
  if module_dir(main) == "" then name else module_dir(main) ++ "/" ++ name

// prints the error of loading file, after the lines of the others if there are several files, else alone to stderr
// the errors of loading file, on the output if there are several files, else on the output of errors
procedure report(in file: Str, errors: List[Diagnostic], several: Bool) :=
  for d in errors do
    if several then
      os_println(in format_diagnostic(file, d))
    else
      os_print_error(in format_diagnostic(file, d))
    end
  end

// prints how many of the files passed if there are several
procedure summarize(in files: List[Str], failed: List[Str]) :=
  if size(files) > 1 then
    os_println(in show(size(files) - size(failed)) ++ " of " ++ show(size(files)) ++ " files passed")
  end

// the targets of the targets, by default the root of the project, where a directory is a target without a name for each of
// the .u files below it, without those of the directories that the project runs only compiled if compiled_only is set, and
// any other path a target of its own, so that one that is no file fails to load as a missing file name.u does
procedure targets_of(
  in  targets: List[Target],
      compiled_only: Bool,
  out found: List[Target]
) :=
  var root: Str, files: List[Str], skipped: List[Str], buffer: Buffer[Target] := empty()
  default_path(out root)
  for Target(path, name) in if targets == List() then List(Target(root, None)) else targets do
    match name
      case Some(_) =>
        buffer := buffer ++ List(Target(path, name))

      case None =>
        var dir: Bool
        os_is_dir(in path, out dir)
        if dir then
          skipped := List()
          if compiled_only then
            compiled_only_of(in path, out skipped)
          end
          walk_all(in List(path), skipped, out files)
          buffer := buffer ++ List(for f in files if is_source(f) yield Target(f, None))
        else
          buffer := buffer ++ List(Target(without_dot(path), None))
        end
    end
  end
  found := List(for t in buffer)

test missing_targets() :=
  var found: List[Target]
  targets_of(in List(Target("./nosuch", None), Target("nosuch.u", Some("t"))), false, out found)
  assert found == List(Target("nosuch", None), Target("nosuch.u", Some("t")))

// the targets grouped by the load that they need, in the order of their first targets: those of the members of a package,
// the files with sections of a directory, together, and those of each program, a file without sections, apart
procedure units_of(in targets: List[Target], out units: List[List[Target]]) :=
  var text: Str, keyed: Buffer[Str * Target] := empty()
  for t in targets do
    try
      os_read_utf8(in t.path, out text)
    catch
      case OsError(_) =>
        text := ""
    end
    keyed := keyed ++ List((if has_sections(text) then os_dirname(t.path) ++ "/" else t.path, t))
  end
  units := grouped(List(for k in keyed))

function grouped(keyed: List[Str * Target]): List[List[Target]] :=
  match keyed
    case List() =>
      List()

    case List((key, _); _) =>
      List(
        List(for (k, t) in keyed if k == key yield t); grouped(List(for (k, t) in keyed if k != key)))
  end

function first_path(targets: List[Target]): Str :=
  match targets
    case List(t; _) =>
      t.path
    case List() =>
      ""
  end

// the files of the targets, each once, in the order of their first targets
function files_of(targets: List[Target]): List[Str] :=
  foldl(targets, List(), lambda files, t => if contains(t.path, files) then files else files ++ List(t.path))

// the names that the targets select of file, List() for all, if one target selects all of it
function names_of(file: Str, targets: List[Target]): List[Str] :=
  let mine := List(for t in targets if t.path == file yield t.name) in
  if contains(None, mine) then
    List()
  else
    List(for n in mine for x in n yield x)

// the label of the lines of file, the file if the targets have several files
function label_of(file: Str, targets: List[Target]): Str :=
  if size(files_of(targets)) > 1 then file ++ ": " else ""

// the files of the paths, where directories are walked in the order of names, without the hidden ones, those named out,
// and the skipped ones, which are absolute and normal
procedure walk_all(
  in  paths: List[Str],
      skipped: List[Str],
  out files: List[Str]
) :=
  var here: Str, found: Buffer[Str] := empty(), dir: Bool, below: List[Str]
  os_cwd(out here)
  for path in paths do
    os_is_dir(in path, out dir)
    if dir then
      walk_dir(in path, skipped, here, out below)
      found := found ++ below
    else
      found := found ++ List(path)
    end
  end
  files := List(for file in found yield without_dot(file))

// the path without ./ in front, by which test labels files as the binary of the tests does (normal_target of
// ulang/runtime/ulang.c)
function without_dot(path: Str): Str :=
  if starts_with(path, "./") then
    without_dot(slice(path, 2, size(path)))
  else
    path

test paths_without_dot() :=
  assert without_dot("./ulang/x.u") == "ulang/x.u" and without_dot("././x.u") == "x.u"
  assert without_dot("../x.u") == "../x.u" and without_dot("x.u") == "x.u"

// the files below dir as walk_all walks them, where here is the working directory
procedure walk_dir(
  in  dir: Str,
      skipped: List[Str],
      here: Str,
  out files: List[Str]
) :=
  var entries: List[Str * Bool], found: Buffer[Str] := empty(), below: List[Str]
  os_list(in dir, out entries)
  for (name, is_folder) in entries do
    if not is_folder then
      found := found ++ List(os_join(dir, name))
    else
      if not starts_with(name, ".") and name != "out" and not contains(absolute_path(here, os_join(dir, name)), skipped) then
        walk_dir(in os_join(dir, name), skipped, here, out below)
        found := found ++ below
      end
    end
  end
  files := List(for file in found)

// path from the directory here, absolute and normal
function absolute_path(here: Str, path: Str): Str :=
  normal_path(if starts_with(path, "/") then path else os_join(here, path))

// the root of the project of the working directory, as a path from it, . or a sequence of ..
procedure default_path(out path: Str) :=
  var here: Str, root: Str
  os_cwd(out here)
  project_root(in normal_path(here), out root)
  path := path_up(root, normal_path(here))

// the path from dir up to root, which is dir or a directory above it
function path_up(root: Str, dir: Str): Str :=
  if dir == root then
    "."
  else
    join("/", List(for _ in split(slice(dir, if root == "/" then 1 else size(root) + 1, size(dir)), '/') yield ".."))

test paths_up() :=
  assert path_up("/a", "/a") == "."
  assert path_up("/a", "/a/b/c") == "../.."
  assert path_up("/", "/b") == ".."

// the directories, absolute and normal, that the project of path runs only compiled, as the function project of its
// project.u declares
procedure compiled_only_of(in path: Str, out skipped: List[Str]) :=
  var here: Str, dir: Bool, root: Str, entries: List[Str * Bool]
  skipped := List()
  os_cwd(out here)
  os_is_dir(in path, out dir)
  project_root(in absolute_path(here, if dir then path else os_dirname(path)), out root)
  os_list(in root, out entries)
  if contains(("project.u", false), entries) then
    var errors: List[Diagnostic], q: Prog
    check_file(in os_join(root, "project.u"), false, out q, errors)
    if errors != List() then
      report(in os_join(root, "project.u"), errors, false)
    else
      var v: Option[Val]
      constant_of(in load(q), Name(Some(q.main), "project"), out v)
      match v
        case Some(VObj(_, List(dirs))) =>
          skipped := List(for d in strings_of(dirs) yield normal_path(os_join(root, d)))
        case _ =>
          skip
      end
    end
  end

// the strings of a list value
function strings_of(v: Val): List[Str] :=
  match v
    case VObj(_, List(VLit(LStr(text)), tail)) =>
      List(text; strings_of(tail))
    case _ =>
      List()
  end

// whether cmd is a test of the module m that names selects, all of them for List()
function is_selected_test(cmd: Cmd, m: Id, names: List[Str]): Bool :=
  match cmd
    case CTest(name, _, _) =>
      name.module == Some(m) and (names == List() or contains(name.base, names))
    case _ =>
      false
  end

function cmd_name(cmd: Cmd): Str :=
  match cmd
    case CTest(name, _, _) =>
      name.base
    case _ =>
      ""
  end
