// the driver of ulang, out/ulang.bin, with the commands of usage: run with the interpreter of ulang/run/run.u, check, which
// loads each unit once and adds the phases of its options, the lints of ulang/lint/lint.u, the tests by the tester of
// ulang/test/runner.u, and the proofs by the default proof of ulang/prove/lemma.u, format by format_program of
// ulang/format/format.u, and compile to C, where a file passes if it loads and the phases pass, and the errors that the
// phases must raise are tested by the cases of ulang/test/errors/

import ulang.syntax
import ulang.format
import ulang.parse
import ulang.check
import ulang.run
import ulang.compile
import ulang.lint
import ulang.test
import ulang.refactor

// the command of the arguments, as request reads them
data Request :=
  case RRun(target: Target, args: List[Str])
  // the phases after loading, where names select tests and lemmas, args are those of the tests, and each overlay is a file
  // and the file whose text check takes instead, as of an editor's unsaved buffer
  case RCheck(targets: List[Target], phases: Phases, args: List[Str], overlays: List[(Str, Str)])
  case RFormat(paths: List[Str])
  // the findings of checking the file, as hover and inlay hints, with overlays as those of check
  case RHints(path: Str, overlays: List[(Str, Str)])
  // the procedure of the target, main by default
  case RCompile(target: Target, output: Str)
  // the tests of the .u files below the directory, by default the root of the project
  case RCompileTests(dir: Option[Str], output: Str)
  // the script of the file, or of stdin if none, or the actions of the words, a line from each that starts with @, see ulang/refactor/refactor.u,
  // where each overlay is a file and the file whose text the script takes instead, as of an editor's unsaved buffer
  case RRefactor(script: Option[Str], inline: Option[Str], dry: Bool, overlays: List[(Str, Str)])
  case RHelp(command: Option[Str])
  // arguments that request does not read, with what is wrong with them
  case RUsage(problem: Str)

// the phases of check after loading: the lints of the files that load, as warnings, the tests, and the proofs of the lemmas
data Phases :=
  case Phases(lints: Bool, tests: Bool, proofs: Bool, timeout: Option[Int])

// a file or a directory, or a file name.u with the name of a declaration after its last :
data Target :=
  case Target(path: Str, name: Option[Str])

procedure main() raises OsError :=
  var args: List[Str], status := 0
  os_args(out args)
  match request(args)
    case RRun(target, rest) =>
      run_target(in target, rest, out status)

    case RCheck(targets, phases, rest, overlays) =>
      check_targets(in targets, phases, rest, overlays, out status)

    case RFormat(paths) =>
      format_paths(in paths, out status)

    case RHints(path, overlays) =>
      print_hints(in path, overlays, out status)

    case RCompile(target, output) =>
      compile_target(in target, output, out status)

    case RCompileTests(dir, output) =>
      compile_tests(in dir, output, out status)

    case RRefactor(script, inline, dry, overlays) =>
      refactor(in script, inline, dry, overlays, out status)

    case RHelp(None) =>
      os_println(in usage())

    case RHelp(Some(command)) =>
      os_println(in help(command))

    case RUsage(problem) =>
      os_print_error(in "ulang: " ++ problem ++ "\n" ++ usage())
      os_exit(in 2)
  end
  if status != 0 then
    os_exit(in status)
  end

// the arguments after -- are those of the program, for run and the tests of check
function request(args: List[Str]): Request :=
  match split_on(args, "--")
    case (List(command; words), rest) =>
      if rest != List() and command != "run" and command != "check" then
        RUsage(command ++ " takes no arguments after --")
      else
        command_request(command, words, rest)

    case (List(), _) =>
      RUsage("no command")
  end

function command_request(command: Str, words: List[Str], rest: List[Str]): Request :=
  match (command, words)
    case ("run", List(word)) =>
      let target := target_of(word) in
      if is_source(target.path) then
        RRun(target, rest)
      else
        RUsage("run takes a file name.u, not " ++ word)

    case ("run", _) =>
      RUsage("run takes one file")

    case ("check", _) =>
      check_request(words, Phases(false, false, false, None), List(), List(), rest)

    case ("format", _) =>
      paths_request(command, words, RFormat(words))

    case ("hints", _) =>
      hints_request(words, None, List())

    case ("compile", _) =>
      compile_request(words, None, false, None)

    case ("refactor", _) =>
      refactor_request(words, RRefactor(None, None, false, List()))

    case ("help", List()) =>
      RHelp(None)

    case ("help", List(topic)) =>
      if contains(topic, commands()) then
        RHelp(Some(topic))
      else
        RUsage("unknown command " ++ topic)

    case _ =>
      if contains(command, commands()) then
        RUsage(command ++ " takes other arguments")
      else
        RUsage("unknown command " ++ command)
  end

// the request of a command that takes paths without names and no options
function paths_request(command: Str, paths: List[Str], request: Request): Request :=
  options_request(command, paths, if exists(paths, lambda w => target_of(w).name != None) then
    RUsage(command ++ " takes no names")
  else
    request)

// the request of a command that takes no options, where words are its arguments before --
function options_request(command: Str, words: List[Str], request: Request): Request :=
  if exists(words, lambda w => starts_with(w, "-")) then
    RUsage(command ++ " takes no options")
  else
    request

// the words of check in any order, the options of its phases, the overlays, and the targets, where names select only tests
// and lemmas
function check_request(words: List[Str], phases: Phases, targets: List[Target], overlays: List[(Str, Str)], rest: List[Str]): Request :=
  match words
    case List("--lint"; more) =>
      check_request(more, phases with lints := true, targets, overlays, rest)

    case List("--test"; more) =>
      check_request(more, phases with tests := true, targets, overlays, rest)

    case List("--prove"; more) =>
      check_request(more, phases with proofs := true, targets, overlays, rest)

    case List("--timeout", seconds; more) =>
      match number(seconds)
        case Some(n) if n > 0 =>
          check_request(more, phases with timeout := Some(n), targets, overlays, rest)
        case _ =>
          RUsage("check takes a positive number of seconds after --timeout")
      end

    case List("--overlay", word; more) =>
      match overlay_of(word)
        case Some(overlay) =>
          check_request(more, phases, targets, overlays ++ List(overlay), rest)
        case None =>
          RUsage(overlay_usage("check"))
      end

    case List("--overlay") =>
      RUsage(overlay_usage("check"))

    case List(word; more) =>
      if starts_with(word, "-") then
        RUsage("check does not take " ++ word)
      else
        check_request(more, phases, targets ++ List(target_of(word)), overlays, rest)

    case List() =>
      if rest != List() and not phases.tests then
        RUsage("check takes arguments after -- only with --test")
      else if phases.timeout != None and not phases.tests then
        RUsage("check takes --timeout only with --test")
      else if exists(targets, lambda t => t.name != None) and not (phases.tests or phases.proofs) then
        RUsage("check takes names only with --test or --prove")
      else
        RCheck(targets, phases, rest, overlays)
  end

// the words of hints, the file and the overlays, as those of check
function hints_request(words: List[Str], path: Option[Str], overlays: List[(Str, Str)]): Request :=
  match words
    case List("--overlay", word; more) =>
      match overlay_of(word)
        case Some(overlay) =>
          hints_request(more, path, overlays ++ List(overlay))
        case None =>
          RUsage(overlay_usage("hints"))
      end

    case List("--overlay") =>
      RUsage(overlay_usage("hints"))

    case List(word; more) =>
      if starts_with(word, "-") then
        RUsage("hints does not take " ++ word)
      else if path != None then
        RUsage("hints takes one file")
      else if is_source(word) then
        hints_request(more, Some(word), overlays)
      else
        RUsage("hints takes a file name.u, not " ++ word)

    case List() =>
      match path
        case Some(file) =>
          RHints(file, overlays)
        case None =>
          RUsage("hints takes one file")
      end
  end

// the file F and the file of its text of the word F=<path> of --overlay, as of an editor's unsaved buffer of F
function overlay_of(word: Str): Option[(Str, Str)] :=
  example overlay_of("a.u=/tmp/b") == Some(("a.u", "/tmp/b"))
  example overlay_of("a.u") == None
  example overlay_of("=/tmp/b") == None
  match index_of("=", word)
    case Some(i) if i > 0 =>
      Some((slice(word, 0, i), slice(word, i + 1, size(word))))
    case _ =>
      None
  end

function overlay_usage(command: Str): Str :=
  command ++ " takes --overlay F=<path>, the file F and the file of its text"

// the words of compile in any order, the file with its procedure or --tests with a directory, and -o with the target
function compile_request(words: List[Str], target: Option[Target], tests: Bool, output: Option[Str]): Request :=
  match words
    case List("-o", path; more) =>
      compile_request(more, target, tests, Some(path))

    case List("--tests"; more) =>
      compile_request(more, target, true, output)

    case List(word; more) =>
      if target == None and not starts_with(word, "-") then
        compile_request(more, Some(target_of(word)), tests, output)
      else
        RUsage("compile does not take " ++ word)

    case List() =>
      match (target, output)
        case (_, None) =>
          RUsage("compile takes -o <target.c> or -o <target.s>")

        case (Some(t), Some(path)) if tests =>
          if t.name == None and not is_source(t.path) then
            RCompileTests(Some(t.path), path)
          else
            RUsage("compile --tests takes a directory, whose packages and programs it compiles, not a file")

        case (None, Some(path)) =>
          if tests then
            RCompileTests(None, path)
          else
            RUsage("compile takes a file or --tests")

        case (Some(t), Some(path)) =>
          if is_source(t.path) then
            RCompile(t, path)
          else
            RUsage("compile takes a file name.u, not " ++ t.path)
      end
  end

function target_of(word: Str): Target :=
  match reverse(split(word, ':'))
    case List(name, first; more) =>
      let path := join(":", reverse(List(first; more))) in
      if is_source(path) then Target(path, Some(name)) else Target(word, None)

    case _ =>
      Target(word, None)
  end

test requests() :=
  assert request(List("run", "a.u")) == RRun(Target("a.u", None), List())
  assert request(List("run", "a.u:go", "--", "x")) == RRun(Target("a.u", Some("go")), List("x"))
  assert request(List("check", "--test", "a.u:t", "dir", "b:c")) == RCheck(List(Target("a.u", Some("t")), Target("dir", None), Target("b:c", None)), Phases(false, true, false, None), List(), List())
  assert request(List("check")) == RCheck(List(), Phases(false, false, false, None), List(), List())
  assert request(List("check", "a.u", "--lint")) == RCheck(List(Target("a.u", None)), Phases(true, false, false, None), List(), List())
  assert request(List("check", "--prove", "a.u:l", "--test")) == RCheck(List(Target("a.u", Some("l"))), Phases(false, true, true, None), List(), List())
  assert request(List("format", "a.u")) == RFormat(List("a.u"))
  assert request(List("compile", "-o", "a.c", "--tests")) == RCompileTests(None, "a.c")
  assert request(List("compile", "--tests", "ulang/test", "-o", "a.c")) == RCompileTests(Some("ulang/test"), "a.c")
  assert request(List("compile", "a.u:go", "-o", "a.c")) == RCompile(Target("a.u", Some("go")), "a.c")
  assert request(List("help", "check")) == RHelp(Some("check"))
  assert request(List("hints", "a.u")) == RHints("a.u", List())
  assert request(List("check", "--overlay", "a.u=/tmp/b", "a.u")) == RCheck(List(Target("a.u", None)), Phases(false, false, false, None), List(), List(("a.u", "/tmp/b")))
  assert request(List("hints", "--overlay", "a.u=/tmp/b", "a.u")) == RHints("a.u", List(("a.u", "/tmp/b")))

test usage_errors() :=
  assert request(List()) == RUsage("no command")
  assert request(List("frobnicate")) == RUsage("unknown command frobnicate")
  assert request(List("test", "a.u")) == RUsage("unknown command test")
  assert request(List("check", "a.u", "--", "x")) == RUsage("check takes arguments after -- only with --test")
  assert request(List("check", "a.u:t")) == RUsage("check takes names only with --test or --prove")
  assert request(List("check", "--lint", "a.u:t")) == RUsage("check takes names only with --test or --prove")
  assert request(List("check", "-v", "a.u")) == RUsage("check does not take -v")
  assert request(List("check", "--test", "--timeout", "5", "a.u")) == RCheck(List(Target("a.u", None)), Phases(false, true, false, Some(5)), List(), List())
  assert request(List("check", "--timeout", "5", "a.u")) == RUsage("check takes --timeout only with --test")
  assert request(List("check", "--test", "--timeout", "0")) == RUsage("check takes a positive number of seconds after --timeout")
  assert request(List("check", "--test", "--timeout")) == RUsage("check does not take --timeout")
  assert request(List("format", "--check")) == RUsage("format takes no options")
  assert request(List("format", "a.u", "--", "x")) == RUsage("format takes no arguments after --")
  assert request(List("check", "--test", "a.u", "--", "-v")) == RCheck(List(Target("a.u", None)), Phases(false, true, false, None), List("-v"), List())
  assert request(List("run", "dir")) == RUsage("run takes a file name.u, not dir")
  assert request(List("compile", "a.u")) == RUsage("compile takes -o <target.c> or -o <target.s>")
  assert request(List("compile", "a.u", "--tests", "-o", "a.c")) == RUsage("compile --tests takes a directory, whose packages and programs it compiles, not a file")
  assert request(List("compile", "a.u:t", "--tests", "-o", "a.c")) == RUsage("compile --tests takes a directory, whose packages and programs it compiles, not a file")
  assert request(List("compile", "-o", "a.c")) == RUsage("compile takes a file or --tests")
  assert request(List("hints", "a.u", "b.u")) == RUsage("hints takes one file")
  assert request(List("hints", "a.u:f")) == RUsage("hints takes a file name.u, not a.u:f")
  assert request(List("check", "--overlay", "a.u")) == RUsage("check takes --overlay F=<path>, the file F and the file of its text")
  assert request(List("hints", "a.u", "--overlay")) == RUsage("hints takes --overlay F=<path>, the file F and the file of its text")
  assert request(List("hints")) == RUsage("hints takes one file")
  assert request(List("hints", "-v", "a.u")) == RUsage("hints does not take -v")

// the words of refactor: --dry, --overlay F=path, and a file of the script or an action of its own, @ and its words, added
// to the request so far, an RRefactor
function refactor_request(words: List[Str], request: Request): Request :=
  match words
    case List("--dry"; rest) =>
      refactor_request(rest, request with dry := true)

    case List("--overlay", word; rest) =>
      match overlay_of(word)
        case Some(overlay) =>
          refactor_request(rest, request with overlays := request.overlays ++ List(overlay))
        case None =>
          RUsage(overlay_usage("refactor"))
      end

    case List("--overlay") =>
      RUsage(overlay_usage("refactor"))

    case List(word; rest) =>
      if starts_with(word, "@") then
        request with inline := Some(inline_script(words))
      else if starts_with(word, "-") then
        RUsage("refactor does not take " ++ word)
      else if request.script == None then
        refactor_request(rest, request with script := Some(word))
      else
        RUsage("refactor takes one script")

    case List() =>
      request
  end

// the script of the words of inline actions, a line for each action, each from a word that starts with @ up to the next
function inline_script(words: List[Str]): Str :=
  example inline_script(List("@sig", "a", "@show", "a.u:f", "#2")) == "@sig a\n@show a.u:f #2"
  match words
    case List(word, next; rest) =>
      word ++ (if starts_with(next, "@") then "\n" else " ") ++ inline_script(List(next; rest))

    case List(word) =>
      word

    case List() =>
      ""
  end

test refactor_requests() :=
  assert request(List("refactor", "--dry", "s.txt")) == RRefactor(Some("s.txt"), None, true, List())
  assert request(List("refactor", "@show", "a.u:f")) == RRefactor(None, Some("@show a.u:f"), false, List())
  assert request(List("refactor", "--overlay", "a.u=/tmp/b", "@check", "a.u")) == RRefactor(None, Some("@check a.u"), false, List(("a.u", "/tmp/b")))
  assert request(List("refactor", "--overlay", "a.u")) == RUsage("refactor takes --overlay F=<path>, the file F and the file of its text")
  assert request(List("refactor", "@sig", "a", "@sig", "b")) == RRefactor(None, Some("@sig a\n@sig b"), false, List())
  assert request(List("refactor", "-v", "s.txt")) == RUsage("refactor does not take -v")
  assert request(List("refactor", "--overlay")) == RUsage("refactor takes --overlay F=<path>, the file F and the file of its text")

function commands(): List[Str] :=
  List("run", "check", "format", "hints", "compile", "refactor", "help")

function usage(): Str :=
  "usage:\n" ++ join("\n", List(for c in commands() yield "  ulang " ++ synopsis(c)))

function help(command: Str): Str :=
  "usage: ulang " ++ synopsis(command) ++ "\n\n" ++ description(command)

function synopsis(command: Str): Str :=
  match command
    case "run" =>
      "run <file>[:<procedure>] [-- args]"

    case "check" =>
      "check [--lint] [--test [--timeout <seconds>]] [--prove] [--overlay F=<path> ...] [<path>[:<name>] ...] [-- args]"

    case "format" =>
      "format [<path> ...]"

    case "hints" =>
      "hints [--overlay F=<path> ...] <file>"

    case "compile" =>
      "compile (<file>[:<procedure>] | --tests [<dir>]) -o <target.c|target.s>"

    case "refactor" =>
      "refactor [--dry] [--overlay F=<path> ...] [<script> | @<action> ...]"

    case _ =>
      "help [<command>]"
  end

function description(command: Str): Str :=
  match command
    case "run" =>
      "calls the procedure, main by default, which takes no parameters, where os_args gives the arguments after --"

    case "check" =>
      "checks the files, also below directories, by default the project, each unit loaded once, with the errors of parsing,\n" ++ "of types, and of format, and adds the phases of the options, which run as far as the errors allow: --lint prints the\n" ++ "lints of the files that load, as warnings with the rule and, where it has one, the simpler expression to write, which\n" ++ "do not fail the check; --test runs the tests, all or the named ones, in the working directory, where the arguments\n" ++ "after -- are those of os_args, printing a line per test, each failed if it runs longer than the seconds of --timeout;\n" ++ "--prove proves the lemmas, all or the named ones, where a\n" ++ "recursive function unfolds only if the prover proves that it terminates, unless code that the lemmas may reach has\n" ++ "errors, and a lemma whose test found a counterexample is falsified; a file passes if it loads and its phases pass, and\n" ++ "with several files, check prints the files that do not pass and how many do; --overlay F=<path> takes the text of\n" ++ "the file at path as that of F, as of an unsaved buffer of an editor, and reports its errors against F"

    case "format" =>
      "rewrites the files, also below directories, by default the project, as format_program writes them, where check\n" ++ "reports the files that differ"

    case "hints" =>
      "checks the file as check does and prints what the check found in it, as JSON lines of the hover and the inlay hints\n" ++ "of LSP: the qualified name and the type of each use of a name, the type of each local, formal, and pattern variable,\n" ++ "with an inlay where the source does not write it, and the inferred raises of private procedures, after the errors;\n" ++ "--overlay F=<path> takes the text of the file at path as that of F, as check does, so that hints follow an unsaved buffer"

    case "compile" =>
      "translates the file to C, or to assembly for x86-64 if the target ends in .s, whose main calls the procedure, main by default, or with --tests the tests of the .u files below the directory, by default the root of the project, with its packages and programs,\n" ++ "whose main takes the targets of check --test, but none of its options, with the tests of lemmas but without their proofs, and runs them as\n" ++ "check --test does, from the root of the project"

    case "refactor" =>
      "runs the script of the file, or of stdin, or the actions of the words, a line per action that starts with @,\n" ++ "followed by its fragment: @show T, @outline F, @refs T, @sig name, @sig M, @resolve F:L.C, @put F, @put F:name, @put\n" ++ "[F] before|after T, @put [before|after|into] N, @drop T, @patch T, @example F:name, @rename T new, @export T, @unexport T, @fix T\n" ++ "[Rule ...], @undo [n], and @check [test] [F], where T is a file or a declaration file.u:name[/arity], a node N is\n" ++ "#n, F:name #n, F:name \"text\", or F:L.C, and a module M is a file or a path from the root, prelude/str for the\n" ++ "library, as one transaction, then checks the files that changed and replies with the state and the diagnostics that\n" ++ "are new or gone, exiting 1 while errors remain and 3 if a test failed; inline actions are a line each,\n" ++ "where a last @put, @patch, or @example takes its fragment from stdin; --dry writes nothing and checks the texts that it would write; --overlay F=<path> takes the text of the\n" ++ "file at path as that of F, as of an unsaved buffer, which the script writes only if it changes it; the actions, an\n" ++ "example, and the reply are in Refactoring of README.md"

    case _ =>
      "prints the usage of all commands, or of one"
  end

// calls the procedure of the target, main by default, without parameters, where os_args gives args
procedure run_target(in target: Target, args: List[Str], out status: Int) :=
  var q: Prog, errors: List[Diagnostic], entry := Name(List(), value_or(target.name, "main")), cache: Map[Name, Val] := empty()
  check_file(in target.path, false, false, out q, errors)
  report(in target.path, errors, false)
  status := load_status(q, errors)
  if errors == List() or is_runnable(q, errors) then
    entry := Name(q.main, entry.base)
    try
      require_entry(in q, entry)
      run_proc(in load(q) with args := args, entry, ref cache)
    catch
      case UnknownEntry(name) =>
        report(in target.path, List(no_entry(name)), false)
        status := max(status, 1)

      case e =>
        report(in target.path, List(diagnostic(RuntimeKind, runtime_message(e))), false)
        status := max(status, 3)

      case e =>
        report(in target.path, List(diagnostic(InternalKind, internal_message(e))), false)
        status := 4
    end
  end

// whether the program q, whose diagnostics are errors, runs despite them, where a run raises Deferred at the parts and
// definitions that they make unsafe: if its main module is checked, which it is not if a package that it imports has
// errors, and no error is internal
function is_runnable(q: Prog, errors: List[Diagnostic]): Bool :=
  not exists(errors, lambda d => d.kind == InternalKind) and exists(q.cmds, lambda c => is_parsed(c) and cmd_module(c.that) == Some(q.main))

// the exit status of loading the program q, whose diagnostics are errors: 0 for none, 1 for errors of the sources, and 4 for
// an internal error, where a run, a test, or a lemma that fails is 3 and a usage error 2, and the greatest of several counts
function load_status(q: Prog, errors: List[Diagnostic]): Int :=
  if exists(errors, lambda d => d.kind == InternalKind) then
    4
  else if has_errors(q) or errors != List() then
    1
  else
    0

function no_entry(name: Name): Diagnostic :=
  Diagnostic(RuntimeKind, "UnknownEntry", None, Pos(0, 0), "there is no procedure " ++ name.base ++ " without parameters", List())

// checks the targets, by default the project, each unit loaded once, with the texts of the overlays instead of their
// files, and adds the phases to each unit that loads, also with errors where it is runnable, printing a line per test
// and lemma, labeled by its file if there are several files
procedure check_targets(
  in  targets: List[Target],
      phases: Phases,
      args: List[Str],
      overlays: List[(Str, Str)],
  out status: Int
) :=
  var texts: Map[Str, Str]
  overlay_texts(in overlays, out texts, status)
  if status == 0 then
    var found: List[Target]
    targets_of(in targets, phases.tests, out found)
    visit_units(in found, texts, phases.tests, lambda in source, q, unit, listed, out failed =>
      failed := List()
      if phases.lints and listed == List() then
        print_lints(in source, q, unit)
      end
      if phases.tests or phases.proofs then
        check_unit(in q, unit, found, phases, args, listed, out failed)
      end
    end, out status)
  end

// the texts of the files of the overlays, F and the file of its text, where an overlay that cannot be read is reported,
// with the status 1
procedure overlay_texts(
  in  overlays: List[(Str, Str)],
  out texts: Map[Str, Str],
      status: Int
) :=
  texts := Map(), status := 0
  try
    var text: Str
    for (file, path) in overlays do
      os_read_utf8(in path, out text)
      texts := Map(file => text; texts)
    end
  catch
    case OsError(m) =>
      report(in "", List(diagnostic(RuntimeKind, m)), false)
      status := 1
  end

// runs the tests of the files of the unit, whose checked program is q, and proves their lemmas, but those whose tests
// falsified them, where with both phases the names select the tests and the lemmas of their names, and failed are the
// files that do not pass
procedure check_unit(
  in  q: Prog,
      unit: List[Target],
      found: List[Target],
      phases: Phases,
      args: List[Str],
      listed: List[(Str, Diagnostic)],
  out failed: List[Str]
) :=
  failed := List()
  for file in files_of(unit) do
    let m := sibling(q.main, file), names := names_of(file, unit), label := label_of(file, found), tests := test_names(q, m), lemmas := lemma_names(q, m), both := phases.tests and phases.proofs and names != List()
    var passed := true, ran: Bool, proven: Bool, falsified: Set[Str] := empty()
    for n in names if both and not contains(n, tests) and not contains(n, lemmas) do
      os_println(in label ++ error_text(RuntimeKind, "there is no test or lemma " ++ n))
      passed := false
    end
    for selected in selection(phases.tests, both, names, tests) do
      test_module(in q, m, selected, args, phases.timeout, label, listed, out ran, falsified)
      passed := passed and ran
    end
    for selected in selection(phases.proofs, both, names, lemmas) do
      // the errors fail the file already, with their status, while no lemma failed
      if blocks_proofs(q) then
        os_println(in label ++ "no lemma proven, since code that the lemmas may reach has errors")
      else
        prove_module(in without_rejected_lemmas(q), m, file, selected, falsified, label, out proven)
        passed := passed and proven
      end
    end
    if not passed then
      failed := failed ++ List(file)
      if size(files_of(found)) > 1 then
        os_println(in file ++ ": failed")
      end
    end
  end

// the names that a phase selects, all for List(), if it runs, where with both phases the names select only those of the
// phase, own, and the phase runs only if they select one
function selection(runs: Bool, both: Bool, names: List[Str], own: List[Str]): Option[List[Str]] :=
  example selection(true, true, List("t", "l"), List("l")) == Some(List("l"))
  example selection(true, true, List("t"), List("l")) == None
  example selection(true, false, List(), List("l")) == Some(List())
  if not runs then
    None
  else if both then
    let selected := List(for n in names if contains(n, own)) in
    if selected == List() then None else Some(selected)
  else
    Some(names)

// the names of the tests of the module m of q
function test_names(q: Prog, m: Path): List[Str] :=
  List(for c in q.cmds for n in test_name(c.that, m) yield n)

function test_name(cmd: Cmd, m: Path): Option[Str] :=
  match cmd
    case CTest(name, _, _) =>
      if name.path == m then Some(owned_text(name)) else None
    case _ =>
      None
  end

// the names of the lemmas of the module m of q
function lemma_names(q: Prog, m: Path): List[Str] :=
  List(for c in q.cmds for n in lemma_name(c.that, m) yield n)

function lemma_name(cmd: Cmd, m: Path): Option[Str] :=
  match cmd
    case CLemma(name, _, _, _, _, _) =>
      if name.path == m then Some(name.base) else None
    case _ =>
      None
  end

// whether q has errors that make its code unsafe to run outside its lemmas and tests, which the lemmas could reach, so that
// none is proven, while a lemma with errors of its own is only not proven
function blocks_proofs(q: Prog): Bool :=
  exists(q.cmds, lambda c => not is_lemma_or_test(c.that) and exists(cmd_errors(c), blocks_run))

// q without its lemmas and tests that have errors, which compile_target leaves out of the program
function without_rejected_proofs(q: Prog): Prog :=
  q with cmds := List(for c in q.cmds if not is_lemma_or_test(c.that) or cmd_errors(c) == List())

// q without its lemmas that have errors, which the prover does not prove
function without_rejected_lemmas(q: Prog): Prog :=
  q with cmds := List(for c in q.cmds if not is_lemma(c.that) or cmd_errors(c) == List())

function is_lemma(cmd: Cmd): Bool :=
  match cmd
    case CLemma(_, _, _, _, _, _) =>
      true
    case _ =>
      false
  end

// checks each unit of the targets once, where the error of a unit that does not load is reported at its first file, and
// calls visit with the checked program of each unit that loads, also with errors if it is runnable, whose files then
// fail, and the errors printed of it, each with its file, List() if it loaded without errors, which gives the files of the
// unit that fail, where tested loads them with
// the tests of their lemmas, then prints how many files passed, where status is the exit status of the worst
procedure visit_units(
  in  found: List[Target],
      overlays: Map[Str, Str],
      tested: Bool,
      visit: (in Source, Prog, List[Target], List[(Str, Diagnostic)], out List[Str]),
  out status: Int
) :=
  var units: List[List[Target]], source: Source, q: Prog, errors: List[Diagnostic], failed: Buffer[Str] := empty(), bad: List[Str], cache := no_cache()
  units_of(in found, overlays, out units)
  status := 0
  for unit in units do
    load_file(in first_path(unit), overlays, true, tested, out source, q, errors, ref cache)
    if errors != List() then
      report(in first_path(unit), errors, size(files_of(found)) > 1)
      failed := failed ++ files_of(unit), status := max(status, load_status(q, errors))
      if is_runnable(q, errors) then
        var listed: Buffer[(Str, Diagnostic)] := empty(), path: Str
        for d in errors do
          diagnostic_file(in first_path(unit), d, out path)
          listed := listed ++ List((path, d))
        end
        visit(in source, q, unit, List(for e in listed), out bad)
        status := if bad == List() then status else max(status, 3)
      end
    else
      visit(in source, q, unit, List(), out bad)
      failed := failed ++ bad, status := if bad == List() then status else max(status, 3)
    end
  end
  summarize(in files_of(found), List(for f in failed))

// prints the errors of checking file, as check does, with the texts of the overlays instead of their files, and the
// findings of the check in it, hints of ulang/check/hints.u, as far as it is checked
procedure print_hints(in file: Str, overlays: List[(Str, Str)], out status: Int) :=
  var texts: Map[Str, Str]
  overlay_texts(in overlays, out texts, status)
  if status == 0 then
    var q: Prog, errors: List[Diagnostic], cache := no_cache()
    load_file(in file, texts, false, false, out _, q, errors, ref cache)
    report(in file, errors, false)
    status := load_status(q, errors)
    if q.main != List() then
      try
        var text: Str
        overlaid_text(in file, texts, out text)
        for h in hints(text, q) do
          for line in format_hint(h) do
            os_println(in line)
          end
        end
      catch
        case OsError(m) =>
          os_print_error(in format_diagnostic(file, diagnostic(RuntimeKind, m)))
          status := 1
      end
    end
  end

// prints the warnings of the lints of the files of the unit, each with its code, the expression to write instead if it has
// one, and its position
procedure print_lints(in source: Source, q: Prog, unit: List[Target]) :=
  for file in files_of(unit) do
    for d in find(source.mods, lambda d => d.name == sibling(q.main, file)) do
      for w in lints(d) do
        os_println(in file ++ ": warning[" ++ show(w.lint) ++ "]: " ++ w.message ++ replacement_text(source, d.name, w) ++ at_pos(w.pos))
      end
    end
  end

function replacement_text(source: Source, m: Path, w: Warning): Str :=
  match w.replacement
    case Some(r) =>
      ", write " ++ format_module_expr(source, m, r)
    case None =>
      ""
  end

// translates the file of the target to C, whose main calls the procedure of the target, main by default, also with errors
// that generate no code, those that do not block a run and those of lemmas, tests, and contracts, also of parsing, which
// it reports as warnings
procedure compile_target(in target: Target, output: Str, out status: Int) :=
  var source: Source, q: Prog, errors: List[Diagnostic], cache := no_cache()
  load_file(in target.path, Map(), false, false, out source, q, errors, ref cache)
  let harmless := code_free_diagnostics(q) ++ List(for e in code_free_parse_errors(source) yield parse_diagnostic(e)), blocking := List(for d in errors if blocks_run(d) and not contains(d, harmless))
  report(in target.path, blocking, false)
  warn(in target.path, List(for d in errors if not contains(d, blocking)))
  status := if blocking == List() then 0 else load_status(q, blocking)
  if blocking == List() then
    try
      compile_prog(in without_rejected_proofs(q), EntryProc(value_or(target.name, "main")), output)
    catch
      case UnknownEntry(name) =>
        report(in target.path, List(no_entry(name)), false)
        status := 1

      case OsError(m) =>
        report(in target.path, List(diagnostic(RuntimeKind, m)), false)
        status := 1

      case e =>
        report(in target.path, List(diagnostic(InternalKind, internal_message(e))), false)
        status := 4
    end
  end

// translates the tests of the .u files below the directory, by default the root of the project, also of those that test
// runs only compiled, to C, whose main runs them as test does, where each unit is checked as test checks it, and the
// commands of each module are taken from the unit that it is a member of, with its tests, or else from the first unit that
// loads it
procedure compile_tests(in dir: Option[Str], output: Str, out status: Int) :=
  var root: Str, found: List[Target], units: List[List[Target]], q: Prog, errors: List[Diagnostic], files: Buffer[TestFile] := empty(), own: Buffer[At[Cmd]] := empty(), others: Map[Path, List[At[Cmd]]] := empty(), members: Set[Path] := empty(), cache := no_cache()
  status := 0
  default_path(out root)
  targets_of(in List(for d in dir yield Target(d, None)), false, out found)
  units_of(in found, Map(), out units)
  for unit in units do
    load_file(in first_path(unit), Map(), true, true, out _, q, errors, ref cache)
    if errors != List() then
      report(in first_path(unit), errors, true)
      status := max(status, load_status(q, errors))
    else
      let modules := List(for file in files_of(unit) yield sibling(q.main, file))
      files := files ++ List(for file in files_of(unit) yield TestFile(from_root(root, file), sibling(q.main, file))), own := own ++ List(for c in q.cmds if belongs(c.that, modules)), members := members ++ Set(for m in modules)
      others := others_of(q.cmds, modules, others)
    end
  end
  if status == 0 then
    try
      compile_prog(in Prog(List(for m => cs in others if not contains(m, members) for c in cs yield c) ++ List(for c in own), List(), List(), List()), EntryTests(List(for f in files)), output)
    catch
      // which only the entry of a procedure raises
      case UnknownEntry(name) =>
        report(in output, List(no_entry(name)), false)
        status := 1

      case OsError(m) =>
        report(in output, List(diagnostic(RuntimeKind, m)), false)
        status := 1

      case e =>
        report(in output, List(diagnostic(InternalKind, internal_message(e))), false)
        status := 4
    end
  end

// others with the commands of cmds of the modules that are neither in modules nor in others yet, by their modules
function others_of(cmds: List[At[Cmd]], modules: List[Path], others: Map[Path, List[At[Cmd]]]): Map[Path, List[At[Cmd]]] :=
  let fresh := List(for c in cmds for m in cmd_module(c.that) if not contains(m, modules) and get(m, others) == None yield (m, c)) in
  others ++ foldl(reverse(fresh), empty(), lambda found, (m, c) => put(m, List(c; value_or(get(m, found), List())), found))

// whether cmd is a command of one of the modules
function belongs(cmd: Cmd, modules: List[Path]): Bool :=
  match cmd_module(cmd)
    case Some(m) =>
      contains(m, modules)
    case None =>
      false
  end

// the path of file from the root, where file is a path from the working directory and root the root from there
function from_root(root: Str, file: Str): Str :=
  if starts_with(file, root ++ "/") then
    slice(file, size(root) + 1, size(file))
  else
    file

test paths_from_root() :=
  assert from_root(".", "./ulang/ulang.u") == "ulang/ulang.u" and from_root("../..", "../../a/b.u") == "a/b.u"

// runs the refactor script of the file, of stdin, or of the inline actions, a line each, where the last one, if it is a
// @put, @patch, or @example, takes its fragment from stdin, and prints its reply
procedure refactor(
  in  script: Option[Str],
      inline: Option[Str],
      dry: Bool,
      overlays: List[(Str, Str)],
  out status: Int
) :=
  status := 0
  try
    var text: Str, reply: List[Str], overlay: Str, texts: Map[Str, Str] := Map()
    for (file, path) in overlays do
      os_read_utf8(in path, out overlay)
      texts := Map(file => overlay; texts)
    end
    match (inline, script)
      case (Some(action), _) =>
        text := action
        if exists(List("@put", "@patch", "@example"), lambda word => starts_with(value_or(last(lines(action)), ""), word)) then
          var io: IO, fragment: Str
          io_stdin(out io)
          io_read_utf8(in io, out fragment)
          text := action ++ "\n" ++ fragment
        end

      case (None, Some(path)) =>
        os_read_utf8(in path, out text)

      case (None, None) =>
        var io: IO
        io_stdin(out io)
        io_read_utf8(in io, out text)
    end
    var state: Str
    state_dir(out state)
    run_tested_script(in text, dry, texts, state, checked_diagnostics, refactor_tests, out reply, status)
    os_println(in join("\n", reply))
  catch
    case OsError(m) =>
      report(in "", List(diagnostic(RuntimeKind, m)), false)
      status := 1
  end

// the errors of checking file, each with the file to edit, and the warnings of its lints, whose code is warning[Rule],
// where the format of each member of its unit is checked whatever its other errors, unlike load_file, so that a reply
// compares the format before and after alike, unless a member does not parse
procedure checked_diagnostics(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  var source: Source, errors: List[Diagnostic], path: Str, cache := no_cache()
  load_file(in file, overlays, false, false, out source, _, errors, ref cache)
  if source.main != List() and not has_errors(source) then
    var unformatted: List[Diagnostic]
    try
      format_errors(in file, overlays, source, out unformatted)
    catch
      case OsError(m) =>
        unformatted := List(diagnostic(RuntimeKind, m))
    end
    errors := errors ++ unformatted
  end
  let warnings := List(for d in find(source.mods, lambda d => d.name == source.main) for w in lints(d) yield Diagnostic(FormatKind, "warning[" ++ show(w.lint) ++ "]", None, w.pos, w.message ++ replacement_text(source, d.name, w), List()))
  found := List()
  for d in errors ++ warnings do
    diagnostic_file(in file, d, out path)
    found := found ++ List((path, d))
  end

// the tests of the files of a refactor script, run as check --test runs them, also with deferred errors, where a test that
// fails only by reaching an error of listed, which the reply lists, is counted, not repeated, and the tests that the
// errors leave out of the program, the declared tests and examples that the checker generates only for a package without
// errors, and all tests of a unit that does not run, are counted as not run, with the reason, while the lemmas whose tests
// the errors leave out are named, not counted, since whether a lemma has a test depends on the types of its formals
procedure refactor_tests(
  in  paths: List[Str],
      listed: List[(Str, Diagnostic)],
  out tests: Tests
) :=
  var units: List[List[Target]], source: Source, q: Prog, errors: List[Diagnostic], outcomes: List[Outcome], cache := no_cache()
  var lines: Buffer[Str] := empty(), passed := 0, failed := 0, skipped := 0, unrun: Map[Str, Str] := Map()
  try
    var found: List[Target], compiled: List[Str]
    compiled_only_files(in paths, out compiled)
    lines := lines ++ List(for path in compiled yield "no test of " ++ path ++ " ran, since its project runs its directory only compiled")
    // no target is the whole project to targets_of
    let runnable := List(for path in paths if not contains(path, compiled) yield Target(path, None))
    found := List()
    if runnable != List() then
      targets_of(in runnable, true, out found)
    end
    units_of(in found, Map(), out units)
  catch
    case OsError(m) =>
      units := List(), lines := lines ++ List("no test ran: " ++ m)
  end
  for unit in units do
    load_file(in first_path(unit), Map(), false, true, out source, q, errors, ref cache)
    for file in files_of(unit) do
      let m := sibling(source.main, file)
      let declared := List(for d in find(source.mods, lambda d => d.name == m) for name in declared_tests(d) yield name), examples := sum(List(for d in find(source.mods, lambda d => d.name == m) yield example_count(d)))
      if not is_runnable(q, errors) then
        skipped := skipped + size(declared) + examples, unrun := put(file, "all its tests, since its unit does not load far enough to run", unrun)
        lines := lines ++ List(
          "no test of " ++ file ++ " ran, since its unit does not load far enough to run")
      else
        test_outcomes(in q, m, List(), List(), out outcomes)
        let misplaced := List(for o in outcomes if o.message != "" and exists(diagnostics(q), lambda d => d.code == "ExampleOnDefinition" and reaches(o.reached, file, d)) yield o.name)
        let names := List(for o in outcomes yield o.name), failures := List(for o in outcomes if o.message != "" and not contains(o.name, misplaced) yield failure_text(o, listed))
        let missing := List(for name in declared if not contains(name, names)), absent := examples - size(List(for name in names if index_of(".example.", name) != None yield name))
        let members := value_or(map_option(find(source.packages, lambda p => contains(m, p.members)), lambda p => p.members), List(m))
        let lemmas := if is_generating(q, members) then
          List()
        else
          List(for d in find(source.mods, lambda d => d.name == m) for name in untested_lemmas(d, names) yield name)
        let lemma_tests := match lemmas
          case List() =>
            List()

          case List(name) =>
            List(
              "the test of lemma " ++ name ++ ", if its formals are enumerable")

          case _ =>
            List(
              "the tests of lemmas " ++ join(", ", lemmas) ++ ", if their formals are enumerable")
        end
        let not_run := List(for name in missing yield "test " ++ name) ++ (if absent > 0 then List(counted_text(absent, "example")) else List()) ++ lemma_tests, left := size(missing) + max(absent, 0) + size(misplaced)
        passed := passed + size(outcomes) - size(failures) - size(misplaced), failed := failed + size(failures), skipped := skipped + left
        let counts := show(size(outcomes) - size(failures) - size(misplaced)) ++ " passed, " ++ show(size(failures)) ++ " failed" ++ (if left == 0 then "" else ", " ++ show(left) ++ " not run")
        lines := lines ++ List("tested " ++ file ++ ": " ++ counts) ++ List(for f in failures yield "  " ++ f)
        if not_run != List() then
          unrun := put(file, join(", ", not_run), unrun)
          lines := lines ++ List(
            "  not run, since the errors leave them out of the program: " ++ join(", ", not_run))
        end
        if misplaced != List() then
          lines := lines ++ List(
            "  not run, since they are examples on definitions, which belong to the signatures in export: " ++ join(", ", misplaced))
        end
      end
    end
  end
  tests := Tests(List(for line in lines), passed, failed, skipped, unrun)

// the paths of paths below the directories that their projects run only compiled (compiled_only_of), whose tests a
// refactor script does not run, since the interpreter takes far too long for them, as check --test does not when it walks
procedure compiled_only_files(in paths: List[Str], out compiled: List[Str]) :=
  var here: Str, dirs: List[Str] := List()
  os_cwd(out here)
  for dir in distinct(List(for path in paths yield os_dirname(path))) do
    var skipped: List[Str]
    compiled_only_of(in dir, out skipped)
    dirs := distinct(dirs ++ skipped)
  end
  compiled := List(for path in paths if exists(dirs, lambda d => starts_with(absolute_path(here, path), d ++ "/")) yield path)

test compiled_only_paths() :=
  var compiled: List[Str]
  compiled_only_files(in List("ulang/ulang.u", "ulang/test/errors/types.u"), out compiled)
  assert compiled == List("ulang/test/errors/types.u")

// the tests of examples on a definition, which belong to its signature, are not run, but counted as not run
test misplaced_examples() :=
  var tests: Tests
  let path := "out/test/refactor/misplaced/misplaced.u"
  os_write_utf8(in path, "export\n\nfunction f(x: Int): Int\n\nimplementation\n\nfunction f(x: Int): Int :=\n  example f(1) == 2\n  x + 1\n")
  refactor_tests(in List(path), List(), out tests)
  assert tests == Tests(List(
    "tested " ++ path ++ ": 0 passed, 0 failed, 1 not run",
    "  not run, since they are examples on definitions, which belong to the signatures in export: f.example.1"), 0, 0, 1, Map())

// whether the checker generated the tests of the package of members in q, the tests of examples and of lemmas, which it
// generates only for a package whose check finds no errors but those of raises and unused imports (check_package of
// ulang/check/check.u), which blocks_run of ulang/syntax/error.u tells apart
function is_generating(q: Prog, members: List[Path]): Bool :=
  not exists(diagnostics(q), lambda d => d.kind == TypeKind and blocks_run(d) and contains(value_or(d.module, q.main), members))

// the lemmas of d that claim to hold, which a test l.lemma tests where their formals are enumerable (enumerated_tests of
// ulang/test/generate.u), whose tests are not among the tests names
function untested_lemmas(d: Mod, names: List[Str]): List[Str] :=
  List(for c in d.implemented if is_parsed(c) for name in claimed_lemma(c.that) if not contains(name ++ lemma_suffix(), names) yield name)

function claimed_lemma(cmd: Cmd): Option[Str] :=
  example claimed_lemma(CLemma(Name(List(), "l"), List(), List(), List(), ClaimHolds(List(), nowhere(ELit(LBool(true)))), None)) == Some("l")
  match cmd
    case CLemma(name, _, _, List(), ClaimHolds(_, _), _) =>
      Some(name.base)
    case _ =>
      None
  end

function counted_text(n: Int, noun: Str): Str :=
  example counted_text(2, "example") == "2 examples"
  show(n) ++ " " ++ noun ++ (if n == 1 then "" else "s")

function sum(ns: List[Int]): Int :=
  foldl(ns, 0, lambda a, b => a + b)

// the names of the tests that the module d declares
function declared_tests(d: Mod): List[Str] :=
  List(for c in d.implemented if is_parsed(c) for name in test_of(c.that) yield name)

function test_of(cmd: Cmd): Option[Str] :=
  match cmd
    case CTest(name, _, _) =>
      Some(owned_text(name))
    case _ =>
      None
  end

// the number of examples of the declarations of d, each of which the checker makes a test
function example_count(d: Mod): Int :=
  sum(List(for c in d.exported ++ d.builtins ++ d.implemented if is_parsed(c) yield size(examples_of(c.that))))

function examples_of(cmd: Cmd): List[At[Example]] :=
  match cmd
    case CFun(_, _, _, _, spec, _) =>
      spec.examples

    case CProc(_, _, _, _, _, _, spec, _) =>
      spec.examples

    case CFunSig(_, _, _, _, spec) =>
      spec.examples

    case CProcSig(_, _, _, _, _, _, spec) =>
      spec.examples

    case _ =>
      List()
  end

// the files of the paths, by default of the project, rewritten as format writes them
procedure format_paths(in paths: List[Str], out status: Int) :=
  var found: List[Target], done: Bool, errors: List[Diagnostic]
  targets_of(in List(for p in paths yield Target(p, None)), false, out found)
  status := 0
  for file in files_of(found) do
    errors := List(), done := false
    try
      format_file(in file, out done)
    catch
      case ParseErrors(broken) =>
        errors := List(for e in take(20, broken) yield parse_diagnostic(e))

      case e =>
        errors := List(parse_diagnostic(e))

      case OsError(m) =>
        errors := List(diagnostic(RuntimeKind, m))
    end
    if errors != List() then
      report(in file, errors, false)
      done := false
    end
    status := if done then status else max(status, 1)
  end

// rewrites file as source, if that parses to the same commands as file, so that formatting tests the parser and the printer
procedure format_file(in file: Str, out ok: Bool) :=
  var p: Source, text: Str, source: Str
  os_read_utf8(in file, out text)
  parse_file_text(in file, text, out p)
  require_parsed(in p)
  source := format_program(p), ok := false
  try
    var q: Source
    parse_file_text(in file, source, out q)
    match reformat_error(p, q)
      case Some(d) =>
        report(in file, List(d), false)

      case None =>
        if source != text then
          os_write_utf8(in file, source)
        end
        ok := true
    end
  catch
    case ParseError(message, _) =>
      report(in file, List(unparsable(message)), false)
  end

// the error of formatting the source p to the text whose parse is q, if q has errors or other commands than p
function reformat_error(p: Source, q: Source): Option[Diagnostic] :=
  match parse_errors(q)
    case List(e; _) =>
      Some(unparsable(e.message))

    case List() =>
      if same_mods(p.mods, q.mods) then
        None
      else
        Some(Diagnostic(FormatKind, "ParsesDifferently", None, Pos(0, 0), "the source parses differently", List()))
  end

function unparsable(message: Str): Diagnostic :=
  Diagnostic(FormatKind, "Unparsable", None, Pos(0, 0), "the source does not parse: " ++ message, List())

test reformat_errors() :=
  var p: Source, q: Source, other: Source
  parse_text_recovering(in "procedure main() :=\n  skip\n", out p)
  parse_text_recovering(in "procedure main() :=\n  x = 1\n", out q)
  parse_text_recovering(in "procedure go() :=\n  skip\n", out other)
  assert reformat_error(p, p) == None
  assert map_option(reformat_error(p, q), lambda d => d.code) == Some("Unparsable")
  assert map_option(reformat_error(p, other), lambda d => d.code) == Some("ParsesDifferently")

function same_mod(d: Mod, e: Mod): Bool :=
  d.name == e.name and import_ids(d) == import_ids(e) and same_sections(d, e) and comment_texts(d) == comment_texts(e)

function same_sections(d: Mod, e: Mod): Bool :=
  same_cmds(d.exported, e.exported) and same_cmds(d.builtins, e.builtins) and same_cmds(d.implemented, e.implemented)

// whether the modules have the same names, imports, commands, and comments, whatever their positions
function same_mods(mods: List[Mod], others: List[Mod]): Bool :=
  size(mods) == size(others) and forall(zip(mods, others), lambda (d, e) => same_mod(d, e))

function same_cmds(cmds: List[At[Cmd]], others: List[At[Cmd]]): Bool :=
  size(cmds) == size(others) and forall(zip(cmds, others), lambda (c, other) => strip_cmd(c.that) == strip_cmd(other.that))

function comment_texts(d: Mod): List[Str] :=
  List(for c in d.comments yield c.text)

// the checked program of file and the errors of loading it, at most 20, where formatted requires each file of its unit, the
// members of its package, to be formatted, after the errors of parsing and checking, and
// tested loads it with the tests of its lemmas and the enumeration that they call (ulang/test/generate.u)
procedure check_file(
  in  file: Str,
      formatted: Bool,
      tested: Bool,
  out q: Prog,
      errors: List[Diagnostic]
) :=
  var cache := no_cache()
  load_file(in file, Map(), formatted, tested, out _, q, errors, ref cache)

// what the files of a run before have parsed and checked of the packages that they import, which load_file reuses
data Cache :=
  case Cache(loaded: Loaded, checks: Checks)

function no_cache(): Cache :=
  Cache(Loaded("", Map(), Source(List(), List(), List())), no_checks())

// check_file with the parsed source, which has no modules if file does not parse
procedure load_file(
  in  file: Str,
      overlays: Map[Str, Str],
      formatted: Bool,
      tested: Bool,
  out source: Source,
      q: Prog,
      errors: List[Diagnostic],
  ref cache: Cache
) :=
  source := Source(List(), List(), List()), q := Prog(List(), List(), List(), List()), errors := List()
  try
    var loaded := cache.loaded, checks := cache.checks
    parse_file_loaded(in file, overlays, out source, ref loaded)
    if loaded.root != cache.loaded.root then
      checks := no_checks()
    end
    if tested then
      load_tester(ref source)
    end
    if has_errors(source) then
      check_cached(in without_unparsed(source), unparsed_names(source), true, if tested then enumerated_tests else no_tests, out q, _, ref checks)
      errors := take(20, List(for e in parse_errors(source) yield parse_diagnostic(e)) ++ diagnostics(q))
    else
      check_cached(in source, empty(), false, if tested then enumerated_tests else no_tests, out q, _, ref checks)
      errors := take(20, diagnostics(q))
    end
    cache := Cache(loaded, checks)
    if formatted and errors == List() then
      var unformatted: List[Diagnostic]
      format_errors(in file, overlays, source, out unformatted)
      errors := take(1, unformatted)
    end
  catch
    case ParseErrors(found) =>
      errors := List(for e in take(20, found) yield parse_diagnostic(e))

    case e =>
      errors := List(parse_diagnostic(e))

    case OsError(m) =>
      errors := List(diagnostic(RuntimeKind, m))

    case e =>
      errors := List(diagnostic(InternalKind, internal_message(e)))
  end

// the errors of the members of the unit of the main module of source, of the file file, that format would change
procedure format_errors(
  in  file: Str,
      overlays: Map[Str, Str],
      source: Source,
  out errors: List[Diagnostic]
) raises OsError :=
  var text: Str, found: Buffer[Diagnostic] := empty()
  for m in unit_modules(source) do
    overlaid_text(in os_join(os_dirname(file), module_file(m)), overlays, out text)
    try
      require_formatted(in source, m, text)
    catch
      case Unformatted(line) =>
        found := found ++ List(
          Diagnostic(FormatKind, "Unformatted", if m == source.main then None else Some(m), Pos(line, 1), "the file differs from what ulang format writes", List()))
    end
  end
  errors := List(for d in found)

// the modules of the unit of the main module of source: the members of its package, or main alone if it is in none
function unit_modules(source: Source): List[Path] :=
  match find(source.packages, lambda p => contains(source.main, p.members))
    case Some(p) =>
      p.members
    case None =>
      List(source.main)
  end

// the name of the file of the module m in its directory
function module_file(m: Path): Str :=
  os_basename(join("/", m)) ++ ".u"

// the module of file, a file of the directory of the module main
function sibling(main: Path, file: Str): Path :=
  let name := slice(os_basename(file), 0, size(os_basename(file)) - 2) in
  module_dir(main) ++ List(name)

// prints the error of loading file, after the lines of the others if there are several files, else alone to stderr
// the errors of loading file, on the output if there are several files, else on the output of errors
procedure report(in file: Str, errors: List[Diagnostic], several: Bool) :=
  var path: Str
  for d in errors do
    diagnostic_file(in file, d, out path)
    if several then
      os_println(in format_diagnostic(path, d))
    else
      os_print_error(in format_diagnostic(path, d))
    end
  end

// prints the warnings of loading file, as report prints errors to stderr
procedure warn(in file: Str, warnings: List[Diagnostic]) :=
  var path: Str
  for d in warnings do
    diagnostic_file(in file, d, out path)
    os_print_error(in format_warning(path, d))
  end

// the file to edit for the diagnostic d of loading file: file for one of its own module, which has none, and else the file
// of the module of d, of the library or of the project of file, from the working directory if it is below it, else
// absolute
procedure diagnostic_file(in file: Str, d: Diagnostic, out path: Str) :=
  path := file
  for m in d.module do
    try
      var here: Str, target: Str
      os_cwd(out here)
      if is_library_module(m) then
        var lib: Str
        os_library_dir(out lib)
        target := os_join(lib, library_file(m) ++ ".u")
      else
        var root: Str
        project_root(in os_dirname(normal_path(if starts_with(file, "/") then file else os_join(here, file))), out root)
        target := os_join(root, join("/", m) ++ ".u")
      end
      path := if starts_with(target, here ++ "/") then
        slice(target, size(here) + 1, size(target))
      else
        target
    catch
      case OsError(_) =>
        skip
    end
  end

// prints how many of the files passed if there are several
procedure summarize(in files: List[Str], failed: List[Str]) :=
  if size(files) > 1 then
    os_println(in show(size(files) - size(failed)) ++ " of " ++ show(size(files)) ++ " files passed")
  end

// the targets of the targets, by default the root of the project, where a directory is a target without a name for each of
// the .u files below it, without those of the directories that the project runs only compiled if compiled_only is set, and
// any other path a target of its own, so that one that is no file fails to load as a missing file name.u does
procedure targets_of(
  in  targets: List[Target],
      compiled_only: Bool,
  out found: List[Target]
) :=
  var root: Str, files: List[Str], skipped: List[Str], buffer: Buffer[Target] := empty()
  default_path(out root)
  for Target(path, name) in if targets == List() then List(Target(root, None)) else targets do
    match name
      case Some(_) =>
        buffer := buffer ++ List(Target(path, name))

      case None =>
        var dir: Bool
        os_is_dir(in path, out dir)
        if dir then
          skipped := List()
          if compiled_only then
            compiled_only_of(in path, out skipped)
          end
          walk_all(in List(path), skipped, out files)
          buffer := buffer ++ List(for f in files if is_source(f) yield Target(f, None))
        else
          buffer := buffer ++ List(Target(without_dot(path), None))
        end
    end
  end
  found := List(for t in buffer)

test missing_targets() :=
  var found: List[Target]
  targets_of(in List(Target("./nosuch", None), Target("nosuch.u", Some("t"))), false, out found)
  assert found == List(Target("nosuch", None), Target("nosuch.u", Some("t")))

// the targets grouped by the load that they need, the package of their directory, in the order of their first targets,
// where a target that cannot be read is a unit of its own, which fails to load
procedure units_of(
  in  targets: List[Target],
      overlays: Map[Str, Str],
  out units: List[List[Target]]
) :=
  var keyed: Buffer[(Str, Target)] := empty()
  for t in targets do
    try
      overlaid_text(in t.path, overlays, out _)
      keyed := keyed ++ List((os_dirname(t.path) ++ "/", t))
    catch
      case OsError(_) =>
        keyed := keyed ++ List((t.path, t))
    end
  end
  units := grouped(List(for k in keyed))

function grouped(keyed: List[(Str, Target)]): List[List[Target]] :=
  match keyed
    case List() =>
      List()

    case List((key, _); _) =>
      List(
        List(for (k, t) in keyed if k == key yield t); grouped(List(for (k, t) in keyed if k != key)))
  end

function first_path(targets: List[Target]): Str :=
  match targets
    case List(t; _) =>
      t.path
    case List() =>
      ""
  end

// the files of the targets, each once, in the order of their first targets
function files_of(targets: List[Target]): List[Str] :=
  foldl(targets, List(), lambda files, t => if contains(t.path, files) then files else files ++ List(t.path))

// the names that the targets select of file, List() for all, if one target selects all of it
function names_of(file: Str, targets: List[Target]): List[Str] :=
  let mine := List(for t in targets if t.path == file yield t.name) in
  if contains(None, mine) then
    List()
  else
    List(for n in mine for x in n yield x)

// the label of the lines of file, the file if the targets have several files
function label_of(file: Str, targets: List[Target]): Str :=
  if size(files_of(targets)) > 1 then file ++ ": " else ""

// the files of the paths, where directories are walked in the order of names, without the hidden ones, those named out,
// and the skipped ones, which are absolute and normal
procedure walk_all(
  in  paths: List[Str],
      skipped: List[Str],
  out files: List[Str]
) :=
  var here: Str, found: Buffer[Str] := empty(), dir: Bool, below: List[Str]
  os_cwd(out here)
  for path in paths do
    os_is_dir(in path, out dir)
    if dir then
      walk_dir(in path, skipped, here, out below)
      found := found ++ below
    else
      found := found ++ List(path)
    end
  end
  files := List(for file in found yield without_dot(file))

// the path without ./ in front, by which test labels files as the binary of the tests does (normal_target of
// ulang/runtime/ulang.c)
function without_dot(path: Str): Str :=
  if starts_with(path, "./") then
    without_dot(slice(path, 2, size(path)))
  else
    path

test paths_without_dot() :=
  assert without_dot("./ulang/x.u") == "ulang/x.u" and without_dot("././x.u") == "x.u"
  assert without_dot("../x.u") == "../x.u" and without_dot("x.u") == "x.u"

// the files below dir as walk_all walks them, where here is the working directory
procedure walk_dir(
  in  dir: Str,
      skipped: List[Str],
      here: Str,
  out files: List[Str]
) :=
  var entries: List[(Str, Bool)], found: Buffer[Str] := empty(), below: List[Str]
  os_list(in dir, out entries)
  for (name, is_folder) in entries do
    if not is_folder then
      found := found ++ List(os_join(dir, name))
    else
      if not starts_with(name, ".") and name != "out" and not contains(absolute_path(here, os_join(dir, name)), skipped) then
        walk_dir(in os_join(dir, name), skipped, here, out below)
        found := found ++ below
      end
    end
  end
  files := List(for file in found)

// path from the directory here, absolute and normal
function absolute_path(here: Str, path: Str): Str :=
  normal_path(if starts_with(path, "/") then path else os_join(here, path))

// the root of the project of the working directory, as a path from it, . or a sequence of ..
procedure default_path(out path: Str) :=
  var here: Str, root: Str
  os_cwd(out here)
  project_root(in normal_path(here), out root)
  path := path_up(root, normal_path(here))

// the path from dir up to root, which is dir or a directory above it
function path_up(root: Str, dir: Str): Str :=
  if dir == root then
    "."
  else
    join("/", List(for _ in split(slice(dir, if root == "/" then 1 else size(root) + 1, size(dir)), '/') yield ".."))

test paths_up() :=
  assert path_up("/a", "/a") == "."
  assert path_up("/a", "/a/b/c") == "../.."
  assert path_up("/", "/b") == ".."

// the directories, absolute and normal, that the project of path runs only compiled, as the function project of its
// project.u declares
procedure compiled_only_of(in path: Str, out skipped: List[Str]) :=
  var here: Str, dir: Bool, root: Str, entries: List[(Str, Bool)]
  skipped := List()
  os_cwd(out here)
  os_is_dir(in path, out dir)
  project_root(in absolute_path(here, if dir then path else os_dirname(path)), out root)
  os_list(in root, out entries)
  if contains(("project.u", false), entries) then
    var errors: List[Diagnostic], q: Prog
    check_file(in os_join(root, "project.u"), false, false, out q, errors)
    if errors != List() then
      report(in os_join(root, "project.u"), errors, false)
    else
      var v: Option[Val]
      try
        constant_of(in load(q), Name(q.main, "project"), out v)
      catch
        case Thrown(value, _) =>
          report(in os_join(root, "project.u"), List(
            diagnostic(RuntimeKind, runtime_message(Uncaught(format_value(value))))), false)
          v := None

        case e =>
          report(in os_join(root, "project.u"), List(diagnostic(RuntimeKind, runtime_message(e))), false)
          v := None

        case e =>
          report(in os_join(root, "project.u"), List(diagnostic(InternalKind, internal_message(e))), false)
          v := None
      end
      match v
        case Some(VObj(_, List(dirs))) =>
          skipped := List(for d in strings_of(dirs) yield normal_path(os_join(root, d)))
        case _ =>
          skip
      end
    end
  end

// the strings of a list value
function strings_of(v: Val): List[Str] :=
  match v
    case VObj(_, List(VLit(LStr(text)), tail)) =>
      List(text; strings_of(tail))
    case _ =>
      List()
  end
