// the driver of ulang, out/ulang.bin, with the commands of usage: run, test, and check with the interpreter of
// ulang/run/run.u, prove by the default proof of ulang/prove/lemma.u, as test does after the tests, format by
// format_program of ulang/format/format.u, and compile to C, where a file passes if it loads, its tests pass, and its
// lemmas are proven, and the errors that the phases must raise are tested by the cases of ulang/test/errors/

import "ulang/syntax"
import "ulang/format"
import "ulang/parse"
import "ulang/check"
import "ulang/run"
import "ulang/compile"
import "ulang/prove"

// the command of the arguments, as request reads them
data Request :=
  case RRun(target: Target, args: List[Str])
  case RTest(targets: List[Target], args: List[Str])
  case RCheck(paths: List[Str])
  case RProve(targets: List[Target])
  case RFormat(paths: List[Str], check_only: Bool)
  // the procedure of the target, main by default
  case RCompile(target: Target, output: Str)
  // the tests of the project
  case RCompileTests(output: Str)
  case RHelp(command: Option[Str])
  // arguments that request does not read, with what is wrong with them
  case RUsage(problem: Str)

// a file or a directory, or a file name.u with the name of a declaration after its last :
data Target :=
  case Target(path: Str, name: Option[Str])

procedure main() :=
  local args: List[Str], ok := true
  call os_args(out args)
  match request(args)
    case RRun(target, rest) =>
      call run_target(in target, rest, out ok)

    case RTest(targets, rest) =>
      call test_targets(in targets, rest, out ok)

    case RCheck(paths) =>
      call check_paths(in paths, out ok)

    case RProve(targets) =>
      call prove_targets(in targets, out ok)

    case RFormat(paths, check_only) =>
      call format_paths(in paths, check_only, out ok)

    case RCompile(target, output) =>
      call compile_target(in target, output, out ok)

    case RCompileTests(output) =>
      call compile_tests(in output, out ok)

    case RHelp(None) =>
      call os_println(in usage())

    case RHelp(Some(command)) =>
      call os_println(in help(command))

    case RUsage(problem) =>
      call os_print_error(in "ulang: " ++ problem ++ "\n" ++ usage())
      call os_exit(in 2)
  end
  if not ok then
    call os_exit(in 1)
  end

// the arguments after -- are those of the program, for run and test
function request(args: List[Str]): Request :=
  match split_on(args, "--")
    case (List(command; words), rest) =>
      if rest != List() and command != "run" and command != "test" then
        RUsage(command ++ " takes no arguments after --")
      else
        command_request(command, words, rest)

    case (List(), _) =>
      RUsage("no command")
  end

function command_request(command: Str, words: List[Str], rest: List[Str]): Request :=
  match (command, words)
    case ("run", List(word)) =>
      let target := target_of(word) in
      if is_source(target.path) then
        RRun(target, rest)
      else
        RUsage("run takes a file name.u, not " ++ word)

    case ("run", _) =>
      RUsage("run takes one file")

    case ("test", _) =>
      RTest(List(for w in words yield target_of(w)), rest)

    case ("check", _) =>
      if exists(words, lambda w => target_of(w).name != None) then
        RUsage("check takes no names")
      else
        RCheck(words)

    case ("prove", _) =>
      RProve(List(for w in words yield target_of(w)))

    case ("format", List("--check"; paths)) =>
      RFormat(paths, true)

    case ("format", _) =>
      RFormat(words, false)

    case ("compile", _) =>
      compile_request(words, None, false, None)

    case ("help", List()) =>
      RHelp(None)

    case ("help", List(topic)) =>
      if contains(topic, commands()) then
        RHelp(Some(topic))
      else
        RUsage("unknown command " ++ topic)

    case _ =>
      if contains(command, commands()) then
        RUsage(command ++ " takes other arguments")
      else
        RUsage("unknown command " ++ command)
  end

// the words of compile in any order, the file with its procedure or --tests, and -o with the target
function compile_request(words: List[Str], target: Option[Target], tests: Bool, output: Option[Str]): Request :=
  match words
    case List("-o", path; more) =>
      compile_request(more, target, tests, Some(path))

    case List("--tests"; more) =>
      compile_request(more, target, true, output)

    case List(word; more) =>
      if target == None and not starts_with(word, "-") then
        compile_request(more, Some(target_of(word)), tests, output)
      else
        RUsage("compile does not take " ++ word)

    case List() =>
      match (target, output)
        case (_, None) =>
          RUsage("compile takes -o <target.c>")

        case (Some(_), _) if tests =>
          RUsage("compile --tests takes no file, since it compiles the tests of the project")

        case (None, Some(path)) =>
          if tests then
            RCompileTests(path)
          else
            RUsage("compile takes a file or --tests")

        case (Some(t), Some(path)) =>
          if is_source(t.path) then
            RCompile(t, path)
          else
            RUsage("compile takes a file name.u, not " ++ t.path)
      end
  end

function target_of(word: Str): Target :=
  match reverse(split(word, ':'))
    case List(name, first; more) =>
      let path := join(":", reverse(List(first; more))) in
      if is_source(path) then Target(path, Some(name)) else Target(word, None)

    case _ =>
      Target(word, None)
  end

test requests() :=
  assert request(List("run", "a.u")) == RRun(Target("a.u", None), List())
  assert request(List("run", "a.u:go", "--", "x")) == RRun(Target("a.u", Some("go")), List("x"))
  assert request(List("test", "a.u:t", "dir", "b:c")) == RTest(List(Target("a.u", Some("t")), Target("dir", None), Target("b:c", None)), List())
  assert request(List("check")) == RCheck(List())
  assert request(List("format", "--check", "a.u")) == RFormat(List("a.u"), true)
  assert request(List("compile", "-o", "a.c", "--tests")) == RCompileTests("a.c")
  assert request(List("compile", "a.u:go", "-o", "a.c")) == RCompile(Target("a.u", Some("go")), "a.c")
  assert request(List("help", "prove")) == RHelp(Some("prove"))

test usage_errors() :=
  assert request(List()) == RUsage("no command")
  assert request(List("frobnicate")) == RUsage("unknown command frobnicate")
  assert request(List("check", "a.u", "--", "x")) == RUsage("check takes no arguments after --")
  assert request(List("check", "a.u:t")) == RUsage("check takes no names")
  assert request(List("run", "dir")) == RUsage("run takes a file name.u, not dir")
  assert request(List("compile", "a.u")) == RUsage("compile takes -o <target.c>")
  assert request(List("compile", "a.u", "--tests", "-o", "a.c")) == RUsage("compile --tests takes no file, since it compiles the tests of the project")
  assert request(List("compile", "-o", "a.c")) == RUsage("compile takes a file or --tests")

function commands(): List[Str] :=
  List("run", "test", "check", "prove", "format", "compile", "help")

function usage(): Str :=
  "usage:\n" ++ join("\n", List(for c in commands() yield "  ulang " ++ synopsis(c)))

function help(command: Str): Str :=
  "usage: ulang " ++ synopsis(command) ++ "\n\n" ++ description(command)

function synopsis(command: Str): Str :=
  match command
    case "run" =>
      "run <file>[:<procedure>] [-- args]"

    case "test" =>
      "test [<path>[:<name>] ...] [-- args]"

    case "check" =>
      "check [<path> ...]"

    case "prove" =>
      "prove [<path>[:<lemma>] ...]"

    case "format" =>
      "format [--check] [<path> ...]"

    case "compile" =>
      "compile (<file>[:<procedure>] | --tests) -o <target.c>"

    case _ =>
      "help [<command>]"
  end

function description(command: Str): Str :=
  match command
    case "run" =>
      "calls the procedure, main by default, which takes no parameters, where os_args gives the arguments after --"

    case "test" =>
      "runs the tests of the files, all or the named ones, also below directories, by default the project, in the working\n" ++ "directory, printing a line per test and lemma, where a file passes if it loads and its tests pass and its lemmas are\n" ++ "proven; with several files, it prints the files that do not pass and how many do"

    case "check" =>
      "checks the files, also below directories, by default the project"

    case "prove" =>
      "proves the lemmas of the files, all or the named ones, also below directories, by default the project; functions are\n" ++ "not yet checked to terminate, so a lemma about one that does not may be proven falsely"

    case "format" =>
      "rewrites the files, also below directories, by default the project, as format_program writes them; with --check, it\n" ++ "only reports the files that differ"

    case "compile" =>
      "translates the file to C, whose main calls the procedure, main by default, or with --tests the tests of the project,\n" ++ "whose main takes the arguments of test, without lemmas, and runs them as test does, from the root of the project"

    case _ =>
      "prints the usage of all commands, or of one"
  end

// the elements before the first sep, and those after it, none if xs has no sep
function split_on[A](xs: List[A], sep: A): List[A] * List[A] :=
  match xs
    case List() =>
      (List(), List())

    case List(x; more) =>
      if x == sep then
        (List(), more)
      else
        match split_on(more, sep)
          case (before, after) =>
            (List(x; before), after)
        end
  end

// calls the procedure of the target, main by default, without parameters, where os_args gives args
procedure run_target(in target: Target, args: List[Str], out ok: Bool) :=
  local q: Prog, errors: List[Diagnostic], error := "", entry := Name(None, value_or(target.name, "main")), cache: Map[Name, Val] := empty()
  call   check_file(in target.path, false, out q, errors)
  call   report(in target.path, errors, false)
  assign ok := false
  if errors == List() then
    assign entry := Name(Some(q.main), entry.base)
    try
      call   require_entry(in q, entry)
      call   run_proc(in load(q) with args := args, entry, ref cache)
      assign ok := true
    catch
      case UnknownEntry(name) =>
        assign error := error_text(RuntimeKind, "there is no procedure " ++ name.base ++ " without parameters")

      case e =>
        assign error := error_text(RuntimeKind, runtime_message(e))

      case e =>
        assign error := error_text(InternalKind, internal_message(e))
    end
  end
  if error != "" then
    call os_print_error(in target.path ++ ": " ++ error)
  end

// runs the tests of the targets, by default of the project, each unit loaded once, in the working directory, and the lemmas
// of each file whose tests all run, printing a line per test and lemma, labeled by its file if there are several files
procedure test_targets(in targets: List[Target], args: List[Str], out ok: Bool) :=
  local found: List[Target]
  call targets_of(in targets, true, out found)
  call visit_units(in found, lambda in q, unit, out failed =>
    call test_unit(in q, unit, found, args, out failed)
  end, out ok)

// runs the tests of the files of the unit, whose checked program is q, where failed are the files that do not pass
procedure test_unit(
  in  q: Prog,
      unit: List[Target],
      found: List[Target],
      args: List[Str],
  out failed: List[Str]
) :=
  local passed: Bool
  assign failed := List()
  for file in files_of(unit) do
    call test_module(in q, sibling(q.main, file), names_of(file, unit), args, label_of(file, found), out passed)
    if not passed then
      assign failed := failed ++ List(file)
      if size(files_of(found)) > 1 then
        call os_println(in file ++ ": failed")
      end
    end
  end

// checks each unit of the targets once, where the error of a unit that does not load is reported at its first file, and
// calls visit with the checked program of each unit that loads, which gives the files of the unit that fail, then prints
// how many files passed, where ok tells whether all did
procedure visit_units(
  in  found: List[Target],
      visit: (in Prog, List[Target], out List[Str]) raises Thrown,
  out ok: Bool
) :=
  local units: List[List[Target]], q: Prog, errors: List[Diagnostic], failed: Buffer[Str] := empty(), bad: List[Str]
  call units_of(in found, out units)
  for unit in units do
    call check_file(in first_path(unit), true, out q, errors)
    if errors != List() then
      call   report(in first_path(unit), errors, size(files_of(found)) > 1)
      assign failed := failed ++ files_of(unit)
    else
      call   visit(in q, unit, out bad)
      assign failed := failed ++ bad
    end
  end
  call   summarize(in files_of(found), List(for f in failed))
  assign ok := size(failed) == 0

// runs the tests of the module m of q, all or the named ones, each on its own, also after a failed one, and then its lemmas
// if all are run, where passed tells whether all pass and are proven
procedure test_module(
  in  q: Prog,
      m: Id,
      names: List[Str],
      args: List[Str],
      label: Str,
  out passed: Bool
) :=
  local run := (load(q) with args := args), tests: List[Cmd], message: Str, proven: Bool
  assign tests := List(for c in q.cmds if is_selected_test(c, m, names)), passed := true
  for n in names if not exists(tests, lambda c => cmd_name(c) == n) do
    call   os_println(in label ++ error_text(RuntimeKind, "there is no test " ++ n))
    assign passed := false
  end
  for c in tests do
    call test_message(in run, c, out message)
    if message == "" then
      call os_println(in label ++ "test " ++ cmd_name(c) ++ " passed")
    else
      call   os_println(in label ++ "test " ++ cmd_name(c) ++ " failed: " ++ message)
      assign passed := false
    end
  end
  if names == List() then
    call   prove_module(in q, m, List(), label, out proven)
    assign passed := passed and proven
  end

// the error of the test cmd, or else ""
procedure test_message(in run: Run, cmd: Cmd, out message: Str) :=
  local cache: Map[Name, Val] := empty()
  assign message := ""
  try
    call run_cmd(in run, cmd, ref cache)
  catch
    case e =>
      assign message := error_text(RuntimeKind, runtime_message(e))
    case e =>
      assign message := error_text(InternalKind, internal_message(e))
  end

// checks the files of the paths, by default of the project, each unit once, where each file must be formatted
procedure check_paths(in paths: List[Str], out ok: Bool) :=
  local found: List[Target]
  call targets_of(in List(for p in paths yield Target(p, None)), false, out found)
  call visit_units(in found, lambda in q, unit, out failed =>
    assign failed := List()
  end, out ok)

// proves the lemmas of the targets, all or the named ones, by default of the project, each unit loaded once
procedure prove_targets(in targets: List[Target], out ok: Bool) :=
  local found: List[Target]
  call targets_of(in targets, false, out found)
  call visit_units(in found, lambda in q, unit, out failed =>
    call prove_unit(in q, unit, found, out failed)
  end, out ok)

// proves the lemmas of the files of the unit, whose checked program is q, where failed are the files with open lemmas
procedure prove_unit(
  in  q: Prog,
      unit: List[Target],
      found: List[Target],
  out failed: List[Str]
) :=
  local proven: Bool
  assign failed := List()
  for file in files_of(unit) do
    call prove_module(in q, sibling(q.main, file), names_of(file, unit), label_of(file, found), out proven)
    if not proven then
      assign failed := failed ++ List(file)
    end
  end

// proves the lemmas of the module m of q, all or the named ones, in their order, where those before are facts, printing
// whether each is proven, and whether all are
procedure prove_module(
  in  q: Prog,
      m: Id,
      names: List[Str],
      label: Str,
  out proven: Bool
) :=
  local t := translate(q, m)
  assign proven := true
  for n in names if not exists(t.lemmas, lambda l => l.name.base == n) do
    call   os_println(in label ++ error_text(RuntimeKind, "there is no lemma " ++ n))
    assign proven := false
  end
  for Proved(name, goal) in prove_lemmas(t.decls, t.lemmas) if names == List() or contains(name.base, names) do
    if goal == true_seq() then
      call os_println(in label ++ "lemma " ++ name.base ++ " proved")
    else
      call   os_println(in label ++ "lemma " ++ name.base ++ " open: " ++ print_seq(goal))
      assign proven := false
    end
  end

// translates the file of the target to C, whose main calls the procedure of the target, main by default
procedure compile_target(in target: Target, output: Str, out ok: Bool) :=
  local q: Prog, errors: List[Diagnostic], error := ""
  call   check_file(in target.path, false, out q, errors)
  call   report(in target.path, errors, false)
  assign ok := false
  if errors == List() then
    try
      call   compile_prog(in q, EntryProc(value_or(target.name, "main")), output)
      assign ok := true
    catch
      case UnknownEntry(name) =>
        assign error := error_text(RuntimeKind, "there is no procedure " ++ name.base ++ " without parameters")

      case OsError(m) =>
        assign error := error_text(RuntimeKind, m)

      case e =>
        assign error := error_text(InternalKind, internal_message(e))
    end
  end
  if error != "" then
    call os_print_error(in target.path ++ ": " ++ error)
  end

// translates the tests of the project to C, whose main runs them as test does, where each unit is checked as test checks
// it, and the commands of each module are taken from the unit that it is a member of, with its tests, or else from the
// first unit that loads it
procedure compile_tests(in output: Str, out ok: Bool) :=
  local root: Str, found: List[Target], units: List[List[Target]], q: Prog, errors: List[Diagnostic], failed := false, files: Buffer[TestFile] := empty(), own: Buffer[Cmd] := empty(), others: Map[Id, List[Cmd]] := empty(), members: Set[Id] := empty()
  call default_path(out root)
  call targets_of(in List(), false, out found)
  call units_of(in found, out units)
  for unit in units do
    call check_file(in first_path(unit), true, out q, errors)
    if errors != List() then
      call   report(in first_path(unit), errors, true)
      assign failed := true
    else
      local modules := List(for file in files_of(unit) yield sibling(q.main, file))
      assign files := files ++ List(for file in files_of(unit) yield TestFile(from_root(root, file), sibling(q.main, file))), own := own ++ List(for c in q.cmds if belongs(c, modules)), members := members ++ Set(for m in modules)
      assign others := others_of(q.cmds, modules, others)
    end
  end
  assign ok := false
  if not failed then
    try
      call   compile_prog(in Prog(List(for m => cs in others if not contains(m, members) for c in cs yield c) ++ List(for c in own), ""), EntryTests(List(for f in files)), output)
      assign ok := true
    catch
      case OsError(m) =>
        call os_print_error(in output ++ ": " ++ error_text(RuntimeKind, m))
      case e =>
        call os_print_error(in output ++ ": " ++ error_text(InternalKind, internal_message(e)))
    end
  end

// others with the commands of cmds of the modules that are neither in modules nor in others yet, by their modules
function others_of(cmds: List[Cmd], modules: List[Id], others: Map[Id, List[Cmd]]): Map[Id, List[Cmd]] :=
  let fresh := List(for c in cmds for m in cmd_module(c) if not contains(m, modules) and get(m, others) == None yield (m, c)) in
  others ++ foldl(reverse(fresh), empty(), lambda found, (m, c) => put(m, List(c; value_or(get(m, found), List())), found))

// whether cmd is a command of one of the modules
function belongs(cmd: Cmd, modules: List[Id]): Bool :=
  match cmd_module(cmd)
    case Some(m) =>
      contains(m, modules)
    case None =>
      false
  end

// the module of cmd, None for a notation, which the checked program no longer needs
function cmd_module(cmd: Cmd): Option[Id] :=
  match cmd
    case CSort(name, _, _) =>
      name.module

    case CData(name, _, _) =>
      name.module

    case CFun(name, _, _, _, _) =>
      name.module

    case CProc(name, _, _, _, _, _, _) =>
      name.module

    case CNotation(_, _, _) =>
      None

    case CTest(name, _, _) =>
      name.module

    case CFunSig(name, _, _, _) =>
      name.module

    case CProcSig(name, _, _, _, _, _) =>
      name.module

    case CAbstract(name, _) =>
      name.module

    case CPatAlias(name, _, _, _, _) =>
      name.module

    case CLemma(name, _, _, _, _) =>
      name.module
  end

// the path of file from the root, where file is a path from the working directory and root the root from there
function from_root(root: Str, file: Str): Str :=
  if starts_with(file, root ++ "/") then
    slice(file, size(root) + 1, size(file))
  else
    file

test paths_from_root() :=
  assert from_root(".", "./ulang/ulang.u") == "ulang/ulang.u" and from_root("../..", "../../a/b.u") == "a/b.u"

// the files of the paths, by default of the project, rewritten as format writes them, or for check_only reported if they
// differ
procedure format_paths(in paths: List[Str], check_only: Bool, out ok: Bool) :=
  local found: List[Target], done: Bool, error: Str
  call   targets_of(in List(for p in paths yield Target(p, None)), false, out found)
  assign ok := true
  for file in files_of(found) do
    assign error := "", done := false
    try
      if check_only then
        call   check_format(in file)
        assign done := true
      else
        call format_file(in file, out done)
      end
    catch
      case e =>
        assign error := format_diagnostic(parse_diagnostic(e))

      case OsError(m) =>
        assign error := format_diagnostic(diagnostic(RuntimeKind, m))

      case Unformatted(line) =>
        assign error := format_diagnostic(Diagnostic(FormatKind, "Unformatted", None, Pos(line, 1), "the file differs from what ulang format writes", List()))
    end
    if error != "" then
      call   os_print_error(in file ++ ": " ++ error)
      assign done := false
    end
    assign ok := ok and done
  end

// raises Unformatted if format would change file
procedure check_format(in file: Str) :=
  local source: Source, text: Str
  call os_read(in file, out text)
  call parse_file_text(in file, text, out source)
  call require_formatted(in source, source.main, text)

// rewrites file as source, if that parses to the same commands as file, so that formatting tests the parser and the printer
procedure format_file(in file: Str, out ok: Bool) :=
  local p: Source, q: Source, text: Str, source: Str
  call   os_read(in file, out text)
  call   parse_file_text(in file, text, out p)
  assign source := format_program(p), ok := false
  try
    call parse_file_text(in file, source, out q)
    if same_mods(p.mods, q.mods) then
      if source != text then
        call os_write(in file, source)
      end
      assign ok := true
    else
      call os_print_error(in file ++ ": " ++ error_text(FormatKind, "the source parses differently"))
    end
  catch
    case ParseError(message, _) =>
      call os_print_error(in file ++ ": " ++ error_text(FormatKind, "the source does not parse: " ++ message))
  end

function same_mod(d: Mod, e: Mod): Bool :=
  d.name == e.name and d.doc == e.doc and d.imports == e.imports and same_sections(d, e)

function same_sections(d: Mod, e: Mod): Bool :=
  same_cmds(d.exported, e.exported) and same_cmds(d.builtins, e.builtins) and same_cmds(d.implemented, e.implemented)

// whether the modules have the same names, imports, and commands with their documentation, whatever their positions
function same_mods(mods: List[Mod], others: List[Mod]): Bool :=
  size(mods) == size(others) and forall(zip(mods, others), lambda (d, e) => same_mod(d, e))

function same_cmds(cmds: List[Doc[Cmd]], others: List[Doc[Cmd]]): Bool :=
  size(cmds) == size(others) and forall(zip(cmds, others), lambda (c, other) => c.doc == other.doc and strip_cmd(c.at.that) == strip_cmd(other.at.that))

// the checked program of file and the errors of loading it, at most 20, where formatted requires each file of its unit, the
// members of its package or file alone if it is a program, to be formatted, after the errors of parsing and checking
procedure check_file(
  in  file: Str,
      formatted: Bool,
  out q: Prog,
      errors: List[Diagnostic]
) :=
  local source: Source, text: Str, typed: List[TypeError]
  assign q := Prog(List(), ""), errors := List()
  try
    call   parse_file(in file, out source)
    call   check_all(in source, out q, typed)
    assign errors := List(for e in take(20, typed) yield type_diagnostic(e))
    for m in unit_modules(source) if formatted and errors == List() do
      call os_read(in os_join(os_dirname(file), module_file(m)), out text)
      try
        call require_formatted(in source, m, text)
      catch
        case Unformatted(line) =>
          assign errors := List(
            Diagnostic(FormatKind, "Unformatted", if m == source.main then None else Some(m), Pos(line, 1), "the file differs from what ulang format writes", List()))
      end
    end
  catch
    case ParseErrors(found) =>
      assign errors := List(for e in take(20, found) yield parse_diagnostic(e))

    case e =>
      assign errors := List(parse_diagnostic(e))

    case OsError(m) =>
      assign errors := List(diagnostic(RuntimeKind, m))

    case e =>
      assign errors := List(diagnostic(InternalKind, internal_message(e)))
  end

// the modules of the unit of the main module of source: the members of its package, or main alone if it is a program
function unit_modules(source: Source): List[Id] :=
  match find(source.packages, lambda p => contains(source.main, p.members))
    case Some(p) =>
      p.members
    case None =>
      List(source.main)
  end

// the name of the file of the module m in its directory
function module_file(m: Id): Str :=
  os_basename(m) ++ ".u"

// the module of file, a file of the directory of the module main
function sibling(main: Id, file: Str): Id :=
  let name := slice(os_basename(file), 0, size(os_basename(file)) - 2) in
  if module_dir(main) == "" then name else module_dir(main) ++ "/" ++ name

// prints the error of loading file, after the lines of the others if there are several files, else alone to stderr
// the errors of loading file, on the output if there are several files, else on the output of errors
procedure report(in file: Str, errors: List[Diagnostic], several: Bool) :=
  for d in errors do
    if several then
      call os_println(in file ++ ": " ++ format_diagnostic(d))
    else
      call os_print_error(in file ++ ": " ++ format_diagnostic(d))
    end
  end

// prints how many of the files passed if there are several
procedure summarize(in files: List[Str], failed: List[Str]) :=
  if size(files) > 1 then
    call os_println(in show(size(files) - size(failed)) ++ " of " ++ show(size(files)) ++ " files passed")
  end

// the targets of the targets, by default the root of the project, where a directory is a target without a name for each of
// the .u files below it, without those of the directories that the project runs only compiled if compiled_only is set
procedure targets_of(
  in  targets: List[Target],
      compiled_only: Bool,
  out found: List[Target]
) :=
  local root: Str, files: List[Str], skipped: List[Str], buffer: Buffer[Target] := empty()
  call default_path(out root)
  for Target(path, name) in if targets == List() then List(Target(root, None)) else targets do
    match name
      case Some(_) =>
        assign buffer := buffer ++ List(Target(path, name))

      case None =>
        assign skipped := List()
        if compiled_only then
          call compiled_only_of(in path, out skipped)
        end
        call   walk_all(in List(path), skipped, out files)
        assign buffer := buffer ++ List(for f in files if is_source(f) yield Target(f, None))
    end
  end
  assign found := List(for t in buffer)

// the targets grouped by the load that they need, in the order of their first targets: those of the members of a package,
// the files with sections of a directory, together, and those of each program, a file without sections, apart
procedure units_of(in targets: List[Target], out units: List[List[Target]]) :=
  local text: Str, keyed: Buffer[Str * Target] := empty()
  for t in targets do
    try
      call os_read(in t.path, out text)
    catch
      case OsError(_) =>
        assign text := ""
    end
    assign keyed := keyed ++ List((if has_sections(text) then os_dirname(t.path) ++ "/" else t.path, t))
  end
  assign units := grouped(List(for k in keyed))

function grouped(keyed: List[Str * Target]): List[List[Target]] :=
  match keyed
    case List() =>
      List()

    case List((key, _); _) =>
      List(
        List(for (k, t) in keyed if k == key yield t); grouped(List(for (k, t) in keyed if k != key)))
  end

function first_path(targets: List[Target]): Str :=
  match targets
    case List(t; _) =>
      t.path
    case List() =>
      ""
  end

// the files of the targets, each once, in the order of their first targets
function files_of(targets: List[Target]): List[Str] :=
  foldl(targets, List(), lambda files, t => if contains(t.path, files) then files else files ++ List(t.path))

// the names that the targets select of file, List() for all, if one target selects all of it
function names_of(file: Str, targets: List[Target]): List[Str] :=
  let mine := List(for t in targets if t.path == file yield t.name) in
  if contains(None, mine) then
    List()
  else
    List(for n in mine for x in n yield x)

// the label of the lines of file, the file if the targets have several files
function label_of(file: Str, targets: List[Target]): Str :=
  if size(files_of(targets)) > 1 then file ++ ": " else ""

// the files of the paths, where directories are walked in the order of names, without the hidden ones, those named out,
// and the skipped ones, which are absolute and normal
procedure walk_all(
  in  paths: List[Str],
      skipped: List[Str],
  out files: List[Str]
) :=
  local here: Str, found: Buffer[Str] := empty(), dir: Bool, below: List[Str]
  call os_cwd(out here)
  for path in paths do
    call os_is_dir(in path, out dir)
    if dir then
      call   walk_dir(in path, skipped, here, out below)
      assign found := found ++ below
    else
      assign found := found ++ List(path)
    end
  end
  assign files := List(for file in found yield without_dot(file))

// the path without ./ in front, by which test labels files as the binary of the tests does (normal_target of
// ulang/runtime/ulang.c)
function without_dot(path: Str): Str :=
  if starts_with(path, "./") then
    without_dot(slice(path, 2, size(path)))
  else
    path

test paths_without_dot() :=
  assert without_dot("./ulang/x.u") == "ulang/x.u" and without_dot("././x.u") == "x.u"
  assert without_dot("../x.u") == "../x.u" and without_dot("x.u") == "x.u"

// the files below dir as walk_all walks them, where here is the working directory
procedure walk_dir(
  in  dir: Str,
      skipped: List[Str],
      here: Str,
  out files: List[Str]
) :=
  local entries: List[Str * Bool], found: Buffer[Str] := empty(), below: List[Str]
  call os_list(in dir, out entries)
  for (name, is_folder) in entries do
    if not is_folder then
      assign found := found ++ List(os_join(dir, name))
    else
      if not starts_with(name, ".") and name != "out" and not contains(absolute_path(here, os_join(dir, name)), skipped) then
        call   walk_dir(in os_join(dir, name), skipped, here, out below)
        assign found := found ++ below
      end
    end
  end
  assign files := List(for file in found)

// path from the directory here, absolute and normal
function absolute_path(here: Str, path: Str): Str :=
  normal_path(if starts_with(path, "/") then path else os_join(here, path))

// the root of the project of the working directory, as a path from it, . or a sequence of ..
procedure default_path(out path: Str) :=
  local here: Str, root: Str
  call   os_cwd(out here)
  call   project_root(in normal_path(here), out root)
  assign path := path_up(root, normal_path(here))

// the path from dir up to root, which is dir or a directory above it
function path_up(root: Str, dir: Str): Str :=
  if dir == root then
    "."
  else
    join("/", List(for d in split(slice(dir, if root == "/" then 1 else size(root) + 1, size(dir)), '/') yield ".."))

test paths_up() :=
  assert path_up("/a", "/a") == "."
  assert path_up("/a", "/a/b/c") == "../.."
  assert path_up("/", "/b") == ".."

// the directories, absolute and normal, that the project of path runs only compiled, as the function project of its
// project.u declares
procedure compiled_only_of(in path: Str, out skipped: List[Str]) :=
  local here: Str, dir: Bool, root: Str, entries: List[Str * Bool], q: Prog, errors: List[Diagnostic], v: Option[Val]
  assign skipped := List()
  call   os_cwd(out here)
  call   os_is_dir(in path, out dir)
  call   project_root(in absolute_path(here, if dir then path else os_dirname(path)), out root)
  call   os_list(in root, out entries)
  if contains(("project.u", false), entries) then
    call check_file(in os_join(root, "project.u"), false, out q, errors)
    if errors != List() then
      call report(in os_join(root, "project.u"), errors, false)
    else
      call constant_of(in load(q), Name(Some(q.main), "project"), out v)
      match v
        case Some(VObj(_, List(dirs))) =>
          assign skipped := List(for d in strings_of(dirs) yield normal_path(os_join(root, d)))
        case _ =>
          skip
      end
    end
  end

// the strings of a list value
function strings_of(v: Val): List[Str] :=
  match v
    case VObj(_, List(VLit(LStr(text)), tail)) =>
      List(text; strings_of(tail))
    case _ =>
      List()
  end

// whether cmd is a test of the module m that names selects, all of them for List()
function is_selected_test(cmd: Cmd, m: Id, names: List[Str]): Bool :=
  match cmd
    case CTest(name, _, _) =>
      name.module == Some(m) and (names == List() or contains(name.base, names))
    case _ =>
      false
  end

function cmd_name(cmd: Cmd): Str :=
  match cmd
    case CTest(name, _, _) =>
      name.base
    case _ =>
      ""
  end
