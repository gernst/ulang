// the names of the builtin types, constructors, and exceptions, which the interpreter, the runtime, and the compiler
// create and refer to, of the modules of the library

import "syntax.u"

export

// the patterns of the constructors of lists after checking, which resolves list() and list(p; r) to the module list
pattern PNil(): Pat := PApp(Name(Some("prelude/list"), "Nil"), list())

pattern PCons(head: Pat, tail: Pat): Pat := PApp(Name(Some("prelude/list"), "Cons"), list(head, tail))

// the builtin types of the prelude, and lists after checking
pattern TBool(): Type := TSort(Name(Some("prelude/prelude"), "Bool"), list())

pattern TInt(): Type := TSort(Name(Some("prelude/prelude"), "Int"), list())

pattern TStr(): Type := TSort(Name(Some("prelude/prelude"), "Str"), list())

pattern TChar(): Type := TSort(Name(Some("prelude/prelude"), "Char"), list())

pattern TList(elem: Type): Type := TSort(Name(Some("prelude/list"), "List"), list(elem))

// the expressions of the constructors of lists after checking, and the lists that forms translate to, before it
pattern ENil(typ: Type): Expr := EVar(Var(Name(Some("prelude/list"), "Nil"), typ))

pattern ECons(typ: Type, head: Expr, tail: Expr): Expr := EApp(EVar(Var(Name(Some("prelude/list"), "Cons"), typ)), list(head, tail))

function nil_name(): Name

function cons_name(): Name

function os_error_name(): Name

function division_by_zero_name(): Name

function out_of_bounds_name(): Name

function no_character_name(): Name

function missing_field_name(): Name

function list_foldr_name(): Name

function array_name(): Name

function array_foldr_name(): Name

// programs of the tests, which are not parsed
function type_plain_list(t: Type): Type

function lists(): List[Mod]

function with_lists(cmds: List[Cmd]): Source

function program_of(cmds: List[Cmd]): Source

function natives_prelude(): Mod

implementation

function nil_name(): Name :=
  library_name("list", "Nil")

function cons_name(): Name :=
  library_name("list", "Cons")

function os_error_name(): Name :=
  library_name("os", "OsError")

// the exceptions of the builtins and of accessors of fields, which the prelude declares
function division_by_zero_name(): Name :=
  library_name("prelude", "DivisionByZero")

function out_of_bounds_name(): Name :=
  library_name("prelude", "OutOfBounds")

function no_character_name(): Name :=
  library_name("prelude", "NoCharacter")

function missing_field_name(): Name :=
  library_name("prelude", "MissingField")

// the builtins of lists and arrays that comprehensions use
function list_foldr_name(): Name :=
  library_name("list", "foldr")

function array_name(): Name :=
  library_name("array", "from_list")

function array_foldr_name(): Name :=
  library_name("array", "foldr")

// the lists of the tests, before checking
function type_plain_list(t: Type): Type :=
  TSort(unqualified("List"), list(t))

// lists with constructors Nil and Cons, exported by the module list as in the library, and their length
function lists(): List[Mod] :=
  list(
    Mod(library_module("list"), "", list(), unplaced(list(
      CData(unqualified("List"), list("A"), list(
        Constr("", unqualified("Nil"), list()),
        Constr("", unqualified("Cons"), list(
          Field("head", TParam("A")),
          Field("tail", type_plain_list(TParam("A"))))))))), list(), list()))

// the program of the commands cmds after len of the module main, which imports lists
function with_lists(cmds: List[Cmd]): Source :=
  Source(list(natives_prelude(); lists()) ++ list(
    Mod("main", "", list(library_module("list")), list(), list(), unplaced(list(len_fun(); cmds)))), "main")

function len_fun(): Cmd :=
  CFun(unqualified("len"), list("A"), list(Var(unqualified("xs"), type_plain_list(TParam("A")))), TInt(), EMatch(expr_var("xs"), list(
    Branch("", pat_var("Nil"), None, expr_int(0)),
    Branch("", PApp(unqualified("Cons"), list(PWild, pat_var("ys"))), None, expr_app("+", list(expr_int(1), expr_app("len", list(expr_var("ys")))))))))

// a prelude of the builtin types and functions of prelude/prelude.u only, for programs that are not parsed
function natives_prelude(): Mod :=
  let int_op := lambda op => CFunSig(unqualified(op), list(), list(Var(unqualified("a"), TInt()), Var(unqualified("b"), TInt())), TInt()) in Mod(library_module("prelude"), "", list(), list(), unplaced(list(for t in list("Bool", "Int", "Str", "Char") yield CAbstract(unqualified(t), list())) ++ list(for op in list("+", "-", "*", "/", "%") yield int_op(op)) ++ list(
    CFunSig(unqualified("++"), list(), list(Var(unqualified("a"), TStr()), Var(unqualified("b"), TStr())), TStr()))), list())

function program_of(cmds: List[Cmd]): Source :=
  Source(list(
    natives_prelude(),
    Mod("main", "", list(), list(), list(), unplaced(cmds))), "main")
