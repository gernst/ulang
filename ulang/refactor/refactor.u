// scripted edits of ulang files by declaration, ideas/refactor.md: a script is a sequence of actions, each a line
// starting with @, which occurs nowhere in ulang, followed by its fragment, the lines up to the next action, taken
// verbatim; the edits splice the text of whole declarations by the spans of the parsed file, since comments are not in
// the tree, and every edited file is printed by format_program, so that a fragment needs no layout of its own

import ulang.syntax
import ulang.format
import ulang.parse
import ulang.check
import ulang.lint

export

// an action of a script, the words of its line after @, and its fragment, the lines up to the next action
data Action :=
  case Action(line: Int, words: List[Str], fragment: Str)

// the actions of a script, where the lines before the first action are ignored
function actions(script: Str): List[Action] :=
  example actions("@show a.u\n@put a.u\nf\ng\n") == List(
      Action(1, List("show", "a.u"), ""),
      Action(2, List("put", "a.u"), "f\ng"))
  example actions("@patch a.u\n@@x => @y\n") == List(Action(1, List("patch", "a.u"), "@x => @y"))

// the directory of the state of refactor, out/refactor of the root of the project of the working directory, where the
// table of handles and the journal are kept
procedure state_dir(out dir: Str) raises OsError

// performs the actions of script on the files it names, all or none, and then, unless dry, writes the files that changed
// and reports the diagnostics that check gives of them, those which are new or gone, or all if the script changed no
// file, where reply is the lines of the reply, whose first line counts the errors and warnings after it, status 0 if all
// applied and no error remains, else 1, with the reason of a refusal, which the first line rejected tells apart, and
// tested the files whose tests to run, those that changed and those of @check, if the script has @check test
procedure run_script(
  in  script: Str,
      dry: Bool,
      state: Str,
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
  out reply: List[Str],
      status: Int,
      tested: List[Str]
)

// the tests of the files of a script: the lines of the reply, and the numbers of the tests that passed, that failed, and
// that did not run, since the errors left them out of the program
data Tests :=
  // unrun has the files whose tests the errors left out of the program, each with those tests
  case Tests(lines: List[Str], passed: Int, failed: Int, skipped: Int, unrun: Map[Str, Str])

// run_script, which runs the tests of the files tested by tester, given the files and the diagnostics that the reply lists,
// so that a test that only reaches one of them is counted, not repeated, and counts them in the first line, where a test
// that failed makes the status 3
procedure run_tested_script(
  in  script: Str,
      dry: Bool,
      overlays: Map[Str, Str],
      state: Str,
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
      tester: (in List[Str], List[(Str, Diagnostic)], out Tests),
  out reply: List[Str],
      status: Int
)

implementation

// what refuses a script, with the reason
data Refused :=
  case Refused(message: Str)

// what a declaration is known by in its module, its kind of name, base name, and arity, -1 for types, tests, and
// lemmas, which are not overloaded, so that a test with formals is not of arity 0 and is selected by its name alone
data Key :=
  case Key(kind: Str, base: Str, arity: Int)

// lines from first to last, both from 1, empty if last is first - 1, where a splice inserts before first
data Range :=
  case Range(first: Int, last: Int)

// what the actions of a script have done so far: the texts of the files they edited, the lines of the reply, the files
// to check at the end, the table of handles, the scripts of the journal that the script undoes, the directory of the
// state, the files whose uses must resolve after the writes to the names given, in order, else the script is undone,
// and whether to run the tests
data Edits :=
  case Edits(files: Map[Str, Str], notes: Buffer[Str], checked: List[Str], handles: Handles, undone: List[Int], state: Str, expected: List[(Str, List[Name])], tests: Bool)

// the handles that the scripts so far have shown, kept in out/refactor/handles.txt of the root, the next number, and
// whether the script changed it
data Handles :=
  case Handles(entries: List[Handle], next: Int, changed: Bool)

// a node of a declaration, known by its file, the key of the declaration, its index in line_nodes of ulang/refactor/nodes.u,
// and the hash of its text without its indentation, by which it is found again after edits of other declarations, and
// which makes it stale when its own text changes from outside, while the edits of the script move the handles of their
// declaration to its new nodes (rebased), and those of the nodes that they remove have the index -1
data Handle :=
  case Handle(number: Int, path: Str, key: Key, index: Int, hash: Int)

// a node that a handle names, in the current text of its file, with the number of the declarations of its module
data Place :=
  case Place(path: Str, lines: Array[Str], key: Key, cmd: Cmd, span: Span, decls: Int)

function actions(script: Str): List[Action] :=
  actions_of(List(for (line, i) in numbered(split(script, '\n')) yield (line, i + 1)))

function actions_of(lines: List[(Str, Int)]): List[Action] :=
  match lines
    case List((line, i); rest) =>
      if is_action_line(line) then
        let (body, more) := fragment_lines(rest) in
        List(
          Action(i, words_of(slice(line, 1, size(line))), trimmed_fragment(firsts(body))); actions_of(more))
      else
        actions_of(rest)

    case List() =>
      List()
  end

function fragment_lines(lines: List[(Str, Int)]): (List[(Str, Int)], List[(Str, Int)]) :=
  match lines
    case List((line, i); rest) if not is_action_line(line) =>
      let (body, more) := fragment_lines(rest) in
      (List(
        (if starts_with(line, "@@") then slice(line, 1, size(line)) else line, i); body), more)

    case _ =>
      (List(), lines)
  end

// whether a line of a script starts an action, a line that starts with @, but for a line that starts with @@, which is a
// line of a fragment that starts with @
function is_action_line(line: Str): Bool :=
  example is_action_line("@put a.u")
  example not is_action_line("@@put a.u")
  starts_with(line, "@") and not starts_with(line, "@@")

// the refusal of an action that takes a fragment and has none, where the next action of the script, if there is one, is
// the line after it that starts with @, which may have been meant as the fragment
function fragment_refusal(action: Action, next: Option[Action]): Option[Str] :=
  example fragment_refusal(Action(1, List("patch", "a.u:f"), ""), Some(Action(2, List("drop", "T"), ""))) == Some("@patch a.u:f has no fragment, since line 2 of the script, @drop T, starts with @, which starts an action; write a fragment line that starts with @ as @@")
  example fragment_refusal(Action(1, List("drop", "a.u:f"), ""), Some(Action(2, List("drop", "T"), ""))) == None
  match (action.words, next)
    case (List("put" | "patch" | "example"; _), Some(after)) if action.fragment == "" =>
      Some("@" ++ join(" ", action.words) ++ " has no fragment, since line " ++ show(after.line) ++ " of the script, @" ++ join(" ", after.words) ++ ", starts with @, which starts an action; write a fragment line that starts with @ as @@")
    case _ =>
      None
  end

// the lines joined, without the blank lines at the end
function trimmed_fragment(lines: List[Str]): Str :=
  join("\n", reverse(drop_blank(reverse(lines))))

function drop_blank(lines: List[Str]): List[Str] :=
  match lines
    case List(line; rest) if is_blank(line) =>
      drop_blank(rest)
    case _ =>
      lines
  end

function is_blank(line: Str): Bool :=
  forall(chars(line), is_space)

// the words of line, split at spaces, but for the text from its first quote to its last, which is one word, with its
// quotes, the text of a node that @put and @drop address
function words_of(line: Str): List[Str] :=
  example words_of("put before a.u:f \"case  X(\"a\")\" ") == List("put", "before", "a.u:f", "\"case  X(\"a\")\"")
  let quotes := List(for (c, i) in numbered(chars(line)) if c == '"' yield i) in
  match (quotes, last(quotes))
    case (List(first, _; _), Some(final)) =>
      plain_words(slice(line, 0, first)) ++ List(slice(line, first, final + 1)) ++ plain_words(slice(line, final + 1, size(line)))
    case _ =>
      plain_words(line)
  end

function plain_words(line: Str): List[Str] :=
  List(for w in split(line, ' ') if w != "" yield w)

// a target file.u, file.u:name, or file.u:name/n, its path, name, and arity
function target_of(word: Str): (Str, Option[Str], Option[Int]) :=
  example target_of("a/b.u:f/2") == ("a/b.u", Some("f"), Some(2))
  match index_of(':', chars(word))
    case Some(i) =>
      let path := slice(word, 0, i), rest := slice(word, i + 1, size(word)) in
      match index_of('/', chars(rest))
        case Some(j) =>
          (path, Some(slice(rest, 0, j)), number(slice(rest, j + 1, size(rest))))
        case None =>
          (path, Some(rest), None)
      end

    case None =>
      (word, None, None)
  end

// the form of @put place file:name that names the declaration of word in file
function anchored_form(file: Str, place: Str, word: Str): Str :=
  example anchored_form("a.u", "after", "f/2") == "@put after a.u:f/2"
  example anchored_form("a.u", "before", "b.u:f") == "@put before a.u:f"
  let name := match index_of(':', chars(word))
    case Some(i) =>
      slice(word, i + 1, size(word))
    case None =>
      word
  end in
  "@put " ++ place ++ " " ++ file ++ ":" ++ name

function key_of(cmd: Cmd): Option[Key] :=
  match cmd
    case CSort(name, _, _) =>
      Some(Key("type", name.base, -1))

    case CData(name, _, _) =>
      Some(Key("type", name.base, -1))

    case CAbstract(name, _) =>
      Some(Key("type", name.base, -1))

    case CFun(name, _, formals, _, _, _) =>
      Some(Key("value", name.base, size(formals)))

    case CFunSig(name, _, formals, _, _) =>
      Some(Key("value", name.base, size(formals)))

    case CProc(name, _, ins, outs, refs, _, _, _) =>
      Some(Key("value", name.base, size(ins) + size(outs) + size(refs)))

    case CProcSig(name, _, ins, outs, refs, _, _) =>
      Some(Key("value", name.base, size(ins) + size(outs) + size(refs)))

    case CPatAlias(name, _, formals, _, _) =>
      Some(Key("value", name.base, size(formals)))

    case CTest(name, _, _) =>
      Some(Key("test", name.base, -1))

    case CLemma(name, _, _, _, _, _) =>
      Some(Key("lemma", name.base, -1))

    case CNotation(_, _, _) =>
      None
  end

// whether cmd is a signature of export or an abstract type, which a definition of the same key implements
function is_signature(cmd: Cmd): Bool :=
  match cmd
    case CFunSig(_, _, _, _, _) =>
      true

    case CProcSig(_, _, _, _, _, _, _) =>
      true

    case CAbstract(_, _) =>
      true

    case _ =>
      false
  end

function has_spec(cmd: Cmd): Bool :=
  match cmd
    case CFunSig(_, _, _, _, spec) =>
      spec != Spec(List(), None, List())

    case CProcSig(_, _, _, _, _, _, spec) =>
      spec != Spec(List(), None, List())

    case _ =>
      false
  end

function key_text(key: Key): Str :=
  if key.arity < 0 then key.base else key.base ++ "/" ++ show(key.arity)

// whether the declaration of key is the one that name and arity select
function is_selected(key: Key, name: Str, arity: Option[Int]): Bool :=
  key.base == name and forall(arity, lambda n => n == key.arity)

function main_mod(source: Source): Mod :=
  match find(source.mods, lambda d => d.name == source.main)
    case Some(d) =>
      d
    case None =>
      Mod(source.main, List(), List(), List(), List(), List())
  end

function cmd_of(cmd: At[Cmd]): Option[Cmd] :=
  match cmd
    case AOk(_, _, that) =>
      Some(that)

    case AErr(_, _, that, _) =>
      Some(that)

    case AUnparsed(_, _, _, _) =>
      None
  end

function cmd_key(cmd: At[Cmd]): Option[Key] :=
  match cmd_of(cmd)
    case Some(c) =>
      key_of(c)
    case None =>
      None
  end

function keyed(cmds: List[At[Cmd]]): List[(Key, At[Cmd], Cmd)] :=
  List(for cmd in cmds for c in cmd_of(cmd) for key in key_of(c) yield (key, cmd, c))

function line_at(lines: Array[Str], line: Int): Str :=
  if 1 <= line and line <= size(lines) then at(line - 1, lines) else ""

function is_comment_line(line: Str): Bool :=
  starts_with(str(drop_spaces(chars(line))), "//")

function drop_spaces(cs: List[Char]): List[Char] :=
  match cs
    case List(' '; rest) =>
      drop_spaces(rest)
    case _ =>
      cs
  end

// the first line of the doc right above line, the run of comment lines without a blank line, all below floor, or line
// if it has none
function doc_start(lines: Array[Str], line: Int, floor: Int): Int :=
  if line - 1 > floor and is_comment_line(line_at(lines, line - 1)) then
    doc_start(lines, line - 1, floor)
  else
    line

// the last line of a declaration that ends at line, with the indented lines after it, such as comments at the end of
// its body, since only declarations and sections start at the first column of formatted text
function tail_end(lines: Array[Str], line: Int): Int :=
  if line < size(lines) and starts_with(line_at(lines, line + 1), " ") then
    tail_end(lines, line + 1)
  else
    line

function lines_in(lines: Array[Str], within: Range): List[Str] :=
  List(for i in range(within.first, within.last + 1) yield line_at(lines, i))

// the range of the declaration cmd, with its doc if doc
function cmd_range(lines: Array[Str], cmd: At[Cmd], floor: Int, doc: Bool): Range :=
  let start := cmd.span.start.line in
  Range(if doc then doc_start(lines, start, floor) else start, tail_end(lines, cmd.span.stop.line))

// the head of a definition, the lines up to the one ending in :=, without it
function head_lines(lines: List[Str]): List[Str] :=
  match lines
    case List(line; rest) =>
      if ends_with(line, " :=") then
        List(slice(line, 0, size(line) - 3))
      else
        List(line; head_lines(rest))

    case List() =>
      List()
  end

// the range of the head of the signature cmd, up to its :=, which only a signature with a spec has, else all of it
function head_range(lines: Array[Str], cmd: At[Cmd]): Range :=
  let start := cmd.span.start.line in
  Range(start, start + size(head_lines(lines_in(lines, Range(start, cmd.span.stop.line)))) - 1)

// lines with each splice, a range and the lines that replace it, where the ranges do not overlap
function spliced(lines: List[Str], splices: List[(Range, List[Str])]): List[Str] :=
  foldl(reverse(sort(List(for (range, new) in splices yield (range.first, range.last, new)))), lines, lambda acc, (first, last, new) => take(first - 1, acc) ++ new ++ drop(last, acc))

procedure current_text(
  in  path: Str,
      files: Map[Str, Str],
  out text: Str
) raises OsError :=
  match get(path, files)
    case Some(edited) =>
      text := edited
    case None =>
      os_read_utf8(in path, out text)
  end

// the parse of text as the file path, with the texts of files, those that the script has edited, instead of their
// files, where the errors in the blocks of fragment are those of a fragment, at their lines in it
procedure parsed(
  in  path: Str,
      text: Str,
      files: Map[Str, Str],
      fragment: List[(Range, Int)],
  out source: Source
) raises Refused, OsError :=
  try
    parse_file_overlaid(in path, Map(path => text; files), false, out source)
    // an import that fails is no failure of the parse here, so that a script can fix it
    require_parsed(in source with mods := List(for m in source.mods yield m with imports := List(for i in m.imports if import_failures(i) == List())))
  catch
    case ParseErrors(errors) =>
      raise Refused(join("\n", List(for d in shown_errors(fragment, List(for e in errors yield parse_diagnostic(e))) yield parse_message(path, fragment, d))))
    case e =>
      raise Refused(parse_message(path, fragment, parse_diagnostic(e)))
  end

// the errors of a parse to show, where those at the lines of the fragment, if there are any, explain those at the lines of
// the file, which parsed before the fragment was spliced in, and a keyword written as a name hides the errors after it on
// its line, which follow from the parse that took it as the start of a section or a command
function shown_errors(fragment: List[(Range, Int)], ds: List[Diagnostic]): List[Diagnostic] :=
  let inside := List(for d in ds if exists(fragment, lambda (r, _) => r.first <= d.pos.line and d.pos.line <= r.last)) in
  let kept := if inside == List() then ds else inside in
  List(for d in kept if not exists(kept, lambda k => is_keyword_error(k) and k.pos.line == d.pos.line and (k.pos.col < d.pos.col or k.pos.col == d.pos.col and not is_keyword_error(d))))

// whether d is the error of a keyword where a name is expected
function is_keyword_error(d: Diagnostic): Bool :=
  example is_keyword_error(Diagnostic(ParseKind, "", None, Pos(1, 1), "keyword builtin is not a name", List()))
  starts_with(d.message, "keyword ") and index_of(" is not a name", d.message) != None

// the message of d at its line in the fragment if it is in one of the blocks of the text that the fragment wrote, each its
// lines and the line of the fragment of its first, else at its line in the file
function parse_message(path: Str, fragment: List[(Range, Int)], d: Diagnostic): Str :=
  let line := d.pos.line in
  match find(fragment, lambda (r, _) => r.first <= line and line <= r.last)
    case Some((r, first)) =>
      "fragment " ++ show(line - r.first + first) ++ "." ++ show(d.pos.col) ++ ": " ++ d.message
    case None =>
      path ++ ":" ++ show(line) ++ "." ++ show(d.pos.col) ++ ": " ++ d.message
  end

function no_fragment(): List[(Range, Int)] :=
  List()

// text as format writes it, which must parse again, with its source, parsed as parsed parses it
procedure formatted(
  in  path: Str,
      text: Str,
      files: Map[Str, Str],
      fragment: List[(Range, Int)],
  out result: Str,
      source: Source
) raises Refused, OsError :=
  var written: Source
  parsed(in path, text, files, fragment, out written)
  result := format_program(written)
  parsed(in path, result, files, no_fragment(), out source)

procedure note(in text: Str, ref edits: Edits) :=
  edits := edits with notes := edits.notes ++ List(text)

// where check gives the diagnostics of a file with the texts of the script as overlays, which @fix compares before and
// after each edit
procedure perform(
  in  action: Action,
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
  ref edits: Edits
) raises Refused, OsError :=
  match action.words
    case List("show"; address) if is_node_address(address) =>
      show_node(in address, ref edits)

    case List("show", word) =>
      show_target(in word, ref edits)

    case List("put", place; address) if contains(place, List("before", "after", "into")) and is_node_address(address) =>
      put_at(in place, address, action.fragment, ref edits)

    case List("put"; address) if is_node_address(address) =>
      put_at(in "replace", address, action.fragment, ref edits)

    case List("put", word) =>
      let (path, name, arity) := target_of(word)
      put(in path, action.fragment, Anchor(if name == None then "end" else "instead", value_or(name, ""), arity), ref edits)

    case List("put", place, word) if contains(place, List("before", "after", "into")) =>
      if place == "into" then
        put_at(in place, List(word), action.fragment, ref edits)
      else
        let (path, name, arity) := target_of(word)
        put(in path, action.fragment, Anchor(place, value_or(name, ""), arity), ref edits)
      end

    case List("put", file, place, word) if contains(place, List("before", "after")) =>
      let (path, name, arity) := target_of(word)
      if path != file then
        raise Refused("@put " ++ file ++ " " ++ place ++ " takes a declaration of " ++ file ++ ", not " ++ word ++ ", so write " ++ anchored_form(file, place, word))
      end
      put(in path, action.fragment, Anchor(place, value_or(name, ""), arity), ref edits)

    case List("drop"; address) if is_node_address(address) =>
      put_at(in "drop", address, "", ref edits)

    case List("drop", word) =>
      drop_target(in word, ref edits)

    case List("patch"; address) =>
      patch(in address, action.fragment, ref edits)

    case List("example", word) =>
      add_examples(in word, action.fragment, ref edits)

    case List("export", word) =>
      export_target(in word, ref edits)

    case List("unexport", word) =>
      unexport_target(in word, ref edits)

    case List("fix", word; rules) =>
      fix(in word, rules, check, ref edits)

    case List("undo") =>
      undo(in None, ref edits)

    case List("undo", word) =>
      undo(in Some(word), ref edits)

    case List("rename", word, new) =>
      rename(in word, new, ref edits)

    case List("outline", word) =>
      outline(in word, ref edits)

    case List("refs", word) =>
      refs(in word, ref edits)

    case List("sig", word) =>
      sig(in word, ref edits)

    case List("resolve", word) =>
      resolve(in word, ref edits)

    case List("resolve", file, at) =>
      resolve(in file ++ ":" ++ at, ref edits)

    case List("check") =>
      skip

    case List("check", "test") =>
      edits := edits with tests := true

    case List("check", "test", path) =>
      edits := edits with checked := edits.checked ++ List(path), tests := true

    case List("check", path) =>
      edits := edits with checked := edits.checked ++ List(path)

    case _ =>
      let actions := "@show T, @put F, @put F:name, @put [before|after] F:name, @put [before|after|into] N, @drop T, where a node N is #h, F:name #h, F:name \"text\", or F:L.C, @patch T, @example F:name, @rename T new, @outline F, @refs T, @sig name, @sig M, @resolve F:L.C, @export T, @unexport T, @fix T [Rule ...], @undo [n], @check [test] [F]"
      raise Refused("line " ++ show(action.line) ++ ": unknown action @" ++ join(" ", action.words) ++ ", which is one of " ++ actions ++ "; a line of a script that starts with @ starts an action, so a fragment line that starts with @ is written @@")
  end

// the definition of key in d, with the lines of the specs of its signatures as its own, for its nodes, so that the
// handles of the examples of a signature in export are nodes of the definition, or the declaration of key if it has no
// definition
function decl_of(d: Mod, key: Key): Option[(At[Cmd], Cmd)] :=
  let decls := List(for (k, cmd, c) in keyed(placed_of(d)) if k == key yield (cmd, c)) in
  match find(decls, lambda (_, c) => not is_signature(c))
    case Some((cmd, c)) =>
      Some((cmd, with_specs(c, List(for (_, s) in decls if is_signature(s) yield spec_of(s)))))
    case None =>
      find(decls, lambda _ => true)
  end

// the spec of a function or procedure, its signature or definition
function spec_of(c: Cmd): Spec :=
  match c
    case CFun(_, _, _, _, spec, _)
       | CProc(_, _, _, _, _, _, spec, _)
       | CFunSig(_, _, _, _, spec)
       | CProcSig(_, _, _, _, _, _, spec) =>
      spec

    case _ =>
      no_spec()
  end

// the definition c with the lines of specs in its spec, the specs of its signatures, which the nodes of c take in, where a
// contract of its own wins, which a definition of a signature has only with errors
function with_specs(c: Cmd, specs: List[Spec]): Cmd :=
  let joined := foldl(specs, spec_of(c), lambda acc, s => Spec(s.pre ++ acc.pre, or_else(acc.post, s.post), s.examples ++ acc.examples)) in
  match c
    case CFun(_, _, _, _, _, _) | CProc(_, _, _, _, _, _, _, _) =>
      c with spec := joined
    case _ =>
      c
  end

function hash_of(text: Str): Int :=
  foldl(chars(text), 17, lambda h, c => (h * 31 + int(c)) % 1000000007)

function indent_of(line: Str): Int :=
  size(line) - size(drop_spaces(chars(line)))

// lines without the indentation that all those that are not blank have
function dedented(lines: List[Str]): List[Str] :=
  let indents := List(for line in lines if not is_blank(line) yield indent_of(line)) in
  let least := foldl(indents, if indents == List() then 0 else foldl(indents, 0, max), min) in
  List(for line in lines yield if is_blank(line) then "" else slice(line, least, size(line)))

function indented(lines: List[Str], depth: Int): List[Str] :=
  List(for line in lines yield if is_blank(line) then "" else repeat(depth, " ") ++ line)

function node_text(lines: Array[Str], span: Span): Str :=
  join("\n", dedented(lines_in(lines, Range(span.start.line, span.stop.line))))

function has_handle(line: Str): Bool :=
  match chars(line)
    case List('#', c; _) =>
      is_digit(c)
    case _ =>
      false
  end

function handle_size(line: Str): Int :=
  size(take_digits(drop(1, chars(line)))) + 1

function take_digits(cs: List[Char]): List[Char] :=
  match cs
    case List(c; rest) if is_digit(c) =>
      List(c; take_digits(rest))
    case _ =>
      List()
  end

// the width of the margin of handles in lines that show the greatest number
function margin_width(greatest: Int): Int :=
  max(6, size(show(greatest)) + 2)

// lines of code that @show printed with handles, without the margin, which a fragment may keep
function unmarked(lines: List[Str]): List[Str] :=
  if exists(lines, has_handle) then
    let width := margin_width(foldl(lines, 0, lambda w, line => if has_handle(line) then max(w, handle_size(line)) else w) - 1) in
    List(for line in lines yield without_margin(line, width))
  else
    lines

function without_margin(line: Str, width: Int): Str :=
  if has_handle(line) or size(line) - size(drop_spaces(chars(line))) >= width then
    slice(line, width, size(line))
  else
    str(drop_spaces(chars(line)))

function margin(number: Option[Int], width: Int): Str :=
  match number
    case Some(n) =>
      let text := "#" ++ show(n) in
      text ++ repeat(width - size(text), " ")

    case None =>
      repeat(width, " ")
  end

// the number of the handle of the node, a new one if the table has none
procedure handle_for(
  in  path: Str,
      key: Key,
      index: Int,
      hash: Int,
  out number: Int,
  ref handles: Handles
) :=
  match find(handles.entries, lambda h => h.path == path and h.key == key and h.index == index and h.hash == hash)
    case Some(h) =>
      number := h.number

    case None =>
      number := handles.next
      handles := Handles(handles.entries ++ List(Handle(number, path, key, index, hash)), number + 1, true)
  end

// adds to marks the handle of each node of cmd that starts in region, by the line where it starts
procedure mark(
  in  path: Str,
      lines: Array[Str],
      key: Key,
      cmd: Cmd,
      region: Range,
  ref handles: Handles,
      marks: Map[Int, Int]
) :=
  var number: Int
  for (span, i) in numbered(line_nodes(lines, cmd)) if region.first <= span.start.line and span.start.line <= region.last do
    handle_for(in path, key, i, hash_of(node_text(lines, span)), out number, ref handles)
    marks := Map(span.start.line => number; marks)
  end

// region with the comments right above it at the indentation of its first line, on lines of their own and over the blank
// lines between them, which format places before the node that starts region
function with_comments(lines: Array[Str], region: Range): Range :=
  example with_comments(Array("f :=", "  // a", "", "  // b", "  x"), Range(5, 5)) == Range(2, 5)
  example with_comments(Array("  a", "    // tail", "  b"), Range(3, 3)) == Range(3, 3)
  region with first := comment_start(lines, region.first - 1, region.first, indent_of(line_at(lines, region.first)))

// the first line of the comments at indent from line upward, or first if line is none of them
function comment_start(lines: Array[Str], line: Int, first: Int, indent: Int): Int :=
  let text := line_at(lines, line) in
  if line < 1 then
    first
  else if is_comment_line(text) and indent_of(text) == indent then
    comment_start(lines, line - 1, line, indent)
  else if is_blank(text) then
    comment_start(lines, line - 1, first, indent)
  else
    first

function rendered(lines: Array[Str], region: Range, marks: Map[Int, Int]): List[Str] :=
  let width := margin_width(foldl(List(for _ => n in marks yield n), 0, max)) in
  List(for i in range(region.first, region.last + 1) yield if line_at(lines, i) == "" then
    ""
  else
    margin(get(i, marks), width) ++ line_at(lines, i))

// the node that the handle word names, found by its hash in the current text of its file, at its index if that has it
procedure resolved(
  in  word: Str,
      edits: Edits,
  out place: Place
) raises Refused, OsError :=
  let entry := find(edits.handles.entries, lambda h => some_number(h.number) == number(slice(word, 1, size(word))))
  match entry
    case None =>
      raise Refused("no handle " ++ word ++ ", which @show gives")

    case Some(h) =>
      var lines: Array[Str], d: Mod
      module_of(in h.path, edits.files, out lines, d)
      match decl_of(d, h.key)
        case None =>
          raise Refused(word ++ " is gone, with " ++ key_text(h.key) ++ " of " ++ h.path)

        case Some((_, cmd)) =>
          match node_of(h, lines, cmd)
            case Some(span) =>
              place := Place(h.path, lines, h.key, cmd, span, size(placed_of(d)))

            case None =>
              let why := if h.index < 0 then
                " is gone, since an edit removed its node"
              else
                " is stale, since its node changed"
              raise Refused(word ++ why ++ " in " ++ key_text(h.key) ++ " of " ++ h.path ++ ", so @show it again")
          end
      end
  end

// the lines of the file at path, as the script has edited it, and its module
procedure module_of(
  in  path: Str,
      files: Map[Str, Str],
  out lines: Array[Str],
      d: Mod
) raises Refused, OsError :=
  var text: Str, source: Source
  current_text(in path, files, out text)
  parsed(in path, text, files, no_fragment(), out source)
  lines := Array(for line in split(text, '\n')), d := main_mod(source)

// whether words address a node: a handle #n, also after a declaration F:name[/n] or a file F that must hold it, the text
// that starts a node of a declaration, F:name[/n] "text", or a position F:L.C
function is_node_address(words: List[Str]): Bool :=
  example is_node_address(List("a.u:f", "\"case A\""))
  example not is_node_address(List("a.u:f"))
  match words
    case List(word) =>
      starts_with(word, "#") or position_of(word) != None

    case List(_, word) =>
      starts_with(word, "#") or starts_with(word, "\"")

    case _ =>
      false
  end

// the path and position of a target F:L.C
function position_of(word: Str): Option[(Str, Pos)] :=
  example position_of("a.u:79.3") == Some(("a.u", Pos(79, 3)))
  example position_of("a.u:f") == None
  match target_of(word)
    case (path, Some(name), None) =>
      match split(name, '.')
        case List(line, col) =>
          match (number(line), number(col))
            case (Some(l), Some(c)) =>
              Some((path, Pos(l, c)))
            case _ =>
              None
          end

        case _ =>
          None
      end

    case _ =>
      None
  end

// the declaration of place, as a target F:name[/n]
function place_text(place: Place): Str :=
  place.path ++ ":" ++ key_text(place.key)

// the node of the address words, see is_node_address, and the text that names it in a reply, its declaration and the
// handle, text, or position
procedure resolved_address(
  in  address: List[Str],
      edits: Edits,
  out place: Place,
      label: Str
) raises Refused, OsError :=
  match address
    case List(word) =>
      match position_of(word)
        case Some((path, pos)) =>
          node_at_position(in path, pos, edits.files, out place)
          label := place_text(place) ++ " at " ++ show(pos.line) ++ "." ++ show(pos.col)

        case None =>
          resolved(in word, edits, out place)
          label := place_text(place) ++ " " ++ word
      end

    case List(scope, word) =>
      if starts_with(word, "#") then
        let (path, name, arity) := target_of(scope)
        resolved(in word, edits, out place)
        if place.path != path or not forall(name, lambda base => is_selected(place.key, base, arity)) then
          raise Refused(word ++ " is a node of " ++ place_text(place) ++ ", not of " ++ scope ++ ", so @show " ++ scope ++ " for its handles")
        end
      else
        node_by_text(in scope, slice(word, 1, size(word) - 1), edits.files, out place)
      end
      label := place_text(place) ++ " " ++ word

    case _ =>
      raise Refused("no node " ++ join(" ", address) ++ ", which is #n, F:name #n, F:name \"text\", or F:L.C")
  end

// the node of the declaration scope, F:name[/n], whose text starts with text, which must be the only one
procedure node_by_text(
  in  scope: Str,
      text: Str,
      files: Map[Str, Str],
  out place: Place
) raises Refused, OsError :=
  var lines: Array[Str], d: Mod
  let (path, name, arity) := target_of(scope)
  module_of(in path, files, out lines, d)
  let keys := distinct(List(for (key, _, _) in keyed(placed_of(d)) if forall(name, lambda base => is_selected(key, base, arity)) yield key))
  let decls := List(for key in keys for (_, c) in decl_of(d, key) yield (key, c))
  match (name, decls, text)
    case (_, _, "") =>
      raise Refused("a node by its text takes the text that starts it, not \"\"")

    case (Some(_), List((key, cmd)), _) =>
      let nodes := line_nodes(lines, cmd)
      // the text with the escapes of string literals read, else as written, so that raw inner quotes and backslashes work
      let found := match (starting_with(lines, nodes, unescaped(text)), unescaped(text) != text)
        case (List(), true) =>
          starting_with(lines, nodes, text)
        case (spans, _) =>
          spans
      end
      match found
        case List(span) =>
          place := Place(path, lines, key, cmd, span, size(placed_of(d)))

        case List() =>
          raise Refused("no node of " ++ path ++ ":" ++ key_text(key) ++ " starts with " ++ quote(text))

        case _ =>
          let at := join(", ", List(for span in found yield show(span.start.line)))
          raise Refused(show(size(found)) ++ " nodes of " ++ path ++ ":" ++ key_text(key) ++ " start with " ++ quote(text) ++ ", at lines " ++ at ++ ", so give more of the text, or a handle")
      end

    case _ =>
      raise Refused("a node by its text takes one declaration F:name[/arity], not " ++ scope)
  end

function starting_with(lines: Array[Str], nodes: List[Span], text: Str): List[Span] :=
  List(for span in nodes if starts_with(node_text(lines, span), text))

// text with each escape of a string literal, a backslash and a character of escapes of ulang/syntax/syntax.u, read as the
// character that it stands for, and any other backslash kept
function unescaped(text: Str): Str :=
  example unescaped("case List(\\\"a\\\")") == "case List(\"a\")"
  example unescaped("a\\\\b\\q") == "a\\b\\q"
  str(unescaped_chars(chars(text)))

function unescaped_chars(cs: List[Char]): List[Char] :=
  match cs
    case List('\\', c; rest) =>
      match find(escapes(), lambda (e, _) => e == c)
        case Some((_, d)) =>
          List(d; unescaped_chars(rest))
        case None =>
          List('\\'; unescaped_chars(List(c; rest)))
      end

    case List(c; rest) =>
      List(c; unescaped_chars(rest))

    case List() =>
      List()
  end

// the innermost node around pos in the definition of the file at path that holds it
procedure node_at_position(
  in  path: Str,
      pos: Pos,
      files: Map[Str, Str],
  out place: Place
) raises Refused, OsError :=
  var lines: Array[Str], d: Mod
  module_of(in path, files, out lines, d)
  let around := List(for (key, cmd, _) in keyed(placed_of(d)) if is_within(pos, cmd.span) for (_, c) in decl_of(d, key) yield (key, c))
  let where := path ++ ":" ++ show(pos.line) ++ "." ++ show(pos.col)
  match around
    case List((key, cmd); _) =>
      match last(List(for span in line_nodes(lines, cmd) if is_within(pos, span)))
        case Some(span) =>
          place := Place(path, lines, key, cmd, span, size(placed_of(d)))
        case None =>
          raise Refused("no node of " ++ path ++ ":" ++ key_text(key) ++ " holds " ++ where ++ ", which @show " ++ path ++ ":" ++ key_text(key) ++ " shows")
      end

    case List() =>
      raise Refused("no definition of " ++ path ++ " holds " ++ where)
  end

function is_within(pos: Pos, span: Span): Bool :=
  example is_within(Pos(2, 5), Span(Pos(1, 3), Pos(2, 6)))
  example not is_within(Pos(2, 6), Span(Pos(1, 3), Pos(2, 6)))
  span.start <= pos and pos < span.stop

function some_number(n: Int): Option[Int] :=
  Some(n)

// the node of h among the nodes of cmd in lines: the one with its hash, at its index if that has it
function node_of(h: Handle, lines: Array[Str], cmd: Cmd): Option[Span] :=
  let fitting := List(for (span, i) in numbered(line_nodes(lines, cmd)) if h.index >= 0 and hash_of(node_text(lines, span)) == h.hash yield (span, i)) in
  match (find(fitting, lambda (_, i) => i == h.index), fitting)
    case (Some((span, _)), _) =>
      Some(span)

    case (None, List((span, _))) =>
      Some(span)

    case _ =>
      None
  end

// the nodes of spans with the hashes of their texts in lines
function hashed(lines: Array[Str], spans: List[Span]): List[(Span, Int)] :=
  List(for span in spans yield (span, hash_of(node_text(lines, span))))

// the numbers of the nodes before and after region in old, the nodes of a declaration with the hashes of their texts,
// if new, its nodes after an edit of region, has them at the same places from its start and from its end, with the same
// texts but for the nodes around region, whose texts the edit changes; so a node outside an edit keeps its place in the
// tree of nodes, while its text may be that of others, as identical statements are
function aligned(old: List[(Span, Int)], new: List[(Span, Int)], region: Range): Option[(Int, Int)] :=
  example aligned(List((Span(Pos(1, 1), Pos(2, 1)), 7), (Span(Pos(3, 1), Pos(4, 1)), 8)), List(
      (Span(Pos(1, 1), Pos(2, 1)), 7),
      (Span(Pos(3, 1), Pos(4, 1)), 8),
      (Span(Pos(5, 1), Pos(6, 1)), 8)), Range(3, 2)) == Some((1, 1))
  let before := size(List(for (span, _) in old if span.start.line < region.first yield span)) in
  let after := size(List(for (span, _) in old if span.start.line > region.last yield span)) in
  let kept := zip(take(before, old), take(before, new)) ++ zip(drop(size(old) - after, old), drop(size(new) - after, new)) in
  if before + after <= size(new) and forall(kept, lambda ((span, hash), (_, new_hash)) => hash == new_hash or is_around(span, region)) then
    Some((before, after))
  else
    None

// whether the node at span holds region, or ends right before it, where an insertion after its last part joins it
function is_around(span: Span, region: Range): Bool :=
  example is_around(Span(Pos(1, 1), Pos(4, 9)), Range(5, 4))
  span.start.line < region.first and span.stop.line + 1 >= region.first

// the index in new of the node at index i of old, which has olds nodes, after an edit that kept before nodes before it
// and after nodes after it, where the node of the region of a replacement moves to the first node that the edit placed
function kept_index(i: Int, before: Int, after: Int, olds: Int, news: Int): Option[Int] :=
  example kept_index(3, 1, 2, 4, 5) == Some(4)
  if i < before then
    Some(i)
  else if i >= olds - after then
    Some(i - olds + news)
  else if before < news - after then
    Some(before)
  else
    None

// moves the handles of the declaration key of path from its nodes in old to those in new, after an edit that replaced
// the lines of region of old: a node inside region is gone, but the node of region if keep, which moves to the first
// node that the edit placed, and the nodes outside region keep their places in the tree of nodes (aligned), whatever
// their texts; only where format changed the nodes outside region, e.g. by joining the lines of a form that the edit
// shortened, a node whose text is unchanged moves to the node of the same text, the same among those of its text, and a
// node around region to the node at its path in the tree of nodes
procedure rebase(
  in  path: Str,
      key: Key,
      old: Array[Str],
      old_cmd: Cmd,
      new: Array[Str],
      new_cmd: Cmd,
      region: Range,
      keep: Bool,
  ref handles: Handles
) :=
  let old_nodes := line_nodes(old, old_cmd), new_nodes := line_nodes(new, new_cmd)
  let old_hashes := List(for span in old_nodes yield hash_of(node_text(old, span)))
  let new_hashes := List(for span in new_nodes yield hash_of(node_text(new, span)))
  let old_paths := paths_of(old_nodes, List(), 0), new_paths := paths_of(new_nodes, List(), 0)
  let new_table := zip(zip(numbered(new_nodes), new_hashes), new_paths)
  let alignment := aligned(zip(old_nodes, old_hashes), zip(new_nodes, new_hashes), region)
  // the nodes of region, if the edit gave them the texts they had, as a node replaced by its own text, which keep their
  // handles, while format may have changed the nodes around them
  let kept_region := match alignment
    case Some((before, after)) =>
      let olds := take(size(old_nodes) - after - before, drop(before, old_hashes)) in
      if olds == take(size(new_nodes) - after - before, drop(before, new_hashes)) then
        range(before, before + size(olds))
      else
        List()

    case None =>
      List()
  end
  var entries: List[Handle] := List()
  for h in handles.entries do
    var moved := h
    match node_of(h, old, old_cmd)
      case Some(span) if h.path == path and h.key == key =>
        let i := value_or(index_of(span, old_nodes), -1), hash := value_or(get_at(i, old_hashes), 0)
        let rank := size(List(for x in take(i, old_hashes) if x == hash yield x))
        let same_text := List(for (((_, j), x), _) in new_table if x == hash yield j)
        let at_path := List(for (((_, j), _), p) in new_table if Some(p) == get_at(i, old_paths) yield j)
        let by_text := if size(same_text) > rank then
          get_at(rank, same_text)
        else
          get_at(0, at_path)
        // a declaration whose nodes have the texts they had keeps them all, and so do the nodes of a region that has them
        let target := if old_hashes == new_hashes or contains(i, kept_region) then
          Some(i)
        else if is_removed(span, region, keep) then
          None
        else
          match alignment
            case Some((before, after)) =>
              kept_index(i, before, after, size(old_nodes), size(new_nodes))
            case None =>
              by_text
          end
        match target
          case Some(j) =>
            moved := h with index := j, hash := value_or(get_at(j, new_hashes), 0)
          case None =>
            moved := h with index := -1
        end

      case _ =>
        skip
    end
    entries := entries ++ List(moved)
  end
  handles := handles with entries := entries, changed := true

// whether an edit of region removes the node at span, which it does if span is inside it, but for the node of region,
// which a replacement keeps
function is_removed(span: Span, region: Range, keep: Bool): Bool :=
  example is_removed(Span(Pos(4, 3), Pos(5, 9)), Range(4, 5), false)
  let start := span.start.line, stop := span.stop.line in
  region.first <= region.last and region.first <= start and stop <= region.last and not (keep and start == region.first and stop == region.last)

function get_at[A](i: Int, xs: List[A]): Option[A] :=
  example get_at(1, List('a', 'b')) == Some('b')
  if i < 0 then
    None
  else
    find_map(zip(xs, range(0, size(xs))), lambda (x, j) => if j == i then Some(x) else None)

// the paths of nodes, which are in preorder, in the tree of their containment, the indices among the children of the
// nodes around each, where stack has the nodes around the next one with their paths and numbers of children so far, and
// roots the number of nodes around none so far
function paths_of(spans: List[Span], stack: List[(Span, List[Int], Int)], roots: Int): List[List[Int]] :=
  example paths_of(List(
      Span(Pos(1, 1), Pos(5, 1)),
      Span(Pos(2, 3), Pos(3, 1)),
      Span(Pos(4, 3), Pos(5, 1))), List(), 0) == List(List(0), List(0, 0), List(0, 1))
  match (spans, stack)
    case (List(), _) =>
      List()

    case (List(span; rest), List((top, top_path, count); below)) =>
      if top.start <= span.start and span.stop <= top.stop then
        let p := top_path ++ List(count) in
        List(
          p; paths_of(rest, List((span, p, 0), (top, top_path, count + 1); below), roots))
      else
        paths_of(spans, below, roots)

    case (List(span; rest), List()) =>
      List(List(roots); paths_of(rest, List((span, List(roots), 0)), roots + 1))
  end

// shows the node of the address, see is_node_address, with handles, under its declaration
procedure show_node(
  in  address: List[Str],
  ref edits: Edits
) raises Refused, OsError :=
  var place: Place, label: Str, handles := edits.handles, marks: Map[Int, Int] := Map()
  resolved_address(in address, edits, out place, label)
  let region := Range(place.span.start.line, place.span.stop.line)
  mark(in place.path, place.lines, place.key, place.cmd, region, ref handles, marks)
  note(in "@show " ++ label ++ "\n" ++ join("\n", rendered(place.lines, with_comments(place.lines, region), marks)), ref edits)
  edits := edits with handles := handles

procedure show_target(in word: Str, ref edits: Edits) raises Refused, OsError :=
  var handles := edits.handles, marks: Map[Int, Int] := Map()
  var text: Str, source: Source
  let (path, name, arity) := target_of(word)
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let lines := Array(for line in split(text, '\n'))
  let selected := List(for (key, cmd, c) in keyed(placed_of(main_mod(source))) if forall(name, lambda base => is_selected(key, base, arity)) yield (key, cmd, c))
  if selected == List() then
    raise Refused(path ++ " declares no " ++ value_or(name, "declarations"))
  end
  var shown: List[Str] := List()
  for (key, cmd, c) in selected do
    let region := cmd_range(lines, cmd, 0, true)
    // the nodes of a signature are those of its definition, which take in its spec
    let nodes := value_or(map_option(decl_of(main_mod(source), key), lambda (_, merged) => merged), c)
    mark(in path, lines, key, nodes, region, ref handles, marks)
    shown := shown ++ List(join("\n", rendered(lines, region, marks)))
  end
  let whole := if name == None then
    join("\n", rendered(lines, Range(1, size(lines) - 1), marks))
  else
    join("\n\n", shown)
  note(in "@show " ++ word ++ "\n" ++ whole, ref edits)
  edits := edits with handles := handles

// replaces the node of the address by the fragment, inserts it before or after it, or into it, as its last statement
// or case, or drops the node, each at the indentation where it stands, and shows each node that the edit places, with
// handles, where the placed nodes must be of the kind of the node, or for into of the kind of its last part, and stay
// in its declaration
procedure put_at(
  in  place_word: Str,
      address: List[Str],
      fragment: Str,
  ref edits: Edits
) raises Refused, OsError :=
  let word := join(" ", address)
  if place_word != "drop" and is_blank(fragment) then
    raise Refused("@put " ++ word ++ " takes a fragment, the lines after it, and @drop removes a node")
  end
  var place: Place, label: Str, result: Str, source: Source, handles := edits.handles, marks: Map[Int, Int] := Map()
  resolved_address(in address, edits, out place, label)
  // a head is only replaced, since what goes next to it or into it is no part of a head
  for node in find(kinded_nodes(place.lines, place.cmd), lambda node => node.span == place.span) if node.kind == KHead and place_word != "replace" do
    raise Refused("@" ++ (if place_word == "drop" then "drop " else "put " ++ place_word ++ " ") ++ word ++ " takes no head, which only @put " ++ word ++ " replaces")
  end
  let lines := place.lines, start := place.span.start.line, stop := place.span.stop.line, indent := place.span.start.col - 1
  let inner := indent + 2, last_line := str(drop_spaces(chars(line_at(lines, stop))))
  let (region, depth) := match place_word
    case "before" =>
      (Range(start, start - 1), indent)

    case "after" =>
      (Range(stop + 1, stop), indent)

    case "into" =>
      if starts_with(str(drop_spaces(chars(line_at(lines, start)))), "case ") or last_line != "end" then
        (Range(stop + 1, stop), inner)
      else
        (Range(stop, stop - 1), inner)

    case _ =>
      (Range(start, stop), indent)
  end
  let new := if place_word == "drop" then
    List()
  else
    indented(dedented(unmarked(split(fragment, '\n'))), depth)
  let (splice, written) := span_splice(place_word, lines, place.span, region, new)
  var closing: List[(Range, List[Str])]
  closed_heads(in place_word, place, edits.files, out closing)
  let text := join("\n", spliced(List(for line in lines), List((splice, written)) ++ closing))
  formatted(in place.path, text, edits.files, List((Range(region.first, region.first + size(new) - 1), 1)), out result, source)
  let d := main_mod(source), result_lines := Array(for line in split(result, '\n'))
  let verb := match place_word
    case "replace" =>
      "@put"

    case "drop" =>
      "@drop"

    case _ =>
      "@put " ++ place_word
  end
  if size(placed_of(d)) != place.decls then
    raise Refused(verb ++ " " ++ word ++ " writes declarations beyond its node, which @put F writes")
  end
  edits := edits with files := Map(place.path => result; edits.files)
  let done := match place_word
    case "replace" =>
      "replaced "

    case "drop" =>
      "dropped "

    case _ =>
      "put " ++ place_word ++ " "
  end
  note(in done ++ label, ref edits)
  for (_, cmd) in decl_of(d, place.key) do
    rebase(in place.path, place.key, lines, place.cmd, result_lines, cmd, region, place_word == "replace", ref handles)
    let olds := kinded_nodes(lines, place.cmd), news := kinded_nodes(result_lines, cmd)
    let alignment := aligned(hashed(lines, List(for node in olds yield node.span)), hashed(result_lines, List(for node in news yield node.span)), region)
    let placed := match alignment
      case Some((before, after)) =>
        outermost(take(size(news) - after - before, drop(before, news)))
      case None =>
        List(for node in find(news, lambda node => node.span.start.line >= (if place_word == "after" then stop + 1 else start)) if place_word != "drop")
    end
    for expected in expected_kind(place_word, place.span, olds) do
      for node in placed if node.kind != expected and alignment != None do
        raise Refused(verb ++ " " ++ word ++ " places " ++ kind_text(node.kind) ++ " where " ++ label ++ " takes " ++ kind_text(expected))
      end
    end
    match (placed, last(placed))
      case (List(first; _), Some(final)) =>
        let shown := Range(first.span.start.line, final.span.stop.line)
        mark(in place.path, result_lines, place.key, cmd, shown, ref handles, marks)
        note(in join("\n", rendered(result_lines, with_comments(result_lines, shown), marks)), ref edits)

      case _ =>
        skip
    end
  end
  edits := edits with handles := handles

// the head of the signature whose last line of spec a drop of place removes, without its :=, which only a signature with
// a spec has
procedure closed_heads(
  in  place_word: Str,
      place: Place,
      files: Map[Str, Str],
  out closing: List[(Range, List[Str])]
) raises Refused, OsError :=
  closing := List()
  if place_word == "drop" then
    var d: Mod
    module_of(in place.path, files, out _, d)
    for (_, cmd, c) in keyed(placed_of(d)) if is_signature(c) and is_within(place.span.start, cmd.span) and forall(spec_parts(c), lambda part => is_inside(part, place.span)) do
      let head := head_range(place.lines, cmd), line := line_at(place.lines, head.last)
      closing := List(
        (Range(head.last, head.last), List(
          if ends_with(line, " :=") then
            slice(line, 0, size(line) - 3)
          else
            line)))
    end
  end

// the region of lines that an edit of place_word at the node at span replaces, whose region of lines is region, and
// the lines that replace it, given new, the lines of the fragment at the depth of the edit: the text after the node on
// its last line, such as the comma after an element or the ) after the last one, stays after what replaces the node,
// so that a fragment writes the node alone, and an element placed before or after another, or dropped, writes or takes
// the comma between them, where a fragment that writes the comma itself is taken as well, while a comment at the end of
// a line stays with the element that it follows, and a dropped element takes its own
function span_splice(place_word: Str, lines: Array[Str], span: Span, region: Range, new: List[Str]): (Range, List[Str]) :=
  example span_splice("replace", Array("f(", "  a,", "  b)"), Span(Pos(3, 3), Pos(3, 4)), Range(3, 3), List("  c")) == (Range(3, 3), List("  c)"))
  example span_splice("before", Array("f(", "  a,", "  b)"), Span(Pos(3, 3), Pos(3, 4)), Range(3, 2), List("  c")) == (Range(3, 2), List("  c,"))
  example span_splice("after", Array("f(", "  a,", "  b)"), Span(Pos(3, 3), Pos(3, 4)), Range(4, 3), List("  c")) == (Range(3, 3), List("  b,", "  c)"))
  example span_splice("after", Array("f(", "  a,", "  b) // b"), Span(Pos(3, 3), Pos(3, 4)), Range(4, 3), List("  c")) == (Range(3, 3), List("  b, // b", "  c)"))
  example span_splice("after", Array("f(", "  a,", "  b)"), Span(Pos(2, 3), Pos(2, 4)), Range(3, 2), List("  c,")) == (Range(3, 2), List("  c,"))
  example span_splice("drop", Array("f(", "  a,", "  b)"), Span(Pos(3, 3), Pos(3, 4)), Range(3, 3), List()) == (Range(2, 3), List("  a)"))
  example span_splice("drop", Array("f(", "  a, // a", "  b) // b"), Span(Pos(3, 3), Pos(3, 4)), Range(3, 3), List()) == (Range(2, 3), List("  a) // a"))
  let stop_line := line_at(lines, span.stop.line) in
  let head := slice(stop_line, 0, span.stop.col - 1), tail := slice(stop_line, span.stop.col - 1, size(stop_line)) in
  let (code, note) := commented(tail) in
  let parted := starts_with(tail, ","), closed := starts_with(tail, ")") in
  match place_word
    case "replace" =>
      (region, with_tail(if parted or closed then without_comma(new) else new, tail))

    case "before" =>
      (region, if parted or closed then with_tail(without_comma(new), ",") else new)

    case "after" =>
      if parted then
        (region, with_tail(without_comma(new), ","))
      else if closed then
        (Range(span.stop.line, span.stop.line), List(head ++ "," ++ note; with_tail(without_comma(new), code)))
      else
        (region, new)

    case "drop" =>
      let (previous, previous_note) := commented(line_at(lines, region.first - 1)) in
      if closed and ends_with(previous, ",") then
        (Range(region.first - 1, region.last), List(slice(previous, 0, size(previous) - 1) ++ code ++ previous_note))
      else
        (region, List())

    case _ =>
      (region, new)
  end

// the code of a line, or of the rest of one, without the spaces at its end, and the comment at its end with the spaces
// before it, from the first // outside the literals of strings and characters
function commented(line: Str): (Str, Str) :=
  example commented("  b, // b \"c\"") == ("  b,", " // b \"c\"")
  example commented("  \"a//b\"") == ("  \"a//b\"", "")
  let code := slice(line, 0, comment_index(chars(line), 0, None)) in
  let kept := size(code) - size(drop_spaces(reverse(chars(code)))) in
  (slice(line, 0, size(code) - kept), slice(line, size(code) - kept, size(line)))

function comment_index(cs: List[Char], i: Int, quote: Option[Char]): Int :=
  example comment_index(chars("'/' // c"), 0, None) == 4
  match (cs, quote)
    case (List('\\', _; rest), Some(_)) =>
      comment_index(rest, i + 2, quote)

    case (List(c; rest), Some(q)) =>
      comment_index(rest, i + 1, if c == q then None else quote)

    case (List('/', '/'; _), None) =>
      i

    case (List(c; rest), None) =>
      comment_index(rest, i + 1, if c == '"' or c == '\'' then Some(c) else None)

    case (List(), _) =>
      i
  end

// lines with tail after the last one
function with_tail(lines: List[Str], tail: Str): List[Str] :=
  example with_tail(List("a", "b"), ")") == List("a", "b)")
  match reverse(lines)
    case List(final; rest) =>
      reverse(List(final ++ tail; rest))
    case List() =>
      List()
  end

// lines without a comma at the end of the last one
function without_comma(lines: List[Str]): List[Str] :=
  example without_comma(List("a,", "b,")) == List("a,", "b")
  match reverse(lines)
    case List(final; rest) if ends_with(final, ",") =>
      reverse(List(slice(final, 0, size(final) - 1); rest))
    case _ =>
      lines
  end

// where @put places the declarations of a fragment that replace none of their key: side end, at the end of their
// sections, before or after the declaration of name and arity in each section that has one, else at the end, or instead,
// where the declaration of the fragment of that name and kind replaces it whatever its arity, and the others go after it,
// or else the one declaration of the fragment, of another name
data Anchor :=
  case Anchor(side: Str, name: Str, arity: Option[Int])

// the kind of node that a fragment placed at the node of span among nodes must have: that of the node, or for into that
// of its last part, if it has one
function expected_kind(place_word: Str, span: Span, nodes: List[Node]): Option[NodeKind] :=
  let found := if place_word == "into" then
    last(outermost(List(for node in nodes if node.span != span and is_inside(node.span, span))))
  else
    find(nodes, lambda node => node.span == span) in
  map_option(found, lambda node => node.kind)

// the nodes that no other of nodes holds
function outermost(nodes: List[Node]): List[Node] :=
  List(for node in nodes if not exists(nodes, lambda other => other.span != node.span and is_inside(node.span, other.span)))

function is_inside(inner: Span, outer: Span): Bool :=
  example is_inside(Span(Pos(2, 3), Pos(3, 1)), Span(Pos(1, 1), Pos(3, 1)))
  outer.start <= inner.start and inner.stop <= outer.stop

// writes the declarations of the fragment into the file at path: a missing or empty file is the fragment, with its
// header, imports, and sections; else the import lines of the fragment join those of the file, the declarations after
// a line export or builtin go into that section and the others into the implementation, or into the builtin section if
// they are anchored there, each section made if the file has none, where a file without sections gets an implementation
// if the fragment exports, and each replaces the one of its key where the file has it, whatever section the fragment
// names, keeping its doc if the fragment writes none, or is placed by anchor, while a definition gives its head, and its
// doc if the fragment writes no signature, to its signature in export, and a comment of the fragment that is no doc of a
// declaration is refused, since only a new file takes it
procedure put(
  in  path: Str,
      fragment: Str,
      anchor: Anchor,
  ref edits: Edits
) raises Refused, OsError :=
  var text := ""
  try
    current_text(in path, edits.files, out text)
  catch
    case OsError(_) =>
      text := ""
  end
  let code := unmarked(split(fragment, '\n'))
  if is_blank(text) and anchor.side != "end" then
    raise Refused(path ++ " declares no " ++ anchor.name ++ ", since it is empty")
  end
  if is_blank(text) then
    var result: Str
    formatted(in path, join("\n", code) ++ "\n", edits.files, List((Range(1, size(code)), 1)), out result, _)
    edits := edits with files := Map(path => result; edits.files)
    note(in path ++ ": written from the fragment", ref edits)
  else
    var fixed := text
    if exists(code, lambda line => starts_with(line, "import ")) then
      with_fixed_imports(in path, text, code, out fixed, ref edits)
    end
    put_anchored(in path, fixed, code, anchor, ref edits)
  end

// text with each import that fails replaced by the import of the fragment code of the same last name, as the import of a
// package that moved is fixed
procedure with_fixed_imports(
  in  path: Str,
      text: Str,
      code: List[Str],
  out fixed: Str,
  ref edits: Edits
) raises Refused, OsError :=
  var source: Source, lines := split(text, '\n')
  parsed(in path, text, edits.files, no_fragment(), out source)
  for i in main_mod(source).imports if import_failures(i) != List() do
    match find(code, lambda line => starts_with(line, "import ") and Some(imported_base(line)) == last(i.that))
      case Some(line) =>
        lines := take(i.pos.line - 1, lines) ++ List(trim(line)) ++ drop(i.pos.line, lines)
        note(in path ++ ": replaced import " ++ path_text(i.that) ++ " by " ++ trim(line), ref edits)

      case None =>
        skip
    end
  end
  fixed := join("\n", lines)

// the last name of the path of an import line
function imported_base(line: Str): Str :=
  example imported_base("import ubox.box") == "box"
  value_or(last(split(trim(slice(line, size("import "), size(line))), '.')), "")

// the parts of the lines of a fragment, each line with its number in the fragment
data Parts :=
  case Parts(imports: List[Str], exported: List[(Str, Int)], builtins: List[(Str, Int)], implemented: List[(Str, Int)], strays: List[Int])

// the parts of the lines of a fragment, where the lines under no line of a section go to the section unheaded
function parts_of(code: List[Str], unheaded: Str): Parts :=
  parts_from(List(for (line, i) in numbered(code) yield (line, i + 1)), unheaded, Parts(List(), List(), List(), List(), List()))

// the parts of lines, where section is that of the line of a section that came last
function parts_from(lines: List[(Str, Int)], section: Str, parts: Parts): Parts :=
  match lines
    case List((line, i); rest) =>
      if contains(line, List("export", "builtin", "implementation")) then
        parts_from(rest, line, parts)
      else if starts_with(line, "import ") then
        parts_from(rest, section, parts with imports := parts.imports ++ List(line))
      else if section == "export" then
        parts_from(rest, section, parts with exported := parts.exported ++ List((line, i)))
      else if section == "builtin" then
        parts_from(rest, section, parts with builtins := parts.builtins ++ List((line, i)))
      else
        parts_from(rest, section, parts with implemented := parts.implemented ++ List((line, i)))

    case List() =>
      parts with strays := strays_of(parts.exported) ++ strays_of(parts.builtins) ++ strays_of(parts.implemented)
  end

// the lines of the comments at the first column that a blank line, or the end, follows before the next declaration,
// which are no docs
function strays_of(lines: List[(Str, Int)]): List[Int] :=
  match lines
    case List((line, i); rest) =>
      if starts_with(line, "//") and comment_ends_in_blank(rest) then
        List(i; strays_of(rest))
      else
        strays_of(rest)

    case List() =>
      List()
  end

function comment_ends_in_blank(rest: List[(Str, Int)]): Bool :=
  match rest
    case List((line, _); more) =>
      if starts_with(line, "//") then
        comment_ends_in_blank(more)
      else
        is_blank(line)

    case List() =>
      true
  end

// a block of lines that the fragment inserts before the line at of the file, with the line of the fragment that its first
// line stands for, before the first line of the fragment where the block starts with a keyword or a blank line, and its
// role, export, implementation, or none for imports
data Insert :=
  case Insert(at: Int, lines: List[Str], first: Int, role: Str)

procedure put_into(
  in  path: Str,
      text: Str,
      code: List[Str],
  ref edits: Edits
) raises Refused, OsError :=
  put_anchored(in path, text, code, Anchor("end", "", None), ref edits)

// the lines of the fragment under no line of a section go to the builtin section if they are anchored at a declaration
// there that the implementation does not define, else to the implementation; a declaration of the fragment replaces the
// one of its key that is a signature as it is, in its section, else where the file has it, so that no part of the file
// gets a second copy, and a definition of an exported name that the fragment writes without its signature gives its
// doc to the signature, where the docs of the module stand
procedure put_anchored(
  in  path: Str,
      text: Str,
      code: List[Str],
      anchor: Anchor,
  ref edits: Edits
) raises Refused, OsError :=
  var source: Source, combined: Source, result: Str, anchor_key: Option[Key] := None
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  if anchor.side != "end" then
    match distinct(List(for (k, _, _) in keyed(placed_of(d)) if is_selected(k, anchor.name, anchor.arity) yield k))
      case List(k) =>
        anchor_key := Some(k)

      case List() =>
        raise Refused(path ++ " declares no " ++ anchor.name)

      case keys =>
        raise Refused(path ++ " declares " ++ join(", ", List(for k in keys yield key_text(k))) ++ ", so name one by its arity")
    end
  end
  let is_anchor := lambda c: At[Cmd] => anchor_key != None and cmd_key(c) == anchor_key
  let export_anchor := find(d.exported, is_anchor), builtin_anchor := find(d.builtins, is_anchor)
  let impl_anchor := find(d.implemented, lambda c => is_anchor(c) and not is_signature_at(c))
  let parts := parts_of(code, if impl_anchor == None and builtin_anchor != None then
    "builtin"
  else
    "implementation")
  if parts.strays != List() then
    raise Refused("fragment " ++ join(", ", List(for i in parts.strays yield show(i))) ++ ": a comment that is no doc of a declaration, which @put writes only into a new file")
  end
  let exported_at := keyword_line(lines, "export"), builtin_at := keyword_line(lines, "builtin")
  let implemented_at := keyword_line(lines, "implementation")
  let has_sections := exported_at != None or implemented_at != None or builtin_at != None
  let imports := distinct(List(for line in parts.imports if not contains(trim(line), List(for l in lines yield trim(l))) yield trim(line)))
  let code_at := first_code_line(lines)
  let import_at := value_or(map_option(last(List(for i in range(1, size(lines) + 1) if starts_with(line_at(lines, i), "import ") yield i)), lambda i => i + 1), code_at)
  let export_lines := firsts(parts.exported), export_first := value_or(map_option(get_at(0, parts.exported), lambda (_, i) => i), 1)
  let builtin_lines := firsts(parts.builtins), builtin_first := value_or(map_option(get_at(0, parts.builtins), lambda (_, i) => i), 1)
  let impl_lines := firsts(parts.implemented), impl_first := value_or(map_option(get_at(0, parts.implemented), lambda (_, i) => i), 1)
  let end_at := size(lines) + 1
  let has_exports := not is_blank(join("", export_lines)), has_builtins := not is_blank(join("", builtin_lines))
  let export_inserts := if not has_exports then
    List()
  else
    match (exported_at, builtin_at, implemented_at)
      case (Some(e), _, _) =>
        List(
          anchored_insert(lines, export_anchor, anchor.side, section_end(lines, e, end_at), export_lines, export_first, "export"))

      case (None, Some(i), _) | (None, None, Some(i)) =>
        List(
          Insert(i, List("export", ""; export_lines) ++ List(""), export_first - 2, "export"))

      case (None, None, None) =>
        List(
          Insert(import_at, List("export", ""; export_lines) ++ List(""), export_first - 2, "export"))
    end
  // a builtin section follows an export section, also an empty one
  let builtin_head := if exported_at == None and not has_exports then
    List("export", "", "builtin", "")
  else
    List("builtin", "")
  let builtin_inserts := if not has_builtins then
    List()
  else
    match (builtin_at, implemented_at)
      case (Some(b), _) =>
        List(
          anchored_insert(lines, builtin_anchor, anchor.side, section_end(lines, b, end_at), builtin_lines, builtin_first, "builtin"))

      case (None, Some(i)) =>
        List(
          Insert(i, builtin_head ++ builtin_lines ++ List(""), builtin_first - size(builtin_head), "builtin"))

      case (None, None) =>
        if has_sections then
          List(
            Insert(end_at, List("", "builtin", ""; builtin_lines), builtin_first - 3, "builtin"))
        else
          List(
            Insert(import_at, builtin_head ++ builtin_lines ++ List(""), builtin_first - size(builtin_head), "builtin"))
    end
  // a file without sections that gets an export or builtin section has its declarations implemented
  let header_inserts := if not has_sections and (has_exports or has_builtins) then
    List(Insert(import_at, List("implementation", ""), 0, ""))
  else
    List()
  let impl_inserts := if is_blank(join("", impl_lines)) then
    List()
  else if implemented_at == None and has_sections then
    List(
      Insert(end_at, List("", "implementation", ""; impl_lines), impl_first - 3, "implementation"))
  else
    List(
      anchored_insert(lines, impl_anchor, anchor.side, end_at, impl_lines, impl_first, "implementation"))
  let inserts := List(Insert(import_at, imports, 0, "")) ++ export_inserts ++ builtin_inserts ++ header_inserts ++ impl_inserts
  let (all_lines_list, blocks) := inserted(List(for line in lines), inserts)
  let all_text := join("\n", all_lines_list)
  parsed(in path, all_text, edits.files, List(for (r, ins) in blocks if ins.role != "" yield (r, ins.first)), out combined)
  let all := main_mod(combined), all_lines := Array(for line in split(all_text, '\n'))
  let block_of := lambda cmd: At[Cmd] => find(blocks, lambda (r, ins) => ins.role != "" and r.first <= cmd.span.start.line and cmd.span.start.line <= r.last)
  let added := List(for cmd in placed_of(all) for (r, ins) in block_of(cmd) yield (cmd, r, ins.role))
  let olds := List(for cmd in placed_of(all) if block_of(cmd) == None yield cmd)
  if size(olds) != size(placed_of(d)) then
    raise Refused("the fragment continues a declaration of " ++ path)
  end
  for key in repeated(List(for (cmd, _, role) in added for k in cmd_key(cmd) yield (role, k))) do
    raise Refused("the fragment declares " ++ key_text(second(key)) ++ " twice")
  end
  // the declarations of the fragment that replace the anchor whatever their arity, by their roles, those of its name and
  // kind, else those of the one declaration of the fragment if it has its kind and another name
  let is_named := lambda cmd: At[Cmd] => exists(cmd_key(cmd), lambda k => exists(anchor_key, lambda a => k.kind == a.kind and k.base == a.base))
  let fragment_keys := distinct(List(for (cmd, _, _) in added for k in cmd_key(cmd) yield k))
  let renamed := if anchor.side != "instead" or exists(added, lambda (cmd, _, _) => is_named(cmd)) then
    None
  else
    sole(List(for k in sole(fragment_keys) for a in anchor_key if k.kind == a.kind yield k))
  let instead := lambda cmd: At[Cmd] => anchor.side == "instead" and (is_named(cmd) or renamed != None and cmd_key(cmd) == renamed)
  let replacing := List(for (cmd, _, role) in added if instead(cmd) yield role)
  for role in repeated(replacing) do
    raise Refused("the fragment declares several " ++ anchor.name ++ " in " ++ role ++ ", which @put " ++ path ++ ":" ++ anchor.name ++ " replaces by one")
  end
  if anchor.side == "instead" and replacing == List() then
    raise Refused("the fragment declares no " ++ anchor.name ++ ", which @put " ++ path ++ ":" ++ anchor.name ++ " replaces" ++ (if fragment_keys == List() then
      ""
    else
      ", but " ++ join(", ", List(for k in fragment_keys yield key_text(k))) ++ ", while a declaration of another name replaces it only as the one declaration of the fragment, of its kind"))
  end
  var splices: List[(Range, List[Str])] := List(), entries: List[(Str, Str, Str, Str)] := List(), replaced_keys: List[(Key, Key)] := List()
  var exported_keys: List[Key] := List()
  let section_cmds := lambda role: Str => if role == "export" then
    all.exported
  else if role == "builtin" then
    all.builtins
  else
    all.implemented
  let section_of := lambda c: At[Cmd] => if contains(c, all.exported) then
    "export"
  else if contains(c, all.builtins) then
    "builtin"
  else
    "implementation"
  for (cmd, r, role) in added do
    let range := cmd_range(all_lines, cmd, r.first - 1, true)
    let has_doc := range.first < cmd.span.start.line, new_key := cmd_key(cmd)
    let wanted := if instead(cmd) then anchor_key else new_key
    if wanted != new_key and exists(olds, lambda c => cmd_key(c) == new_key) then
      raise Refused(path ++ " declares " ++ value_or(map_option(new_key, key_text), "") ++ " already, so the fragment cannot replace " ++ value_or(map_option(wanted, key_text), "") ++ " by it")
    end
    let is_old := lambda c: At[Cmd] => contains(c, olds) and cmd_key(c) == wanted and is_signature_at(c) == is_signature_at(cmd)
    let old := or_else(find(section_cmds(role), is_old), find(olds, is_old))
    // the signature in export that takes the doc of a definition that the fragment writes without the signature
    let doc_signature := if has_doc and wanted != None and not is_signature_at(cmd) and not exists(added, lambda (c, _, other) => other == "export" and cmd_key(c) == new_key) then
      find(all.exported, lambda c => contains(c, olds) and cmd_key(c) == wanted and is_signature_at(c))
    else
      None
    let doc := lines_in(all_lines, Range(range.first, cmd.span.start.line - 1))
    let new := if doc_signature == None then
      lines_in(all_lines, range)
    else
      lines_in(all_lines, Range(cmd.span.start.line, range.last))
    let moved := if doc_signature == None then "" else ", its doc on its signature"
    for signature in doc_signature do
      splices := splices ++ List(
        (Range(cmd_range(all_lines, signature, 0, true).first, signature.span.start.line - 1), doc))
    end
    match old
      case Some(o) =>
        let replaced := cmd_range(all_lines, o, 0, has_doc)
        let old_key := cmd_key(o), section := section_of(o)
        splices := splices ++ List((replaced, new), (range, List()))
        let kept := if exists(old_key, lambda k => exists(new_key, lambda n => n.base != k.base)) then
          ", whose uses keep the name " ++ anchor.name ++ ", which @rename changes"
        else
          ""
        let entry := if old_key != new_key then
          ("replaced " ++ value_or(map_option(old_key, key_text), "") ++ " by " ++ value_or(map_option(new_key, key_text), ""), moved ++ kept)
        else if new == lines_in(all_lines, replaced) and doc_signature == None then
          ("unchanged " ++ value_or(map_option(new_key, key_text), "a notation"), "")
        else if map_option(cmd_of(o), head_type) != map_option(cmd_of(cmd), head_type) then
          ("replaced " ++ value_or(map_option(new_key, key_text), "a notation"), ", of another type" ++ moved)
        else
          ("replaced " ++ value_or(map_option(new_key, key_text), "a notation"), moved)
        entries := entries ++ List((first(entry), second(entry), section, role))
        replaced_keys := replaced_keys ++ List(for k in new_key for o_k in old_key if section == "implementation" yield (o_k, k))

      case None =>
        if doc_signature != None then
          splices := splices ++ List((range, new))
        end
        exported_keys := exported_keys ++ List(for k in new_key if role == "export" yield k)
        entries := entries ++ List(
          ("added " ++ value_or(map_option(new_key, key_text), "a notation"), moved ++ beside_text(new_key, olds), role, role))
    end
  end
  let plain := not (has_sections or has_exports or has_builtins)
  var done := List(for line in imports yield "added " ++ line) ++ List(for (what, suffix) in distinct(List(for (w, s, _, _) in entries yield (w, s))) for line in Some(done_text(what, suffix, entries, plain)) if line != "" yield line)
  formatted(in path, join("\n", spliced(all_lines_list, splices)), edits.files, no_fragment(), out result, source)
  with_signatures(in path, replaced_keys, edits.files, ref result, done)
  with_exported_raises(in path, text, exported_keys, edits.files, ref result, done)
  edits := edits with files := Map(path => result; edits.files)
  if done != List() then
    note(in path ++ ": " ++ join(", ", done), ref edits)
  end

// the text of the other arities of the name of key among cmds, of its kind, which a declaration of key that is added
// overloads, so that the reply tells an overload from a replacement
function beside_text(key: Option[Key], cmds: List[At[Cmd]]): Str :=
  let others := distinct(List(for k in key for cmd in cmds for o in cmd_key(cmd) if o.kind == k.kind and o.base == k.base and o.arity != k.arity yield key_text(o))) in
  if others == List() then "" else ", beside " ++ join(", ", others)

// the one element of xs, if it has one
function sole[A](xs: List[A]): Option[A] :=
  example sole(List(1)) == Some(1)
  example sole(List(1, 2)) == None
  match xs
    case List(x) =>
      Some(x)
    case _ =>
      None
  end

// the text of the reply of what a fragment did, named once with the sections of its parts among entries, each what it
// did, the rest of its text, the section of the part, and the section that the fragment named, where plain tells a file
// without sections, whose additions name none, and a part that is unchanged beside one replaced is named by that one, so
// that its text is empty
function done_text(what: Str, suffix: Str, entries: List[(Str, Str, Str, Str)], plain: Bool): Str :=
  let parts := List(for (w, s, section, role) in entries if w == what and s == suffix yield (section, role)) in
  let sections := firsts(parts) in
  let sections_of := lambda verb: Str, key: Str => List(for (w, _, section, _) in entries if w == verb ++ key yield section) in
  if starts_with(what, "added ") then
    match sections
      case List("export") =>
        "exported " ++ slice(what, 6, size(what)) ++ suffix

      case List("implementation") =>
        what ++ (if plain then "" else " to implementation") ++ suffix

      case List(section) =>
        what ++ " to " ++ section ++ suffix

      case _ =>
        what ++ sections_text(sections) ++ suffix
    end
  else if starts_with(what, "unchanged ") and sections_of("replaced ", slice(what, 10, size(what))) != List() then
    ""
  else
    let unchanged := if starts_with(what, "replaced ") then
      sections_of("unchanged ", slice(what, 9, size(what)))
    else
      List() in
    let kept := if unchanged == List() then
      ""
    else
      ", unchanged in " ++ join(" and ", unchanged) in
    match parts
      case List((section, role)) if section != role =>
        what ++ " in " ++ section ++ suffix ++ kept
      case _ =>
        what ++ sections_text(sections) ++ suffix ++ kept
    end

function is_signature_at(cmd: At[Cmd]): Bool :=
  exists(cmd_of(cmd), is_signature)

// the line of the keyword of a section, which stands alone at the first column of formatted text
function keyword_line(lines: Array[Str], word: Str): Option[Int] :=
  find(range(1, size(lines) + 1), lambda i => line_at(lines, i) == word)

// the line before which the section that starts at start ends, at the next keyword of a section, else at end_at
function section_end(lines: Array[Str], start: Int, end_at: Int): Int :=
  value_or(find(range(start + 1, end_at), lambda i => contains(line_at(lines, i), List("builtin", "implementation"))), end_at)

// the first line of code, a keyword, an import, or a declaration with its doc, after the header of the file
function first_code_line(lines: Array[Str]): Int :=
  match find(range(1, size(lines) + 1), lambda i => not is_blank(line_at(lines, i)) and not is_comment_line(line_at(lines, i)))
    case Some(i) =>
      doc_start(lines, i, 0)
    case None =>
      size(lines) + 1
  end

// lines with the blocks of inserts, each before its line, and the range of each block in the result, where the blocks at one
// line keep their order
function inserted(lines: List[Str], inserts: List[Insert]): (List[Str], List[(Range, Insert)]) :=
  inserted_from(lines, 1, inserts, 1, List(), List())

function inserted_from(lines: List[Str], line: Int, inserts: List[Insert], out_line: Int, done: List[Str], blocks: List[(Range, Insert)]): (List[Str], List[(Range, Insert)]) :=
  let here := List(for ins in inserts if ins.at == line yield ins) in
  let block_lines := List(for ins in here for l in ins.lines yield l) in
  let ranges := ranges_of(here, out_line) in
  let next_out := out_line + size(block_lines) in
  match lines
    case List(l; rest) =>
      inserted_from(rest, line + 1, inserts, next_out + 1, done ++ block_lines ++ List(l), blocks ++ ranges)
    case List() =>
      (done ++ block_lines, blocks ++ ranges)
  end

function ranges_of(inserts: List[Insert], first: Int): List[(Range, Insert)] :=
  match inserts
    case List(ins; rest) =>
      List(
        (Range(first, first + size(ins.lines) - 1), ins); ranges_of(rest, first + size(ins.lines)))

    case List() =>
      List()
  end

// gives the signature in export of each of keys, the key that a definition replaced and its own, which differ if its
// arity changed, the head of the definition, in text, which is formatted, so that each head ends in :=
procedure with_signatures(
  in  path: Str,
      keys: List[(Key, Key)],
      files: Map[Str, Str],
  ref text: Str,
      done: List[Str]
) raises Refused, OsError :=
  var source: Source, splices: List[(Range, List[Str])] := List()
  parsed(in path, text, files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  for (old, key) in keys do
    let definition := find(keyed(d.implemented), lambda (k, _, c) => k == key and not is_signature(c))
    let signatures := List(for (k, sig, c) in keyed(d.exported) if is_signature(c) and not is_abstract(c) yield (k, sig, c))
    let signature := or_else(find(signatures, lambda (k, _, _) => k == old), find(signatures, lambda (k, _, _) => k == key))
    match (definition, signature)
      case (Some((_, def, _)), Some((_, sig, c))) =>
        let head := head_range(lines, sig), new_head := head_lines(lines_in(lines, cmd_range(lines, def, 0, false)))
        let written := if has_spec(c) then with_assign(new_head) else new_head
        if written != lines_in(lines, head) then
          splices := splices ++ List((head, written))
          done := done ++ List("with the signature of " ++ key_text(key))
        end

      case _ =>
        skip
    end
  end
  if splices != List() then
    formatted(in path, join("\n", spliced(List(for line in lines), splices)), files, no_fragment(), out text, source)
  end

// writes the raises of each procedure of keys that the fragment exported, whose definition writes none, into the head of
// its definition, and into that of its signature unless it writes raises, those of the signature or else those that the
// check of the text before the fragment inferred while the procedure was private, as @export does, since an exported
// procedure raises what its signature says and its definition repeats the signature
procedure with_exported_raises(
  in  path: Str,
      before: Str,
      keys: List[Key],
      files: Map[Str, Str],
  ref text: Str,
      done: List[Str]
) raises Refused, OsError :=
  var source: Source, splices: List[(Range, List[Str])] := List(), found: List[Hint] := List(), hinted := false
  parsed(in path, text, files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  for key in keys do
    let definition := find(keyed(d.implemented), lambda (k, _, c) => k == key and not is_signature(c))
    let signature := find(keyed(d.exported), lambda (k, _, c) => k == key and is_signature(c))
    match (definition, signature)
      case (Some((_, def, CProc(_, _, _, _, _, List(), _, _))), Some((_, sig, CProcSig(_, _, _, _, _, signed, spec)))) =>
        if signed == List() and not hinted then
          file_hints(in path, before, files, out found)
          hinted := true
        end
        let raised := if signed == List() then
          join(", ", List(for h in found for (proc, types) in raises_of(h) if proc.base == key.base for t in types yield format_type(t)))
        else
          join(", ", List(for t in signed yield format_type(t)))
        if raised != "" then
          let def_range := head_range(lines, def), sig_range := head_range(lines, sig)
          splices := splices ++ List(
            (def_range, with_raises(with_assign(head_lines(lines_in(lines, def_range))), raised)))
          if signed == List() then
            let sig_head := with_raises(with_assign(head_lines(lines_in(lines, sig_range))), raised)
            splices := splices ++ List(
              (sig_range, if spec != Spec(List(), None, List()) then
                sig_head
              else
                strip_assign(sig_head)))
          end
          done := done ++ List("with raises " ++ raised ++ " of " ++ key_text(key))
        end

      case _ =>
        skip
    end
  end
  if splices != List() then
    formatted(in path, join("\n", spliced(List(for line in lines), splices)), files, no_fragment(), out text, source)
  end

// the block of a section, which the fragment wrote from its line first, inserted before or after the declaration of the
// anchor in the section, side before or after or instead, else before the line at, at the end of the section
function anchored_insert(lines: Array[Str], anchor: Option[At[Cmd]], side: Str, at: Int, block: List[Str], first: Int, role: Str): Insert :=
  match anchor
    case Some(cmd) if side == "before" =>
      Insert(cmd_range(lines, cmd, 0, true).first, block ++ List(""), first, role)

    case Some(cmd) =>
      Insert(cmd_range(lines, cmd, 0, true).last + 1, List(""; block), first - 1, role)

    case None =>
      Insert(at, List(""; block), first - 1, role)
  end

// the type of the head of a declaration of a value, by which a replacement tells that it changed the type
function head_type(cmd: Cmd): Option[Type] :=
  match cmd
    case CFun(_, _, formals, typ, _, _) =>
      Some(TFun(List(for f in formals yield f.that.typ), typ))

    case CFunSig(_, _, formals, typ, _) =>
      Some(TFun(List(for f in formals yield f.that.typ), typ))

    case CProc(_, _, ins, outs, refs, raised, _, _) =>
      Some(TProc(List(for f in ins yield f.that.typ), List(for f in outs yield f.that.typ), List(for f in refs yield f.that.typ), RWritten(raised)))

    case CProcSig(_, _, ins, outs, refs, raised, _) =>
      Some(TProc(List(for f in ins yield f.that.typ), List(for f in outs yield f.that.typ), List(for f in refs yield f.that.typ), RWritten(raised)))

    case CPatAlias(_, _, formals, typ, _) =>
      Some(TFun(List(for f in formals yield f.that.typ), typ))

    case _ =>
      None
  end

function is_abstract(cmd: Cmd): Bool :=
  match cmd
    case CAbstract(_, _) =>
      true
    case _ =>
      false
  end

// the head with := at the end of its last line
function with_assign(head: List[Str]): List[Str] :=
  match reverse(head)
    case List(last; rest) =>
      reverse(List(last ++ " :="; rest))
    case List() =>
      List()
  end

// removes the declarations of the target, with their docs and signatures
procedure drop_target(in word: Str, ref edits: Edits) raises Refused, OsError :=
  var text: Str, source: Source, result: Str
  let (path, name, arity) := target_of(word)
  let base := value_or(name, "")
  if base == "" then
    raise Refused("@drop takes a declaration file.u:name or a handle, not " ++ word)
  end
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let lines := Array(for line in split(text, '\n'))
  let dropped := List(for (key, cmd, _) in keyed(placed_of(main_mod(source))) if is_selected(key, base, arity) yield (key, cmd))
  let keys := distinct(firsts(dropped))
  if keys == List() then
    raise Refused(path ++ " declares no " ++ base)
  end
  if size(keys) > 1 then
    raise Refused(path ++ " declares " ++ join(", ", List(for key in keys yield key_text(key))) ++ ", so name one by its arity")
  end
  let exported := main_mod(source).exported
  let sections := List(for (_, cmd) in dropped yield if contains(cmd, exported) then "export" else "implementation")
  let splices := List(for (_, cmd) in dropped yield (cmd_range(lines, cmd, 0, true), List()))
  formatted(in path, join("\n", spliced(List(for line in lines), splices)), edits.files, no_fragment(), out result, source)
  edits := edits with files := Map(path => result; edits.files)
  note(in path ++ ": dropped " ++ join(", ", List(for key in keys yield key_text(key))) ++ sections_text(sections), ref edits)

// the sections of the declarations that an edit took, if there are several, since a datatype in export and one in
// implementation, or a signature and its definition, share a name
function sections_text(sections: List[Str]): Str :=
  example sections_text(List("export", "implementation")) == " (export and implementation)"
  match sections
    case List(_, _; _) =>
      if size(distinct(sections)) == 1 then
        " (" ++ show(size(sections)) ++ " in " ++ join("", take(1, sections)) ++ ")"
      else
        " (" ++ join(" and ", sections) ++ ")"

    case _ =>
      ""
  end

// substitutes in the text of the target, a node of the address (is_node_address), a declaration with its doc, its
// signature and definition alike, or a whole file, each line old => new of the fragment, where old occurs in the target
// and at most once in each of its parts, the signature and the definition of a declaration, or in a file each declaration
// and each run of lines of no declaration, the header above the imports included, split at the last => at which it does,
// since => also occurs in code, where the old text with the most of the line is the one meant; or, if a line of the
// fragment is => alone, which formatted code never has, the lines before it by those after it, as whole lines whatever
// their indentation, at most once in each part, or exactly once in the whole of a file; refuses a patch that changes
// nothing, and rebases the handles of the declarations that it changed
procedure patch(
  in  address: List[Str],
      fragment: Str,
  ref edits: Edits
) raises Refused, OsError :=
  var path: Str, lines: Array[Str], parts: List[(Range, Str)], source: Source, result: Str, key := Key("", "", -1), old_cmd: Option[Cmd] := None, whole: Option[Source] := None, label: Str, handles := edits.handles
  let word := join(" ", address)
  if is_blank(fragment) then
    raise Refused("@patch " ++ word ++ " takes a fragment of lines old => new, or old lines, a line => alone, and new lines")
  end
  let code := split(fragment, '\n')
  let arrows := List(for (line, i) in numbered(code) if trim(line) == "=>" yield i + 1)
  if size(arrows) > 1 then
    raise Refused("fragment " ++ show(value_or(get_at(1, arrows), 0)) ++ ": a second line => alone, while a @patch takes one block, so each block takes a @patch of its own")
  end
  let block := index_of("=>", List(for line in code yield trim(line)))
  if is_node_address(address) then
    var place: Place
    resolved_address(in address, edits, out place, label)
    path := place.path, lines := place.lines, parts := List((Range(place.span.start.line, place.span.stop.line), "the node"))
    key := place.key, old_cmd := Some(place.cmd)
  else
    var text: Str
    if size(address) != 1 then
      raise Refused("@patch takes a node, #n, F:name #n, F:name \"text\", or F:L.C, a declaration file.u:name[/arity], or a file, not " ++ word)
    end
    let (file, name, arity) := target_of(word)
    current_text(in file, edits.files, out text)
    parsed(in file, text, edits.files, no_fragment(), out source)
    path := file, lines := Array(for line in split(text, '\n'))
    match name
      case Some(base) =>
        let selected := List(for (k, cmd, c) in keyed(placed_of(main_mod(source))) if is_selected(k, base, arity) yield (k, cmd, c))
        match distinct(List(for (k, _, _) in selected yield k))
          case List(k) =>
            parts := List(for (_, cmd, c) in selected yield (cmd_range(lines, cmd, 0, true), if is_signature(c) then "its signature" else "its definition"))
            key := k, label := file ++ ":" ++ key_text(k), old_cmd := map_option(decl_of(main_mod(source), k), lambda (_, c) => c)

          case List() =>
            raise Refused(path ++ " declares no " ++ base)

          case _ =>
            raise Refused("@patch takes a handle or one declaration file.u:name[/arity], whose signature and definition it patches together, or a file, not " ++ word)
        end

      case None =>
        whole := Some(source), label := file
        if block == None then
          parts := file_parts(lines, main_mod(source))
        else
          parts := List((Range(1, size(lines)), "the file"))
        end
    end
  end
  let regions := List(for (region, _) in parts yield region), labels := List(for (_, what) in parts yield what)
  var patched := List(for region in regions yield join("\n", lines_in(lines, region))), changed := Range(1, 0), taken: List[Str] := List()
  match block
    case Some(i) =>
      var at: List[(Int, Int)]
      let old := unmarked(take(i, code))
      patch_block(in old, unmarked(drop(i + 1, code)), labels, out at, ref patched)
      if at == List() then
        let part := join("\n", List(for line in drop_blank(old) yield trim(line)))
        let counts := List(for text in patched yield size(occurrences(text, part)))
        if size(drop_blank(old)) == 1 and is_once_each(counts) then
          // one old line that is a part of a line of the target patches as the line form does
          let new := join("\n", List(for line in drop_blank(unmarked(drop(i + 1, code))) yield trim(line)))
          patched := List(for text in patched yield substituted(text, part, new))
        else
          var context: Str
          block_context(in path, List(for line in old yield trim(line)), lines, regions, edits, out context)
          let hint := if size(drop_blank(old)) == 1 and exists(counts, lambda n => n > 0) then
            ", and as a part of a line it occurs " ++ occurrence_text(counts, labels) ++ ", so it takes more of its line"
          else
            ""
          raise Refused("@patch: the old lines, " ++ quote(join("\n", List(for line in old yield trim(line)))) ++ ", occur in no line of the target as whole lines" ++ hint ++ context)
        end
      end
      // the definition follows the signature, and only it has nodes
      for (j, k) in take(1, reverse(at)) do
        let first := value_or(map_option(get_at(j, regions), lambda r => r.first), 1) + k
        changed := Range(first, first + i - 1)
      end

    case None =>
      for (line, i) in numbered(code) if not is_blank(line) do
        var absent: Option[Str], split: Option[Str]
        patch_line(in line, i + 1, labels, out absent, split, ref patched)
        taken := taken ++ List(for s in split)
        for old in absent do
          var text: Str, current: Source, earlier: Str
          current_text(in path, edits.files, out text)
          parsed(in path, text, edits.files, no_fragment(), out current)
          earlier_action(in path, lambda before => index_of(old, before) != None, edits, out earlier)
          raise Refused(nowhere_text(path, old, lines, main_mod(current)) ++ earlier)
        end
      end
  end
  let splices := List(for (region, text) in zip(regions, patched) yield (region, split(text, '\n')))
  try
    formatted(in path, join("\n", spliced(List(for line in lines), splices)), edits.files, no_fragment(), out result, source)
  catch
    // a line of several => may have split where the agent did not mean it
    case Refused(message) if taken != List() =>
      raise Refused(message ++ "\n" ++ join("\n", taken))
  end
  if result == join("\n", List(for line in lines)) then
    raise Refused("@patch " ++ word ++ " changes nothing, once formatted")
  end
  let result_lines := Array(for line in split(result, '\n'))
  match whole
    case Some(before) =>
      let old_mod := main_mod(before), new_mod := main_mod(source)
      let keys := distinct(List(for (k, _, _) in keyed(placed_of(old_mod)) ++ keyed(placed_of(new_mod)) yield k))
      let touched := List(for k in keys if decl_text(lines, old_mod, k) != decl_text(result_lines, new_mod, k) yield k)
      for k in touched do
        for (_, c) in decl_of(old_mod, k) do
          for (_, cmd) in decl_of(new_mod, k) do
            rebase(in path, k, lines, c, result_lines, cmd, Range(1, 0), true, ref handles)
          end
        end
      end
      let outside := if outside_text(lines, old_mod) == outside_text(result_lines, new_mod) then
        List()
      else
        List("the lines of no declaration")
      edits := edits with files := Map(path => result; edits.files), handles := handles
      note(in path ++ ": patched " ++ join(", ", List(for k in touched yield key_text(k)) ++ outside), ref edits)

    case None =>
      var shown: List[Str] := List(), marks: Map[Int, Int] := Map()
      for (_, cmd) in decl_of(main_mod(source), key) do
        for c in old_cmd do
          rebase(in path, key, lines, c, result_lines, cmd, changed, true, ref handles)
          // the reply shows the nodes that the patch changed with their handles
          for span in changed_nodes(lines, result_lines, line_nodes(result_lines, cmd)) do
            let region := Range(span.start.line, span.stop.line)
            mark(in path, result_lines, key, cmd, region, ref handles, marks)
            shown := shown ++ List(
              join("\n", rendered(result_lines, with_comments(result_lines, region), marks)))
          end
        end
      end
      edits := edits with files := Map(path => result; edits.files), handles := handles
      note(in "patched " ++ label, ref edits)
      for text in shown do
        note(in text, ref edits)
      end
  end

// the nodes of spans, those of a declaration in new, that an edit of old to new changed: the outermost that start on the
// lines that it changed, where a node starts at the comments that format places above it, so that an edit of a comment
// changed the node that it documents, else the innermost around them, so that an edit of a head alone changed none
function changed_nodes(old: Array[Str], new: Array[Str], spans: List[Span]): List[Span] :=
  example changed_nodes(Array("a", "  b", "  c"), Array("a", "  b", "  d"), List(Span(Pos(2, 3), Pos(3, 4)), Span(Pos(3, 3), Pos(3, 4)))) == List(Span(Pos(3, 3), Pos(3, 4)))
  example changed_nodes(Array("a", "  b", "  c"), Array("a", "  c"), List(Span(Pos(1, 1), Pos(2, 4)), Span(Pos(2, 3), Pos(2, 4)))) == List(Span(Pos(1, 1), Pos(2, 4)))
  example changed_nodes(Array("a", "  // x", "  b"), Array("a", "  // y", "  b"), List(Span(Pos(1, 1), Pos(3, 4)), Span(Pos(3, 3), Pos(3, 4)))) == List(Span(Pos(3, 3), Pos(3, 4)))
  let olds := List(for line in old), news := List(for line in new) in
  let shared := common_prefix(olds, news) in
  let suffix := min(common_prefix(reverse(olds), reverse(news)), min(size(olds), size(news)) - shared) in
  let first := shared + 1, final := size(news) - suffix in
  let starting := List(for span in spans if first <= span.start.line and with_comments(new, Range(span.start.line, span.stop.line)).first <= final) in
  if starting != List() then
    List(for span in starting if not exists(starting, lambda other => other != span and is_inside(span, other)))
  else
    List(for span in last(List(for span in spans if span.start.line < first and span.stop.line >= max(first, final))))

// the number of the elements at the start of xs and ys that they share
function common_prefix[A](xs: List[A], ys: List[A]): Int :=
  example common_prefix(List("a", "b"), List("a", "c")) == 1
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) if x == y =>
      1 + common_prefix(xs_, ys_)
    case _ =>
      0
  end

// adds the examples of the fragment to the spec of the function or procedure of the target, F:name[/n], after the lines
// of its spec, on its signature if it has one, the place of the examples of an exported name, else on its definition,
// writing the := of a signature without a spec, and shows them with their handles
procedure add_examples(
  in  word: Str,
      fragment: Str,
  ref edits: Edits
) raises Refused, OsError :=
  var text: Str, source: Source, handles := edits.handles, marks: Map[Int, Int] := Map()
  let code := drop_blank(unmarked(split(fragment, '\n')))
  let added := size(List(for line in code if starts_with(trim(line), "example ") yield line))
  if not starts_with(trim(value_or(get_at(0, code), "")), "example ") then
    raise Refused("@example " ++ word ++ " takes a fragment of examples, each starting with example")
  end
  let (path, name, arity) := target_of(word)
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  let selected := List(for (key, cmd, c) in keyed(placed_of(d)) if name != None and forall(name, lambda base => is_selected(key, base, arity)) and spec_holder(c) yield (key, cmd, c))
  let ordered := List(for (key, cmd, c) in selected if is_signature(c) yield (key, cmd, c)) ++ List(for (key, cmd, c) in selected if not is_signature(c) yield (key, cmd, c))
  match (distinct(List(for (key, _, _) in selected yield key)), ordered)
    case (List(key), List((_, cmd, c); _)) =>
      var result: Str
      let head := head_range(lines, cmd)
      let at := match spec_range(lines, cmd, c)
        case Some(range) =>
          range.last
        case None =>
          head.last
      end
      // a signature without a spec ends at its head, which the spec follows after :=
      let opened := if is_signature(c) and not has_spec(c) then
        List(
          (Range(head.last, head.last), List(line_at(lines, head.last) ++ " :=")))
      else
        List()
      let new := indented(dedented(code), indent_of(line_at(lines, cmd.span.start.line)) + 2), region := Range(at + 1, at)
      formatted(in path, join("\n", spliced(List(for line in lines), opened ++ List((region, new)))), edits.files, List((Range(at + 1, at + size(new)), 1)), out result, source)
      let after := main_mod(source), result_lines := Array(for line in split(result, '\n'))
      let held := List(for (k, _, other) in keyed(placed_of(after)) if k == key and is_signature(other) == is_signature(c) yield size(spec_of(other).examples))
      if size(placed_of(after)) != size(placed_of(d)) or held != List(size(spec_of(c).examples) + added) then
        raise Refused("@example " ++ word ++ " takes examples alone, while the fragment writes other code")
      end
      let target := if is_signature(c) then "its signature" else "its definition"
      edits := edits with files := Map(path => result; edits.files)
      note(in path ++ ":" ++ key_text(key) ++ ": added " ++ counted(added, "example") ++ " to " ++ target, ref edits)
      for ((_, old_cmd), (_, new_cmd)) in zip(List(for decl in decl_of(d, key)), List(for decl in decl_of(after, key))) do
        rebase(in path, key, lines, old_cmd, result_lines, new_cmd, region, false, ref handles)
        let olds := kinded_nodes(lines, old_cmd), news := kinded_nodes(result_lines, new_cmd)
        let placed := match aligned(hashed(lines, List(for node in olds yield node.span)), hashed(result_lines, List(for node in news yield node.span)), region)
          case Some((before, kept)) =>
            outermost(take(size(news) - kept - before, drop(before, news)))
          case None =>
            List(for node in news if node.kind == KSpec and node.span.start.line > at and node.span.start.line <= at + size(new))
        end
        match (placed, last(placed))
          case (List(first; _), Some(final)) =>
            let shown := Range(first.span.start.line, final.span.stop.line)
            mark(in path, result_lines, key, new_cmd, shown, ref handles, marks)
            note(in join("\n", rendered(result_lines, shown, marks)), ref edits)

          case _ =>
            skip
        end
      end
      edits := edits with handles := handles

    case (List(), _) =>
      raise Refused(path ++ " declares no function or procedure " ++ value_or(name, "") ++ ", whose spec @example writes")

    case _ =>
      raise Refused("@example takes one declaration file.u:name[/arity], not " ++ word)
  end

// whether c has a spec, a function or procedure, its signature or definition
function spec_holder(c: Cmd): Bool :=
  match c
    case CFun(_, _, _, _, _, _)
       | CProc(_, _, _, _, _, _, _, _)
       | CFunSig(_, _, _, _, _)
       | CProcSig(_, _, _, _, _, _, _) =>
      true

    case _ =>
      false
  end

// the parts of a file of lines, whose module is d, that a @patch of the file patches by lines: each declaration with its
// doc, by its name and arity, and each run of lines of no declaration, in the order of the file
function file_parts(lines: Array[Str], d: Mod): List[(Range, Str)] :=
  let decls := List(for (key, cmd, _) in keyed(placed_of(d)) yield (cmd_range(lines, cmd, 0, true), key_text(key))) in
  let outside := List(for region in gaps(List(for (region, _) in decls yield region), size(lines)) yield (region, "the lines of no declaration")) in
  sort(decls ++ outside)

// the runs of the lines from 1 to last that no range of covered holds, where the ranges do not overlap
function gaps(covered: List[Range], last: Int): List[Range] :=
  example gaps(List(Range(7, 7), Range(3, 4)), 8) == List(Range(1, 2), Range(5, 6), Range(8, 8))
  example gaps(List(Range(1, 2)), 2) == List()
  let sorted := sort(covered) in
  let starts := List(1; List(for r in sorted yield r.last + 1)), stops := List(for r in sorted yield r.first - 1) ++ List(last) in
  List(for (first, stop) in zip(starts, stops) if first <= stop yield Range(first, stop))

// the lines of the declaration key in lines, whose module is d, with its doc, its signature and definition alike
function decl_text(lines: Array[Str], d: Mod, key: Key): List[Str] :=
  List(for (k, cmd, _) in keyed(placed_of(d)) if k == key for line in lines_in(lines, cmd_range(lines, cmd, 0, true)) yield line)

// the lines of no declaration in lines that are not blank, whose module is d, since a declaration removed or added
// takes or brings a blank line
function outside_text(lines: Array[Str], d: Mod): List[Str] :=
  List(for region in gaps(List(for (_, cmd, _) in keyed(placed_of(d)) yield cmd_range(lines, cmd, 0, true)), size(lines)) for line in lines_in(lines, region) if not is_blank(line) yield line)

// substitutes in texts, the parts of one target with their labels, the line old => new, the line number of the fragment,
// where old occurs in them and at most once in each, split at the last => at which it does, since => also occurs in code,
// so that the old text that takes the most of the line wins, and a line old => with nothing after deletes old, as old =>
// with a space does; absent is the old text of a line that splits at one => only, if it occurs nowhere, so that the
// refusal can name the declarations of the file that have it, and split says where a line of several => split
procedure patch_line(
  in  line: Str,
      number: Int,
      labels: List[Str],
  out absent: Option[Str],
      split: Option[Str],
  ref texts: List[Str]
) raises Refused :=
  let full := if ends_with(line, " =>") then line ++ " " else line
  let every := line_splits(full, occurrences(full, " => "), texts), coded := line_splits(full, code_arrows(full), texts)
  // an arrow in a string or char literal of the line splits it only if none outside them leaves an old text
  let counts := if exists(coded, lambda (_, _, ns) => is_once_each(ns)) then coded else every
  absent := None, split := None
  match reverse(List(for (old, new, ns) in counts if is_once_each(ns) yield (old, new)))
    case List((old, new); _) =>
      if old == new then
        raise Refused("@patch: fragment line " ++ show(number) ++ ", " ++ quote(line) ++ ", changes nothing")
      end
      if size(counts) > 1 then
        split := Some("fragment line " ++ show(number) ++ " split at its last => that leaves an old text of the target, " ++ quote(old) ++ " => " ++ quote(new))
      end
      texts := List(for text in texts yield substituted(text, old, new))

    case List() =>
      match counts
        case List((old, _, ns)) =>
          if foldl(ns, 0, lambda a, b => a + b) == 0 then
            absent := Some(old)
          else
            raise Refused("@patch: the old text " ++ quote(old) ++ " occurs " ++ occurrence_text(ns, labels) ++ ", so it takes more of its line")
          end

        case List() =>
          raise Refused("@patch: fragment line " ++ show(number) ++ ", " ++ quote(line) ++ ", is no line old => new")

        case _ =>
          raise Refused("@patch: no old text of " ++ quote(line) ++ " occurs in the target and at most once in each of its parts, where a line is old => new")
      end
  end

// the splits of line at the offsets of its arrows into the old and the new text, with the occurrences of the old text
// in each of texts
function line_splits(line: Str, arrows: List[Int], texts: List[Str]): List[(Str, Str, List[Int])] :=
  example line_splits("a => b", List(1), List("xa", "aa")) == List(("a", "b", List(1, 2)))
  List(for i in arrows yield (slice(line, 0, i), slice(line, i + 4, size(line)), List(for text in texts yield size(occurrences(text, slice(line, 0, i))))))

// the offsets of the arrows " => " of a line of code outside its string and char literals, read from the start of
// the line
function code_arrows(line: Str): List[Int] :=
  example code_arrows("f(\"a => b\") => g('\"')") == List(11)
  example code_arrows("a => b => c") == List(1, 6)
  let quoted := Array(for inside in in_literals(chars(line), false)) in
  List(for i in occurrences(line, " => ") if not value_or(get(i + 1, quoted), false))

// whether each of the characters cs lies in a string or char literal, where quoted says whether they start in a string
function in_literals(cs: List[Char], quoted: Bool): List[Bool] :=
  example in_literals(chars("a\"=\\\"\"b"), false) == List(false, true, true, true, true, true, false)
  example in_literals(chars("'\"'x"), false) == List(true, true, true, false)
  match cs
    case List('\\', _; rest) if quoted =>
      List(true, true; in_literals(rest, true))

    case List('"'; rest) =>
      List(true; in_literals(rest, not quoted))

    case List('\'', '\\', _, '\''; rest) if not quoted =>
      List(true, true, true, true; in_literals(rest, false))

    case List('\'', _, '\''; rest) if not quoted =>
      List(true, true, true; in_literals(rest, false))

    case List(_; rest) =>
      List(quoted; in_literals(rest, quoted))

    case List() =>
      List()
  end

// whether counts, of the occurrences of a text in each part of a target, say that it occurs in one at least and at most
// once in each
function is_once_each(counts: List[Int]): Bool :=
  example is_once_each(List(1, 0, 1))
  example not is_once_each(List(0, 2))
  example not is_once_each(List(0))
  exists(counts, lambda n => n > 0) and forall(counts, lambda n => n <= 1)

// how often a text occurs in a target, by the counts of its parts with their labels, where those of one label add up
function occurrence_text(counts: List[Int], labels: List[Str]): Str :=
  example occurrence_text(List(2), List("its definition")) == "2 times in the target"
  example occurrence_text(List(1, 2), List("its signature", "its definition")) == "3 times in the target, 1 in its signature and 2 in its definition"
  let total := foldl(counts, 0, lambda a, b => a + b) in
  let places := List(for label in distinct(labels) yield (label, foldl(List(for (n, l) in zip(counts, labels) if l == label yield n), 0, lambda a, b => a + b))) in
  let found := List(for (label, n) in places if n > 0 yield show(n) ++ " in " ++ label) in
  show(total) ++ " times in the target" ++ (if size(places) == 1 then "" else ", " ++ join(" and ", found))

// the refusal of a @patch whose old text occurs nowhere in its target, with the declarations of the file of lines,
// whose module is d, that have it
function nowhere_text(path: Str, old: Str, lines: Array[Str], d: Mod): Str :=
  let holders := distinct(List(for (key, cmd, _) in keyed(placed_of(d)) if index_of(old, join("\n", lines_in(lines, cmd_range(lines, cmd, 0, true)))) != None yield path ++ ":" ++ key_text(key))) in
  "@patch: the old text " ++ quote(old) ++ " occurs nowhere in the target" ++ (if holders == List() then "" else ", but in " ++ join(", ", holders))

// the end of the refusal of a @patch of the file path whose old lines, wanted without their indentation, occur in none of
// the regions of lines that it searched: the earlier action of the script that removed them, else the text of the
// target if they occur in the file outside it or some of them in it
procedure block_context(
  in  path: Str,
      wanted: List[Str],
      lines: Array[Str],
      regions: List[Range],
      edits: Edits,
  out context: Str
) :=
  earlier_action(in path, lambda before => block_starts(split(before, '\n'), wanted) != List(), edits, out context)
  if context == "" then
    let searched := List(for region in regions for line in lines_in(lines, region) yield line)
    let trimmed := List(for line in searched yield trim(line))
    if block_starts(List(for line in lines), wanted) != List() then
      context := ", but in the file outside the target, which @patch " ++ path ++ " takes, while the target is:\n" ++ join("\n", searched)
    else
      for (n, line) in nearest_line(lines, regions, value_or(get_at(0, drop_blank(wanted)), "")) do
        context := ", and the line of the target that starts most like the first of them is " ++ path ++ ":" ++ show(n) ++ ", " ++ quote(trim(line))
      end
      if exists(wanted, lambda line => not is_blank(line) and contains(line, trimmed)) then
        context := context ++ ", while some of them occur in the target, which is:\n" ++ join("\n", searched)
      end
    end
  end

// the line of lines within regions whose start without its indentation is the longest start of wanted, by its number,
// unless none shares a character with it, where the first of the lines wins
function nearest_line(lines: Array[Str], regions: List[Range], wanted: Str): Option[(Int, Str)] :=
  example nearest_line(Array("f :=", "  g(1,", "    2)"), List(Range(2, 3)), "g(1, 2)") == Some((2, "  g(1,"))
  example nearest_line(Array("a"), List(Range(1, 1)), "b") == None
  let scored := List(for region in regions for n in range(region.first, region.last + 1) yield (common_prefix(chars(trim(line_at(lines, n))), chars(wanted)), n)) in
  let (score, best) := foldl(scored, (0, 0), lambda (s, n), (s_, n_) => if s_ > s then (s_, n_) else (s, n)) in
  if score == 0 then None else Some((best, line_at(lines, best)))

// the end of the refusal of a @patch of the file path whose old text the target lacks, if the file had it before the
// script, as is_found tells of its text, and an earlier action of the script edited it: that action, else empty
procedure earlier_action(
  in  path: Str,
      is_found: Str -> Bool,
      edits: Edits,
  out context: Str
) :=
  context := ""
  let actions := reverse(List(for note in edits.notes if starts_with(note, path ++ ": ") yield note))
  for last in take(1, actions) do
    try
      var before: Str
      os_read_utf8(in path, out before)
      if is_found(before) then
        context := ", which the file had before an earlier action of the script, " ++ last
      end
    catch
      // a file that the script made had no text before it
      case OsError(_) =>
        context := ""
    end
  end

// substitutes in texts, the parts of one target with their labels, the lines old by the lines new, at the indentation of
// the first old line, where old occurs as consecutive whole lines, compared without their indentation, at most once in
// each part, and at is the index of each part where it occurs and its line in it, from 0, empty if it occurs in none
procedure patch_block(
  in  old: List[Str],
      new: List[Str],
      labels: List[Str],
  out at: List[(Int, Int)],
  ref texts: List[Str]
) raises Refused :=
  let wanted := List(for line in old yield trim(line))
  if is_blank(join("", wanted)) then
    raise Refused("@patch: a fragment with a line => alone takes the old lines before it")
  end
  if wanted == List(for line in new yield trim(line)) then
    raise Refused("@patch: the lines before => and after it are the same, so the patch changes nothing")
  end
  let found := List(for text in texts yield block_starts(split(text, '\n'), wanted))
  if not forall(found, lambda ks => size(ks) <= 1) then
    raise Refused("@patch: the old lines, " ++ quote(join("\n", wanted)) ++ ", occur " ++ occurrence_text(List(for ks in found yield size(ks)), labels))
  end
  at := List(for (ks, j) in numbered(found) for k in ks yield (j, k))
  texts := List(for (text, i) in numbered(texts) yield match get_at(i, found)
    case Some(List(k)) =>
      let ls := split(text, '\n') in
      join("\n", take(k, ls) ++ indented(dedented(new), indent_of(value_or(get_at(k, ls), ""))) ++ drop(k + size(old), ls))

    case _ =>
      text
  end)

// the indices, from 0, at which lines continue with the lines wanted, compared without their indentation
function block_starts(lines: List[Str], wanted: List[Str]): List[Int] :=
  example block_starts(List("a", "  b", "c", "b", "c"), List("b", "c")) == List(1, 3)
  List(for k in range(0, size(lines) - size(wanted) + 1) if List(for line in take(size(wanted), drop(k, lines)) yield trim(line)) == wanted)

// the offsets where part occurs in text
function occurrences(text: Str, part: Str): List[Int] :=
  example occurrences("a => b => c", " => ") == List(1, 6)
  if part == "" then
    List()
  else
    List(for i in range(0, size(text) - size(part) + 1) if slice(text, i, i + size(part)) == part)

// text with each occurrence of old replaced by new, where the occurrences do not overlap
function substituted(text: Str, old: Str, new: Str): Str :=
  example substituted("a + a", "a", "bc") == "bc + bc"
  foldr(occurrences(text, old), text, lambda i, acc => slice(acc, 0, i) ++ new ++ slice(acc, i + size(old), size(acc)))

// the files of a script of the journal as they were before and after it
data Change :=
  case Change(path: Str, before: Str, after: Str)

function journal_text(changes: List[Change]): Str :=
  let headers := List(for c in changes yield c.path ++ "\t" ++ show(size(c.before)) ++ "\t" ++ show(size(c.after))) in
  join("\n", List(show(size(changes)); headers)) ++ "\n" ++ join("", List(for c in changes yield c.before ++ c.after))

function journal_changes(text: Str): List[Change] :=
  let lines := split(text, '\n') in
  match lines
    case List(count; rest) =>
      let headers := take(value_or(number(count), 0), rest) in
      let offset := foldl(List(count; headers), 0, lambda n, line => n + size(line) + 1) in
      changes_of(headers, slice(text, offset, size(text)))

    case List() =>
      List()
  end

function changes_of(headers: List[Str], body: Str): List[Change] :=
  match headers
    case List(header; rest) =>
      match split(header, '\t')
        case List(path, before, after) =>
          let b := value_or(number(before), 0), a := value_or(number(after), 0) in
          List(
            Change(path, slice(body, 0, b), slice(body, b, b + a)); changes_of(rest, slice(body, b + a, size(body))))

        case _ =>
          List()
      end

    case List() =>
      List()
  end

test journal_round_trip() :=
  let changes := List(Change("a.u", "x\ny\n", "z"), Change("b.u", "", "w\n"))
  assert journal_changes(journal_text(changes)) == changes

// the numbers of the scripts of the journal, those undone, and those that undo others
procedure journal_numbers(
  in  dir: Str,
  out done: List[Int],
      undone: List[Int],
      undos: List[Int]
) :=
  var entries: List[(Str, Bool)] := List()
  try
    os_list(in os_join(dir, "journal"), out entries)
  catch
    case OsError(_) =>
      entries := List()
  end
  done := List(for (name, _) in entries if ends_with(name, ".txt") for n in number(slice(name, 0, size(name) - 4)) yield n)
  undone := List(for (name, _) in entries if ends_with(name, ".undone") for n in number(slice(name, 0, size(name) - 7)) yield n)
  undos := List(for (name, _) in entries if ends_with(name, ".undo") for n in number(slice(name, 0, size(name) - 5)) yield n)

// restores the files of a script of the journal, if each is as it left it: the one that word numbers, or else the last
// one that is neither undone nor an undo, so that undos in a row go back, while an undo of an undo, by its number, redoes
procedure undo(in word: Option[Str], ref edits: Edits) raises Refused, OsError :=
  var done: List[Int], undone: List[Int], undos: List[Int]
  let dir := edits.state
  journal_numbers(in dir, out done, undone, undos)
  let open := List(for n in done if not contains(n, undone ++ edits.undone) yield n)
  let chosen := match word
    case Some(w) =>
      number(w)
    case None =>
      last(sort(List(for n in open if not contains(n, undos) yield n)))
  end
  match chosen
    case Some(n) if contains(n, open) =>
      var journal: Str, text: Str
      os_read_utf8(in os_join(dir, "journal/" ++ show(n) ++ ".txt"), out journal)
      for c in journal_changes(journal) do
        current_text(in c.path, edits.files, out text)
        if text != c.after then
          raise Refused(c.path ++ " changed after script " ++ show(n) ++ ", so it is not undone")
        end
        edits := edits with files := Map(c.path => c.before; edits.files)
      end
      edits := edits with undone := edits.undone ++ List(n)
      note(in "undid script " ++ show(n), ref edits)

    case _ =>
      raise Refused("no script of the journal to undo" ++ value_or(map_option(word, lambda w => " numbered " ++ w), ""))
  end

function handle_line(h: Handle): Str :=
  join("\t", List(
    show(h.number),
    h.path,
    h.key.kind,
    h.key.base,
    show(h.key.arity),
    show(h.index),
    show(h.hash)))

function handle_of(line: Str): Option[Handle] :=
  match split(line, '\t')
    case List(n, path, kind, base, arity, index, hash) =>
      match (number(n), number(arity), number(index), number(hash))
        case (Some(i), Some(a), Some(j), Some(h)) =>
          Some(Handle(i, path, Key(kind, base, a), j, h))
        case _ =>
          None
      end

    case _ =>
      None
  end

test handle_round_trip() :=
  let h := Handle(7, "a/b.u", Key("value", "++", 2), 3, 12345)
  assert handle_of(handle_line(h)) == Some(h)

// the table of handles in dir, whose paths are from root, with the paths from the working directory here, as the script
// names its files
procedure load_handles(in dir: Str, here: Str, root: Str, out handles: Handles) :=
  var text := ""
  try
    os_read_utf8(in os_join(dir, "handles.txt"), out text)
  catch
    case OsError(_) =>
      text := ""
  end
  let entries := List(for line in split(text, '\n') for h in handle_of(line) yield h with path := normal_file(root, here, h.path))
  handles := Handles(entries, foldl(entries, 0, lambda n, h => max(n, h.number)) + 1, false)

// writes the table of handles into dir with the paths from root, so that it holds whatever the working directory here
procedure save_handles(
  in  dir: Str,
      here: Str,
      root: Str,
      entries: List[Handle]
) raises OsError :=
  os_write_utf8(in os_join(dir, "handles.txt"), join("\n", List(for h in entries yield handle_line(h with path := normal_file(here, root, h.path)))) ++ "\n")

procedure state_dir(out dir: Str) raises OsError :=
  var here: Str, root: Str
  os_cwd(out here)
  project_root(in here, out root)
  dir := os_join(root, "out/refactor")

procedure run_script(
  in  script: Str,
      dry: Bool,
      state: Str,
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
  out reply: List[Str],
      status: Int,
      tested: List[Str]
) :=
  run_actions(in script, dry, Map(), state, check, lambda in paths, listed, out found =>
    found := Tests(List(), 0, 0, 0, Map())
  end, out reply, status, tested)

procedure run_tested_script(
  in  script: Str,
      dry: Bool,
      overlays: Map[Str, Str],
      state: Str,
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
      tester: (in List[Str], List[(Str, Diagnostic)], out Tests),
  out reply: List[Str],
      status: Int
) :=
  run_actions(in script, dry, overlays, state, check, tester, out reply, status, _)

// run_tested_script, which also gives the files whose tests it ran
procedure run_actions(
  in  script: Str,
      dry: Bool,
      overlays: Map[Str, Str],
      state: Str,
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
      tester: (in List[Str], List[(Str, Diagnostic)], out Tests),
  out reply: List[Str],
      status: Int,
      tested: List[Str]
) :=
  reply := List(), status := 0, tested := List()
  try
    var handles: Handles, here: Str, root: Str
    let dir := state
    os_cwd(out here)
    project_root(in here, out root)
    load_handles(in dir, here, root, out handles)
    // the actions read the overlays as the texts of their files, which the script writes only if it changes them
    let base := Map(for path => text in overlays yield normal_file(here, here, path) => text)
    var edits := Edits(base, empty(), List(), handles, List(), state, List(), false), written: Map[Str, Str] := Map(), failure: Option[Str] := None
    var refused := 0
    let all := actions(script)
    for action in all if failure == None do
      if is_rename(action) then
        flush(in edits, ref written)
      end
      try
        for message in fragment_refusal(action, find(all, lambda a => a.line > action.line)) do
          raise Refused(message)
        end
        perform(in action with words := normal_words(here, action.words), check, ref edits)
        if is_rename(action) then
          commit_rename(in edits, ref written)
          edits := edits with expected := List()
        end
      catch
        // a query writes nothing, so its refusal is a note, and the script goes on
        case Refused(message) | OsError(message) if is_query(action) =>
          note(in "@" ++ join(" ", action.words) ++ ": refused, " ++ with_script_lines(message, action.line), ref edits)
          refused := refused + 1

        case Refused(message) =>
          failure := Some(with_script_lines(message, action.line))

        case OsError(message) =>
          failure := Some(action_failure(action, message))
      end
    end
    for message in failure do
      for path => original in written do
        os_write_utf8(in path, original)
      end
      raise Refused(message)
    end
    if edits.handles.changed then
      save_handles(in dir, here, root, saved_entries(handles, edits.handles, dry))
    end
    var changes: List[Change] := List(), original: Str, created: List[Str] := List()
    for path => text in edits.files do
      try
        match (get(path, base), get(path, written))
          case (Some(overlay), _) =>
            original := overlay

          case (None, Some(kept)) =>
            original := kept

          case (None, None) =>
            os_read_utf8(in path, out original)
        end
      catch
        case OsError(_) =>
          original := "", created := created ++ List(path)
      end
      if text != original then
        changes := changes ++ List(Change(path, original, text))
      end
    end
    let changed := List(for c in changes yield c.path)
    // the files whose exports the script changed, whose importers it does not check, which may now have errors
    let interfaces := List(for c in changes if not contains(c.path, created) for names in List(changed_exports(c.before, c.after)) if names != List() yield c.path ++ ": the exports " ++ join(", ", names) ++ " changed, whose importers are not checked")
    let paths := distinct(changed ++ edits.checked)
    var before: List[(Str, Diagnostic)] := List(), after: List[(Str, Diagnostic)] := List(), found: List[(Str, Diagnostic)]
    var journaled: List[Str] := List()
    for path => kept in written do
      os_write_utf8(in path, kept)
    end
    for path in paths if not contains(path, created) do
      check(in path, base, out found)
      before := deduplicated(before ++ found)
    end
    if dry then
      journaled := List(for path in changed yield "would write " ++ path)
    else
      var done: List[Int]
      for c in changes do
        os_write_utf8(in c.path, c.after)
      end
      journal_numbers(in dir, out done, _, _)
      let number := foldl(done, 0, max) + 1
      if changes != List() then
        os_write_utf8(in os_join(dir, "journal/" ++ show(number) ++ ".txt"), journal_text(changes))
        journaled := List("script " ++ show(number) ++ " of the journal")
      end
      if edits.undone != List() and changes != List() then
        os_write_utf8(in os_join(dir, "journal/" ++ show(number) ++ ".undo"), "")
      end
      for n in edits.undone do
        os_write_utf8(in os_join(dir, "journal/" ++ show(n) ++ ".undone"), "")
      end
    end
    // the texts after the script, which a dry run checks without writing them
    let finals := base ++ Map(for c in changes yield c.path => c.after)
    for path in paths do
      check(in path, finals, out found)
      after := deduplicated(after ++ found)
    end
    let added := List(for (file, d) in after if not exists(before, lambda (other, e) => is_same(file, d, other, e)))
    let gone := List(for (file, d) in before if not exists(after, lambda (other, e) => is_same(file, d, other, e)))
    // a script that changes no file has no change to compare, so it lists the state
    let listed := if changes == List() then after else added
    let counts := if paths == List() then
      List()
    else if changes == List() then
      List("checked " ++ counted(size(paths), "file") ++ ", unchanged")
    else
      List(
        "checked " ++ counted(size(paths), "file") ++ ": " ++ show(size(added)) ++ " new, " ++ show(size(gone)) ++ " gone")
    let marker := if changes == List() then "  " else "  + "
    var labels := edits.handles, lines: List[Str] := List()
    for (file, d) in listed do
      var label := ""
      // the nodes of a dry run are not in the files, so its diagnostics have no handles
      if not dry then
        diagnostic_handle(in file, d, edits.files, out label, ref labels)
      end
      lines := lines ++ List(marker ++ label ++ diagnostic_text(file, d))
    end
    lines := lines ++ List(for (file, d) in gone if changes != List() yield "  - " ++ diagnostic_text(file, d))
    if size(labels.entries) > size(edits.handles.entries) then
      save_handles(in dir, here, root, labels.entries)
    end
    var tests := Tests(List(), 0, 0, 0, Map())
    // the tests run on the files, which a dry run does not write
    tested := if edits.tests and not dry then paths else List()
    if tested != List() then
      tester(in tested, listed, out tests)
      var unrun: Map[Str, Str]
      load_unrun(in dir, here, root, out unrun)
      // the tests of the packages of the files tested that the errors of an earlier script left unrun, and which have not
      // run since
      let earlier := List(for f => what in unrun if not contains(f, tested) and exists(tested, lambda t => os_dirname(t) == os_dirname(f)) yield "not run since an earlier script, whose errors left them out: " ++ f ++ ": " ++ what)
      tests := tests with lines := tests.lines ++ earlier
      save_unrun(in dir, here, root, Map(for f => what in unrun if not contains(f, tested) yield f => what) ++ tests.unrun)
    end
    let errors := size(List(for (_, d) in after if not is_warning(d) yield d))
    // a script that changes a file says how many of each are new, so that the first line tells whether they are its own
    let fresh := if changes == List() then
      None
    else
      Some((size(List(for (_, d) in added if not is_warning(d) yield d)), size(List(for (_, d) in added if is_warning(d) yield d))))
    reply := List(
      verdict(dry, paths != List(), errors, size(after) - errors, fresh, refused, tests)) ++ List(for n in edits.notes) ++ journaled ++ counts ++ interfaces ++ lines ++ tests.lines
    status := if tests.failed > 0 then 3 else if errors > 0 or refused > 0 then 1 else 0
  catch
    case Refused(message) =>
      reply := List("rejected", message), status := 1
    case OsError(message) =>
      reply := List("rejected", message), status := 1
  end

// the words of an action with the path of each target F, F:name[/n], or F:L.C by normal_file from the working directory
// here, so that ./a.u and a.u name the same file
function normal_words(here: Str, words: List[Str]): List[Str] :=
  example normal_words("/r", List("show", "./a.u:f/2", "#3")) == List("show", "a.u:f/2", "#3")
  List(for word in words yield match target_of(word)
    case (path, _, _) if ends_with(path, ".u") and not starts_with(word, "\"") and not starts_with(word, "#") =>
      normal_file(here, here, path) ++ slice(word, size(path), size(word))
    case _ =>
      word
  end)

// whether action is a query, which writes nothing but the handles it shows
function is_query(action: Action): Bool :=
  match action.words
    case List("show" | "outline" | "refs" | "sig" | "resolve"; _) =>
      true
    case _ =>
      false
  end

// the message of an error of the system in an action, with the action and its line in the script
function action_failure(action: Action, message: Str): Str :=
  example action_failure(Action(3, List("put", "a/b.u"), ""), "cannot read a/b.u") == "line 3, @put a/b.u: cannot read a/b.u"
  "line " ++ show(action.line) ++ ", @" ++ join(" ", action.words) ++ ": " ++ message

function is_rename(action: Action): Bool :=
  match action.words
    case List("rename"; _) =>
      true
    case _ =>
      false
  end

// writes the files that the actions so far edited, before a rename, which reads the files from disk, where written keeps
// the text that each file had before the script
procedure flush(in edits: Edits, ref written: Map[Str, Str]) raises OsError :=
  var prior: List[(Str, Str)] := List()
  flush_into(in edits, ref written, prior)

// writes the files of a rename and compares the resolutions of the files that it scanned with those that it expects, where
// a difference restores the files as they were before the rename and refuses the script
procedure commit_rename(
  in  edits: Edits,
  ref written: Map[Str, Str]
) raises Refused, OsError :=
  var prior: List[(Str, Str)] := List(), differences: List[Str] := List(), uses: List[(Span, Name, Int)]
  flush_into(in edits, ref written, prior)
  for (path, names) in edits.expected do
    var text: Str
    os_read_utf8(in path, out text)
    resolutions(in path, out uses)
    let lines := Array(for line in split(text, '\n'))
    for difference in first_difference(List(for (span, name, _) in uses yield (span.start, use_text(lines, span), name)), names) do
      differences := differences ++ List(path ++ ":" ++ difference)
    end
  end
  if differences != List() then
    for (path, text) in prior do
      os_write_utf8(in path, text)
    end
    raise Refused(join("\n", List(
      "the rename changes the resolution of other names, so nothing is written:") ++ differences))
  end

// flush, which also collects the texts that it overwrote in prior
procedure flush_into(
  in  edits: Edits,
  ref written: Map[Str, Str],
      prior: List[(Str, Str)]
) raises OsError :=
  for path => text in edits.files do
    var current := ""
    try
      os_read_utf8(in path, out current)
    catch
      case OsError(_) =>
        current := ""
    end
    if text != current then
      if get(path, written) == None then
        written := Map(path => current; written)
      end
      prior := prior ++ List((path, current))
      os_write_utf8(in path, text)
    end
  end

// the first use of found, each at its position with its text, whose name is not the one of expected, the names that the
// uses before the rename should resolve to, in their order, as a text with its position that names the use and both
// names, where a use that is new or that would resolve to nothing, which shifts the uses after it, is told by the uses
// after it
function first_difference(found: List[(Pos, Str, Name)], expected: List[Name]): Option[Str] :=
  example first_difference(List((Pos(3, 7), "g", Name(List(), "g"))), List(Name(List("m"), "g"))) == Some("3.7: the use g would resolve to the local g instead of m.g")
  example first_difference(List((Pos(3, 7), "x", Name(List(), "x"))), List(Name(List("m"), "g"), Name(List(), "x"))) == Some("3.7: the use of m.g just before x here would resolve to nothing, as an ambiguous or unknown name")
  example first_difference(List(
      (Pos(2, 1), "h", Name(List("m"), "h")),
      (Pos(3, 7), "x", Name(List(), "x"))), List(Name(List(), "x"))) == Some("2.1: the use h would be new, resolving to m.h")
  match (found, expected)
    case (List((pos, text, n); rest), List(e; more)) =>
      let at := show(pos.line) ++ "." ++ show(pos.col) in
      if n == e then
        first_difference(rest, more)
      else if names_of(found) == more then
        Some(at ++ ": the use of " ++ format_name(e) ++ " just before " ++ text ++ " here would resolve to nothing, as an ambiguous or unknown name")
      else if names_of(rest) == expected then
        Some(at ++ ": the use " ++ text ++ " would be new, resolving to " ++ resolved_text(n))
      else
        Some(at ++ ": the use " ++ text ++ " would resolve to " ++ resolved_text(n) ++ " instead of " ++ resolved_text(e))

    case (List(), List()) =>
      None

    case (List((pos, text, n); _), List()) =>
      Some(show(pos.line) ++ "." ++ show(pos.col) ++ ": the use " ++ text ++ " would be new, resolving to " ++ resolved_text(n))

    case (List(), List(e; _)) =>
      Some(" the last use of " ++ format_name(e) ++ " would resolve to nothing, as an ambiguous or unknown name")
  end

// a name that a use resolves to, a local, a builtin without a module, or a declaration by its qualified name
function resolved_text(name: Name): Str :=
  example resolved_text(Name(List(), "x")) == "the local x"
  example resolved_text(Name(List(), "show")) == "show"
  if name.path == List() and not contains(name.base, List("==", "compare", "show", "and", "or")) then
    "the local " ++ name.base
  else
    format_name(name)

function names_of(found: List[(Pos, Str, Name)]): List[Name] :=
  List(for (_, _, n) in found yield n)

// the text of a use at span, on the line where it starts
function use_text(lines: Array[Str], span: Span): Str :=
  example use_text(Array("a := f(x)"), Span(Pos(1, 6), Pos(1, 7))) == "f"
  let line := line_at(lines, span.start.line) in
  let stop := if span.stop.line == span.start.line then span.stop.col - 1 else size(line) in
  slice(line, span.start.col - 1, stop)

// the uses of names in the main module of the file at path, as the checker resolves them, in the order of their spans,
// each over the span that writes it, with the number of formals of its type at the use (hints of ulang/check/hints.u)
procedure resolutions(
  in  path: Str,
  out uses: List[(Span, Name, Int)]
) raises Refused, OsError :=
  var text: Str, found: List[Hint]
  os_read_utf8(in path, out text)
  file_hints(in path, text, Map(), out found)
  uses := List(for h in found for use in use_of(h) yield use)

// the hints of the main module of the file at path whose text is text, with the texts of files instead of their files,
// as ulang.sh hints gives them, of a check that the errors do not stop, with the packages other than that of the file
// loaded only as far as it sees them, whose uses resolve as in the whole load
procedure file_hints(
  in  path: Str,
      text: Str,
      files: Map[Str, Str],
  out found: List[Hint]
) raises Refused, OsError :=
  var q: Prog
  try
    var source: Source
    var checks := no_checks()
    parse_file_overlaid(in path, Map(path => text; files), true, out source)
    if has_errors(source) then
      check_cached(in without_unparsed(source), unparsed_names(source), true, true, no_tests, out q, _, _, ref checks)
    else
      check_cached(in source, empty(), false, true, no_tests, out q, _, _, ref checks)
    end
  catch
    case ParseError(message, _) =>
      raise Refused(path ++ ": " ++ message)

    case e =>
      raise Refused(path ++ ": " ++ parse_diagnostic(e).message)

    case e =>
      raise Refused(path ++ ": " ++ internal_message(e))
  end
  found := hints(text, q)

function use_of(h: Hint): Option[(Span, Name, Int)] :=
  match h
    case HUse(span, name, typ) =>
      Some((span, name, arity_of(typ)))
    case _ =>
      None
  end

// the files that may use declarations of the module d of the file at path, whose texts, as the script has edited them,
// name one of words as a whole word, each with its text: the members of the package of d, the .u files of the directory
// of path, first those of them that the walk of the project skips, such as those below out/, then the files of the
// project that are members or import the package, in the order of the walk, all by their normal paths (normal_file)
procedure user_files(
  in  path: Str,
      d: Mod,
      words: List[Str],
      files: Map[Str, Str],
  out found: List[(Str, Str)]
) raises OsError :=
  var here: Str, root: Str, walked: List[Str], below: List[Str]
  os_cwd(out here)
  project_root(in here, out root)
  source_files(in root, out walked)
  source_files(in os_dirname(path), out below)
  let project := List(for file in walked yield normal_file(here, here, file))
  let own := List(for f in List(for file in below yield normal_file(here, here, file)) if os_dirname(f) == os_dirname(path))
  let import_line := "import " ++ path_text(module_dir(d.name))
  found := List()
  for file in distinct(List(for f in own if not contains(f, project)) ++ project) do
    var text: Str
    current_text(in file, files, out text)
    if (contains(file, own) or size(occurrences(text, import_line)) > 0) and exists(words, lambda word => has_word(text, word)) then
      found := found ++ List((file, text))
    end
  end

// the path of the file at path, absolute or from the directory from, as a path from dir if it is below dir, else as an
// absolute path, without . and .., where from and dir are absolute and normal, so that a file has one path in the files
// of a script and in the table of handles, however a script spells it
function normal_file(from: Str, dir: Str, path: Str): Str :=
  example normal_file("/r", "/r", "./a/../b.u") == "b.u"
  example normal_file("/r/x", "/r", "y.u") == "x/y.u"
  example normal_file("/r", "/r/x", "z.u") == "/r/z.u"
  example normal_file("/r", "/r", "/s/t.u") == "/s/t.u"
  let absolute := normal_path(if starts_with(path, "/") then path else os_join(from, path)) in
  if starts_with(absolute, dir ++ "/") then
    slice(absolute, size(dir) + 1, size(absolute))
  else
    absolute

// the .u files below dir, without hidden directories and those named out, as check walks them
procedure source_files(in dir: Str, out files: List[Str]) :=
  var entries: List[(Str, Bool)] := List(), below: List[Str]
  try
    os_list(in dir, out entries)
  catch
    case OsError(_) =>
      entries := List()
  end
  files := List()
  for (name, is_dir) in entries if not starts_with(name, ".") do
    let path := if dir == "." then name else os_join(dir, name)
    if is_dir and name != "out" then
      source_files(in path, out below)
      files := files ++ below
    else
      if not is_dir and ends_with(name, ".u") and name != "project.u" then
        files := files ++ List(path)
      end
    end
  end

function is_name_char(c: Char): Bool :=
  is_letter(c) or is_digit(c) or c == '_'

function is_plain_name(name: Str): Bool :=
  match chars(name)
    case List(c; rest) =>
      (is_letter(c) or c == '_') and forall(rest, is_name_char)
    case List() =>
      false
  end

// line with each occurrence of name as a whole word replaced by new
function with_word(line: Str, name: Str, new: Str): Str :=
  example with_word("f(x) + ff(f)", "f", "g") == "g(x) + ff(g)"
  let starts := List(for i in occurrences(line, name) if is_word_at(line, i, size(name)) yield i) in
  foldl(reverse(starts), line, lambda acc, i => slice(acc, 0, i) ++ new ++ slice(acc, i + size(name), size(acc)))

function is_word_at(line: Str, i: Int, n: Int): Bool :=
  (i == 0 or not is_name_char(at(i - 1, line))) and (i + n >= size(line) or not is_name_char(at(i + n, line)))

// line with name at each of cols, from 1, replaced by new, where name stands there
function at_cols(line: Str, cols: List[Int], name: Str, new: Str): Str :=
  foldl(reverse(sort(cols)), line, lambda acc, col => if slice(acc, col - 1, col - 1 + size(name)) == name then
    slice(acc, 0, col - 1) ++ new ++ slice(acc, col - 1 + size(name), size(acc))
  else
    acc)

// the number of formals of a function or constructor of type typ, or of a procedure
function arity_of(typ: Type): Int :=
  match typ
    case TFun(args, _) =>
      size(args)

    case TProc(ins, outs, refs, _) =>
      size(ins) + size(outs) + size(refs)

    case _ =>
      0
  end

// renames the function, procedure, pattern alias, or constructor of the target, a declaration file.u:name[/arity], at
// its declarations and the examples on them, and at every use that resolves to it in the files that can see it, of
// user_files, which resolve after the writes as before, else the script is undone; docs are listed, and so are, as a
// warning, the declarations of new of every arity that the uses see, among which a use that its arity and types do not
// decide is ambiguous
procedure rename(
  in  word: Str,
      new: Str,
  ref edits: Edits
) raises Refused, OsError :=
  var text: Str, source: Source, here: Str, root: Str, files: List[(Str, Str)], uses: List[(Span, Name, Int)]
  let (path, chosen, arity) := target_of(word)
  let base := value_or(chosen, "")
  if not is_plain_name(base) or not is_plain_name(new) then
    raise Refused("@rename takes a declaration file.u:name of a plain name and a plain name, not " ++ word ++ " and " ++ new)
  end
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  let decls := List(for (key, cmd, c) in keyed(placed_of(d)) if key.kind == "value" and is_selected(key, base, arity) yield (key, cmd, c))
  let constrs := List(for (_, cmd, c) in keyed(placed_of(d)) for constr in constrs_of(c) if constr_name(constr) == base yield (cmd, constr))
  let arities := distinct(List(for (key, _, _) in decls yield key.arity) ++ List(for (_, constr) in constrs yield constr_arity(constr)))
  match arities
    case List(_) =>
      skip

    case List() =>
      raise Refused(path ++ " declares no function, procedure, pattern alias, or constructor " ++ base ++ ", and types and fields are not renamed yet")

    case _ =>
      raise Refused(path ++ " declares " ++ base ++ " of several arities, so name one, " ++ base ++ "/n")
  end
  let n := value_or(get_at(0, arities), 0)
  let members := List(for m in source.mods if is_member(source, d.name, m.name) for cmd in placed_of(m) yield cmd)
  let clashes := exists(keyed(members), lambda (key, _, c) => key.kind == "value" and key.base == new and key.arity == n or exists(constrs_of(c), lambda constr => constr_name(constr) == new))
  if clashes then
    raise Refused("the package of " ++ path ++ " already declares " ++ new ++ "/" ++ show(n))
  end
  let target := Name(d.name, base), renamed := Name(d.name, new)
  os_cwd(out here)
  project_root(in here, out root)
  user_files(in path, d, List(base, new), edits.files, out files)
  // the texts before the rename, by which the declarations that the uses of new also see leave out those it writes
  let unrenamed := edits.files
  var count := 0, touched := 0, also: List[Str] := List()
  var expected: List[(Str, List[Name])] := List()
  for (file, file_text) in files do
    resolutions(in file, out uses)
    let hits := List(for (span, name, k) in uses if name == target and k == n yield span)
    expected := expected ++ List(
      (file, List(for (_, name, k) in uses yield if name == target and k == n then renamed else name)))
    let file_lines := Array(for line in split(file_text, '\n'))
    var edited := List(for line in file_lines)
    if file == path then
      edited := declared(lines, decls, constrs, base, new)
    end
    edited := List(for (line, i) in numbered(edited) yield at_cols(line, List(for span in hits if span.start.line == i + 1 yield span.start.col), base, new))
    if hits != List() or file == path then
      var result: Str, seen_source := source
      if file != path then
        try
          parse_file_overlaid(in file, Map(file => file_text; unrenamed), true, out seen_source)
        catch
          case e =>
            raise Refused(file ++ ": " ++ parse_diagnostic(e).message)
        end
      end
      also := distinct(also ++ seen_decls(seen_source, new))
      formatted(in file, join("\n", edited), edits.files, no_fragment(), out result, _)
      edits := edits with files := Map(file => result; edits.files)
      count := count + size(hits), touched := touched + 1
    end
  end
  edits := edits with expected := expected
  note(in "renamed " ++ format_name(target) ++ " to " ++ new ++ " at its declarations and " ++ counted(count, "use") ++ " in " ++ counted(touched, "file"), ref edits)
  if also != List() then
    note(in "warning: the uses of " ++ new ++ "/" ++ show(n) ++ " also see " ++ join(", ", also) ++ ", so a use that its arity and types do not decide is ambiguous", ref edits)
  end
  var found: List[Str]
  doc_references(in if root == here then "." else root, base, out found)
  for reference in found do
    note(in "not renamed in the docs: " ++ reference, ref edits)
  end

// the lines of the file whose declarations of base are decls and constrs, with new at the name of each and in the
// examples on them
function declared(lines: Array[Str], decls: List[(Key, At[Cmd], Cmd)], constrs: List[(At[Cmd], At[Constr])], base: Str, new: Str): List[Str] :=
  let heads := List(for (_, cmd, _) in decls yield cmd.span.start.line) in
  let specs := List(for (_, cmd, _) in decls for i in range(cmd.span.start.line, tail_end(lines, cmd.span.stop.line) + 1) if starts_with(str(drop_spaces(chars(line_at(lines, i)))), "example ") yield i) in
  let cases := List(for (_, constr) in constrs yield constr.span.start.line) in
  List(for i in range(1, size(lines) + 1) yield if contains(i, heads) or contains(i, specs) or contains(i, cases) then
    with_word(line_at(lines, i), base, new)
  else
    line_at(lines, i))

// whether the module other is main or a member of its package
function is_member(source: Source, main: Path, other: Path): Bool :=
  main == other or exists(source.packages, lambda p => contains(main, p.members) and contains(other, p.members))

function constrs_of(cmd: Cmd): List[At[Constr]] :=
  match cmd
    case CData(_, _, constrs) =>
      constrs
    case _ =>
      List()
  end

function constr_name(constr: At[Constr]): Str :=
  match constr
    case AOk(_, _, Constr(name, _)) =>
      name.base
    case _ =>
      ""
  end

function constr_arity(constr: At[Constr]): Int :=
  match constr
    case AOk(_, _, Constr(_, fields)) =>
      size(fields)
    case _ =>
      0
  end

// the lines of the spec of the definition cmd, its contract and examples after its head, and the line of its head that
// ends in :=
function spec_range(lines: Array[Str], cmd: At[Cmd], c: Cmd): Option[Range] :=
  let head_end := cmd.span.start.line + size(head_lines(lines_in(lines, Range(cmd.span.start.line, cmd.span.stop.line)))) - 1 in
  let stops := List(for part in spec_parts(c) yield part.stop.line) in
  map_option(last(sort(stops)), lambda stop => Range(head_end + 1, stop))

function spec_parts(cmd: Cmd): List[Span] :=
  match cmd
    case CFun(_, _, _, _, spec, _) =>
      spec_spans(spec)

    case CProc(_, _, _, _, _, _, spec, _) =>
      spec_spans(spec)

    case CFunSig(_, _, _, _, spec) =>
      spec_spans(spec)

    case CProcSig(_, _, _, _, _, _, spec) =>
      spec_spans(spec)

    case _ =>
      List()
  end

function spec_spans(spec: Spec): List[Span] :=
  List(for e in spec.pre yield e.span) ++ List(for e in spec.post yield e.span) ++ List(for x in spec.examples yield x.span)

function is_definition_of_value(cmd: Cmd): Bool :=
  match cmd
    case CFun(_, _, _, _, _, _) =>
      true

    case CProc(_, _, _, _, _, _, _, _) =>
      true

    case _ =>
      false
  end

// the head lines with raised written before their :=, as an exported procedure must write what it raises
function with_raises(head: List[Str], raised: Str): List[Str] :=
  example with_raises(List("procedure p(in x: Int) :="), "OsError") == List("procedure p(in x: Int) raises OsError :=")
  match reverse(head)
    case List(last; rest) if raised != "" and ends_with(last, " :=") =>
      reverse(List(
        slice(last, 0, size(last) - 3) ++ " raises " ++ raised ++ " :="; rest))

    case _ =>
      head
  end

// exports the declaration of the target: a function or procedure gets a signature in export with its doc, contract, and
// examples, which leave the definition, and a procedure that raises without saying so the inferred raises in both heads,
// while a datatype, a type alias, or a pattern alias moves into export whole
procedure export_target(in word: Str, ref edits: Edits) raises Refused, OsError :=
  var text: Str, source: Source
  let (path, name, arity) := target_of(word)
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  let selected := List(for (key, cmd, c) in keyed(placed_of(d)) if forall(name, lambda base => is_selected(key, base, arity)) yield (key, cmd, c))
  if exists(selected, lambda (_, cmd, _) => contains(cmd, d.exported)) then
    raise Refused(word ++ " is exported already")
  end
  match selected
    case List((key, cmd, c)) =>
      let range := cmd_range(lines, cmd, 0, true)
      let doc := lines_in(lines, Range(range.first, cmd.span.start.line - 1))
      if is_definition_of_value(c) then
        var result: Str
        var found: List[Hint]
        let spec := spec_range(lines, cmd, c)
        let head := head_lines(lines_in(lines, Range(cmd.span.start.line, cmd.span.stop.line)))
        let head_end := cmd.span.start.line + size(head) - 1
        let body := lines_in(lines, Range(value_or(map_option(spec, lambda r => r.last), head_end) + 1, range.last))
        let spec_lines := value_or(map_option(spec, lambda r => lines_in(lines, r)), List())
        file_hints(in path, text, edits.files, out found)
        let raised := join(", ", List(for h in found for (proc, types) in raises_of(h) if proc.base == key.base for t in types yield format_type(t)))
        let def_head := with_raises(with_assign(head), raised)
        let sig_head := if spec_lines == List() then strip_assign(def_head) else def_head
        let base := spliced(List(for line in lines), List((range, def_head ++ body)))
        formatted(in path, join("\n", base), edits.files, no_fragment(), out result, _)
        put_anchored(in path, result, List("export"; doc ++ sig_head ++ spec_lines), export_neighbour(d, cmd), ref edits)
      else
        var result: Str
        let base := spliced(List(for line in lines), List((range, List())))
        formatted(in path, join("\n", base), edits.files, no_fragment(), out result, _)
        put_anchored(in path, result, List("export"; lines_in(lines, range)), export_neighbour(d, cmd), ref edits)
      end

    case List() =>
      raise Refused(path ++ " declares no " ++ value_or(name, "declaration") ++ " to export")

    case _ =>
      raise Refused(path ++ " declares " ++ join(", ", List(for (key, _, _) in selected yield key_text(key))) ++ ", so name one by its arity")
  end

// where @export puts the new signature of the declaration cmd of the implementation of d: after that of the exported
// declaration nearest before cmd there, else before that of the nearest after it, else at the end of export
function export_neighbour(d: Mod, cmd: At[Cmd]): Anchor :=
  let exported := List(for (k, _, _) in keyed(d.exported) yield k) in
  let keys := List(for c in d.implemented for k in cmd_key(c) if contains(k, exported) yield (c.span.start.line, k)) in
  match last(List(for (line, k) in keys if line < cmd.span.start.line yield k))
    case Some(k) =>
      Anchor("after", k.base, Some(k.arity))

    case None =>
      match find(keys, lambda (line, _) => line > cmd.span.start.line)
        case Some((_, k)) =>
          Anchor("before", k.base, Some(k.arity))
        case None =>
          Anchor("end", "", None)
      end
  end

function raises_of(h: Hint): Option[(Name, List[Type])] :=
  match h
    case HRaises(_, proc, raised) =>
      Some((proc, raised))
    case _ =>
      None
  end

// the head without the := of its last line
function strip_assign(head: List[Str]): List[Str] :=
  match reverse(head)
    case List(last; rest) if ends_with(last, " :=") =>
      reverse(List(slice(last, 0, size(last) - 3); rest))
    case _ =>
      head
  end

// makes the declaration of the target private, unless another module uses it, a member of the package or an importer, by
// the resolutions of their checks: the doc, contract, and examples of its signature go to its definition, and the
// signature goes, while a datatype or an alias moves into the implementation whole
procedure unexport_target(
  in  word: Str,
  ref edits: Edits
) raises Refused, OsError :=
  var text: Str, source: Source
  let (path, name, arity) := target_of(word)
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  let exported := List(for (key, cmd, c) in keyed(d.exported) if forall(name, lambda base => is_selected(key, base, arity)) yield (key, cmd, c))
  match exported
    case List((key, cmd, c)) =>
      var files: List[(Str, Str)], users: List[Str] := List()
      user_files(in path, d, List(key.base), edits.files, out files)
      for (file, _) in files if file != path do
        var uses: List[(Span, Name, Int)]
        resolutions(in file, out uses)
        for (span, _, _) in find(uses, lambda (_, n, k) => n == Name(d.name, key.base) and (key.arity < 0 or k == key.arity)) do
          users := users ++ List(
            file ++ ":" ++ show(span.start.line) ++ "." ++ show(span.start.col))
        end
      end
      if users != List() then
        raise Refused(word ++ " is used by " ++ join(", ", users) ++ ", so it stays exported")
      end
      let sig_range := cmd_range(lines, cmd, 0, true)
      if is_signature(c) then
        let sig_doc := lines_in(lines, Range(sig_range.first, cmd.span.start.line - 1))
        let sig_head := head_lines(lines_in(lines, Range(cmd.span.start.line, cmd.span.stop.line)))
        let spec_lines := if has_spec(c) then
          lines_in(lines, Range(cmd.span.start.line + size(sig_head), sig_range.last))
        else
          List()
        match find(keyed(d.implemented), lambda (k, _, dc) => k == key and not is_signature(dc))
          case Some((_, def, _)) =>
            var result: Str
            let def_range := cmd_range(lines, def, 0, true)
            let def_doc := lines_in(lines, Range(def_range.first, def.span.start.line - 1))
            let def_head := head_lines(lines_in(lines, Range(def.span.start.line, def.span.stop.line)))
            let rest := lines_in(lines, Range(def.span.start.line + size(def_head), def_range.last))
            let new_def := (if def_doc == List() then sig_doc else def_doc) ++ with_assign(def_head) ++ spec_lines ++ rest
            let base := spliced(List(for line in lines), List((sig_range, List()), (def_range, new_def)))
            formatted(in path, join("\n", base), edits.files, no_fragment(), out result, _)
            edits := edits with files := Map(path => result; edits.files)
            note(in path ++ ": unexported " ++ key_text(key), ref edits)

          case None =>
            raise Refused(word ++ " has no definition in " ++ path ++ ", such as a builtin")
        end
      else
        var result: Str
        let base := spliced(List(for line in lines), List((sig_range, List())))
        formatted(in path, join("\n", base), edits.files, no_fragment(), out result, _)
        put_into(in path, result, List("implementation"; lines_in(lines, sig_range)), ref edits)
      end

    case List() =>
      raise Refused(path ++ " exports no " ++ value_or(name, "declaration"))

    case _ =>
      raise Refused(path ++ " exports " ++ join(", ", List(for (key, _, _) in exported yield key_text(key))) ++ ", so name one by its arity")
  end

// a splice of a text, the characters from start to stop replaced by text, which fixes the warnings of fixed
data Splice :=
  case Splice(start: Int, stop: Int, text: Str, fixed: List[Str])

// applies the edits of the warnings of the lints of the file of word, or of the declaration that word names, of the
// rules if any, together, where those that overlap an edit taken before are skipped, for a second @fix to take, and those
// after which the unit of the file has an error that check did not find before are refused, each named with the first
// such error: the edits are tried together, and if that adds an error, each in turn on top of those taken so far, checked
// with the texts of the script as overlays
procedure fix(
  in  word: Str,
      rules: List[Str],
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
  ref edits: Edits
) raises Refused, OsError :=
  var text: Str, source: Source, result: Str, before: List[(Str, Diagnostic)], added: List[(Str, Diagnostic)]
  let (path, name, arity) := target_of(word)
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  let regions := List(for (key, cmd, _) in keyed(placed_of(d)) if forall(name, lambda base => is_selected(key, base, arity)) yield cmd_range(lines, cmd, 0, true))
  let selected := List(for w in lints(d) if rules == List() or contains(show(w.lint), rules) if name == None or exists(regions, lambda r => r.first <= w.pos.line and w.pos.line <= r.last) yield w)
  let fixable := List(for w in selected for edit in w.edit yield (w, edit))
  let starts := line_starts(lines)
  let splices := edit_splices(source, d, text, lines, starts, List(for (w, edit) in fixable yield (show(w.lint) ++ " at " ++ show(w.pos.line) ++ "." ++ show(w.pos.col), edit)))
  let taken := without_overlaps(sort(List(for sp in splices yield (sp.start, sp.stop, sp.text, sp.fixed))), -1)
  if taken == List() then
    formatted(in path, text, edits.files, no_fragment(), out result, _)
    added := List(), before := List()
  else
    // the check reads the texts of the script as overlays, so that a try writes nothing
    check(in path, Map(path => text; edits.files), out before)
    tried_splices(in path, text, edits.files, taken, check, before, out result, added)
  end
  var accepted := taken, refused: List[(List[Str], (Str, Diagnostic))] := List()
  if added != List() then
    accepted := List()
    formatted(in path, text, edits.files, no_fragment(), out result, _)
    for splice in taken do
      var candidate: Str
      tried_splices(in path, text, edits.files, accepted ++ List(splice), check, before, out candidate, added)
      match added
        case List() =>
          accepted := accepted ++ List(splice), result := candidate

        case List(first; _) =>
          let (_, _, _, fixed_labels) := splice
          refused := refused ++ List((fixed_labels, first))
      end
    end
  end
  edits := edits with files := Map(path => result; edits.files)
  let unfixable := size(selected) - size(fixable)
  let labels := distinct(List(for (_, _, _, fixed_labels) in accepted for label in fixed_labels yield label))
  let refused_labels := List(for (fixed_labels, _) in refused for label in fixed_labels yield label)
  let skipped := distinct(List(for sp in splices for label in sp.fixed if not contains(label, labels) and not contains(label, refused_labels) yield label))
  let overlapping := if skipped == List() then
    ""
  else
    ", skipped inside or across another edit, which a second @fix takes if it still applies: " ++ join(", ", skipped)
  let rest := overlapping ++ (if unfixable > 0 then
    ", " ++ counted(unfixable, "warning") ++ " without an edit"
  else
    "")
  let fixed_text := if labels == List() then "nothing to fix" else "fixed " ++ join(", ", labels)
  note(in path ++ ": " ++ fixed_text ++ rest, ref edits)
  for (fixed_labels, (file, error)) in refused do
    note(in path ++ ": refused " ++ join(", ", fixed_labels) ++ ", which would cause " ++ diagnostic_text(file, error), ref edits)
  end

// the text with the splices taken, formatted, and the errors that check finds in it beyond before, with it and files as
// the overlays, where a text that does not parse is its own error
procedure tried_splices(
  in  path: Str,
      text: Str,
      files: Map[Str, Str],
      taken: List[(Int, Int, Str, List[Str])],
      check: (in Str, Map[Str, Str], out List[(Str, Diagnostic)]),
      before: List[(Str, Diagnostic)],
  out result: Str,
      added: List[(Str, Diagnostic)]
) raises OsError :=
  let fixed := foldl(reverse(taken), text, lambda acc, (start, stop, new, _) => slice(acc, 0, start) ++ new ++ slice(acc, stop, size(acc)))
  try
    var found: List[(Str, Diagnostic)]
    formatted(in path, fixed, files, no_fragment(), out result, _)
    check(in path, Map(path => result; files), out found)
    added := new_errors(before, found)
  catch
    case Refused(message) =>
      result := text, added := List((path, diagnostic(ParseKind, message)))
  end

// the errors of after, not the warnings, that before has not, each of before matching one of after by is_same
function new_errors(before: List[(Str, Diagnostic)], after: List[(Str, Diagnostic)]): List[(Str, Diagnostic)] :=
  match after
    case List() =>
      List()

    case List((file, d); rest) =>
      if is_warning(d) then
        new_errors(before, rest)
      else
        match without_same(before, file, d)
          case Some(left) =>
            new_errors(left, rest)
          case None =>
            List((file, d); new_errors(before, rest))
        end
  end

// diagnostics without the first that is_same as d of file, if one is
function without_same(diagnostics: List[(Str, Diagnostic)], file: Str, d: Diagnostic): Option[List[(Str, Diagnostic)]] :=
  match diagnostics
    case List() =>
      None

    case List((other, e); rest) =>
      if is_same(file, d, other, e) then
        Some(rest)
      else
        map_option(without_same(rest, file, d), lambda left => List((other, e); left))
  end

// the offsets of the starts of the lines, from 1, and of the end
function line_starts(lines: Array[Str]): Array[Int] :=
  Array(for n in reverse(foldl(List(for line in lines), List(0), lambda acc, line => List(value_or(get_at(0, acc), 0) + size(line) + 1; acc))))

function offset_of(starts: Array[Int], pos: Pos): Int :=
  at(pos.line - 1, starts) + pos.col - 1

function line_offset(starts: Array[Int], line: Int): Int :=
  at(min(line, size(starts)) - 1, starts)

// the splices of the edits in the text of the module d of source, each with the label of its warning, where the edits of
// the declarations of one statement are one splice of it
function edit_splices(source: Source, d: Mod, text: Str, lines: Array[Str], starts: Array[Int], edits: List[(Str, Edit)]): List[Splice] :=
  let moves := List(for (label, edit) in edits for (local, decl, bodies) in move_of(edit) yield (local, decl, bodies, label)) in
  let locals := distinct(List(for (local, _, _, _) in moves yield local)) in
  let simple := List(for (label, edit) in edits for sp in simple_splice(source, d, text, lines, starts, edit) yield sp with fixed := List(label)) in
  let calls := distinct(List(for (_, edit) in edits for (spans, _) in drop_outs_of(edit) for c in spans yield c)) in
  let outs := List(for call in calls yield out_splice(text, starts, call, names_at(call, edits)) with fixed := labels_at(call, edits)) in
  let local_edits := List(for local in locals for sp in local_splices(text, lines, starts, local, List(for (l, decl, bodies, _) in moves if l == local yield (decl, bodies))) yield sp with fixed := List(for (l, _, _, label) in moves if l == local yield label)) in
  simple ++ outs ++ local_edits

// the names that the edits drop at the outs of the call at call, and the labels of their warnings
function names_at(call: Span, edits: List[(Str, Edit)]): List[Id] :=
  List(for (_, edit) in edits for (spans, name) in drop_outs_of(edit) if contains(call, spans) yield name)

function labels_at(call: Span, edits: List[(Str, Edit)]): List[Str] :=
  List(for (label, edit) in edits for (spans, _) in drop_outs_of(edit) if contains(call, spans) yield label)

function move_of(edit: Edit): Option[(Span, Span, List[Span])] :=
  match edit
    case EditMove(local, decl, bodies) =>
      Some((local, decl, bodies))

    case EditDropOuts(local, decl, _, _) =>
      Some((local, decl, List()))

    case _ =>
      None
  end

function simple_splice(source: Source, d: Mod, text: Str, lines: Array[Str], starts: Array[Int], edit: Edit): Option[Splice] :=
  match edit
    case EditExpr(span, expr) =>
      Some(Splice(offset_of(starts, span.start), offset_of(starts, span.stop), "(" ++ format_module_expr(source, d.name, expr) ++ ")", List()))

    case EditDrop(pos) =>
      map_option(find(placed_of(d), lambda cmd => cmd.pos == pos), lambda cmd => let range := cmd_range(lines, cmd, 0, true) in
      Splice(line_offset(starts, range.first), line_offset(starts, range.last + 1), "", List()))

    case EditWild(span) =>
      Some(Splice(offset_of(starts, span.start), offset_of(starts, span.stop), "_", List()))

    case EditLet(span) =>
      let start := offset_of(starts, span.start) in
      if slice(text, start, start + 3) == "var" then
        Some(Splice(start, start + 3, "let", List()))
      else
        None

    case EditMove(_, _, _) =>
      None

    case EditDropOuts(_, _, _, _) =>
      None
  end

function drop_outs_of(edit: Edit): Option[(List[Span], Id)] :=
  match edit
    case EditDropOuts(_, _, calls, name) =>
      Some((calls, name))
    case _ =>
      None
  end

// the splice of the call at span that writes _ for each of names among its outs, the arguments after its out up to its
// ref, which the call names by their words, since the outs of a call have no positions, all in one splice, since the
// declarations of the names go together
function out_splice(text: Str, starts: Array[Int], span: Span, names: List[Id]): Splice :=
  let first := offset_of(starts, span.start), last := offset_of(starts, span.stop) in
  let call := slice(text, first, last) in
  let outs_at := value_or(index_of("out ", call), size(call)) in
  let refs_at := value_or(map_option(index_of(" ref ", slice(call, outs_at, size(call))), lambda i => outs_at + i), size(call)) in
  let outs := foldl(names, slice(call, outs_at, refs_at), lambda acc, name => with_word(acc, name, "_")) in
  Splice(first, last, slice(call, 0, outs_at) ++ outs ++ slice(call, refs_at, size(call)), List())

// the splices that remove the declarations of moves from the statement over local, and the statement if none is left, and
// declare each by var at the start of the bodies that it moves into, those of one body in one var
function local_splices(text: Str, lines: Array[Str], starts: Array[Int], local: Span, moves: List[(Span, List[Span])]): List[Splice] :=
  let first := offset_of(starts, local.start), last := offset_of(starts, local.stop) in
  let stmt := slice(text, first, last) in
  let decl_texts := List(for (decl, _) in moves yield slice(text, offset_of(starts, decl.start), offset_of(starts, decl.stop))) in
  let kept := foldl(reverse(sort(List(for (decl, _) in moves yield (offset_of(starts, decl.start) - first, offset_of(starts, decl.stop) - first)))), stmt, without_decl) in
  let removal := if is_blank(slice(kept, 3, size(kept))) then
    Splice(line_offset(starts, local.start.line), line_offset(starts, local.stop.line + 1), "", List())
  else
    Splice(first, last, kept, List()) in
  let bodies := distinct(List(for (_, spans) in moves for body in spans yield body)) in
  List(
    removal; List(for body in bodies yield Splice(line_offset(starts, body.start.line), line_offset(starts, body.start.line), repeat(body.start.col - 1, " ") ++ "var " ++ join(", ", declared_in(body, moves, decl_texts)) ++ "\n", List())))

// the texts of the declarations of moves that move into body
function declared_in(body: Span, moves: List[(Span, List[Span])], decl_texts: List[Str]): List[Str] :=
  List(for ((_, spans), t) in zip(moves, decl_texts) if contains(body, spans) yield t)

// stmt without the declaration from start to stop, and the comma after it, else the one before it
function without_decl(stmt: Str, range: (Int, Int)): Str :=
  example without_decl("var a: Int, b, c", (4, 10)) == "var b, c"
  example without_decl("var a: Int, b", (12, 13)) == "var a: Int"
  let (start, stop) := range in
  if stop + 2 <= size(stmt) and slice(stmt, stop, stop + 2) == ", " then
    slice(stmt, 0, start) ++ slice(stmt, stop + 2, size(stmt))
  else if start >= 2 and slice(stmt, start - 2, start) == ", " then
    slice(stmt, 0, start - 2) ++ slice(stmt, stop, size(stmt))
  else
    slice(stmt, 0, start) ++ slice(stmt, stop, size(stmt))

// the splices, sorted, without those that overlap one before them, where last is the stop of the last one taken
function without_overlaps(splices: List[(Int, Int, Str, List[Str])], last: Int): List[(Int, Int, Str, List[Str])] :=
  match splices
    case List((start, stop, new, labels); rest) =>
      if start < last and stop > start then
        without_overlaps(rest, last)
      else
        List(
          (start, stop, new, labels); without_overlaps(rest, max(last, stop)))

    case List() =>
      List()
  end

// the first line of the reply
function verdict(dry: Bool, checked: Bool, errors: Int, warnings: Int, fresh: Option[(Int, Int)], refused: Int, tests: Tests): Str :=
  example verdict(false, true, 3, 1, None, 0, Tests(List(), 0, 0, 0, Map())) == "applied, 3 errors, 1 warning"
  example verdict(false, true, 3, 1, Some((1, 0)), 0, Tests(List(), 0, 0, 0, Map())) == "applied, 3 errors (1 new), 1 warning (0 new)"
  example verdict(false, true, 0, 0, Some((0, 0)), 0, Tests(List(), 2, 1, 4, Map())) == "applied, clean, 2 tests passed, 1 failed, 4 not run"
  example verdict(false, false, 0, 0, None, 0, Tests(List(), 0, 0, 0, Map())) == "applied"
  example verdict(false, false, 0, 0, None, 2, Tests(List(), 0, 0, 0, Map())) == "applied, 2 queries refused"
  example verdict(true, true, 1, 0, Some((1, 0)), 0, Tests(List(), 0, 0, 0, Map())) == "dry, 1 error (1 new)"
  let state := if not checked then
    List()
  else if errors == 0 and warnings == 0 then
    List("clean")
  else
    List(for (n, noun, added) in List(
      (errors, "error", map_option(fresh, first)),
      (warnings, "warning", map_option(fresh, second))) if n > 0 yield counted(n, noun) ++ value_or(map_option(added, lambda k => " (" ++ show(k) ++ " new)"), "")) in
  let ran := if tests.passed + tests.failed + tests.skipped == 0 then
    List()
  else
    List(counted(tests.passed, "test") ++ " passed") ++ List(for (n, what) in List((tests.failed, " failed"), (tests.skipped, " not run")) if n > 0 yield show(n) ++ what) in
  let queries := if refused == 0 then
    List()
  else if refused == 1 then
    List("1 query refused")
  else
    List(show(refused) ++ " queries refused") in
  join(", ", List(if dry then "dry" else "applied") ++ state ++ queries ++ ran)

// the names that the export and builtin sections of the formatted texts before and after declare differently: those of
// the declarations whose lines differ, with the constructors and fields of a datatype, which importers name
function changed_exports(before: Str, after: Str): List[Str] :=
  example changed_exports("export\n\nfunction f(x: Int): Int\n\nfunction g(): Int\n", "export\n\nfunction f(y: Int): Int\n\nfunction g(): Int\n") == List("f")
  example changed_exports("export\n\ndata T :=\n  case C(name: Int)\n", "export\n\ndata T :=\n  case C(name: Int)\n  case D\n") == List("T", "C", "name", "D")
  example changed_exports("function f(): Int :=\n  1\n", "function f(): Int :=\n  2\n") == List()
  let old := exported_blocks(before), new := exported_blocks(after) in
  distinct(List(for k in distinct(List(for k => _ in old yield k) ++ List(for k => _ in new yield k)) if get(k, old) != get(k, new) for word in List(
    k; declared_parts(value_or(get(k, old), List()) ++ value_or(get(k, new), List()))) yield word))

// the declarations of the export and builtin sections of a formatted text, the lines of each name without comments and
// blank lines, where a declaration starts with a keyword at the first column and goes on in the lines below it that do
// not
function exported_blocks(text: Str): Map[Str, List[Str]] :=
  example exported_blocks("export\n\n// the f\nfunction f(\n  x: Int\n): Int\n\nimplementation\n\nfunction g(): Int :=\n  1\n") == Map("f" => List("function f(", "  x: Int", "): Int"))
  blocks_of(List(for line in split(text, '\n') if not is_blank(line) and not starts_with(trim(line), "//")), false, "", Map())

function blocks_of(lines: List[Str], exporting: Bool, current: Str, found: Map[Str, List[Str]]): Map[Str, List[Str]] :=
  match lines
    case List(line; rest) =>
      if line == "export" or line == "builtin" then
        blocks_of(rest, true, "", found)
      else if line == "implementation" then
        found
      else if not exporting then
        blocks_of(rest, exporting, current, found)
      else if is_letter(at(0, line)) then
        let name := declared_name(line) in
        blocks_of(rest, exporting, name, put(name, value_or(get(name, found), List()) ++ List(line), found))
      else
        blocks_of(rest, exporting, current, put(current, value_or(get(current, found), List()) ++ List(line), found))

    case List() =>
      found
  end

// the name that the first line of a declaration declares, the operator of a notation
function declared_name(line: Str): Str :=
  example declared_name("function f[A](x: A): A") == "f"
  example declared_name("data T :=") == "T"
  example declared_name("infix left 7 --") == "--"
  let words := split(line, ' ') in
  if contains(value_or(get_at(0, words), ""), List("infix", "prefix", "postfix")) then
    value_or(last(words), "")
  else
    head_name(value_or(get_at(1, words), ""))

// the constructors and fields that the lines of a datatype declare, in its case lines
function declared_parts(lines: List[Str]): List[Str] :=
  example declared_parts(List("data T :=", "  case C(name: Int, at: Map[Int, Str])", "  case D")) == List("C", "name", "at", "D")
  List(for line in lines if starts_with(trim(line), "case ") for word in constr_words(slice(trim(line), size("case "), size(trim(line)))) yield word)

function constr_words(text: Str): List[Str] :=
  List(
    head_name(text); List(for w in split(text, ' ') if ends_with(w, ":") yield head_name(after_paren(w))))

// word after its last (, if any
function after_paren(word: Str): Str :=
  example after_paren("C(name:") == "name:"
  match last(occurrences(word, "("))
    case Some(i) =>
      slice(word, i + 1, size(word))
    case None =>
      word
  end

// the start of word up to the first (, [, or :
function head_name(word: Str): Str :=
  example head_name("f[A](x:") == "f"
  str(take_while(chars(word), lambda c => not contains(c, List('(', '[', ':'))))

// the tests that the errors of scripts left unrun, of files by their normal paths, kept in dir with the paths from root,
// as the handles are
procedure load_unrun(
  in  dir: Str,
      here: Str,
      root: Str,
  out unrun: Map[Str, Str]
) :=
  var text := ""
  try
    os_read_utf8(in os_join(dir, "unrun.txt"), out text)
  catch
    case OsError(_) =>
      text := ""
  end
  unrun := Map(for line in lines(text) for (path, what) in unrun_entry(line) yield normal_file(root, here, path) => what)

function unrun_entry(line: Str): Option[(Str, Str)] :=
  match split(line, '\t')
    case List(path, what) =>
      Some((path, what))
    case _ =>
      None
  end

procedure save_unrun(
  in  dir: Str,
      here: Str,
      root: Str,
      unrun: Map[Str, Str]
) raises OsError :=
  os_write_utf8(in os_join(dir, "unrun.txt"), join("", List(for path => what in unrun yield normal_file(here, root, path) ++ "\t" ++ what ++ "\n")))

// the diagnostics of found without those after the first of the same file, position, and code, as the checks of two
// members of one package both report an error of one of them, the other with its module
function deduplicated(found: List[(Str, Diagnostic)]): List[(Str, Diagnostic)] :=
  example deduplicated(List(
      ("a.u", Diagnostic(TypeKind, "E", None, Pos(1, 1), "m", List())),
      ("a.u", Diagnostic(TypeKind, "E", Some(List("a")), Pos(1, 1), "m", List())))) == List(("a.u", Diagnostic(TypeKind, "E", None, Pos(1, 1), "m", List())))
  foldl(found, List(), lambda kept: List[(Str, Diagnostic)], (file, d) => if exists(kept, lambda (other, e) => other == file and e.pos == d.pos and e.code == d.code) then
    kept
  else
    kept ++ List((file, d)))

// whether d is a warning of a lint, which does not fail a check, as checked_diagnostics of ulang/ulang.u writes them
function is_warning(d: Diagnostic): Bool :=
  starts_with(d.code, "warning[")

// the message of a refused action at the line line of the script, where each position in its fragment, fragment L.C at the
// start of a line, also gets its line in the script, since the fragment starts on the line after the action
function with_script_lines(message: Str, line: Int): Str :=
  example with_script_lines("fragment 2.6: expression expected\nfragment 3, 4: a comment", 4) == "fragment 2.6, script 6.6: expression expected\nfragment 3, 4, script 7, 8: a comment"
  example with_script_lines("a.u:2.6: expression expected", 4) == "a.u:2.6: expression expected"
  join("\n", List(for text in split(message, '\n') yield with_script_line(text, line)))

function with_script_line(text: Str, line: Int): Str :=
  match occurrences(text, ": ")
    case List(i; _) if starts_with(text, "fragment ") =>
      let items := List(for item in split(slice(text, size("fragment "), i), ',') yield script_position(str(drop_spaces(chars(item))), line)) in
      if forall(items, lambda item => item != None) then
        slice(text, 0, i) ++ ", script " ++ join(", ", List(for item in items for p in item yield p)) ++ slice(text, i, size(text))
      else
        text

    case _ =>
      text
  end

// the position L or L.C of a fragment as L + line, or None if it is none
function script_position(item: Str, line: Int): Option[Str] :=
  example script_position("2.6", 4) == Some("6.6")
  match split(item, '.')
    case List(l) =>
      map_option(number(l), lambda n => show(n + line))

    case List(l, c) =>
      map_option(number(l), lambda n => show(n + line) ++ "." ++ c)

    case _ =>
      None
  end

// whether two diagnostics are the same but for their positions, which edits move, and the numbers of the unknowns in
// their messages, which depend on what the checker checked before
function is_same(file: Str, d: Diagnostic, other: Str, e: Diagnostic): Bool :=
  file == other and d.code == e.code and renumbered(d.message) == renumbered(e.message)

// text with the unknowns ?N numbered in the order of their first occurrences, ?1, ?2
function renumbered(text: Str): Str :=
  example renumbered("the type ?18 of ?19, not ?18?") == "the type ?1 of ?2, not ?1?"
  str(renumbered_chars(chars(text), Map()))

function renumbered_chars(cs: List[Char], seen: Map[Str, Int]): List[Char] :=
  match cs
    case List('?'; rest) =>
      let digits := take_while(rest, is_digit) in
      if digits == List() then
        List('?'; renumbered_chars(rest, seen))
      else
        let n := value_or(get(str(digits), seen), size(seen) + 1) in
        chars("?" ++ show(n)) ++ renumbered_chars(drop_while(rest, is_digit), Map(str(digits) => n; seen))

    case List(c; rest) =>
      List(c; renumbered_chars(rest, seen))

    case List() =>
      List()
  end

// the handle of the innermost node around the position of d in file, with a space after it, or nothing if no node of a
// definition holds it
procedure diagnostic_handle(
  in  file: Str,
      d: Diagnostic,
      files: Map[Str, Str],
  out label: Str,
  ref handles: Handles
) :=
  label := ""
  if d.pos.line > 0 then
    try
      var place: Place, number: Int
      node_at_position(in file, d.pos, files, out place)
      let index := value_or(index_of(place.span, line_nodes(place.lines, place.cmd)), -1)
      handle_for(in place.path, place.key, index, hash_of(node_text(place.lines, place.span)), out number, ref handles)
      label := "#" ++ show(number) ++ " "
    catch
      case Refused(_) =>
        label := ""
      case OsError(_) =>
        label := ""
    end
  end

function diagnostic_text(file: Str, d: Diagnostic): Str :=
  let at := if d.pos.line > 0 then
    ":" ++ show(d.pos.line) ++ "." ++ show(d.pos.col)
  else
    "" in
  file ++ at ++ ": " ++ d.code ++ ": " ++ d.message

// the lines of CLAUDE.md, README.md, and the files of ideas/ below root that write the name in backticks, as file:line
procedure doc_references(in root: Str, name: Str, out found: List[Str]) :=
  var entries: List[(Str, Bool)] := List()
  try
    os_list(in os_join(root, "ideas"), out entries)
  catch
    case OsError(_) =>
      entries := List()
  end
  found := List()
  let docs := List("CLAUDE.md", "README.md") ++ List(for (entry, is_dir) in entries if not is_dir and ends_with(entry, ".md") yield "ideas/" ++ entry)
  for doc in docs do
    var text: Str
    try
      os_read_utf8(in os_join(root, doc), out text)
    catch
      case OsError(_) =>
        text := ""
    end
    for (line, i) in numbered(split(text, '\n')) if size(occurrences(line, "`" ++ name ++ "`")) > 0 do
      found := found ++ List(doc ++ ":" ++ show(i + 1))
    end
  end

function counted(n: Int, noun: Str): Str :=
  example counted(1, "file") == "1 file"
  example counted(2, "file") == "2 files"
  show(n) ++ " " ++ noun ++ (if n == 1 then "" else "s")

// the handles to save after a script, which a dry run does not move, so that it saves only those that it adds
function saved_entries(before: Handles, after: Handles, dry: Bool): List[Handle] :=
  if dry then
    before.entries ++ List(for h in after.entries if h.number >= before.next yield h)
  else
    after.entries

// whether name occurs in text as a whole word
function has_word(text: Str, name: Str): Bool :=
  example has_word("ff(f)", "f")
  exists(occurrences(text, name), lambda i => is_word_at(text, i, size(name)))

// the outline of the file path, a line per declaration in the order of the file: its lines, its section, its kind, its
// name with its arity as a target names it, whether other modules see it, the handle of its first node if it has one,
// and the constructors of a datatype, so that an agent sees what a module offers without reading it
procedure outline(in path: Str, ref edits: Edits) raises Refused, OsError :=
  var text: Str, source: Source
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source), lines := Array(for line in split(text, '\n'))
  let has_sections := keyword_line(lines, "export") != None or keyword_line(lines, "implementation") != None or keyword_line(lines, "builtin") != None
  let visible := List(for (key, _, _) in keyed(d.exported ++ d.builtins) yield key)
  let sections := List(
    ("export", d.exported),
    ("builtin", d.builtins),
    ("implementation", d.implemented))
  var handles := edits.handles, rows: List[(Str, Str, Str, Str, Str, Str)] := List(), number: Int
  for (section, cmd) in List(for (section, cmds) in sections for cmd in cmds yield (section, cmd)) do
    let range := cmd_range(lines, cmd, 0, false)
    let at := show(range.first) ++ (if range.last > range.first then "-" ++ show(range.last) else "")
    let place := if has_sections then section else "none"
    match cmd_of(cmd)
      case None =>
        rows := rows ++ List((at, place, "unparsed", trim(line_at(lines, range.first)), "", ""))

      case Some(c) =>
        match key_of(c)
          case None =>
            rows := rows ++ List(
              (at, place, decl_kind(c), trim(line_at(lines, range.first)), "", ""))

          case Some(key) =>
            let seen := if section != "implementation" or contains(key, visible) then
              "exported"
            else
              "private"
            var handle := ""
            for (own, merged) in decl_of(d, key) if own.span == cmd.span do
              // the handle of a declaration is its first node that is no line of its spec and no head, the body of a function
              for (node, i) in find(numbered(kinded_nodes(lines, merged)), lambda (node, _) => node.kind != KSpec and node.kind != KHead and is_within(node.span.start, own.span)) do
                let span := node.span
                handle_for(in path, key, i, hash_of(node_text(lines, span)), out number, ref handles)
                handle := "#" ++ show(number)
              end
            end
            let name := if key.kind == "value" or key.kind == "type" then
              key_text(key)
            else
              key.base
            rows := rows ++ List(
              (at, place, decl_kind(c), name, seen, join(" ", List(for part in List(handle, constrs_text(c)) if part != "" yield part))))
        end
    end
  end
  edits := edits with handles := handles
  let widths := List(
    foldl(rows, 0, lambda w, (a, _, _, _, _, _) => max(w, size(a))),
    foldl(rows, 0, lambda w, (_, s, _, _, _, _) => max(w, size(s))),
    foldl(rows, 0, lambda w, (_, _, k, _, _, _) => max(w, size(k))),
    foldl(rows, 0, lambda w, (_, _, _, n, _, _) => max(w, size(n))))
  let row_text := lambda (a, s, k, n, e, h) => trim_end(join(" ", List(
    padded(a, value_or(get_at(0, widths), 0)),
    padded(s, value_or(get_at(1, widths), 0)),
    padded(k, value_or(get_at(2, widths), 0)),
    padded(n, value_or(get_at(3, widths), 0)),
    padded(e, 8),
    h)))
  note(in join("\n", List("@outline " ++ path) ++ List(for row in rows yield row_text(row))), ref edits)

function padded(text: Str, width: Int): Str :=
  example padded("ab", 4) == "ab  "
  text ++ repeat(width - size(text), " ")

function trim_end(text: Str): Str :=
  example trim_end("ab  ") == "ab"
  str(reverse(drop_spaces(reverse(chars(text)))))

// the kind of a declaration as an outline names it, where a signature has the kind of its definition
function decl_kind(c: Cmd): Str :=
  match c
    case CSort(_, _, _) =>
      "type"

    case CData(_, _, _) =>
      "data"

    case CAbstract(_, _) =>
      "type"

    case CFun(_, _, _, _, _, _) =>
      "function"

    case CFunSig(_, _, _, _, _) =>
      "function"

    case CProc(_, _, _, _, _, _, _, _) =>
      "procedure"

    case CProcSig(_, _, _, _, _, _, _) =>
      "procedure"

    case CPatAlias(_, _, _, _, _) =>
      "pattern"

    case CTest(_, _, _) =>
      "test"

    case CLemma(_, _, _, _, _, _) =>
      "lemma"

    case CNotation(_, _, _) =>
      "notation"
  end

// the constructors of a datatype with their arities, as targets name them, else ""
function constrs_text(c: Cmd): Str :=
  match constrs_of(c)
    case List() =>
      ""
    case constrs =>
      "cases " ++ join(", ", List(for constr in constrs yield constr_name(constr) ++ "/" ++ show(constr_arity(constr))))
  end

// the uses of the function, procedure, pattern alias, or constructor of the target file.u:name[/arity] in the files of
// user_files, found as rename finds them, by the names that the checker resolves, each with its position, the declaration around it, the handle of the innermost node there, and its line
procedure refs(in word: Str, ref edits: Edits) raises Refused, OsError :=
  var text: Str, source: Source, files: List[(Str, Str)]
  let (path, chosen, arity) := target_of(word)
  let base := value_or(chosen, "")
  current_text(in path, edits.files, out text)
  parsed(in path, text, edits.files, no_fragment(), out source)
  let d := main_mod(source)
  let arities := distinct(List(for (key, _, _) in keyed(placed_of(d)) if key.kind == "value" and is_selected(key, base, arity) yield key.arity) ++ List(for (_, _, c) in keyed(placed_of(d)) for constr in constrs_of(c) if constr_name(constr) == base and forall(arity, lambda k => k == constr_arity(constr)) yield constr_arity(constr)))
  match arities
    case List(_) =>
      skip

    case List() =>
      raise Refused(path ++ " declares no function, procedure, pattern alias, or constructor " ++ base ++ ", and the uses of types and fields are not found yet")

    case _ =>
      raise Refused(path ++ " declares " ++ base ++ " of several arities, so name one, " ++ base ++ "/n")
  end
  let n := value_or(get_at(0, arities), 0), target := Name(d.name, base)
  user_files(in path, d, List(base), edits.files, out files)
  var handles := edits.handles, found: List[Str] := List(), touched := 0
  for (file, file_text) in files do
    var hints_found: List[Hint]
    file_hints(in file, file_text, edits.files, out hints_found)
    let hits := List(for h in hints_found for (span, name, k) in use_of(h) if name == target and k == n yield span)
    if hits != List() then
      var file_source: Source
      try
        parse_file_overlaid(in file, Map(file => file_text; edits.files), true, out file_source)
      catch
        case e =>
          raise Refused(file ++ ": " ++ parse_diagnostic(e).message)
      end
      let m := main_mod(file_source), file_lines := Array(for line in split(file_text, '\n'))
      for span in hits do
        var around := "", handle := "", number: Int
        for (key, cmd, _) in keyed(placed_of(m)) if cmd.span.start.line <= span.start.line and span.start.line <= cmd_range(file_lines, cmd, 0, false).last do
          around := " in " ++ key_text(key)
          for (_, merged) in decl_of(m, key) do
            let nodes := List(for (node, i) in numbered(line_nodes(file_lines, merged)) if node.start <= span.start and span.stop <= node.stop yield (node, i))
            for (node, i) in last(nodes) do
              handle_for(in file, key, i, hash_of(node_text(file_lines, node)), out number, ref handles)
              handle := " #" ++ show(number)
            end
          end
        end
        found := found ++ List(
          "  " ++ file ++ ":" ++ show(span.start.line) ++ "." ++ show(span.start.col) ++ around ++ handle ++ ": " ++ trim(line_at(file_lines, span.start.line)))
      end
      touched := touched + 1
    end
  end
  edits := edits with handles := handles
  note(in join("\n", List(
    "@refs " ++ word ++ ": " ++ counted(size(found), "use") ++ " of " ++ format_name(target) ++ "/" ++ show(n) ++ " in " ++ counted(touched, "file")) ++ found), ref edits)

// the declarations of base of every arity that the main module of source sees, by their qualified names and types as
// written: its own, the exports of the other members of its package and of the packages it imports, and those of the
// library
function seen_decls(source: Source, base: Str): List[Str] :=
  let d := main_mod(source) in
  let seen := seen_modules(d, source.packages) in
  distinct(List(for m in source.mods if m.name == d.name or contains(m.name, seen) for cmd in if m.name == d.name then placed_of(m) else m.exported ++ m.builtins for c in cmd_of(cmd) for text in decl_texts(m.name, c, base) yield text))

// the declarations of base in c of the module m, a value or the constructors of a datatype, with their types
function decl_texts(m: Path, c: Cmd, base: Str): List[Str] :=
  let named := lambda typ: Type => List(format_name(Name(m, base)) ++ ": " ++ format_type(typ)) in
  let types := lambda xs: List[At[Var]] => List(for x in xs yield x.that.typ) in
  match c
    case CFun(name, _, formals, typ, _, _) if name.base == base =>
      named(TFun(types(formals), typ))

    case CFunSig(name, _, formals, typ, _) if name.base == base =>
      named(TFun(types(formals), typ))

    case CPatAlias(name, _, formals, typ, _) if name.base == base =>
      named(TFun(types(formals), typ))

    case CProc(name, _, ins, outs, refs, raised, _, _) if name.base == base =>
      named(TProc(types(ins), types(outs), types(refs), RWritten(raised)))

    case CProcSig(name, _, ins, outs, refs, raised, _) if name.base == base =>
      named(TProc(types(ins), types(outs), types(refs), RWritten(raised)))

    case CData(name, params, constrs) =>
      List(for constr in constrs if constr_name(constr) == base for typ in constr_type(constr, TSort(name, List(for p in params yield TParam(p)))) for text in named(typ) yield text)

    case _ =>
      List()
  end

function constr_type(constr: At[Constr], result: Type): Option[Type] :=
  match constr
    case AOk(_, _, Constr(_, fields)) =>
      Some(if fields == List() then
        result
      else
        TFun(List(for f in fields yield f.typ), result))

    case _ =>
      None
  end

// the exported signatures that word names: of a module, a file F.u or a path from the root such as ulang/check/check or
// prelude/str of the library, its export and builtin sections as the file has them; else of a name, every exported
// declaration of it in the modules of the project and the library, across overloads, so that an agent learns the types
// of a name without reading the modules
procedure sig(in word: Str, ref edits: Edits) raises Refused, OsError :=
  if is_module_word(word) then
    module_sig(in word, ref edits)
  else
    name_sig(in word, ref edits)
  end

// whether word of @sig names a module, a file or a path of names with a /, rather than a name, also of an operator
function is_module_word(word: Str): Bool :=
  example is_module_word("prelude/str")
  example is_module_word("a/b.u")
  example not is_module_word("lines")
  example not is_module_word("/")
  ends_with(word, ".u") or size(split(word, '/')) > 1 and forall(split(word, '/'), is_plain_name)

// the file of the module that word names, a file as written, a module of the library in the directory of the library,
// and any other from the root of the project
procedure module_file(in word: Str, out path: Str) raises OsError :=
  var here: Str
  os_cwd(out here)
  if ends_with(word, ".u") then
    path := word
  else
    if starts_with(word, "prelude/") then
      var lib: Str
      os_library_dir(out lib)
      path := normal_file(here, here, os_join(lib, slice(word, size("prelude/"), size(word)) ++ ".u"))
    else
      var root: Str
      project_root(in here, out root)
      path := normal_file(here, here, os_join(root, word ++ ".u"))
    end
  end

// the export and builtin sections of the module that word names, as its file writes them
procedure module_sig(in word: Str, ref edits: Edits) raises Refused, OsError :=
  var path: Str, text: Str
  module_file(in word, out path)
  try
    current_text(in path, edits.files, out text)
  catch
    case OsError(message) =>
      raise Refused("@sig " ++ word ++ ": no module there, " ++ message)
  end
  match exported_lines(Array(for line in split(text, '\n')))
    case List() =>
      note(in "@sig " ++ word ++ ": " ++ path ++ " exports nothing, since it has no export section", ref edits)
    case shown =>
      note(in join("\n", List("@sig " ++ word ++ ": " ++ path) ++ shown), ref edits)
  end

// the lines of the export and builtin sections of a formatted file, from the keyword of the first to the last line that
// is not blank before implementation
function exported_lines(lines: Array[Str]): List[Str] :=
  example exported_lines(Array("export", "", "type T", "", "implementation", "data T := case T")) == List("export", "", "type T")
  match List(for word_line in List(keyword_line(lines, "export"), keyword_line(lines, "builtin")) for i in word_line yield i)
    case List(start; _) =>
      let stop := value_or(keyword_line(lines, "implementation"), size(lines) + 1) in
      reverse(drop_blank(reverse(lines_in(lines, Range(start, stop - 1)))))

    case List() =>
      List()
  end

// the exported declarations of name in the modules of the project and the library, each with its qualified name and its
// text, a signature with its examples unless they take more than spec_lines lines, a datatype whole, and of a constructor
// the head of its datatype and its line; the files that name it are parsed, each with its package and its imports, unless
// an earlier parse loaded its module
procedure name_sig(in name: Str, ref edits: Edits) raises Refused, OsError :=
  var here: Str, root: Str, lib: Str, walked: List[Str], library: List[Str]
  os_cwd(out here)
  project_root(in here, out root)
  os_library_dir(out lib)
  source_files(in root, out walked)
  source_files(in lib, out library)
  var covered: Set[Path] := Set(), mods: List[(Mod, Str)] := List(), unparsed: List[Str] := List()
  for f in distinct(List(for w in walked ++ library yield normal_path(w))) do
    var text: Str
    let file := normal_file(here, here, f)
    current_text(in file, edits.files, out text)
    let lines := Array(for line in split(text, '\n'))
    let id := module_id_of(normal_path(lib), normal_path(root), f)
    if not contains(id, covered) and has_word(join("\n", List(for line in exported_lines(lines) if not is_comment_line(line))), name) then
      try
        var source: Source
        parsed(in file, text, edits.files, no_fragment(), out source)
        for m in source.mods if not contains(m.name, covered) do
          covered := covered ++ Set(m.name)
          let module_path := if is_library_module(m.name) then
            os_join(lib, library_file(m.name) ++ ".u")
          else
            os_join(root, join("/", m.name) ++ ".u")
          mods := mods ++ List((m, normal_file(here, here, module_path)))
        end
      catch
        case Refused(message) =>
          unparsed := unparsed ++ List(message)
      end
    end
  end
  var found: List[(Path, Int, List[Str])] := List()
  for (m, path) in mods do
    let cmds := List(for cmd in m.exported ++ m.builtins for c in cmd_of(cmd) if declares(c, name) yield (cmd, c))
    if cmds != List() then
      var text: Str
      current_text(in path, edits.files, out text)
      let lines := Array(for line in split(text, '\n'))
      for (cmd, c) in cmds do
        found := found ++ List((m.name, cmd.span.start.line, sig_lines(lines, cmd, c, name)))
      end
    end
  end
  if found == List() then
    raise Refused("@sig " ++ name ++ ": no module of the project or the library exports " ++ name)
  end
  let shown := List(for (m, _, text) in sort(found) yield sig_entry(format_name(Name(m, name)), text))
  let modules := size(distinct(List(for (m, _, _) in found yield m)))
  note(in join("\n", List(
    "@sig " ++ name ++ ": " ++ counted(size(found), "declaration") ++ " in " ++ counted(modules, "module")) ++ shown ++ List(for message in unparsed yield "  not parsed: " ++ message)), ref edits)

// the module of the file at path, as the parser names it, where lib and root are the directories of the library and of the
// project, all absolute and normal
function module_id_of(lib: Str, root: Str, path: Str): Path :=
  example module_id_of("/r/prelude", "/r", "/r/prelude/str.u") == List("prelude", "str")
  example module_id_of("/l", "/r", "/r/b/c.u") == List("b", "c")
  let base := slice(path, 0, size(path) - size(".u")) in
  if os_dirname(path) == lib then
    library_module(slice(base, size(lib) + 1, size(base)))
  else if starts_with(base, root ++ "/") then
    dir_path(slice(base, size(root) + 1, size(base)))
  else
    dir_path(base)

// whether c declares name, as a function, procedure, pattern alias, type, or constructor
function declares(c: Cmd, name: Str): Bool :=
  exists(key_of(c), lambda key => key.base == name) or exists(constrs_of(c), lambda constr => constr_name(constr) == name)

// the lines of the declaration cmd of name for @sig: a declaration of name whole, but for a spec of more than spec_lines
// lines, which it leaves out, and of a constructor of name the head of its datatype and the constructor
function sig_lines(lines: Array[Str], cmd: At[Cmd], c: Cmd, name: Str): List[Str] :=
  let all := lines_in(lines, cmd_range(lines, cmd, 0, false)) in
  if exists(key_of(c), lambda key => key.base == name) then
    let head := lines_in(lines, head_range(lines, cmd)) in
    if is_signature(c) and size(all) - size(head) > spec_lines() then
      head ++ List(
        "    (" ++ counted(size(all) - size(head), "line") ++ " of examples)")
    else
      all
  else
    List(line_at(lines, cmd.span.start.line)) ++ List(for constr in constrs_of(c) if constr_name(constr) == name for line in lines_in(lines, Range(constr.span.start.line, constr.span.stop.line)) yield line)

function spec_lines(): Int :=
  4

// an entry of @sig, the qualified name and the text of its declaration, on one line if it has one
function sig_entry(qualified: Str, text: List[Str]): Str :=
  example sig_entry("m.f", List("function f(): Int")) == "m.f: function f(): Int"
  example sig_entry("m.f", List("function f(): Int :=", "  example f() == 1")) == "m.f:\n  function f(): Int :=\n    example f() == 1"
  match text
    case List(line) =>
      qualified ++ ": " ++ line
    case _ =>
      join("\n", List(qualified ++ ":"; List(for line in text yield "  " ++ line)))
  end

// the qualified name and the type of the use at the position F:L.C, or the type of the variable declared there, from
// the hints of the checked file, the innermost one if several spans contain the position
procedure resolve(in word: Str, ref edits: Edits) raises Refused, OsError :=
  match position_of(word)
    case Some((path, pos)) =>
      var text: Str, found: List[Hint]
      current_text(in path, edits.files, out text)
      file_hints(in path, text, edits.files, out found)
      let hits := List(for h in found for (span, what) in resolution_of(h) if compare(span.start, pos) <= 0 and compare(pos, span.stop) < 0 yield (span.start, Pos(0 - span.stop.line, 0 - span.stop.col), what))
      match last(sort(hits))
        case Some((_, _, what)) =>
          note(in "@resolve " ++ word ++ ": " ++ what, ref edits)
        case None =>
          note(in "@resolve " ++ word ++ ": no use or declaration of a name there", ref edits)
      end

    case None =>
      raise Refused("@resolve takes a position F:L.C or F L.C, not " ++ word)
  end

// the span of a hint and what @resolve says of it, a use by its qualified name and a declared variable by its name, each
// with its type where the checked program has one
function resolution_of(h: Hint): Option[(Span, Str)] :=
  let typed := lambda typ: Type => if typ == THole then "" else ": " ++ format_type(typ) in
  match h
    case HUse(span, name, typ) =>
      Some((span, "use of " ++ format_name(name) ++ typed(typ)))

    case HDecl(span, name, typ, _) =>
      Some((span, "declaration of " ++ format_name(name) ++ typed(typ)))

    case HRaises(_, _, _) =>
      None
  end
