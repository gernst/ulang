// the nodes of a declaration that handles name: the parts that start their lines in formatted text, statements, cases,
// constructors, elements spread one per line, the body of a function, and the heads of a definition and its signatures,
// by their spans

import ulang.syntax

export

// the spans of the parts of decl that start their lines in lines, the text of its file, outer before inner, without
// repeated starts, so that each line has at most one node, and without the parts that the source does not write, such as
// an else without its keyword, whose spans are empty
function line_nodes(lines: Array[Str], decl: Decl): List[Span]

// what a node is, by which an edit checks that a fragment fits the place of a node, where a line of a spec is an example
// or a contract, requires or ensures, and a head is that of the definition of a function or procedure, which its
// signature repeats
data NodeKind :=
  case KStatement
  case KCase
  case KExpression
  case KConstructor
  case KSpec
  case KHead

data Node :=
  case Node(span: Span, kind: NodeKind)

// the nodes of line_nodes with their kinds, where the cases of a match and the handlers of a try are cases, and the head
// of the definition of a function or procedure and of each of its signatures is a node of its own
function kinded_nodes(lines: Array[Str], decl: Decl): List[Node]

// the kind with its article, as messages name it
function kind_text(kind: NodeKind): Str :=
  example kind_text(KCase) == "a case"

// a declaration as its nodes see it: its definition, with the specs of its signatures in its spec, and the spans of its
// signatures in export, whose heads are nodes of it, as the head of the definition is
data Decl :=
  case Decl(cmd: Cmd, signatures: List[Span])

implementation

function line_nodes(lines: Array[Str], decl: Decl): List[Span] :=
  List(for node in kinded_nodes(lines, decl) yield node.span)

// the nodes of cmd in the order of their starts, where those of the same start keep their order, the outer first, and a
// line of a spec starts at its keyword
function kinded_nodes(lines: Array[Str], decl: Decl): List[Node] :=
  let placed := List(for node in head_nodes(lines, decl.cmd)
    ++ signature_heads(lines, decl.signatures)
    ++ cmd_nodes(decl.cmd) yield at_keyword(lines, node)) in
  let sorted := List(for (_, _, node) in sort(List(for (node, i) in numbered(placed) yield (node.span.start, i, node))) yield node) in
  first_starts(List(for node in sorted if node.span.start != node.span.stop and starts_line(lines, node.span.start) yield node), Set())

// the head of the definition of a function or procedure, from its keyword to its :=, without the :=, which a fragment at
// the node keeps, as the comma after an element, where only the lines of its spec and comments stand between the head
// and the body, which format starts on the line after the :=
function head_nodes(lines: Array[Str], cmd: Cmd): List[Node] :=
  match cmd
    case CFun(_, _, _, _, spec, body) =>
      head_above(lines, spec_spans(spec), body.span.start.line - 1)

    case CProc(_, _, _, _, _, _, spec, stmt) =>
      head_above(lines, spec_spans(spec), stmt.span.start.line - 1)

    case _ =>
      List()
  end

// the head of each signature at the spans of signatures, from its keyword to the line that ends in :=, without the :=,
// which only a signature with a spec has, else to its end
function signature_heads(lines: Array[Str], signatures: List[Span]): List[Node] :=
  example signature_heads(Array(
        "function f(x: Int): Int :=",
        "  example f(1) == 1",
        "function g(",
        "  x: Int",
        "): Int"), List(Span(Pos(1, 1), Pos(2, 20)), Span(Pos(3, 1), Pos(5, 7))))
      == List(
        Node(Span(Pos(1, 1), Pos(1, 24)), KHead),
        Node(Span(Pos(3, 1), Pos(5, 7)), KHead))
  List(for span in signatures for line in head_end(lines, span.start.line, span.stop.line) yield Node(Span(span.start, head_stop(lines, line, span)), KHead))

// the last line of a head that starts at line and ends at stop at the latest, the first that ends in :=, else stop
function head_end(lines: Array[Str], line: Int, stop: Int): Option[Int] :=
  if line < 1 or line > size(lines) or line > stop then
    None
  else if line == stop or ends_with(at(line - 1, lines), " :=") then
    Some(line)
  else
    head_end(lines, line + 1, stop)

// the end of a head whose last line is line, before its := if it has one, else at the end of span
function head_stop(lines: Array[Str], line: Int, span: Span): Pos :=
  let text := at(line - 1, lines) in
  if ends_with(text, " :=") then Pos(line, size(text) - 2) else span.stop

function spec_spans(spec: Spec): List[Span] :=
  List(for expr in spec.pre yield expr.span)
    ++ List(for expr in spec.post yield expr.span)
    ++ List(for x in spec.examples yield x.span)

// the head whose last line is the first at or above line that is neither blank nor a comment nor a line of parts, the
// lines of the spec, if it ends in :=, and whose first line, above it without a blank line between, starts with the
// keyword of a function or procedure
function head_above(lines: Array[Str], parts: List[Span], line: Int): List[Node] :=
  example head_above(Array("function f(x: Int): Int :=", "  example f(1) == 1", "  x"), List(Span(Pos(2, 11), Pos(2, 20))), 2)
      == List(Node(Span(Pos(1, 1), Pos(1, 24)), KHead))
  example head_above(Array("procedure p(", "  in  x: Int,", "  out y: Int", ") :=", "  y := x"), List(), 4)
      == List(Node(Span(Pos(1, 1), Pos(4, 2)), KHead))
  example head_above(Array("function f(): Int := 1"), List(), 0) == List()
  if line < 1 or line > size(lines) then
    List()
  else
    let text := at(line - 1, lines) in
    if trim(text) == ""
      or starts_with(trim(text), "//")
      or exists(parts, lambda part => part.start.line <= line and line <= part.stop.line) then
      head_above(lines, parts, line - 1)
    else if ends_with(text, " :=") then
      match head_start(lines, line)
        case Some(start) =>
          List(
            Node(Span(line_start(lines, Pos(start, 1)), Pos(line, size(text) - 2)), KHead))

        case None =>
          List()
      end
    else
      List()

// the line at or above line that starts with the keyword of a function or procedure, with no blank line between
function head_start(lines: Array[Str], line: Int): Option[Int] :=
  if line < 1 or line > size(lines) then
    None
  else
    let text := trim(at(line - 1, lines)) in
    if starts_with(text, "function ") or starts_with(text, "procedure ") then
      Some(line)
    else if text == "" then
      None
    else
      head_start(lines, line - 1)

function kind_text(kind: NodeKind): Str :=
  match kind
    case KStatement =>
      "a statement"

    case KCase =>
      "a case"

    case KExpression =>
      "an expression"

    case KConstructor =>
      "a constructor"

    case KSpec =>
      "a line of a spec"

    case KHead =>
      "a head"
  end

function first_starts(nodes: List[Node], seen: Set[Pos]): List[Node] :=
  match nodes
    case List(node; rest) =>
      if contains(node.span.start, seen) then
        first_starts(rest, seen)
      else
        List(node; first_starts(rest, Set(node.span.start; seen)))

    case List() =>
      List()
  end

// whether only spaces stand before pos on its line
function starts_line(lines: Array[Str], pos: Pos): Bool :=
  pos.line >= 1
    and pos.line <= size(lines)
    and forall(chars(slice(at(pos.line - 1, lines), 0, pos.col - 1)), lambda c => c == ' ')

// the node, where a line of a spec starts at the first position of its line that is no space, its keyword
function at_keyword(lines: Array[Str], node: Node): Node :=
  match node.kind
    case KSpec =>
      node with span := Span(line_start(lines, node.span.start), node.span.stop)
    case _ =>
      node
  end

// the first position of the line of pos that is no space
function line_start(lines: Array[Str], pos: Pos): Pos :=
  example line_start(Array("  requires x > 0"), Pos(1, 12)) == Pos(1, 3)
  if pos.line >= 1 and pos.line <= size(lines) then
    let line := at(pos.line - 1, lines) in
    Pos(pos.line, size(line) - size(drop_while(chars(line), lambda c => c == ' ')) + 1)
  else
    pos

function cmd_nodes(cmd: Cmd): List[Node] :=
  match cmd
    case CFun(_, _, _, _, spec, body) =>
      spec_nodes(spec) ++ expr_nodes(body)

    case CProc(_, _, _, _, _, _, spec, stmt) =>
      spec_nodes(spec) ++ stmt_nodes(stmt)

    case CTest(_, _, stmt) =>
      stmt_nodes(stmt)

    case CData(_, _, constrs) =>
      List(for constr in constrs yield Node(constr.span, KConstructor))

    case CSort(_, _, _) =>
      List()

    case CNotation(_, _, _) =>
      List()

    case CFunSig(_, _, _, _, spec) =>
      spec_nodes(spec)

    case CProcSig(_, _, _, _, _, _, spec) =>
      spec_nodes(spec)

    case CAbstract(_, _) =>
      List()

    case CPatAlias(_, _, _, _, _) =>
      List()

    case CLemma(_, _, _, _, _, _) =>
      List()
  end

// the lines of a spec, its requires, whose node spans its assumptions, its ensures, and each example, with the nodes of
// their expressions, where kinded_nodes moves the start of each line to its keyword
function spec_nodes(spec: Spec): List[Node] :=
  let pre := match (spec.pre, last(spec.pre))
    case (List(first; _), Some(final)) =>
      List(
        Node(Span(first.span.start, final.span.stop), KSpec); flat_map(spec.pre, expr_nodes))

    case _ =>
      List()
  end in
  let post := List(for expr in spec.post for node in List(Node(expr.span, KSpec); expr_nodes(expr)) yield node) in
  pre ++ post ++ flat_map(spec.examples, example_nodes)

function example_nodes(x: At[Example]): List[Node] :=
  match x
    case AOk(_, span, that) =>
      List(Node(span, KSpec); example_parts(that))

    case AErr(_, span, that, _) =>
      List(Node(span, KSpec); example_parts(that))

    case AUnparsed(_, span, _, _) =>
      List(Node(span, KSpec))
  end

function example_parts(x: Example): List[Node] :=
  match x
    case XHolds(expr) =>
      expr_nodes(expr)

    case XRaises(expr, _) =>
      expr_nodes(expr)

    case XCall(_, ins, outs, refs) =>
      flat_map(ins ++ outs, expr_nodes)
        ++ flat_map(refs, lambda (before, after) => expr_nodes(before) ++ expr_nodes(after))

    case XCallRaises(_, ins, _, befores, _) =>
      flat_map(ins ++ befores, expr_nodes)
  end

function stmt_nodes(stmt: At[Stmt]): List[Node] :=
  match stmt
    case AOk(_, span, that) =>
      stmt_parts(span, that)

    case AErr(_, span, that, _) =>
      stmt_parts(span, that)

    case AUnparsed(_, span, _, _) =>
      List(Node(span, KStatement))
  end

// a block is no node, since its first statement starts where it does
function stmt_parts(span: Span, stmt: Stmt): List[Node] :=
  match stmt
    case SBlock(_, stmts) =>
      flat_map(stmts, stmt_nodes)
    case _ =>
      List(Node(span, KStatement); inner_stmt_nodes(stmt))
  end

function inner_stmt_nodes(stmt: Stmt): List[Node] :=
  match stmt
    case SSkip =>
      List()

    case SAssign(upd) =>
      flat_map(upd, lambda (_, expr) => expr_nodes(expr))

    case SBlock(_, stmts) =>
      flat_map(stmts, stmt_nodes)

    case SLocal(_, decls) =>
      List(for (_, value) in decls for expr in value for node in expr_nodes(expr) yield node)

    case SIf(cond, left, right) =>
      expr_nodes(cond) ++ stmt_nodes(left) ++ stmt_nodes(right)

    case SWhile(cond, body) =>
      expr_nodes(cond) ++ stmt_nodes(body)

    case SCall(_, ins, _, _) =>
      flat_map(ins, expr_nodes)

    case SMatch(arg, cases) =>
      expr_nodes(arg)
        ++ flat_map(cases, lambda branch => List(Node(branch.span, KCase); branch_nodes(branch, stmt_nodes)))

    case SAssert(cond) =>
      expr_nodes(cond)

    case SAssertRaises(_, _, _, body) =>
      stmt_nodes(body)

    case SRaise(value, _) =>
      expr_nodes(value)

    case STry(body, catches) =>
      stmt_nodes(body)
        ++ flat_map(catches, lambda handler => List(Node(handler.span, KCase); catch_nodes(handler)))

    case SFor(gens, body) =>
      flat_map(gens, gen_nodes) ++ stmt_nodes(body)
  end

function branch_nodes[A](branch: At[Branch[A]], nodes: A -> List[Node]): List[Node] :=
  match branch
    case AOk(_, _, that) =>
      nodes(that.body)

    case AErr(_, _, that, _) =>
      nodes(that.body)

    case AUnparsed(_, _, _, _) =>
      List()
  end

function catch_nodes(handler: At[Catch]): List[Node] :=
  match handler
    case AOk(_, _, that) =>
      stmt_nodes(that.body)

    case AErr(_, _, that, _) =>
      stmt_nodes(that.body)

    case AUnparsed(_, _, _, _) =>
      List()
  end

function gen_nodes(gen: Gen): List[Node] :=
  match gen
    case GVal(_, over, _) =>
      expr_nodes(over)

    case GPair(_, _, over, _) =>
      expr_nodes(over)

    case GIf(cond) =>
      expr_nodes(cond)

    case GLet(_, bound) =>
      expr_nodes(bound)
  end

function expr_nodes(expr: At[Expr]): List[Node] :=
  match expr
    case AOk(_, span, that) =>
      List(Node(span, KExpression); inner_expr_nodes(that))

    case AErr(_, span, that, _) =>
      List(Node(span, KExpression); inner_expr_nodes(that))

    case AUnparsed(_, span, _, _) =>
      List(Node(span, KExpression))
  end

function inner_expr_nodes(expr: Expr): List[Node] :=
  match expr
    case ELit(_) =>
      List()

    case EVar(_) =>
      List()

    case EApp(fun, args) =>
      expr_nodes(fun) ++ flat_map(args, expr_nodes)

    case EField(base, _) =>
      expr_nodes(base)

    case EUpdate(base, _, value) =>
      expr_nodes(base) ++ expr_nodes(value)

    case ELam(_, body) =>
      expr_nodes(body)

    case EProc(_, _, _, _, stmt) =>
      stmt_nodes(stmt)

    case ELet(bindings, body) =>
      flat_map(bindings, lambda (_, value) => expr_nodes(value))
        ++ expr_nodes(body)

    case EIte(cond, then_expr, else_expr) =>
      expr_nodes(cond) ++ expr_nodes(then_expr) ++ expr_nodes(else_expr)

    case EMatch(arg, cases) =>
      expr_nodes(arg)
        ++ flat_map(cases, lambda branch => List(Node(branch.span, KCase); branch_nodes(branch, expr_nodes)))

    case ETuple(args) =>
      flat_map(args, expr_nodes)

    case EAnnotated(inner, _) =>
      expr_nodes(inner)

    case EForm(_, elems, rest) =>
      flat_map(elems, yield_nodes) ++ rest_nodes(rest)

    case EFor(_, gens, elem, rest) =>
      flat_map(gens, gen_nodes) ++ yield_nodes(elem) ++ rest_nodes(rest)
  end

function yield_nodes(elem: Yield): List[Node] :=
  match elem
    case YVal(value) =>
      expr_nodes(value)
    case YPair(key, value) =>
      expr_nodes(key) ++ expr_nodes(value)
  end

function rest_nodes(rest: Option[At[Expr]]): List[Node] :=
  match rest
    case Some(expr) =>
      expr_nodes(expr)
    case None =>
      List()
  end
