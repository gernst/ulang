// the handles of ulang/refactor/refactor.u on files below out/test/refactor/ of the root, which run only compiled, since
// each parse loads the library, too slowly for the interpreter

import "ulang/syntax"
import "ulang/refactor"

procedure no_diagnostics(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  found := List()

// a check that finds a Mismatch at each assignment of 7
procedure flagged(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  var text := ""
  try
    os_read_utf8(in file, out text)
  catch
    case OsError(_) =>
      text := ""
  end
  found := List(for (line, i) in numbered(split(text, '\n')) for col in index_of("y := 7", line) yield (file, Diagnostic(TypeKind, "Mismatch", None, Pos(i + 1, col + 6), "expected Str but found Int", List())))

// a file of a procedure whose cases repeat statements and a datatype, in a directory of its own with a fresh table of
// handles, its path, and the reply of @show of both declarations
procedure sample(in dir: Str, out path: Str, reply: List[Str]) :=
  path := os_join(dir, "p.u")
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "procedure p(in x: Int, out y: Int) :=\n  match x\n    case 0 =>\n      y := 1\n      y := y + 1\n    case _ =>\n      y := 2\n  end\n\ndata T :=\n  case A\n  case B\n")
  run_script(in "@show " ++ path ++ ":p\n@show " ++ path ++ ":T", false, dir, no_diagnostics, out reply, _, _)

// a case inserted before another whose statements it repeats takes new handles, the old statements keep theirs, in the
// same script and the next, and the reply lists each node that an edit placed, under its declaration
test identical_statements() :=
  var path: Str, reply: List[Str], status: Int, text: Str
  let dir := "out/test/refactor/identical"
  sample(in dir, out path, reply)
  assert reply == List(
    "applied",
    "@show " ++ path ++ ":p\n      procedure p(in x: Int, out y: Int) :=\n#1      match x\n#2        case 0 =>\n#3          y := 1\n#4          y := y + 1\n#5        case _ =>\n#6          y := 2\n        end",
    "@show " ++ path ++ ":T\n      data T :=\n#7      case A\n#8      case B")
  run_script(in "@put before #2\ncase 1 =>\n  y := 1\n  y := y + 1\n@put #3\ny := 5\n", false, dir, no_diagnostics, out reply, status, _)
  assert status == 0
  assert take(5, reply) == List(
    "applied, clean",
    "put before " ++ path ++ ":p/2 #2",
    "#9        case 1 =>\n#10         y := 1\n#11         y := y + 1",
    "replaced " ++ path ++ ":p/2 #3",
    "#3          y := 5")
  run_script(in "@put #4\ny := y + 2\n@put #6\ny := 2\ny := 3\n", false, dir, no_diagnostics, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "procedure p(in x: Int, out y: Int) :=\n  match x\n    case 1 =>\n      y := 1\n      y := y + 1\n\n    case 0 =>\n      y := 5\n      y := y + 2\n\n    case _ =>\n      y := 2\n      y := 3\n  end\n\ndata T :=\n  case A\n  case B\n"
  assert take(5, reply) == List(
    "applied, clean",
    "replaced " ++ path ++ ":p/2 #4",
    "#4          y := y + 2",
    "replaced " ++ path ++ ":p/2 #6",
    "#6          y := 2\n#12         y := 3")

// a handle after a declaration that does not hold it, a fragment of another kind than the node or than the parts of a
// node that it goes into, and declarations after a constructor are refused
test scoped_handles() :=
  var path: Str, reply: List[Str], status: Int
  let dir := "out/test/refactor/scoped"
  sample(in dir, out path, _)
  run_script(in "@put " ++ path ++ ":T #6\ny := 3\n", false, dir, no_diagnostics, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "#6 is a node of " ++ path ++ ":p/2, not of " ++ path ++ ":T, so @show " ++ path ++ ":T for its handles")
  run_script(in "@put #4\ncase 2 =>\n  y := 3\n", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List(
    "rejected",
    "@put #4 places a case where " ++ path ++ ":p/2 #4 takes a statement")
  run_script(in "@put into #1\ny := 3\n", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List(
    "rejected",
    "@put into #1 places a statement where " ++ path ++ ":p/2 #1 takes a case")
  run_script(in "@put after #8\ncase C\nfunction g(): Int := 1\n", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List(
    "rejected",
    "@put after #8 writes declarations beyond its node, which @put F writes")
  run_script(in "@put after " ++ path ++ ":T #8\ncase C\n@put " ++ path ++ ":p/2 #6\ny := 3\n", false, dir, no_diagnostics, out reply, status, _)
  assert status == 0
  assert take(5, reply) == List(
    "applied, clean",
    "put after " ++ path ++ ":T #8",
    "#9      case C",
    "replaced " ++ path ++ ":p/2 #6",
    "#6          y := 3")

// a node addressed by the text that starts it, which must start exactly one node of the declaration
test nodes_by_text() :=
  var path: Str, reply: List[Str], status: Int, text: Str
  let dir := "out/test/refactor/texts"
  sample(in dir, out path, _)
  run_script(in "@put before " ++ path ++ ":p \"case _\"\ncase 1 =>\n  y := 1\n", false, dir, no_diagnostics, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "procedure p(in x: Int, out y: Int) :=\n  match x\n    case 0 =>\n      y := 1\n      y := y + 1\n\n    case 1 =>\n      y := 1\n\n    case _ =>\n      y := 2\n  end\n\ndata T :=\n  case A\n  case B\n"
  assert take(3, reply) == List(
    "applied, clean",
    "put before " ++ path ++ ":p/2 \"case _\"",
    "#9        case 1 =>\n#10         y := 1")
  run_script(in "@put " ++ path ++ ":p \"y := 1\"\ny := 0\n", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List(
    "rejected",
    "2 nodes of " ++ path ++ ":p/2 start with \"y := 1\", at lines 4, 8, so give more of the text, or a handle")
  run_script(in "@drop " ++ path ++ ":p \"y := 3\"\n", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List("rejected", "no node of " ++ path ++ ":p/2 starts with \"y := 3\"")
  run_script(in "@drop " ++ path ++ ":p \"y := y\"\n", false, dir, no_diagnostics, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0 and take(2, reply) == List("applied, clean", "dropped " ++ path ++ ":p/2 \"y := y\"")
  assert index_of("y + 1", text) == None

// a position is a target, the innermost node around it, and each new diagnostic of a reply has the handle of the
// innermost node around its position
test positions() :=
  var path: Str, reply: List[Str], status: Int
  let dir := "out/test/refactor/positions"
  sample(in dir, out path, _)
  run_script(in "@show " ++ path ++ ":4.8", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List("applied", "@show " ++ path ++ ":p/2 at 4.8\n#3          y := 1")
  run_script(in "@show " ++ path ++ ":3.5", false, dir, no_diagnostics, out reply, status, _)
  assert reply == List(
    "applied",
    "@show " ++ path ++ ":p/2 at 3.5\n#2        case 0 =>\n#3          y := 1\n#4          y := y + 1")
  run_script(in "@show " ++ path ++ ":1.1", false, dir, no_diagnostics, out reply, status, _)
  assert status == 1
  assert reply == List(
    "applied, 1 query refused",
    "@show " ++ path ++ ":1.1: refused, no node of " ++ path ++ ":p/2 holds " ++ path ++ ":1.1, which @show " ++ path ++ ":p/2 shows")
  run_script(in "@put " ++ path ++ ":5.7\ny := 7\n", false, dir, flagged, out reply, status, _)
  assert status == 1
  assert take(3, reply) == List(
    "applied, 1 error",
    "replaced " ++ path ++ ":p/2 at 5.7",
    "#4          y := 7")
  assert drop(4, reply) == List(
    "checked 1 file: 1 new, 0 gone",
    "  + #4 " ++ path ++ ":5.12: Mismatch: expected Str but found Int")

// the text of a node may write the quotes of a string literal escaped, as in a literal, or raw, and a backslash that
// starts no escape stays
test quoted_texts() :=
  var reply: List[Str], status: Int
  let dir := "out/test/refactor/quoted", path := "out/test/refactor/quoted/q.u"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "function f(xs: List[Str]): Int :=\n  match xs\n    case List(\"a\\\\b\") =>\n      1\n    case List(\"fetch\") =>\n      2\n    case _ =>\n      3\n  end\n")
  let shown := "#1        case List(\"fetch\") =>\n#2          2"
  run_script(in "@show " ++ path ++ ":f \"case List(\\\"fetch\\\")\"", false, dir, no_diagnostics, out reply, status, _)
  assert status == 0 and reply == List(
    "applied",
    "@show " ++ path ++ ":f/1 \"case List(\\\"fetch\\\")\"\n" ++ shown)
  run_script(in "@show " ++ path ++ ":f \"case List(\"fetch\")\"", false, dir, no_diagnostics, out reply, status, _)
  assert status == 0 and drop(1, split(at(1, reply), '\n')) == split(shown, '\n')
  run_script(in "@show " ++ path ++ ":f \"case List(\"a\\\\b\")\"", false, dir, no_diagnostics, out reply, status, _)
  assert status == 0 and drop(1, split(at(1, reply), '\n')) == List("#3        case List(\"a\\\\b\") =>", "#4          1")

// each element of a form spread one per line is a node, an expression, whose lines a fragment replaces whole, with its
// comma, and next to which it inserts lines
test element_handles() :=
  var reply: List[Str], status: Int, text: Str
  let dir := "out/test/refactor/elements", path := "out/test/refactor/elements/e.u"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "function names(): List[Str] :=\n  List(\n    \"alpha-alpha-alpha-alpha\",\n    \"beta-beta-beta-beta-beta\",\n    \"gamma-gamma-gamma-gamma-gamma\",\n    \"delta\")\n")
  run_script(in "@show " ++ path ++ ":names", false, dir, no_diagnostics, out reply, status, _)
  assert status == 0 and contains("#3        \"beta-beta-beta-beta-beta\",", split(at(1, reply), '\n'))
  run_script(in "@put #3\n\"bravo\",\n@put before #3\n\"aleph\",\n", false, dir, no_diagnostics, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "function names(): List[Str] :=\n  List(\n    \"alpha-alpha-alpha-alpha\",\n    \"aleph\",\n    \"bravo\",\n    \"gamma-gamma-gamma-gamma-gamma\",\n    \"delta\")\n"
