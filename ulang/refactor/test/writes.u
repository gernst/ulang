// the writes of @put of new modules and exports, and the refusals of errors of the system, on files below
// out/test/refactor/writes/ of the root, which run only compiled, as the scripts of scripts.u do

import ulang.syntax
import ulang.refactor

procedure unseen(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  found := List()

// @put of a new module makes its directory, which the test removes before and after
test puts_into_new_directory() :=
  var reply: List[Str], status: Int, text: Str, found: Bool
  let dir := "out/test/refactor/writes/new"
  os_is_dir(in dir, out found)
  if found then
    os_remove_all(in dir)
  end
  let module := "function twice(n: Int): Int :=\n  2 * n\n"
  run_script(in "@put " ++ dir ++ "/deep/m.u\n" ++ module, false, "out/test/refactor/writes", unseen, out reply, status, _)
  assert status == 0
  os_read_utf8(in os_join(dir, "deep/m.u"), out text)
  assert text == module
  os_remove_all(in dir)

// an error of the system in an action that writes is refused with the action and its line in the script, while a query
// would only be noted
test names_failed_action() :=
  var reply: List[Str], status: Int
  run_script(in "@check\n@drop out/test/refactor/writes/missing.u:f\n", false, "out/test/refactor/writes", unseen, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "line 2, @drop out/test/refactor/writes/missing.u:f: cannot read out/test/refactor/writes/missing.u")

// @put of the signature of a private procedure into export writes the raises that the check inferred into the
// signature and the definition, and the raises that the signature writes into the definition
test exports_inferred_raises() :=
  var reply: List[Str], status: Int, text: Str
  let
    state := "out/test/refactor/writes",
    path := "out/test/refactor/writes/raises/a.u"
  let proc := "procedure p(in x: Int, out y: Int) :=\n  if x < 0 then\n    raise OsError(\"negative\")\n  end\n  y := x\n"
  os_write_utf8(in path, proc)
  run_script(in "@put " ++ path ++ "\nexport\n\nprocedure p(in x: Int, out y: Int)\n", false, state, unseen, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text
    == "export\n\nprocedure p(in x: Int, out y: Int) raises OsError\n\nimplementation\n\nprocedure p(in x: Int, out y: Int) raises OsError :=\n  if x < 0 then\n    raise OsError(\"negative\")\n  end\n  y := x\n"
  assert contains(path ++ ": exported p/2, with raises OsError of p/2", reply)
  os_write_utf8(in path, proc)
  run_script(in "@put "
    ++ path
    ++ "\nexport\n\nprocedure p(in x: Int, out y: Int) raises OsError, Str\n", false, state, unseen, out reply, status, _)
  os_read_utf8(in path, out text)
  assert index_of("procedure p(in x: Int, out y: Int) raises OsError, Str :=", text)
    != None

// @put of a fragment of an import names the import that it added, and one that the file has already is no edit
test names_added_import() :=
  var reply: List[Str], status: Int, text: Str
  let
    state := "out/test/refactor/writes",
    path := "out/test/refactor/writes/imports/a.u"
  os_write_utf8(in "out/test/refactor/writes/imports/b/b.u", "export\n\nfunction k(): Int\n\nimplementation\n\nfunction k(): Int :=\n  1\n")
  os_write_utf8(in path, "function f(): Int :=\n  1\n")
  run_script(in "@put " ++ path ++ "\nimport out.test.refactor.writes.imports.b\n", false, state, unseen, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0 and text
    == "import out.test.refactor.writes.imports.b\n\nfunction f(): Int :=\n  1\n"
  assert take(2, reply) == List(
    "applied, clean",
    path ++ ": added import out.test.refactor.writes.imports.b")
  run_script(in "@put " ++ path ++ "\nimport out.test.refactor.writes.imports.b\n", false, state, unseen, out reply, status, _)
  assert status == 0 and reply == List("applied")

// a keyword written as a name in a fragment, which the parse of the file takes as the start of a section, is refused at
// its line in the fragment alone, without the errors of the declarations of the file after it
test refuses_keyword_as_name() :=
  var reply: List[Str], status: Int
  let
    state := "out/test/refactor/writes",
    path := "out/test/refactor/writes/keyword.u"
  os_write_utf8(in path, "export\n\nfunction f(x: Int): Int\n\nimplementation\n\ndata Parts :=\n  case Parts(xs: List[Int])\n\nfunction f(x: Int): Int :=\n  x + 1\n\nfunction g(x: Int): Int :=\n  x\n")
  run_script(in "@put "
    ++ path
    ++ ":Parts\ndata Parts :=\n  case Parts(xs: List[Int], builtin: List[Int])\n", false, state, unseen, out reply, status, _)
  assert status == 1 and reply == List(
    "rejected",
    "fragment 2.29, script 3.29: keyword builtin is not a name; write a name such as builtins\ncorrected by the hints, which @retry applies:\n  fragment 2, script 3:   case Parts(xs: List[Int], builtins: List[Int])")
