// the scripts of ulang/refactor/refactor.u on files below out/test/refactor/ of the root, which run only compiled, since
// each parse loads the library, too slowly for the interpreter

import ulang.syntax
import ulang.refactor

// a put that replaces a definition and its signature, keeping its doc, and adds a function, then a drop, on a file below
// out/test/refactor/ of the root, with a check that finds nothing
test put_and_drop() :=
  var reply: List[Str], status: Int, text: Str
  let path := "out/test/refactor/sample.u"
  os_write_utf8(in path, "export\n\nfunction f(x: Int): Int\n\nimplementation\n\n// one more\nfunction f(x: Int): Int :=\n  x + 1\n")
  let script := "@put " ++ path ++ "\nfunction f(y: Int): Int := y + 2\nfunction g(): Int := f(1)\n@drop " ++ path ++ ":g\n"
  run_script(in script, false, "out/test/refactor/state", lambda in _, _, out found =>
    found := List()
  end, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "export\n\nfunction f(y: Int): Int\n\nimplementation\n\n// one more\nfunction f(y: Int): Int :=\n  y + 2\n"
  assert take(3, reply) == List(
    "applied, clean",
    path ++ ": replaced f/1, added g/0 to implementation, with the signature of f/1",
    path ++ ": dropped g/0")

// a fragment that does not parse refuses the script, at its line in the fragment, and writes nothing
test refused_fragment() :=
  var reply: List[Str], status: Int, text: Str
  let path := "out/test/refactor/refused.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_script(in "@put " ++ path ++ "\nfunction g(x: Int): Int :=\n  x +\n", false, "out/test/refactor/state", lambda in _, _, out found =>
    found := List()
  end, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 1 and text == "function f(x: Int): Int :=\n  x\n"
  assert reply == List(
    "rejected",
    "fragment 2.6, script 3.6: expression expected but end of input found")

// a fragment with a habit of another language is refused with its correction, which @retry applies, once
test retries_corrected_fragments() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/retry", path := "out/test/refactor/retry/r.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_script(in "@put " ++ path ++ "\nfunction g(x: Int): Int :=\n  return x + 1\n", false, state, nothing_found, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "fragment 2.10, script 3.10: declaration expected but x found\ncorrected by the hints, which @retry applies:\n  fragment 2, script 3:   x + 1")
  run_script(in "@retry", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0 and text == "function f(x: Int): Int :=\n  x\n\nfunction g(x: Int): Int :=\n  x + 1\n"
  run_script(in "@retry", false, state, nothing_found, out reply, status, _)
  assert status == 1 and take(1, reply) == List("rejected")

// handles of @show name the nodes of a declaration, which @put replaces and inserts before, and @patch edits, in one
// script, since each edit moves the handles of its declaration, and @undo restores the file
test handles() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/handles", path := "out/test/refactor/handles.u"
  let original := "function f(x: Int): Int :=\n  match x\n    case 0 =>\n      1\n    case _ =>\n      x\n  end\n"
  os_write_utf8(in os_join(state, "handles.txt"), "")
  os_write_utf8(in path, original)
  run_script(in "@show " ++ path ++ ":f", false, state, nothing_found, out reply, status, _)
  let shown := "#1    function f(x: Int): Int :=\n#2      match x\n#3        case 0 =>\n#4          1\n#5        case _ =>\n#6          x\n        end"
  assert reply == List("applied", "@show " ++ path ++ ":f\n" ++ shown)
  run_script(in "@put #4\n2\n@put before #5\n      case 1 =>\n        3\n@patch #6\n-x\n+x + 1\n", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "function f(x: Int): Int :=\n  match x\n    case 0 =>\n      2\n\n    case 1 =>\n      3\n\n    case _ =>\n      x + 1\n  end\n"
  run_script(in "@undo", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in path, out text)
  assert text == original

procedure nothing_found(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  found := List()

// @rename renames a function at its signature, definition, and examples and its uses in the members of its package, by
// resolution, so that a local of the old name keeps it, and refuses a new name that a local would capture
test renames() :=
  var reply: List[Str], status: Int, text: Str, other: Str
  let state := "out/test/refactor/renames", dir := "out/test/refactor/renames/p"
  os_write_utf8(in os_join(dir, "a.u"), "export\n\nfunction f(x: Int): Int :=\n  example f(1) == 2\n\nimplementation\n\nfunction f(x: Int): Int :=\n  x + 1\n")
  os_write_utf8(in os_join(dir, "b.u"), "function g(y: Int): Int :=\n  let f := 1 in\n  f + y\n\nfunction h(y: Int): Int :=\n  f(y)\n")
  run_script(in "@rename " ++ dir ++ "/a.u:f y", false, state, nothing_found, out reply, status, _)
  assert status == 1 and take(1, reply) == List("rejected")
  run_script(in "@rename " ++ dir ++ "/a.u:f next", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in os_join(dir, "a.u"), out text)
  os_read_utf8(in os_join(dir, "b.u"), out other)
  assert status == 0
  assert text == "export\n\nfunction next(x: Int): Int :=\n  example next(1) == 2\n\nimplementation\n\nfunction next(x: Int): Int :=\n  x + 1\n"
  assert other == "function g(y: Int): Int :=\n  let f := 1 in\n  f + y\n\nfunction h(y: Int): Int :=\n  next(y)\n"

// @fix applies the edit of each lint that has one, an expression rewritten, a declaration dropped, a variable written
// _, and a local moved into the branches that use it, where a second @fix takes what the first enables, a var made let
test fixes() :=
  var status: Int, text: Str
  let state := "out/test/refactor/fixes", path := "out/test/refactor/fixes/f.u"
  os_write_utf8(in path, "function is_pos(n: Int): Bool :=\n  if n > 0 and n < 10 then true else false\n\nfunction first(o: Option[Int]): Int :=\n  match o\n    case Some(x) =>\n      x\n    case None =>\n      0\n  end\n\nfunction unused_helper(n: Int): Int :=\n  n\n\nprocedure classify(in n: Int, out text: Str) :=\n  var label: Str, count := 1, spare: Int\n  let k := n + 1\n  if is_pos(n) then\n    label := \"pos\"\n    text := label ++ show(count) ++ show(first(Some(k)))\n  else\n    label := \"neg\"\n    text := label\n  end\n\nfunction pairs(xs: List[(Int, Int)]): List[Int] :=\n  List(for (a, b) in xs yield a)\n\nfunction count_a(s: Str): Int :=\n  size(List(for c in chars(s) if c == 'a'))\n\nprocedure main() :=\n  var t: Str\n  classify(in 3, out t)\n  os_println(in t)\n  os_println(in show(count_a(t)))\n")
  run_script(in "@fix " ++ path, false, state, nothing_found, out _, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "function is_pos(n: Int): Bool :=\n  n > 0 and n < 10\n\nfunction first(o: Option[Int]): Int :=\n  value_or(o, 0)\n\nprocedure classify(in n: Int, out text: Str) :=\n  var count := 1\n  let k := n + 1\n  if is_pos(n) then\n    var label: Str\n    label := \"pos\"\n    text := label ++ show(count) ++ show(first(Some(k)))\n  else\n    var label: Str\n    label := \"neg\"\n    text := label\n  end\n\nfunction count_a(s: Str): Int :=\n  size(List(for c in s if c == 'a'))\n\nprocedure main() :=\n  var t: Str\n  classify(in 3, out t)\n  os_println(in t)\n  os_println(in show(count_a(t)))\n"
  run_script(in "@fix " ++ path, false, state, nothing_found, out _, status, _)
  os_read_utf8(in path, out text)
  assert text == "function is_pos(n: Int): Bool :=\n  n > 0 and n < 10\n\nfunction first(o: Option[Int]): Int :=\n  value_or(o, 0)\n\nprocedure classify(in n: Int, out text: Str) :=\n  let count := 1\n  let k := n + 1\n  if is_pos(n) then\n    var label: Str\n    label := \"pos\"\n    text := label ++ show(count) ++ show(first(Some(k)))\n  else\n    var label: Str\n    label := \"neg\"\n    text := label\n  end\n\nfunction count_a(s: Str): Int :=\n  size(List(for c in s if c == 'a'))\n\nprocedure main() :=\n  var t: Str\n  classify(in 3, out t)\n  os_println(in t)\n  os_println(in show(count_a(t)))\n"

// @fix writes a replacement as format writes it at its place, at the indentation of its line and with the comments
// inside it, which a replacement printed alone would drop
test fixes_keep_comments() :=
  var status: Int, text: Str
  let state := "out/test/refactor/fixes", path := "out/test/refactor/fixes/c.u"
  let body := "procedure main() :=\n  var b := false\n  if true then\n    b := "
  os_write_utf8(in path, body ++ "if contains(\n      // the first\n      1,\n      List(2)) then\n      true\n    else\n      false\n  end\n  os_println(in show(b))\n")
  run_script(in "@fix " ++ path, false, state, nothing_found, out _, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == body ++ "contains(\n      // the first\n      1,\n      List(2))\n  end\n  os_println(in show(b))\n"

// a check that finds an error at each use of value_or in the text of the file, the overlay if any, as if the module
// declared another
procedure value_or_flagged(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  var text := ""
  match get(file, overlays)
    case Some(overlay) =>
      text := overlay

    case None =>
      try
        os_read_utf8(in file, out text)
      catch
        case OsError(_) =>
          text := ""
      end
  end
  found := List(for (line, i) in numbered(split(text, '\n')) for col in index_of("value_or(", line) yield (file, Diagnostic(TypeKind, "Mismatch", None, Pos(i + 1, col + 1), "expected Int but found Bool", List())))

// @fix refuses the edit after which the unit has an error that it did not have, naming it, and applies the others
test refuses_breaking_fixes() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/refused", path := "out/test/refactor/refused/f.u"
  os_write_utf8(in path, "function is_pos(n: Int): Bool :=\n  if n > 0 then true else false\n\nfunction first(o: Option[Int]): Int :=\n  match o\n    case Some(x) =>\n      x\n    case None =>\n      0\n  end\n\nprocedure main() :=\n  os_println(in show(is_pos(first(None))))\n")
  run_script(in "@fix " ++ path, false, state, value_or_flagged, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "function is_pos(n: Int): Bool :=\n  n > 0\n\nfunction first(o: Option[Int]): Int :=\n  match o\n    case Some(x) =>\n      x\n    case None =>\n      0\n  end\n\nprocedure main() :=\n  os_println(in show(is_pos(first(None))))\n"
  assert contains(path ++ ": fixed BoolIte at 2.3", reply)
  assert contains(path ++ ": refused OptionMatch at 5.3, which would cause " ++ path ++ ":5.3: Mismatch: expected Int but found Bool", reply)

// @patch of a declaration patches its signature and its definition together, so that an example on the signature and
// the body change in one script, an if without else gets no handle on its end, and @fix of nothing says so
test patches_signatures() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/signatures", path := "out/test/refactor/signatures/s.u"
  os_write_utf8(in os_join(state, "handles.txt"), "")
  os_write_utf8(in path, "export\n\nfunction f(x: Int): Int :=\n  example f(1) == 2\n\nimplementation\n\nfunction f(x: Int): Int :=\n  x + 1\n\nprocedure p(in x: Int, out y: Int) :=\n  y := x\n  if x > 0 then\n    y := 1\n  end\n\nprocedure main() :=\n  var y: Int\n  p(in 1, out y)\n  os_println(in show(y))\n")
  run_script(in "@patch " ++ path ++ ":f\n-f(1) == 2\n+f(1) == 3\n-x + 1\n+x + 2\n", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "export\n\nfunction f(x: Int): Int :=\n  example f(1) == 3\n\nimplementation\n\nfunction f(x: Int): Int :=\n  x + 2\n\nprocedure p(in x: Int, out y: Int) :=\n  y := x\n  if x > 0 then\n    y := 1\n  end\n\nprocedure main() :=\n  var y: Int\n  p(in 1, out y)\n  os_println(in show(y))\n"
  run_script(in "@show " ++ path ++ ":p", false, state, nothing_found, out reply, status, _)
  assert not exists(reply, lambda r => contains("end", List(for line in split(r, '\n') if starts_with(line, "#") yield str(drop_margin(chars(line))))))
  run_script(in "@fix " ++ path, false, state, nothing_found, out reply, status, _)
  assert contains(path ++ ": nothing to fix", reply)

function drop_margin(cs: List[Char]): List[Char] :=
  match cs
    case List(c; rest) if c == '#' or is_digit(c) or c == ' ' =>
      drop_margin(rest)
    case _ =>
      cs
  end

// @put writes a new module from its fragment, with its header and sections, adds an import to a program and an export
// to a file without sections, which then gets both, and refuses a comment that is no doc
test writes_modules() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/modules", dir := "out/test/refactor/modules/m"
  os_write_utf8(in os_join(dir, "tools.u"), "// tools\n\nfunction twice(n: Int): Int :=\n  2 * n\n")
  os_write_utf8(in "out/test/refactor/modules/prog.u", "procedure main() :=\n  skip\n")
  os_write_utf8(in os_join(dir, "wire.u"), "")
  let wire := "// the codes\n\nexport\n\nfunction code_of(line: Str): Option[Int]\n\nimplementation\n\nfunction code_of(line: Str): Option[Int] :=\n  number(slice(line, 0, 3))\n"
  run_script(in "@put " ++ dir ++ "/wire.u\n" ++ wire, false, state, nothing_found, out reply, status, _)
  os_read_utf8(in os_join(dir, "wire.u"), out text)
  assert status == 0 and text == wire
  run_script(in "@put " ++ dir ++ "/tools.u\nexport\nfunction thrice(n: Int): Int\nimplementation\nfunction thrice(n: Int): Int := 3 * n\n", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in os_join(dir, "tools.u"), out text)
  assert text == "// tools\n\nexport\n\nfunction thrice(n: Int): Int\n\nimplementation\n\nfunction twice(n: Int): Int :=\n  2 * n\n\nfunction thrice(n: Int): Int :=\n  3 * n\n"
  run_script(in "@put out/test/refactor/modules/prog.u\nimport out.test.refactor.modules.m\nprocedure go() :=\n  skip\n", false, state, nothing_found, out reply, status, _)
  os_read_utf8(in "out/test/refactor/modules/prog.u", out text)
  assert text == "import out.test.refactor.modules.m\n\nprocedure main() :=\n  skip\n\nprocedure go() :=\n  skip\n"
  run_script(in "@put " ++ dir ++ "/tools.u\n// a header\n\nfunction four(n: Int): Int := 4 * n\n", false, state, nothing_found, out reply, status, _)
  assert status == 1 and take(1, reply) == List("rejected")

// @export gives a definition a signature with its doc and examples and a procedure its inferred raises, @unexport takes
// them back, and refuses while another member of the package uses the name; two renames run in one script
test exports_and_renames() :=
  var status: Int, text: Str
  let state := "out/test/refactor/exports", dir := "out/test/refactor/exports/p"
  os_write_utf8(in os_join(dir, "b.u"), "function use_b(): Int :=\n  0\n")
  let source := "export\n\nfunction f(x: Int): Int\n\nimplementation\n\nfunction f(x: Int): Int :=\n  g(x) + 1\n\n// g of x\nfunction g(x: Int): Int :=\n  example g(1) == 2\n  2 * x\n\nprocedure p(in x: Int) :=\n  if x < 0 then\n    raise OsError(\"negative\")\n  end\n"
  os_write_utf8(in os_join(dir, "a.u"), source)
  run_script(in "@export " ++ dir ++ "/a.u:g\n@export " ++ dir ++ "/a.u:p\n", false, state, nothing_found, out _, status, _)
  os_read_utf8(in os_join(dir, "a.u"), out text)
  assert status == 0
  assert text == "export\n\nfunction f(x: Int): Int\n\n// g of x\nfunction g(x: Int): Int :=\n  example g(1) == 2\n\nprocedure p(in x: Int) raises OsError\n\nimplementation\n\nfunction f(x: Int): Int :=\n  g(x) + 1\n\nfunction g(x: Int): Int :=\n  2 * x\n\nprocedure p(in x: Int) raises OsError :=\n  if x < 0 then\n    raise OsError(\"negative\")\n  end\n"
  run_script(in "@unexport " ++ dir ++ "/a.u:g\n", false, state, nothing_found, out _, status, _)
  os_read_utf8(in os_join(dir, "a.u"), out text)
  assert status == 0
  assert text == "export\n\nfunction f(x: Int): Int\n\nprocedure p(in x: Int) raises OsError\n\nimplementation\n\nfunction f(x: Int): Int :=\n  g(x) + 1\n\n// g of x\nfunction g(x: Int): Int :=\n  example g(1) == 2\n  2 * x\n\nprocedure p(in x: Int) raises OsError :=\n  if x < 0 then\n    raise OsError(\"negative\")\n  end\n"
  os_write_utf8(in os_join(dir, "b.u"), "function use_b(): Int :=\n  f(1)\n")
  run_script(in "@unexport " ++ dir ++ "/a.u:f\n", false, state, nothing_found, out _, status, _)
  assert status == 1
  run_script(in "@rename " ++ dir ++ "/a.u:f h\n@rename " ++ dir ++ "/a.u:g k\n", false, state, nothing_found, out _, status, _)
  os_read_utf8(in os_join(dir, "b.u"), out text)
  assert status == 0 and text == "function use_b(): Int :=\n  h(1)\n"
  os_read_utf8(in os_join(dir, "a.u"), out text)
  assert index_of("k(x) + 1", text) != None and index_of("example k(1) == 2", text) != None

// a line of a script that starts with @ starts an action, so an action that takes a fragment and is followed by one is
// refused with the line that it took as an action, and a fragment line that starts with @@ is the line with one @,
// while a fragment of @patch needs no escape, since its lines start with - or +
test escapes_at_lines() :=
  var reply: List[Str], status: Int, text: Str
  let path := "out/test/refactor/at.u"
  os_write_utf8(in path, "function f(): Str :=\n  \"@a\"\n")
  run_script(in "@patch " ++ path ++ ":f\n@drop " ++ path ++ ":f\n", false, "out/test/refactor/state", lambda in _, _, out found =>
    found := List()
  end, out reply, status, _)
  assert status == 1 and reply == List(
    "rejected",
    "@patch " ++ path ++ ":f has no fragment, since line 2 of the script, @drop " ++ path ++ ":f, starts with @, which starts an action; write a fragment line that starts with @ as @@")
  run_script(in "@patch " ++ path ++ ":f\n@@a\n", false, "out/test/refactor/state", lambda in _, _, out found =>
    found := List()
  end, out reply, status, _)
  assert status == 1 and starts_with(join("\n", reply), "rejected\n" ++ "@patch: fragment line 1, \"@a\", starts with neither - nor +")
  run_script(in "@patch " ++ path ++ ":f\n-\"@a\"\n+\"@b\"\n", false, "out/test/refactor/state", lambda in _, _, out found =>
    found := List()
  end, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0 and text == "function f(): Str :=\n  \"@b\"\n"
