// @patch of nodes, the normal paths of handles and files, and the messages of @rename, on files below
// out/test/refactor/small/ of the root, which run only compiled, as the scripts of scripts.u do

import ulang.syntax
import ulang.refactor

procedure unchecked(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  found := List()

// a file of a procedure of an if in a directory of its own with a fresh table of handles, and its path
procedure branches(in dir: Str, out path: Str) :=
  path := os_join(dir, "p.u")
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "procedure p(in x: Int, out y: Int) :=\n  if x > 0 then\n    y := 1\n  else\n    y := 2\n  end\n")

// @patch takes a node by its text, by its position, and by a handle scoped by its declaration, as @show and @put do, and
// replies with the innermost nodes that it changed, with their handles
test patches_nodes() :=
  var path: Str, reply: List[Str], status: Int, text: Str
  let dir := "out/test/refactor/small/patch"
  branches(in dir, out path)
  run_script(in "@show " ++ path ++ ":p\n@patch " ++ path ++ ":p \"y := 1\"\n1 => 3\n@patch " ++ path ++ ":5.5\n2 => 4\n@patch " ++ path ++ ":p #2\nx > 0 => x > 1\n@patch " ++ path ++ ":p\n) := => ) raises Str :=\n", false, dir, unchecked, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "procedure p(in x: Int, out y: Int) raises Str :=\n  if x > 1 then\n    y := 3\n  else\n    y := 4\n  end\n"
  assert take(7, drop(2, reply)) == List(
    "patched " ++ path ++ ":p/2 \"y := 1\"",
    "#3        y := 3",
    "patched " ++ path ++ ":p/2 at 5.5",
    "#4        y := 4",
    "patched " ++ path ++ ":p/2 #2",
    "#2      if x > 1 then\n#3        y := 3\n        else\n#4        y := 4\n        end",
    "patched " ++ path ++ ":p/2")
  run_script(in "@patch " ++ path ++ ":p \"z\"\nz => w\n", false, dir, unchecked, out reply, status, _)
  assert status == 1
  assert reply == List("rejected", "no node of " ++ path ++ ":p/2 starts with \"z\"")

// the reply of a @patch of a comment shows the node below it, which the comment documents, not the loop around it
test patches_comments() :=
  var reply: List[Str], status: Int
  let dir := "out/test/refactor/small/comments", path := "out/test/refactor/small/comments/q.u"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "procedure q(out y: Int) :=\n  y := 0\n  while y < 3 do\n    // grows\n    y := y + 1\n  end\n")
  run_script(in "@patch " ++ path ++ ":q\ngrows => grows by one\n", false, dir, unchecked, out reply, status, _)
  assert status == 0 and take(2, drop(1, reply)) == List(
    "patched " ++ path ++ ":q/1",
    "          // grows by one\n#1        y := y + 1")

// the reply of a @patch of the line of a let … in shows that line alone, without the body after it, unless the body
// changed too, where it shows the let whole
test patches_lets() :=
  var reply: List[Str], status: Int
  let dir := "out/test/refactor/small/lets", path := "out/test/refactor/small/lets/f.u"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "function f(x: Int): Int :=\n  let a := x + 1 in\n  let b := a * 2 in\n  a + b\n")
  run_script(in "@patch " ++ path ++ ":f\nx + 1 => x + 2\n@patch " ++ path ++ ":f\nlet b := a * 2 in\n  a + b\n=>\nlet b := a * 3 in\n  a - b\n", false, dir, unchecked, out reply, status, _)
  assert status == 0 and take(4, drop(1, reply)) == List(
    "patched " ++ path ++ ":f/1",
    "#1      let a := x + 2 in",
    "patched " ++ path ++ ":f/1",
    "#2      let b := a * 3 in\n#3      a - b")

// a line old =>* new of @patch replaces every occurrence of old in the target, in its head and body alike, and says how
// often, a line old =>* deletes them, an =>* in a literal is no such arrow, and an old text that occurs nowhere is refused
test patches_every() :=
  var reply: List[Str], status: Int, text: Str
  let dir := "out/test/refactor/small/every", path := "out/test/refactor/small/every/f.u"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "function f(x: Int): Str :=\n  if x + x * x > 0 then \" =>* \" else \"\"\n")
  run_script(in "@patch " ++ path ++ ":f\nx =>* y\n@patch " ++ path ++ ":f\n * y =>*\n@patch " ++ path ++ ":f\n\" =>* \" => \"=\"\n", false, dir, unchecked, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "function f(y: Int): Str :=\n  if y + y > 0 then \"=\" else \"\"\n"
  assert contains("patched " ++ path ++ ":f/1, replaced \"x\" 4 times", reply)
  assert contains("patched " ++ path ++ ":f/1, replaced \" * y\" 1 time", reply)
  run_script(in "@patch " ++ path ++ ":f\nz =>* w\n", false, dir, unchecked, out reply, status, _)
  assert status == 1 and reply == List("rejected", "@patch: the old text \"z\" occurs nowhere in the target")

// a file spelled with ./ or .. is the file without them, in the handles and in the edits of a script, so that both
// spellings show the same handles, and a show after a put sees the put
test normal_paths() :=
  var path: Str, reply: List[Str], status: Int, table: Str
  let dir := "out/test/refactor/small/paths"
  branches(in dir, out path)
  run_script(in "@show ./" ++ path ++ ":p\n@show " ++ dir ++ "/../paths/p.u:p\n", false, dir, unchecked, out reply, status, _)
  let shown := "@show " ++ path ++ ":p\n#1    procedure p(in x: Int, out y: Int) :=\n#2      if x > 0 then\n#3        y := 1\n        else\n#4        y := 2\n        end"
  assert status == 0 and reply == List("applied", shown, shown)
  run_script(in "@put ./" ++ path ++ ":p\nprocedure p(in x: Int, out y: Int) := y := x\n@show " ++ path ++ ":p\n", false, dir, unchecked, out reply, status, _)
  assert status == 0 and contains("@show " ++ path ++ ":p\n#1    procedure p(in x: Int, out y: Int) :=\n#5      y := x", reply)
  os_read_utf8(in os_join(dir, "handles.txt"), out table)
  assert index_of("./", table) == None and index_of(path, table) != None

// a rename that a local would capture names the use, the local, and the declaration it should resolve to; a new name
// that the library declares with another arity warns of it; @refs takes a path with ./ as the path
test rename_messages() :=
  var reply: List[Str], status: Int
  let dir := "out/test/refactor/small/rename"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in os_join(dir, "p/a.u"), "export\n\nfunction f(x: Int): Int\n\nimplementation\n\nfunction f(x: Int): Int :=\n  x + 1\n")
  os_write_utf8(in os_join(dir, "p/b.u"), "function g(y: Int): Int :=\n  let f := 1 in\n  f + y\n\nfunction h(y: Int): Int :=\n  f(y)\n")
  os_write_utf8(in os_join(dir, "m.u"), "function shout(s: Str): Str :=\n  s\n\nfunction use(s: Str): Str :=\n  shout(s)\n")
  run_script(in "@rename " ++ dir ++ "/p/a.u:f y", false, dir, unchecked, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "the rename changes the resolution of other names, so nothing is written:\n" ++ dir ++ "/p/b.u:6.3: the use y would resolve to the local y instead of out.test.refactor.small.rename.p.a.y")
  run_script(in "@refs ./" ++ dir ++ "/p/a.u:f", false, dir, unchecked, out reply, status, _)
  assert status == 0
  assert drop(1, reply) == List(
    "@refs " ++ dir ++ "/p/a.u:f: 1 use of out.test.refactor.small.rename.p.a.f/1 in 1 file\n  " ++ dir ++ "/p/b.u:6.3 in h/1 #1: f(y)")
  run_script(in "@rename " ++ dir ++ "/m.u:shout max", false, dir, unchecked, out reply, status, _)
  assert status == 0
  assert exists(reply, lambda line => starts_with(line, "warning: the uses of max/1 also see ") and index_of("prelude.prelude.max: (Int, Int) -> Int", line) != None)
