// @patch of nodes, the normal paths of handles and files, and the messages of @rename, on files below
// out/test/refactor/small/ of the root, which run only compiled, as the scripts of scripts.u do

import "ulang/syntax"
import "ulang/refactor"

procedure unchecked(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  found := List()

// a file of a procedure of an if in a directory of its own with a fresh table of handles, and its path
procedure branches(in dir: Str, out path: Str) :=
  path := os_join(dir, "p.u")
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in path, "procedure p(in x: Int, out y: Int) :=\n  if x > 0 then\n    y := 1\n  else\n    y := 2\n  end\n")

// @patch takes a node by its text, by its position, and by a handle scoped by its declaration, as @show and @put do
test patches_nodes() :=
  var path: Str, reply: List[Str], status: Int, text: Str
  let dir := "out/test/refactor/small/patch"
  branches(in dir, out path)
  run_script(in "@patch " ++ path ++ ":p \"y := 1\"\n1 => 3\n@patch " ++ path ++ ":5.5\n2 => 4\n@show " ++ path ++ ":p\n@patch " ++ path ++ ":p #1\nx > 0 => x > 1\n", false, dir, unchecked, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "procedure p(in x: Int, out y: Int) :=\n  if x > 1 then\n    y := 3\n  else\n    y := 4\n  end\n"
  assert take(3, reply) == List(
    "applied, clean",
    path ++ ": patched " ++ path ++ ":p \"y := 1\"",
    path ++ ": patched " ++ path ++ ":5.5")
  run_script(in "@patch " ++ path ++ ":p \"z\"\nz => w\n", false, dir, unchecked, out reply, status, _)
  assert status == 1
  assert reply == List("rejected", "no node of " ++ path ++ ":p/2 starts with \"z\"")

// a file spelled with ./ or .. is the file without them, in the handles and in the edits of a script, so that both
// spellings show the same handles, and a show after a put sees the put
test normal_paths() :=
  var path: Str, reply: List[Str], status: Int, table: Str
  let dir := "out/test/refactor/small/paths"
  branches(in dir, out path)
  run_script(in "@show ./" ++ path ++ ":p\n@show " ++ dir ++ "/../paths/p.u:p\n", false, dir, unchecked, out reply, status, _)
  let shown := "@show " ++ path ++ ":p\n      procedure p(in x: Int, out y: Int) :=\n#1      if x > 0 then\n#2        y := 1\n        else\n#3        y := 2\n        end"
  assert status == 0 and reply == List("applied", shown, shown)
  run_script(in "@put ./" ++ path ++ ":p\nprocedure p(in x: Int, out y: Int) := y := x\n@show " ++ path ++ ":p\n", false, dir, unchecked, out reply, status, _)
  assert status == 0 and contains("@show " ++ path ++ ":p\n      procedure p(in x: Int, out y: Int) :=\n#4      y := x", reply)
  os_read_utf8(in os_join(dir, "handles.txt"), out table)
  assert index_of("./", table) == None and index_of(path, table) != None

// a rename that a local would capture names the use, the local, and the declaration it should resolve to; a new name
// that the library declares with another arity warns of it; @refs takes a path with ./ as the path
test rename_messages() :=
  var reply: List[Str], status: Int
  let dir := "out/test/refactor/small/rename"
  os_write_utf8(in os_join(dir, "handles.txt"), "")
  os_write_utf8(in os_join(dir, "p/a.u"), "export\n\nfunction f(x: Int): Int\n\nimplementation\n\nfunction f(x: Int): Int :=\n  x + 1\n")
  os_write_utf8(in os_join(dir, "p/b.u"), "function g(y: Int): Int :=\n  let f := 1 in\n  f + y\n\nfunction h(y: Int): Int :=\n  f(y)\n")
  os_write_utf8(in os_join(dir, "m.u"), "function shout(s: Str): Str :=\n  s\n\nfunction use(s: Str): Str :=\n  shout(s)\n")
  run_script(in "@rename " ++ dir ++ "/p/a.u:f y", false, dir, unchecked, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "the rename changes the resolution of other names, so nothing is written:\n" ++ dir ++ "/p/b.u:6.3: the use y would resolve to the local y instead of " ++ dir ++ "/p/a.y")
  run_script(in "@refs ./" ++ dir ++ "/p/a.u:f", false, dir, unchecked, out reply, status, _)
  assert status == 0
  assert drop(1, reply) == List(
    "@refs " ++ dir ++ "/p/a.u:f: 1 use of " ++ dir ++ "/p/a.f/1 in 1 file\n  " ++ dir ++ "/p/b.u:6.3 in h/1 #1: f(y)")
  run_script(in "@rename " ++ dir ++ "/m.u:shout max", false, dir, unchecked, out reply, status, _)
  assert status == 0
  assert exists(reply, lambda line => starts_with(line, "warning: the uses of max/1 also see ") and index_of("prelude/prelude.max: (Int, Int) -> Int", line) != None)
