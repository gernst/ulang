// the replies of the scripts of ulang/refactor/refactor.u, their first lines, their lists of diagnostics, and their
// tests, on files below out/test/refactor/replies/ of the root, which run only compiled, as those of scripts.u

import "ulang/syntax"
import "ulang/format"
import "ulang/parse"
import "ulang/refactor"

// an error of the type checker at line of the file
function type_error(line: Int): Diagnostic :=
  Diagnostic(TypeKind, "Mismatch", None, Pos(line, 3), "expected Int but found Bool", List())

// a warning of a lint at line of the file, as checked_diagnostics of ulang/ulang.u writes it
function lint_warning(line: Int): Diagnostic :=
  Diagnostic(FormatKind, "warning[BoolIte]", None, Pos(line, 3), "an if of true and false is its condition", List())

procedure no_diagnostics(in file: Str, out found: List[(Str, Diagnostic)]) :=
  found := List()

// the first line counts the errors and warnings of the state after the script, apart, and the status is 1 while an error
// remains, 0 with warnings only, and 1 for a refusal, which the first line rejected tells apart
test first_lines() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/first.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 1\n", false, state, lambda in file, out found =>
    found := List((file, type_error(2)), (file, type_error(5)), (file, lint_warning(7)))
  end, out reply, status, _)
  assert status == 1
  assert take(1, reply) == List("applied, 2 errors, 1 warning")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 2\n", false, state, lambda in file, out found =>
    found := List((file, lint_warning(7)))
  end, out reply, status, _)
  assert status == 0 and take(1, reply) == List("applied, 1 warning")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 3\n", false, state, no_diagnostics, out reply, status, _)
  assert status == 0 and take(1, reply) == List("applied, clean")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x +\n", false, state, no_diagnostics, out reply, status, _)
  assert status == 1 and take(1, reply) == List("rejected")

// a script that changes no file lists the diagnostics of the state, unmarked, since it has no change to compare, while one
// that changes a file lists those that are new or gone
test state_without_changes() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/state.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_script(in "@check " ++ path, false, state, lambda in file, out found =>
    found := List((file, type_error(2)))
  end, out reply, status, _)
  assert status == 1
  assert reply == List(
    "applied, 1 error",
    "checked 1 file, unchanged",
    "  " ++ path ++ ":2.3: Mismatch: expected Int but found Bool")

// the error of a fragment gives its line in the script too, which differs for each action
test fragment_lines() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/lines.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  let script := "@show " ++ path ++ ":f\n@put " ++ path ++ "\nfunction g(x: Int): Int :=\n  x +\n"
  run_script(in script, false, state, no_diagnostics, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "fragment 2.6, script 4.6: expression expected but end of input found")

// the tests of @check test count in the first line, after the state, and a failed one makes the status 3
test tested_counts() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/tested.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_tested_script(in "@check test " ++ path, false, state, no_diagnostics, lambda in paths, listed, out tests =>
    tests := Tests(List("tested " ++ join(", ", paths) ++ ": 2 passed, 1 failed, 1 not run"), 2, 1, 1)
  end, out reply, status)
  assert status == 3
  assert reply == List(
    "applied, clean, 2 tests passed, 1 failed, 1 not run",
    "checked 1 file, unchanged",
    "tested " ++ path ++ ": 2 passed, 1 failed, 1 not run")

// an empty file is formatted, so that check gives it no Unformatted
test empty_formatted() :=
  var source: Source
  parse_file_text(in "out/test/refactor/replies/empty.u", "", out source)
  assert format_program(source) == ""
