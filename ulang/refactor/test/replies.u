// the replies of the scripts of ulang/refactor/refactor.u, their first lines, their lists of diagnostics, and their
// tests, on files below out/test/refactor/replies/ of the root, which run only compiled, as those of scripts.u

import ulang.syntax
import ulang.format
import ulang.parse
import ulang.refactor

// an error of the type checker at line of the file
function type_error(line: Int): Diagnostic :=
  Diagnostic(TypeKind, "Mismatch", None, Pos(line, 3), "expected Int but found Bool", List())

// a warning of a lint at line of the file, as checked_diagnostics of ulang/ulang.u writes it
function lint_warning(line: Int): Diagnostic :=
  Diagnostic(FormatKind, "warning[BoolIte]", None, Pos(line, 3), "an if of true and false is its condition", List())

procedure no_diagnostics(
  in  file: Str,
      overlays: Map[Str, Str],
  out found: List[(Str, Diagnostic)]
) :=
  found := List()

// the first line counts the errors and warnings of the state after the script, apart, and the status is 1 while an error
// remains, 0 with warnings only, and 1 for a refusal, which the first line rejected tells apart
test first_lines() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/first.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 1\n", false, state, lambda in file, _, out found =>
    found := List((file, type_error(2)), (file, type_error(5)), (file, lint_warning(7)))
  end, out reply, status, _)
  assert status == 1
  assert take(1, reply) == List("applied, 2 errors (0 new), 1 warning (0 new)")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 2\n", false, state, lambda in file, _, out found =>
    found := List((file, lint_warning(7)))
  end, out reply, status, _)
  assert status == 0 and take(1, reply) == List("applied, 1 warning (0 new)")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 3\n", false, state, no_diagnostics, out reply, status, _)
  assert status == 0 and take(1, reply) == List("applied, clean")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x +\n", false, state, no_diagnostics, out reply, status, _)
  assert status == 1 and take(1, reply) == List("rejected")

// the first line counts the errors and warnings that the script made new, apart, if it changed a file
test new_counts() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/new.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_script(in "@put " ++ path ++ "\nfunction f(x: Int): Int := x + 1\n", false, state, lambda in file, overlays, out found =>
    found := List((file, type_error(5)), (file, lint_warning(7))) ++ (if overlays == Map() then
      List()
    else
      List(
        (file, Diagnostic(TypeKind, "UnknownVariable", None, Pos(2, 3), "unknown variable y", List()))))
  end, out reply, status, _)
  assert status == 1 and take(1, reply) == List("applied, 2 errors (1 new), 1 warning (0 new)")

// a diagnostic that the checks report twice, as those of two members of a package report the errors of one with its
// module, is counted and listed once
test duplicates() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/duplicates.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  os_write_utf8(in os_join(state, "handles.txt"), "")
  run_script(in "@check " ++ path, false, state, lambda in file, _, out found =>
    found := List(
      (file, type_error(2)),
      (file, type_error(2) with module := Some(List("replies"))))
  end, out reply, status, _)
  assert status == 1 and reply == List(
    "applied, 1 error",
    "checked 1 file, unchanged",
    "  #1 " ++ path ++ ":2.3: Mismatch: expected Int but found Bool")

// a script that changes no file lists the diagnostics of the state, unmarked but for their handles, since it has no change
// to compare, while one that changes a file lists those that are new or gone
test state_without_changes() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/state.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  os_write_utf8(in os_join(state, "handles.txt"), "")
  run_script(in "@check " ++ path, false, state, lambda in file, _, out found =>
    found := List((file, type_error(2)))
  end, out reply, status, _)
  assert status == 1
  assert reply == List(
    "applied, 1 error",
    "checked 1 file, unchanged",
    "  #1 " ++ path ++ ":2.3: Mismatch: expected Int but found Bool")

// the error of a fragment gives its line in the script too, which differs for each action
test fragment_lines() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/lines.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  let script := "@show " ++ path ++ ":f\n@put " ++ path ++ "\nfunction g(x: Int): Int :=\n  x +\n"
  run_script(in script, false, state, no_diagnostics, out reply, status, _)
  assert status == 1
  assert reply == List(
    "rejected",
    "fragment 2.6, script 4.6: expression expected but end of input found")

// the tests of @check test count in the first line, after the state, and a failed one makes the status 3
test tested_counts() :=
  var reply: List[Str], status: Int
  let state := "out/test/refactor/replies/state", path := "out/test/refactor/replies/tested.u"
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  run_tested_script(in "@check test " ++ path, false, Map(), state, no_diagnostics, lambda in paths, listed, out tests =>
    tests := Tests(List("tested " ++ join(", ", paths) ++ ": 2 passed, 1 failed, 1 not run"), 2, 1, 1)
  end, out reply, status)
  assert status == 3
  assert reply == List(
    "applied, clean, 2 tests passed, 1 failed, 1 not run",
    "checked 1 file, unchanged",
    "tested " ++ path ++ ": 2 passed, 1 failed, 1 not run")

// an empty file is formatted, so that check gives it no Unformatted
test empty_formatted() :=
  var source: Source
  parse_file_text(in "out/test/refactor/replies/empty.u", "", out source)
  assert format_program(source) == ""

// the echo of the nodes that an edit placed and @show of a node print the comments above them, as format places them,
// with the blank lines between them
test shows_comments() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/replies/comments", path := "out/test/refactor/replies/comments/c.u"
  os_write_utf8(in os_join(state, "handles.txt"), "")
  os_write_utf8(in path, "procedure p(in x: Int, out y: Int) :=\n  y := x\n  if x > 0 then\n    y := 1\n    // ends the body\n  end\n")
  run_script(in "@put after " ++ path ++ ":p \"y := x\"\n// the second\n\n// step\ny := y + 1\n", false, state, no_diagnostics, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 0
  assert text == "procedure p(in x: Int, out y: Int) :=\n  y := x\n  // the second\n\n  // step\n  y := y + 1\n  if x > 0 then\n    y := 1\n    // ends the body\n  end\n"
  let shown := List("        // the second", "", "        // step", "#1      y := y + 1")
  assert take(3, reply) == List(
    "applied, clean",
    "put after " ++ path ++ ":p/2 \"y := x\"",
    join("\n", shown))
  run_script(in "@show " ++ path ++ ":p #1\n@show " ++ path ++ ":p \"if\"", false, state, no_diagnostics, out reply, status, _)
  assert status == 0
  assert at(1, reply) == join("\n", List("@show " ++ path ++ ":p/2 #1") ++ shown)
  assert take(2, split(at(2, reply), '\n')) == List("@show " ++ path ++ ":p/2 \"if\"", "#2      if x > 0 then")

// a refused query is a note of the reply, which the first line counts, and the other actions of the script go on, since
// queries write nothing, while the status is 1
test refused_queries() :=
  var reply: List[Str], status: Int, text: Str
  let state := "out/test/refactor/replies/refused", path := "out/test/refactor/replies/refused/r.u"
  os_write_utf8(in os_join(state, "handles.txt"), "")
  os_write_utf8(in path, "function f(x: Int): Int :=\n  x\n")
  let script := "@show " ++ path ++ ":g\n@outline " ++ path ++ "\n@show " ++ path ++ ":f \"y\"\n@put " ++ path ++ "\nfunction f(x: Int): Int := x + 1\n"
  run_script(in script, false, state, no_diagnostics, out reply, status, _)
  os_read_utf8(in path, out text)
  assert status == 1 and text == "function f(x: Int): Int :=\n  x + 1\n"
  assert take(5, reply) == List(
    "applied, clean, 2 queries refused",
    "@show " ++ path ++ ":g: refused, " ++ path ++ " declares no g",
    "@outline " ++ path ++ "\n1-2 none function f/1 private  #1",
    "@show " ++ path ++ ":f \"y\": refused, no node of " ++ path ++ ":f/1 starts with \"y\"",
    path ++ ": replaced f/1")
