// the tool's literals, types, patterns, names, and programs as ulang source, where literals, types, patterns, and names
// are formatted by their structure, for the messages of the checker and the interpreter, as format_value of ulang/run.u
// formats values, and programs with the notation in effect, as out/ulang.bin format prints them, which parses to the same
// commands

export

function format_program(source: Source): Str

function format_lit(lit: Lit): Str

function format_type(t: Type): Str

function format_types(ts: List[Type]): Str

// the types of one message, where a name of sorts of several modules is qualified by its module wherever it occurs
function format_types_apart(ts: List[Type]): List[Str]

function format_pat(pat: Pat): Str

function format_name(n: Name): Str

// the array of the texts of its elements, which the interpreter shows itself when they have declared shows
function array_text(texts: List[Str]): Str

implementation

// programs as source, where the notation of the prelude, of the program, and of its imports decide where operators need
// parentheses, and the translations of the parser are printed as what they translate, so that the source parses to the
// same commands
data Doc :=
  case Doc(text: Str, shape: Shape)

// an open form extends as far to the right as it can, as if, let, lambda without modes, raise, and updates do, a negative
// literal would be read as - applied to its operand, and an operator binds its operands by its fixity and precedence
data Shape :=
  case Atom
  case Open
  case Negative
  case Operator(fixity: Fixity, prec: Int)

// the last of the modules of source as source, after the modules before it, whose notation it starts with as far as it
// sees them, by imports, implicitly, or as the members of its package
function format_program(source: Source): Str :=
  match last(source.mods)
    case Some(d) =>
      join("\n\n", format_mod(imported_notation(source.mods, seen_modules(d, source.packages)), d)) ++ "\n"
    case None =>
      ""
  end

// the notation that the modules names of mods export, in order
function imported_notation(mods: List[Mod], names: List[Id]): Notation :=
  with_notation(empty_notation(), imported_cmds(mods, names))

function imported_cmds(mods: List[Mod], names: List[Id]): List[Cmd] :=
  List(for d in mods for c in commands_of(d.exported) if contains(d.name, names) yield c)

// the imports of module d and its sections, where its export section declares the notation of the sections after it, and a
// module that exports nothing has no sections
function format_mod(notation: Notation, d: Mod): List[Str] :=
  doc_header(d) ++ import_lines(d) ++ format_sections(notation, d)

function doc_header(d: Mod): List[Str] :=
  if d.doc == "" then List() else List(doc_lines(d.doc))

// one block of the imported packages, in their order, which is the order of loading
function import_lines(d: Mod): List[Str] :=
  let is := List(for p in d.imports yield "import " ++ quote(p)) in
  if d.imports == List() then List() else List(join("\n", is))

function format_sections(notation: Notation, d: Mod): List[Str] :=
  if is_sectionless(d) then
    format_cmds(notation, d.implemented)
  else
    sections_of(notation, d)

function is_sectionless(d: Mod): Bool :=
  d.exported == List() and d.builtins == List()

function sections_of(notation: Notation, d: Mod): List[Str] :=
  export_section(notation, d) ++ builtin_section(notation, d) ++ implementation_section(notation, d)

function export_section(notation: Notation, d: Mod): List[Str] :=
  List("export"; format_cmds(notation, d.exported))

function builtin_section(notation: Notation, d: Mod): List[Str] :=
  section_lines("builtin", inner_notation(notation, d), d.builtins)

function implementation_section(notation: Notation, d: Mod): List[Str] :=
  section_lines("implementation", inner_notation(notation, d), d.implemented)

function section_lines(head: Str, notation: Notation, tops: List[Top]): List[Str] :=
  if tops == List() then List() else List(head; format_cmds(notation, tops))

function inner_notation(notation: Notation, d: Mod): Notation :=
  with_notation(notation, commands_of(d.exported))

// op applied to the operands, if it is declared as an operator of their number
function operator_doc(notation: Notation, op: Id, args: List[Doc]): Option[Doc] :=
  match (args, infix_of(notation, op), prefix_prec(notation, op), postfix_prec(notation, op))
    case (List(l, r), Some((f, prec)), _, _) =>
      Some(infix_doc(op, l, r, f, prec))

    case (List(a), _, Some(prec), _) =>
      Some(Doc(prefix_text(op, prefix_operand(a, prec)), Operator(FPrefix, prec)))

    case (List(a), _, _, Some(prec)) =>
      Some(Doc(postfix_operand(a) ++ " " ++ op, Operator(FPostfix, prec)))

    case _ =>
      None
  end

function infix_doc(op: Id, l: Doc, r: Doc, f: Fixity, prec: Int): Doc :=
  Doc(infix_operand(l, f, prec, FLeft) ++ " " ++ op ++ " " ++ infix_operand(r, f, prec, FRight), Operator(f, prec))

function parenthesized(d: Doc, needed: Bool): Str :=
  if needed then "(" ++ d.text ++ ")" else d.text

// an operand of an infix operator of fixity f and precedence prec on the side FLeft or FRight, where a prefix operator
// would take the operators after it of its precedence or above, and a chain of an associative operator needs none
function infix_operand(d: Doc, f: Fixity, prec: Int, side: Fixity): Str :=
  parenthesized(d, match d.shape
    case Atom =>
      false

    case Operator(FPrefix, q) =>
      q <= prec

    case Operator(FPostfix, _) =>
      true

    case Operator(fixity, q) =>
      q < prec or q == prec and not (f == side and fixity == side)

    case Negative =>
      side == FLeft

    case _ =>
      true
  end)

// the operand of a prefix operator, which takes the operators of its precedence or above
function prefix_operand(d: Doc, prec: Int): Str :=
  parenthesized(d, match d.shape
    case Atom =>
      false

    case Operator(FPostfix, _) =>
      true

    case Operator(_, q) =>
      q < prec

    case _ =>
      true
  end)

function postfix_operand(d: Doc): Str :=
  parenthesized(d, match d.shape
    case Atom =>
      false

    case Operator(FPostfix, _) =>
      false

    case _ =>
      true
  end)

// a name is separated from its operand, and a symbol only from an operand that starts with a symbol, as in - -x
function prefix_text(op: Id, a: Str): Str :=
  if not is_symbolic(op) or is_op_char(at(0, a)) then
    op ++ " " ++ a
  else
    op ++ a

// the function of an application, and the record of an access
function atom_text(d: Doc): Str :=
  parenthesized(d, d.shape != Atom)

// an expression before a comma that a name and := may follow, which would continue its updates
function closed_text(d: Doc): Str :=
  parenthesized(d, d.shape == Open)

// expressions, at the indentation of the line they start on
function format_expr(notation: Notation, indent: Str, expr: Expr): Str :=
  expr_doc(notation, indent, expr).text

function format_exprs(notation: Notation, indent: Str, exprs: List[Expr]): Str :=
  join(", ", List(for e in exprs yield format_expr(notation, indent, e)))

function expr_doc(notation: Notation, indent: Str, expr: Expr): Doc :=
  match expr
    case ELit(LInt(num)) if num < 0 =>
      Doc(show(num), Negative)

    case ELit(lit) =>
      Doc(format_lit(lit), Atom)

    case EVar(var) =>
      Doc(var.name.base, Atom)

    case EApp(fun, args) =>
      app_doc(notation, indent, fun, args)

    case EField(e, field) =>
      Doc(atom_text(expr_doc(notation, indent, e)) ++ "." ++ field, Atom)

    case EUpdate(_, _, _) =>
      updates_doc(notation, indent, expr)

    case ELam(List(), body) =>
      Doc("lambda => " ++ format_expr(notation, indent, body), Open)

    case ELam(formals, body) =>
      match patterns_of_lambda(formals, body)
        case Some((pats, inner)) =>
          Doc("lambda " ++ format_patterns(notation, indent, pats) ++ " => " ++ format_expr(notation, indent, inner), Open)
        case None =>
          Doc("lambda " ++ formals_text(formals) ++ " => " ++ format_expr(notation, indent, body), Open)
      end

    case EProc(ins, outs, refs, stmt) =>
      Doc(block_text(notation, indent, "lambda " ++ formal_sections(ins, outs, refs) ++ " =>", stmt), Atom)

    case ELet(bindings, body) =>
      Doc(let_text(notation, indent, bindings, body), Open)

    case EIte(cond, then_expr, else_expr) =>
      Doc(ite_text(notation, indent, cond, then_expr, else_expr), Open)

    case EMatch(arg, cases) =>
      Doc(expr_match_text(notation, indent, arg, cases), Atom)

    case ETuple(args) =>
      Doc("(" ++ format_exprs(notation, indent, args) ++ ")", Atom)

    case EForm(form, elems, rest) =>
      Doc(form_text(notation, indent, form, elems, rest), Atom)

    case EFor(form, gens, elem, rest) =>
      Doc(for_text(notation, indent, form, gens, elem, rest), Atom)
  end

// the body on the next line, at the indentation of the let
function let_text(notation: Notation, indent: Str, bindings: List[Pat * Expr], body: Expr): Str :=
  "let " ++ bindings_text(notation, indent, bindings) ++ " in\n" ++ indent ++ format_expr(notation, indent, body)

// the bindings of a let, where each but the last is closed, since a comma would continue it
function bindings_text(notation: Notation, indent: Str, bindings: List[Pat * Expr]): Str :=
  match bindings
    case List() =>
      ""

    case List((p, a)) =>
      format_pattern(notation, indent, p) ++ " := " ++ format_expr(notation, indent, a)

    case List((p, a); more) =>
      format_pattern(notation, indent, p) ++ " := " ++ closed_expr(notation, indent, a) ++ ", " ++ bindings_text(notation, indent, more)
  end

// on one line if it fits in 80 columns, as a display does
function ite_text(notation: Notation, indent: Str, cond: Expr, then_expr: Expr, else_expr: Expr): Str :=
  let flat := "if " ++ format_expr(notation, indent, cond) ++ " then " ++ format_expr(notation, indent, then_expr) ++ " else " ++ format_expr(notation, indent, else_expr) in
  if size(indent) + size(flat) > 80 or contains('\n', flat) then
    spread_ite(notation, indent, cond, then_expr, else_expr)
  else
    flat

// each branch on a line of its own, one deeper, and an if after else at the level of the first if
function spread_ite(notation: Notation, indent: Str, cond: Expr, then_expr: Expr, else_expr: Expr): Str :=
  let inner := deeper(indent) in
  "if " ++ format_expr(notation, indent, cond) ++ " then\n" ++ inner ++ format_expr(notation, inner, then_expr) ++ "\n" ++ indent ++ "else" ++ match else_expr
    case EIte(c, t, e) =>
      " " ++ spread_ite(notation, indent, c, t, e)
    case _ =>
      "\n" ++ inner ++ format_expr(notation, inner, else_expr)
  end

function expr_match_text(notation: Notation, indent: Str, expr: Expr, cases: List[Branch[Expr]]): Str :=
  end_text(indent, "match " ++ format_expr(notation, indent, expr) ++ expr_cases(notation, deeper(indent), cases))

function end_text(indent: Str, text: Str): Str :=
  text ++ "\n" ++ indent ++ "end"

function block_text(notation: Notation, indent: Str, head: Str, stmt: Stmt): Str :=
  end_text(indent, head ++ format_body(notation, deeper(indent), stmt))

// a display wider than the line puts one element on each line
function form_text(notation: Notation, indent: Str, form: Form, elems: List[Yield], rest: Option[Expr]): Str :=
  let flat := form_name(form) ++ "(" ++ elems_text(notation, indent, elems) ++ rest_text(notation, indent, rest) ++ ")" in
  if size(indent) + size(flat) > 80 then
    spread_form(notation, indent, form, elems, rest)
  else
    flat

function spread_form(notation: Notation, indent: Str, form: Form, elems: List[Yield], rest: Option[Expr]): Str :=
  let inner := deeper(indent) in
  form_name(form) ++ "(\n" ++ inner ++ join(",\n" ++ inner, List(for e in elems yield elem_text(notation, inner, e))) ++ rest_text(notation, inner, rest) ++ ")"

function elems_text(notation: Notation, indent: Str, elems: List[Yield]): Str :=
  join(", ", List(for e in elems yield elem_text(notation, indent, e)))

function for_text(notation: Notation, indent: Str, form: Form, gens: List[Gen], elem: Yield, rest: Option[Expr]): Str :=
  form_name(form) ++ "(" ++ gens_text(notation, indent, gens) ++ for_tail(notation, indent, form, gens, elem, rest)

function for_tail(notation: Notation, indent: Str, form: Form, gens: List[Gen], elem: Yield, rest: Option[Expr]): Str :=
  yield_text(notation, indent, form, gens, elem) ++ rest_text(notation, indent, rest) ++ ")"

function gens_text(notation: Notation, indent: Str, gens: List[Gen]): Str :=
  join(" ", List(for g in gens yield gen_text(notation, indent, g)))

function yield_text(notation: Notation, indent: Str, form: Form, gens: List[Gen], elem: Yield): Str :=
  if implicit_elem(form, gens) == Some(elem) then
    ""
  else
    " yield " ++ elem_text(notation, indent, elem)

function elem_text(notation: Notation, indent: Str, elem: Yield): Str :=
  match elem
    case YVal(e) =>
      format_expr(notation, indent, e)
    case YPair(k, v) =>
      format_expr(notation, indent, k) ++ " => " ++ format_expr(notation, indent, v)
  end

// for p in c, for k => v in m, or if q
function gen_text(notation: Notation, indent: Str, g: Gen): Str :=
  match g
    case GVal(p, c) =>
      "for " ++ format_pattern(notation, indent, p) ++ in_text(notation, indent, c)

    case GPair(k, v, c) =>
      "for " ++ format_pattern(notation, indent, k) ++ " => " ++ format_pattern(notation, indent, v) ++ in_text(notation, indent, c)

    case GIf(q) =>
      "if " ++ format_expr(notation, indent, q)
  end

function in_text(notation: Notation, indent: Str, c: Expr): Str :=
  " in " ++ format_expr(notation, indent, c)

function app_doc(notation: Notation, indent: Str, f: Expr, args: List[Expr]): Doc :=
  let docs := List(for a in args yield expr_doc(notation, indent, a)) in
  match f
    case EName(name, _) =>
      match operator_doc(notation, name.base, docs)
        case Some(d) =>
          d
        case None =>
          Doc(name.base ++ "(" ++ texts(docs) ++ ")", Atom)
      end

    case _ =>
      Doc(atom_text(expr_doc(notation, indent, f)) ++ "(" ++ texts(docs) ++ ")", Atom)
  end

function texts(docs: List[Doc]): Str :=
  join(", ", List(for d in docs yield d.text))

// e with f := a, g := b, which the parser applies from the left, where e and the values are operands without updates
function updates_doc(notation: Notation, indent: Str, expr: Expr): Doc :=
  match updates_of(expr)
    case (r, updates) =>
      Doc(closed_expr(notation, indent, r) ++ " with " ++ updates_text(notation, indent, updates), Open)
  end

function updates_text(notation: Notation, indent: Str, updates: List[Id * Expr]): Str :=
  join(", ", List(for u in updates yield update_text(notation, indent, u)))

function closed_expr(notation: Notation, indent: Str, expr: Expr): Str :=
  closed_text(expr_doc(notation, indent, expr))

function update_text(notation: Notation, indent: Str, update: Id * Expr): Str :=
  match update
    case (f, a) =>
      f ++ " := " ++ closed_expr(notation, indent, a)
  end

function updates_of(expr: Expr): Expr * List[Id * Expr] :=
  match expr
    case EUpdate(r, field, a) =>
      match updates_of(r)
        case (s, updates) =>
          (s, updates ++ List((field, a)))
      end

    case _ =>
      (expr, List())
  end

// x := e, y := f, where an open form before a comma is parenthesized
function assignments_text(notation: Notation, indent: Str, pairs: List[Var * Expr]): Str :=
  match pairs
    case List() =>
      ""

    case List((x, a)) =>
      x.name.base ++ " := " ++ format_expr(notation, indent, a)

    case List((x, a); more) =>
      assignment_text(notation, indent, x, a) ++ ", " ++ assignments_text(notation, indent, more)
  end

function assignment_text(notation: Notation, indent: Str, x: Var, a: Expr): Str :=
  x.name.base ++ " := " ++ closed_expr(notation, indent, a)

function expr_cases(notation: Notation, indent: Str, branches: List[Branch[Expr]]): Str :=
  case_chain(List(for b in branches yield expr_case(notation, indent, b)))

// the cases, each starting with a newline, with a blank line between them unless there are at most two and each has a
// head and one line of body
function case_chain(cases: List[Str]): Str :=
  join(if size(cases) > 2 or exists(cases, lambda c => size(split(c, '\n')) > 3) then
    "\n"
  else
    "", cases)

function expr_case(notation: Notation, indent: Str, b: Branch[Expr]): Str :=
  branch_head(notation, indent, b) ++ "\n" ++ deeper(indent) ++ format_expr(notation, deeper(indent), b.body)

function branch_head[A](notation: Notation, indent: Str, b: Branch[A]): Str :=
  indented_doc(indent, b.doc) ++ "\n" ++ indent ++ case_head(notation, indent, b.pat, b.guard)

function case_head(notation: Notation, indent: Str, pat: Pat, guard: Option[Expr]): Str :=
  match guard
    case Some(g) =>
      "case " ++ format_pattern(notation, indent, pat) ++ " if " ++ format_expr(notation, indent, g) ++ " =>"
    case None =>
      "case " ++ format_pattern(notation, indent, pat) ++ " =>"
  end

function deeper(indent: Str): Str :=
  indent ++ "  "

// the set or map after ; that a literal adds to, if it is not empty
function rest_text(notation: Notation, indent: Str, rest: Option[Expr]): Str :=
  match rest
    case Some(r) =>
      "; " ++ format_expr(notation, indent, r)
    case None =>
      ""
  end

function format_pattern(notation: Notation, indent: Str, pat: Pat): Str :=
  pattern_doc(notation, indent, pat).text

function format_patterns(notation: Notation, indent: Str, pats: List[Pat]): Str :=
  join(", ", List(for p in pats yield format_pattern(notation, indent, p)))

function pattern_doc(notation: Notation, indent: Str, pat: Pat): Doc :=
  match pat
    case PWild =>
      Doc("_", Atom)

    case PLit(LInt(num)) if num < 0 =>
      Doc(show(num), Negative)

    case PLit(lit) =>
      Doc(format_lit(lit), Atom)

    case PVar(var) =>
      Doc(var.name.base, Atom)

    case PTuple(args) =>
      Doc("(" ++ format_patterns(notation, indent, args) ++ ")", Atom)

    case PApp(Name(None, "Nil"), List()) =>
      Doc("List()", Atom)

    case PApp(Name(None, "Cons"), List(_, _)) =>
      Doc(list_pattern_text(notation, indent, pat), Atom)

    case PApp(constr, args) =>
      pattern_app_doc(notation, indent, constr, args)
  end

function pattern_app_doc(notation: Notation, indent: Str, constr: Name, pats: List[Pat]): Doc :=
  let docs := List(for q in pats yield pattern_doc(notation, indent, q)) in
  match operator_doc(notation, constr.base, docs)
    case Some(d) =>
      d
    case None =>
      Doc(constr.base ++ "(" ++ texts(docs) ++ ")", Atom)
  end

// a list wider than the line puts one element on each line, as the forms of expressions do
function list_pattern_text(notation: Notation, indent: Str, pat: Pat): Str :=
  let flat := "List(" ++ format_patterns(notation, indent, cons_pattern_items(pat)) ++ pattern_rest_text(notation, indent, pat) ++ ")" in
  if size(indent) + size(flat) > 80 then
    spread_list_pattern(notation, indent, pat)
  else
    flat

function spread_list_pattern(notation: Notation, indent: Str, pat: Pat): Str :=
  let inner := deeper(indent) in
  "List(\n" ++ inner ++ join(",\n" ++ inner, List(for p in cons_pattern_items(pat) yield format_pattern(notation, inner, p))) ++ pattern_rest_text(notation, inner, pat) ++ ")"

function pattern_rest_text(notation: Notation, indent: Str, pat: Pat): Str :=
  match cons_pattern_rest(pat)
    case PApp(Name(None, "Nil"), List()) =>
      ""
    case rest =>
      "; " ++ format_pattern(notation, indent, rest)
  end

function cons_pattern_items(pat: Pat): List[Pat] :=
  match pat
    case PApp(Name(None, "Cons"), List(a, b)) =>
      List(a; cons_pattern_items(b))
    case _ =>
      List()
  end

function cons_pattern_rest(pat: Pat): Pat :=
  match pat
    case PApp(Name(None, "Cons"), List(_, b)) =>
      cons_pattern_rest(b)
    case _ =>
      pat
  end

// statements, each on a line of its own at indent
function format_stmt(notation: Notation, indent: Str, stmt: Stmt): Str :=
  match stmt
    case SSkip =>
      "skip"

    case SAssign(upd) =>
      "assign " ++ assignments_text(notation, indent, upd)

    case SIf(cond, left, right) =>
      cond_text(notation, indent, "if", "then", cond, left) ++ else_text(notation, indent, right)

    case SWhile(cond, body) =>
      end_text(indent, cond_text(notation, indent, "while", "do", cond, body))

    case SCall(proc, ins, outs, refs) =>
      "call " ++ call_text(notation, indent, proc, ins, outs, refs)

    case SMatch(arg, cases) =>
      end_text(indent, "match " ++ format_expr(notation, indent, arg) ++ stmt_cases(notation, deeper(indent), cases))

    case SAssert(cond) =>
      "assert " ++ format_expr(notation, indent, cond)

    case SRaise(value, _) =>
      "raise " ++ format_expr(notation, indent, value)

    case STry(body, catches) =>
      end_text(indent, "try" ++ format_body(notation, deeper(indent), body) ++ catch_text(notation, indent, catches))

    case SBlock(_, _) =>
      match for_parts(stmt)
        case Some((pat, c, q, body)) =>
          end_text(indent, for_head(notation, indent, pat, c, q) ++ format_body(notation, deeper(indent), body))
        case None =>
          "skip" ++ format_body(notation, indent, stmt)
      end
  end

function cond_text(notation: Notation, indent: Str, word: Str, after: Str, cond: Expr, body: Stmt): Str :=
  word ++ " " ++ format_expr(notation, indent, cond) ++ " " ++ after ++ format_body(notation, deeper(indent), body)

function call_text(notation: Notation, indent: Str, proc: Name, ins: List[Expr], outs: List[Var], refs: List[Var]): Str :=
  proc.base ++ "(" ++ call_sections(notation, indent, ins, outs, refs) ++ ")"

function call_sections(notation: Notation, indent: Str, ins: List[Expr], outs: List[Var], refs: List[Var]): Str :=
  sections_text(List(for a in ins yield format_expr(notation, indent, a)), names_of(outs), names_of(refs))

function names_of(xs: List[Var]): List[Str] :=
  List(for x in xs yield x.name.base)

function catch_text(notation: Notation, indent: Str, handlers: List[Catch]): Str :=
  "\n" ++ indent ++ "catch" ++ stmt_cases(notation, deeper(indent), handler_branches(handlers))

function handler_branches(handlers: List[Catch]): List[Branch[Stmt]] :=
  List(for h in handlers yield Branch(h.doc, h.pat, h.guard, h.body))

function for_head(notation: Notation, indent: Str, pat: Pat, c: Expr, q: Option[Expr]): Str :=
  "for " ++ format_pattern(notation, indent, pat) ++ in_text(notation, indent, c) ++ do_text(notation, indent, q)

function do_text(notation: Notation, indent: Str, q: Option[Expr]): Str :=
  condition_text(notation, indent, q) ++ " do"

function condition_text(notation: Notation, indent: Str, q: Option[Expr]): Str :=
  match q
    case Some(c) =>
      " if " ++ format_expr(notation, indent, c)
    case None =>
      ""
  end

// the pattern, container, condition, and body of the block that the parser makes of for p in c if q do body end
function for_parts(stmt: Stmt): Option[Pat * Expr * Option[Expr] * Stmt] :=
  match stmt
    case ForBlock(pat, c, guarded) =>
      for_guarded(pat, c, guarded)
    case _ =>
      None
  end

function for_guarded(pat: Pat, c: Expr, guarded: Stmt): Option[Pat * Expr * Option[Expr] * Stmt] :=
  match guarded
    case SIf(g, body, SSkip) =>
      Some((pat, c, Some(g), body))
    case body =>
      Some((pat, c, None, body))
  end

// the else of an if, whose body may be an if, nested
function else_text(notation: Notation, indent: Str, stmt: Stmt): Str :=
  match stmt
    case SSkip =>
      "\n" ++ indent ++ "end"
    case _ =>
      "\n" ++ indent ++ "else" ++ format_body(notation, deeper(indent), stmt) ++ "\n" ++ indent ++ "end"
  end

function stmt_cases(notation: Notation, indent: Str, branches: List[Branch[Stmt]]): Str :=
  case_chain(List(for b in branches yield stmt_case(notation, indent, b)))

function stmt_case(notation: Notation, indent: Str, b: Branch[Stmt]): Str :=
  branch_head(notation, indent, b) ++ format_body(notation, deeper(indent), b.body)

// the lines of a body, each after a newline, where local x := e is x with the assignment that starts the block
function format_body(notation: Notation, indent: Str, body: Stmt): Str :=
  match body
    case SBlock(_, _) if for_parts(body) != None =>
      format_stmts(notation, indent, List(body))

    case SBlock(List(), stmts) =>
      format_stmts(notation, indent, stmts)

    case SBlock(locals, stmts) =>
      match local_decls(notation, indent, locals, stmts)
        case (decls, rest) =>
          "\n" ++ indent ++ "local " ++ join(", ", decls) ++ format_stmts(notation, indent, rest)
      end

    case _ =>
      format_stmts(notation, indent, List(body))
  end

function format_stmts(notation: Notation, indent: Str, ss: List[Stmt]): Str :=
  join("", List(for run in runs(ss) for s in run yield stmt_line(notation, indent, has_assign(run), s)))

// a statement after a newline, where a call is padded to the width of assign next to an assign
function stmt_line(notation: Notation, indent: Str, padded: Bool, stmt: Stmt): Str :=
  match stmt
    case SCall(proc, ins, outs, refs) if padded =>
      "\n" ++ indent ++ "call   " ++ call_text(notation, indent, proc, ins, outs, refs)
    case _ =>
      "\n" ++ indent ++ format_stmt(notation, indent, stmt)
  end

// the statements in groups, where the calls and assignments in a row are one group and any other statement is alone
function runs(ss: List[Stmt]): List[List[Stmt]] :=
  match ss
    case List() =>
      List()

    case List(s; rest) =>
      let more := runs(rest) in
      match more
        case List(List(t; same); others) if is_simple(s) and is_simple(t) =>
          List(List(s, t; same); others)
        case _ =>
          List(List(s); more)
      end
  end

function is_simple(stmt: Stmt): Bool :=
  match stmt
    case SCall(_, _, _, _) =>
      true

    case SAssign(_) =>
      true

    case _ =>
      false
  end

function has_assign(run: List[Stmt]): Bool :=
  exists(run, lambda s => match s
    case SAssign(_) =>
      true
    case _ =>
      false
  end)

// the declarations of the locals xs, with the assignments at the start of ss that initialize them, and the statements after
function local_decls(notation: Notation, indent: Str, xs: List[Var], ss: List[Stmt]): List[Str] * List[Stmt] :=
  match (xs, ss)
    case (List(), _) =>
      (List(), ss)

    case (List(x; more), List(SAssign(List((y, a))); rest)) if y == Var(x.name, THole) =>
      match local_decls(notation, indent, more, rest)
        case (decls, after) =>
          (List(
            formal_text(x) ++ " := " ++ closed_expr(notation, indent, a); decls), after)
      end

    case (List(x; more), _) =>
      match local_decls(notation, indent, more, ss)
        case (decls, after) =>
          (List(formal_text(x); decls), after)
      end
  end

// in a, b, out c, ref d, without the empty sections
function sections_text(ins: List[Str], outs: List[Str], refs: List[Str]): Str :=
  join(", ", section("in", ins) ++ section("out", outs) ++ section("ref", refs))

function section(mode: Str, items: List[Str]): List[Str] :=
  if items == List() then List() else List(mode ++ " " ++ join(", ", items))

function formal_sections(ins: List[Var], outs: List[Var], refs: List[Var]): Str :=
  sections_text(formal_texts(ins), formal_texts(outs), formal_texts(refs))

function formal_texts(xs: List[Var]): List[Str] :=
  List(for x in xs yield formal_text(x))

function formals_text(xs: List[Var]): Str :=
  join(", ", formal_texts(xs))

function formal_text(x: Var): Str :=
  if x.typ == THole then
    x.name.base
  else
    x.name.base ++ ": " ++ format_type(x.typ)

// commands, where the notation of a command apply to those after it
function format_cmds(notation: Notation, tops: List[Top]): List[Str] :=
  match tops
    case List() =>
      List()

    case List(top; more) =>
      let after := with_notation(notation, List(top.cmd)) in
      match format_cmd(notation, top.cmd)
        case Some(text) =>
          List(doc_text(top.doc) ++ text; format_cmds(after, more))
        case None =>
          format_cmds(after, more)
      end
  end

// the lines of a documentation as comments
function doc_lines(doc: Str): Str :=
  join("\n", List(for line in split(doc, '\n') yield if line == "" then "//" else "// " ++ line))

// the lines of a documentation as comments above its command, if there is any
function doc_text(doc: Str): Str :=
  if doc == "" then "" else doc_lines(doc) ++ "\n"

// the lines of a documentation as comments above a constructor or a case at indent, each after a newline
function indented_doc(indent: Str, doc: Str): Str :=
  if doc == "" then
    ""
  else
    join("", List(for line in split(doc, '\n') yield doc_line(indent, line)))

function doc_line(indent: Str, line: Str): Str :=
  if line == "" then "\n" ++ indent ++ "//" else "\n" ++ indent ++ "// " ++ line

function format_cmd(notation: Notation, cmd: Cmd): Option[Str] :=
  match cmd
    case CSort(name, params, typ) =>
      Some("type " ++ name.base ++ params_text(params) ++ " :=\n  " ++ format_type(typ))

    case CAbstract(name, params) =>
      Some("type " ++ name.base ++ params_text(params))

    case CData(name, params, constrs) =>
      Some(data_text(name, params, constrs))

    case CFun(name, params, formals, typ, body) =>
      Some(function_head(name, params, formals, typ) ++ " :=\n  " ++ format_expr(notation, "  ", body))

    case CFunSig(name, params, formals, typ) =>
      Some(function_head(name, params, formals, typ))

    case CProc(name, params, ins, outs, refs, stmt) =>
      Some(proc_head(name, params, ins, outs, refs) ++ " :=" ++ format_body(notation, "  ", stmt))

    case CProcSig(name, params, ins, outs, refs) =>
      Some(proc_head(name, params, ins, outs, refs))

    case CPatAlias(name, params, formals, typ, pat) =>
      Some("pattern " ++ name.base ++ params_text(params) ++ "(" ++ formals_text(formals) ++ "): " ++ format_type(typ) ++ " :=\n  " ++ format_pattern(notation, "  ", pat))

    case CNotation(fixity, prec, ops) =>
      Some(fixity_text(fixity) ++ " " ++ show(prec) ++ " " ++ join(" ", ops))

    case CTest(test_name, vars, stmt) =>
      Some("test " ++ test_name ++ "(" ++ formals_text(vars) ++ ") :=" ++ format_body(notation, "  ", stmt))

    case CLemma(name, params, formals, assms, concl) =>
      Some("lemma " ++ name.base ++ params_text(params) ++ "(" ++ formals_text(formals) ++ ") :=" ++ contract_text(notation, assms, concl))
  end

// requires and ensures on lines of their own, where ensures aligns with requires
function contract_text(notation: Notation, assms: List[Expr], concl: Expr): Str :=
  if assms == List() then
    "\n  ensures " ++ format_expr(notation, "  ", concl)
  else
    "\n  requires " ++ join(", ", List(for a in assms yield format_expr(notation, "  ", a))) ++ "\n  ensures  " ++ format_expr(notation, "  ", concl)

function data_text(name: Name, params: List[Id], constrs: List[Constr]): Str :=
  "data " ++ name.base ++ params_text(params) ++ " :=" ++ constrs_text(constrs)

function constrs_text(constrs: List[Constr]): Str :=
  join("", List(for c in constrs yield constr_line(c)))

function constr_line(c: Constr): Str :=
  indented_doc("  ", c.doc) ++ "\n  case " ++ constr_text(c)

// a head wider than the line has one formal on each line, the modes in front of the first of their group
function proc_head(name: Name, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var]): Str :=
  let flat := "procedure " ++ name.base ++ params_text(params) ++ "(" ++ formal_sections(ins, outs, refs) ++ ")" in
  if size(flat) > 80 then
    spread_proc_head(name, params, ins, outs, refs)
  else
    flat

function spread_proc_head(name: Name, params: List[Id], ins: List[Var], outs: List[Var], refs: List[Var]): Str :=
  "procedure " ++ name.base ++ params_text(params) ++ "(\n" ++ join(",\n", mode_lines("in ", ins) ++ mode_lines("out", outs) ++ mode_lines("ref", refs)) ++ "\n)"

function mode_lines(mode: Str, xs: List[Var]): List[Str] :=
  match formal_texts(xs)
    case List() =>
      List()

    case List(first; more) =>
      List(
        "  " ++ mode ++ " " ++ first; List(for text in more yield "      " ++ text))
  end

function params_text(params: List[Id]): Str :=
  if params == List() then "" else "[" ++ join(", ", params) ++ "]"

function function_head(n: Name, params: List[Id], xs: List[Var], r: Type): Str :=
  "function " ++ n.base ++ params_text(params) ++ "(" ++ formals_text(xs) ++ "): " ++ format_type(r)

function fixity_text(f: Fixity): Str :=
  match f
    case FPrefix =>
      "prefix"

    case FPostfix =>
      "postfix"

    case FInfix =>
      "infix"

    case FLeft =>
      "infix left"

    case FRight =>
      "infix right"
  end

// C(f: T, g: U)
function constr_text(c: Constr): Str :=
  match c
    case Constr(_, name, List()) =>
      name.base
    case Constr(_, name, fields) =>
      name.base ++ "(" ++ join(", ", List(for f in fields yield f.name ++ ": " ++ format_type(f.typ))) ++ ")"
  end

function test_operators(): Notation :=
  with_notation(empty_notation(), List(
    CNotation(FInfix, 6, List("==")),
    CNotation(FRight, 8, List("^")),
    CNotation(FLeft, 9, List("+", "-")),
    CNotation(FLeft, 10, List("*")),
    CNotation(FPrefix, 5, List("not")),
    CNotation(FPrefix, 11, List("-"))))

function source(expr: Expr): Str :=
  format_expr(test_operators(), "", expr)

test operators_parenthesized() :=
  local a := expr_var("a"), b := expr_var("b"), c := expr_var("c")
  assert source(expr_app("*", List(expr_app("+", List(a, b)), c))) == "(a + b) * c"
  assert source(expr_app("+", List(a, expr_app("*", List(b, c))))) == "a + b * c"
  assert source(expr_app("-", List(expr_app("-", List(a, b)), c))) == "a - b - c"
  assert source(expr_app("-", List(a, expr_app("-", List(b, c))))) == "a - (b - c)"
  assert source(expr_app("^", List(a, expr_app("^", List(b, c))))) == "a ^ b ^ c"
  assert source(expr_app("^", List(expr_app("^", List(a, b)), c))) == "(a ^ b) ^ c"
  assert source(expr_app("==", List(expr_app("==", List(a, b)), c))) == "(a == b) == c"
  assert source(expr_app("not", List(expr_app("==", List(a, b))))) == "not a == b"
  assert source(expr_app("==", List(expr_app("not", List(a)), b))) == "(not a) == b"
  assert source(expr_app("-", List(expr_app("+", List(a, b))))) == "-(a + b)"
  assert source(expr_app("-", List(expr_app("-", List(a))))) == "- -a"
  assert source(expr_app("-", List(expr_app("not", List(a))))) == "-(not a)"
  assert source(expr_app("*", List(a, expr_app("not", List(b))))) == "a * (not b)"
  assert source(expr_app("-", List(a, expr_int(-1)))) == "a - -1"
  assert source(EField(expr_int(-1), "f")) == "(-1).f"
  assert source(expr_app("+", List(EIte(a, b, c), expr_int(1)))) == "(if a then b else c) + 1"

test updates_closed() :=
  local r := EUpdate(EUpdate(expr_var("r"), "f", expr_int(1)), "g", EIte(expr_var("c"), expr_int(2), expr_int(3))), assignment := SAssign(List(
    (Var(unqualified("x"), THole), r),
    (Var(unqualified("y"), THole), expr_int(2)))), sum := expr_app("+", List(expr_var("a"), expr_var("b")))
  assert source(r) == "r with f := 1, g := (if c then 2 else 3)"
  assert format_stmt(test_operators(), "", assignment) == "assign x := (" ++ source(r) ++ "), y := 2"
  assert source(expr_app("+", List(EField(sum, "f"), r))) == "(a + b).f + (" ++ source(r) ++ ")"

test bodies() :=
  local x := Var(unqualified("x"), TInt()), y := Var(unqualified("y"), THole), body := SBlock(List(x, y), List(
    SAssign(List((Var(x.name, THole), expr_int(1)))),
    SIf(EVar(y), SBlock(List(), List(SSkip)), SIf(EVar(x), SBlock(List(), List()), SSkip)))), noted := Top(Pos(0, 0), "note", CNotation(FLeft, 9, List("+"))), plain := Top(Pos(0, 0), "", CNotation(FLeft, 8, List("-")))
  assert format_body(test_operators(), "", body) == "\nlocal x: Int := 1, y\nif y then\n  skip\nelse\n  if x then\n  end\nend"
  assert format_cmd(test_operators(), CNotation(FLeft, 9, List("+", "-"))) == Some("infix left 9 + -")
  assert doc_text("") == "" and doc_text("a\n b\n") == "// a\n//  b\n//\n"
  assert format_cmds(test_operators(), List(noted, plain)) == List("// note\ninfix left 9 +", "infix left 8 -")

// literals, types, patterns, and names by their structure, in a fixed notation
function format_lit(lit: Lit): Str :=
  match lit
    case LUnit =>
      "()"

    case LBool(bool) =>
      if bool then "true" else "false"

    case LInt(num) =>
      show(num)

    case LStr(text) =>
      quote(text)

    case LChar(char) =>
      "'" ++ escape(char, '\'') ++ "'"
  end

function array_text(texts: List[Str]): Str :=
  "Array(" ++ join(", ", texts) ++ ")"

// types as the messages of the checker show them, without numbering the unknowns anew
function format_type(t: Type): Str :=
  join(", ", format_types_apart(List(t)))

function format_types(ts: List[Type]): Str :=
  join(", ", format_types_apart(ts))

// the types of one message, where a name of sorts of several modules is qualified by its module wherever it occurs
function format_types_apart(ts: List[Type]): List[Str] :=
  let clashes := clashing_bases(List(for t in ts for name in sorts_in(t) yield name)) in
  List(for t in ts yield format_type_apart(clashes, t))

function clashing_bases(names: List[Name]): Set[Id] :=
  Set(for name in names if exists(names, lambda other => other.base == name.base and other != name) yield name.base)

// t, where the sorts of the names clashes are qualified by their modules
function format_type_apart(clashes: Set[Id], t: Type): Str :=
  match t
    case TParam(param) =>
      param

    case THole =>
      "_"

    case TMeta(meta) =>
      "?" ++ show(meta)

    case TFun(List(TTuple(List())), res) =>
      "(()) -> " ++ format_type_apart(clashes, res)

    case TFun(List(a), res) =>
      type_operand(clashes, a) ++ " -> " ++ format_type_apart(clashes, res)

    case TFun(args, res) =>
      "(" ++ format_list_apart(clashes, args) ++ ") -> " ++ format_type_apart(clashes, res)

    case TProc(ins, outs, refs) =>
      "(" ++ join(", ", type_section(clashes, "in", ins) ++ type_section(clashes, "out", outs) ++ type_section(clashes, "ref", refs)) ++ ")"

    case TTuple(List()) =>
      "()"

    case TTuple(types) =>
      join(" * ", List(for a in types yield type_component(clashes, a)))

    case TSort(name, List()) =>
      sort_text(clashes, name)

    case TSort(name, args) =>
      sort_text(clashes, name) ++ "[" ++ format_list_apart(clashes, args) ++ "]"
  end

function sort_text(clashes: Set[Id], name: Name): Str :=
  if contains(name.base, clashes) then format_name(name) else name.base

function format_list_apart(clashes: Set[Id], ts: List[Type]): Str :=
  join(", ", List(for t in ts yield format_type_apart(clashes, t)))

function type_section(clashes: Set[Id], mode: Str, ts: List[Type]): List[Str] :=
  if ts == List() then
    List()
  else
    List(mode ++ " " ++ format_list_apart(clashes, ts))

// the argument of a function, in parentheses if it is a function
function type_operand(clashes: Set[Id], t: Type): Str :=
  match t
    case TFun(_, _) =>
      "(" ++ format_type_apart(clashes, t) ++ ")"
    case _ =>
      format_type_apart(clashes, t)
  end

// a component of a tuple, in parentheses if it is a function or a tuple
function type_component(clashes: Set[Id], t: Type): Str :=
  match t
    case TFun(_, _) =>
      "(" ++ format_type_apart(clashes, t) ++ ")"

    case TTuple(List(_, _; _)) =>
      "(" ++ format_type_apart(clashes, t) ++ ")"

    case _ =>
      format_type_apart(clashes, t)
  end

// patterns as the messages of the checker show them, in the syntax of the source without a notation, since no
// constructor is named by an operator
function format_pat(pat: Pat): Str :=
  format_pattern(empty_notation(), "", source_pattern(pat))

// the checked pattern in the shape of the parsed one, where a constructor without arguments is a name, and Cons and Nil,
// which checking resolves, are the names that the parser writes for lists
function source_pattern(pat: Pat): Pat :=
  match pat
    case PWild =>
      pat

    case PLit(_) =>
      pat

    case PVar(_) =>
      pat

    case PTuple(args) =>
      PTuple(List(for p in args yield source_pattern(p)))

    case PCons(x, xs) =>
      PApp(Name(None, "Cons"), List(source_pattern(x), source_pattern(xs)))

    case PNil() =>
      PApp(Name(None, "Nil"), List())

    case PApp(constr, List()) =>
      PName(constr, THole)

    case PApp(constr, args) =>
      PApp(constr, List(for p in args yield source_pattern(p)))
  end

// whether a name is an operator, which starts with a symbol
function is_symbolic(n: Id): Bool :=
  n != "" and is_op_char(at(0, n))

// the name with its module, to tell names apart
function format_name(n: Name): Str :=
  match n
    case Name(Some(m), base) =>
      m ++ "." ++ base
    case Name(None, base) =>
      base
  end

test printing() :=
  local int_type := TSort(unqualified("Int"), List()), str_type := TSort(unqualified("Str"), List()), list_type := TSort(unqualified("List"), List(TParam("A"))), fun_type := TFun(List(TParam("A")), TParam("B")), pair_type := TTuple(List(int_type, str_type)), var_pat := PName(unqualified("x"), THole)
  assert format_type(TFun(List(fun_type, pair_type), list_type)) == "(A -> B, Int * Str) -> List[A]"
  assert format_type(TProc(List(TParam("A")), List(), List(int_type))) == "(in A, ref Int)"
  assert format_pat(PCons(var_pat, PApp(unqualified("Some"), List(PWild)))) == "List(x; Some(_))"
  assert format_name(cons_name()) == "prelude/list.Cons" and cons_name().base == "Cons"
