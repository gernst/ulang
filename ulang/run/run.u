// the interpreter of ulang, which runs programs of ulang/syntax/syntax.u that ulang/check/check.u has checked,
// where statements update the values of the variables in scope, which a call passes to a procedure and back,
// and errors are values of RuntimeError and InternalError of ulang/syntax/error.u, while the exceptions of the program are values of Thrown

import "ulang/syntax"
import "ulang/format"
import "ulang/check"

export

data Val :=
  case VLit(lit: Lit)
  case VObj(constr: Name, args: List[Val])
  case VArr(values: Array[Val])
  case VFunClos(env: Map[Name, Val], formals: List[Var], body: Expr)
  case VFun(name: Name, arity: Int)
  case VCon(constr: Name)
  case VPrim(name: Name)
  case VProc(name: Name)
  case VProcClos(env: Map[Name, Val], ins: List[Var], outs: List[Var], refs: List[Var], stmt: Stmt)

data Run :=
  case Run(defs: Defs, computing: List[Name], args: List[Str])

data Thrown :=
  case Thrown(value: Val, typ: Type)

function load(q: Prog): Run

function format_value(v: Val): Str

procedure run_proc(in run: Run, n: Name, ref cache: Map[Name, Val])

// the value of the function n without parameters, None if there is none
procedure constant_of(in run: Run, n: Name, out v: Option[Val])

procedure run_cmd(in run: Run, cmd: Cmd, ref cache: Map[Name, Val])

// runs the tests of a checked program, where failed assertions are errors
procedure run_program(in q: Prog)

implementation

pattern VInt(num: Int): Val :=
  VLit(LInt(num))

pattern VStr(text: Str): Val :=
  VLit(LStr(text))

pattern VChar(char: Char): Val :=
  VLit(LChar(char))

pattern VBool(bool: Bool): Val :=
  VLit(LBool(bool))

// the values of the constructors of the library that the interpreter makes and takes apart
pattern VNil(): Val :=
  VObj(Name(Some("prelude/list"), "Nil"), List())

pattern VCons(head: Val, tail: Val): Val :=
  VObj(Name(Some("prelude/list"), "Cons"), List(head, tail))

pattern VTuple(args: List[Val]): Val :=
  VObj(Name(None, ","), args)

pattern VSome(value: Val): Val :=
  VObj(Name(Some("prelude/option"), "Some"), List(value))

pattern VNone(): Val :=
  VObj(Name(Some("prelude/option"), "None"), List())

pattern VOsError(message: Str): Val :=
  VObj(Name(Some("prelude/os"), "OsError"), List(VStr(message)))

// values by their structure, for messages, while show of the program uses the shows that datatypes declare, see show_in
function format_value(v: Val): Str :=
  match v
    case VLit(lit) =>
      format_lit(lit)

    case VTuple(args) =>
      "(" ++ format_values(args) ++ ")"

    case VCons(_, _) if list_elements(v) != None =>
      "List(" ++ format_values(list_items(v)) ++ ")"

    case VNil() =>
      "List()"

    case VObj(constr, List()) =>
      constr.base

    case VObj(constr, args) =>
      constr.base ++ "(" ++ format_values(args) ++ ")"

    case VArr(values) =>
      array_text(List(for w in List(for x in values) yield format_value(w)))

    case VProc(_) =>
      "<procedure>"

    case VProcClos(_, _, _, _, _) =>
      "<procedure>"

    case _ =>
      "<function>"
  end

function format_values(vs: List[Val]): Str :=
  join(", ", List(for v in vs yield format_value(v)))

function list_items(v: Val): List[Val] :=
  match list_elements(v)
    case Some(vs) =>
      vs
    case None =>
      List()
  end

function list_value(vs: List[Val]): Val :=
  match vs
    case List() =>
      VNil()
    case List(v; rest) =>
      VCons(v, list_value(rest))
  end

function list_elements(v: Val): Option[List[Val]] :=
  match v
    case VNil() =>
      Some(List())

    case VCons(w, ws) =>
      match list_elements(ws)
        case Some(us) =>
          Some(List(w; us))
        case None =>
          None
      end

    case _ =>
      None
  end

// the values of the variables in scope, where a variable without a value is not in the map
type Bindings :=
  Map[Name, Val]

// the position of constructor k in its declaration, which orders values of different constructors
function position_of(run: Run, k: Name): Int :=
  value_or(map_option(get(k, run.defs.constrs), lambda constr => constr.position), 0)

// the function of the map fs, by datatype, that orders, equates, or shows the values of the datatype of constructor k
function declared_for(run: Run, k: Name, fs: Map[Name, Name]): Option[Name] :=
  match get(k, run.defs.constrs)
    case Some(constr) =>
      get(constr.datatype, fs)
    case None =>
      None
  end

// raises the exception of unordered_of for the datatype of constructor k, where equating raises only Incomparable
procedure unordered(in run: Run, k: Name, equating: Bool) :=
  match get(k, run.defs.constrs)
    case Some(constr) =>
      match unordered_of(run.defs, constr.datatype)
        case Some(e) if not equating or e == incomparable_name() =>
          raise failure(e, List(VStr(format_name(constr.datatype))))
        case _ =>
          skip
      end

    case None =>
      skip
  end

function load(q: Prog): Run :=
  Run(defs_of(q), List(), List())

// the contents of a string, as printing and declared shows give them, and the source of any other value
function text_of(v: Val): Str :=
  match v
    case VStr(text) =>
      text
    case _ =>
      format_value(v)
  end

// the builtins without a module, and the functions of the builtin sections of the prelude, str, and array
function builtin_names(): Set[Name] :=
  Set(
    unqualified("<"),
    unqualified("=="),
    unqualified("compare"),
    unqualified("show"),
    library_name("prelude", "+"),
    library_name("prelude", "-"),
    library_name("prelude", "*"),
    library_name("prelude", "/"),
    library_name("prelude", "%"),
    library_name("prelude", "++"),
    library_name("str", "chars"),
    library_name("str", "str"),
    library_name("str", "ord"),
    library_name("str", "chr"),
    library_name("str", "is_digit"),
    library_name("str", "is_letter"),
    library_name("str", "is_space"),
    library_name("str", "size"),
    library_name("str", "at"),
    library_name("str", "contains"),
    library_name("str", "slice"),
    library_name("str", "join"),
    library_name("str", "split"),
    library_name("str", "quote"),
    library_name("str", "number"),
    library_name("array", "from_list"),
    library_name("array", "size"),
    library_name("array", "at"),
    library_name("array", "slice"),
    library_name("array", "foldr"),
    library_name("array", "foldl"))

function is_builtin(n: Name): Bool :=
  contains(n, builtin_names())

// functions and procedures, which have no order or equality
procedure incomparable(in v: Val) :=
  match v
    case VProc(_) =>
      raise CompareProcedures

    case VProcClos(_, _, _, _, _) =>
      raise CompareProcedures

    case VLit(_) =>
      skip

    case VObj(_, _) =>
      skip

    case VArr(_) =>
      skip

    case _ =>
      raise CompareFunctions
  end

function is_true(v: Val): Bool :=
  v == VBool(true)

function is_code_point(num: Int): Bool :=
  0 <= num and num <= 1114111 and not (55296 <= num and num <= 57343)

function str_values(vs: List[Val]): List[Str] :=
  match vs
    case List(VStr(text); rest) =>
      List(text; str_values(rest))
    case _ =>
      List()
  end

function char_values(vs: List[Val]): List[Char] :=
  match vs
    case List(VChar(char); rest) =>
      List(char; char_values(rest))
    case _ =>
      List()
  end

function bind_all(xs: List[Var], vs: List[Val], env: Bindings): Bindings :=
  match (xs, vs)
    case (List(x; xs_), List(v; vs_)) =>
      bind_all(xs_, vs_, put(x.name, v, env))
    case _ =>
      env
  end

// env where the variables of p have the parts of v that they match, if p matches v
function match_into(pat: Pat, v: Val, env: Bindings): Option[Bindings] :=
  match (pat, v)
    case (PWild, _) =>
      Some(env)

    case (PLit(lit), _) =>
      if v == VLit(lit) then Some(env) else None

    case (PName(name, _), _) =>
      Some(put(name, v, env))

    case (PApp(c, pats), VObj(d, args)) =>
      if c == d then match_all_into(pats, args, env) else None

    case (PApp(_, _), _) =>
      None

    case (PTuple(pats), VTuple(args)) =>
      match_all_into(pats, args, env)

    case (PTuple(_), _) =>
      None
  end

function match_all_into(pats: List[Pat], vs: List[Val], env: Bindings): Option[Bindings] :=
  match (pats, vs)
    case (List(), List()) =>
      Some(env)

    case (List(p; ps_), List(v; vs_)) =>
      match match_into(p, v, env)
        case Some(inner) =>
          match_all_into(ps_, vs_, inner)
        case None =>
          None
      end

    case _ =>
      None
  end

procedure evaluate(
  in  run: Run,
      env: Bindings,
      expr: Expr,
  out v: Val,
  ref cache: Map[Name, Val]
) :=
  match expr
    case ELit(lit) =>
      assign v := VLit(lit)

    case EName(name, typ) =>
      call variable_value(in run, env, name, typ, out v)

    case EApp(fun, args) =>
      call apply_expr(in run, env, fun, args, out v, ref cache)

    case EField(_, field) =>
      raise UnresolvedField(field)

    case EUpdate(_, field, _) =>
      raise UnresolvedField(field)

    case EForm(form, _, _) =>
      raise UntranslatedForm(form_name(form))

    case EFor(form, _, _, _) =>
      raise UntranslatedForm(form_name(form))

    case ELam(formals, body) =>
      assign v := VFunClos(env, formals, body)

    case EProc(ins, outs, refs, stmt) =>
      assign v := VProcClos(env, ins, outs, refs, stmt)

    // the patterns are bound in parallel, and match, since they are irrefutable
    case ELet(bindings, body) =>
      local vs: List[Val]
      call evaluate_all(in run, env, seconds(bindings), out vs, ref cache)
      match match_all_into(firsts(bindings), vs, env)
        case Some(inner) =>
          call evaluate(in run, inner, body, out v, ref cache)
        case None =>
          raise Unexpected("let whose patterns do not match")
      end

    case EIte(cond, then_expr, else_expr) =>
      local w: Val
      call evaluate(in run, env, cond, out w, ref cache)
      if is_true(w) then
        call evaluate(in run, env, then_expr, out v, ref cache)
      else
        call evaluate(in run, env, else_expr, out v, ref cache)
      end

    case EMatch(arg, cases) =>
      local w: Val, sel: Option[Expr * Bindings * List[Name]], s: Str
      call evaluate(in run, env, arg, out w, ref cache)
      call select(in run, env, w, cases, out sel, ref cache)
      match sel
        case Some((body, inner, _)) =>
          call evaluate(in run, inner, body, out v, ref cache)

        case None =>
          call show_in(in run, w, out s, ref cache)
          raise NoCase(s)
      end

    // tuples are objects of the constructor ,
    case ETuple(args) =>
      local vs: List[Val]
      call   evaluate_all(in run, env, args, out vs, ref cache)
      assign v := VTuple(vs)
  end

procedure evaluate_all(
  in  run: Run,
      env: Bindings,
      exprs: List[Expr],
  out vs: List[Val],
  ref cache: Map[Name, Val]
) :=
  local v: Val
  assign vs := List()
  for e in exprs do
    call   evaluate(in run, env, e, out v, ref cache)
    assign vs := vs ++ List(v)
  end

// unqualified names are local variables or builtins without a module, since the checker qualifies the names of declarations
procedure variable_value(
  in  run: Run,
      env: Bindings,
      n: Name,
      t: Type,
  out v: Val
) :=
  match (get(n, env), n.module)
    case (Some(w), _) =>
      assign v := w

    case (None, None) =>
      if is_builtin(n) then
        assign v := VPrim(n)
      else
        raise Uninitialized(n)
      end

    case (None, Some(_)) =>
      match get((n, arity(t)), run.defs.funs)
        case Some(_) =>
          assign v := VFun(n, arity(t))

        case None if contains((n, arity(t)), run.defs.fields) =>
          assign v := VFun(n, arity(t))

        case None =>
          match get(n, run.defs.constrs)
            case Some(constr) =>
              assign v := if constr.arity == 0 then VObj(n, List()) else VCon(n)

            case None if contains(n, run.defs.procs) =>
              assign v := VProc(n)

            case None if is_builtin(n) =>
              assign v := VPrim(n)

            case None =>
              raise Uninitialized(n)
          end
      end
  end

// and, or are not strict and therefore not builtins
procedure apply_expr(
  in  run: Run,
      env: Bindings,
      f: Expr,
      args: List[Expr],
  out v: Val,
  ref cache: Map[Name, Val]
) :=
  match (f, args)
    case (EName(Name(None, "and"), _), List(l, r)) =>
      local a: Val
      call evaluate(in run, env, l, out a, ref cache)
      if is_true(a) then
        call evaluate(in run, env, r, out v, ref cache)
      else
        assign v := a
      end

    case (EName(Name(None, "or"), _), List(l, r)) =>
      local a: Val
      call evaluate(in run, env, l, out a, ref cache)
      if is_true(a) then
        assign v := a
      else
        call evaluate(in run, env, r, out v, ref cache)
      end

    case _ =>
      local g: Val, vs: List[Val]
      call evaluate(in run, env, f, out g, ref cache)
      call evaluate_all(in run, env, args, out vs, ref cache)
      call apply_value(in run, g, vs, out v, ref cache)
  end

procedure apply_value(
  in  run: Run,
      f: Val,
      vs: List[Val],
  out v: Val,
  ref cache: Map[Name, Val]
) :=
  match f
    case VFunClos(env, formals, body) =>
      call evaluate(in run, bind_all(formals, vs, env), body, out v, ref cache)

    case VFun(name, arity) =>
      match get((name, arity), run.defs.funs)
        case Some(fun) =>
          if fun.formals == List() then
            call cached(in run, name, fun.body, out v, ref cache)
          else
            call evaluate(in run, bind_all(fun.formals, vs, empty()), fun.body, out v, ref cache)
          end

        case None =>
          match get((name, arity), run.defs.fields)
            case Some(ps) =>
              call field_value(in run, name, ps, vs, out v)
            case None =>
              raise Uninitialized(name)
          end
      end

    case VCon(constr) =>
      assign v := VObj(constr, vs)

    case VPrim(name) =>
      local k: Int, r: Bool, s: Str
      match (format_name(name), vs)
        case ("compare", List(a, b)) =>
          call   compare_values(in run, a, b, out k, ref cache)
          assign v := VInt(k)

        case ("==", List(a, b)) =>
          call   equal(in run, a, b, out r, ref cache)
          assign v := VBool(r)

        case ("show", List(a)) =>
          call   show_in(in run, a, out s, ref cache)
          assign v := VStr(s)

        case ("<", List(VInt(a), VInt(b))) =>
          assign v := VBool(a < b)

        case ("<", List(a, b)) =>
          call   compare_values(in run, a, b, out k, ref cache)
          assign v := VBool(k < 0)

        case ("prelude/array.foldr", List(VArr(values), acc, g)) =>
          assign k := size(values), v := acc
          while k > 0 do
            assign k := k - 1
            call   apply_value(in run, g, List(at(k, values), v), out v, ref cache)
          end

        case ("prelude/array.foldl", List(VArr(values), acc, g)) =>
          assign k := 0, v := acc
          while k < size(values) do
            call   apply_value(in run, g, List(v, at(k, values)), out v, ref cache)
            assign k := k + 1
          end

        case _ =>
          call primitive(in name, vs, out v)
      end

    case _ =>
      raise NotFunction(format_value(f))
  end

// the value of a function without parameters, which is computed once, since expressions are deterministic,
// where run.computing are the functions whose values are being computed, which detects a value that needs itself,
// and which an exception leaves, unlike the cache, such that the next call computes the value again
procedure cached(
  in  run: Run,
      n: Name,
      body: Expr,
  out v: Val,
  ref cache: Map[Name, Val]
) :=
  match get(n, cache)
    case Some(w) =>
      assign v := w

    case None if contains(n, run.computing) =>
      raise RecursiveInitialization(format_name(n))

    case None =>
      call   evaluate(in run with computing := List(n; run.computing), empty(), body, out v, ref cache)
      assign cache := put(n, v, cache)
  end

// the field of the accessor or the updater name of an object, at its position in each constructor, ps, or else
// MissingField, where an updater copies the object with the new value of the field
procedure field_value(
  in  run: Run,
      name: Name,
      ps: List[Int],
      vs: List[Val],
  out v: Val
) :=
  match vs
    case List(VObj(k, args); rest) =>
      local p: Int := at(position_of(run, k), from_list(ps))
      if p < 0 then
        raise failure(missing_field_name(), List(VStr(field_of(name))))
      end
      match rest
        case List(y) =>
          assign v := VObj(k, take(p, args) ++ List(y; drop(p + 1, args)))
        case _ =>
          assign v := at(p, from_list(args))
      end

    case _ =>
      raise Unspecified(name, List(for w in vs yield format_value(w)))
  end

// an exception of a builtin, of a type of the prelude
function failure(n: Name, args: List[Val]): Thrown :=
  Thrown(VObj(n, args), TSort(n, List()))

procedure primitive(in n: Name, vs: List[Val], out v: Val) :=
  match (format_name(n), vs)
    case ("prelude/prelude.+", List(VInt(a), VInt(b))) =>
      assign v := VInt(a + b)

    case ("prelude/prelude.-", List(VInt(a), VInt(b))) =>
      assign v := VInt(a - b)

    case ("prelude/prelude.*", List(VInt(a), VInt(b))) =>
      assign v := VInt(a * b)

    case ("prelude/prelude./", List(VInt(_), VInt(0))) =>
      raise failure(division_by_zero_name(), List())

    case ("prelude/prelude./", List(VInt(a), VInt(b))) =>
      assign v := VInt(a / b)

    case ("prelude/prelude.%", List(VInt(_), VInt(0))) =>
      raise failure(division_by_zero_name(), List())

    case ("prelude/prelude.%", List(VInt(a), VInt(b))) =>
      assign v := VInt(a % b)

    case ("prelude/str.chars", List(VStr(text))) =>
      assign v := list_value(List(for c in chars(text) yield VChar(c)))

    case ("prelude/str.str", List(w)) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := VStr(str(char_values(ws)))
        case _ =>
          raise NotList(format_value(w))
      end

    case ("prelude/str.ord", List(VChar(char))) =>
      assign v := VInt(ord(char))

    case ("prelude/str.chr", List(VInt(num))) =>
      if not is_code_point(num) then
        raise failure(no_character_name(), List(VInt(num)))
      end
      assign v := VChar(chr(num))

    case ("prelude/prelude.++", List(VStr(s), VStr(t))) =>
      assign v := VStr(s ++ t)

    case ("prelude/str.size", List(VStr(text))) =>
      assign v := VInt(size(text))

    case ("prelude/str.join", List(VStr(text), w)) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := VStr(join(text, str_values(ws)))
        case _ =>
          raise NotList(format_value(w))
      end

    // from i up to but excluding j, where i <= j are indices of s or its end
    case ("prelude/str.slice", List(VStr(text), VInt(i), VInt(j))) =>
      if i < 0 or i > size(text) or i > j then
        raise failure(out_of_bounds_name(), List(VInt(i), VInt(size(text))))
      else
        if j > size(text) then
          raise failure(out_of_bounds_name(), List(VInt(j), VInt(size(text))))
        end
      end
      assign v := VStr(slice(text, i, j))

    case ("prelude/str.split", List(VStr(text), VChar(char))) =>
      assign v := list_value(List(for part in split(text, char) yield VStr(part)))

    case ("prelude/str.at", List(VInt(num), VStr(text))) =>
      if num < 0 or num >= size(text) then
        raise failure(out_of_bounds_name(), List(VInt(num), VInt(size(text))))
      end
      assign v := VChar(at(num, text))

    case ("prelude/str.contains", List(VChar(char), VStr(text))) =>
      assign v := VBool(contains(char, text))

    case ("prelude/str.quote", List(VStr(text))) =>
      assign v := VStr(quote(text))

    case ("prelude/str.number", List(VStr(text))) =>
      match number(text)
        case Some(k) =>
          assign v := VSome(VInt(k))
        case None =>
          assign v := VNone()
      end

    case ("prelude/str.is_digit", List(VChar(char))) =>
      assign v := VBool(is_digit(char))

    case ("prelude/str.is_letter", List(VChar(char))) =>
      assign v := VBool(is_letter(char))

    case ("prelude/str.is_space", List(VChar(char))) =>
      assign v := VBool(is_space(char))

    case ("prelude/array.from_list", List(w)) =>
      match list_elements(w)
        case Some(ws) =>
          assign v := VArr(Array(for x in ws))
        case _ =>
          raise NotList(format_value(w))
      end

    case ("prelude/array.size", List(VArr(values))) =>
      assign v := VInt(size(values))

    case ("prelude/array.at", List(VInt(num), VArr(values))) =>
      if num < 0 or num >= size(values) then
        raise failure(out_of_bounds_name(), List(VInt(num), VInt(size(values))))
      end
      assign v := at(num, values)

    case ("prelude/array.slice", List(VArr(values), VInt(i), VInt(j))) =>
      if i < 0 or i > size(values) or i > j then
        raise failure(out_of_bounds_name(), List(VInt(i), VInt(size(values))))
      else
        if j > size(values) then
          raise failure(out_of_bounds_name(), List(VInt(j), VInt(size(values))))
        end
      end
      assign v := VArr(slice(values, i, j))

    case _ =>
      raise Unspecified(n, List(for w in vs yield format_value(w)))
  end

// values of datatypes with declared equalities or orders are compared by them, and others structurally
procedure equal(
  in  run: Run,
      a: Val,
      b: Val,
  out r: Bool,
  ref cache: Map[Name, Val]
) :=
  call incomparable(in a)
  call incomparable(in b)
  match (a, b)
    case (VObj(c, xs), VObj(d, ys)) =>
      local v: Val, k: Int
      call unordered(in run, c, true)
      match (declared_for(run, c, run.defs.equalities), declared_for(run, c, run.defs.orders))
        case (Some(f), _) =>
          call   apply_value(in run, VFun(f, 2), List(a, b), out v, ref cache)
          assign r := is_true(v)

        case (None, Some(_)) =>
          call   compare_values(in run, a, b, out k, ref cache)
          assign r := k == 0

        case (None, None) =>
          if c == d and size(xs) == size(ys) then
            call equal_all(in run, xs, ys, out r, ref cache)
          else
            assign r := false
          end
      end

    case (VArr(xs), VArr(ys)) =>
      if size(xs) == size(ys) then
        call equal_all(in run, List(for x in xs), List(for x in ys), out r, ref cache)
      else
        assign r := false
      end

    case _ =>
      assign r := a == b
  end

// -1, 0, or 1 for values of the same type, by the declared orders of datatypes, or else structurally, where
// constructors are ordered by their declaration and then by their fields
procedure compare_values(
  in  run: Run,
      a: Val,
      b: Val,
  out r: Int,
  ref cache: Map[Name, Val]
) :=
  call incomparable(in a)
  call incomparable(in b)
  match (a, b)
    case (VInt(x), VInt(y)) =>
      assign r := order(x, y)

    case (VChar(x), VChar(y)) =>
      assign r := order(ord(x), ord(y))

    case (VBool(x), VBool(y)) =>
      assign r := order(if x then 1 else 0, if y then 1 else 0)

    case (VStr(x), VStr(y)) =>
      assign r := compare(x, y)

    case (VObj(c, xs), VObj(d, ys)) =>
      local v: Val
      call unordered(in run, c, false)
      match declared_for(run, c, run.defs.orders)
        case Some(f) =>
          call apply_value(in run, VFun(f, 2), List(a, b), out v, ref cache)
          match v
            case VInt(num) =>
              assign r := num
            case _ =>
              raise NotFunction(format_value(v))
          end

        case None =>
          if c == d then
            call compare_all(in run, xs, ys, out r, ref cache)
          else
            assign r := order(position_of(run, c), position_of(run, d))
          end
      end

    // arrays by their elements and then by their size, as lists
    case (VArr(xs), VArr(ys)) =>
      call compare_all(in run, List(for x in xs), List(for x in ys), out r, ref cache)

    case _ =>
      assign r := 0
  end

procedure compare_all(
  in  run: Run,
      xs: List[Val],
      ys: List[Val],
  out r: Int,
  ref cache: Map[Name, Val]
) :=
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) =>
      call compare_values(in run, x, y, out r, ref cache)
      if r == 0 then
        call compare_all(in run, xs_, ys_, out r, ref cache)
      end

    case _ =>
      assign r := order(size(xs), size(ys))
  end

// the text of a value as format_value gives it, where the values of datatypes with declared shows are shown by them,
// also inside other values, as lists, options, sets, and maps of the library are
procedure show_in(in run: Run, v: Val, out s: Str, ref cache: Map[Name, Val]) :=
  match v
    case VObj(constr, _) if declared_for(run, constr, run.defs.shows) != None =>
      local w: Val
      match declared_for(run, constr, run.defs.shows)
        case Some(f) =>
          call   apply_value(in run, VFun(f, 1), List(v), out w, ref cache)
          assign s := text_of(w)

        case None =>
          assign s := format_value(v)
      end

    case VTuple(args) =>
      local texts: List[Str]
      call   show_all(in run, args, out texts, ref cache)
      assign s := "(" ++ join(", ", texts) ++ ")"

    case VObj(constr, List()) =>
      assign s := constr.base

    case VObj(constr, args) =>
      local texts: List[Str]
      call   show_all(in run, args, out texts, ref cache)
      assign s := constr.base ++ "(" ++ join(", ", texts) ++ ")"

    case VArr(values) =>
      local texts: List[Str]
      call   show_all(in run, List(for x in values), out texts, ref cache)
      assign s := array_text(texts)

    case _ =>
      assign s := format_value(v)
  end

procedure show_all(
  in  run: Run,
      vs: List[Val],
  out texts: List[Str],
  ref cache: Map[Name, Val]
) :=
  local s: Str
  assign texts := List()
  for v in vs do
    call   show_in(in run, v, out s, ref cache)
    assign texts := texts ++ List(s)
  end

function order(x: Int, y: Int): Int :=
  if x < y then -1 else if y < x then 1 else 0

procedure equal_all(
  in  run: Run,
      xs: List[Val],
      ys: List[Val],
  out r: Bool,
  ref cache: Map[Name, Val]
) :=
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) =>
      call equal(in run, x, y, out r, ref cache)
      if r then
        call equal_all(in run, xs_, ys_, out r, ref cache)
      end

    case _ =>
      assign r := true
  end

// x updates the values of the variables in scope
procedure exec(
  in  run: Run,
      stmt: Stmt,
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  match stmt
    case SSkip =>
      skip

    // the variables are assigned in parallel
    case SAssign(upd) =>
      local vs: List[Val]
      call   evaluate_all(in run, env, seconds(upd), out vs, ref cache)
      assign env := env ++ Map(for (k, u) in zip(List(for x in firsts(upd) yield x.name), vs))

    case SBlock(locals, stmts) =>
      call scoped(in run, List(for x in locals yield x.name), env -- Set(for x in locals yield x.name), stmts, ref env, cache)

    case SIf(cond, left, right) =>
      local v: Val
      call evaluate(in run, env, cond, out v, ref cache)
      if is_true(v) then
        call exec(in run, left, ref env, cache)
      else
        call exec(in run, right, ref env, cache)
      end

    case SWhile(cond, body) =>
      local v: Val
      call evaluate(in run, env, cond, out v, ref cache)
      while is_true(v) do
        call exec(in run, body, ref env, cache)
        call evaluate(in run, env, cond, out v, ref cache)
      end

    // a variable of a procedure type hides the procedures of that name
    case SCall(proc, ins, outs, refs) =>
      local vs: List[Val]
      call evaluate_all(in run, env, ins, out vs, ref cache)
      match get(proc, env)
        case Some(f) =>
          call invoke_value(in run, f, vs, List(for x in refs yield x.name), out vs, ref env, cache)
        case None =>
          call invoke(in run, proc, vs, List(for x in refs yield x.name), out vs, ref env, cache)
      end
      assign env := env ++ Map(for (k, u) in zip(List(for x in outs yield x.name), vs))

    case SMatch(arg, cases) =>
      local v: Val, sel: Option[Stmt * Bindings * List[Name]], s: Str
      call evaluate(in run, env, arg, out v, ref cache)
      call select(in run, env, v, cases, out sel, ref cache)
      match sel
        case Some((body, inner, ns)) =>
          call scoped(in run, ns, inner, List(body), ref env, cache)

        case None =>
          call show_in(in run, v, out s, ref cache)
          raise NoCase(s)
      end

    // assertions of equations show both sides when they fail
    case SAssert(ECall(Name(None, "=="), _, List(lhs, rhs))) =>
      local v: Val, w: Val, r: Bool, s: Str, t: Str
      call evaluate(in run, env, lhs, out v, ref cache)
      call evaluate(in run, env, rhs, out w, ref cache)
      call equal(in run, v, w, out r, ref cache)
      if not r then
        call show_in(in run, v, out s, ref cache)
        call show_in(in run, w, out t, ref cache)
        raise AssertionUnequal(s, t)
      end

    case SAssert(cond) =>
      local v: Val
      call evaluate(in run, env, cond, out v, ref cache)
      if not is_true(v) then
        raise AssertionFailed
      end

    // an exception that the pattern does not match raises again, from handle
    case SAssertRaises(typ, pat, body) =>
      local inner := env, raised := false
      try
        call exec(in run, body, ref inner, cache)
      catch
        case Thrown(value, t) =>
          call   handle(in run, List(Catch("", typ, pat, None, SSkip)), value, t, ref inner, cache)
          assign raised := true
      end
      if not raised then
        raise AssertionNotRaised(format_pat(pat))
      end

    case SRaise(value, typ) =>
      local v: Val
      call evaluate(in run, env, value, out v, ref cache)
      raise Thrown(v, typ)

    case STry(body, catches) =>
      try
        call exec(in run, body, ref env, cache)
      catch
        case Thrown(value, typ) =>
          call handle(in run, catches, value, typ, ref env, cache)
      end
  end

procedure exec_all(
  in  run: Run,
      xs: List[Stmt],
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  for x in xs do
    call exec(in run, x, ref env, cache)
  end

// runs the statements xs from inner in the scope of the variables names, whose values inner gives,
// where the variables of the same names outside the scope get their values back afterwards, also after an exception
procedure scoped(
  in  run: Run,
      names: List[Name],
      inner: Bindings,
      xs: List[Stmt],
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  local outer := env
  assign env := inner
  try
    call exec_all(in run, xs, ref env, cache)
  catch
    case Thrown(value, typ) =>
      assign env := restored(names, outer, env)
      raise Thrown(value, typ)
  end
  assign env := restored(names, outer, env)

// env where the variables names have their values in outer, or none
function restored(names: List[Name], outer: Bindings, env: Bindings): Bindings :=
  match names
    case List() =>
      env

    case List(n; rest) =>
      match get(n, outer)
        case Some(v) =>
          restored(rest, outer, put(n, v, env))
        case None =>
          restored(rest, outer, remove(n, env))
      end
  end

// the first case whose pattern matches v and whose guard holds, with env and the variables that the pattern binds
procedure select[A](
  in  run: Run,
      env: Bindings,
      v: Val,
      cases: List[Branch[A]],
  out sel: Option[A * Bindings * List[Name]],
  ref cache: Map[Name, Val]
) :=
  match cases
    case List() =>
      assign sel := None

    case List(Branch(_, pat, guard, body); rest) =>
      local ok: Bool
      match match_into(pat, v, env)
        case Some(inner) =>
          call holds(in run, inner, guard, out ok, ref cache)
          if ok then
            assign sel := Some((body, inner, pattern_names(pat)))
          else
            call select(in run, env, v, rest, out sel, ref cache)
          end

        case None =>
          call select(in run, env, v, rest, out sel, ref cache)
      end
  end

procedure holds(
  in  run: Run,
      env: Bindings,
      g: Option[Expr],
  out ok: Bool,
  ref cache: Map[Name, Val]
) :=
  match g
    case Some(e) =>
      local w: Val
      call   evaluate(in run, env, e, out w, ref cache)
      assign ok := is_true(w)

    case None =>
      assign ok := true
  end

// the first handler of v of type t whose guard holds, where _ handles exceptions of any type, or else raises v again
procedure handle(
  in  run: Run,
      hs: List[Catch],
      v: Val,
      t: Type,
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  match hs
    case List() =>
      raise Thrown(v, t)

    case List(Catch(_, _, PWild, guard, body); rest) =>
      local ok: Bool
      call holds(in run, env, guard, out ok, ref cache)
      if ok then
        call exec(in run, body, ref env, cache)
      else
        call handle(in run, rest, v, t, ref env, cache)
      end

    // the type is compared first, since the pattern and the guard assume it
    case List(Catch(_, typ, pat, guard, body); rest) =>
      local ok: Bool := false
      if typ == t then
        match match_into(pat, v, env)
          case Some(inner) =>
            call holds(in run, inner, guard, out ok, ref cache)
            if ok then
              call scoped(in run, pattern_names(pat), inner, List(body), ref env, cache)
            end

          case _ =>
            skip
        end
      end
      if not ok then
        call handle(in run, rest, v, t, ref env, cache)
      end
  end

// calls the procedure n with the values ins of its ins, where the variables refs of the caller in env are its refs,
// which get their values back when it returns, and the values outs of its outs
procedure invoke(
  in  run: Run,
      n: Name,
      ins: List[Val],
      refs: List[Name],
  out outs: List[Val],
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  match get(n, run.defs.procs)
    case Some(proc) =>
      call run_body(in run, n, empty(), proc.ins, proc.outs, proc.refs, proc.stmt, ins, refs, out outs, ref env, cache)

    case None if format_name(n) == "prelude/os.os_print" =>
      assign outs := List()
      call   print_all(in List(for v in ins yield text_of(v)))

    case None if format_name(n) == "prelude/os.os_args" =>
      assign outs := List(list_value(List(for a in run.args yield VStr(a))))

    case None =>
      call os_proc(in n, ins, out outs)
  end

// a lambda sees the values of the variables around it, which the checker does not let it assign
procedure invoke_value(
  in  run: Run,
      f: Val,
      ins: List[Val],
      refs: List[Name],
  out outs: List[Val],
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  match f
    case VProc(name) =>
      call invoke(in run, name, ins, refs, out outs, ref env, cache)

    case VProcClos(around, xs, ys, zs, stmt) =>
      call run_body(in run, unqualified("lambda"), around, xs, ys, zs, stmt, ins, refs, out outs, ref env, cache)

    case _ =>
      raise NotProc(format_value(f))
  end

// the body of procedure n with the ins xs, outs ys, and refs zs, whose variables start from around,
// where the caller gets the outs and refs only when the body returns, so that an exception leaves its variables as they were
procedure run_body(
  in  run: Run,
      n: Name,
      around: Bindings,
      xs: List[Var],
      ys: List[Var],
      zs: List[Var],
      body: Stmt,
      ins: List[Val],
      refs: List[Name],
  out outs: List[Val],
  ref env: Bindings,
      cache: Map[Name, Val]
) :=
  local inner := bind_all(xs, ins, (around -- Set(for x in ys ++ zs yield x.name)) ++ Map(for (k, v) in values_in(zip(List(for x in zs yield x.name), refs), env)))
  call   exec(in run, body, ref inner, cache)
  call   read_outs(in n, List(for x in ys yield x.name), inner, out outs)
  assign env := env ++ Map(for (k, v) in values_in(zip(refs, List(for x in zs yield x.name)), inner))

// the pairs of the names a and the values of the names b in env, for those that have values
function values_in(ps: List[Name * Name], env: Bindings): List[Name * Val] :=
  match ps
    case List() =>
      List()

    case List((a, b); rest) =>
      match get(b, env)
        case Some(v) =>
          List((a, v); values_in(rest, env))
        case None =>
          values_in(rest, env)
      end
  end

// the values of the outs of procedure p, which must be assigned
procedure read_outs(
  in  p: Name,
      ys: List[Name],
      env: Bindings,
  out vs: List[Val]
) :=
  assign vs := List()
  for y in ys do
    match get(y, env)
      case Some(v) =>
        assign vs := vs ++ List(v)
      case None =>
        raise UnassignedOutput(y, p)
    end
  end

procedure print_all(in lines: List[Str]) :=
  for line in lines do
    call os_print(in line)
  end

// the procedures of the library os are those of the interpreter of this program, whose OsError the program can catch
procedure os_proc(in n: Name, ins: List[Val], out outs: List[Val]) :=
  try
    match (format_name(n), ins)
      case ("prelude/os.os_read", List(VStr(path))) =>
        local text: Str
        call   os_read(in path, out text)
        assign outs := List(VStr(text))

      case ("prelude/os.os_write", List(VStr(path), VStr(t))) =>
        call   os_write(in path, t)
        assign outs := List()

      case ("prelude/os.os_library", List(VStr(name))) =>
        local text: Str
        call   os_library(in name, out text)
        assign outs := List(VStr(text))

      case ("prelude/os.os_list", List(VStr(path))) =>
        local entries: List[Str * Bool]
        call   os_list(in path, out entries)
        assign outs := List(list_value(entry_values(entries)))

      case ("prelude/os.os_is_dir", List(VStr(path))) =>
        local yes: Bool
        call   os_is_dir(in path, out yes)
        assign outs := List(VBool(yes))

      case ("prelude/os.os_cwd", List()) =>
        local text: Str
        call   os_cwd(out text)
        assign outs := List(VStr(text))

      case ("prelude/os.os_chdir", List(VStr(path))) =>
        call   os_chdir(in path)
        assign outs := List()

      case ("prelude/os.os_print_error", List(VStr(msg))) =>
        call   os_print_error(in msg)
        assign outs := List()

      case ("prelude/os.os_exit", List(VInt(num))) =>
        call   os_exit(in num)
        assign outs := List()

      case _ =>
        raise UnknownProc(n)
    end
  catch
    case OsError(message) =>
      raise Thrown(VOsError(message), TSort(os_error_name(), List()))
  end

// the entries of a directory as values of the program
function entry_values(entries: List[Str * Bool]): List[Val] :=
  List(for (name, dir) in entries yield VTuple(List(VStr(name), VBool(dir))))

procedure constant_of(in run: Run, n: Name, out v: Option[Val]) :=
  local cache: Map[Name, Val] := empty(), value: Val
  match get((n, 0), run.defs.funs)
    case Some(fun) =>
      call   cached(in run, n, fun.body, out value, ref cache)
      assign v := Some(value)

    case None =>
      assign v := None
  end

// calls the procedure n without parameters
procedure run_proc(in run: Run, n: Name, ref cache: Map[Name, Val]) :=
  local env: Bindings := empty(), outs: List[Val]
  try
    call invoke(in run, n, List(), List(), out outs, ref env, cache)
  catch
    case Thrown(value, _) =>
      call uncaught(in run, value, ref cache)
  end

procedure run_cmd(in run: Run, cmd: Cmd, ref cache: Map[Name, Val]) :=
  local env: Bindings := empty()
  try
    match cmd
      case CTest(_, _, stmt) =>
        call exec(in run, stmt, ref env, cache)
      case _ =>
        skip
    end
  catch
    case Thrown(value, _) =>
      call uncaught(in run, value, ref cache)
  end

// an exception of the program that no handler catches, as the error with its text
procedure uncaught(in run: Run, v: Val, ref cache: Map[Name, Val]) :=
  local s: Str
  call show_in(in run, v, out s, ref cache)
  raise Uncaught(s)

procedure run_all(in run: Run, cmds: List[Cmd], ref cache: Map[Name, Val]) :=
  for c in cmds do
    call run_cmd(in run, c, ref cache)
  end

procedure run_program(in q: Prog) :=
  local cache: Map[Name, Val] := empty()
  call run_all(in load(q), q.cmds, ref cache)

// checks the commands, after len of a module that imports lists, and runs their tests
procedure check_and_run(in cmds: List[Cmd]) :=
  local q: Prog
  call check_program(in with_lists(cmds), out q)
  call run_program(in q)

// the test n that asserts that expr equals expected
function asserting(n: Id, expr: Expr, expected: Expr): Cmd :=
  CTest(unqualified(n), List(), SBlock(List(), List(SAssert(expr_app("==", List(expr, expected))))))

// a test that assigns expr to a local variable
function assigning(expr: Expr): Cmd :=
  CTest(unqualified("a"), List(), SBlock(List(hole_var("v")), List(SAssign(List((hole_var("v"), expr))))))

test values() :=
  assert format_value(list_value(List(VInt(1), VStr("a\"b")))) == "List(1, \"a\\\"b\")"
  assert format_value(VTuple(List(VChar('\''), VNil(), VObj(unqualified("Some"), List(VBool(true)))))) == "('\\'', List(), Some(true))"

test expressions() :=
  call check_and_run(in List(
    asserting("p1", expr_app("len", List(
      expr_app("Cons", List(expr_int(1), expr_app("Cons", List(expr_int(2), expr_var("Nil"))))))), expr_int(2)),
    asserting("p2", ELet(List(
      (PVar(Var(unqualified("f"), THole)), ELam(List(Var(unqualified("x"), THole)), expr_app("*", List(expr_var("x"), expr_var("x")))))), expr_app("+", List(expr_app("f", List(expr_int(3))), expr_app("f", List(expr_int(4)))))), expr_int(25)),
    asserting("p4", expr_app("and", List(
      ELit(LBool(false)),
      expr_app("==", List(expr_app("/", List(expr_int(1), expr_int(0))), expr_int(0))))), ELit(LBool(false)))))

// procedure sum(in n: Int, out s: Int) with a loop, and procedure size(ref k: Int) raising Fail after an increment
function procedures(): List[Cmd] :=
  List(
    CData(unqualified("Fail"), List(), List(Constr("", unqualified("Fail"), List(Field("code", TInt()))))),
    CProc(unqualified("sum"), List(), List(Var(unqualified("n"), TInt())), List(Var(unqualified("s"), TInt())), List(), SBlock(List(Var(unqualified("i"), TInt())), List(
      SAssign(List(
        (Var(unqualified("s"), THole), expr_int(0)),
        (Var(unqualified("i"), THole), expr_int(0)))),
      SWhile(expr_app("<", List(expr_var("i"), expr_var("n"))), SBlock(List(), List(
        SAssign(List(
          (Var(unqualified("i"), THole), expr_app("+", List(expr_var("i"), expr_int(1)))),
          (Var(unqualified("s"), THole), expr_app("+", List(expr_var("s"), expr_app("+", List(expr_var("i"), expr_int(1)))))))))))))),
    CProc(unqualified("count"), List(), List(), List(), List(Var(unqualified("k"), TInt())), SBlock(List(), List(
      SAssign(List(
        (Var(unqualified("k"), THole), expr_app("+", List(expr_var("k"), expr_int(1)))))),
      SRaise(expr_app("Fail", List(expr_var("k"))), THole)))))

test procedures() :=
  call check_and_run(in procedures() ++ List(
    CTest(unqualified("sum"), List(), SBlock(List(Var(unqualified("s"), TInt())), List(
      SCall(unqualified("sum"), List(expr_int(4)), List(Var(unqualified("s"), THole)), List()),
      equals("s", 10)))),
    CTest(unqualified("count"), List(), SBlock(List(Var(unqualified("k"), TInt()), Var(unqualified("m"), TInt())), List(
      SAssign(List(
        (Var(unqualified("k"), THole), expr_int(1)),
        (Var(unqualified("m"), THole), expr_int(0)))),
      STry(SBlock(List(), List(
        SCall(unqualified("count"), List(), List(), List(Var(unqualified("k"), THole))))), List(
        Catch("", THole, PApp(unqualified("Fail"), List(pat_var("j"))), None, SBlock(List(), List(SAssign(List((Var(unqualified("m"), THole), expr_var("j"))))))))),
      equals("k", 1),
      equals("m", 2))))))

// a declared procedure and a lambda that captures k, called through variables
test procedure_values() :=
  call check_and_run(in procedures() ++ List(
    CTest(unqualified("values"), List(), SBlock(List(Var(unqualified("s"), TInt()), Var(unqualified("t"), TInt())), List(
      SBlock(List(hole_var("f"), hole_var("k"), hole_var("g")), List(
        SAssign(List((hole_var("f"), expr_var("sum")))),
        SAssign(List((hole_var("k"), expr_int(10)))),
        SAssign(List(
          (hole_var("g"), EProc(List(hole_var("n")), List(hole_var("r")), List(), SBlock(List(), List(
            SAssign(List(
              (hole_var("r"), expr_app("+", List(expr_var("n"), expr_var("k")))))))))))),
        SCall(unqualified("f"), List(expr_int(4)), List(hole_var("s")), List()),
        SCall(unqualified("g"), List(expr_int(4)), List(hole_var("t")), List()))),
      equals("s", 10),
      equals("t", 14))))))

function hole_var(n: Id): Var :=
  Var(unqualified(n), THole)

// the assertion that the variable n equals k
function equals(n: Id, k: Int): Stmt :=
  SAssert(expr_app("==", List(expr_var(n), expr_int(k))))

test errors() :=
  assert raises Uncaught("Fail(1)") do
    call check_and_run(in procedures() ++ List(
      CTest(unqualified("t"), List(), SBlock(List(), List(SRaise(expr_app("Fail", List(expr_int(1))), THole))))))
  end
  assert raises AssertionUnequal("1", "2") do
    call check_and_run(in List(
      CTest(unqualified("t"), List(), SBlock(List(), List(SAssert(expr_app("==", List(expr_int(1), expr_int(2)))))))))
  end
  assert raises Uncaught("DivisionByZero") do
    call check_and_run(in List(assigning(expr_app("/", List(expr_int(1), expr_int(0))))))
  end
  assert raises RecursiveInitialization("main.loop") do
    call check_and_run(in List(
      CFun(unqualified("loop"), List(), List(), TInt(), expr_app("+", List(expr_app("loop", List()), expr_int(1)))),
      assigning(expr_app("loop", List()))))
  end

// match (1, true, 3) case (_, _, z) => z end, a flat tuple
test tuples() :=
  call check_and_run(in List(
    asserting("p", EMatch(ETuple(List(expr_int(1), ELit(LBool(true)), expr_int(3))), List(
      Branch("", PTuple(List(PWild, PWild, pat_var("z"))), None, expr_var("z")))), expr_int(3))))

// a handler for integers skips a string without evaluating its guard, so the string is raised further
test handler_types() :=
  assert raises Uncaught("\"x\"") do
    call check_and_run(in List(
      CTest(unqualified("t"), List(), STry(SRaise(ELit(LStr("x")), THole), List(
        Catch("", THole, pat_var("k"), Some(expr_app("<", List(expr_var("k"), expr_int(2)))), SSkip))))))
  end
