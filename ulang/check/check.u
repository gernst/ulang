// the type checker of ulang, which checks and elaborates programs of ulang/syntax/syntax.u in signatures of ulang/check/sig.u,
// where the state is passed by reference, and errors are values of TypeError instead of messages,
// and which overloads names across modules: the declarations of a name in all visible modules are its candidates,
// and each use resolves to the one whose type fits, at once if only one fits, or else at the end of the command,
// when the uses that are still open are solved together

import "ulang/syntax"

export

data TypeError :=
  case UnknownSort(name: Name)
  case SortArity(name: Name, expected: Int, actual: Int)
  case SortDefined(name: Name)
  case MissingType(name: Name)
  case UndeclaredParams(name: Name, types: List[Type])
  case CannotUnify(left: Type, right: Type)
  // the type found of a part, which what names, where the type expected is another
  case Mismatch(expected_type: Type, found_type: Type, what: Str)
  case InfiniteType(meta: Type, typ: Type)
  case UnknownVariable(name: Name)
  case NoOverload(name: Name, typ: Type)
  case WrongArity(name: Name, arity: Int)
  case AlreadyDefined(name: Name)
  case Duplicate(what: Str, item: Str)
  case Ambiguous(name: Name, candidates: List[Name * Scheme])
  case UnknownField(name: Name)
  case UnknownFieldType(field: Id, typ: Type)
  case UnknownFieldOwner(field: Id)
  // a container of a generator whose type, which chooses the folds, is not known at the generator
  case UnknownContainer(typ: Type)
  // a container of a generator whose type is of a module that declares no fold of three arguments, the one that the form
  // takes
  case NoFold(typ: Type, fold: Id)
  case CountMismatch(owner: Str, unit: Str, expected: Int, actual: Int)
  case UnknownConstructor(name: Name)
  case NotExhaustive(pat: Pat)
  case Unreachable(pat: Pat)
  case NotAssignable(name: Name)
  case UnknownProcedure(name: Name)
  // a use of a name that only a command declares that does not parse
  case UnparsedDeclaration(name: Name)
  // a call in a proof of a name that is no lemma of its module
  case UnknownLemma(name: Name)
  // induction on a name that is no formal of a datatype of the lemma
  case NotInducible(name: Name)
  case UnknownException(typ: Type)
  case Unassigned(name: Name)
  case OutputUnassigned(output: Name, proc: Name)
  case MissingDefinition(name: Name)
  case SignatureMismatch(name: Name)
  case PartlyExported(name: Name)
  case PrivateType(name: Name, sort: Name)
  // a formal, local, pattern variable, or formal of a lambda of the name of a local around it
  case HiddenLocal(name: Name)
  case VisibleEquality(sort: Name)
  // show, compare, or == of other values than those of a datatype of its module, see order_of of defs.u
  case MisshapenHook(name: Name, hook: Hook)
  case UnexportedOrder(fun: Name, sort: Name)
  // a pattern alias whose variables are not exactly its formals
  case AliasVariables(name: Name)
  // a pattern alias with _, which matches but builds no value
  case PatternOnly(name: Name)
  // a pattern of assert raises that binds the variable name
  case RaisesVariables(name: Name)
  // an exported pattern alias of a constructor that importers do not see
  case PrivateConstructor(name: Name, constr: Name)
  // examples on the definition of an exported function or procedure, which belong to its signature in export
  case ExampleOnDefinition(name: Name)
  // a contract on the definition of an exported procedure, which belongs to its signature in export
  case ContractOnDefinition(name: Name)
  // a claim correct p(…) of the lemma name whose outs are not the outs of the lemma in their order
  case ClaimOuts(name: Name)
  // a claim correct p(…) of a procedure that is not defined before it in its package, whose loops the invariants take
  case ClaimOrder(proc: Name)
  // a step of the proof of a claim correct p(…) of the lemma name other than an invariant
  case ClaimStep(name: Name)
  // an invariant in the proof of a lemma that is no claim correct p(…)
  case InvariantOutsideClaim
  // a call in a proof of the lemma name, which is a claim correct p(…), which holds only for runs that end
  case ClaimCalled(name: Name)
  // raise of a value, or raises of a type, that is not of a datatype without type parameters
  case NotAnException(typ: Type)
  // the procedure name raises typ, which its raises omit
  case UndeclaredRaise(name: Name, typ: Type)
  // the procedure value name, lambda for a lambda, raises typ, which its type omits, as the place of its use gives it
  case UntypedRaise(name: Name, typ: Type)
  // a handler, or the pattern of assert raises, of typ, which the body cannot raise
  case NeverRaised(typ: Type)
  // an error with the form to write instead, which the checker knows from the part, e.g. ++ for + of strings
  case Hinted(error: TypeError, hint: Str)
  // an error of the command at the position of an imported module, or of the main module for None
  case Located(module: Option[Id], pos: Pos, error: TypeError)

// raises the first error of check_all
procedure check_program(
  in  source: Source,
  out q: Prog
) raises TypeError, InternalError

// the checked program of source and its errors in the order of the commands, up to the first package that has errors,
// with the tests that generate makes of each package whose definitions check without errors
procedure check_all(
  in  source: Source,
      generate: Checked -> List[Pos * (Id * Cmd)],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError

// the errors that checking found in q, which holds them as the errors of its commands, in their order
function diagnostics(q: Prog): List[Diagnostic]

// whether checking found errors in q, without those of proofs, which the prover adds (with_proofs of ulang/prove/lemma.u)
function has_errors(q: Prog): Bool

// check_all of a source without its commands that do not parse, where a use of a name that one of them declares, of
// unparsed, is no unknown name but UnparsedDeclaration
procedure check_partial(
  in  source: Source,
      unparsed: Set[Id],
      generate: Checked -> List[Pos * (Id * Cmd)],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError

// what the generated tests of a package see of it once its definitions check without errors: its commands at their
// positions, as written, and checked, its abstract types, the signature with the private declarations of its members,
// which modules each module sees, and the private declarations, which the other members do not see
data Checked :=
  case Checked(placed: List[Pos * (Id * Cmd)], defined: List[Id * At[Cmd]], abstract: List[Name], sig: Sig, table: List[Id * List[Id]], hidden: Set[Name])

// whether the module m of the package c sees the declaration d
function is_seen(c: Checked, m: Id, d: Name): Bool

// the generator of no tests, for the commands that run none
function no_tests(c: Checked): List[Pos * (Id * Cmd)]

// whether the patterns pats, without guards, match every value of type t, as the cases of an exhaustive match do
function covers_all(sig: Sig, t: Type, pats: List[Pat]): Bool

implementation

function covers_all(sig: Sig, t: Type, pats: List[Pat]): Bool :=
  missing(sig, empty(), List(for p in pats yield List(p)), List(t)) == None

// the types of unknowns by their index
type Subst :=
  Map[Int, Type]

type Env :=
  List[Name * Local]

data Local :=
  case Local(typ: Type, assigned: Bool)

// a use of an overloaded name that more than one candidate fits, by the placeholder id that stands for it
data Pending :=
  case Pending(id: Name, name: Name, cands: List[Name * Scheme], typ: Type, pos: Pos)

// a part around the errors that are reported, which tells how they read
data Within :=
  // the elements of a form at places, whose mismatches are of an element of the form
  case InForm(form: Form, places: Set[Pos])
  // the arguments of a call of name, whose mismatches may have hints of name
  case InCall(name: Name)

// where hidden and hidden_sorts are the private declarations and sorts of the members of the package being checked, which
// the other members do not see, while sig has only the exports of the modules checked before, and unknown_sorts and
// loop_assigned are of the command being checked, the unknown types reported, each once, and the variables that the body
// of a while assigns which are not assigned before it, the latter of the procedure or procedure lambda being checked
data State :=
  case State(sig: Sig, sub: Subst, count: Int, module: Id, visible: List[Id], table: List[Id * List[Id]], pending: List[Pending], chosen: Map[Name, Name], hidden: Set[Name], hidden_sorts: Set[Name], at: Pos, errors: List[TypeError], unparsed: Set[Id], partial: Bool, within: List[Within], taken: Set[Int], loops: List[Pos * Env], scopes: Map[Name, List[Env]], unknown_sorts: Set[Name], loop_assigned: Set[Name])

// the constructor of a pattern, where literals count as constructors without arguments
data Head :=
  case HCon(constr: Name)
  case HLit(lit: Lit)

// the head of tuples, which have no module
pattern HTuple(): Head :=
  HCon(Name(None, ","))

function with_sig(s: State, sig: Sig): State :=
  s with sig := sig

// the state for checking a declaration of module m, where the substitution starts empty and unknowns are numbered
// from 1 again, since unknowns do not outlive the command that introduces them
function enter(s: State, m: Id): State :=
  s with sub := empty(), count := 0, module := m, visible := sees(m, s.table), pending := List(), chosen := empty(), at := Pos(0, 0), unknown_sorts := empty(), loop_assigned := empty()

function sees(m: Id, vs: List[Id * List[Id]]): List[Id] :=
  value_or(get(m, vs), List(m))

function start(main: Id, vs: List[Id * List[Id]]): State :=
  State(empty(), empty(), 0, main, sees(main, vs), vs, List(), empty(), empty(), empty(), Pos(0, 0), List(), empty(), false, List(), empty(), List(), empty(), empty(), empty())

function in_module(m: Id, n: Name): Name :=
  Name(Some(m), n.base)

function qualify(m: Id, cmd: Cmd): Cmd :=
  match cmd
    case CSort(name, params, typ) =>
      CSort(in_module(m, name), params, typ)

    case CData(name, params, constrs) =>
      CData(in_module(m, name), params, List(for k in constrs yield map_at(k, lambda c => qualify_constr(m, c))))

    case CFun(name, params, formals, typ, spec, body) =>
      CFun(in_module(m, name), params, formals, typ, spec, body)

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(in_module(m, name), params, ins, outs, refs, raised, spec, stmt)

    case CFunSig(name, params, formals, typ, spec) =>
      CFunSig(in_module(m, name), params, formals, typ, spec)

    case CProcSig(name, params, ins, outs, refs, raised, spec) =>
      CProcSig(in_module(m, name), params, ins, outs, refs, raised, spec)

    case CAbstract(name, params) =>
      CAbstract(in_module(m, name), params)

    case CPatAlias(name, params, formals, typ, pat) =>
      CPatAlias(in_module(m, name), params, formals, typ, pat)

    case CLemma(name, params, ins, outs, claim, proof) =>
      CLemma(in_module(m, name), params, ins, outs, claim, proof)

    case CNotation(_, _, _) =>
      cmd

    case CTest(name, vars, stmt) =>
      CTest(in_module(m, name), vars, stmt)
  end

function qualify_constr(m: Id, k: Constr): Constr :=
  k with name := in_module(m, k.name)

// each module sees itself and its direct imports, which include the implicit ones and the members of its package, for the
// imports of each module
function visibility(imports: List[Id * List[Id]], main: Id): List[Id * List[Id]] :=
  List(for m in distinct(List(main) ++ firsts(imports)) yield (m, distinct(List(m) ++ imports_of(imports, m))))

function imports_of(imports: List[Id * List[Id]], m: Id): List[Id] :=
  value_or(get(m, imports), List())

// the declarations named n of a kind that the module sees, where its own declarations hide those of other modules
// and declared tells whether a name is a declaration of that kind
function visible_names(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := List(for d in names_of(s.sig, n.base) if declared(d)) in
  match n
    case Name(Some(_), _) =>
      if contains(n, ds) then List(n) else List()

    case Name(None, base) =>
      if contains(Name(Some(s.module), base), ds) then
        List(Name(Some(s.module), base))
      else
        List(for d in ds if is_visible_sort(s, d))
  end

// the declarations named n of a kind in all modules that the module sees, its own included, whose types decide
// among them
function overloads(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  match n
    case Name(Some(_), _) =>
      List(for d in names_of(s.sig, n.base) if declared(d) and d == n)
    case _ =>
      List(for d in names_of(s.sig, n.base) if declared(d) and is_visible(s, d))
  end

// an unknown name n, with the visible name that it most likely means, of the library for names of other languages,
// else the nearest by edits, if few
function unknown_variable(s: State, n: Name): TypeError :=
  match get(n.base, foreign_names())
    case Some(meant) =>
      Hinted(UnknownVariable(n), "write " ++ meant)

    case None =>
      match nearest(n.base, List(for base => ds in s.sig.named if exists(ds, lambda d => is_visible(s, d)) yield base))
        case Some(meant) =>
          Hinted(UnknownVariable(n), "did you mean " ++ meant ++ "?")
        case None =>
          UnknownVariable(n)
      end
  end

// the names of other languages for the functions and procedures of the library
function foreign_names(): Map[Str, Str] :=
  Map(
    "length" => "size",
    "len" => "size",
    "count" => "size",
    "print" => "call os_println(in text)",
    "println" => "call os_println(in text)",
    "append" => "xs ++ ys",
    "concat" => "xs ++ ys",
    "toString" => "show",
    "to_string" => "show",
    "map" => "List(for x in xs yield f(x))",
    "filter" => "List(for x in xs if p(x))")

// the name of names nearest to x by edits, if at most a quarter of its characters differ, so none for short names
function nearest(x: Str, names: List[Str]): Option[Str] :=
  let scored := List(for name in names if name != x yield (distance(x, name), name)), limit := size(x) / 4 in
  foldl(scored, None, lambda best, (d, name) => if d <= limit and is_better(d, best, scored) then Some(name) else best)

function is_better(d: Int, best: Option[Str], scored: List[Int * Str]): Bool :=
  match best
    case Some(b) =>
      exists(scored, lambda (e, name) => name == b and d < e)
    case None =>
      true
  end

// the edit distance of a and b, by insertions, deletions, and replacements of characters
function distance(a: Str, b: Str): Int :=
  let bs := chars(b) in
  value_or(last(foldl(chars(a), List(for j in range(0, size(bs) + 1)), lambda row, c => edit_row(row, c, bs))), 0)

// the next row of the distances, of one more character c of the first string, from the row of the characters before it
function edit_row(prev: List[Int], c: Char, bs: List[Char]): List[Int] :=
  match prev
    case List(first; _) =>
      List(first + 1; edit_cells(prev, c, bs, first + 1))
    case List() =>
      List()
  end

function edit_cells(prev: List[Int], c: Char, bs: List[Char], left: Int): List[Int] :=
  match (prev, bs)
    case (List(diag, up; rest), List(b; more)) =>
      let cell := min(min(up + 1, left + 1), if b == c then diag else diag + 1) in
      List(cell; edit_cells(List(up; rest), c, more, cell))

    case _ =>
      List()
  end

// whether the module sees the declaration d, which is its own, or of a module that it sees and not private to it
function is_visible(s: State, d: Name): Bool :=
  match d.module
    case Some(m) =>
      m == s.module or contains(m, s.visible) and not contains(d, s.hidden)
    case None =>
      false
  end

function is_visible_sort(s: State, d: Name): Bool :=
  match d.module
    case Some(m) =>
      m == s.module or contains(m, s.visible) and not contains(d, s.hidden_sorts)
    case None =>
      false
  end

function params(ps: List[Id]): List[Type] :=
  List(for p in ps yield TParam(p))

function literal(v: Lit): Type :=
  match v
    case LUnit =>
      TTuple(List())

    case LBool(_) =>
      TBool()

    case LInt(_) =>
      TInt()

    case LHex(_) =>
      TInt()

    case LStr(_) =>
      TStr()

    case LChar(_) =>
      TChar()
  end

// the literal as the checked program has it, where a hexadecimal number is an LInt
function checked_lit(lit: Lit): Lit :=
  match lit
    case LHex(num) =>
      LInt(num)
    case _ =>
      lit
  end

function logic(): Scheme :=
  Scheme(List(), TFun(List(TBool(), TBool()), TBool()))

// only what cannot be defined in the prelude, which are names without a module
function builtin_schemes(n: Name): List[Scheme] :=
  match n
    case Name(None, base) =>
      builtin_scheme(base)
    case _ =>
      List()
  end

function builtin_scheme(b: Id): List[Scheme] :=
  let a := TParam("A") in
  match b
    case "<" =>
      List(Scheme(List(a), TFun(List(a, a), TBool())))

    case "and" =>
      List(logic())

    case "or" =>
      List(logic())

    case _ =>
      List(for hook in hooks() if hook_name(hook) == b yield hook_scheme(hook))
  end

// the Params and Metas in t
function free(t: Type): List[Type] :=
  match t
    case TParam(_) =>
      List(t)

    case TMeta(_) =>
      List(t)

    case THole =>
      List()

    case TError =>
      List()

    case TSort(_, args) =>
      distinct(List(for a in args for v in free(a) yield v))

    case TFun(args, res) =>
      distinct(List(for a in args ++ List(res) for v in free(a) yield v))

    case TProc(ins, outs, refs, raised) =>
      distinct(List(for a in ins ++ outs ++ refs ++ List(raised) for v in free(a) yield v))

    case TTuple(types) =>
      distinct(List(for a in types for v in free(a) yield v))
  end

function has_holes(t: Type): Bool :=
  match t
    case THole =>
      true

    case TSort(_, args) =>
      exists(args, has_holes)

    case TFun(args, res) =>
      exists(args, has_holes) or has_holes(res)

    case TProc(ins, outs, refs, raised) =>
      exists(ins ++ outs ++ refs ++ List(raised), has_holes)

    case TTuple(types) =>
      exists(types, has_holes)

    case _ =>
      false
  end

function subst(t: Type, m: List[Type * Type]): Type :=
  match t
    case TSort(name, args) =>
      TSort(name, List(for a in args yield subst(a, m)))

    case TFun(args, res) =>
      TFun(List(for a in args yield subst(a, m)), subst(res, m))

    case TProc(ins, outs, refs, raised) =>
      TProc(List(for a in ins yield subst(a, m)), List(for a in outs yield subst(a, m)), List(for a in refs yield subst(a, m)), subst(raised, m))

    case TTuple(types) =>
      TTuple(List(for a in types yield subst(a, m)))

    case _ =>
      value_or(get(t, m), t)
  end

function resolve(su: Subst, t: Type): Type :=
  match t
    case TMeta(meta) =>
      match get(meta, su)
        case Some(u) =>
          resolve(su, u)
        case None =>
          t
      end

    case _ =>
      t
  end

function occurs(su: Subst, i: Int, t: Type): Bool :=
  match resolve(su, t)
    case TMeta(meta) =>
      i == meta

    case TSort(_, args) =>
      exists(args, lambda a => occurs(su, i, a))

    case TFun(args, res) =>
      exists(args, lambda a => occurs(su, i, a)) or occurs(su, i, res)

    case TProc(ins, outs, refs, raised) =>
      exists(ins ++ outs ++ refs ++ List(raised), lambda a => occurs(su, i, a))

    case TTuple(types) =>
      exists(types, lambda a => occurs(su, i, a))

    case _ =>
      false
  end

function constructor_scheme(constr: ConstrSig): Scheme :=
  Scheme(constr.params, if constr.fields == List() then
    constr.typ
  else
    TFun(constr.fields, constr.typ))

function constructor_of(sig: Sig, k: Name): Scheme :=
  match constr_of(sig, k)
    case Some(constr) =>
      constructor_scheme(constr)
    case None =>
      Scheme(List(), TTuple(List()))
  end

// the meanings of n with their names, where local variables hide functions, constructors, and builtins, and declared hooks
// are no candidates, since the builtins reach them through the type of their arguments
function candidates(s: State, env: Env, n: Name): List[Name * Scheme] :=
  match get(n, env)
    case Some(l) =>
      List((n, Scheme(List(), l.typ)))
    case None =>
      List(for f in overloads(s, n, lambda f => is_fun(s.sig, f)) for sc in schemes_of(s.sig, f) if not is_hook(f, arity(sc.typ)) yield (f, sc)) ++ List(for k in overloads(s, n, lambda k => is_constr(s.sig, k)) yield (k, constructor_of(s.sig, k))) ++ List(for p in overloads(s, n, lambda p => is_proc(s.sig, p)) yield (p, proc_scheme(s.sig, p))) ++ List(for sc in builtin_schemes(n) yield (n, sc))
  end

// f with k arguments is the order, the equality, or the text of the values of a datatype, see order_of of defs.u
// constructors and pattern aliases, the names that patterns apply
function is_pattern_name(sig: Sig, n: Name): Bool :=
  is_constr(sig, n) or is_pat_alias(sig, n)

function is_hook(f: Name, k: Int): Bool :=
  hook_of(f.base, k) != None

// a procedure is a value of its type (in A, out B, ref C) raises …, whose raises are a parameter of their own, those of the
// place of its use, which must include those of the procedure (raises_errors of ulang/check/raises.u)
function proc_scheme(sig: Sig, p: Name): Scheme :=
  match proc_of(sig, p)
    case Some(proc) =>
      Scheme(proc.params ++ List(TParam("(raised)")), TProc(proc.ins, proc.outs, proc.refs, TParam("(raised)")))
    case None =>
      Scheme(List(), THole)
  end

function with_arity(cs: List[Name * Scheme], k: Int): List[Name * Scheme] :=
  List(for (n, sc) in cs if arity(sc.typ) == k)

function has_arity(scs: List[Scheme], k: Int): Bool :=
  exists(scs, lambda sc => arity(sc.typ) == k)

function bind(xs: List[Var]): Env :=
  List(for x in xs yield (x.name, Local(x.typ, true)))

// no local of xs hides one of env, except those of the translations, whose names users cannot write, such as (acc) and
// (item), which nest
procedure unhidden(in env: Env, xs: List[Var], ref s: State) :=
  for x in xs if not starts_with(x.name.base, "(") and get(x.name, env) != None do
    call report(in HiddenLocal(x.name), ref s)
  end

function unassigned(xs: List[Var]): Env :=
  List(for x in xs yield (x.name, Local(x.typ, false)))

// env after assignments to xs, which are the innermost variables of their names
function assigned(env: Env, xs: List[Name]): Env :=
  match (env, xs)
    case (_, List()) =>
      env

    case (List(), _) =>
      List()

    case (List((n, l); rest), _) =>
      if contains(n, xs) then
        List((n, l with assigned := true); assigned(rest, xs -- List(n)))
      else
        List((n, l); assigned(rest, xs))
  end

// the variables that both paths assign, where env and other have the same variables
function joined(env: Env, other: Env): Env :=
  match (env, other)
    case (List((n, l); rest), List((_, k); more)) =>
      List(
        (n, l with assigned := l.assigned and k.assigned); joined(rest, more))

    case _ =>
      List()
  end

// the variables after a raise, where no path continues, which joins with others as if it assigned all of them
function unreachable(env: Env): Env :=
  List(for (n, l) in env yield (n, l with assigned := true))

procedure readable(in env: Env, n: Name, ref s: State) :=
  match get(n, env)
    case Some(Local(_, false)) =>
      call report(in Unassigned(n), ref s)
    case _ =>
      skip
  end

procedure readables(in env: Env, ns: List[Name], ref s: State) :=
  for n in ns do
    call readable(in env, n, ref s)
  end

// the outs os of procedure p must be assigned at the end of its body
procedure outputs(in p: Name, os: List[Var], env: Env, ref s: State) :=
  match os
    case List() =>
      skip

    case List(o; more) =>
      match get(o.name, env)
        case Some(Local(_, false)) if contains(o.name, s.loop_assigned) =>
          call report(in Hinted(OutputUnassigned(o.name, p), "the checker assumes that a while may not run its body, so assign " ++ o.name.base ++ " also before it"), ref s)

        case Some(Local(_, false)) =>
          call report(in OutputUnassigned(o.name, p), ref s)

        case _ =>
          skip
      end
      call outputs(in p, more, env, ref s)
  end

// the variables of before that are not assigned there but are in after, the variables after a body
function newly_assigned(before: Env, after: Env): Set[Name] :=
  Set(for (n, l) in before if not l.assigned and exists(get(n, after), lambda x => x.assigned) yield n)

// the pattern of a case, and whether it has no guard, such that it may cover values
function case_of[A](b: At[Branch[A]]): At[Pat] * Bool :=
  match b.that
    case Branch(pat, guard, _) =>
      (pat, guard == None)
  end

function zonk_guard(s: State, g: Option[At[Expr]]): Option[At[Expr]] :=
  map_option(g, lambda e => zonk_expr(s, e))

function zonk_type(su: Subst, t: Type): Type :=
  match resolve(su, t)
    case TSort(name, args) =>
      TSort(name, List(for a in args yield zonk_type(su, a)))

    case TFun(args, res) =>
      TFun(List(for a in args yield zonk_type(su, a)), zonk_type(su, res))

    case TProc(ins, outs, refs, raised) =>
      TProc(List(for a in ins yield zonk_type(su, a)), List(for a in outs yield zonk_type(su, a)), List(for a in refs yield zonk_type(su, a)), zonk_type(su, raised))

    case TTuple(types) =>
      TTuple(List(for a in types yield zonk_type(su, a)))

    case u =>
      u
  end

// the declaration chosen for an overloaded name, which stands for it until the end of the command
function settled(s: State, n: Name): Name :=
  match n.module
    case Some("?") =>
      value_or(get(n, s.chosen), n)
    case _ =>
      n
  end

function zonk_var(s: State, x: Var): Var :=
  Var(settled(s, x.name), zonk_type(s.sub, x.typ))

function zonk_vars(s: State, xs: List[Var]): List[Var] :=
  List(for x in xs yield zonk_var(s, x))

function zonk_decls(s: State, xs: List[At[Var]]): List[At[Var]] :=
  List(for x in xs yield map_at(x, lambda v => zonk_var(s, v)))

function zonk_expr(s: State, expr: At[Expr]): At[Expr] :=
  map_at(expr, lambda e => zonk_node(s, e))

function zonk_node(s: State, expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(var) =>
      EVar(zonk_var(s, var))

    case EApp(fun, args) =>
      EApp(zonk_expr(s, fun), List(for a in args yield zonk_expr(s, a)))

    case EField(base, field) =>
      EField(zonk_expr(s, base), field)

    case EUpdate(base, field, value) =>
      EUpdate(zonk_expr(s, base), field, zonk_expr(s, value))

    case ELam(formals, body) =>
      ELam(List(for p in formals yield zonk_pat(s, p)), zonk_expr(s, body))

    case EProc(ins, outs, refs, raised, stmt) =>
      EProc(zonk_decls(s, ins), zonk_decls(s, outs), zonk_decls(s, refs), zonk_type(s.sub, raised), zonk_stmt(s, stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (zonk_pat(s, p), zonk_expr(s, e))), zonk_expr(s, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(zonk_expr(s, cond), zonk_expr(s, then_expr), zonk_expr(s, else_expr))

    case EMatch(arg, cases) =>
      EMatch(zonk_expr(s, arg), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda e => zonk_expr(s, e)))))

    case ETuple(args) =>
      ETuple(List(for arg in args yield zonk_expr(s, arg)))

    case EForm(_, _, _) =>
      expr

    case EFor(_, _, _, _) =>
      expr
  end

function zonk_branch[A](s: State, b: Branch[A], zonk_body: A -> A): Branch[A] :=
  Branch(zonk_pat(s, b.pat), zonk_guard(s, b.guard), zonk_body(b.body))

function zonk_pat(s: State, pat: At[Pat]): At[Pat] :=
  map_at(pat, lambda p => zonk_pattern(s, p))

function zonk_pattern(s: State, pat: Pat): Pat :=
  match pat
    case PVar(var) =>
      PVar(zonk_var(s, var))

    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield zonk_pat(s, a)))

    case PTuple(args) =>
      PTuple(List(for q in args yield zonk_pat(s, q)))

    case _ =>
      pat
  end

function zonk_binding(s: State, p: Var * At[Expr]): Var * At[Expr] :=
  match p
    case (x, e) =>
      (zonk_var(s, x), zonk_expr(s, e))
  end

function zonk_stmt(s: State, stmt: At[Stmt]): At[Stmt] :=
  map_at(stmt, lambda y => zonk_statement(s, y))

function zonk_statement(s: State, stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for p in upd yield zonk_binding(s, p)))

    case SBlock(locals, stmts) =>
      SBlock(zonk_decls(s, locals), List(for d in stmts yield zonk_stmt(s, d)))

    case SIf(cond, left, right) =>
      SIf(zonk_expr(s, cond), zonk_stmt(s, left), zonk_stmt(s, right))

    case SWhile(cond, body) =>
      SWhile(zonk_expr(s, cond), zonk_stmt(s, body))

    case SCall(proc, ins, outs, refs) =>
      SCall(settled(s, proc), List(for e in ins yield zonk_expr(s, e)), zonk_vars(s, outs), zonk_vars(s, refs))

    case SMatch(arg, cases) =>
      SMatch(zonk_expr(s, arg), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda y => zonk_stmt(s, y)))))

    case SAssert(cond) =>
      SAssert(zonk_expr(s, cond))

    case SAssertRaises(typ, pat, body) =>
      SAssertRaises(zonk_type(s.sub, typ), zonk_pat(s, pat), zonk_stmt(s, body))

    case SRaise(value, typ) =>
      SRaise(zonk_expr(s, value), zonk_type(s.sub, typ))

    case STry(body, catches) =>
      STry(zonk_stmt(s, body), List(for h in catches yield map_at(h, lambda c => zonk_handler(s, c))))

    case SFor(gens, body) =>
      SFor(List(for g in gens yield zonk_gen(s, g)), zonk_stmt(s, body))
  end

function zonk_proof(s: State, proof: Proof): Proof :=
  Proof(List(for step in proof.steps yield map_at(step, lambda node => zonk_step(s, node))), map_option(proof.split, lambda split => map_at(split, lambda node => zonk_split(s, node))))

function zonk_step(s: State, step: Step): Step :=
  match step
    case StepLocal(x, value) =>
      StepLocal(map_at(x, lambda v => zonk_var(s, v)), map_option(value, lambda e => zonk_expr(s, e)))

    case StepCall(name, ins, outs) =>
      StepCall(name, List(for e in ins yield zonk_expr(s, e)), zonk_vars(s, outs))

    case StepAssert(cond) =>
      StepAssert(zonk_expr(s, cond))

    case StepInvariant(cond) =>
      StepInvariant(zonk_expr(s, cond))

    case StepAssign(upd) =>
      StepAssign(List(for (x, e) in upd yield (zonk_var(s, x), zonk_expr(s, e))))
  end

function zonk_split(s: State, split: Split): Split :=
  match split
    case SplitInduction(formal, cases) =>
      SplitInduction(zonk_var(s, formal), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda p => zonk_proof(s, p)))))

    case SplitMatch(arg, cases) =>
      SplitMatch(zonk_expr(s, arg), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda p => zonk_proof(s, p)))))

    case SplitIf(cond, left, right) =>
      SplitIf(zonk_expr(s, cond), zonk_proof(s, left), map_option(right, lambda p => zonk_proof(s, p)))
  end

function zonk_gen(s: State, g: Gen): Gen :=
  match g
    case GVal(pat, over) =>
      GVal(zonk_pat(s, pat), zonk_expr(s, over))

    case GPair(key, value, over) =>
      GPair(zonk_pat(s, key), zonk_pat(s, value), zonk_expr(s, over))

    case GIf(cond) =>
      GIf(zonk_expr(s, cond))
  end

function zonk_handler(s: State, h: Catch): Catch :=
  match h
    case Catch(typ, pat, guard, body) =>
      Catch(zonk_type(s.sub, typ), zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_cmd(s: State, cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, _, body) =>
      CFun(name, params, zonk_decls(s, formals), zonk_type(s.sub, typ), no_spec(), zonk_expr(s, body))

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(name, params, zonk_decls(s, ins), zonk_decls(s, outs), zonk_decls(s, refs), raised, zonk_contract(s, spec), zonk_stmt(s, stmt))

    case CTest(name, vars, stmt) =>
      CTest(name, vars, zonk_stmt(s, stmt))

    case CLemma(name, params, ins, outs, claim, proof) =>
      CLemma(name, params, zonk_decls(s, ins), zonk_decls(s, outs), zonk_claim(s, claim), map_option(proof, lambda p => zonk_proof(s, p)))

    case _ =>
      cmd
  end

// the contract of the spec, which the checked program keeps for the prover, without the examples, which are tests
function zonk_contract(s: State, spec: Spec): Spec :=
  Spec(List(for a in spec.pre yield zonk_expr(s, a)), map_option(spec.post, lambda e => zonk_expr(s, e)), List())

function zonk_claim(s: State, claim: Claim): Claim :=
  match claim
    case ClaimHolds(assms, concl) =>
      ClaimHolds(List(for a in assms yield zonk_expr(s, a)), zonk_expr(s, concl))
    case ClaimCorrect(proc, ins, outs) =>
      ClaimCorrect(settled(s, proc), List(for a in ins yield zonk_expr(s, a)), zonk_vars(s, outs))
  end

// exceptions are told apart by their types at runtime, which must therefore be known after checking
// the type t of an exception at pos, if it is not known
function unknown_at(pos: Pos, t: Type): Option[Pos * Type] :=
  map_option(unknown_type(t), lambda u => (pos, u))

function unknown_type(t: Type): Option[Type] :=
  if free(t) == List() then None else Some(t)

// the type of an exception that is not known, also of those raised in expressions
function unknown_in(stmt: At[Stmt]): Option[Pos * Type] :=
  match stmt.that
    case SAssign(upd) =>
      unknown_in_exprs(seconds(upd))

    case SBlock(_, stmts) =>
      unknown_in_all(stmts)

    case SIf(cond, left, right) =>
      or_else(unknown_in_expr(cond), or_else(unknown_in(left), unknown_in(right)))

    case SWhile(cond, body) =>
      or_else(unknown_in_expr(cond), unknown_in(body))

    case SCall(_, ins, _, _) =>
      unknown_in_exprs(ins)

    case SMatch(arg, cases) =>
      or_else(unknown_in_expr(arg), unknown_in_branches(cases))

    case SAssert(cond) =>
      unknown_in_expr(cond)

    case SAssertRaises(typ, pat, body) =>
      or_else(if pat.that == PWild then None else unknown_at(stmt.pos, typ), unknown_in(body))

    case SRaise(value, typ) =>
      or_else(unknown_at(stmt.pos, typ), unknown_in_expr(value))

    case STry(body, catches) =>
      or_else(unknown_in(body), unknown_in_handlers(catches))

    case SFor(gens, body) =>
      or_else(unknown_in_exprs(List(for g in gens yield gen_container(g))), unknown_in(body))

    case SSkip =>
      None
  end

function unknown_in_expr(expr: At[Expr]): Option[Pos * Type] :=
  match expr.that
    case EApp(fun, args) =>
      unknown_in_exprs(List(fun; args))

    case EField(base, _) =>
      unknown_in_expr(base)

    case EUpdate(base, _, value) =>
      unknown_in_exprs(List(base, value))

    case ELam(_, body) =>
      unknown_in_expr(body)

    case EProc(_, _, _, _, stmt) =>
      unknown_in(stmt)

    case ELet(bindings, body) =>
      unknown_in_exprs(seconds(bindings) ++ List(body))

    case EIte(cond, then_expr, else_expr) =>
      unknown_in_exprs(List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      unknown_in_exprs(List(arg; List(for b in cases for e in branch_exprs(b) yield e)))

    case ETuple(args) =>
      unknown_in_exprs(args)

    // literals and variables, and forms, which the checker has translated
    case _ =>
      None
  end

function unknown_in_exprs(exprs: List[At[Expr]]): Option[Pos * Type] :=
  find_map(exprs, unknown_in_expr)

function branch_exprs(b: At[Branch[At[Expr]]]): List[At[Expr]] :=
  match b.that
    case Branch(_, Some(g), body) =>
      List(g, body)
    case Branch(_, None, body) =>
      List(body)
  end

function unknown_in_all(xs: List[At[Stmt]]): Option[Pos * Type] :=
  find_map(xs, unknown_in)

function unknown_in_branches(bs: List[At[Branch[At[Stmt]]]]): Option[Pos * Type] :=
  find_map(bs, unknown_in_branch)

function unknown_in_branch(b: At[Branch[At[Stmt]]]): Option[Pos * Type] :=
  match b.that
    case Branch(_, guard, body) =>
      or_else(unknown_in_guard(guard), unknown_in(body))
  end

// handlers of _ catch exceptions of any type
function unknown_in_handlers(hs: List[At[Catch]]): Option[Pos * Type] :=
  find_map(hs, unknown_in_handler)

function unknown_in_handler(h: At[Catch]): Option[Pos * Type] :=
  match h.that
    case Catch(typ, pat, guard, body) =>
      let caught := if pat.that == PWild then None else unknown_at(h.pos, typ) in
      or_else(caught, or_else(unknown_in_guard(guard), unknown_in(body)))
  end

function unknown_in_guard(guard: Option[At[Expr]]): Option[Pos * Type] :=
  match guard
    case Some(g) =>
      unknown_in_expr(g)
    case None =>
      None
  end

function unknown_in_cmd(cmd: Cmd): Option[Pos * Type] :=
  match cmd
    case CFun(_, _, _, _, _, body) =>
      unknown_in_expr(body)

    case CProc(_, _, _, _, _, _, spec, stmt) =>
      or_else(unknown_in(stmt), find_map(spec.pre ++ List(for e in spec.post), unknown_in_expr))

    case CTest(_, _, stmt) =>
      unknown_in(stmt)

    case CLemma(_, _, _, _, claim, _) =>
      find_map(claim_exprs(claim), unknown_in_expr)

    case _ =>
      None
  end

// the exhaustiveness check works on the patterns without their positions, whose witnesses are at Pos(0, 0)
function head_of(pat: Pat): Option[Head * List[Pat]] :=
  match pat
    case PApp(constr, args) =>
      Some((HCon(constr), List(for a in args yield a.that)))

    case PTuple(args) =>
      Some((HTuple(), List(for a in args yield a.that)))

    case PLit(lit) =>
      Some((HLit(lit), List()))

    case _ =>
      None
  end

// the constructors in the first column
function heads(rows: List[List[Pat]]): List[Head] :=
  match rows
    case List() =>
      List()

    case List(List(p; _); rest) =>
      match head_of(p)
        case Some((h, _)) =>
          List(h; heads(rest))
        case None =>
          heads(rest)
      end

    case List(List(); rest) =>
      heads(rest)
  end

// the argument types of constructor k of a datatype with type arguments args
function constr_fields(sig: Sig, k: Name, args: List[Type]): List[Type] :=
  match constr_of(sig, k)
    case Some(constr) =>
      List(for a in constr.fields yield subst(a, zip(constr.params, args)))
    case None =>
      List()
  end

// all constructors of t with their argument types, if there are finitely many
function constructors_of(sig: Sig, su: Subst, t: Type): Option[List[Head * List[Type]]] :=
  match zonk_type(su, t)
    case TBool() =>
      Some(List((HLit(LBool(true)), List()), (HLit(LBool(false)), List())))

    case TTuple(types) =>
      Some(List((HTuple(), types)))

    case TSort(name, args) =>
      match members_of(sig, name)
        case Some(ks) =>
          Some(List(for k in ks yield (HCon(k), constr_fields(sig, k, args))))
        case None =>
          None
      end

    case _ =>
      None
  end

function fields_of(sig: Sig, su: Subst, t: Type, h: Head): List[Type] :=
  match constructors_of(sig, su, t)
    case Some(ks) =>
      value_or(get(h, ks), List())
    case None =>
      List()
  end

function covers(hs: List[Head], ks: List[Head * List[Type]]): Bool :=
  forall(ks, lambda (h, _) => contains(h, hs))

// the rows whose first pattern has no constructor, without it
function defaults(rows: List[List[Pat]]): List[List[Pat]] :=
  match rows
    case List() =>
      List()

    case List(List(p; ps); rest) =>
      match head_of(p)
        case Some(_) =>
          defaults(rest)
        case None =>
          List(ps; defaults(rest))
      end

    case List(List(); rest) =>
      defaults(rest)
  end

function specialize(rows: List[List[Pat]], h: Head, n: Int): List[List[Pat]] :=
  match rows
    case List() =>
      List()

    case List(List(p; ps); rest) =>
      match head_of(p)
        case Some((g, args)) =>
          if g == h then
            List(args ++ ps; specialize(rest, h, n))
          else
            specialize(rest, h, n)

        case None =>
          List(replicate(n, PWild) ++ ps; specialize(rest, h, n))
      end

    case List(List(); rest) =>
      specialize(rest, h, n)
  end

// some values of types ts match q but no row
function is_useful(sig: Sig, su: Subst, rows: List[List[Pat]], q: List[Pat], ts: List[Type]): Bool :=
  match (q, ts)
    case (List(), _) =>
      rows == List()

    case (List(p; ps), List(t; rest)) =>
      match head_of(p)
        case Some((h, args)) =>
          is_useful(sig, su, specialize(rows, h, size(args)), args ++ ps, fields_of(sig, su, t, h) ++ rest)

        case None =>
          match constructors_of(sig, su, t)
            case Some(ks) =>
              if covers(heads(rows), ks) then
                is_useful_in(sig, su, rows, ks, ps, rest)
              else
                is_useful(sig, su, defaults(rows), ps, rest)

            case None =>
              is_useful(sig, su, defaults(rows), ps, rest)
          end
      end

    case (List(_; _), List()) =>
      false
  end

function is_useful_in(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], pats: List[Pat], rest: List[Type]): Bool :=
  exists(ks, lambda (h, args) => is_useful(sig, su, specialize(rows, h, size(args)), replicate(size(args), PWild) ++ pats, args ++ rest))

function witness(h: Head, args: List[Pat]): Pat :=
  match h
    case HTuple() =>
      PTuple(List(for a in args yield nowhere(a)))

    case HCon(constr) =>
      PApp(constr, List(for a in args yield nowhere(a)))

    case HLit(lit) =>
      PLit(lit)
  end

// values of types ts, as patterns, that no row matches
function missing(sig: Sig, su: Subst, rows: List[List[Pat]], ts: List[Type]): Option[List[Pat]] :=
  match ts
    case List() =>
      if rows == List() then Some(List()) else None
    case List(t; rest) =>
      missing_in(sig, su, rows, heads(rows), constructors_of(sig, su, t), rest)
  end

// hs are the constructors in the first column, cs are all constructors of its type if there are finitely many
function missing_in(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match cs
    case Some(ks) =>
      if covers(hs, ks) then
        first_missing(sig, su, rows, ks, rest)
      else
        other_missing(sig, su, rows, hs, cs, rest)

    case None =>
      other_missing(sig, su, rows, hs, cs, rest)
  end

function first_missing(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], rest: List[Type]): Option[List[Pat]] :=
  match ks
    case List() =>
      None

    case List((h, args); more) =>
      match missing(sig, su, specialize(rows, h, size(args)), args ++ rest)
        case Some(ws) =>
          match split_at(size(args), ws)
            case (found, others) =>
              Some(List(witness(h, found); others))
          end

        case None =>
          first_missing(sig, su, rows, more, rest)
      end
  end

function other_missing(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match missing(sig, su, defaults(rows), rest)
    case Some(ws) =>
      Some(List(uncovered(hs, cs); ws))
    case None =>
      None
  end

// a value of the first column that hs do not cover
function uncovered(hs: List[Head], cs: Option[List[Head * List[Type]]]): Pat :=
  match cs
    case Some(ks) =>
      if hs == List() then PWild else first_uncovered(hs, ks)
    case None =>
      PWild
  end

function first_uncovered(hs: List[Head], ks: List[Head * List[Type]]): Pat :=
  match ks
    case List() =>
      PWild

    case List((h, args); rest) =>
      if contains(h, hs) then
        first_uncovered(hs, rest)
      else
        witness(h, replicate(size(args), PWild))
  end

procedure fresh(out t: Type, ref s: State) :=
  assign t := TMeta(s.count + 1), s := s with count := s.count + 1

procedure bind_meta(in i: Int, t: Type, ref s: State) :=
  if occurs(s.sub, i, t) then
    call report(in InfiniteType(TMeta(i), zonk_type(s.sub, t)), ref s)
  else
    assign s := s with sub := put(i, t, s.sub)
  end

procedure unify(in t: Type, t_: Type, ref s: State) :=
  local a := resolve(s.sub, t), b := resolve(s.sub, t_)
  match (a, b)
    case (TError, TMeta(meta)) =>
      call bind_meta(in meta, TError, ref s)

    case (TMeta(meta), TError) =>
      call bind_meta(in meta, TError, ref s)

    case (TError, _) =>
      skip

    case (_, TError) =>
      skip

    case (TMeta(i), TMeta(j)) =>
      if i != j then
        call bind_meta(in i, b, ref s)
      end

    case (TMeta(meta), _) =>
      call bind_meta(in meta, b, ref s)

    case (_, TMeta(meta)) =>
      call bind_meta(in meta, a, ref s)

    case (TParam(x), TParam(y)) =>
      if x != y then
        call report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TSort(f, xs), TSort(g, ys)) =>
      if f == g and size(xs) == size(ys) then
        call unifies(in xs, ys, ref s)
      else
        call report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TFun(xs, r), TFun(ys, r_)) =>
      if size(xs) == size(ys) then
        call unifies(in xs ++ List(r), ys ++ List(r_), ref s)
      else
        call report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TTuple(xs), TTuple(ys)) =>
      if size(xs) == size(ys) then
        call unifies(in xs, ys, ref s)
      else
        call report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TProc(xs, ys, zs, r), TProc(us, vs, ws, r_)) =>
      if size(xs) == size(us) and size(ys) == size(vs) and size(zs) == size(ws) then
        call unifies(in xs ++ ys ++ zs ++ List(r), us ++ vs ++ ws ++ List(r_), ref s)
      else
        call report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case _ =>
      call report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
  end

procedure unifies(in xs: List[Type], ys: List[Type], ref s: State) :=
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) =>
      call unify(in x, y, ref s)
      call unifies(in xs_, ys_, ref s)

    case (List(), List()) =>
      skip

    case _ =>
      call report(in CountMismatch("", "values", size(xs), size(ys)), ref s)
  end

procedure fresh_list[A](in xs: List[A], out ts: List[Type], ref s: State) :=
  local t: Type
  assign ts := List()
  for _ in xs do
    call   fresh(out t, ref s)
    assign ts := ts ++ List(t)
  end

procedure instance(in ps: List[Type], out m: List[Type * Type], ref s: State) :=
  local t: Type
  assign m := List()
  for p in ps do
    call   fresh(out t, ref s)
    assign m := m ++ List((p, t))
  end

procedure instantiate(in sc: Scheme, out t: Type, ref s: State) :=
  local m: List[Type * Type]
  call   instance(in sc.params, out m, ref s)
  assign t := subst(zonk_type(s.sub, sc.typ), m)

// the names ns, which must be distinct, of what they are, e.g. formals
procedure unique(in what: Str, ns: List[Name], ref s: State) :=
  match repeated(ns)
    case Some(n) =>
      call report(in Duplicate(what, n.base), ref s)
    case None =>
      skip
  end

procedure unique_ids(in what: Str, ns: List[Id], ref s: State) :=
  match repeated(ns)
    case Some(n) =>
      call report(in Duplicate(what, n), ref s)
    case None =>
      skip
  end

// the number n of the units of owner, which expects m of them, e.g. the arguments of a constructor
procedure same_length(in owner: Str, unit: Str, m: Int, n: Int, ref s: State) :=
  if m != n then
    call report(in CountMismatch(owner, unit, m, n), ref s)
  end

// expands type definitions and replaces holes by fresh unknowns
procedure normalize(in t: Type, out u: Type, ref s: State) :=
  match t
    case THole =>
      call fresh(out u, ref s)

    case TParam(_) =>
      assign u := t

    case TMeta(_) =>
      assign u := t

    case TError =>
      assign u := t

    case TFun(args, res) =>
      local us: List[Type], v: Type
      call   normalizes(in args, out us, ref s)
      call   normalize(in res, out v, ref s)
      assign u := TFun(us, v)

    case TTuple(types) =>
      local us: List[Type]
      call   normalizes(in types, out us, ref s)
      assign u := TTuple(us)

    case TProc(ins, outs, refs, raised) =>
      local us: List[Type], r: Type
      call   normalizes(in ins ++ outs ++ refs, out us, ref s)
      call   normalized_raises(in raised, out r, ref s)
      assign u := match split_at(size(ins), us)
        case (in_types, others) =>
          match split_at(size(outs), others)
            case (out_types, ref_types) =>
              TProc(in_types, out_types, ref_types, r)
          end
      end

    case TSort(name, args) =>
      match visible_names(s, name, lambda n => is_sort(s.sig, n))
        case List(m) =>
          call normalize_sort(in m, args, out u, ref s)

        case List() =>
          call   unknown_sort(in name, ref s)
          assign u := TError

        case ms =>
          call report(in Ambiguous(name, List(for m in ms yield (m, Scheme(List(), THole)))), ref s)
          call fresh(out u, ref s)
      end
  end

// reported once per command, e.g. a type parameter that its declaration omits
procedure unknown_sort(in n: Name, ref s: State) :=
  if not contains(n, s.unknown_sorts) then
    call   report(in UnknownSort(n), ref s)
    assign s := s with unknown_sorts := Set(n; s.unknown_sorts)
  end

procedure normalize_sort(
  in  n: Name,
      args: List[Type],
  out u: Type,
  ref s: State
) :=
  match data_of(s.sig, n)
    case Some(k) if size(args) != k =>
      call   report(in SortArity(n, k, size(args)), ref s)
      assign u := TError

    case Some(_) =>
      local us: List[Type]
      call   normalizes(in args, out us, ref s)
      assign u := TSort(n, us)

    case None =>
      match type_alias_of(s.sig, n)
        case Some(alias) if size(args) != size(alias.params) =>
          call   report(in SortArity(n, size(alias.params), size(args)), ref s)
          assign u := TError

        case Some(alias) =>
          local us: List[Type]
          call   normalizes(in args, out us, ref s)
          assign u := subst(alias.typ, zip(params(alias.params), us))

        case None =>
          call unknown_sort(in n, ref s)
          call fresh(out u, ref s)
      end
  end

// step applied to each of xs in order, threading the state
procedure map_state[A, B](
  in  xs: List[A],
      step: (in A, out B, ref State) raises TypeError,
  out ys: List[B],
  ref s: State
) :=
  local y: B, found: Buffer[B] := empty()
  for x in xs do
    call   step(in x, out y, ref s)
    assign found := found ++ List(y)
  end
  assign ys := List(for z in found)

procedure normalizes(in ts: List[Type], out us: List[Type], ref s: State) :=
  call map_state(in ts, normalize, out us, ref s)

procedure known(in t: Type, what: Name, out u: Type, ref s: State) :=
  if has_holes(t) then
    call report(in MissingType(what), ref s)
  end
  call normalize(in t, out u, ref s)

procedure knowns(
  in  ts: List[Type],
      what: Name,
  out us: List[Type],
  ref s: State
) :=
  call map_state(in ts, lambda in t: Type, out u: Type, ref r: State =>
    call known(in t, what, out u, ref r)
  end, out us, ref s)

// the declared variables of a lambda or locals, which are what, e.g. formals, each with the errors of its type at it
procedure formals(
  in  what: Str,
      xs: List[At[Var]],
  out ys: List[Var],
  ref s: State
) :=
  call unique_decls(in what, xs, ref s)
  call map_state(in xs, normalize_var, out ys, ref s)

procedure normalize_var(in x: At[Var], out y: Var, ref s: State) :=
  local u: Type, outer := s.at
  assign s := s with at := decl_pos(outer, x.pos)
  call   normalize(in x.that.typ, out u, ref s)
  assign y := Var(x.that.name, u), s := s with at := outer

// the parameters and locals, which have types, each with the errors of its type at it
procedure signature(in xs: List[At[Var]], out ys: List[Var], ref s: State) :=
  call unique_decls(in "formal", xs, ref s)
  call map_state(in xs, known_var, out ys, ref s)

procedure known_var(in x: At[Var], out y: Var, ref s: State) :=
  local u: Type, outer := s.at
  assign s := s with at := decl_pos(outer, x.pos)
  call   known(in x.that.typ, x.that.name, out u, ref s)
  assign y := Var(x.that.name, u), s := s with at := outer

// the declarations decls with the types of xs, which are their variables as checked
function retyped(decls: List[At[Var]], xs: List[Var]): List[At[Var]] :=
  List(for (d, x) in zip(decls, xs) yield map_at(d, lambda _ => x))

// the position of a declaration, or else of what declares it, outer, if the parser did not read it
function decl_pos(outer: Pos, pos: Pos): Pos :=
  if pos == Pos(0, 0) then outer else pos

// the declarations xs, which must have distinct names, of what they are, e.g. formals, where a repeated one is reported
// at its second declaration
procedure unique_decls(in what: Str, xs: List[At[Var]], ref s: State) :=
  match repeated_decl(xs, empty())
    case Some(x) =>
      call report(in at_use(decl_pos(s.at, x.pos), Duplicate(what, x.that.name.base)), ref s)
    case None =>
      skip
  end

// the first of xs whose name is declared before it, in seen or in xs
function repeated_decl(xs: List[At[Var]], seen: Set[Name]): Option[At[Var]] :=
  match xs
    case List() =>
      None

    case List(x; rest) =>
      if contains(x.that.name, seen) then
        Some(x)
      else
        repeated_decl(rest, Set(x.that.name; seen))
  end

// a use of n elaborated with an instance of sc, where w is normalized
procedure use(in n: Name, w: Type, sc: Scheme, out x: Var, ref s: State) :=
  local u: Type
  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)
  assign x := Var(n, u)

// a use of n of type w, which is normalized, as the one of the candidates cs that fits w
procedure use_name(
  in  n: Name,
      cs: List[Name * Scheme],
      w: Type,
  out x: Var,
  ref s: State
) :=
  match cs
    case List() if overloads(s, n, lambda a => is_pat_alias(s.sig, a)) != List() =>
      call   report(in PatternOnly(n), ref s)
      assign x := Var(n, w)

    case List() =>
      call   report(in unknown_variable(s, n), ref s)
      call   unify(in w, TError, ref s)
      assign x := Var(n, TError)

    case List((m, sc)) =>
      call use(in m, w, sc, out x, ref s)

    case _ =>
      local m: Name
      call   choose(in n, cs, w, out m, ref s)
      assign x := Var(m, w)
  end

// the result of the type w of a function, if it is one, is TError
procedure unify_result(in w: Type, ref s: State) :=
  match zonk_type(s.sub, w)
    case TFun(_, r) =>
      call unify(in r, TError, ref s)
    case _ =>
      call unify(in w, TError, ref s)
  end

// the one of the candidates cs that fits w, or a placeholder for the use if several fit, which stays open
procedure choose(
  in  n: Name,
      cs: List[Name * Scheme],
      w: Type,
  out m: Name,
  ref s: State
) :=
  local ok: List[(Name * Scheme) * State]
  call trials(in cs, w, s, out ok)
  match ok
    // a use that no candidate fits has the result TError, so that what uses it makes no follow-ups
    case List() =>
      call   report(in NoOverload(n, zonk_type(s.sub, w)), ref s)
      call   unify_result(in w, ref s)
      assign m := n

    case List(((m_, _), s_)) =>
      assign m := m_, s := s_

    case _ =>
      assign m := Name(Some("?"), show(s.count + 1))
      assign s := s with count := s.count + 1, pending := s.pending ++ List(Pending(m, n, firsts(ok), w, s.at))
  end

// the candidates that fit w, each with the state after unifying its instance with w
procedure trials(
  in  cs: List[Name * Scheme],
      w: Type,
      s: State,
  out ok: List[(Name * Scheme) * State]
) :=
  local u: State
  assign ok := List()
  for (m, sc) in cs do
    assign u := s
    call   trial(in sc, w, ref u)
    if size(u.errors) == size(s.errors) then
      assign ok := ok ++ List(((m, sc), u))
    end
  end

procedure trial(in sc: Scheme, w: Type, ref s: State) :=
  local u: Type
  call instantiate(in sc, out u, ref s)
  call unify(in u, w, ref s)

// the open uses, until none can be decided, where each is decided once one of its candidates fits
procedure solve(ref s: State) :=
  local changed := true, ps: List[Pending]
  while changed do
    assign ps := s.pending, changed := false
    assign s := s with pending := List()
    call   revisit(in ps, ref changed, s)
  end

procedure revisit(in ps: List[Pending], ref changed: Bool, s: State) :=
  match ps
    case List() =>
      skip

    case List(p; rest) =>
      local ok: List[(Name * Scheme) * State]
      call trials(in p.cands, p.typ, s, out ok)
      match ok
        case List() =>
          assign s := s with errors := s.errors ++ List(at_use(p.pos, NoOverload(p.name, zonk_type(s.sub, p.typ))))

        case List(((m, _), s_)) =>
          assign s := s_ with chosen := put(p.id, m, s_.chosen)
          assign changed := true

        case _ =>
          assign s := s with pending := s.pending ++ List(p with cands := firsts(ok))
          if size(ok) < size(p.cands) then
            assign changed := true
          end
      end
      call revisit(in rest, ref changed, s)
  end

// the uses of a command, each of which must be decided by its types alone, so that a use means the one candidate that fits
// it, whatever the order in which the uses are solved
procedure settle(ref s: State) :=
  call solve(ref s)
  match List(for p in s.pending if not has_error_type(zonk_type(s.sub, p.typ)))
    case List(p; _) =>
      assign s := s with errors := s.errors ++ List(at_use(p.pos, Ambiguous(p.name, p.cands)))
    case List() =>
      skip
  end

// an expression at its position, where an error inside is reported at the innermost position, and an open use of an
// overloaded name remembers it for the end of the command, where it is solved
procedure infer(
  in  env: Env,
      expr: At[Expr],
  out res: At[Expr],
      typ: Type,
  ref s: State
) :=
  match expr
    case AOk(pos, span, node) =>
      local outer := s.at, before := size(s.errors), x: Expr, errors: List[Diagnostic]
      assign s := s with at := pos
      call   infer_node(in env, pos, span, node, None, out x, typ, ref s)
      call   take_errors(in pos, before, out errors, ref s)
      assign res := checked_at(pos, span, x, errors), s := s with at := outer

    // reported by the parser, of any type
    case AUnparsed(_, _, _, _) =>
      assign res := expr, typ := TError

    // the checker makes error nodes of the parts that the parser read, which it checks once
    case AErr(_, _, _, _) =>
      raise Unexpected("error node")
  end

// expr against the type that what names, t, which it passes down to its parts, so that a part of the wrong type is
// reported at the part, and then expects of the whole
procedure infer_against(
  in  env: Env,
      expr: At[Expr],
      t: Type,
      what: Str,
  out res: At[Expr],
      typ: Type,
  ref s: State
) :=
  match expr
    case AOk(pos, span, node) =>
      local outer := s.at, before := size(s.errors), x: Expr, errors: List[Diagnostic]
      assign s := s with at := pos
      call   infer_node(in env, pos, span, node, Some((t, what)), out x, typ, ref s)
      call   take_errors(in pos, before, out errors, ref s)
      assign res := checked_at(pos, span, x, errors), s := s with at := outer

    // reported by the parser, of any type
    case AUnparsed(_, _, _, _) =>
      assign res := expr, typ := TError

    // the checker makes error nodes of the parts that the parser read, which it checks once
    case AErr(_, _, _, _) =>
      raise Unexpected("error node")
  end

// the expression expr at pos, where the translations of forms, generators, and lambdas with patterns are at pos, and
// expected the type that a part around it expects, if known, which the parts of applications, tuples, lets, and forms
// are checked against
procedure infer_node(
  in  env: Env,
      pos: Pos,
      span: Span,
      expr: Expr,
      expected: Option[Type * Str],
  out res: Expr,
      typ: Type,
  ref s: State
) :=
  match expr
    case ELit(lit) =>
      assign res := ELit(checked_lit(lit)), typ := literal(lit)

    case EName(name, a) =>
      local z: Var, w: Type
      call   normalize(in a, out w, ref s)
      call   use_name(in name, candidates(s, env, name), w, out z, ref s)
      call   readable(in env, name, ref s)
      assign res := EVar(z), typ := z.typ

    case EApp(fun, args) =>
      call application(in env, fun, args, expected, out res, typ, ref s)

    case EField(base, field) =>
      call field_access(in env, pos, span, "." ++ field, base, List(), out res, typ, ref s)

    case EUpdate(base, field, value) =>
      call field_access(in env, pos, span, "." ++ field ++ ":=", base, List(value), out res, typ, ref s)

    case ELam(pats, body) =>
      match variables_of(s, pats)
        case Some(bound) =>
          local xs: List[Var], b: At[Expr], u: Type
          call   formals(in "formal", bound, out xs, ref s)
          call   unhidden(in env, xs, ref s)
          call   infer(in bind(xs) ++ env, body, out b, u, ref s)
          assign res := ELam(List(for (p, x) in zip(bound, xs) yield AOk(p.pos, p.span, PVar(x))), b), typ := TFun(List(for x in xs yield x.typ), u)

        case None =>
          call translated(in env, AOk(pos, span, lambda_match(s, pos, span, pats, body)), expected, out res, typ, ref s)
      end

    // the body sees the variables around it, but assigns only the outs and refs of the lambda, and its loops are its
    // own, so the hint of outputs sees only those of the lambda
    case EProc(ins, outs, refs, _, stmt) =>
      local loop_assigned := s.loop_assigned, xs: List[Var], ys: List[Var], zs: List[Var], r: Type, y: At[Stmt], inner: Env
      call   unique_decls(in "formal", ins ++ outs ++ refs, ref s)
      call   map_state(in ins, normalize_var, out xs, ref s)
      call   map_state(in outs, normalize_var, out ys, ref s)
      call   map_state(in refs, normalize_var, out zs, ref s)
      call   unhidden(in env, xs ++ ys ++ zs, ref s)
      assign inner := bind(xs) ++ unassigned(ys) ++ bind(zs) ++ env, s := s with loop_assigned := empty()
      call   statement(in List(for x in ys ++ zs yield x.name), stmt, out y, ref inner, s)
      call   outputs(in unqualified("lambda"), ys, inner, ref s)
      assign s := s with loop_assigned := loop_assigned
      call   fresh(out r, ref s)
      assign res := EProc(retyped(ins, xs), retyped(outs, ys), retyped(refs, zs), r, y), typ := TProc(List(for x in xs yield x.typ), List(for x in ys yield x.typ), List(for x in zs yield x.typ), r)

    // lets do not generalize, only declarations have type parameters
    case ELet(bound, body) =>
      match variables_of(s, firsts(bound))
        case Some(bound_vars) =>
          local xs: List[Var], b: At[Expr], u: Type, exprs: List[At[Expr]]
          call   formals(in "binding", bound_vars, out xs, ref s)
          call   unhidden(in env, xs, ref s)
          call   checks(in env, "the bindings", seconds(bound), List(for x in xs yield x.typ), out exprs, ref s)
          call   infer_body(in bind(xs) ++ env, body, expected, out b, u, ref s)
          assign res := ELet(zip(List(for (p, x) in zip(firsts(bound), xs) yield p with that := PVar(x)), exprs), b), typ := u

        // other patterns are irrefutable, checked for exhaustiveness as the cases of a match
        case None =>
          local ts: List[Type], exprs: List[At[Expr]], pats: List[At[Pat]] := List(), xs: List[Var] := List(), b: At[Expr]
          call fresh_list(in bound, out ts, ref s)
          call checks(in env, "the bindings", seconds(bound), ts, out exprs, ref s)
          for (pat, t) in zip(firsts(bound), ts) do
            local typed_pat: At[Pat], ys: List[Var]
            call   binders(in pat, t, out typed_pat, ys, ref s)
            assign pats := pats ++ List(typed_pat), xs := xs ++ ys
          end
          call unique(in "pattern variable", List(for x in xs yield x.name), ref s)
          call unhidden(in env, xs, ref s)
          call infer_body(in bind(xs) ++ env, body, expected, out b, typ, ref s)
          call solve(ref s)
          for (pat, t) in zip(pats, ts) do
            call coverage(in t, List((pat, true)), ref s)
          end
          assign res := ELet(zip(pats, exprs), b)
      end

    case EIte(cond, then_expr, else_expr) =>
      local b: At[Expr], c: At[Expr], l: At[Expr], u: Type
      call   check(in env, cond, TBool(), "the condition of if", out c, ref s)
      call   infer(in env, then_expr, out l, u, ref s)
      call   check(in env, else_expr, u, "the else branch", out b, ref s)
      assign res := EIte(c, l, b), typ := u

    case ETuple(items) =>
      local exprs: List[At[Expr]], ts: List[Type]
      match component_types(s, expected, size(items))
        case Some(us) =>
          assign exprs := List()
          for ((item, u), i) in zip(zip(items, us), range(1, size(items) + 1)) do
            local typed_item: At[Expr]
            call   check(in env, item, u, "component " ++ show(i) ++ " of the tuple", out typed_item, ref s)
            assign exprs := exprs ++ List(typed_item)
          end
          assign ts := us

        case None =>
          call infers(in env, items, out exprs, ts, ref s)
      end
      assign res := ETuple(exprs), typ := TTuple(ts)

    case EMatch(arg, cases) =>
      local c: At[Expr], u: Type, bs: List[At[Branch[At[Expr]]]]
      call   fresh(out typ, ref s)
      call   infer(in env, arg, out c, u, ref s)
      call   expr_branches(in env, cases, u, typ, out bs, ref s)
      call   solve(ref s)
      call   coverage(in u, List(for br in bs yield case_of(br)), ref s)
      assign res := EMatch(c, bs)

    // forms as the builders of the module of their name, and their generators as the folds of the modules of the
    // containers, which the checked program keeps
    case EForm(form, elems, rest) =>
      local outer := s.within, places := Set(for y in elems for e in yielded_exprs(y) yield e.pos)
      assign s := s with within := List(InForm(form, places); outer)
      call   translated(in env, form_expr(pos, span, form, elems, rest), expected, out res, typ, ref s)
      assign s := s with within := outer

    case EFor(FArray, gens, elem, None) =>
      call translated(in env, form_app(pos, span, library_module("array"), "from_list", List(AOk(pos, span, EFor(FList, gens, elem, None)))), expected, out res, typ, ref s)

    case EFor(form, List(), elem, rest) =>
      call translated(in env, step_expr(pos, span, form, elem, base_expr(pos, span, form, rest)), expected, out res, typ, ref s)

    case EFor(form, List(GIf(cond); more), elem, rest) =>
      call translated(in env, AOk(pos, span, EIte(cond, AOk(pos, span, EFor(form, more, elem, rest)), base_expr(pos, span, form, rest))), expected, out res, typ, ref s)

    case EFor(form, List(g; more), elem, rest) =>
      call generator(in env, pos, span, form, g, more, elem, rest, out res, typ, ref s)
  end

// the translation expr of an expression at the position of expr, which it has, checked as the node of that expression,
// so that the errors of its top stay for the part of the expression to take, as only its node is kept
procedure translated(
  in  env: Env,
      expr: At[Expr],
      expected: Option[Type * Str],
  out res: Expr,
      typ: Type,
  ref s: State
) :=
  match (expr, expected)
    case (AOk(pos, span, node), Some((t, what))) =>
      local u: Type
      call   infer_node(in env, pos, span, node, expected, out res, u, ref s)
      call   expect(in pos, what, t, u, ref s)
      assign typ := t

    case (AOk(pos, span, node), None) =>
      call infer_node(in env, pos, span, node, None, out res, typ, ref s)

    // the translations are built by the checker, at the position of what they translate
    case _ =>
      raise Unexpected("a translation that does not parse")
  end

// expr against expected, if known, else inferred
procedure infer_body(
  in  env: Env,
      expr: At[Expr],
      expected: Option[Type * Str],
  out typed_expr: At[Expr],
      typ: Type,
  ref s: State
) :=
  match expected
    case Some((t, what)) =>
      call   check(in env, expr, t, what, out typed_expr, ref s)
      assign typ := t

    case None =>
      call infer(in env, expr, out typed_expr, typ, ref s)
  end

// e as an error of an element of a form, at one of places, instead of an argument of the call that the form is translated to
function element_error(form: Form, places: Set[Pos], e: TypeError): TypeError :=
  match e
    case Located(m, pos, Mismatch(t, u, what)) if contains(pos, places) and starts_with(what, "argument") =>
      Located(m, pos, Mismatch(t, u, "an element of " ++ form_name(form)))
    case _ =>
      e
  end

function yielded_exprs(y: Yield): List[At[Expr]] :=
  match y
    case YVal(value) =>
      List(value)
    case YPair(key, value) =>
      List(key, value)
  end

// the types of the n components of a tuple of the type expected, if known
function component_types(s: State, expected: Option[Type * Str], n: Int): Option[List[Type]] :=
  match expected
    case Some((t, _)) =>
      match zonk_type(s.sub, t)
        case TTuple(ts) if size(ts) == n =>
          Some(ts)
        case _ =>
          None
      end

    case None =>
      None
  end

// the error e of a program at the innermost part around it, s.at, which infer, statement, and binders set, after which the
// checker continues with a fallback
procedure report(in e: TypeError, ref s: State) :=
  if not reaches_error(s, e) then
    assign s := s with errors := s.errors ++ List(within(s, at_use(s.at, unparsed_use(s.unparsed, e))))
  end

// e as the parts around it read it, the innermost first
function within(s: State, e: TypeError): TypeError :=
  foldl(s.within, e, lambda x, w => as_within(w, x))

function as_within(w: Within, e: TypeError): TypeError :=
  match w
    case InForm(form, places) =>
      element_error(form, places, e)
    case InCall(name) =>
      argument_hint(name, e)
  end

// the errors that the part at pos takes, those reported since there were before that no part inside it took, and none for
// a part at Pos(0, 0), of code that the parser did not read, whose errors the part around it or the command takes
procedure take_errors(
  in  pos: Pos,
      before: Int,
  out errors: List[Diagnostic],
  ref s: State
) :=
  if pos == Pos(0, 0) then
    assign errors := List()
  else
    local own := List(for (i, e) in zip(range(before, size(s.errors)), drop(before, s.errors)) if not contains(i, s.taken) yield (i, e))
    assign errors := List(for (_, e) in own yield type_diagnostic(e)), s := s with taken := s.taken ++ Set(for (i, _) in own yield i)
  end

// x at pos with its errors, if it has some
function checked_at[A](pos: Pos, span: Span, x: A, errors: List[Diagnostic]): At[A] :=
  if errors == List() then AOk(pos, span, x) else AErr(pos, span, x, errors)

// whether e is of a type that a part that does not parse reaches, TError, which needs no error of its own
function reaches_error(s: State, e: TypeError): Bool :=
  exists(error_types(e), lambda t => has_error_type(zonk_type(s.sub, t)))

// the types that e names
function error_types(e: TypeError): List[Type] :=
  match e
    case Located(_, _, error) =>
      error_types(error)

    case Hinted(error, _) =>
      error_types(error)

    case CannotUnify(left, right) =>
      List(left, right)

    case Mismatch(expected_type, found_type, _) =>
      List(expected_type, found_type)

    case NoOverload(_, typ) =>
      List(typ)

    case UnknownFieldType(_, typ) =>
      List(typ)

    case UnknownContainer(typ) =>
      List(typ)

    case NoFold(typ, _) =>
      List(typ)

    case UnknownException(typ) =>
      List(typ)

    case NotAnException(typ) =>
      List(typ)

    case _ =>
      List()
  end

function has_error_type(t: Type): Bool :=
  match t
    case TError =>
      true

    case TSort(_, args) =>
      exists(args, has_error_type)

    case TFun(args, res) =>
      exists(List(res; args), has_error_type)

    case TTuple(args) =>
      exists(args, has_error_type)

    case TProc(ins, outs, refs, raised) =>
      exists(List(raised; ins ++ outs ++ refs), has_error_type)

    case _ =>
      false
  end

// the first error that s reported
procedure reported(in s: State) :=
  match s.errors
    case List(e; _) =>
      raise e
    case List() =>
      skip
  end

// e at pos, unless it has a position already, where Located without a module is in the module of the command, which
// located adds
function at_use(pos: Pos, e: TypeError): TypeError :=
  match e
    case Located(_, _, _) =>
      e
    case _ =>
      if pos == Pos(0, 0) then e else Located(None, pos, e)
  end

// the types of raises of a procedure type, as the set of the exceptions, sorted, where a hole is a hole
procedure normalized_raises(in raised: Type, out typ: Type, ref s: State) :=
  match raised
    case TTuple(types) =>
      local us: List[Type]
      call   normalizes(in types, out us, ref s)
      call   exceptions(in us, ref s)
      assign typ := TTuple(distinct(sort(us)))

    case _ =>
      call normalize(in raised, out typ, ref s)
  end

// raises NotAnException unless each of types is a datatype without type parameters
procedure exceptions(in types: List[Type], ref s: State) :=
  for t in types do
    match t
      case TSort(name, List()) if is_data(s.sig, name) =>
        skip
      case _ =>
        call report(in NotAnException(t), ref s)
    end
  end

// the fold of the module of the type of the container of generator g, which must be known after the container, applied to
// the container, the base of the form, and the function of a step, whose body adds the elements of the generators after g
procedure generator(
  in  env: Env,
      pos: Pos,
      span: Span,
      form: Form,
      g: Gen,
      more: List[Gen],
      elem: Yield,
      rest: Option[At[Expr]],
  out typed_expr: Expr,
      t: Type,
  ref s: State
) :=
  local c: At[Expr], u: Type, typed_fold: At[Expr], x: Var, w: Type
  call   infer(in env, gen_container(g), out c, u, ref s)
  call   solve(ref s)
  assign x := Var(unqualified("(container)"), u), w := zonk_type(s.sub, u)
  match w
    case TSort(Name(Some(m), _), targs) if declares_fold(s.sig, m, fold_name(form)) =>
      call infer(in bind(List(x)) ++ env, fold_expr(s, pos, span, form, m, targs, g, AOk(pos, span, EVar(x)), AOk(pos, span, EFor(form, more, elem, Some(AOk(pos, span, EVar(form_acc()))))), base_expr(pos, span, form, rest)), out typed_fold, t, ref s)

    // the container stands for the form, of a type that later uses unify with anything
    case TSort(Name(Some(_), _), _) =>
      call   report(in NoFold(w, fold_name(form)), ref s)
      call   fresh(out t, ref s)
      assign typed_fold := standing_for(pos, x, c)

    case _ =>
      call   report(in UnknownContainer(w), ref s)
      call   fresh(out t, ref s)
      assign typed_fold := standing_for(pos, x, c)
  end
  assign typed_expr := with_container(typed_fold, c).that

// foldr for lists, which come out in the order of the container, and foldl for the others
function fold_name(form: Form): Id :=
  if form == FList then "foldr" else "foldl"

function declares_fold(sig: Sig, m: Id, fold: Id): Bool :=
  exists(schemes_of(sig, Name(Some(m), fold)), lambda sc => match sc.typ
    case TFun(args, _) =>
      size(args) == 3
    case _ =>
      false
  end)

function form_app(pos: Pos, span: Span, m: Id, f: Id, args: List[At[Expr]]): At[Expr] :=
  AOk(pos, span, ECall(pos, span, Name(Some(m), f), THole, args))

// the accumulator of the folds, which users cannot name
function form_acc(): Var :=
  Var(unqualified("(acc)"), THole)

// the container that a form adds its elements to, its rest or else the empty one
function base_expr(pos: Pos, span: Span, form: Form, rest: Option[At[Expr]]): At[Expr] :=
  match (rest, form)
    case (Some(r), _) =>
      r

    case (None, FList) =>
      AOk(pos, span, ENil(THole))

    case (None, FSet) =>
      form_app(pos, span, library_module("set"), "empty", List())

    case (None, _) =>
      form_app(pos, span, library_module("map"), "empty", List())
  end

// base with elem added, which comes first in a list, and whose key counts in a map
function step_expr(pos: Pos, span: Span, form: Form, elem: Yield, base: At[Expr]): At[Expr] :=
  match (form, elem)
    case (FMap, YPair(k, v)) =>
      form_app(pos, span, library_module("map"), "put", List(k, v, base))

    case (FMap, YVal(e)) =>
      form_app(pos, span, library_module("map"), "put", List(
        form_app(pos, span, library_module("prelude"), "first", List(e)),
        form_app(pos, span, library_module("prelude"), "second", List(e)),
        base))

    case (FSet, YVal(e)) =>
      form_app(pos, span, library_module("set"), "insert", List(e, base))

    case (_, YVal(e)) =>
      AOk(pos, span, ECons(pos, span, THole, e, base))

    case (_, YPair(k, v)) =>
      AOk(pos, span, ECons(pos, span, THole, AOk(pos, span, ETuple(List(k, v))), base))
  end

// List(a, b; r) is Cons(a, Cons(b, r)), Set(a, b; r) is insert(a, insert(b, r)), Map(k => v, l => w; r) is
// put(l, w, put(k, v, r)), so that the last entry of a key counts, and Array(a, b) is from_list(List(a, b))
function form_expr(pos: Pos, span: Span, form: Form, elems: List[Yield], rest: Option[At[Expr]]): At[Expr] :=
  match form
    case FArray =>
      form_app(pos, span, library_module("array"), "from_list", List(form_expr(pos, span, FList, elems, None)))

    case FMap =>
      foldl(elems, base_expr(pos, span, form, rest), lambda acc, e => step_expr(pos, span, form, e, acc))

    case _ =>
      foldr(elems, base_expr(pos, span, form, rest), lambda e, acc => step_expr(pos, span, form, e, acc))
  end

function gen_container(g: Gen): At[Expr] :=
  match g
    case GVal(_, c) =>
      c

    case GPair(_, _, c) =>
      c

    case GIf(c) =>
      c
  end

// the fold of module m over container c into base, by foldr for lists, so that prepending keeps the order, and else by foldl,
// so that the steps run in the order of the generators, whose function binds the pattern of g and computes body, where a
// pattern that is no variable is matched, and the fold of a map takes key and value
function fold_expr(s: State, pos: Pos, span: Span, form: Form, m: Id, targs: List[Type], g: Gen, c: At[Expr], body: At[Expr], base: At[Expr]): At[Expr] :=
  let fold := fold_name(form), acc := form_acc() in
  match g
    case GPair(k, v, _) =>
      let kx := formal_of(s, k, "(key)", key_type(targs)), vx := formal_of(s, v, "(value)", value_type(targs)) in
      form_app(pos, span, m, fold, List(
        c,
        base,
        AOk(pos, span, ELam(if fold == "foldr" then
          List(formal_at(k, kx), formal_at(v, vx), formal_at(c, acc))
        else
          List(formal_at(c, acc), formal_at(k, kx), formal_at(v, vx)), matched(s, pos, span, List((kx, k), (vx, v)), body)))))

    case GVal(p, _) if m == library_module("map") =>
      let kx := Var(unqualified("(key)"), key_type(targs)), vx := Var(unqualified("(value)"), value_type(targs)) in
      form_app(pos, span, m, fold, List(
        c,
        base,
        AOk(pos, span, lambda_of(pos, span, if fold == "foldr" then List(kx, vx, acc) else List(acc, kx, vx), AOk(pos, span, EMatch(scrutinee(pos, span, List(kx, vx)), List(AOk(pos, span, Branch(p, None, body)))))))))

    case GVal(p, _) =>
      let x := formal_of(s, p, "(element)", key_type(targs)) in
      form_app(pos, span, m, fold, List(
        c,
        base,
        AOk(pos, span, ELam(if fold == "foldr" then
          List(formal_at(p, x), formal_at(c, acc))
        else
          List(formal_at(c, acc), formal_at(p, x)), matched(s, pos, span, List((x, p)), body)))))

    case GIf(_) =>
      body
  end

// the types of the first and second type argument of a container, which are those of the elements, or keys and values
function key_type(targs: List[Type]): Type :=
  match targs
    case List(t; _) =>
      t
    case List() =>
      THole
  end

function value_type(targs: List[Type]): Type :=
  match targs
    case List(_, t; _) =>
      t
    case _ =>
      THole
  end

// the variable of a pattern that is one, and else a formal that users cannot name
function formal_of(s: State, p: At[Pat], name: Id, typ: Type): Var :=
  match p.that
    case PVar(x) if is_pvar(s, p) =>
      Var(x.name, typ)
    case _ =>
      Var(unqualified(name), typ)
  end

// body under a match of the formals against the patterns that are not variables
function matched(s: State, pos: Pos, span: Span, pairs: List[Var * At[Pat]], body: At[Expr]): At[Expr] :=
  match List(for q in pairs if not is_pvar(s, second(q)))
    case List() =>
      body

    case ps =>
      AOk(pos, span, EMatch(scrutinee(pos, span, firsts(ps)), List(
        AOk(pos, span, Branch(matched_pattern(pos, span, seconds(ps)), None, body)))))
  end

// a pattern that is a variable, which a name of a constructor or pattern alias is not, as binders resolves it
function is_pvar(s: State, p: At[Pat]): Bool :=
  match p.that
    case PVar(x) =>
      overloads(s, x.name, lambda n => is_pattern_name(s.sig, n)) == List()
    case _ =>
      false
  end

// the variables of patterns that are all variables
function variables_of(s: State, pats: List[At[Pat]]): Option[List[At[Var]]] :=
  if forall(pats, lambda p => is_pvar(s, p)) then
    map_option(pattern_vars(pats), lambda xs => List(for (p, x) in zip(pats, xs) yield AOk(p.pos, p.span, x)))
  else
    None

// overloaded names are resolved by their number of arguments and the types of the arguments and the result,
// where the arguments are inferred first, and a call that no candidate fits by its arity has the type TError, so that its
// uses make no follow-ups
procedure application(
  in  env: Env,
      fun: At[Expr],
      args: List[At[Expr]],
      expected: Option[Type * Str],
  out typed_expr: Expr,
      t: Type,
  ref s: State
) :=
  match fun
    case AOk(_, _, EName(name, typ)) =>
      local cs: List[Name * Scheme] := candidates(s, env, name)
      if size(cs) > 1 then
        local ts: List[Type], typed_args: List[At[Expr]], w: Type, x: Var
        call infers_first(in env, args, out typed_args, ts, ref s)
        call fresh(out t, ref s)
        call normalize(in typ, out w, ref s)
        call unify(in w, TFun(ts, t), ref s)
        if with_arity(cs, size(args)) == List() then
          call   report(in WrongArity(name, size(args)), ref s)
          call   unify(in t, TError, ref s)
          assign x := Var(name, TError)
        else
          call use_name(in name, with_arity(cs, size(args)), w, out x, ref s)
        end
        call   infers_lambdas(in env, args, ts, ref typed_args, s)
        assign typed_expr := EApp(fun with that := EVar(x), typed_args)
      else
        local outer := s.within, typed_args: List[At[Expr]], typed_fun: At[Expr], u: Type
        assign s := s with within := List(InCall(name); outer)
        call   infer(in env, fun, out typed_fun, u, ref s)
        call   apply(in env, u, args, expected, out typed_args, t, ref s)
        assign typed_expr := EApp(typed_fun, typed_args), s := s with within := outer
      end

    case AOk(_, _, ELam(_, _)) =>
      local typed_fun: At[Expr], typed_args: List[At[Expr]], ts: List[Type]
      call   infers(in env, args, out typed_args, ts, ref s)
      call   fresh(out t, ref s)
      call   infer_lambda(in env, fun, TFun(ts, t), out typed_fun, ref s)
      assign typed_expr := EApp(typed_fun, typed_args)

    // also a callee that does not parse, of the type TError
    case _ =>
      local typed_fun: At[Expr], u: Type, typed_args: List[At[Expr]]
      call   infer(in env, fun, out typed_fun, u, ref s)
      call   apply(in env, u, args, expected, out typed_args, t, ref s)
      assign typed_expr := EApp(typed_fun, typed_args)
  end

// the accessor T.f, or for the suffix .f:= the updater T.f:=, applied to expr and the further arguments, of the type T of
// expr, of the module of T, where an unknown type of expr is an error, at pos of the access
procedure field_access(
  in  env: Env,
      pos: Pos,
      span: Span,
      suffix: Id,
      expr: At[Expr],
      rest: List[At[Expr]],
  out typed_expr: Expr,
      t: Type,
  ref s: State
) :=
  local c: At[Expr], u: Type, w: Type, typed_rest: List[At[Expr]], us: List[Type], x: Var
  call infer(in env, expr, out c, u, ref s)
  call infers(in env, rest, out typed_rest, us, ref s)
  call fresh(out t, ref s)
  call fresh(out w, ref s)
  call unify(in w, TFun(List(u; us), t), ref s)
  call solve(ref s)
  match zonk_type(s.sub, u)
    case TSort(Name(Some(m), base), _) =>
      local accessor: Name := Name(Some(m), base ++ suffix)
      match schemes_of(s.sig, accessor)
        case List(sc) if is_visible(s, accessor) =>
          call use(in accessor, w, sc, out x, ref s)

        case _ =>
          call   report(in continued_update(suffix, expr, UnknownField(accessor)), ref s)
          assign x := Var(accessor, w)
      end

    case TMeta(_) =>
      call   report(in UnknownFieldOwner(suffix), ref s)
      assign x := Var(unqualified(suffix), w)

    case v =>
      call   report(in UnknownFieldType(suffix, v), ref s)
      assign x := Var(unqualified(suffix), w)
  end
  assign typed_expr := EApp(AOk(pos, span, EVar(x)), List(c; typed_rest))

// e of an unknown field of the update by suffix .f:= of the update expr, with the hint that the comma before f continued the
// update, where the source likely meant an assignment of a variable f
function continued_update(suffix: Id, expr: At[Expr], e: TypeError): TypeError :=
  match expr
    case AOk(_, _, EUpdate(_, _, _)) if ends_with(suffix, ":=") =>
      Hinted(e, "a comma after with continues the update, so an assignment of " ++ slice(suffix, 1, size(suffix) - 2) ++ " takes an assign of its own")
    case _ =>
      e
  end

procedure apply(
  in  env: Env,
      f: Type,
      args: List[At[Expr]],
      expected: Option[Type * Str],
  out typed_args: List[At[Expr]],
      r: Type,
  ref s: State
) :=
  local ts: List[Type], fitting := false
  call fresh(out r, ref s)
  match (zonk_type(s.sub, f), expected)
    case (TFun(ps, res), Some((t, _))) if size(ps) == size(args) =>
      call fits(in res, t, s, out fitting)
    case _ =>
      skip
  end
  match (zonk_type(s.sub, f), expected)
    // of an unknown function, whose arguments are still checked
    case (TError, _) =>
      call infers_first(in env, args, out typed_args, ts, ref s)
      call infers_lambdas(in env, args, ts, ref typed_args, s)
      call unify(in r, TError, ref s)

    case (TFun(ps, res), Some((t, _))) if fitting =>
      call unify(in res, t, ref s)
      call unify(in res, r, ref s)
      call checks_args(in env, args, ps, out typed_args, ref s)

    case (TFun(ps, res), _) if size(ps) == size(args) =>
      call infers_first(in env, args, out typed_args, ts, ref s)
      for ((a, p), (t, i)) in zip(zip(args, ps), numbered(ts)) do
        call expect(in a.pos, "argument " ++ show(i + 1) ++ " of the call", p, t, ref s)
      end
      call unify(in res, r, ref s)
      call infers_lambdas(in env, args, ts, ref typed_args, s)

    // of a value that no function type fits, whose result is TError, so that its uses make no follow-ups
    case _ =>
      local applicable: Bool
      call infers_first(in env, args, out typed_args, ts, ref s)
      call fits(in f, TFun(ts, r), s, out applicable)
      call unify(in f, TFun(ts, r), ref s)
      call infers_lambdas(in env, args, ts, ref typed_args, s)
      if not applicable then
        call unify(in r, TError, ref s)
      end
  end

// whether u unifies with t, tried on a copy of s
procedure fits(in u: Type, t: Type, s: State, out ok: Bool) :=
  local trial := s
  call   unify(in u, t, ref trial)
  assign ok := size(trial.errors) == size(s.errors)

// the arguments checked against the types of the formals ps, the lambdas last, since they take the types of their formals
// from the other arguments
procedure checks_args(
  in  env: Env,
      args: List[At[Expr]],
      ps: List[Type],
  out typed_args: List[At[Expr]],
  ref s: State
) :=
  local typed: Map[Int, At[Expr]] := Map(), x: At[Expr]
  for ((a, p), i) in zip(zip(args, ps), range(0, size(args))) if not is_lambda(a) do
    call   check(in env, a, p, "argument " ++ show(i + 1) ++ " of the call", out x, ref s)
    assign typed := put(i, x, typed)
  end
  for ((a, p), i) in zip(zip(args, ps), range(0, size(args))) if is_lambda(a) do
    call   check(in env, a, p, "argument " ++ show(i + 1) ++ " of the call", out x, ref s)
    assign typed := put(i, x, typed)
  end
  assign typed_args := List(for (a, i) in zip(args, range(0, size(args))) yield value_or(get(i, typed), a))

// the arguments in order, except the lambdas, which get an unknown type and wait until the type of the function is
// known, so that the formals of a lambda have the types that the function expects, see infers_lambdas
procedure infers_first(
  in  env: Env,
      exprs: List[At[Expr]],
  out typed_exprs: List[At[Expr]],
      ts: List[Type],
  ref s: State
) :=
  local typed_expr: At[Expr], t: Type
  assign typed_exprs := List(), ts := List()
  for expr in exprs do
    if is_lambda(expr) then
      call   fresh(out t, ref s)
      assign typed_expr := expr
    else
      call infer(in env, expr, out typed_expr, t, ref s)
    end
    assign typed_exprs := typed_exprs ++ List(typed_expr), ts := ts ++ List(t)
  end

// lambda x, p => e with a pattern p that is no variable is lambda x, (1) => match (1) case p => e end, with formals that
// users cannot write for the patterns, which are matched in the body as the formals of folds are
function lambda_match(s: State, pos: Pos, span: Span, pats: List[At[Pat]], body: At[Expr]): Expr :=
  let xs := List(for (p, i) in numbered(pats) yield formal_of(s, p, "(" ++ show(i) ++ ")", THole)) in
  ELam(List(for (p, x) in zip(pats, xs) yield formal_at(p, x)), matched(s, pos, span, zip(xs, pats), body))

// the formal x of a lambda that a translation makes, at the part p that it binds, the pattern that it names or the
// container of a fold, so that a formal keeps the span of its pattern
function formal_at[A](p: At[A], x: Var): At[Pat] :=
  AOk(p.pos, p.span, PVar(x))

function matched_pattern(pos: Pos, span: Span, pats: List[At[Pat]]): At[Pat] :=
  match pats
    case List(pat) =>
      pat
    case _ =>
      AOk(pos, span, PTuple(pats))
  end

function scrutinee(pos: Pos, span: Span, xs: List[Var]): At[Expr] :=
  match xs
    case List(x) =>
      AOk(pos, span, EVar(x))
    case _ =>
      AOk(pos, span, ETuple(List(for x in xs yield AOk(pos, span, EVar(x)))))
  end

// the formals of a lambda of variables, typed by the types ps of the function that it is an argument for, where untyped
function typed_formals(expr: Expr, ps: List[Type]): Expr :=
  match expr
    case ELam(formals, body) =>
      ELam(List(for (pat, t) in zip(formals, ps) yield typed_formal(pat, t)), body)
    case _ =>
      expr
  end

function typed_formal(pat: At[Pat], t: Type): At[Pat] :=
  match pat.that
    case PVar(x) if x.typ == THole =>
      pat with that := PVar(Var(x.name, t))
    case _ =>
      pat
  end

function is_lambda(e: At[Expr]): Bool :=
  match e
    case AOk(_, _, ELam(_, _)) =>
      true
    case _ =>
      false
  end

// the lambdas among exprs, whose types are those in types, inferred with the formals that have no type typed by the
// parameters of the function type there, if it is known, where res are the other exprs as infers_first typed them
procedure infers_lambdas(
  in  env: Env,
      exprs: List[At[Expr]],
      types: List[Type],
  ref res: List[At[Expr]],
      s: State
) :=
  local found: List[At[Expr]] := List()
  for ((expr, typed_expr), t) in zip(zip(exprs, res), types) do
    if is_lambda(expr) then
      local typed_lambda: At[Expr]
      call   infer_lambda(in env, expr, t, out typed_lambda, ref s)
      assign found := found ++ List(typed_lambda)
    else
      assign found := found ++ List(typed_expr)
    end
  end
  assign res := found

procedure infer_lambda(
  in  env: Env,
      expr: At[Expr],
      t: Type,
  out typed_expr: At[Expr],
  ref s: State
) :=
  local u: Type
  match (expr.that, zonk_type(s.sub, t))
    case (ELam(formals, body), TFun(ps, _)) if size(ps) == size(formals) =>
      call infer(in env, expr with that := typed_formals(lambda_match(s, expr.pos, expr.span, formals, body), ps), out typed_expr, u, ref s)
    case _ =>
      call infer(in env, expr, out typed_expr, u, ref s)
  end
  call unify(in u, t, ref s)

// expr of the type t, where what names it in a mismatch
procedure check(
  in  env: Env,
      expr: At[Expr],
      t: Type,
      what: Str,
  out typed_expr: At[Expr],
  ref s: State
) :=
  if is_lambda(expr) then
    call infer_lambda(in env, expr, t, out typed_expr, ref s)
  else
    local u: Type
    call infer_against(in env, expr, t, what, out typed_expr, u, ref s)
    call expect(in expr.pos, what, t, u, ref s)
  end

// the type u of the part at pos, which what names, is t, else the mismatch of the whole types at the part, instead of
// the parts of the types that do not unify
procedure expect(in pos: Pos, what: Str, t: Type, u: Type, ref s: State) :=
  local before := s.errors, outer := s.at
  assign s := s with at := pos
  call   unify(in u, t, ref s)
  if exists(drop(size(before), s.errors), is_unify_error) then
    assign s := s with errors := before ++ List(
      within(s, at_use(pos, Mismatch(zonk_type(s.sub, t), zonk_type(s.sub, u), what))))
  end
  assign s := s with at := outer

// e with the hint of a mismatch of an argument of name, ++ for + of strings
function argument_hint(name: Name, e: TypeError): TypeError :=
  match e
    case Located(m, pos, Mismatch(TInt(), TStr(), what)) if name.base == "+" =>
      Located(m, pos, Hinted(Mismatch(TInt(), TStr(), what), "strings join by ++, and + adds integers"))
    case _ =>
      e
  end

function is_unify_error(e: TypeError): Bool :=
  match e
    case Located(_, _, CannotUnify(_, _)) =>
      true

    case CannotUnify(_, _) =>
      true

    case _ =>
      false
  end

// the expressions of what, checked against the types ts, as many
procedure checks(
  in  env: Env,
      what: Str,
      exprs: List[At[Expr]],
      ts: List[Type],
  out typed_exprs: List[At[Expr]],
  ref s: State
) :=
  match (exprs, ts)
    case (List(expr; more), List(t; ts_)) =>
      local typed_expr: At[Expr], rest: List[At[Expr]]
      call   check(in env, expr, t, what, out typed_expr, ref s)
      call   checks(in env, what, more, ts_, out rest, ref s)
      assign typed_exprs := List(typed_expr; rest)

    case (List(), List()) =>
      assign typed_exprs := List()

    // the expressions as they are, of no types
    case _ =>
      call   report(in CountMismatch(what, "values", size(ts), size(exprs)), ref s)
      assign typed_exprs := exprs
  end

procedure infers(
  in  env: Env,
      exprs: List[At[Expr]],
  out typed_exprs: List[At[Expr]],
      ts: List[Type],
  ref s: State
) :=
  local typed_expr: At[Expr], t: Type
  assign typed_exprs := List(), ts := List()
  for expr in exprs do
    call   infer(in env, expr, out typed_expr, t, ref s)
    assign typed_exprs := typed_exprs ++ List(typed_expr), ts := ts ++ List(t)
  end

procedure expr_branches(
  in  env: Env,
      cases: List[At[Branch[At[Expr]]]],
      t: Type,
      r: Type,
  out typed_cases: List[At[Branch[At[Expr]]]],
  ref s: State
) :=
  match cases
    case List() =>
      assign typed_cases := List()

    case List(AOk(pos, span, Branch(pat, g, body)); more) =>
      local typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: At[Expr], rest: List[At[Branch[At[Expr]]]]
      call   typed_pattern(in pat, t, out typed_pat, xs, ref s)
      call   unhidden(in env, xs, ref s)
      call   guard(in bind(xs) ++ env, g, out typed_guard, ref s)
      call   check(in bind(xs) ++ env, body, r, "the case", out typed_body, ref s)
      call   expr_branches(in env, more, t, r, out rest, ref s)
      assign typed_cases := List(AOk(pos, span, Branch(typed_pat, typed_guard, typed_body)); rest)

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

procedure guard(
  in  env: Env,
      g: Option[At[Expr]],
  out typed_guard: Option[At[Expr]],
  ref s: State
) :=
  match g
    case Some(expr) =>
      local typed_expr: At[Expr]
      call   check(in env, expr, TBool(), "the guard", out typed_expr, ref s)
      assign typed_guard := Some(typed_expr)

    case None =>
      assign typed_guard := None
  end

// guarded cases neither cover values for exhaustiveness nor make later cases unreachable
procedure coverage(in t: Type, cs: List[At[Pat] * Bool], ref s: State) :=
  if zonk_type(s.sub, t) != TError then
    call coverage_known(in t, cs, ref s)
  end

// coverage of a type that no error reaches, which says which values there are
procedure coverage_known(in t: Type, cs: List[At[Pat] * Bool], ref s: State) :=
  call reachable(in t, List(), cs, ref s)
  match missing(s.sig, s.sub, List(for p in unguarded(cs) yield List(p)), List(t))
    case Some(List(w; _)) =>
      call report(in NotExhaustive(w), ref s)
    case _ =>
      skip
  end

function unguarded(cs: List[At[Pat] * Bool]): List[Pat] :=
  List(for (p, g) in cs if g yield p.that)

procedure reachable(
  in  t: Type,
      before: List[Pat],
      cs: List[At[Pat] * Bool],
  ref s: State
) :=
  match cs
    case List() =>
      skip

    case List((p, open); rest) =>
      if not is_useful(s.sig, s.sub, List(for q in before yield List(q)), List(p.that), List(t)) then
        call report(in at_use(p.pos, Unreachable(p.that)), ref s)
      end
      if open then
        call reachable(in t, before ++ List(p.that), rest, ref s)
      else
        call reachable(in t, before, rest, ref s)
      end
  end

procedure typed_pattern(
  in  pat: At[Pat],
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  call binders(in pat, t, out typed_pat, xs, ref s)
  call unique(in "pattern variable", List(for x in xs yield x.name), ref s)

// a pattern at its position, where an error inside is reported at the innermost position, and a pattern alias is expanded
// at the position of its use
procedure binders(
  in  pat: At[Pat],
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  match pat
    case AOk(pos, span, node) =>
      local outer := s.at
      assign s := s with at := pos
      call   pattern_binders(in pos, span, node, t, out typed_pat, xs, ref s)
      assign s := s with at := outer

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

procedure pattern_binders(
  in  pos: Pos,
      span: Span,
      pat: Pat,
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  match pat
    case PWild =>
      assign typed_pat := AOk(pos, span, pat), xs := List()

    case PLit(lit) =>
      call   unify(in literal(lit), t, ref s)
      assign typed_pat := AOk(pos, span, PLit(checked_lit(lit))), xs := List()

    case PName(name, typ) =>
      if overloads(s, name, lambda n => is_pattern_name(s.sig, n)) != List() then
        call pattern_binders(in pos, span, PApp(name, List()), t, out typed_pat, xs, ref s)
      else
        local u: Type
        call   normalize(in typ, out u, ref s)
        call   unify(in u, t, ref s)
        assign typed_pat := AOk(pos, span, PName(name, u)), xs := List(Var(name, u))
      end

    // a pattern of an unknown constructor is _, which binds nothing
    case PApp(constr, args) =>
      local k: Option[Name], head: Option[PatHead]
      match overloads(s, constr, lambda n => is_pattern_name(s.sig, n))
        case List(k_) =>
          assign k := Some(k_)

        case List() =>
          call   report(in UnknownConstructor(constr), ref s)
          assign k := None

        case ks =>
          call pattern_constructor(in constr, ks, size(args), t, out k, ref s)
      end
      assign head := match k
        case Some(c) =>
          pat_head(s.sig, c)
        case None =>
          None
      end
      match (k, head)
        case (Some(c), Some(h)) =>
          call constructor_binders(in pos, span, c, h, args, t, out typed_pat, xs, ref s)

        case (Some(_), None) =>
          call   report(in UnknownConstructor(constr), ref s)
          assign typed_pat := AOk(pos, span, PWild), xs := List()

        // a constructor that does not parse binds the variables of its arguments, of unknown types
        case (None, _) if contains(constr.base, s.unparsed) =>
          local qs: List[At[Pat]], ts: List[Type]
          call   fresh_list(in args, out ts, ref s)
          call   binder_list(in args, ts, out qs, xs, ref s)
          assign typed_pat := AOk(pos, span, PWild)

        // reported where k was resolved
        case (None, _) =>
          assign typed_pat := AOk(pos, span, PWild), xs := List()
      end

    case PTuple(args) =>
      local qs: List[At[Pat]], ts: List[Type]
      call   fresh_list(in args, out ts, ref s)
      call   unify(in TTuple(ts), t, ref s)
      call   binder_list(in args, ts, out qs, xs, ref s)
      assign typed_pat := AOk(pos, span, PTuple(qs))
  end

// the constructor or pattern alias k with its head applied to the patterns args, matching t
procedure constructor_binders(
  in  pos: Pos,
      span: Span,
      k: Name,
      head: PatHead,
      args: List[At[Pat]],
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  local m: List[Type * Type], qs: List[At[Pat]]
  call same_length(in head.what ++ " " ++ k.base, "arguments", size(head.args), size(args), ref s)
  call instance(in head.params, out m, ref s)
  call unify(in subst(head.typ, m), t, ref s)
  call binder_list(in args, List(for a in head.args yield subst(a, m)), out qs, xs, ref s)
  match pat_alias_of(s.sig, k)
    case Some(alias) =>
      assign typed_pat := subst_pat(alias.pat, zip(List(for x in alias.formals yield x.name), qs)) with pos := pos, span := span
    case None =>
      assign typed_pat := AOk(pos, span, PApp(k, qs))
  end

// pat with the patterns of sub for its variables
function subst_pat(pat: At[Pat], sub: List[Name * At[Pat]]): At[Pat] :=
  match pat.that
    case PVar(var) =>
      value_or(get(var.name, sub), pat)

    case PApp(constr, args) =>
      pat with that := PApp(constr, List(for a in args yield subst_pat(a, sub)))

    case PTuple(args) =>
      pat with that := PTuple(List(for a in args yield subst_pat(a, sub)))

    case _ =>
      pat
  end

// the one of the constructors ks with k arguments whose datatype fits t, where open uses are solved first if
// several fit, since the variables of the pattern need their types, and None after the error if none or several fit
procedure pattern_constructor(
  in  n: Name,
      ks: List[Name],
      k: Int,
      t: Type,
  out c: Option[Name],
  ref s: State
) :=
  local ok: List[(Name * Scheme) * State]
  call trials(in results(s.sig, ks, k), t, s, out ok)
  if size(ok) > 1 then
    call solve(ref s)
    call trials(in results(s.sig, ks, k), t, s, out ok)
  end
  match ok
    case List(((c_, _), _)) =>
      assign c := Some(c_)

    case List() =>
      call   report(in NoOverload(n, zonk_type(s.sub, t)), ref s)
      assign c := None

    case _ =>
      call   report(in Ambiguous(n, firsts(ok)), ref s)
      assign c := None
  end

// the constructors and pattern aliases of ks with k arguments, each with the scheme of the type that it matches
function results(sig: Sig, ks: List[Name], k: Int): List[Name * Scheme] :=
  match ks
    case List() =>
      List()

    case List(n; rest) =>
      match pat_head(sig, n)
        case Some(head) if size(head.args) == k =>
          List((n, Scheme(head.params, head.typ)); results(sig, rest, k))
        case _ =>
          results(sig, rest, k)
      end
  end

// the head of a pattern, a constructor or a pattern alias, named by what it is, with the params of its declaration, the
// types of its arguments, and the type that it matches
data PatHead :=
  case PatHead(what: Str, params: List[Type], args: List[Type], typ: Type)

function pat_head(sig: Sig, n: Name): Option[PatHead] :=
  match (constr_of(sig, n), pat_alias_of(sig, n))
    case (Some(decl), _) =>
      Some(PatHead("constructor", decl.params, decl.fields, decl.typ))

    case (None, Some(alias)) =>
      Some(PatHead("pattern alias", alias.params, List(for x in alias.formals yield x.typ), alias.typ))

    case (None, None) =>
      None
  end

procedure binder_list(
  in  pats: List[At[Pat]],
      ts: List[Type],
  out qs: List[At[Pat]],
      xs: List[Var],
  ref s: State
) :=
  match (pats, ts)
    case (List(p; more), List(t; ts_)) =>
      local q: At[Pat], ys: List[Var], rest: List[At[Pat]], zs: List[Var]
      call   binders(in p, t, out q, ys, ref s)
      call   binder_list(in more, ts_, out rest, zs, ref s)
      assign qs := List(q; rest), xs := ys ++ zs

    case (List(), List()) =>
      assign qs := List(), xs := List()

    // the components as _ of the expected types, which bind nothing
    case _ =>
      call   report(in CountMismatch("the pattern", "components", size(ts), size(pats)), ref s)
      assign qs := List(for _ in ts yield nowhere(PWild)), xs := List()
  end

procedure variable(
  in  env: Env,
      assignable: List[Name],
      x: Var,
  out y: Var,
  ref s: State
) :=
  match x
    case Var(name, typ) =>
      if not contains(name, assignable) then
        call report(in NotAssignable(name), ref s)
      end
      match get(name, env)
        case Some(l) =>
          local u: Type
          call   normalize(in typ, out u, ref s)
          call   unify(in l.typ, u, ref s)
          assign y := Var(name, l.typ)

        case None =>
          local u: Type
          call   report(in unknown_variable(s, name), ref s)
          assign y := Var(name, TError)
      end
  end

procedure variables(
  in  env: Env,
      assignable: List[Name],
      xs: List[Var],
  out ys: List[Var],
  ref s: State
) :=
  call map_state(in xs, lambda in x: Var, out y: Var, ref r: State =>
    call variable(in env, assignable, x, out y, ref r)
  end, out ys, ref s)

// env tells which variables are assigned on every path to x, and after it
procedure statement(
  in  assignable: List[Name],
      stmt: At[Stmt],
  out y: At[Stmt],
  ref env: Env,
      s: State
) :=
  match stmt
    case AOk(pos, span, node) =>
      local outer := s.at, before := size(s.errors), x: Stmt, errors: List[Diagnostic]
      assign s := s with at := pos
      call   statement_node(in assignable, pos, span, node, out x, ref env, s)
      call   take_errors(in pos, before, out errors, ref s)
      assign y := checked_at(pos, span, x, errors), s := s with at := outer

    // reported by the parser, which may assign every variable, so that no reads after it are errors
    case AUnparsed(_, _, _, _) =>
      assign y := stmt, env := assigned(env, firsts(env))

    // the checker makes error nodes of the parts that the parser read, which it checks once
    case AErr(_, _, _, _) =>
      raise Unexpected("error node")
  end

procedure statement_node(
  in  assignable: List[Name],
      pos: Pos,
      span: Span,
      stmt: Stmt,
  out y: Stmt,
  ref env: Env,
      s: State
) :=
  match stmt
    case SSkip =>
      assign y := stmt

    case SAssign(upd) =>
      local ys: List[Var], exprs: List[At[Expr]]
      call   unique(in "assignment to", List(for x in firsts(upd) yield x.name), ref s)
      call   variables(in env, assignable, firsts(upd), out ys, ref s)
      call   checks(in env, "the assignment", seconds(upd), List(for x in ys yield x.typ), out exprs, ref s)
      assign y := SAssign(zip(ys, exprs)), env := assigned(env, List(for x in ys yield x.name))

    // the types of locals that are initialized at the start of the block may be inferred
    case SBlock(locals, stmts) =>
      local ys: List[Var], xs: List[At[Stmt]], inner: Env
      call   untyped(in locals, initialized(stmts), ref s)
      call   formals(in "local", locals, out ys, ref s)
      call   unhidden(in env, ys, ref s)
      assign inner := unassigned(ys) ++ env
      call   statements(in List(for x in ys yield x.name) ++ assignable, stmts, out xs, ref inner, s)
      assign y := SBlock(retyped(locals, ys), xs), env := drop(size(ys), inner)

    case SIf(cond, left, right) =>
      local c: At[Expr], l: At[Stmt], r: At[Stmt], other: Env
      call   check(in env, cond, TBool(), "the condition of if", out c, ref s)
      assign other := env
      call   statement(in assignable, left, out l, ref env, s)
      call   statement(in assignable, right, out r, ref other, s)
      assign y := SIf(c, l, r), env := joined(env, other)

    // the scope of the loop, which the invariant of a claim of the procedure sees
    case SWhile(cond, body) =>
      local c: At[Expr], l: At[Stmt], inner: Env
      assign s := s with loops := s.loops ++ List((pos, env))
      call   check(in env, cond, TBool(), "the condition of while", out c, ref s)
      assign inner := env
      call   statement(in assignable, body, out l, ref inner, s)
      assign y := SWhile(c, l), s := s with loop_assigned := s.loop_assigned ++ newly_assigned(env, inner)

    // a procedure that a variable holds and the refs are read
    case SCall(proc, ins, outs, refs) =>
      call   call_proc(in env, assignable, proc, ins, outs, refs, out y, ref s)
      call   readables(in env, List(proc; List(for x in refs yield x.name)), ref s)
      assign env := assigned(env, List(for x in outs ++ refs yield x.name))

    case SMatch(arg, cases) =>
      local c: At[Expr], t: Type, bs: List[At[Branch[At[Stmt]]]]
      call   infer(in env, arg, out c, t, ref s)
      call   stmt_branches(in assignable, cases, t, out bs, ref env, s)
      call   solve(ref s)
      call   coverage(in t, List(for br in bs yield case_of(br)), ref s)
      assign y := SMatch(c, bs)

    case SAssert(cond) =>
      local c: At[Expr]
      call   check(in env, cond, TBool(), "the assertion", out c, ref s)
      assign y := SAssert(c)
      if is_parsed(c) and c.that == ELit(LBool(false)) then
        assign env := unreachable(env)
      end

    // the variables after the body are those before, as at the start of a handler, since it raises if the test passes
    case SAssertRaises(typ, pat, body) =>
      local u: Type, p: At[Pat], xs: List[Var], b: At[Stmt], inner: Env := env
      call normalize(in typ, out u, ref s)
      call typed_pattern(in pat, u, out p, xs, ref s)
      match xs
        case List(x; _) =>
          call report(in RaisesVariables(x.name), ref s)
        case List() =>
          skip
      end
      call   statement(in assignable, body, out b, ref inner, s)
      assign y := SAssertRaises(u, p, b)

    case SRaise(value, typ) =>
      local c: At[Expr], t: Type, u: Type
      call   infer(in env, value, out c, t, ref s)
      call   normalize(in typ, out u, ref s)
      call   unify(in t, u, ref s)
      assign y := SRaise(c, t), env := unreachable(env)

    case STry(body, catches) =>
      local l: At[Stmt], hs: List[At[Catch]], other: Env := env
      call   statement(in assignable, body, out l, ref env, s)
      call   handler_list(in assignable, catches, out hs, ref other, s)
      assign y := STry(l, hs), env := joined(env, other)

    // the pattern over each item, irrefutable, whose variables the body sees, which may not run, as of a while
    case SFor(gens, body) =>
      local over: At[Expr], t: Type, typed_pat: At[Pat], xs: List[Var], typed_body: At[Stmt], inner: Env
      call   items(in env, pos, span, loop_container(pos, span, gens), out over, t, ref s)
      call   typed_pattern(in loop_pattern(pos, span, gens), t, out typed_pat, xs, ref s)
      call   solve(ref s)
      call   coverage(in t, List((typed_pat, true)), ref s)
      call   unhidden(in env, xs, ref s)
      assign inner := bind(xs) ++ env
      call   statement(in assignable -- List(for x in xs yield x.name), loop_body(gens, body), out typed_body, ref inner, s)
      assign y := SFor(List(GVal(typed_pat, over)), typed_body)
  end

// the list of the elements of the container c, of type List[t], which is c itself if it is a list, and else built by the fold
// of a generator at pos, where a map gives its pairs
procedure items(
  in  env: Env,
      pos: Pos,
      span: Span,
      c: At[Expr],
  out list: At[Expr],
      t: Type,
  ref s: State
) :=
  local typed_c: At[Expr], u: Type, w: Type
  call   infer(in env, c, out typed_c, u, ref s)
  call   solve(ref s)
  assign w := zonk_type(s.sub, u)
  match w
    case TList(elem) =>
      assign list := typed_c, t := elem

    case _ =>
      local x := Var(unqualified("(container)"), u), item := Var(unqualified("(item)"), THole), typed_list: At[Expr], v: Type
      call   infer(in bind(List(x)) ++ env, AOk(pos, span, EFor(FList, List(GVal(AOk(pos, span, PVar(item)), AOk(pos, span, EVar(x)))), YVal(AOk(pos, span, EVar(item))), None)), out typed_list, v, ref s)
      call   fresh(out t, ref s)
      call   unify(in v, TList(t), ref s)
      assign list := with_container(typed_list, typed_c)
  end

// the container c of a generator without a fold, as the variable x bound to it, which keeps c with its errors and its parts
// that do not parse, which a run reaches
function standing_for(pos: Pos, x: Var, c: At[Expr]): At[Expr] :=
  AOk(pos, c.span, ELet(List((AOk(pos, c.span, PVar(x)), c)), AOk(pos, c.span, EVar(x))))

// the fold of a generator over the variable of its container, applied to the container instead, as is the container that
// stands for a generator without a fold
function with_container(fold: At[Expr], c: At[Expr]): At[Expr] :=
  match fold.that
    case EApp(f, List(_; args)) =>
      fold with that := EApp(f, List(c; args))

    case ELet(List((x, _)), body) =>
      fold with that := ELet(List((x, c)), body)

    case _ =>
      fold
  end

// the container of the generator of a for statement at pos, which the parser makes of one generator and an optional guard
function loop_container(pos: Pos, span: Span, gens: List[Gen]): At[Expr] :=
  match gens
    case List(g; _) =>
      gen_container(g)
    case List() =>
      AOk(pos, span, ETuple(List()))
  end

// the pattern of the generator of a for statement at pos, a pair of key and value over a map
function loop_pattern(pos: Pos, span: Span, gens: List[Gen]): At[Pat] :=
  match gens
    case List(GVal(pat, _); _) =>
      pat

    case List(GPair(key, value, _); _) =>
      AOk(key.pos, span_over(key, value), PTuple(List(key, value)))

    case _ =>
      AOk(pos, span, PWild)
  end

// the body of a for statement under its guard
function loop_body(gens: List[Gen], body: At[Stmt]): At[Stmt] :=
  match gens
    case List(_, GIf(cond)) =>
      AOk(body.pos, body.span, SIf(cond, body, AOk(body.pos, span_at(body.span.stop), SSkip)))
    case _ =>
      body
  end

// the variables that the leading assignments of a block assign one at a time, as local x := e does
function initialized(xs: List[At[Stmt]]): List[Name] :=
  match xs
    case List(AOk(_, _, SAssign(List((x, _)))); rest) =>
      List(x.name; initialized(rest))

    case List(AOk(_, _, SCall(_, _, outs, _)); _) =>
      List(for x in outs yield x.name)

    case _ =>
      List()
  end

// the locals without a type are initialized
procedure untyped(in xs: List[At[Var]], inits: List[Name], ref s: State) :=
  match xs
    case List() =>
      skip

    case List(x; rest) =>
      if has_holes(x.that.typ) and not contains(x.that.name, inits) then
        call report(in at_use(decl_pos(s.at, x.pos), MissingType(x.that.name)), ref s)
      end
      call untyped(in rest, inits, ref s)
  end

procedure statements(
  in  assignable: List[Name],
      xs: List[At[Stmt]],
  out ys: List[At[Stmt]],
  ref env: Env,
      s: State
) :=
  local stmt: At[Stmt]
  assign ys := List()
  for x in xs do
    call   statement(in assignable, x, out stmt, ref env, s)
    assign ys := ys ++ List(stmt)
  end

// the procedures of the program hide the builtin ones
// a variable of a procedure type hides the procedures of that name
procedure call_proc(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match get(p, env)
    case Some(l) =>
      call call_variable(in env, assignable, p, l.typ, ins, outs, refs, out stmt, ref s)
    case None =>
      call call_declared(in env, assignable, p, ins, outs, refs, out stmt, ref s)
  end

procedure call_variable(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      typ: Type,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  local is: List[Type], os: List[Type], rs: List[Type], r: Type, typed_ins: List[At[Expr]], typed_outs: List[Var], typed_refs: List[Var]
  call   fresh_list(in ins, out is, ref s)
  call   fresh_list(in outs, out os, ref s)
  call   fresh_list(in refs, out rs, ref s)
  call   fresh(out r, ref s)
  call   unify(in typ, TProc(is, os, rs, r), ref s)
  call   unique(in "out or ref", List(for y in outs ++ refs yield y.name), ref s)
  call   checks(in env, "procedure " ++ p.base, ins, is, out typed_ins, ref s)
  call   variables(in env, assignable, outs, out typed_outs, ref s)
  call   variables(in env, assignable, refs, out typed_refs, ref s)
  call   unifies(in List(for y in typed_outs ++ typed_refs yield y.typ), os ++ rs, ref s)
  assign stmt := SCall(p, typed_ins, typed_outs, typed_refs)

procedure call_declared(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match overloads(s, p, lambda q => is_proc(s.sig, q))
    case List(q) =>
      call declared_call(in env, assignable, p, q, ins, outs, refs, out stmt, ref s)

    case List() =>
      call declared_call(in env, assignable, p, p, ins, outs, refs, out stmt, ref s)

    case qs =>
      call overloaded_call(in env, assignable, p, qs, ins, outs, refs, out stmt, ref s)
  end

// a call of one of the procedures qs, by the types of its arguments, where the arguments are inferred first
procedure overloaded_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      qs: List[Name],
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  local typed_ins: List[At[Expr]], is: List[Type], typed_outs: List[Var], typed_refs: List[Var], m: Name
  call   unique(in "out or ref", List(for x in outs ++ refs yield x.name), ref s)
  call   infers(in env, ins, out typed_ins, is, ref s)
  call   variables(in env, assignable, outs, out typed_outs, ref s)
  call   variables(in env, assignable, refs, out typed_refs, ref s)
  call   choose(in p, List(for q in qs yield (q, proc_scheme(s.sig, q))), TProc(is, List(for x in typed_outs yield x.typ), List(for x in typed_refs yield x.typ), TTuple(List())), out m, ref s)
  assign stmt := SCall(m, typed_ins, typed_outs, typed_refs)

procedure declared_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      q: Name,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match proc_of(s.sig, q)
    case Some(proc) =>
      local m: List[Type * Type], typed_ins: List[At[Expr]], typed_outs: List[Var], typed_refs: List[Var]
      call   instance(in proc.params, out m, ref s)
      call   same_length(in "procedure " ++ q.base, "ins", size(proc.ins), size(ins), ref s)
      call   same_length(in "procedure " ++ q.base, "outs", size(proc.outs), size(outs), ref s)
      call   same_length(in "procedure " ++ q.base, "refs", size(proc.refs), size(refs), ref s)
      call   unique(in "out or ref", List(for x in outs ++ refs yield x.name), ref s)
      call   checks(in env, "procedure " ++ q.base, ins, List(for t in proc.ins yield subst(t, m)), out typed_ins, ref s)
      call   variables(in env, assignable, outs, out typed_outs, ref s)
      call   variables(in env, assignable, refs, out typed_refs, ref s)
      call   unifies(in List(for x in typed_outs ++ typed_refs yield x.typ), List(for t in proc.outs ++ proc.refs yield subst(t, m)), ref s)
      assign stmt := SCall(q, typed_ins, typed_outs, typed_refs)

    // a call that does nothing, of an unknown procedure
    case None =>
      call   report(in UnknownProcedure(p), ref s)
      assign stmt := SSkip
  end

// env joins what the cases assign, where a match that no case fits raises
procedure stmt_branches(
  in  assignable: List[Name],
      cases: List[At[Branch[At[Stmt]]]],
      t: Type,
  out typed_cases: List[At[Branch[At[Stmt]]]],
  ref env: Env,
      s: State
) :=
  match cases
    case List() =>
      assign typed_cases := List(), env := unreachable(env)

    case List(AOk(pos, span, Branch(pat, g, body)); more) =>
      local typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: At[Stmt], rest: List[At[Branch[At[Stmt]]]], inner: Env
      call   typed_pattern(in pat, t, out typed_pat, xs, ref s)
      call   unhidden(in env, xs, ref s)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out typed_guard, ref s)
      call   statement(in assignable -- List(for x in xs yield x.name), body, out typed_body, ref inner, s)
      call   stmt_branches(in assignable, more, t, out rest, ref env, s)
      assign typed_cases := List(AOk(pos, span, Branch(typed_pat, typed_guard, typed_body)); rest), env := joined(drop(size(xs), inner), env)

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

// handlers start from the variables before the try, which an exception restores
procedure handler_list(
  in  assignable: List[Name],
      handlers: List[At[Catch]],
  out typed_handlers: List[At[Catch]],
  ref env: Env,
      s: State
) :=
  match handlers
    case List() =>
      assign typed_handlers := List(), env := unreachable(env)

    case List(AOk(pos, span, Catch(typ, pat, g, body)); more) =>
      local u: Type, typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: At[Stmt], rest: List[At[Catch]], inner: Env
      call   normalize(in typ, out u, ref s)
      call   typed_pattern(in pat, u, out typed_pat, xs, ref s)
      call   unhidden(in env, xs, ref s)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out typed_guard, ref s)
      call   statement(in assignable -- List(for x in xs yield x.name), body, out typed_body, ref inner, s)
      call   handler_list(in assignable, more, out rest, ref env, s)
      assign typed_handlers := List(AOk(pos, span, Catch(u, typed_pat, typed_guard, typed_body)); rest), env := joined(drop(size(xs), inner), env)

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

procedure declare_name(in sig: Sig, n: Name) :=
  if is_fun(sig, n) or is_proc(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n) or builtin_schemes(unqualified(n.base)) != List() then
    raise AlreadyDefined(n)
  end

// functions of the same name must differ in their number of arguments, while they may overload builtins
procedure overload(in sig: Sig, n: Name, k: Int) :=
  if is_proc(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n) or has_arity(schemes_of(sig, n), k) then
    raise AlreadyDefined(n)
  end

procedure declare_sort(in sig: Sig, n: Name) :=
  if n.base == "->" or is_type_alias(sig, n) or is_data(sig, n) then
    raise SortDefined(n)
  end

// the type parameters of ts are declared, where an unknown is the fallback of an error reported before
procedure closed(in n: Name, ps: List[Id], ts: List[Type], ref s: State) :=
  local undeclared := List(for v in distinct(List(for t in ts for v in free(t) yield v)) -- params(ps) if not is_meta(v))
  if undeclared != List() then
    call report(in UndeclaredParams(n, undeclared), ref s)
  end

function is_meta(t: Type): Bool :=
  match t
    case TMeta(_) =>
      true
    case _ =>
      false
  end

// datatypes may be mutually recursive, so they are known before any sort is checked
procedure declare_datas(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(name, params, _) =>
        assign s := enter(s, m)
        call   declare_sort(in s.sig, name)
        assign s := with_sig(s, with_data(s.sig, name, size(params)))

      case _ =>
        skip
    end
  end

procedure declare_sorts(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CSort(name, params, typ) =>
        local u: Type
        assign s := enter(s, m)
        call   declare_sort(in s.sig, name)
        call   unique_ids(in "type parameter", params, ref s)
        call   known(in typ, name, out u, ref s)
        call   closed(in name, params, List(u), ref s)
        assign s := with_sig(s, with_type_alias(s.sig, name, TypeAlias(params, u)))

      case _ =>
        skip
    end
  end

procedure declare_constrs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(n, params, constrs) =>
        assign s := enter(s, m)
        call   unique_ids(in "type parameter", params, ref s)
        assign s := with_sig(s, with_members(s.sig, n, List(for k in parts(constrs) yield k.name)))
        call   declare_constructors(in n, params, constrs, ref s)
        call   declare_fields(in n, params, datatype_fields(s.sig, params, parts(constrs)), ref s)

      case _ =>
        skip
    end
  end

// each constructor at its position
procedure declare_constructors(
  in  n: Name,
      ps: List[Id],
      ks: List[At[Constr]],
  ref s: State
) :=
  for k in ks do
    try
      assign s := s with at := k.pos
      call   declare_constructor(in n, ps, k.that, ref s)
    catch
      case e =>
        raise at_use(k.pos, e)
    end
  end

procedure declare_constructor(in n: Name, ps: List[Id], k: Constr, ref s: State) :=
  local ts: List[Type]
  call   declare_name(in s.sig, k.name)
  call   knowns(in List(for field in k.fields yield field.typ), k.name, out ts, ref s)
  call   closed(in n, ps, ts, ref s)
  assign s := with_sig(s, with_constr(s.sig, k.name, ConstrSig(params(ps), ts, TSort(n, params(ps)))))

// the accessor T.f and the updater T.f:= of each field f of the datatype T, which have no definitions, since the
// interpreter and the compiler implement them by the positions of the fields (fields of Defs)
procedure declare_fields(
  in  n: Name,
      ps: List[Id],
      fields: List[Id * Type],
  ref s: State
) :=
  local t := TSort(n, params(ps))
  for (f, u) in fields do
    assign s := with_sig(s, with_fun(with_fun(s.sig, accessor_name(n, f), Scheme(params(ps), TFun(List(t), u))), updater_name(n, f), Scheme(params(ps), TFun(List(t, u), t))))
  end

// each field of the constructors once, with its type as the constructor that declares it first has it, which is that of
// the others, since the parser rejects a field with different types
function datatype_fields(sig: Sig, ps: List[Id], ks: List[Constr]): List[Id * Type] :=
  first_fields(List(for k in ks for p in zip(List(for field in k.fields yield field.name), constr_fields(sig, k.name, params(ps))) yield p))

function first_fields(fields: List[Id * Type]): List[Id * Type] :=
  match fields
    case List() =>
      List()
    case List((f, u); rest) =>
      List((f, u); first_fields(List(for p in rest if first(p) != f)))
  end

procedure declare_funs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CFun(name, ps, formals, typ, _, _) =>
        local xs: List[Var], r: Type
        assign s := enter(s, m)
        call   overload(in s.sig, name, size(formals))
        call   unique_ids(in "type parameter", ps, ref s)
        call   signature(in formals, out xs, ref s)
        call   known(in typ, name, out r, ref s)
        call   closed(in name, ps, List(TFun(List(for x in xs yield x.typ), r)), ref s)
        assign s := with_sig(s, with_fun(s.sig, name, Scheme(params(ps), TFun(List(for x in xs yield x.typ), r))))

      case _ =>
        skip
    end
  end

// each alias after the constructors and the aliases before it, so that aliases do not recur, with the function of the
// same name that builds its values where its pattern has no _
procedure declare_pat_aliases(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CPatAlias(name, ps, formals, typ, pat) =>
        local xs: List[Var], r: Type, checked: At[Pat], ys: List[Var]
        assign s := enter(s, m)
        call   declare_name(in s.sig, name)
        call   unique_ids(in "type parameter", ps, ref s)
        call   signature(in formals, out xs, ref s)
        call   known(in typ, name, out r, ref s)
        call   closed(in name, ps, List(TFun(List(for x in xs yield x.typ), r)), ref s)
        call   typed_pattern(in pat, r, out checked, ys, ref s)
        if Set(for y in ys yield y.name) != Set(for x in xs yield x.name) then
          call report(in AliasVariables(name), ref s)
        end
        for y in ys do
          call unify(in y.typ, value_or(map_option(find(xs, lambda x => x.name == y.name), lambda x => x.typ), y.typ), ref s)
        end
        call   solve(ref s)
        assign s := with_sig(s, with_pat_alias(s.sig, name, PatAlias(params(ps), xs, r, zonk_pat(s, checked))))
        if pattern_expr(pat) != None then
          assign s := with_sig(s, with_fun(s.sig, name, Scheme(params(ps), TFun(List(for x in xs yield x.typ), r))))
        end

      case _ =>
        skip
    end
  end

// the proof of a lemma over its formals and the locals of the proof, see ideas/prove.md, section 4: the steps in their order,
// each adding its local to env, then the split, whose cases are proofs with the variables of their patterns
procedure check_proof(
  in  formals: List[Var],
      outs: List[Name],
      proof: Proof,
  out typed_proof: Proof,
  ref env: Env,
      s: State
) :=
  local steps: Buffer[At[Step]] := empty(), split: Option[At[Split]] := None
  for step in proof.steps do
    local typed_step: Step, outer := s.at
    assign s := s with at := step.pos
    call   proof_step(in outs, step.that, out typed_step, ref env, s)
    assign steps := steps ++ List(AOk(step.pos, step.span, typed_step)), s := s with at := outer
  end
  match proof.split
    case Some(placed) =>
      local typed_split: Split, outer := s.at
      assign s := s with at := placed.pos
      call   proof_split(in formals, outs, placed.that, out typed_split, ref env, s)
      assign split := Some(AOk(placed.pos, placed.span, typed_split)), s := s with at := outer

    case None =>
      skip
  end
  assign typed_proof := Proof(List(for step in steps), split)

// a step, where a local with a value is a definition and one without a witness that an out of a call binds, a call is of
// a lemma of the module, and an assignment gives the witnesses of the outs of the lemma, each once
procedure proof_step(
  in  assignable: List[Name],
      step: Step,
  out typed_step: Step,
  ref env: Env,
      s: State
) :=
  match step
    case StepLocal(x, Some(e)) =>
      local c: At[Expr], y: Var, t: Type
      if x.that.typ == THole then
        call   infer(in env, e, out c, t, ref s)
        assign y := Var(x.that.name, t)
      else
        local ys: List[Var]
        call   formals(in "local", List(x), out ys, ref s)
        assign y := at(0, from_list(ys))
        call   check(in env, e, y.typ, "the local " ++ x.that.name.base, out c, ref s)
      end
      call   unhidden(in env, List(y), ref s)
      assign env := bind(List(y)) ++ env, typed_step := StepLocal(map_at(x, lambda _ => y), Some(c))

    case StepLocal(x, None) =>
      local ys: List[Var]
      call   untyped(in List(x), List(), ref s)
      call   formals(in "local", List(x), out ys, ref s)
      call   unhidden(in env, ys, ref s)
      assign env := List(for y in ys yield (y.name, Local(y.typ, false))) ++ env, typed_step := StepLocal(map_at(x, lambda _ => at(0, from_list(ys))), None)

    case StepCall(name, ins, outs) =>
      local qualified := in_module(s.module, name), typed_ins: List[At[Expr]] := ins, typed_outs: List[Var] := outs
      match lemma_of(s.sig, qualified)
        case Some(lemma_sig) if lemma_sig.claim =>
          call report(in ClaimCalled(name), ref s)

        case Some(lemma_sig) =>
          local m: List[Type * Type]
          call instance(in lemma_sig.params, out m, ref s)
          if size(ins) != size(lemma_sig.formals) then
            call report(in CountMismatch("lemma " ++ name.base, "arguments", size(lemma_sig.formals), size(ins)), ref s)
          else
            call checks(in env, "lemma " ++ name.base, ins, List(for t in lemma_sig.formals yield subst(t, m)), out typed_ins, ref s)
          end
          if size(outs) != size(lemma_sig.outs) then
            call report(in CountMismatch("lemma " ++ name.base, "outs", size(lemma_sig.outs), size(outs)), ref s)
          else
            call   variables(in env, unbound(env), outs, out typed_outs, ref s)
            call   unifies(in List(for y in typed_outs yield y.typ), List(for t in lemma_sig.outs yield subst(t, m)), ref s)
            assign env := assigned(env, List(for y in outs yield y.name))
          end

        case None =>
          call report(in UnknownLemma(name), ref s)
      end
      assign typed_step := StepCall(qualified, typed_ins, typed_outs)

    case StepAssert(cond) =>
      local c: At[Expr]
      call   check(in env, cond, TBool(), "the assertion", out c, ref s)
      assign typed_step := StepAssert(c)

    // claim_proof checks those of claims
    case StepInvariant(_) =>
      call   report(in InvariantOutsideClaim, ref s)
      assign typed_step := step

    case StepAssign(upd) =>
      local ys: List[Var], exprs: List[At[Expr]]
      call   unique(in "assignment to", List(for x in firsts(upd) yield x.name), ref s)
      call   variables(in env, List(for o in assignable if contains(o, unbound(env)) yield o), firsts(upd), out ys, ref s)
      call   checks(in env, "the assignment", seconds(upd), List(for y in ys yield y.typ), out exprs, ref s)
      assign typed_step := StepAssign(zip(ys, exprs)), env := assigned(env, List(for y in ys yield y.name))
  end

// the variables of env that are not assigned yet, the witnesses of a proof and the outs of its lemma
function unbound(env: Env): List[Name] :=
  List(for (n, l) in env if not l.assigned yield n)

// a split of a proof, where induction is on a formal of a datatype of the lemma
procedure proof_split(
  in  formals: List[Var],
      outs: List[Name],
      split: Split,
  out typed_split: Split,
  ref env: Env,
      s: State
) :=
  match split
    case SplitInduction(x, cases) =>
      local t: Type, typed_cases: List[At[Branch[Proof]]]
      match List(for f in formals if f.name == x.name and (is_datatype_type(s, f.typ) or zonk_type(s.sub, f.typ) == TInt()) yield f.typ)
        case List(u; _) =>
          assign t := u

        case List() =>
          call report(in NotInducible(x.name), ref s)
          call fresh(out t, ref s)
      end
      call   proof_cases(in formals, outs, cases, t, out typed_cases, ref env, s)
      assign typed_split := SplitInduction(Var(x.name, t), typed_cases)

    case SplitMatch(arg, cases) =>
      local c: At[Expr], t: Type, typed_cases: List[At[Branch[Proof]]]
      call   infer(in env, arg, out c, t, ref s)
      call   proof_cases(in formals, outs, cases, t, out typed_cases, ref env, s)
      assign typed_split := SplitMatch(c, typed_cases)

    case SplitIf(cond, left, right) =>
      local c: At[Expr], l: Proof, r: Option[Proof] := None, inner := env, other := env
      call check(in env, cond, TBool(), "the condition", out c, ref s)
      call check_proof(in formals, outs, left, out l, ref inner, s)
      match right
        case Some(p) =>
          local q: Proof
          call   check_proof(in formals, outs, p, out q, ref other, s)
          assign r := Some(q)

        case None =>
          skip
      end
      assign typed_split := SplitIf(c, l, r), env := joined(outer_part(inner, env), outer_part(other, env))
  end

// a type of a datatype with constructors, which builtin types such as Int have none of
// the variables of env in inner, the environment of a block inside, which adds its own in front
function outer_part(inner: Env, env: Env): Env :=
  drop(size(inner) - size(env), inner)

function is_datatype_type(s: State, t: Type): Bool :=
  match zonk_type(s.sub, t)
    case TSort(name, _) =>
      value_or(members_of(s.sig, name), List()) != List()
    case _ =>
      false
  end

// the cases of a split, each a proof with the variables of its pattern, from env, after which a variable is assigned if
// every case assigns it, and the cases that are not written count as paths that do not
procedure proof_cases(
  in  formals: List[Var],
      outs: List[Name],
      cases: List[At[Branch[Proof]]],
      t: Type,
  out typed_cases: List[At[Branch[Proof]]],
  ref env: Env,
      s: State
) :=
  local found: Buffer[At[Branch[Proof]]] := empty(), after := unreachable(env)
  for placed in cases do
    local typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: Proof, inner: Env
    call   typed_pattern(in placed.that.pat, t, out typed_pat, xs, ref s)
    call   unhidden(in env, xs, ref s)
    assign inner := bind(xs) ++ env
    call   guard(in inner, placed.that.guard, out typed_guard, ref s)
    call   check_proof(in formals, outs, placed.that.body, out typed_body, ref inner, s)
    assign found := found ++ List(
      AOk(placed.pos, placed.span, Branch(typed_pat, typed_guard, typed_body))), after := joined(after, outer_part(inner, env))
  end
  assign typed_cases := List(for c in found)
  if not covers_all(s.sig, zonk_type(s.sub, t), List(for c in found if c.that.guard == None yield strip_pat(c.that.pat).that)) then
    assign after := joined(after, env)
  end
  assign env := after

// lemmas have names of their own, apart from the values, which they may share
procedure declare_lemmas(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CLemma(name, ps, formals, outs, claim, _) =>
        local xs: List[Var], ys: List[Var]
        assign s := enter(s, m)
        if lemma_of(s.sig, name) != None then
          raise AlreadyDefined(name)
        end
        call   unique_ids(in "type parameter", ps, ref s)
        call   signature(in formals ++ outs, out xs, ref s)
        call   closed(in name, ps, List(for x in xs yield x.typ), ref s)
        assign ys := drop(size(formals), xs), xs := take(size(formals), xs)
        assign s := with_sig(s, with_lemma(s.sig, name, LemmaSig(params(ps), List(for x in xs yield x.typ), List(for y in ys yield y.typ), is_claim(claim))))

      case _ =>
        skip
    end
  end

function is_claim(claim: Claim): Bool :=
  match claim
    case ClaimCorrect(_, _, _) =>
      true
    case ClaimHolds(_, _) =>
      false
  end

procedure declare_procs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CProc(name, ps, ins, outs, refs, raised, _, _) =>
        local xs: List[Var], ts: List[Type], typed_raised: List[Type]
        assign s := enter(s, m)
        call   declare_name(in s.sig, name)
        call   unique_ids(in "type parameter", ps, ref s)
        call   signature(in ins ++ outs ++ refs, out xs, ref s)
        call   normalizes(in raised, out typed_raised, ref s)
        call   exceptions(in typed_raised, ref s)
        assign ts := List(for x in xs yield x.typ)
        call   closed(in name, ps, ts, ref s)
        assign s := match split_at(size(ins), ts)
          case (in_types, others) =>
            match split_at(size(outs), others)
              case (out_types, ref_types) =>
                with_sig(s, with_proc(s.sig, name, ProcSig(params(ps), in_types, out_types, ref_types, typed_raised)))
            end
        end

      case _ =>
        skip
    end
  end

procedure command(in cmd: Cmd, out typed_cmd: Cmd, ref s: State) :=
  match cmd
    case CFun(name, params, formals, typ, _, body) =>
      local xs: List[Var], r: Type, b: At[Expr]
      call   signature(in formals, out xs, ref s)
      call   known(in typ, name, out r, ref s)
      call   check(in bind(xs), body, r, "the result of " ++ name.base, out b, ref s)
      assign typed_cmd := CFun(name, params, retyped(formals, xs), r, no_spec(), b)

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      local is: List[Var], os: List[Var], rs: List[Var], typed_raised: List[Type], y: At[Stmt], env: Env, typed_spec: Spec
      call   signature(in ins, out is, ref s)
      call   signature(in outs, out os, ref s)
      call   signature(in refs, out rs, ref s)
      call   normalizes(in raised, out typed_raised, ref s)
      assign env := bind(is) ++ unassigned(os) ++ bind(rs)
      call   contract(in is, os, rs, spec, out typed_spec, ref s)
      call   statement(in List(for x in os ++ rs yield x.name), stmt, out y, ref env, s)
      call   outputs(in name, os, env, ref s)
      assign typed_cmd := CProc(name, params, retyped(ins, is), retyped(outs, os), retyped(refs, rs), typed_raised, typed_spec, y)

    // a test with formals runs as the test over their enumerated values that the tester generates of it
    // (enumerated_tests of ulang/test/generate.u)
    case CTest(name, formals, stmt) =>
      local xs: List[Var], y: At[Stmt], env: Env
      call   signature(in formals, out xs, ref s)
      assign env := bind(xs)
      call   statement(in List(), stmt, out y, ref env, s)
      assign typed_cmd := CTest(name, retyped(formals, xs), y)

    case CData(name, params, constrs) =>
      assign typed_cmd := CData(name, params, List(for k in constrs yield map_at(k, lambda c => resolved_fields(s.sig, c))))

    case CLemma(name, params, ins, outs, ClaimHolds(assms, concl), proof) =>
      local xs: List[Var], ys: List[Var], checked: List[At[Expr]] := List(), c: At[Expr], typed_proof: Option[Proof] := None
      call signature(in ins, out xs, ref s)
      call signature(in outs, out ys, ref s)
      for a in assms do
        local b: At[Expr]
        call   check(in bind(xs), a, TBool(), "the assumption", out b, ref s)
        assign checked := checked ++ List(b)
      end
      call check(in bind(xs ++ ys), concl, TBool(), "the conclusion", out c, ref s)
      match proof
        case Some(p) =>
          local env := bind(xs) ++ unassigned(ys), q: Proof
          call   check_proof(in xs, List(for y in ys yield y.name), p, out q, ref env, s)
          call   outputs(in name, ys, env, ref s)
          assign typed_proof := Some(q)

        case None =>
          skip
      end
      assign typed_cmd := CLemma(name, params, retyped(ins, xs), retyped(outs, ys), ClaimHolds(checked, c), typed_proof)

    // the call of the claim assigns the outs of the lemma, and the invariants are over the scopes of the loops
    case CLemma(name, params, ins, outs, ClaimCorrect(proc, args, call_outs), proof) =>
      local xs: List[Var], ys: List[Var], env: Env, y: Stmt, claim: Claim := ClaimCorrect(proc, args, call_outs), typed_proof: Option[Proof] := None
      call   signature(in ins, out xs, ref s)
      call   signature(in outs, out ys, ref s)
      assign env := bind(xs) ++ unassigned(ys)
      call   call_declared(in env, List(for x in ys yield x.name), proc, args, call_outs, List(), out y, ref s)
      call   solve(ref s)
      match y
        case SCall(q, typed_ins, typed_outs, _) =>
          if List(for x in typed_outs yield x.name) != List(for x in ys yield x.name) then
            call report(in ClaimOuts(name), ref s)
          end
          assign claim := ClaimCorrect(q, typed_ins, typed_outs)
          match (get(settled(s, q), s.scopes), proof)
            case (Some(scopes), Some(p)) =>
              local typed: Proof
              call   claim_proof(in name, scopes, p, out typed, ref s)
              assign typed_proof := Some(typed)

            // without a proof, the invariant of every loop is true
            case (Some(_), None) =>
              skip

            case (None, _) =>
              call report(in ClaimOrder(proc), ref s)
          end

        // call_declared reported the unknown procedure
        case _ =>
          skip
      end
      assign typed_cmd := CLemma(name, params, retyped(ins, xs), retyped(outs, ys), claim, typed_proof)

    case _ =>
      assign typed_cmd := cmd
  end

// the contract of a procedure, the requires over its ins and refs, the ensures over all its formals
procedure contract(
  in  ins: List[Var],
      outs: List[Var],
      refs: List[Var],
      spec: Spec,
  out typed_spec: Spec,
  ref s: State
) :=
  local pre: Buffer[At[Expr]] := empty(), post: Option[At[Expr]] := None
  for a in spec.pre do
    local b: At[Expr]
    call   check(in bind(ins ++ refs), a, TBool(), "the requires", out b, ref s)
    assign pre := pre ++ List(b)
  end
  match spec.post
    case Some(e) =>
      local c: At[Expr]
      call   check(in bind(ins ++ outs ++ refs), e, TBool(), "the ensures", out c, ref s)
      assign post := Some(c)

    case None =>
      skip
  end
  assign typed_spec := Spec(List(for a in pre), post, spec.examples)

// the proof of the claim name, its invariants, each over the scope of its loop, the first of scopes for the first
procedure claim_proof(
  in  name: Name,
      scopes: List[Env],
      proof: Proof,
  out typed_proof: Proof,
  ref s: State
) :=
  local invariants: Buffer[At[Step]] := empty(), written := List(for step in proof.steps if is_invariant(step.that) yield step)
  if proof.split != None or size(written) != size(proof.steps) then
    call report(in ClaimStep(name), ref s)
  end
  if size(written) != size(scopes) then
    call report(in CountMismatch("the proof of " ++ name.base, "invariants", size(scopes), size(written)), ref s)
  end
  for (step, env) in zip(written, scopes) do
    match step.that
      case StepInvariant(cond) =>
        local c: At[Expr], outer := s.at
        assign s := s with at := step.pos
        call   check(in env, cond, TBool(), "the invariant", out c, ref s)
        assign invariants := invariants ++ List(AOk(step.pos, step.span, StepInvariant(c))), s := s with at := outer

      // written has only invariants
      case _ =>
        skip
    end
  end
  assign typed_proof := Proof(List(for step in invariants), None)

function is_invariant(step: Step): Bool :=
  match step
    case StepInvariant(_) =>
      true
    case _ =>
      false
  end

// the constructor k with the types of its fields resolved, as declare_constructors declared them
function resolved_fields(sig: Sig, k: Constr): Constr :=
  match constr_of(sig, k.name)
    case Some(constr) =>
      k with fields := List(for (field, typ) in zip(k.fields, constr.fields) yield field with typ := typ)
    case None =>
      k
  end

procedure commands(
  in  cmds: List[Id * Cmd],
  out typed_cmds: List[Cmd],
  ref s: State
) :=
  match cmds
    case List() =>
      assign typed_cmds := List()

    case List((m, cmd); more) =>
      local taken := s.taken, typed_cmd: Cmd, zonked: Cmd, rest: List[Cmd]
      assign s := enter(s, m) with loops := List()
      call   command(in cmd, out typed_cmd, ref s)
      call   settle(ref s)
      assign s := with_scopes(s, typed_cmd)
      if not s.partial or part_errors(cmd) == List() then
        assign zonked := zonk_cmd(s, typed_cmd)
        match unknown_in_cmd(zonked)
          case Some((pos, t)) =>
            assign s := s with errors := s.errors ++ List(at_use(pos, UnknownException(t)))
          case None =>
            skip
        end
      else
        assign zonked := cmd, s := s with taken := taken
      end
      call   commands(in more, out rest, ref s)
      assign typed_cmds := List(zonked; rest)
  end

// s with the scopes of the loops of the checked procedure cmd, one per while of its body in the order of the source, as
// the invariants of its claims are written, with their types, which the next command, after enter, no longer knows
function with_scopes(s: State, cmd: Cmd): State :=
  match cmd
    case CProc(name, _, _, _, _, _, _, stmt) =>
      let scopes := Map(for (pos, env) in s.loops yield pos => List(for (n, l) in env yield (n, l with typ := zonk_type(s.sub, l.typ)))) in
      s with scopes := put(name, List(for pos in loop_positions(stmt) for env in get(pos, scopes) yield env), s.scopes)

    case _ =>
      s
  end

// tests are chosen by name, so a name of a test of module d is not repeated, where the error is at the second test
procedure unique_tests(in d: Mod, ref s: State) :=
  local seen: Set[Id] := empty(), found := false
  for (pos, (_, cmd)) in decls_of(d) do
    match cmd
      case CTest(name, _, _) =>
        if contains(name.base, seen) and not found then
          assign found := true
          assign s := s with errors := s.errors ++ List(Located(Some(d.name), pos, Duplicate("declaration", name.base)))
        end
        assign seen := seen ++ Set(name.base)

      case _ =>
        skip
    end
  end

// only abstract types declare equalities, since matching tells the values of other datatypes apart by their constructors,
// and the orders and equalities of exported datatypes are exported, since they change what the builtins do for importers
procedure check_orders(
  in  cmds: List[Cmd],
      abstract: List[Name],
      hidden: Set[Name],
      hidden_sorts: List[Name]
) :=
  match cmds
    case List() =>
      skip

    case List(c; rest) =>
      match (c, order_of(c))
        case (_, Some((HookEquality, t))) if not contains(t, abstract) =>
          raise VisibleEquality(t)

        case (CFun(name, _, formals, _, _, _), None) =>
          match hook_of(name.base, size(formals))
            case Some(hook) =>
              raise MisshapenHook(name, hook)
            case None =>
              call check_orders(in rest, abstract, hidden, hidden_sorts)
          end

        case (CFun(name, _, _, _, _, _), Some((_, t))) if contains(name, hidden) and not contains(t, hidden_sorts) =>
          raise UnexportedOrder(name, t)

        case _ =>
          call check_orders(in rest, abstract, hidden, hidden_sorts)
      end
  end

// the commands of ds without signatures and abstract types, which only the checks of sections need
function is_definition(d: Id * Cmd): Bool :=
  match d
    case (_, CFunSig(_, _, _, _, _)) =>
      false

    case (_, CProcSig(_, _, _, _, _, _, _)) =>
      false

    case (_, CAbstract(_, _)) =>
      false

    case _ =>
      true
  end

// the signatures and types of the builtin section of d as definitions to declare, whose definitions the interpreter and the
// runtime give, where a type is a datatype without constructors, whose values the interpreter and the runtime make
function natives(d: Mod): List[Id * Cmd] :=
  List(for c in commands_of(d.builtins) yield (d.name, native(qualify(d.name, c))))

function native(cmd: Cmd): Cmd :=
  match cmd
    case CFunSig(name, params, formals, typ, _) =>
      CFun(name, params, formals, typ, no_spec(), nowhere(ELit(LUnit)))

    case CProcSig(name, params, ins, outs, refs, raised, _) =>
      CProc(name, params, ins, outs, refs, raised, no_spec(), nowhere(SSkip))

    case CAbstract(name, params) =>
      CData(name, params, List())

    case _ =>
      cmd
  end

function abstract_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case List() =>
      List()

    case List((_, CAbstract(name, _)); rest) =>
      List(name; abstract_types(rest))

    case List(_; rest) =>
      abstract_types(rest)
  end

// the declarations of an implementation section that the export section does not export, with the constructors and fields
// of abstract types
function private_names(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  List(for c in im for n in private_in(c, ex) yield n)

function private_in(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CFun(name, _, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then List() else List(name)

    case CProc(name, _, _, _, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then List() else List(name)

    case CData(t, _, constrs) =>
      let members := List(for k in parts(constrs) yield k.name) ++ List(for f in field_names(parts(constrs)) for n in List(accessor_name(t, f), updater_name(t, f)) yield n) in
      if exists(ex, lambda e => abstracts(e, t)) then
        members
      else
        List(t; members)

    case CSort(name, _, _) =>
      List(name)

    case CPatAlias(name, _, _, _, _) =>
      List(name)

    case CLemma(name, _, _, _, _, _) =>
      List(name)

    case CTest(_, _, _) =>
      List()

    // notations, signatures, and abstract types, which enter_section of ulang/parse/parse.u keeps out of implementation sections
    case _ =>
      List()
  end

// the sorts of an implementation section that the export section does not export, not even as abstract types
function private_sorts(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  List(for c in im for n in private_sort(c, ex) yield n)

function private_sort(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CData(name, _, _) =>
      if exists(ex, lambda e => abstracts(e, name)) then List() else List(name)

    case CSort(name, _, _) =>
      List(name)

    case _ =>
      List()
  end

function signs(e: Cmd, n: Name): Bool :=
  match e
    case CFunSig(name, _, _, _, _) =>
      name == n

    case CProcSig(name, _, _, _, _, _, _) =>
      name == n

    case _ =>
      false
  end

function abstracts(e: Cmd, t: Name): Bool :=
  match e
    case CAbstract(name, _) =>
      name == t
    case _ =>
      false
  end

// the function n of k arguments, the procedure n, and the datatype n
function defines_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFun(name, _, formals, _, _, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

function defines_proc(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, _, _, _, _, _, _) =>
      name == n
    case _ =>
      false
  end

function defines_data(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CData(name, _, _) =>
      name == n
    case _ =>
      false
  end

function signs_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFunSig(name, _, formals, _, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

// the signatures of ex, each of which the implementation section im defines once and exactly as written, where an error
// is at the second signature of a name, at the definition that differs, or at the signature without a definition
procedure check_signatures(in ex: List[Pos * Cmd], im: List[Pos * Cmd]) :=
  match ex
    case List() =>
      skip

    case List((pos, CFunSig(name, params, formals, typ, _)); rest) =>
      call once(in name, List(for (p, e) in rest if signs_fun(e, name, size(formals)) yield p))
      match List(for (p, c) in im if defines_fun(c, name, size(formals)) yield (p, c))
        case List((p, CFun(_, params_, formals_, typ_, _, _))) =>
          if params_ != params or vars(formals_) != vars(formals) or typ_ != typ then
            raise Located(None, p, SignatureMismatch(name))
          end

        case _ =>
          raise Located(None, pos, MissingDefinition(name))
      end
      call check_signatures(in rest, im)

    case List((pos, CProcSig(name, params, ins, outs, refs, raised, _)); rest) =>
      call once(in name, List(for (p, e) in rest if signs(e, name) yield p))
      match List(for (p, c) in im if defines_proc(c, name) yield (p, c))
        case List((p, CProc(_, params_, ins_, outs_, refs_, raised_, _, _))) =>
          if params_ != params or vars(ins_) != vars(ins) or vars(outs_) != vars(outs) or vars(refs_) != vars(refs) or raised_ != raised then
            raise Located(None, p, SignatureMismatch(name))
          end

        case _ =>
          raise Located(None, pos, MissingDefinition(name))
      end
      call check_signatures(in rest, im)

    case List((pos, CAbstract(name, params)); rest) =>
      match List(for (p, c) in im if defines_data(c, name) yield (p, c))
        case List((p, CData(_, params_, _))) =>
          if params_ != params then
            raise Located(None, p, SignatureMismatch(name))
          end

        case _ =>
          raise Located(None, pos, MissingDefinition(name))
      end
      call check_signatures(in rest, im)

    case List(_; rest) =>
      call check_signatures(in rest, im)
  end

// the signature name is not repeated at the positions others
procedure once(in name: Name, others: List[Pos]) :=
  for p in take(1, others) do
    raise Located(None, p, AlreadyDefined(name))
  end

// a function of the implementation section that is exported is exported with each of its numbers of arguments
procedure check_arities(in im: List[Pos * Cmd], ex: List[Cmd]) :=
  for (pos, cmd) in im do
    match cmd
      case CFun(name, _, formals, _, _, _) =>
        if exists(ex, lambda e => signs(e, name)) and not exists(ex, lambda e => signs_fun(e, name, size(formals))) then
          raise Located(None, pos, PartlyExported(name))
        end

      case _ =>
        skip
    end
  end

// the exported pattern aliases of cs expand to constructors that importers see
procedure exported_aliases(in cs: List[Id * Cmd], hidden: Set[Name], s: State) :=
  for (_, cmd) in cs do
    match cmd
      case CPatAlias(name, _, _, _, _) if not contains(name, hidden) =>
        for k in pattern_constrs(value_or(map_option(pat_alias_of(s.sig, name), lambda alias => alias.pat.that), PWild)) if contains(k, hidden) do
          raise PrivateConstructor(name, k)
        end

      case _ =>
        skip
    end
  end

function pattern_constrs(pat: Pat): List[Name] :=
  match pat
    case PApp(constr, args) =>
      List(constr; List(for a in args for k in pattern_constrs(a.that) yield k))

    case PTuple(args) =>
      List(for a in args for k in pattern_constrs(a.that) yield k)

    case _ =>
      List()
  end

// the types of the export section name only sorts that importers can name, not the private sorts of the module
procedure check_exposed(in m: Id, ex: List[Pos * Cmd], hidden_sorts: List[Name]) :=
  match ex
    case List() =>
      skip

    case List((pos, c); rest) =>
      match exposed(c)
        case Some((n, ts)) =>
          local found: List[Name] := List(for u in ts for t in sorts_in(u) if contains(own_name(m, t), hidden_sorts) yield own_name(m, t))
          match found
            case List(t; _) =>
              raise Located(None, pos, PrivateType(n, t))
            case List() =>
              skip
          end

        case None =>
          skip
      end
      call check_exposed(in m, rest, hidden_sorts)
  end

// a name as written in module m, where an unqualified name of a sort of m is one of its own
function own_name(m: Id, n: Name): Name :=
  if n.module == None then in_module(m, n) else n

// the declaration of an export section with the types that it shows to importers
function exposed(cmd: Cmd): Option[Name * List[Type]] :=
  match cmd
    case CFunSig(name, _, formals, typ, _) =>
      Some((name, List(for x in formals yield x.that.typ) ++ List(typ)))

    case CProcSig(name, _, ins, outs, refs, raised, _) =>
      Some((name, List(for x in ins ++ outs ++ refs yield x.that.typ) ++ raised))

    case CData(name, _, constrs) =>
      Some((name, List(for k in parts(constrs) for field in k.fields yield field.typ)))

    case CSort(name, _, typ) =>
      Some((name, List(typ)))

    case CPatAlias(name, _, formals, typ, _) =>
      Some((name, List(for x in formals yield x.that.typ) ++ List(typ)))

    // abstract types and notations, and definitions and tests, which enter_section of ulang/parse/parse.u keeps out of export
    // sections
    case _ =>
      None
  end

// the sections of module d, whose signatures its definitions repeat, and whose exports name no private sorts
procedure check_sections(in d: Mod) :=
  local ex := placed_cmds(d.name, d.exported), im := placed_cmds(d.name, d.implemented)
  call check_signatures(in ex, im)
  call check_arities(in im, seconds(ex))
  call check_exposed(in d.name, ex, private_sorts(seconds(ex), seconds(im)))

// the declarations and sorts that module d keeps private, which are all of a module without an export section
procedure private_of(in d: Mod, out hidden: Set[Name], hidden_sorts: List[Name]) :=
  local ex := exported_cmds(d), im := implemented_cmds(d)
  assign hidden := Set(for x in private_names(ex, im)), hidden_sorts := private_sorts(ex, im)

// the commands of docs of the module m with qualified names, at their declarations
function placed_cmds(m: Id, docs: List[At[Cmd]]): List[Pos * Cmd] :=
  List(for c in docs if is_parsed(c) yield (c.pos, qualify(m, c.that)))

function exported_cmds(d: Mod): List[Cmd] :=
  List(for c in commands_of(d.exported) yield qualify(d.name, c))

function implemented_cmds(d: Mod): List[Cmd] :=
  List(for c in commands_of(d.implemented) yield qualify(d.name, c))

// the commands of the program with qualified names, where each package and each program is checked once, after the
// modules it imports
procedure check_program(
  in  source: Source,
  out q: Prog
) raises TypeError, InternalError :=
  local errors: List[TypeError]
  call check_all(in source, no_tests, out q, errors)
  for e in take(1, errors) do
    raise e
  end

procedure check_all(
  in  source: Source,
      generate: Checked -> List[Pos * (Id * Cmd)],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError :=
  call check_source(in source, empty(), false, generate, out q, errors)

procedure check_partial(
  in  source: Source,
      unparsed: Set[Id],
      generate: Checked -> List[Pos * (Id * Cmd)],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError :=
  call check_source(in source, unparsed, true, generate, out q, errors)

function is_seen(c: Checked, m: Id, d: Name): Bool :=
  is_visible(start(m, c.table) with hidden := c.hidden, d)

function no_tests(c: Checked): List[Pos * (Id * Cmd)] :=
  List()

// the checked program of source, where partial tells whether it has parts that do not parse, which only then are looked for
procedure check_source(
  in  source: Source,
      unparsed: Set[Id],
      partial: Bool,
      generate: Checked -> List[Pos * (Id * Cmd)],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError :=
  local sig: Sig := empty(), imports: List[Id * List[Id]] := List(), cmds: List[Id * At[Cmd]] := List(), checked: List[Id * At[Cmd]], shown: Sig, found: List[TypeError], loose: List[TypeError] := List(), found_loose: List[TypeError], placed: List[At[Cmd]]
  assign errors := List()
  for mods in units(source.mods, source.packages) if errors == List() do
    try
      call   check_package(in mods, source.packages, sig, imports, unparsed, partial, generate, out checked, shown, found, found_loose)
      assign sig := union(sig, shown), imports := imports ++ List(for d in mods yield (d.name, seen_modules(d, source.packages))), cmds := cmds ++ checked, errors := found, loose := found_loose
    catch
      case e =>
        assign cmds := cmds ++ List(for d in mods for (m, c) in written_of(d.name, d.exported ++ d.implemented) yield (m, unchecked(c))), errors := List(e), loose := List(e)
    end
  end
  assign errors := distinct(List(for e in errors yield in_main(source.main, e)))
  call   with_errors(in source.main, cmds ++ builtins_of(source), distinct(List(for e in loose yield in_main(source.main, e))), out placed)
  assign q := Prog(take(size(cmds), placed), drop(size(cmds), placed), source.main)

// a command of a package whose check failed, as written, which is an error node without errors of its own, so that no run
// takes it for checked code (rejected of ulang/syntax/syntax.u), while the error of the package stands on its command
function unchecked(cmd: At[Cmd]): At[Cmd] :=
  match cmd
    case AOk(pos, span, that) =>
      AErr(pos, span, that, List())
    case _ =>
      cmd
  end

// the commands of the builtin sections of source
function builtins_of(source: Source): List[Id * At[Cmd]] :=
  List(for d in source.mods for c in written_of(d.name, d.builtins) yield c)

// cmds, each with the errors whose position it contains, as the last command of their module that starts at or before it
procedure with_errors(
  in  main: Id,
      cmds: List[Id * At[Cmd]],
      errors: List[TypeError],
  out placed: List[At[Cmd]]
) raises InternalError :=
  local on: Map[Int, List[Diagnostic]] := empty(), indexed := zip(range(0, size(cmds)), cmds)
  for e in errors do
    match container(indexed, error_module(main, e), error_pos(e), None)
      case Some(i) =>
        assign on := put(i, value_or(get(i, on), List()) ++ List(type_diagnostic(e)), on)
      case None =>
        raise Unexpected("an error outside the commands of its module, " ++ show(e))
    end
  end
  assign placed := List(for (i, (_, cmd)) in indexed yield with_diagnostics(cmd, value_or(get(i, on), List())))

// the module of the error e, main for one without a module, and for one without a position, of code that the parser did
// not read, at Pos(0, 0) as its commands
function error_module(main: Id, e: TypeError): Id :=
  match e
    case Located(Some(m), _, _) =>
      m
    case _ =>
      main
  end

function error_pos(e: TypeError): Pos :=
  match e
    case Located(_, pos, _) =>
      pos
    case _ =>
      Pos(0, 0)
  end

// the index of the last command of module m in cmds that starts at or before pos, after found
function container(cmds: List[Int * (Id * At[Cmd])], m: Id, pos: Pos, found: Option[Int * Pos]): Option[Int] :=
  match cmds
    case List() =>
      map_option(found, first)

    case List((i, (n, cmd)); rest) =>
      if n == m and cmd.pos <= pos and forall(found, lambda (_, p) => p <= cmd.pos) then
        container(rest, m, pos, Some((i, cmd.pos)))
      else
        container(rest, m, pos, found)
  end

// cmd with the errors ds, if there are any
function with_diagnostics(cmd: At[Cmd], ds: List[Diagnostic]): At[Cmd] :=
  match (cmd, ds)
    case (_, List()) =>
      cmd

    case (AOk(pos, span, that), _) =>
      AErr(pos, span, that, ds)

    case (AErr(pos, span, that, errors), _) =>
      AErr(pos, span, that, errors ++ ds)

    // without_unparsed of ulang/parse/parse.u leaves no command that does not parse to the checker
    case (AUnparsed(_, _, _, _), _) =>
      cmd
  end

// the errors that checking found in q, of its commands and their parts, by position within each command, without those of
// parsing, which are the source's
function diagnostics(q: Prog): List[Diagnostic] :=
  distinct(List(for cmd in q.cmds ++ q.builtins for d in command_diagnostics(q.main, cmd) yield d))

// the errors of cmd by position, where an error of a part without a module is of the module of cmd, and one of main has
// none
function command_diagnostics(main: Id, cmd: At[Cmd]): List[Diagnostic] :=
  let m := if is_parsed(cmd) then cmd_module(cmd.that) else None in
  let ds := List(for d in cmd_errors(cmd) if d.kind != ParseKind yield in_main_module(main, d with module := or_else(d.module, m))) in
  List(for (_, _, d) in sort(List(for (i, d) in zip(range(0, size(ds)), ds) yield (d.pos, i, d))) yield d)

function in_main_module(main: Id, d: Diagnostic): Diagnostic :=
  if d.module == Some(main) then d with module := None else d

function has_errors(q: Prog): Bool :=
  exists(diagnostics(q), lambda d => d.kind != ProofKind)

// whether e stops the definitions after the declarations, as all errors do but the uses of declarations that do not parse,
// which have no type that could mislead the checking of the definitions
function is_blocking(e: TypeError): Bool :=
  match e
    case Located(_, _, error) =>
      is_blocking(error)

    case UnparsedDeclaration(_) =>
      false

    case _ =>
      true
  end

// e as the use of a declaration of unparsed that does not parse, if it is an unknown name of one
function unparsed_use(unparsed: Set[Id], e: TypeError): TypeError :=
  match e
    case Located(m, pos, error) =>
      Located(m, pos, unparsed_use(unparsed, error))

    case Hinted(UnknownVariable(name), _) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownVariable(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownSort(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownConstructor(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownProcedure(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case _ =>
      e
  end

// e without the module if it is the main one
function in_main(main: Id, e: TypeError): TypeError :=
  match e
    case Located(Some(m), pos, error) if m == main =>
      Located(None, pos, error)
    case _ =>
      e
  end

// the modules in the order of mods, where the members of a package, which follow each other, are checked together, and
// each other module, a program, on its own
function units(mods: List[Mod], packages: List[Package]): List[List[Mod]] :=
  match mods
    case List() =>
      List()

    case List(d; rest) =>
      match find(packages, lambda p => contains(d.name, p.members))
        case Some(p) =>
          let unit := take_members(mods, p.members) in
          List(unit; units(drop(size(unit), mods), packages))

        case None =>
          List(List(d); units(rest, packages))
      end
  end

function take_members(mods: List[Mod], members: List[Id]): List[Mod] :=
  match mods
    case List(d; rest) if contains(d.name, members) =>
      List(d; take_members(rest, members))
    case _ =>
      List()
  end

// the commands of the members mods of a package, or of a program alone, and the signature that they show their importers,
// checked together after the declarations before of the modules that imports lists, where the declarations that other
// modules keep private are unknown, since before has only their signatures, and those that members keep private are hidden
// from the other members, and where the definitions are checked only after declarations without errors, whose uses would
// only repeat them
procedure check_package(
  in  mods: List[Mod],
      packages: List[Package],
      before: Sig,
      imports: List[Id * List[Id]],
      unparsed: Set[Id],
      partial: Bool,
      generate: Checked -> List[Pos * (Id * Cmd)],
  out cmds: List[Id * At[Cmd]],
      shown: Sig,
      errors: List[TypeError],
      loose: List[TypeError]
) :=
  local own := List(for d in mods yield (d.name, seen_modules(d, packages))), members := List(for d in mods yield d.name), placed := List(for d in mods for p in decls_of(d) yield p), s: State, decls: List[Id * Cmd], defined: List[Id * At[Cmd]], tested: List[Id * At[Cmd]] := List(), enumerated: List[Id * At[Cmd]] := List(), hidden: Set[Name] := empty(), hidden_sorts: List[Name] := List(), builtins := List(for d in mods for c in natives(d) yield c), private: Set[Name], private_sorts: List[Name], exceptions: Exceptions
  for d in mods do
    call   private_of(in d, out private, private_sorts)
    assign hidden := hidden ++ private, hidden_sorts := hidden_sorts ++ private_sorts
  end
  assign s := State(before, empty(), 0, first_member(members), List(), visibility(imports ++ own, first_member(members)), List(), empty(), hidden, Set(for x in hidden_sorts), Pos(0, 0), List(), unparsed, partial, List(), empty(), List(), empty(), empty(), empty()), decls := seconds(placed)
  call   each_placed(in declare_datas, placed, ref s)
  call   declare_datas(in builtins, ref s)
  call   each_placed(in declare_sorts, alias_order(List(for p in placed if alias_names(p) != None), List()), ref s)
  call   each_placed(in declare_constrs, placed, ref s)
  call   each_placed(in declare_pat_aliases, placed, ref s)
  call   each_placed(in declare_funs, placed, ref s)
  call   each_placed(in declare_procs, placed, ref s)
  call   each_placed(in declare_lemmas, placed, ref s)
  call   declare_funs(in builtins, ref s)
  call   declare_procs(in builtins, ref s)
  for d in mods do
    try
      call check_sections(in d)
    catch
      case e =>
        assign s := s with errors := s.errors ++ List(located(d.name, Pos(0, 0), e))
    end
  end
  call each_placed(in lambda in cs: List[Id * Cmd], ref t: State =>
    call exported_aliases(in cs, hidden, t)
  end, placed, ref s)
  for d in mods do
    call unique_tests(in d, ref s)
  end
  for (p, (m, name)) in List(for (p, (m, cmd)) in placed for name in contract_on_definition(placed, cmd) yield (p, (m, name))) do
    assign s := s with errors := s.errors ++ List(Located(Some(m), p, ContractOnDefinition(name)))
  end
  if not exists(s.errors, is_blocking) then
    call placed_commands(in with_contracts(placed_definitions(placed), placed), lambda in checked: List[Cmd] =>
      call check_orders(in checked, abstract_types(decls), hidden, hidden_sorts)
    end, out defined, ref s)
  else
    assign defined := List()
  end
  if s.errors == List() then
    local generated := generate(Checked(placed, defined, abstract_types(decls), s.sig, s.table, s.hidden))
    for d in mods do
      call examples_placed(in d, ref s)
    end
    call example_commands(in List(for d in mods for x in example_tests(d) yield x), out tested, ref s)
    call each_placed(in declare_funs, generated, ref s)
    call placed_commands(in generated, lambda in checked: List[Cmd] =>
      skip
    end, out enumerated, ref s)
  end
  assign cmds := with_definitions(List(for d in mods for c in written_of(d.name, d.exported ++ d.implemented) yield c), defined) ++ tested ++ enumerated, shown := exported(restrict(s.sig, members), hidden, Set(for x in hidden_sorts)), errors := s.errors, loose := List(for (i, e) in zip(range(0, size(s.errors)), s.errors) if not contains(i, s.taken) yield e)
  assign exceptions := raises_errors(List(for (_, c) in defined ++ tested if cmd_errors(c) == List() yield c.that), s.sig, hidden)
  assign errors := errors ++ exceptions.errors, cmds := List(for (m, c) in cmds yield (m, map_at(c, lambda cmd => with_inferred(cmd, exceptions.inferred))))
  assign loose := loose ++ drop(size(s.errors), errors)

// cmd with the raises inferred of it if it is a private procedure without raises, which the checked program keeps
function with_inferred(cmd: Cmd, inferred: Map[Name, List[Type]]): Cmd :=
  match cmd
    case CProc(name, params, ins, outs, refs, List(), spec, stmt) =>
      CProc(name, params, ins, outs, refs, value_or(get(name, inferred), List()), spec, stmt)
    case _ =>
      cmd
  end

// an example of the function or procedure owner, translated into the test cmd, at the position pos in module, where an
// example of the export section is checked as an importer of module sees it
data ExampleTest :=
  case ExampleTest(pos: Pos, module: Id, owner: Name, exported: Bool, cmd: Cmd)

// the examples on definitions in implementation of functions and procedures that export declares, as errors of s
procedure examples_placed(in d: Mod, ref s: State) :=
  local declared := List(for c in d.exported ++ d.builtins for o in example_owner(qualify(d.name, c.that)) yield o)
  for x in example_tests(d) if not x.exported and contains(x.owner, declared) do
    assign s := s with errors := s.errors ++ List(Located(Some(d.name), x.pos, ExampleOnDefinition(x.owner)))
  end

// the name of a function or procedure, of which examples may be given
function example_owner(cmd: Cmd): Option[Name] :=
  match cmd
    case CFun(name, _, _, _, _, _) =>
      Some(name)

    case CFunSig(name, _, _, _, _) =>
      Some(name)

    case CProc(name, _, _, _, _, _, _, _) =>
      Some(name)

    case CProcSig(name, _, _, _, _, _, _) =>
      Some(name)

    case _ =>
      None
  end

// the spec of a function or procedure, empty for other commands
function spec_of(cmd: Cmd): Spec :=
  match cmd
    case CFun(_, _, _, _, spec, _) =>
      spec

    case CFunSig(_, _, _, _, spec) =>
      spec

    case CProc(_, _, _, _, _, _, spec, _) =>
      spec

    case CProcSig(_, _, _, _, _, _, spec) =>
      spec

    case _ =>
      no_spec()
  end

// the tests of the examples of module d, named f.example.N with N from 1 for each base name f in the order of the source,
// which users cannot write
function example_tests(d: Mod): List[ExampleTest] :=
  numbered_examples(d.name, List(for c in d.exported ++ d.builtins yield (true, c.that)) ++ List(for c in d.implemented yield (false, c.that)), empty())

function numbered_examples(m: Id, cmds: List[Bool * Cmd], counts: Map[Id, Int]): List[ExampleTest] :=
  match cmds
    case List() =>
      List()

    case List((exported, cmd); more) =>
      match example_owner(qualify(m, cmd))
        case Some(owner) =>
          let n := value_or(get(owner.base, counts), 0), examples := spec_of(cmd).examples in
          List(for (i, x) in zip(range(n + 1, n + 1 + size(examples)), examples) yield example_test(m, x.pos, owner, exported, i, x)) ++ numbered_examples(m, more, put(owner.base, n + size(examples), counts))

        case None =>
          numbered_examples(m, more, counts)
      end
  end

function example_test(m: Id, pos: Pos, owner: Name, exported: Bool, n: Int, x: At[Example]): ExampleTest :=
  ExampleTest(pos, m, owner, exported, CTest(Name(Some(m), owner.base ++ ".example." ++ show(n)), List(), example_body(pos, x)))

// the body of the test of the example x, which raises the error of a part that does not parse
function example_body(pos: Pos, x: At[Example]): At[Stmt] :=
  match example_error(x)
    case Some(error) =>
      AOk(pos, x.span, SRaise(nowhere(ELit(LStr("the example does not parse: " ++ error.message ++ " at " ++ show(error.pos.line) ++ "." ++ show(error.pos.col)))), THole))
    case None =>
      example_stmt(pos, x.span, x.that)
  end

// the body of the test of the example x, which is checked as written, in the scope of its module, so that its names take
// the declarations that overloading chooses, also another one than the owner, which the convention, an example applies
// its function, rules out; the statement is at the example at pos, where the checks of the exceptions report what its
// assert raises cannot catch, and the other parts that the source does not have are at Pos(0, 0), so that their errors
// are located at the example too
function example_stmt(pos: Pos, span: Span, x: Example): At[Stmt] :=
  match x
    case XHolds(expr) =>
      AOk(pos, span, SAssert(expr))

    case XRaises(expr, pat) =>
      let value := Var(generated_name("value"), THole) in
      AOk(pos, span, SAssertRaises(THole, pat, nowhere(block(List(value), List(nowhere(SAssign(List((value, expr)))))))))

    case XCall(proc, ins, outs, refs) =>
      let out_vars := generated_vars("out", size(outs)), ref_vars := generated_vars("ref", size(refs)) in
      AOk(pos, span, block(out_vars ++ ref_vars, initial_refs(ref_vars, firsts(refs)) ++ List(nowhere(SCall(proc, ins, out_vars, ref_vars))) ++ expected_values(out_vars ++ ref_vars, outs ++ seconds(refs))))

    case XCallRaises(proc, ins, blanks, befores, pat) =>
      let out_vars := generated_vars("out", blanks), ref_vars := generated_vars("ref", size(befores)) in
      AOk(pos, span, SAssertRaises(THole, pat, nowhere(block(out_vars ++ ref_vars, initial_refs(ref_vars, befores) ++ List(nowhere(SCall(proc, ins, out_vars, ref_vars)))))))
  end

function generated_vars(base: Id, n: Int): List[Var] :=
  List(for i in range(1, n + 1) yield Var(generated_name(base ++ show(i)), THole))

// one assignment per ref, so that the block infers their types
function initial_refs(xs: List[Var], befores: List[At[Expr]]): List[At[Stmt]] :=
  List(for (x, before) in zip(xs, befores) yield nowhere(SAssign(List((x, before)))))

// assert (a, …) == (b, …) of the variables and the expected values, or assert a == b of one, or nothing of none
function expected_values(actual: List[Var], expected: List[At[Expr]]): List[At[Stmt]] :=
  match (actual, expected)
    case (List(), _) =>
      List()

    case (List(a), List(e)) =>
      List(nowhere(SAssert(generated_op("==", List(nowhere(EVar(a)), e)))))

    case _ =>
      List(
        nowhere(SAssert(generated_op("==", List(
          nowhere(ETuple(List(for a in actual yield nowhere(EVar(a))))),
          nowhere(ETuple(expected)))))))
  end

// the tests of the examples, each checked in its module, or as an importer of its module sees it if it is exported, by
// a module of its own, which sees what the module sees and the module itself, with their errors located at the examples
procedure example_commands(
  in  xs: List[ExampleTest],
  out cmds: List[Id * At[Cmd]],
  ref s: State
) :=
  assign cmds := List()
  for x in xs do
    local errors: List[Diagnostic], before := size(s.errors), one: List[Cmd] := List(x.cmd), viewer := (if x.exported then "(example)/" ++ x.module else x.module)
    assign s := s with table := List((viewer, List(x.module; sees(x.module, s.table))); s.table)
    try
      call commands(in List((viewer, x.cmd)), out one, ref s)
    catch
      case e =>
        assign s := s with errors := s.errors ++ List(e)
    end
    assign s := placed_errors(s, before, (x.module, x.cmd), x.pos)
    call   take_errors(in x.pos, before, out errors, ref s)
    assign cmds := cmds ++ List(for c in one yield (x.module, checked_at(x.pos, span_at(x.pos), c, errors)))
  end

// the type aliases of a package, each after those that it names, since an alias is expanded where it is declared, and
// members name each other's aliases in any order, where aliases that name each other stay in their order
function alias_order(pending: List[Pos * (Id * Cmd)], done: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  match find(pending, lambda p => not exists(pending, lambda q => q != p and names_alias(p, q)))
    case Some(p) =>
      alias_order(remove(p, pending), done ++ List(p))
    case None =>
      done ++ pending
  end

// whether the alias p names the alias q, by its name as written
function names_alias(p: Pos * (Id * Cmd), q: Pos * (Id * Cmd)): Bool :=
  match (alias_names(p), alias_names(q))
    case (Some((_, named)), Some((name, _))) =>
      contains(name, named)
    case _ =>
      false
  end

// the name of the type alias of a placed command and the names of the sorts that it names, if it is one
function alias_names(p: Pos * (Id * Cmd)): Option[Id * List[Id]] :=
  match p
    case (_, (_, CSort(name, _, typ))) =>
      Some((name.base, List(for n in sorts_in(typ) yield n.base)))
    case _ =>
      None
  end

function first_member(members: List[Id]): Id :=
  match members
    case List(m; _) =>
      m
    case List() =>
      ""
  end

// the commands of module d with qualified names, with the module of each, and their positions
function decls_of(d: Mod): List[Pos * (Id * Cmd)] :=
  List(for c in placed_of(d) yield (c.pos, (d.name, qualify(d.name, c.that))))

// the contracts of the signatures of procedures of placed, by name and arity
function declared_contracts(placed: List[Pos * (Id * Cmd)]): Map[Name * Int, Spec] :=
  Map(for (_, (_, cmd)) in placed for (key, spec) in signature_contract(cmd) yield key => spec)

function signature_contract(cmd: Cmd): Option[(Name * Int) * Spec] :=
  match cmd
    case CProcSig(name, _, ins, outs, refs, _, spec) =>
      Some(((name, size(ins) + size(outs) + size(refs)), spec))
    case _ =>
      None
  end

// the definitions with the contracts of their signatures in export, which they do not repeat
function with_contracts(defined: List[Pos * (Id * Cmd)], placed: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  let declared := declared_contracts(placed) in
  List(for (p, (m, cmd)) in defined yield (p, (m, contracted(declared, cmd))))

function contracted(declared: Map[Name * Int, Spec], cmd: Cmd): Cmd :=
  match cmd
    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      match get((name, size(ins) + size(outs) + size(refs)), declared)
        case Some(sig) =>
          CProc(name, params, ins, outs, refs, raised, Spec(sig.pre, sig.post, spec.examples), stmt)
        case None =>
          cmd
      end

    case _ =>
      cmd
  end

// the name of a definition of a procedure that export declares, if it has a contract, which belongs to the signature
function contract_on_definition(placed: List[Pos * (Id * Cmd)], cmd: Cmd): Option[Name] :=
  match cmd
    case CProc(name, _, ins, outs, refs, _, spec, _) if spec.pre != List() or spec.post != None =>
      if get((name, size(ins) + size(outs) + size(refs)), declared_contracts(placed)) != None then
        Some(name)
      else
        None

    case _ =>
      None
  end

// the definitions to check, where a pattern alias is the function that builds its values, if it has one
function placed_definitions(placed: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  List(for (p, (m, cmd)) in placed for c in definition_of(cmd) if is_definition((m, c)) yield (p, (m, c)))

function definition_of(cmd: Cmd): List[Cmd] :=
  match cmd
    case CPatAlias(name, params, formals, typ, pat) =>
      match pattern_expr(pat)
        case Some(body) =>
          List(CFun(name, params, formals, typ, no_spec(), body))
        case None =>
          List()
      end

    case _ =>
      List(cmd)
  end

// the declarations of a phase, one by one, where an error is located at the declaration that raises it
procedure each_placed(
  in  phase: (in List[Id * Cmd], ref State) raises TypeError, InternalError,
      placed: List[Pos * (Id * Cmd)],
  ref s: State
) :=
  match placed
    case List() =>
      skip

    case List((p, d); rest) =>
      local before := size(s.errors)
      try
        call phase(in List(d), ref s)
      catch
        case e =>
          assign s := s with errors := s.errors ++ List(e)
      end
      assign s := placed_errors(s, before, d, p)
      call   each_placed(in phase, rest, ref s)
  end

// the commands of the definitions, checked one by one and then by after, each at its declaration, where an error is located
// at the definition that raises it, which stays as written if checking it raises
procedure placed_commands(
  in  placed: List[Pos * (Id * Cmd)],
      after: (in List[Cmd]) raises TypeError,
  out cmds: List[Id * At[Cmd]],
  ref s: State
) :=
  match placed
    case List() =>
      assign cmds := List()

    case List((p, d); more) =>
      local before := size(s.errors), one: List[Cmd] := List(second(d)), rest: List[Id * At[Cmd]], errors: List[Diagnostic]
      try
        call commands(in List(d), out one, ref s)
        if size(s.errors) == before then
          call after(in one)
        end
      catch
        case e =>
          assign s := s with errors := s.errors ++ List(e)
      end
      assign s := placed_errors(s, before, d, p)
      call   take_errors(in p, before, out errors, ref s)
      call   placed_commands(in more, after, out rest, ref s)
      assign cmds := List(for c in one yield (first(d), checked_at(p, span_at(p), c, errors))) ++ rest
  end

// the commands of the export and implementation sections of the modules, each at its declaration, with the checked
// definitions in place of those that placed_definitions gives, in their order, as written where they are not checked
function with_definitions(written: List[Id * At[Cmd]], defined: List[Id * At[Cmd]]): List[Id * At[Cmd]] :=
  match (written, defined)
    case (List((m, cmd); rest), List((n, d); more)) if is_checked(m, cmd) =>
      List((n, d with span := cmd.span); with_definitions(rest, more))

    case (List(c; rest), _) =>
      List(c; with_definitions(rest, defined))

    case (List(), _) =>
      List()
  end

// whether placed_definitions gives a definition of cmd of module m
function is_checked(m: Id, cmd: At[Cmd]): Bool :=
  match cmd
    case AOk(_, _, that) =>
      is_definition((m, that)) and definition_of(that) != List()

    case AErr(_, _, that, _) =>
      is_definition((m, that)) and definition_of(that) != List()

    case AUnparsed(_, _, _, _) =>
      false
  end

// the commands of docs of the module m with qualified names, at their declarations
function written_of(m: Id, docs: List[At[Cmd]]): List[Id * At[Cmd]] :=
  List(for c in docs for x in qualified_at(m, c) yield (m, x))

// without_unparsed of ulang/parse/parse.u leaves no command that does not parse to the checker
function qualified_at(m: Id, cmd: At[Cmd]): Option[At[Cmd]] :=
  match cmd
    case AOk(pos, span, that) =>
      Some(AOk(pos, span, qualify(m, that)))

    case AErr(pos, span, that, errors) =>
      Some(AErr(pos, span, qualify(m, that), errors))

    case AUnparsed(_, _, _, _) =>
      None
  end

// s with the errors after the first before located at the declaration d at position p, which raised or reported them
function placed_errors(s: State, before: Int, d: Id * Cmd, p: Pos): State :=
  s with errors := take(before, s.errors) ++ List(for e in drop(before, s.errors) yield located(first(d), p, e))

// the error e of a declaration of module m at position p, if the parser read it
function located(m: Id, p: Pos, e: TypeError): TypeError :=
  match e
    case Located(None, q, error) =>
      Located(Some(m), q, error)
    case _ =>
      if p == Pos(0, 0) then e else Located(Some(m), p, e)
  end

// the type of expr without a program
procedure type_of(in expr: At[Expr], out t: Type) :=
  local s := start("main", List()), typed_expr: At[Expr], u: Type
  call   infer(in List(), expr, out typed_expr, u, ref s)
  call   settle(ref s)
  call   reported(in s)
  assign t := zonk_type(s.sub, u)

// lambda xs => body, at Pos(0, 0), as code that the parser did not read
function lambda_at(xs: List[Var], body: At[Expr]): At[Expr] :=
  nowhere(lambda_of(Pos(0, 0), span_at(Pos(0, 0)), xs, body))

// let id := lambda x => x in (id(1), id(arg)), whose id is not generalized
function let_id(arg: At[Expr]): At[Expr] :=
  nowhere(ELet(List(
    (pat_var("id"), lambda_at(List(Var(unqualified("x"), THole)), expr_var("x")))), nowhere(ETuple(List(expr_app("id", List(expr_int(1))), expr_app("id", List(arg)))))))

test inference() :=
  local t: Type
  call type_of(in expr_app("<", List(expr_int(1), expr_int(2))), out t)
  assert t == TBool()
  call type_of(in let_id(expr_int(2)), out t)
  assert t == TTuple(List(TInt(), TInt()))
  assert raises Mismatch(TInt(), TBool(), "argument 1 of the call") do
    call type_of(in let_id(nowhere(ELit(LBool(true)))), out t)
  end
  assert raises InfiniteType(_, _) do
    call type_of(in lambda_at(List(Var(unqualified("f"), THole)), expr_app("f", List(expr_var("f")))), out t)
  end
  assert raises Mismatch(_, _, _) do
    call type_of(in expr_app("<", List(expr_int(1), nowhere(ELit(LBool(true))))), out t)
  end
  assert raises UnknownVariable(Name(None, "x")) do
    call type_of(in expr_app("x", List()), out t)
  end

// a case of a match at Pos(0, 0), without a doc
function case_at[A](pat: At[Pat], body: A): At[Branch[A]] :=
  nowhere(Branch(pat, None, body))

test elaboration() :=
  local q: Prog
  call check_program(in with_lists(List(
    CTest(unqualified("r"), List(), nowhere(block(List(Var(unqualified("n"), THole)), List(
      nowhere(SAssign(List(
        (Var(unqualified("n"), THole), expr_app("len", List(expr_app("Cons", List(expr_int(1), expr_var("Nil"))))))))))))))), out q)
  match definitions(q)
    case List(
      _,
      CFun(_, _, _, _, _, AOk(_, _, EMatch(_, List(AOk(_, _, Branch(pat, _, _)); _)))),
      CTest(_, List(), AOk(_, _, SBlock(_, List(AOk(_, _, SAssign(List((_, AOk(_, _, ECall(_, _, _, typ, _))))))))))) =>
      assert pat.that == PNil()
      assert typ == TFun(List(TList(TInt())), TInt())

    case _ =>
      assert false
  end

test coverage() :=
  local q: Prog
  assert raises NotExhaustive(PCons(AOk(_, _, PWild), AOk(_, _, PWild))) do
    call check_program(in with_lists(List(
      CFun(unqualified("f"), List(), unplaced_vars(List(Var(unqualified("xs"), type_plain_list(TInt())))), TInt(), no_spec(), nowhere(EMatch(expr_var("xs"), List(case_at(pat_var("Nil"), expr_int(0)))))))), out q)
  end
  assert raises Unreachable(PNil()) do
    call check_program(in with_lists(List(
      CFun(unqualified("f"), List(), unplaced_vars(List(Var(unqualified("xs"), type_plain_list(TInt())))), TInt(), no_spec(), nowhere(EMatch(expr_var("xs"), List(
        case_at(nowhere(PWild), expr_int(0)),
        case_at(pat_var("Nil"), expr_int(1)))))))), out q)
  end

test statements() :=
  local q: Prog
  assert raises NotAssignable(Name(None, "n")) do
    call check_program(in program_of(List(
      CProc(unqualified("inc"), List(), List(), List(), unplaced_vars(List(Var(unqualified("k"), TInt()))), List(), no_spec(), nowhere(block(List(), List(
        nowhere(SAssign(List(
          (Var(unqualified("k"), THole), expr_app("+", List(expr_var("k"), expr_int(1))))))))))),
      CProc(unqualified("p"), List(), unplaced_vars(List(Var(unqualified("n"), TInt()))), List(), List(), List(), no_spec(), nowhere(block(List(), List(
        nowhere(SCall(unqualified("inc"), List(), List(), List(Var(unqualified("n"), THole)))))))))), out q)
  end
  assert raises UnknownException(TList(_)) do
    call check_program(in with_lists(List(
      CTest(unqualified("t"), List(), nowhere(block(List(), List(nowhere(SRaise(expr_var("Nil"), THole)))))))), out q)
  end

function tsort(n: Id): Type :=
  TSort(unqualified(n), List())

function var_of(n: Id, t: Type): Var :=
  Var(unqualified(n), t)

function fun_cmd(n: Id, xs: List[Var], r: Type, b: At[Expr]): Cmd :=
  CFun(unqualified(n), List(), unplaced_vars(xs), r, no_spec(), b)

function constr_at(n: Id, fields: List[Field]): At[Constr] :=
  nowhere(Constr(unqualified(n), fields))

// the modules bag and box, which both export a function size, a constructor Leaf, a procedure fill, and a field x,
// and that the program imports
function bags(): List[Mod] :=
  List(
    sectioned("bag", List(
      CData(unqualified("Bag"), List(), List(
        constr_at("Bag", List(Field("n", TInt()))),
        constr_at("Leaf", List(Field("n", TInt()))))),
      CData(unqualified("Pt"), List(), List(constr_at("Pt", List(Field("x", TInt()))))),
      fun_cmd("size", List(var_of("b", tsort("Bag"))), TInt(), expr_int(1)),
      fun_cmd("compare", List(var_of("a", tsort("Bag")), var_of("b", tsort("Bag"))), TInt(), expr_int(0)),
      CProc(unqualified("fill"), List(), List(), unplaced_vars(List(var_of("b", tsort("Bag")))), List(), List(), no_spec(), nowhere(SAssign(List((var_of("b", THole), expr_app("Bag", List(expr_int(0)))))))))),
    sectioned("box", List(
      CData(unqualified("Box"), List(), List(
        constr_at("Box", List(Field("s", TStr()))),
        constr_at("Leaf", List(Field("s", TStr()))))),
      CData(unqualified("Qt"), List(), List(constr_at("Qt", List(Field("x", TStr()))))),
      fun_cmd("size", List(var_of("b", tsort("Box"))), TInt(), expr_int(2)),
      CProc(unqualified("fill"), List(), List(), unplaced_vars(List(var_of("b", tsort("Box")))), List(), List(), no_spec(), nowhere(SAssign(List((var_of("b", THole), expr_app("Box", List(nowhere(ELit(LStr("")))))))))))))

// the module of cmds with sections, as the parser gives it: the datatypes and the signatures of the definitions exported,
// and the definitions implemented
function sectioned(name: Id, cmds: List[Cmd]): Mod :=
  Mod(name, List(), unplaced(List(for c in cmds yield signature_of(c))), List(), unplaced(List(for c in cmds if signature_of(c) != c)), List())

function signature_of(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, _, _) =>
      CFunSig(name, params, formals, typ, no_spec())

    case CProc(name, params, ins, outs, refs, raised, _, _) =>
      CProcSig(name, params, ins, outs, refs, raised, no_spec())

    case _ =>
      cmd
  end

// the program of the commands cmds of the module main, which imports bag and box, each a package of its own
function with_bags(cmds: List[Cmd]): Source :=
  Source(List(natives_prelude(); bags()) ++ List(Mod("main", List("bag", "box"), List(), List(), unplaced(cmds), List())), List(Package("bag", List("bag")), Package("box", List("box"))), "main")

function in_bag(n: Id): Name :=
  Name(Some("bag"), n)

function in_box(n: Id): Name :=
  Name(Some("box"), n)

// the body of the last function of the checked program with_bags([cmd])
procedure body_of(in cmd: Cmd, out b: Expr) :=
  local q: Prog
  call check_program(in with_bags(List(cmd)), out q)
  match reverse(definitions(q))
    case List(CFun(_, _, _, _, _, body); _) =>
      assign b := body.that
    case _ =>
      assert false
  end

// size(Bag(1)) + size(Box("x"))
test by_arguments() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), expr_app("+", List(
    expr_app("size", List(expr_app("Bag", List(expr_int(1))))),
    expr_app("size", List(expr_app("Box", List(nowhere(ELit(LStr("x")))))))))), out b)
  match b
    case EApp(_, List(AOk(_, _, ECall(_, _, m, _, _)), AOk(_, _, ECall(_, _, n, _, _)))) =>
      assert (m, n) == (in_bag("size"), in_box("size"))
    case _ =>
      assert false
  end

// (lambda x => size(x))(Box("x")), where size(x) stays open until the lambda is applied
test deferred() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), nowhere(EApp(lambda_at(List(var_of("x", THole)), expr_app("size", List(expr_var("x")))), List(expr_app("Box", List(nowhere(ELit(LStr("x"))))))))), out b)
  match b
    case EApp(AOk(_, _, ELam(_, AOk(_, _, ECall(_, _, name, typ, _)))), _) =>
      assert name == in_box("size")
      assert typ == TFun(List(TSort(in_box("Box"), List())), TInt())

    case _ =>
      assert false
  end

// size as a value of the declared result type Box -> Int
test by_result() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TFun(List(tsort("Box")), TInt()), expr_var("size")), out b)
  assert b == EName(in_box("size"), TFun(List(TSort(in_box("Box"), List())), TInt()))

// Leaf("s") constructs a Box, and the case Leaf(n) of a Bag is of bag
test constructors() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), tsort("Box"), expr_app("Leaf", List(nowhere(ELit(LStr("s")))))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == in_box("Leaf")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("g", List(var_of("b", tsort("Bag"))), TInt(), nowhere(EMatch(expr_var("b"), List(
    case_at(nowhere(PApp(unqualified("Leaf"), List(pat_var("n")))), expr_var("n")),
    case_at(nowhere(PApp(unqualified("Bag"), List(pat_var("n")))), expr_var("n")))))), out b)
  match b
    case EMatch(_, List(AOk(_, _, Branch(AOk(_, _, PApp(constr, _)), _, _)); _)) =>
      assert constr == in_bag("Leaf")
    case _ =>
      assert false
  end

// call fill(out b) for a local b: Box
test procedures() :=
  local q: Prog
  call check_program(in with_bags(List(
    CProc(unqualified("p"), List(), List(), List(), List(), List(), no_spec(), nowhere(block(List(var_of("b", tsort("Box"))), List(
      nowhere(SCall(unqualified("fill"), List(), List(var_of("b", THole)), List())))))))), out q)
  match reverse(definitions(q))
    case List(
      CProc(_, _, _, _, _, _, _, AOk(_, _, SBlock(_, List(AOk(_, _, SCall(proc, _, _, _)))))); _) =>
      assert proc == in_box("fill")

    case _ =>
      assert false
  end

// (lambda p => p.x)(Pt(3)), where the type of p is not known at the access
test fields() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), nowhere(EApp(lambda_at(List(var_of("p", THole)), nowhere(EField(expr_var("p"), "x"))), List(expr_app("Pt", List(expr_int(3))))))), out b)
  match b
    case EApp(AOk(_, _, ELam(_, AOk(_, _, ECall(_, _, name, _, _)))), _) =>
      assert name == in_bag("Pt.x")
    case _ =>
      assert false
  end

// compare and == are the builtins, also of bags, whose compare of bag the builtin reaches through the type, and of type
// parameters
test builtins() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), expr_app("compare", List(expr_app("Bag", List(expr_int(1))), expr_app("Bag", List(expr_int(2)))))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == unqualified("compare")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("g", List(), TBool(), expr_app("==", List(expr_int(1), expr_int(2)))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  call body_of(in CFun(unqualified("h"), List("A"), unplaced_vars(List(var_of("x", TParam("A")))), TBool(), no_spec(), expr_app("==", List(expr_var("x"), expr_var("x")))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("k", List(), TBool(), nowhere(ELet(List(
    (pat_var("e"), lambda_at(List(var_of("x", THole)), expr_app("==", List(expr_var("x"), expr_var("x")))))), nowhere(ELit(LBool(true)))))), out b)
  match b
    case ELet(List((_, AOk(_, _, ELam(_, AOk(_, _, ECall(_, _, name, _, _)))))), _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end

// a local variable hides all declarations of its name
test locals() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(var_of("size", TInt())), TInt(), expr_var("size")), out b)
  assert b == EName(unqualified("size"), TInt())

test errors() :=
  local b: Expr
  assert raises NoOverload(Name(None, "size"), _) do
    call body_of(in fun_cmd("f", List(), TInt(), expr_app("size", List(expr_int(1)))), out b)
  end
  assert raises Ambiguous(Name(None, "size"), List(_, _)) do
    call body_of(in fun_cmd("f", List(), TBool(), nowhere(ELet(List(
      (pat_var("h"), lambda_at(List(var_of("x", THole)), expr_app("size", List(expr_var("x")))))), nowhere(ELit(LBool(true)))))), out b)
  end
  assert raises WrongArity(Name(None, "size"), 2) do
    call body_of(in fun_cmd("f", List(), TInt(), expr_app("size", List(expr_int(1), expr_int(2)))), out b)
  end
