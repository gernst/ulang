// the type checker of ulang, which checks and elaborates programs of ulang/syntax/syntax.u in signatures of ulang/check/sig.u,
// where the state is passed by reference, and errors are values of TypeError instead of messages,
// and which overloads names across modules: the declarations of a name in all visible modules are its candidates,
// and each use resolves to the one whose type fits, at once if only one fits, or else at the end of the command,
// when the uses that are still open are solved together

import ulang.syntax
import ulang.expand

export

data TypeError :=
  case UnknownSort(name: Name)
  case SortArity(name: Name, expected: Int, actual: Int)
  case SortDefined(name: Name)
  case MissingType(name: Name)
  case UndeclaredParams(name: Name, types: List[Type])
  case CannotUnify(left: Type, right: Type)
  // the type found of a part, which what names, where the type expected is another
  case Mismatch(expected_type: Type, found_type: Type, what: Str)
  case InfiniteType(meta: Type, typ: Type)
  case UnknownVariable(name: Name)
  case NoOverload(name: Name, typ: Type)
  case WrongArity(name: Name, arity: Int)
  case AlreadyDefined(name: Name)
  case Duplicate(what: Str, item: Str)
  case Ambiguous(name: Name, candidates: List[(Name, Scheme)])
  case UnknownField(name: Name)
  case UnknownFieldType(field: Id, typ: Type)
  case UnknownFieldOwner(field: Id)
  // a container of a generator whose type, which chooses the folds, is not known at the generator
  case UnknownContainer(typ: Type)
  // a container of a generator whose type is of a module that declares no fold of three arguments, the one that the form
  // takes
  case NoFold(typ: Type, fold: Id)
  case CountMismatch(owner: Str, unit: Str, expected: Int, actual: Int)
  case UnknownConstructor(name: Name)
  case NotExhaustive(pat: Pat)
  case Unreachable(pat: Pat)
  case NotAssignable(name: Name)
  case UnknownProcedure(name: Name)
  // a use of a name that only a command declares that does not parse
  case UnparsedDeclaration(name: Name)
  // a call in a proof of a name that is no lemma of its module
  case UnknownLemma(name: Name)
  // induction on a name that is no formal of a datatype of the lemma
  case NotInducible(name: Name)
  case UnknownException(typ: Type)
  case Unassigned(name: Name)
  case OutputUnassigned(output: Name, proc: Name)
  case MissingDefinition(name: Name)
  // a definition that differs from its signature in part
  case SignatureMismatch(name: Name, part: Differing)
  case PartlyExported(name: Name)
  case PrivateType(name: Name, sort: Name)
  // a formal, local, pattern variable, or formal of a lambda of the name of a local around it
  case HiddenLocal(name: Name)
  // a formal, local, pattern variable, or formal of a lambda named as the first name of a path that the module sees, of
  // which name.x would be a qualified name
  case QualifierLocal(name: Name)
  case VisibleEquality(sort: Name)
  // show, compare, or == of other values than those of a datatype of its module, see order_of of defs.u
  case MisshapenHook(name: Name, hook: Hook)
  case UnexportedOrder(fun: Name, sort: Name)
  // a pattern alias whose variables are not exactly its formals
  case AliasVariables(name: Name)
  // an alternative of a pattern that binds name where the first does not, or the other way if not binds
  case OrVariables(name: Name, binds: Bool)
  // a pattern alias with _, which matches but builds no value
  case PatternOnly(name: Name)
  // a pattern of assert raises that binds the variable name
  case RaisesVariables(name: Name)
  // an exported pattern alias of a constructor that importers do not see
  case PrivateConstructor(name: Name, constr: Name)
  // examples on the definition of an exported function or procedure, which belong to its signature in export
  case ExampleOnDefinition(name: Name)
  // a contract on the definition of an exported procedure, which belongs to its signature in export
  case ContractOnDefinition(name: Name)
  // a claim correct p(…) of the lemma name whose outs are not the outs of the lemma in their order
  case ClaimOuts(name: Name)
  // a claim correct p(…) of a procedure that is not defined before it in its package, whose loops the invariants take
  case ClaimOrder(proc: Name)
  // a step of the proof of a claim correct p(…) of the lemma name other than an invariant
  case ClaimStep(name: Name)
  // an invariant in the proof of a lemma that is no claim correct p(…)
  case InvariantOutsideClaim
  // a call in a proof of the lemma name, which is a claim correct p(…), which holds only for runs that end
  case ClaimCalled(name: Name)
  // raise of a value, or raises of a type, that is not of a datatype without type parameters
  case NotAnException(typ: Type)
  // the procedure name raises typ, which its raises omit
  case UndeclaredRaise(name: Name, typ: Type)
  // an import of a package of which its module uses nothing
  case UnusedImport(package: Path)
  // the procedure value name, lambda for a lambda, raises typ, which its type omits, as the place of its use gives it
  case UntypedRaise(name: Name, typ: Type)
  // a procedure value of a type that raises typ, which the type of the place it reaches omits
  case WiderRaise(typ: Type)
  // a handler, or the pattern of assert raises, of typ, which the body cannot raise
  case NeverRaised(typ: Type)
  // an error with the form to write instead, which the checker knows from the part, e.g. ++ for + of strings
  case Hinted(error: TypeError, hint: Str)
  // an error of the command at the position of an imported module, or of the main module for None
  case Located(module: Option[Path], pos: Pos, error: TypeError)

// the first part in which a definition differs from its signature, each as the signature has it and, with _, as the
// definition has it, where mode names the formals, formals, ins, outs, or refs
data Differing :=
  case DifferingParams(params: List[Id], params_: List[Id])
  case DifferingFormals(mode: Str, formals: List[Var], formals_: List[Var])
  case DifferingResult(typ: Type, typ_: Type)
  case DifferingRaises(raised: List[Type], raised_: List[Type])

// raises the first error of check_all
procedure check_program(
  in  source: Source,
  out q: Prog
) raises TypeError, InternalError

// the checked program of source and its errors in the order of the commands, each package checked against the
// signatures of those before it, also of those with errors, with the tests that generate makes of each package whose definitions check without errors
procedure check_all(
  in  source: Source,
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError

// the errors that checking found in q, which holds them as the errors of its commands, in their order
function diagnostics(q: Prog): List[Diagnostic]

// the errors of q that stand on the parts that generate no code, code_free_errors of ulang/syntax/syntax.u, as diagnostics
// gives them
function code_free_diagnostics(q: Prog): List[Diagnostic]

// whether checking found errors in q, without those of proofs, which the prover adds (with_proofs of ulang/prove/lemma.u)
function has_errors(q: Prog): Bool

// check_all of a source without its commands that do not parse, where a use of a name that one of them declares, of
// unparsed, is no unknown name but UnparsedDeclaration
procedure check_partial(
  in  source: Source,
      unparsed: Set[Id],
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError

// the packages that the checks of a run before have checked without errors, as imports, without their tests, by id
type Checks

function no_checks(): Checks

// check_all, or check_partial if partial, which takes the packages of checks instead of checking them again, but for the
// package of the main module of source, and adds those that it checks without errors to checks
procedure check_cached(
  in  source: Source,
      unparsed: Set[Id],
      partial: Bool,
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError],
  ref checks: Checks
) raises InternalError

// what the generated tests of a package see of it once its definitions check without errors: its commands at their
// positions, as written, and checked, its abstract types, the signature with the private declarations of its members,
// which modules each module sees, and the private declarations, which the other members do not see
data Checked :=
  case Checked(placed: List[(Pos, (Path, Cmd))], defined: List[(Path, At[Cmd])], abstract: List[Name], sig: Sig, table: List[(Path, List[Path])], hidden: Set[Name])

// whether the module m of the package c sees the declaration d
function is_seen(c: Checked, m: Path, d: Name): Bool

// the generator of no tests, for the commands that run none
function no_tests(c: Checked): List[(Pos, (Path, Cmd))]

// whether the patterns pats, without guards, match every value of type t, as the cases of an exhaustive match do
function covers_all(sig: Sig, t: Type, pats: List[Pat]): Bool

implementation

function covers_all(sig: Sig, t: Type, pats: List[Pat]): Bool :=
  missing(sig, empty(), List(for p in pats yield List(alias_free(sig, nowhere(p)).that)), List(t)) == None

// pat with the uses of the pattern aliases of sig expanded, as exhaustiveness takes them, while the checked program keeps
// them
function alias_free(sig: Sig, pat: At[Pat]): At[Pat] :=
  alias_expansion(lambda n => map_option(pat_alias_of(sig, n), lambda alias => Alias(List(for x in alias.formals yield x.name), alias.pat)), pat)

// the types of unknowns by their index
type Subst :=
  Map[Int, Type]

// how the values of the first of two unified types relate to those of the second: the same, flowing into them, or
// coming from them, which decides the bounds of their raises
data Direction :=
  case Both
  case Into
  case From

type Env :=
  List[(Name, Local)]

data Local :=
  case Local(typ: Type, assigned: Bool)

// a use of an overloaded name that more than one candidate fits, by the placeholder id that stands for it
data Pending :=
  case Pending(id: Name, name: Name, cands: List[(Name, Scheme)], typ: Type, pos: Pos)

// a part around the errors that are reported, which tells how they read
data Within :=
  // the arguments of a call of name, whose mismatches may have hints of name
  case InCall(name: Name)

// where hidden and hidden_sorts are the private declarations and sorts of the members of the package being checked, which
// the other members do not see, while sig has only the exports of the modules checked before, and unknown_sorts and
// loop_assigned are of the command being checked, the unknown types reported, each once, and the variables that the body
// of a while assigns which are not assigned before it, the latter of the procedure or procedure lambda being checked, and
// clashes counts the errors reported, also those that report drops since they reach TError, by which a trial tells that a
// unification failed
data State :=
  case State(sig: Sig, sub: Subst, count: Int, module: Path, visible: List[Path], table: List[(Path, List[Path])], pending: List[Pending], chosen: Map[Name, Name], hidden: Set[Name], hidden_sorts: Set[Name], at: Pos, errors: List[TypeError], unparsed: Set[Id], partial: Bool, within: List[Within], taken: Set[Int], loops: List[(Pos, Env)], scopes: Map[Name, List[Env]], unknown_sorts: Set[Name], loop_assigned: Set[Name], raises_count: Int, bounds: Buffer[Bound], solved: Option[Map[Int, Set[Name]]], aliased: Set[(Path, Path)], clashes: Int)

// the constructor of a pattern, where literals count as constructors without arguments
data Head :=
  case HCon(constr: Name)
  case HLit(lit: Lit)

// the head of tuples, which have no module
pattern HTuple(): Head :=
  HCon(Name(List(), ","))

function with_sig(s: State, sig: Sig): State :=
  s with sig := sig

// the state for checking a declaration of module m, where the substitution starts empty and unknowns of types are
// numbered from 1 again, since they do not outlive the command that introduces them, while the unknowns of raises and
// their bounds go on, which the raises pass solves after the package
function enter(s: State, m: Path): State :=
  s with sub := empty(), count := 0, module := m, visible := sees(m, s.table), pending := List(), chosen := empty(), at := Pos(0, 0), unknown_sorts := empty(), loop_assigned := empty()

function sees(m: Path, vs: List[(Path, List[Path])]): List[Path] :=
  value_or(get(m, vs), List(m))

function start(main: Path, vs: List[(Path, List[Path])]): State :=
  State(empty(), empty(), 0, main, sees(main, vs), vs, List(), empty(), empty(), empty(), Pos(0, 0), List(), empty(), false, List(), empty(), List(), empty(), empty(), empty(), 0, empty(), None, empty(), 0)

function in_module(m: Path, n: Name): Name :=
  Name(m, n.base)

function qualify(m: Path, cmd: Cmd): Cmd :=
  match cmd
    case CSort(name, params, typ) =>
      CSort(in_module(m, name), params, typ)

    case CData(name, params, constrs) =>
      CData(in_module(m, name), params, List(for k in constrs yield map_at(k, lambda c => qualify_constr(m, c))))

    case CFun(name, params, formals, typ, spec, body) =>
      CFun(in_module(m, name), params, formals, typ, spec, body)

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(in_module(m, name), params, ins, outs, refs, raised, spec, stmt)

    case CFunSig(name, params, formals, typ, spec) =>
      CFunSig(in_module(m, name), params, formals, typ, spec)

    case CProcSig(name, params, ins, outs, refs, raised, spec) =>
      CProcSig(in_module(m, name), params, ins, outs, refs, raised, spec)

    case CAbstract(name, params) =>
      CAbstract(in_module(m, name), params)

    case CPatAlias(name, params, formals, typ, pat) =>
      CPatAlias(in_module(m, name), params, formals, typ, pat)

    case CLemma(name, params, ins, outs, claim, proof) =>
      CLemma(in_module(m, name), params, ins, outs, claim, proof)

    case CNotation(_, _, _) =>
      cmd

    case CTest(name, vars, stmt) =>
      CTest(in_module(m, name), vars, stmt)
  end

function qualify_constr(m: Path, k: Constr): Constr :=
  k with name := in_module(m, k.name)

// each module sees itself and its direct imports, which include the implicit ones and the members of its package, for the
// imports of each module
function visibility(imports: List[(Path, List[Path])], main: Path): List[(Path, List[Path])] :=
  List(for m in distinct(List(main) ++ firsts(imports)) yield (m, distinct(List(m) ++ imports_of(imports, m))))

function imports_of(imports: List[(Path, List[Path])], m: Path): List[Path] :=
  value_or(get(m, imports), List())

// the declarations named n of a kind that the module sees, of which none hides another, so that a name of several is
// ambiguous unless its path tells them apart, and declared tells whether a name is a declaration of that kind; the owner
// of a name is part of it, so that the accessor T.f is no candidate of f
function visible_names(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := List(for d in names_of(s.sig, n.base) if declared(d) and d.owner == n.owner) in
  match n.path
    case List(_; _) =>
      List(for d in ds if is_qualified_by(n.path, d) and (is_visible_sort(s, d) or is_unwritable(n.path)))
    case List() =>
      List(for d in ds if is_visible_sort(s, d))
  end

// whether d is a declaration of the module of the path, or of a member of the package of the path
function is_qualified_by(path: Path, d: Name): Bool :=
  d.path == path or module_dir(d.path) == path

// whether users cannot write the path, of the modules that the checker and the tester make, such as (test).enumerate
function is_unwritable(path: Path): Bool :=
  match path
    case List(first; _) =>
      starts_with(first, "(")
    case List() =>
      false
  end

// the declarations named n of a kind in all modules that the module sees, its own included, whose types decide
// among them, with the owner of n
function overloads(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := List(for d in names_of(s.sig, n.base) if declared(d) and d.owner == n.owner) in
  match n.path
    case List(_; _) =>
      List(for d in ds if is_qualified_by(n.path, d) and (is_visible(s, d) or is_unwritable(n.path)))
    case List() =>
      List(for d in ds if is_visible(s, d))
  end

// an unknown name n, with the visible name that it most likely means, of the library for names of other languages,
// else the nearest by edits, if few
function unknown_variable(s: State, n: Name): TypeError :=
  match get(n.base, foreign_names())
    case Some(meant) =>
      Hinted(UnknownVariable(n), "write " ++ meant)

    case None =>
      match nearest(n.base, List(for base => ds in s.sig.named if exists(ds, lambda d => d.owner == List() and is_visible(s, d)) yield base))
        case Some(meant) =>
          Hinted(UnknownVariable(n), "did you mean " ++ meant ++ "?")
        case None =>
          UnknownVariable(n)
      end
  end

// the names of other languages for the functions and procedures of the library
function foreign_names(): Map[Str, Str] :=
  Map(
    "length" => "size",
    "len" => "size",
    "count" => "size",
    "print" => "os_println(in text)",
    "println" => "os_println(in text)",
    "append" => "xs ++ ys",
    "concat" => "xs ++ ys",
    "toString" => "show",
    "to_string" => "show",
    "map" => "List(for x in xs yield f(x))",
    "filter" => "List(for x in xs if p(x))")

// the name of names nearest to x by edits, if at most a quarter of its characters differ, so none for short names
function nearest(x: Str, names: List[Str]): Option[Str] :=
  let scored := List(for name in names if name != x yield (distance(x, name), name)), limit := size(x) / 4 in
  foldl(scored, None, lambda best, (d, name) => if d <= limit and is_better(d, best, scored) then Some(name) else best)

function is_better(d: Int, best: Option[Str], scored: List[(Int, Str)]): Bool :=
  match best
    case Some(b) =>
      exists(scored, lambda (e, name) => name == b and d < e)
    case None =>
      true
  end

// the edit distance of a and b, by insertions, deletions, and replacements of characters
function distance(a: Str, b: Str): Int :=
  let bs := chars(b) in
  value_or(last(foldl(chars(a), List(for j in range(0, size(bs) + 1)), lambda row, c => edit_row(row, c, bs))), 0)

// the next row of the distances, of one more character c of the first string, from the row of the characters before it
function edit_row(prev: List[Int], c: Char, bs: List[Char]): List[Int] :=
  match prev
    case List(first; _) =>
      List(first + 1; edit_cells(prev, c, bs, first + 1))
    case List() =>
      List()
  end

function edit_cells(prev: List[Int], c: Char, bs: List[Char], left: Int): List[Int] :=
  match (prev, bs)
    case (List(diag, up; rest), List(b; more)) =>
      let cell := min(min(up + 1, left + 1), if b == c then diag else diag + 1) in
      List(cell; edit_cells(List(up; rest), c, more, cell))

    case _ =>
      List()
  end

// whether the module sees the value d, which is its own, or of a module that it sees and not private to it
function is_visible(s: State, d: Name): Bool :=
  is_visible_among(s, s.hidden, d)

// whether the module sees the declaration d, which is its own, or of a module that it sees and not among the hidden
// declarations of the other members of its package
function is_visible_among(s: State, hidden: Set[Name], d: Name): Bool :=
  match name_module(d)
    case Some(m) =>
      m == s.module or contains(m, s.visible) and not contains(d, hidden)
    case None =>
      false
  end

// whether the module sees the type d, as is_visible of values
function is_visible_sort(s: State, d: Name): Bool :=
  is_visible_among(s, s.hidden_sorts, d)

function params(ps: List[Id]): List[Type] :=
  List(for p in ps yield TParam(p))

function literal(v: Lit): Type :=
  match v
    case LUnit =>
      TTuple(List())

    case LBool(_) =>
      TBool()

    case LInt(_) =>
      TInt()

    case LHex(_) =>
      TInt()

    case LStr(_) =>
      TStr()

    case LChar(_) =>
      TChar()
  end

// the literal as the checked program has it, where a hexadecimal number is an LInt
function checked_lit(lit: Lit): Lit :=
  match lit
    case LHex(num) =>
      LInt(num)
    case _ =>
      lit
  end

function logic(): Scheme :=
  Scheme(List(), TFun(List(TBool(), TBool()), TBool()))

// only what cannot be defined in the prelude, which are names without a module
function builtin_schemes(n: Name): List[Scheme] :=
  match n
    case Name(List(), base) =>
      builtin_scheme(base)
    case _ =>
      List()
  end

function builtin_scheme(b: Id): List[Scheme] :=
  let a := TParam("A") in
  match b
    case "<" =>
      List(Scheme(List(a), TFun(List(a, a), TBool())))

    case "and" =>
      List(logic())

    case "or" =>
      List(logic())

    case _ =>
      List(for hook in hooks() if hook_name(hook) == b yield hook_scheme(hook))
  end

// the Params and Metas in t
function free(t: Type): List[Type] :=
  match t
    case TParam(_) =>
      List(t)

    case TMeta(_) =>
      List(t)

    case THole =>
      List()

    case TError =>
      List()

    case TSort(_, args) =>
      distinct(List(for a in args for v in free(a) yield v))

    case TFun(args, res) =>
      distinct(List(for a in args ++ List(res) for v in free(a) yield v))

    case TProc(ins, outs, refs, raised) =>
      distinct(List(for a in ins ++ outs ++ refs ++ raised_types(raised) for v in free(a) yield v))

    case TTuple(types) =>
      distinct(List(for a in types for v in free(a) yield v))
  end

function has_holes(t: Type): Bool :=
  match t
    case THole =>
      true

    case TSort(_, args) =>
      exists(args, has_holes)

    case TFun(args, res) =>
      exists(args, has_holes) or has_holes(res)

    case TProc(ins, outs, refs, raised) =>
      exists(ins ++ outs ++ refs ++ raised_types(raised), has_holes)

    case TTuple(types) =>
      exists(types, has_holes)

    case TMeta(_) | TParam(_) | TError =>
      false
  end

function subst(t: Type, m: List[(Type, Type)]): Type :=
  match t
    case TSort(name, args) =>
      TSort(name, List(for a in args yield subst(a, m)))

    case TFun(args, res) =>
      TFun(List(for a in args yield subst(a, m)), subst(res, m))

    case TProc(ins, outs, refs, raised) =>
      TProc(List(for a in ins yield subst(a, m)), List(for a in outs yield subst(a, m)), List(for a in refs yield subst(a, m)), raised)

    case TTuple(types) =>
      TTuple(List(for a in types yield subst(a, m)))

    case THole | TMeta(_) | TParam(_) | TError =>
      value_or(get(t, m), t)
  end

function resolve(su: Subst, t: Type): Type :=
  match t
    case TMeta(meta) =>
      match get(meta, su)
        case Some(u) =>
          resolve(su, u)
        case None =>
          t
      end

    case _ =>
      t
  end

function occurs(su: Subst, i: Int, t: Type): Bool :=
  match resolve(su, t)
    case TMeta(meta) =>
      i == meta

    case TSort(_, args) =>
      exists(args, lambda a => occurs(su, i, a))

    case TFun(args, res) =>
      exists(args, lambda a => occurs(su, i, a)) or occurs(su, i, res)

    case TProc(ins, outs, refs, _) =>
      exists(ins ++ outs ++ refs, lambda a => occurs(su, i, a))

    case TTuple(types) =>
      exists(types, lambda a => occurs(su, i, a))

    case THole | TParam(_) | TError =>
      false
  end

function constructor_scheme(constr: ConstrSig): Scheme :=
  Scheme(constr.params, if constr.fields == List() then
    constr.typ
  else
    TFun(constr.fields, constr.typ))

function constructor_of(sig: Sig, k: Name): Scheme :=
  match constr_of(sig, k)
    case Some(constr) =>
      constructor_scheme(constr)
    case None =>
      Scheme(List(), TTuple(List()))
  end

// the meanings of n with their names, where local variables hide functions, constructors, and builtins, and declared hooks
// are no candidates, since the builtins reach them through the type of their arguments
function candidates(s: State, env: Env, n: Name): List[(Name, Scheme)] :=
  match get(n, env)
    case Some(l) =>
      List((n, Scheme(List(), l.typ)))
    case None =>
      List(for f in overloads(s, n, lambda f => is_fun(s.sig, f)) for sc in schemes_of(s.sig, f) if not is_hook(f, arity(sc.typ)) yield (f, sc)) ++ List(for k in overloads(s, n, lambda k => is_constr(s.sig, k)) yield (k, constructor_of(s.sig, k))) ++ List(for p in overloads(s, n, lambda p => is_proc(s.sig, p)) yield (p, proc_scheme(s.sig, p))) ++ List(for sc in builtin_schemes(n) yield (n, sc))
  end

// f with k arguments is the order, the equality, or the text of the values of a datatype, see order_of of defs.u
// constructors and pattern aliases, the names that patterns apply
function is_pattern_name(sig: Sig, n: Name): Bool :=
  is_constr(sig, n) or is_pat_alias(sig, n)

function is_hook(f: Name, k: Int): Bool :=
  hook_of(f.base, k) != None

// a procedure is a value of its type (in A, out B, ref C) raises …, whose raises are an unknown of each instance, those of
// the place of its use, which must include those of the procedure (raises_errors of ulang/check/raises.u)
function proc_scheme(sig: Sig, p: Name): Scheme :=
  match proc_of(sig, p)
    case Some(proc) =>
      Scheme(proc.params, TProc(proc.ins, proc.outs, proc.refs, RPending))
    case None =>
      Scheme(List(), THole)
  end

function with_arity(cs: List[(Name, Scheme)], k: Int): List[(Name, Scheme)] :=
  List(for (n, sc) in cs if arity(sc.typ) == k)

function has_arity(scs: List[Scheme], k: Int): Bool :=
  exists(scs, lambda sc => arity(sc.typ) == k)

function bind(xs: List[Var]): Env :=
  List(for x in xs yield (x.name, Local(x.typ, true)))

// no local of xs hides one of env, except those of the translations, whose names users cannot write, such as (acc) and
// (item), which nest
procedure unhidden(in env: Env, xs: List[Var], ref s: State) :=
  for x in xs if not starts_with(x.name.base, "(") and not is_dropped(x) and get(x.name, env) != None do
    report(in HiddenLocal(x.name), ref s)
  end

// unhidden at pos, the declaration of xs, a pattern of a let or a local, whose errors stand there, not on the let
procedure unhidden_at(in pos: Pos, env: Env, xs: List[Var], ref s: State) :=
  let outer := s.at
  s := s with at := decl_pos(outer, pos)
  unhidden(in env, xs, ref s)
  s := s with at := outer

// the coverage of the irrefutable pattern pat of a let or a local, whose errors stand at it, not on the let
procedure covered_at(in pat: At[Pat], typed_pat: At[Pat], t: Type, ref s: State) :=
  let outer := s.at
  s := s with at := decl_pos(outer, pat.pos)
  coverage(in t, List((typed_pat, true)), List(pat), ref s)
  s := s with at := outer

// the first names of the paths that the module sees, of its own package and module, the packages that it imports and
// their members, and the library, which a local may not take, since an access x.y of it would be a qualified name
function qualifiers(s: State): Set[Id] :=
  Set(for m in List(s.module; s.visible) for first in take(1, m) yield first)

// whether path names a package or a module that the module sees
function is_seen_path(s: State, path: Path): Bool :=
  exists(List(s.module; s.visible), lambda m => m == path or module_dir(m) == path)

// expr as a qualified name if it is one, an access x.a.….z of a name x that is no local, of which the longest x.a.….p that
// names a path that the module sees is the path, the name after it the base, and the names after that are accesses of
// fields, as the parser reads ulang.syntax.size, which has no syntax of its own in expressions
function qualified(s: State, env: Env, expr: At[Expr]): Option[At[Expr]] :=
  match access_chain(expr)
    case Some((x, fields)) if get(unqualified(x), env) == None =>
      let paths := List(for i in range(0, size(fields)) if is_seen_path(s, List(x; List(for (_, _, f) in take(i, fields) yield f))) yield i) in
      match reverse(paths)
        case List(i; _) =>
          let path := List(x; List(for (_, _, f) in take(i, fields) yield f)) in
          match drop(i, fields)
            case List((_, span, base); rest) =>
              Some(foldl(rest, AOk(span.start, span, EName(Name(path, base), THole)), lambda inner, (pos, outer, field) => AOk(pos, outer, EField(inner, field))))
            case List() =>
              None
          end

        case List() =>
          None
      end

    case _ =>
      None
  end

// the name x and the fields a, …, z of an access x.a.….z, each at the position and span of its access
function access_chain(expr: At[Expr]): Option[(Id, List[(Pos, Span, Id)])] :=
  match expr
    case AOk(_, _, EName(Name(List(), x), THole)) =>
      Some((x, List()))

    case AOk(pos, span, EField(base, field)) =>
      map_option(access_chain(base), lambda (x, fields) => (x, fields ++ List((pos, span, field))))

    case _ =>
      None
  end

function unassigned(xs: List[Var]): Env :=
  List(for x in xs yield (x.name, Local(x.typ, false)))

// env after assignments to xs, which are the innermost variables of their names
function assigned(env: Env, xs: List[Name]): Env :=
  match (env, xs)
    case (_, List()) =>
      env

    case (List(), _) =>
      List()

    case (List((n, l); rest), _) =>
      if contains(n, xs) then
        List((n, l with assigned := true); assigned(rest, xs -- List(n)))
      else
        List((n, l); assigned(rest, xs))
  end

// the variables that both paths assign, where env and other have the same variables
function joined(env: Env, other: Env): Env :=
  match (env, other)
    case (List((n, l); rest), List((_, k); more)) =>
      List(
        (n, l with assigned := l.assigned and k.assigned); joined(rest, more))

    case _ =>
      List()
  end

// the variables after a raise, where no path continues, which joins with others as if it assigned all of them
function unreachable(env: Env): Env :=
  List(for (n, l) in env yield (n, l with assigned := true))

procedure readable(in env: Env, n: Name, ref s: State) :=
  match get(n, env)
    case Some(Local(_, false)) =>
      report(in Unassigned(n), ref s)
    case _ =>
      skip
  end

procedure readables(in env: Env, ns: List[Name], ref s: State) :=
  for n in ns do
    readable(in env, n, ref s)
  end

// the outs os of procedure p must be assigned at the end of its body
procedure outputs(in p: Name, os: List[Var], env: Env, ref s: State) :=
  match os
    case List() =>
      skip

    case List(o; more) =>
      match get(o.name, env)
        case Some(Local(_, false)) if contains(o.name, s.loop_assigned) =>
          report(in Hinted(OutputUnassigned(o.name, p), "the checker assumes that a while may not run its body, so assign " ++ o.name.base ++ " also before it"), ref s)

        case Some(Local(_, false)) =>
          report(in OutputUnassigned(o.name, p), ref s)

        case _ =>
          skip
      end
      outputs(in p, more, env, ref s)
  end

// the variables of before that are not assigned there but are in after, the variables after a body
function newly_assigned(before: Env, after: Env): Set[Name] :=
  Set(for (n, l) in before if not l.assigned and exists(get(n, after), lambda x => x.assigned) yield n)

// the pattern of a case, and whether it has no guard, such that it may cover values
function case_of[A](b: At[Branch[A]]): (At[Pat], Bool) :=
  match b.that
    case Branch(pat, guard, _) =>
      (pat, guard == None)
  end

function zonk_guard(s: State, g: Option[At[Expr]]): Option[At[Expr]] :=
  map_option(g, lambda e => zonk_expr(s, e))

// t of the checked program, with the solutions of the raises pass for its unknowns of raises once they are known
function zonked(s: State, t: Type): Type :=
  solved_type(s.solved, zonk_type(s.sub, t))

// t with the solutions of its unknowns of raises once the raises pass has solved them, where one without a bound is none
function solved_type(solved: Option[Map[Int, Set[Name]]], t: Type): Type :=
  match t
    case TSort(name, args) =>
      TSort(name, List(for a in args yield solved_type(solved, a)))

    case TFun(args, res) =>
      TFun(List(for a in args yield solved_type(solved, a)), solved_type(solved, res))

    case TProc(ins, outs, refs, raised) =>
      TProc(List(for a in ins yield solved_type(solved, a)), List(for a in outs yield solved_type(solved, a)), List(for a in refs yield solved_type(solved, a)), solved_raises(solved, raised))

    case TTuple(types) =>
      TTuple(List(for a in types yield solved_type(solved, a)))

    case THole | TMeta(_) | TParam(_) | TError =>
      t
  end

function solved_raises(solved: Option[Map[Int, Set[Name]]], raised: Raises): Raises :=
  match (raised, solved)
    case (RUnknown(id), Some(solutions)) =>
      RSet(value_or(get(id, solutions), empty()))
    case _ =>
      raised
  end

function zonk_type(su: Subst, t: Type): Type :=
  let u := resolve(su, t) in
  match u
    case TSort(name, args) =>
      TSort(name, List(for a in args yield zonk_type(su, a)))

    case TFun(args, res) =>
      TFun(List(for a in args yield zonk_type(su, a)), zonk_type(su, res))

    case TProc(ins, outs, refs, raised) =>
      TProc(List(for a in ins yield zonk_type(su, a)), List(for a in outs yield zonk_type(su, a)), List(for a in refs yield zonk_type(su, a)), raised)

    case TTuple(types) =>
      TTuple(List(for a in types yield zonk_type(su, a)))

    case THole | TMeta(_) | TParam(_) | TError =>
      u
  end

// the module of the placeholder names of the pending uses of overloaded names, which no path names, until the end of
// the command chooses their declarations
function pending_module(): Path :=
  List("?")

// the declaration chosen for an overloaded name, which stands for it until the end of the command
function settled(s: State, n: Name): Name :=
  if name_module(n) == Some(pending_module()) then
    value_or(get(n, s.chosen), n)
  else
    n

function zonk_var(s: State, x: Var): Var :=
  Var(settled(s, x.name), zonked(s, x.typ))

function zonk_vars(s: State, xs: List[Var]): List[Var] :=
  List(for x in xs yield zonk_var(s, x))

function zonk_decls(s: State, xs: List[At[Var]]): List[At[Var]] :=
  List(for x in xs yield map_at(x, lambda v => zonk_var(s, v)))

function zonk_expr(s: State, expr: At[Expr]): At[Expr] :=
  map_at(expr, lambda e => zonk_node(s, e))

function zonk_node(s: State, expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(x) =>
      EVar(zonk_var(s, x))

    case EApp(fun, args) =>
      EApp(zonk_expr(s, fun), List(for a in args yield zonk_expr(s, a)))

    case EField(base, field) =>
      EField(zonk_expr(s, base), field)

    case EUpdate(base, field, value) =>
      EUpdate(zonk_expr(s, base), field, zonk_expr(s, value))

    case ELam(formals, body) =>
      ELam(List(for p in formals yield zonk_pat(s, p)), zonk_expr(s, body))

    case EProc(ins, outs, refs, raised, stmt) =>
      EProc(zonk_decls(s, ins), zonk_decls(s, outs), zonk_decls(s, refs), solved_raises(s.solved, raised), zonk_stmt(s, stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (zonk_pat(s, p), zonk_expr(s, e))), zonk_expr(s, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(zonk_expr(s, cond), zonk_expr(s, then_expr), zonk_expr(s, else_expr))

    case EMatch(arg, cases) =>
      EMatch(zonk_expr(s, arg), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda e => zonk_expr(s, e)))))

    case ETuple(args) =>
      ETuple(List(for arg in args yield zonk_expr(s, arg)))

    case EAnnotated(inner, typ) =>
      EAnnotated(zonk_expr(s, inner), zonked(s, typ))

    case EForm(form, elems, rest) =>
      EForm(form, List(for y in elems yield zonk_yield(s, y)), map_option(rest, lambda r => zonk_expr(s, r)))

    case EFor(form, gens, elem, rest) =>
      EFor(form, List(for g in gens yield zonk_gen(s, g)), zonk_yield(s, elem), map_option(rest, lambda r => zonk_expr(s, r)))
  end

function zonk_yield(s: State, y: Yield): Yield :=
  match y
    case YVal(value) =>
      YVal(zonk_expr(s, value))
    case YPair(key, value) =>
      YPair(zonk_expr(s, key), zonk_expr(s, value))
  end

function zonk_branch[A](s: State, b: Branch[A], zonk_body: A -> A): Branch[A] :=
  Branch(zonk_pat(s, b.pat), zonk_guard(s, b.guard), zonk_body(b.body))

function zonk_pat(s: State, pat: At[Pat]): At[Pat] :=
  map_at(pat, lambda p => zonk_pattern(s, p))

function zonk_pattern(s: State, pat: Pat): Pat :=
  match pat
    case PVar(x) =>
      PVar(zonk_var(s, x))

    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield zonk_pat(s, a)))

    case PTuple(args) =>
      PTuple(List(for q in args yield zonk_pat(s, q)))

    case POr(alts) =>
      POr(List(for q in alts yield zonk_pat(s, q)))

    // the type of an alternative of a handler, see handler_pattern
    case PAnnotated(inner, typ) =>
      PAnnotated(zonk_pat(s, inner), zonked(s, typ))

    case PWild | PLit(_) =>
      pat
  end

function zonk_binding(s: State, p: (Var, At[Expr])): (Var, At[Expr]) :=
  match p
    case (x, e) =>
      (zonk_var(s, x), zonk_expr(s, e))
  end

function zonk_stmt(s: State, stmt: At[Stmt]): At[Stmt] :=
  map_at(stmt, lambda y => zonk_statement(s, y))

function zonk_statement(s: State, stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for p in upd yield zonk_binding(s, p)))

    case SBlock(locals, stmts) =>
      SBlock(zonk_decls(s, locals), List(for d in stmts yield zonk_stmt(s, d)))

    case SLocal(mutable, decls) =>
      SLocal(mutable, List(for (p, e) in decls yield (zonk_pat(s, p), map_option(e, lambda x => zonk_expr(s, x)))))

    case SIf(cond, left, right) =>
      SIf(zonk_expr(s, cond), zonk_stmt(s, left), zonk_stmt(s, right))

    case SWhile(cond, body) =>
      SWhile(zonk_expr(s, cond), zonk_stmt(s, body))

    case SCall(proc, ins, outs, refs) =>
      SCall(settled(s, proc), List(for e in ins yield zonk_expr(s, e)), zonk_vars(s, outs), zonk_vars(s, refs))

    case SMatch(arg, cases) =>
      SMatch(zonk_expr(s, arg), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda y => zonk_stmt(s, y)))))

    case SAssert(cond) =>
      SAssert(zonk_expr(s, cond))

    case SAssertRaises(typ, pat, guard, body) =>
      SAssertRaises(zonked(s, typ), zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))

    case SRaise(value, typ) =>
      SRaise(zonk_expr(s, value), zonked(s, typ))

    case STry(body, catches) =>
      STry(zonk_stmt(s, body), List(for h in catches yield map_at(h, lambda c => zonk_handler(s, c))))

    case SFor(gens, body) =>
      SFor(List(for g in gens yield zonk_gen(s, g)), zonk_stmt(s, body))
  end

function zonk_proof(s: State, proof: Proof): Proof :=
  Proof(List(for step in proof.steps yield map_at(step, lambda node => zonk_step(s, node))), map_option(proof.split, lambda split => map_at(split, lambda node => zonk_split(s, node))))

function zonk_step(s: State, step: Step): Step :=
  match step
    case StepLocal(x, value) =>
      StepLocal(map_at(x, lambda v => zonk_var(s, v)), map_option(value, lambda e => zonk_expr(s, e)))

    case StepCall(name, ins, outs) =>
      StepCall(name, List(for e in ins yield zonk_expr(s, e)), zonk_vars(s, outs))

    case StepAssert(cond) =>
      StepAssert(zonk_expr(s, cond))

    case StepInvariant(cond) =>
      StepInvariant(zonk_expr(s, cond))

    case StepAssign(upd) =>
      StepAssign(List(for (x, e) in upd yield (zonk_var(s, x), zonk_expr(s, e))))
  end

function zonk_split(s: State, split: Split): Split :=
  match split
    case SplitInduction(formal, cases) =>
      SplitInduction(zonk_var(s, formal), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda p => zonk_proof(s, p)))))

    case SplitMatch(arg, cases) =>
      SplitMatch(zonk_expr(s, arg), List(for b in cases yield map_at(b, lambda br => zonk_branch(s, br, lambda p => zonk_proof(s, p)))))

    case SplitIf(cond, left, right) =>
      SplitIf(zonk_expr(s, cond), zonk_proof(s, left), map_option(right, lambda p => zonk_proof(s, p)))
  end

function zonk_gen(s: State, g: Gen): Gen :=
  match g
    case GVal(pat, over, typ) =>
      GVal(zonk_pat(s, pat), zonk_expr(s, over), zonked(s, typ))

    case GPair(key, value, over, typ) =>
      GPair(zonk_pat(s, key), zonk_pat(s, value), zonk_expr(s, over), zonked(s, typ))

    case GIf(cond) =>
      GIf(zonk_expr(s, cond))
  end

function zonk_handler(s: State, h: Catch): Catch :=
  match h
    case Catch(typ, pat, guard, body) =>
      Catch(zonked(s, typ), zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_cmd(s: State, cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, _, body) =>
      CFun(name, params, zonk_decls(s, formals), zonked(s, typ), no_spec(), zonk_expr(s, body))

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      CProc(name, params, zonk_decls(s, ins), zonk_decls(s, outs), zonk_decls(s, refs), raised, zonk_contract(s, spec), zonk_stmt(s, stmt))

    case CTest(name, vars, stmt) =>
      CTest(name, vars, zonk_stmt(s, stmt))

    case CLemma(name, params, ins, outs, claim, proof) =>
      CLemma(name, params, zonk_decls(s, ins), zonk_decls(s, outs), zonk_claim(s, claim), map_option(proof, lambda p => zonk_proof(s, p)))

    case CNoCode =>
      cmd
  end

// the contract of the spec, which the checked program keeps for the prover, without the examples, which are tests
function zonk_contract(s: State, spec: Spec): Spec :=
  Spec(List(for a in spec.pre yield zonk_expr(s, a)), map_option(spec.post, lambda e => zonk_expr(s, e)), List())

function zonk_claim(s: State, claim: Claim): Claim :=
  match claim
    case ClaimHolds(assms, concl) =>
      ClaimHolds(List(for a in assms yield zonk_expr(s, a)), zonk_expr(s, concl))
    case ClaimCorrect(proc, ins, outs) =>
      ClaimCorrect(settled(s, proc), List(for a in ins yield zonk_expr(s, a)), zonk_vars(s, outs))
  end

// exceptions are told apart by their types at runtime, which must therefore be known after checking
// the type t of an exception at pos, if it is not known
function unknown_at(pos: Pos, t: Type): Option[(Pos, Type)] :=
  map_option(unknown_type(t), lambda u => (pos, u))

function unknown_type(t: Type): Option[Type] :=
  if free(t) == List() then None else Some(t)

// the type of an exception that is not known, also of those raised in expressions
function unknown_in(stmt: At[Stmt]): Option[(Pos, Type)] :=
  match stmt.that
    case SAssign(upd) =>
      unknown_in_exprs(seconds(upd))

    case SBlock(_, stmts) =>
      unknown_in_all(stmts)

    case SLocal(_, decls) =>
      unknown_in_exprs(List(for (_, e) in decls for x in e yield x))

    case SIf(cond, left, right) =>
      or_else(unknown_in_expr(cond), or_else(unknown_in(left), unknown_in(right)))

    case SWhile(cond, body) =>
      or_else(unknown_in_expr(cond), unknown_in(body))

    case SCall(_, ins, _, _) =>
      unknown_in_exprs(ins)

    case SMatch(arg, cases) =>
      or_else(unknown_in_expr(arg), unknown_in_branches(cases))

    case SAssert(cond) =>
      unknown_in_expr(cond)

    case SAssertRaises(typ, pat, guard, body) =>
      or_else(if pat.that == PWild then None else unknown_at(stmt.pos, typ), or_else(unknown_in_guard(guard), unknown_in(body)))

    case SRaise(value, typ) =>
      or_else(unknown_at(stmt.pos, typ), unknown_in_expr(value))

    case STry(body, catches) =>
      or_else(unknown_in(body), unknown_in_handlers(catches))

    case SFor(gens, body) =>
      or_else(unknown_in_exprs(List(for g in gens yield gen_container(g))), unknown_in(body))

    case SSkip =>
      None
  end

function unknown_in_expr(expr: At[Expr]): Option[(Pos, Type)] :=
  match expr.that
    case EApp(fun, args) =>
      unknown_in_exprs(List(fun; args))

    case EField(base, _) =>
      unknown_in_expr(base)

    case EUpdate(base, _, value) =>
      unknown_in_exprs(List(base, value))

    case ELam(_, body) =>
      unknown_in_expr(body)

    case EProc(_, _, _, _, stmt) =>
      unknown_in(stmt)

    case ELet(bindings, body) =>
      unknown_in_exprs(seconds(bindings) ++ List(body))

    case EIte(cond, then_expr, else_expr) =>
      unknown_in_exprs(List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      unknown_in_exprs(List(arg; List(for b in cases for e in branch_exprs(b) yield e)))

    case ETuple(args) =>
      unknown_in_exprs(args)

    case EAnnotated(inner, _) =>
      unknown_in_expr(inner)

    case ELit(_) | EVar(_) =>
      None

    case EForm(_, elems, rest) =>
      unknown_in_exprs(List(for y in elems for e in yielded_exprs(y) yield e) ++ List(for r in rest yield r))

    case EFor(_, gens, elem, rest) =>
      unknown_in_exprs(List(for g in gens yield gen_container(g)) ++ yielded_exprs(elem) ++ List(for r in rest yield r))
  end

function unknown_in_exprs(exprs: List[At[Expr]]): Option[(Pos, Type)] :=
  find_map(exprs, unknown_in_expr)

function branch_exprs(b: At[Branch[At[Expr]]]): List[At[Expr]] :=
  match b.that
    case Branch(_, Some(g), body) =>
      List(g, body)
    case Branch(_, None, body) =>
      List(body)
  end

function unknown_in_all(xs: List[At[Stmt]]): Option[(Pos, Type)] :=
  find_map(xs, unknown_in)

function unknown_in_branches(bs: List[At[Branch[At[Stmt]]]]): Option[(Pos, Type)] :=
  find_map(bs, unknown_in_branch)

function unknown_in_branch(b: At[Branch[At[Stmt]]]): Option[(Pos, Type)] :=
  match b.that
    case Branch(_, guard, body) =>
      or_else(unknown_in_guard(guard), unknown_in(body))
  end

// handlers of _ catch exceptions of any type
function unknown_in_handlers(hs: List[At[Catch]]): Option[(Pos, Type)] :=
  find_map(hs, unknown_in_handler)

function unknown_in_handler(h: At[Catch]): Option[(Pos, Type)] :=
  match h.that
    case Catch(typ, pat, guard, body) =>
      let caught := if pat.that == PWild then None else unknown_at(h.pos, typ) in
      or_else(caught, or_else(unknown_in_guard(guard), unknown_in(body)))
  end

function unknown_in_guard(guard: Option[At[Expr]]): Option[(Pos, Type)] :=
  match guard
    case Some(g) =>
      unknown_in_expr(g)
    case None =>
      None
  end

function unknown_in_cmd(cmd: Cmd): Option[(Pos, Type)] :=
  match cmd
    case CFun(_, _, _, _, _, body) =>
      unknown_in_expr(body)

    case CProc(_, _, _, _, _, _, spec, stmt) =>
      or_else(unknown_in(stmt), find_map(spec.pre ++ List(for e in spec.post), unknown_in_expr))

    case CTest(_, _, stmt) =>
      unknown_in(stmt)

    case CLemma(_, _, _, _, claim, _) =>
      find_map(claim_exprs(claim), unknown_in_expr)

    case CNoCode =>
      None
  end

// the exhaustiveness check works on the patterns without their positions, whose witnesses are at Pos(0, 0)
function head_of(pat: Pat): Option[(Head, List[Pat])] :=
  match pat
    case PApp(constr, args) =>
      Some((HCon(constr), List(for a in args yield a.that)))

    case PTuple(args) =>
      Some((HTuple(), List(for a in args yield a.that)))

    case PLit(lit) =>
      Some((HLit(lit), List()))

    case PWild | PVar(_) =>
      None

    // alternatives, whose rows heads, defaults, specialize, and is_useful split before, and annotations, which checked
    // patterns do not have
    case PAnnotated(_, _) | POr(_) =>
      None
  end

// the constructors in the first column
function heads(rows: List[List[Pat]]): List[Head] :=
  match rows
    case List() =>
      List()

    case List(List(POr(alts); ps); rest) =>
      heads(or_rows(alts, ps) ++ rest)

    case List(List(p; _); rest) =>
      match head_of(p)
        case Some((h, _)) =>
          List(h; heads(rest))
        case None =>
          heads(rest)
      end

    case List(List(); rest) =>
      heads(rest)
  end

// the argument types of constructor k of a datatype with type arguments args
function constr_fields(sig: Sig, k: Name, args: List[Type]): List[Type] :=
  match constr_of(sig, k)
    case Some(constr) =>
      List(for a in constr.fields yield subst(a, zip(constr.params, args)))
    case None =>
      List()
  end

// all constructors of t with their argument types, if there are finitely many
function constructors_of(sig: Sig, su: Subst, t: Type): Option[List[(Head, List[Type])]] :=
  match zonk_type(su, t)
    case TBool() =>
      Some(List((HLit(LBool(true)), List()), (HLit(LBool(false)), List())))

    case TTuple(types) =>
      Some(List((HTuple(), types)))

    case TSort(name, args) =>
      match members_of(sig, name)
        case Some(ks) =>
          Some(List(for k in ks yield (HCon(k), constr_fields(sig, k, args))))
        case None =>
          None
      end

    case THole
       | TMeta(_)
       | TParam(_)
       | TError
       | TFun(_, _)
       | TProc(_, _, _, _) =>
      None
  end

function fields_of(sig: Sig, su: Subst, t: Type, h: Head): List[Type] :=
  match constructors_of(sig, su, t)
    case Some(ks) =>
      value_or(get(h, ks), List())
    case None =>
      List()
  end

function covers(hs: List[Head], ks: List[(Head, List[Type])]): Bool :=
  forall(ks, lambda (h, _) => contains(h, hs))

// the rows whose first pattern has no constructor, without it
function defaults(rows: List[List[Pat]]): List[List[Pat]] :=
  match rows
    case List() =>
      List()

    case List(List(POr(alts); ps); rest) =>
      defaults(or_rows(alts, ps) ++ rest)

    case List(List(p; ps); rest) =>
      match head_of(p)
        case Some(_) =>
          defaults(rest)
        case None =>
          List(ps; defaults(rest))
      end

    case List(List(); rest) =>
      defaults(rest)
  end

// the rows of the alternatives alts before the patterns ps, which the matrices take in place of the row of the
// alternatives, as Maranget's do
function or_rows(alts: List[At[Pat]], ps: List[Pat]): List[List[Pat]] :=
  List(for a in alts yield List(a.that; ps))

function specialize(rows: List[List[Pat]], h: Head, n: Int): List[List[Pat]] :=
  match rows
    case List() =>
      List()

    case List(List(POr(alts); ps); rest) =>
      specialize(or_rows(alts, ps) ++ rest, h, n)

    case List(List(p; ps); rest) =>
      match head_of(p)
        case Some((g, args)) =>
          if g == h then
            List(args ++ ps; specialize(rest, h, n))
          else
            specialize(rest, h, n)

        case None =>
          List(replicate(n, PWild) ++ ps; specialize(rest, h, n))
      end

    case List(List(); rest) =>
      specialize(rest, h, n)
  end

// some values of types ts match q but no row
function is_useful(sig: Sig, su: Subst, rows: List[List[Pat]], q: List[Pat], ts: List[Type]): Bool :=
  match (q, ts)
    case (List(), _) =>
      rows == List()

    case (List(POr(alts); ps), _) =>
      exists(or_rows(alts, ps), lambda row => is_useful(sig, su, rows, row, ts))

    case (List(p; ps), List(t; rest)) =>
      match head_of(p)
        case Some((h, args)) =>
          is_useful(sig, su, specialize(rows, h, size(args)), args ++ ps, fields_of(sig, su, t, h) ++ rest)

        case None =>
          match constructors_of(sig, su, t)
            case Some(ks) =>
              if covers(heads(rows), ks) then
                is_useful_in(sig, su, rows, ks, ps, rest)
              else
                is_useful(sig, su, defaults(rows), ps, rest)

            case None =>
              is_useful(sig, su, defaults(rows), ps, rest)
          end
      end

    case (List(_; _), List()) =>
      false
  end

function is_useful_in(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[(Head, List[Type])], pats: List[Pat], rest: List[Type]): Bool :=
  exists(ks, lambda (h, args) => is_useful(sig, su, specialize(rows, h, size(args)), replicate(size(args), PWild) ++ pats, args ++ rest))

function witness(h: Head, args: List[Pat]): Pat :=
  match h
    case HTuple() =>
      PTuple(List(for a in args yield nowhere(a)))

    case HCon(constr) =>
      PApp(constr, List(for a in args yield nowhere(a)))

    case HLit(lit) =>
      PLit(lit)
  end

// values of types ts, as patterns, that no row matches
function missing(sig: Sig, su: Subst, rows: List[List[Pat]], ts: List[Type]): Option[List[Pat]] :=
  match ts
    case List() =>
      if rows == List() then Some(List()) else None
    case List(t; rest) =>
      missing_in(sig, su, rows, heads(rows), constructors_of(sig, su, t), rest)
  end

// hs are the constructors in the first column, cs are all constructors of its type if there are finitely many
function missing_in(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[(Head, List[Type])]], rest: List[Type]): Option[List[Pat]] :=
  match cs
    case Some(ks) =>
      if covers(hs, ks) then
        first_missing(sig, su, rows, ks, rest)
      else
        other_missing(sig, su, rows, hs, cs, rest)

    case None =>
      other_missing(sig, su, rows, hs, cs, rest)
  end

function first_missing(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[(Head, List[Type])], rest: List[Type]): Option[List[Pat]] :=
  match ks
    case List() =>
      None

    case List((h, args); more) =>
      match missing(sig, su, specialize(rows, h, size(args)), args ++ rest)
        case Some(ws) =>
          match split_at(size(args), ws)
            case (found, others) =>
              Some(List(witness(h, found); others))
          end

        case None =>
          first_missing(sig, su, rows, more, rest)
      end
  end

function other_missing(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[(Head, List[Type])]], rest: List[Type]): Option[List[Pat]] :=
  match missing(sig, su, defaults(rows), rest)
    case Some(ws) =>
      Some(List(uncovered(hs, cs); ws))
    case None =>
      None
  end

// a value of the first column that hs do not cover
function uncovered(hs: List[Head], cs: Option[List[(Head, List[Type])]]): Pat :=
  match cs
    case Some(ks) =>
      if hs == List() then PWild else first_uncovered(hs, ks)
    case None =>
      PWild
  end

function first_uncovered(hs: List[Head], ks: List[(Head, List[Type])]): Pat :=
  match ks
    case List() =>
      PWild

    case List((h, args); rest) =>
      if contains(h, hs) then
        first_uncovered(hs, rest)
      else
        witness(h, replicate(size(args), PWild))
  end

procedure fresh(out t: Type, ref s: State) :=
  t := TMeta(s.count + 1), s := s with count := s.count + 1

procedure fresh_raises(out r: Raises, ref s: State) :=
  r := RUnknown(s.raises_count + 1), s := s with raises_count := s.raises_count + 1

procedure bind_meta(in i: Int, t: Type, ref s: State) :=
  if occurs(s.sub, i, t) then
    report(in InfiniteType(TMeta(i), zonk_type(s.sub, t)), ref s)
  else
    s := s with sub := put(i, t, s.sub)
  end

procedure unify(in t: Type, t_: Type, ref s: State) :=
  unify_toward(in Both, t, t_, ref s)

// t and t_ are the same type, but for the raises of their procedure types, which are bounds of how values of t relate
// to those of t_ in the direction d, flipped for the arguments of functions and the ins of procedures, and the same both
// ways for refs and the invariant params of datatypes
procedure unify_toward(in d: Direction, t: Type, t_: Type, ref s: State) :=
  let a := resolve(s.sub, t), b := resolve(s.sub, t_)
  match (a, b)
    case (TError, TMeta(meta)) =>
      bind_meta(in meta, TError, ref s)

    case (TMeta(meta), TError) =>
      bind_meta(in meta, TError, ref s)

    case (TError, _) =>
      skip

    case (_, TError) =>
      skip

    case (TMeta(i), TMeta(j)) =>
      if i != j then
        bind_meta(in i, b, ref s)
      end

    case (TMeta(meta), _) =>
      bind_toward(in d, meta, b, true, ref s)

    case (_, TMeta(meta)) =>
      bind_toward(in d, meta, a, false, ref s)

    case (TParam(x), TParam(y)) =>
      if x != y then
        report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TSort(f, xs), TSort(g, ys)) =>
      if f == g and size(xs) == size(ys) then
        let fixed := fixed_of(s.sig, f)
        for ((x, i), y) in zip(numbered(xs), ys) do
          unify_toward(in if contains(i, fixed) then Both else d, x, y, ref s)
        end
      else
        report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TFun(xs, r), TFun(ys, r_)) =>
      if size(xs) == size(ys) then
        unifies_toward(in flipped(d), xs, ys, ref s)
        unify_toward(in d, r, r_, ref s)
      else
        report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TTuple(xs), TTuple(ys)) =>
      if size(xs) == size(ys) then
        unifies_toward(in d, xs, ys, ref s)
      else
        report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case (TProc(xs, ys, zs, r), TProc(us, vs, ws, r_)) =>
      if size(xs) == size(us) and size(ys) == size(vs) and size(zs) == size(ws) then
        unifies_toward(in flipped(d), xs, us, ref s)
        unifies_toward(in d, ys, vs, ref s)
        unifies(in zs, ws, ref s)
        unify_raises(in d, r, r_, t, t_, ref s)
      else
        report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case _ =>
      report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
  end

// the raises r and r_ of the procedure types t and t_ relate in the direction d, where two sets are compared at once,
// and the other pairs are bounds, which the raises pass checks, while RPending is the raises of the type of a call,
// which take none
procedure unify_raises(
  in  d: Direction,
      r: Raises,
      r_: Raises,
      t: Type,
      t_: Type,
  ref s: State
) :=
  match (r, r_)
    case (RPending, _) =>
      skip

    case (_, RPending) =>
      skip

    case (RSet(names), RSet(names_)) =>
      if not relates(d, names, names_) then
        report(in CannotUnify(zonk_type(s.sub, t), zonk_type(s.sub, t_)), ref s)
      end

    case _ =>
      if r != r_ then
        s := s with bounds := s.bounds ++ bounds_toward(d, s.module, s.at, r, r_)
      end
  end

// whether the sets names and names_ relate in the direction d
function relates(d: Direction, names: Set[Name], names_: Set[Name]): Bool :=
  match d
    case Both =>
      names == names_

    case Into =>
      names -- names_ == empty()

    case From =>
      names_ -- names == empty()
  end

function bounds_toward(d: Direction, m: Path, pos: Pos, r: Raises, r_: Raises): List[Bound] :=
  match d
    case Both =>
      List(Bound(m, pos, r, r_), Bound(m, pos, r_, r))

    case Into =>
      List(Bound(m, pos, r, r_))

    case From =>
      List(Bound(m, pos, r_, r))
  end

// binds the unknown meta to t, or, where values flow between them, to a copy of t whose raises are unknowns of their own,
// bounded by those of t in the direction d, where first tells whether meta is the first of the types unified, so that
// the values that reach meta from several places may raise what each of them raises
procedure bind_toward(
  in  d: Direction,
      meta: Int,
      t: Type,
      first: Bool,
  ref s: State
) :=
  let u := zonk_type(s.sub, t)
  if d == Both or not has_procs(u) then
    bind_meta(in meta, t, ref s)
  else
    var copy: Type
    loosened(in u, out copy, ref s)
    bind_meta(in meta, copy, ref s)
    if first then
      unify_toward(in d, copy, u, ref s)
    else
      unify_toward(in d, u, copy, ref s)
    end
  end

function has_procs(t: Type): Bool :=
  match t
    case TProc(_, _, _, _) =>
      true

    case TSort(_, args) =>
      exists(args, has_procs)

    case TFun(args, res) =>
      exists(List(res; args), has_procs)

    case TTuple(types) =>
      exists(types, has_procs)

    case THole | TMeta(_) | TParam(_) | TError =>
      false
  end

// t with fresh unknowns for all its raises
procedure loosened(in t: Type, out u: Type, ref s: State) :=
  match t
    case TProc(ins, outs, refs, _) =>
      var us: List[Type], r: Raises
      loosened_all(in ins ++ outs ++ refs, out us, ref s)
      fresh_raises(out r, ref s)
      u := TProc(take(size(ins), us), take(size(outs), drop(size(ins), us)), drop(size(ins) + size(outs), us), r)

    case TSort(name, args) =>
      var us: List[Type]
      loosened_all(in args, out us, ref s)
      u := TSort(name, us)

    case TFun(args, res) =>
      var us: List[Type], v: Type
      loosened_all(in args, out us, ref s)
      loosened(in res, out v, ref s)
      u := TFun(us, v)

    case TTuple(types) =>
      var us: List[Type]
      loosened_all(in types, out us, ref s)
      u := TTuple(us)

    case THole | TMeta(_) | TParam(_) | TError =>
      u := t
  end

procedure loosened_all(in ts: List[Type], out us: List[Type], ref s: State) :=
  var u: Type
  us := List()
  for t in ts do
    loosened(in t, out u, ref s)
    us := us ++ List(u)
  end

// sig with the invariant params of the datatypes names, which grow from none until no field of their constructors takes
// a param that is not invariant yet in a position that is not covariant
function with_variances(sig: Sig, names: List[Name]): Sig :=
  let next := foldl(names, sig, lambda acc, n => with_fixed(acc, n, fixed_params(acc, n))) in
  if List(for n in names yield fixed_of(next, n)) == List(for n in names yield fixed_of(sig, n)) then
    sig
  else
    with_variances(next, names)

// the positions of the params of the datatype n that a field of one of its constructors takes where its values flow in
function fixed_params(sig: Sig, n: Name): Set[Int] :=
  Set(for k in value_or(members_of(sig, n), List()) for constr in constr_of(sig, k) for (p, i) in numbered(constr.params) if exists(constr.fields, lambda f => takes_fixed(sig, p, f, true)) yield i)

// whether t takes the param p where its values flow in, in an argument of a function, an in or a ref of a procedure, or
// an invariant param of a datatype, where covariant tells whether the positions around t are all covariant
function takes_fixed(sig: Sig, p: Type, t: Type, covariant: Bool): Bool :=
  match t
    case TParam(_) =>
      t == p and not covariant

    case TSort(name, args) =>
      let fixed := fixed_of(sig, name) in
      exists(numbered(args), lambda (a, i) => takes_fixed(sig, p, a, covariant and not contains(i, fixed)))

    case TFun(args, res) =>
      exists(args, lambda a => takes_fixed(sig, p, a, false)) or takes_fixed(sig, p, res, covariant)

    case TProc(ins, outs, refs, _) =>
      exists(ins ++ refs, lambda a => takes_fixed(sig, p, a, false)) or exists(outs, lambda a => takes_fixed(sig, p, a, covariant))

    case TTuple(types) =>
      exists(types, lambda a => takes_fixed(sig, p, a, covariant))

    case THole | TMeta(_) | TError =>
      false
  end

function flipped(d: Direction): Direction :=
  match d
    case Both =>
      Both

    case Into =>
      From

    case From =>
      Into
  end

procedure unifies(in xs: List[Type], ys: List[Type], ref s: State) :=
  unifies_toward(in Both, xs, ys, ref s)

procedure unifies_toward(
  in  d: Direction,
      xs: List[Type],
      ys: List[Type],
  ref s: State
) :=
  match (xs, ys)
    case (List(x; xs_), List(y; ys_)) =>
      unify_toward(in d, x, y, ref s)
      unifies_toward(in d, xs_, ys_, ref s)

    case (List(), List()) =>
      skip

    case _ =>
      report(in CountMismatch("", "values", size(xs), size(ys)), ref s)
  end

procedure fresh_list[A](in xs: List[A], out ts: List[Type], ref s: State) :=
  var t: Type
  ts := List()
  for _ in xs do
    fresh(out t, ref s)
    ts := ts ++ List(t)
  end

procedure instance(in ps: List[Type], out m: List[(Type, Type)], ref s: State) :=
  var t: Type
  m := List()
  for p in ps do
    fresh(out t, ref s)
    m := m ++ List((p, t))
  end

procedure instantiate(in sc: Scheme, out t: Type, ref s: State) :=
  var m: List[(Type, Type)]
  instance(in sc.params, out m, ref s)
  match subst(zonk_type(s.sub, sc.typ), m)
    case TProc(ins, outs, refs, RPending) =>
      var r: Raises
      fresh_raises(out r, ref s)
      t := TProc(ins, outs, refs, r)

    case u =>
      t := u
  end

// the names ns, which must be distinct, of what they are, e.g. formals
procedure unique(in what: Str, ns: List[Name], ref s: State) :=
  match repeated(ns)
    case Some(n) =>
      report(in Duplicate(what, n.base), ref s)
    case None =>
      skip
  end

procedure unique_ids(in what: Str, ns: List[Id], ref s: State) :=
  match repeated(ns)
    case Some(n) =>
      report(in Duplicate(what, n), ref s)
    case None =>
      skip
  end

// the number n of the units of owner, which expects m of them, e.g. the arguments of a constructor
procedure same_length(in owner: Str, unit: Str, m: Int, n: Int, ref s: State) :=
  if m != n then
    report(in CountMismatch(owner, unit, m, n), ref s)
  end

// expands type definitions and replaces holes by fresh unknowns
procedure normalize(in t: Type, out u: Type, ref s: State) :=
  match t
    case THole =>
      fresh(out u, ref s)

    case TParam(_) =>
      u := t

    case TMeta(_) =>
      u := t

    case TError =>
      u := t

    case TFun(args, res) =>
      var us: List[Type], v: Type
      normalizes(in args, out us, ref s)
      normalize(in res, out v, ref s)
      u := TFun(us, v)

    case TTuple(types) =>
      var us: List[Type]
      normalizes(in types, out us, ref s)
      u := TTuple(us)

    case TProc(ins, outs, refs, raised) =>
      var us: List[Type], r: Raises
      normalizes(in ins ++ outs ++ refs, out us, ref s)
      normalized_raises(in raised, out r, ref s)
      u := match split_at(size(ins), us)
        case (in_types, others) =>
          match split_at(size(outs), others)
            case (out_types, ref_types) =>
              TProc(in_types, out_types, ref_types, r)
          end
      end

    case TSort(name, args) =>
      match visible_names(s, name, lambda n => is_sort(s.sig, n))
        case List(m) =>
          normalize_sort(in m, args, out u, ref s)

        case List() =>
          unknown_sort(in name, ref s)
          u := TError

        case ms =>
          report(in Ambiguous(name, List(for m in ms yield (m, Scheme(List(), THole)))), ref s)
          fresh(out u, ref s)
      end
  end

// the use of the alias n by the module checked, which the expansion leaves no name of, for UnusedImport
procedure aliased(in n: Name, ref s: State) :=
  match name_module(n)
    case Some(m) =>
      s := s with aliased := Set((s.module, m); s.aliased)
    case None =>
      skip
  end

// the use of the pattern alias n, which also uses the modules of the pattern of the alias, as its expansion does
procedure pattern_aliased(in n: Name, alias: PatAlias, ref s: State) :=
  aliased(in n, ref s)
  s := s with aliased := s.aliased ++ Set(for m in pat_modules(alias.pat) yield (s.module, m))

// reported once per command, e.g. a type parameter that its declaration omits
procedure unknown_sort(in n: Name, ref s: State) :=
  if not contains(n, s.unknown_sorts) then
    report(in UnknownSort(n), ref s)
    s := s with unknown_sorts := Set(n; s.unknown_sorts)
  end

procedure normalize_sort(
  in  n: Name,
      args: List[Type],
  out u: Type,
  ref s: State
) :=
  match data_of(s.sig, n)
    case Some(k) if size(args) != k =>
      report(in SortArity(n, k, size(args)), ref s)
      u := TError

    case Some(_) =>
      var us: List[Type]
      normalizes(in args, out us, ref s)
      u := TSort(n, us)

    case None =>
      match type_alias_of(s.sig, n)
        case Some(alias) if size(args) != size(alias.params) =>
          report(in SortArity(n, size(alias.params), size(args)), ref s)
          u := TError

        case Some(alias) =>
          var us: List[Type]
          normalizes(in args, out us, ref s)
          u := subst(alias.typ, zip(params(alias.params), us))
          aliased(in n, ref s)

        case None =>
          unknown_sort(in n, ref s)
          fresh(out u, ref s)
      end
  end

// step applied to each of xs in order, threading the state
procedure map_state[A, B](
  in  xs: List[A],
      step: (in A, out B, ref State) raises TypeError,
  out ys: List[B],
  ref s: State
) :=
  var y: B, found: Buffer[B] := empty()
  for x in xs do
    step(in x, out y, ref s)
    found := found ++ List(y)
  end
  ys := List(for z in found)

procedure normalizes(in ts: List[Type], out us: List[Type], ref s: State) :=
  map_state(in ts, normalize, out us, ref s)

procedure known(in t: Type, what: Name, out u: Type, ref s: State) :=
  if has_holes(t) then
    report(in MissingType(what), ref s)
  end
  normalize(in t, out u, ref s)

procedure knowns(
  in  ts: List[Type],
      what: Name,
  out us: List[Type],
  ref s: State
) :=
  map_state(in ts, lambda in t: Type, out u: Type, ref r: State =>
    known(in t, what, out u, ref r)
  end, out us, ref s)

// the declared variables of a lambda or locals, which are what, e.g. formals, each with the errors of its type at it
procedure formals(
  in  what: Str,
      xs: List[At[Var]],
  out ys: List[Var],
  ref s: State
) :=
  unique_decls(in what, xs, ref s)
  map_state(in xs, normalize_var, out ys, ref s)

procedure normalize_var(in x: At[Var], out y: Var, ref s: State) :=
  var u: Type
  let outer := s.at
  s := s with at := decl_pos(outer, x.pos)
  normalize(in x.that.typ, out u, ref s)
  y := Var(x.that.name, u), s := s with at := outer

// the parameters and locals, which have types, each with the errors of its type at it
procedure signature(in xs: List[At[Var]], out ys: List[Var], ref s: State) :=
  unique_decls(in "formal", xs, ref s)
  map_state(in xs, known_var, out ys, ref s)

procedure known_var(in x: At[Var], out y: Var, ref s: State) :=
  var u: Type
  let outer := s.at
  s := s with at := decl_pos(outer, x.pos)
  known(in x.that.typ, x.that.name, out u, ref s)
  y := Var(x.that.name, u), s := s with at := outer

// the declarations decls with the types of xs, which are their variables as checked
function retyped(decls: List[At[Var]], xs: List[Var]): List[At[Var]] :=
  List(for (d, x) in zip(decls, xs) yield map_at(d, lambda _ => x))

// the position of a declaration, or else of what declares it, outer, if the parser did not read it
function decl_pos(outer: Pos, pos: Pos): Pos :=
  if pos == Pos(0, 0) then outer else pos

// the declarations xs, which must have distinct names, of what they are, e.g. formals, where a repeated one is reported
// at its second declaration
procedure unique_decls(in what: Str, xs: List[At[Var]], ref s: State) :=
  match repeated_decl(xs, empty())
    case Some(x) =>
      report(in at_use(decl_pos(s.at, x.pos), Duplicate(what, x.that.name.base)), ref s)
    case None =>
      skip
  end
  for x in xs if contains(x.that.name.base, qualifiers(s)) do
    report(in at_use(decl_pos(s.at, x.pos), QualifierLocal(x.that.name)), ref s)
  end

// the first of xs whose name is declared before it, in seen or in xs
function repeated_decl(xs: List[At[Var]], seen: Set[Name]): Option[At[Var]] :=
  match xs
    case List() =>
      None

    case List(x; rest) =>
      if contains(x.that.name, seen) then
        Some(x)
      else
        repeated_decl(rest, Set(x.that.name; seen))
  end

// a use of n elaborated with an instance of sc, where w is normalized
procedure use(in n: Name, w: Type, sc: Scheme, out x: Var, ref s: State) :=
  var u: Type
  instantiate(in sc, out u, ref s)
  unify(in u, w, ref s)
  x := Var(n, u)

// a use of n of type w, which is normalized, as the one of the candidates cs that fits w
procedure use_name(
  in  n: Name,
      cs: List[(Name, Scheme)],
      w: Type,
  out x: Var,
  ref s: State
) :=
  match cs
    case List() if overloads(s, n, lambda a => is_pat_alias(s.sig, a)) != List() =>
      report(in PatternOnly(n), ref s)
      x := Var(n, w)

    case List() =>
      report(in unknown_variable(s, n), ref s)
      unify(in w, TError, ref s)
      x := Var(n, TError)

    case List((m, sc)) =>
      use(in m, w, sc, out x, ref s)

    case _ =>
      var m: Name
      choose(in n, cs, w, out m, ref s)
      x := Var(m, w)
  end

// the result of the type w of a function, if it is one, is TError
procedure unify_result(in w: Type, ref s: State) :=
  match zonk_type(s.sub, w)
    case TFun(_, r) =>
      unify(in r, TError, ref s)
    case _ =>
      unify(in w, TError, ref s)
  end

// the one of the candidates cs that fits w, or a placeholder for the use if several fit, which stays open
procedure choose(
  in  n: Name,
      cs: List[(Name, Scheme)],
      w: Type,
  out m: Name,
  ref s: State
) :=
  var ok: List[((Name, Scheme), State)]
  trials(in cs, w, s, out ok)
  match ok
    // a use that no candidate fits has the result TError, so that what uses it makes no follow-ups
    case List() =>
      report(in NoOverload(n, zonk_type(s.sub, w)), ref s)
      unify_result(in w, ref s)
      m := n

    case List(((m_, _), s_)) =>
      m := m_, s := s_

    case _ =>
      m := Name(pending_module(), show(s.count + 1))
      s := s with count := s.count + 1, pending := s.pending ++ List(Pending(m, n, firsts(ok), w, s.at))
  end

// the candidates that fit w, each with the state after unifying its instance with w, where a candidate fits if the
// unification reports nothing, also no clash with a part of type TError, which report drops, so that an argument of an
// erroneous type, as List[TError], keeps only the candidates of its container
procedure trials(
  in  cs: List[(Name, Scheme)],
      w: Type,
      s: State,
  out ok: List[((Name, Scheme), State)]
) :=
  var u: State
  ok := List()
  for (m, sc) in cs do
    u := s
    trial(in sc, w, ref u)
    if u.clashes == s.clashes then
      ok := ok ++ List(((m, sc), u))
    end
  end

procedure trial(in sc: Scheme, w: Type, ref s: State) :=
  var u: Type
  instantiate(in sc, out u, ref s)
  unify(in u, w, ref s)

// the open uses, until none can be decided, where each is decided once one of its candidates fits
procedure solve(ref s: State) :=
  var changed := true, ps: List[Pending]
  while changed do
    ps := s.pending, changed := false
    s := s with pending := List()
    revisit(in ps, ref changed, s)
  end

procedure revisit(in ps: List[Pending], ref changed: Bool, s: State) :=
  match ps
    case List() =>
      skip

    case List(p; rest) =>
      var ok: List[((Name, Scheme), State)]
      trials(in p.cands, p.typ, s, out ok)
      match ok
        case List() =>
          if not has_error_type(zonk_type(s.sub, p.typ)) then
            s := s with errors := s.errors ++ List(at_use(p.pos, NoOverload(p.name, zonk_type(s.sub, p.typ))))
          end

        case List(((m, _), s_)) =>
          s := s_ with chosen := put(p.id, m, s_.chosen)
          changed := true

        case _ =>
          s := s with pending := s.pending ++ List(p with cands := firsts(ok))
          if size(ok) < size(p.cands) then
            changed := true
          end
      end
      revisit(in rest, ref changed, s)
  end

// the uses of a command, each of which must be decided by its types alone, so that a use means the one candidate that fits
// it, whatever the order in which the uses are solved
procedure settle(ref s: State) :=
  solve(ref s)
  match List(for p in s.pending if not has_error_type(zonk_type(s.sub, p.typ)))
    case List(p; _) =>
      s := s with errors := s.errors ++ List(at_use(p.pos, Ambiguous(p.name, p.cands)))
    case List() =>
      skip
  end

// an expression at its position, where an error inside is reported at the innermost position, and an open use of an
// overloaded name remembers it for the end of the command, where it is solved
procedure infer(
  in  env: Env,
      expr: At[Expr],
  out res: At[Expr],
      typ: Type,
  ref s: State
) :=
  infer_expected(in env, expr, None, out res, typ, ref s)

// expr as infer does, against the type t that what names if expected is Some((t, what)), which it passes down to its
// parts, so that a part of the wrong type is reported at the part, and which the caller then expects of the whole
procedure infer_expected(
  in  env: Env,
      expr: At[Expr],
      expected: Option[(Type, Str)],
  out res: At[Expr],
      typ: Type,
  ref s: State
) :=
  match expr
    case AOk(pos, span, node) =>
      let outer := s.at, before := size(s.errors)
      var x: Expr, errors: List[Diagnostic]
      s := s with at := pos
      infer_node(in env, pos, span, node, expected, out x, typ, ref s)
      take_errors(in pos, before, out errors, ref s)
      res := checked_at(pos, span, x, errors), s := s with at := outer

    // reported by the parser, of any type
    case AUnparsed(_, _, _, _) =>
      res := expr, typ := TError

    // the checker makes error nodes of the parts that the parser read, which it checks once
    case AErr(_, _, _, _) =>
      raise Unexpected("error node")
  end

// the expression expr at pos, where the translations of forms, generators, and lambdas with patterns are at pos, and
// expected the type that a part around it expects, if known, which the parts of applications, tuples, lets, and forms
// are checked against
procedure infer_node(
  in  env: Env,
      pos: Pos,
      span: Span,
      expr: Expr,
      expected: Option[(Type, Str)],
  out res: Expr,
      typ: Type,
  ref s: State
) :=
  match expr
    case ELit(lit) =>
      res := ELit(checked_lit(lit)), typ := literal(lit)

    case EName(name, a) =>
      var z: Var, w: Type
      normalize(in a, out w, ref s)
      use_name(in name, candidates(s, env, name), w, out z, ref s)
      readable(in env, name, ref s)
      res := EVar(z), typ := z.typ

    case EApp(fun, args) =>
      application(in env, value_or(qualified(s, env, fun), fun), args, expected, out res, typ, ref s)

    case EField(base, field) =>
      match qualified(s, env, AOk(pos, span, expr))
        case Some(name) =>
          infer_node(in env, name.pos, name.span, name.that, expected, out res, typ, ref s)
        case None =>
          field_access(in env, pos, span, "." ++ field, base, List(), out res, typ, ref s)
      end

    case EUpdate(base, field, value) =>
      field_access(in env, pos, span, "." ++ field ++ ":=", base, List(value), out res, typ, ref s)

    case ELam(pats, body) =>
      match variables_of(s, pats)
        case Some(bound) =>
          var xs: List[Var], b: At[Expr], u: Type
          formals(in "formal", bound, out xs, ref s)
          unhidden(in env, xs, ref s)
          infer(in bind(xs) ++ env, body, out b, u, ref s)
          res := ELam(List(for (p, x) in zip(bound, xs) yield AOk(p.pos, p.span, PVar(x))), b), typ := TFun(List(for x in xs yield x.typ), u)

        case None =>
          var ts: List[Type]
          fresh_list(in pats, out ts, ref s)
          match expected
            case Some((t, what)) =>
              var u: Type
              lambda_patterns(in env, pats, ts, body, out res, u, ref s)
              expect(in pos, what, t, u, ref s)
              typ := t

            case None =>
              lambda_patterns(in env, pats, ts, body, out res, typ, ref s)
          end
      end

    // the body sees the variables around it, but assigns only the outs and refs of the lambda, and its loops are its
    // own, so the hint of outputs sees only those of the lambda
    case EProc(ins, outs, refs, _, stmt) =>
      let loop_assigned := s.loop_assigned
      var xs: List[Var], ys: List[Var], zs: List[Var], r: Raises, y: At[Stmt], inner: Env
      unique_decls(in "formal", List(for x in ins if not is_dropped(x.that)) ++ outs ++ refs, ref s)
      map_state(in ins, normalize_var, out xs, ref s)
      map_state(in outs, normalize_var, out ys, ref s)
      map_state(in refs, normalize_var, out zs, ref s)
      unhidden(in env, xs ++ ys ++ zs, ref s)
      inner := bind(xs) ++ unassigned(ys) ++ bind(zs) ++ env, s := s with loop_assigned := empty()
      statement(in List(for x in ys ++ zs yield x.name), stmt, out y, ref inner, s)
      outputs(in unqualified("lambda"), ys, inner, ref s)
      s := s with loop_assigned := loop_assigned
      fresh_raises(out r, ref s)
      res := EProc(retyped(ins, xs), retyped(outs, ys), retyped(refs, zs), r, y), typ := TProc(List(for x in xs yield x.typ), List(for x in ys yield x.typ), List(for x in zs yield x.typ), r)

    // the bindings of a let are sequential, each in the scope of those before it, where a binding of a pattern that is no
    // variable is irrefutable, checked for exhaustiveness as the cases of a match; lets do not generalize, only
    // declarations have type parameters
    case ELet(bound, body) =>
      var inner := env, bindings: List[(At[Pat], At[Expr])] := List(), covered: List[(At[Pat], Type, At[Pat])] := List(), b: At[Expr]
      for (pat, value) in bound do
        match variables_of(s, List(pat))
          case Some(List(x)) =>
            var xs: List[Var], typed_value_list: List[At[Expr]]
            formals(in "binding", List(x), out xs, ref s)
            unhidden_at(in pat.pos, inner, xs, ref s)
            checks(in inner, "the bindings", List(value), List(for y in xs yield y.typ), out typed_value_list, ref s)
            bindings := bindings ++ zip(List(for y in xs yield pat with that := PVar(y)), typed_value_list), inner := bind(xs) ++ inner

          case _ =>
            var t: Type, typed_value: At[Expr], typed_pat: At[Pat], xs: List[Var]
            fresh(out t, ref s)
            check(in inner, value, t, "the bindings", out typed_value, ref s)
            typed_pattern(in pat, t, out typed_pat, xs, ref s)
            unhidden_at(in pat.pos, inner, xs, ref s)
            bindings := bindings ++ List((typed_pat, typed_value)), covered := covered ++ List((typed_pat, t, pat)), inner := bind(xs) ++ inner
        end
      end
      infer_body(in inner, body, expected, out b, typ, ref s)
      solve(ref s)
      for (typed_pat, t, pat) in covered do
        covered_at(in pat, typed_pat, t, ref s)
      end
      res := ELet(bindings, b)

    case EIte(cond, then_expr, else_expr) =>
      var b: At[Expr], c: At[Expr], l: At[Expr], u: Type, w: Type
      check(in env, cond, TBool(), "the condition of if", out c, ref s)
      infer(in env, then_expr, out l, u, ref s)
      // the value is of either branch, so it may raise what each raises
      fresh(out w, ref s)
      unify_toward(in Into, u, w, ref s)
      check(in env, else_expr, w, "the else branch", out b, ref s)
      res := EIte(c, l, b), typ := w

    case ETuple(items) =>
      var exprs: List[At[Expr]], ts: List[Type]
      match component_types(s, expected, size(items))
        case Some(us) =>
          exprs := List()
          for ((item, u), i) in zip(zip(items, us), range(1, size(items) + 1)) do
            var typed_item: At[Expr]
            check(in env, item, u, "component " ++ show(i) ++ " of the tuple", out typed_item, ref s)
            exprs := exprs ++ List(typed_item)
          end
          ts := us

        case None =>
          infers(in env, items, out exprs, ts, ref s)
      end
      res := ETuple(exprs), typ := TTuple(ts)

    // the expression is checked against the ascribed type, which resolves its fields and overloads and reports a part of
    // another type at the part, and the checked program keeps the ascription, which the backends take as its expression
    case EAnnotated(inner, ascribed) =>
      var typed_inner: At[Expr]
      normalize(in ascribed, out typ, ref s)
      check(in env, inner, typ, "the ascription", out typed_inner, ref s)
      res := EAnnotated(typed_inner, typ)

    case EMatch(arg, cases) =>
      var c: At[Expr], u: Type, bs: List[At[Branch[At[Expr]]]]
      fresh(out typ, ref s)
      infer(in env, arg, out c, u, ref s)
      expr_branches(in env, cases, u, typ, out bs, ref s)
      solve(ref s)
      coverage(in u, List(for br in bs yield case_of(br)), firsts(List(for br in cases yield case_of(br))), ref s)
      res := EMatch(c, bs)

    // a form is typed by the type of its elements and the container of its name, of which the checked program keeps the parts
    // as the source wrote them, which ulang/expand/expand.u builds by the builders of the module of the container
    case EForm(form, elems, rest) =>
      var a: Type, r: Type, typed_elems: List[Yield], typed_rest: Option[At[Expr]]
      form_types(in form, expected, out a, r, ref s)
      yields(in env, form, elems, a, out typed_elems, ref s)
      form_rest(in env, form, rest, r, out typed_rest, ref s)
      fitted(in pos, expected, r, out typ, ref s)
      res := EForm(form, typed_elems, typed_rest)

    // the generators of a form, each in the scope of those before it, and the rest of the form, outside of them, where a
    // generator takes the types of its elements from the fold of the module of its container, by which ulang/expand/expand.u
    // translates it, and an array is built from the list of its elements
    case EFor(form, gens, elem, rest) =>
      var a: Type, r: Type, typed_rest: Option[At[Expr]], typed_gens: List[Gen], typed_elem: Yield
      form_types(in form, expected, out a, r, ref s)
      form_rest(in env, form, rest, r, out typed_rest, ref s)
      generators(in env, form, gens, elem, a, if form == FArray then TList(a) else r, out typed_gens, typed_elem, ref s)
      fitted(in pos, expected, r, out typ, ref s)
      res := EFor(form, typed_gens, typed_elem, typed_rest)
  end

// the type a of the elements of a form and the type r of the form, the container of its name, whose elements are pairs of
// key and value for a map, of the type that is expected, if it is a container of that name
procedure form_types(
  in  form: Form,
      expected: Option[(Type, Str)],
  out a: Type,
      r: Type,
  ref s: State
) :=
  match form
    case FMap =>
      var k: Type, v: Type
      fresh(out k, ref s)
      fresh(out v, ref s)
      a := TTuple(List(k, v)), r := TSort(form_sort(form), List(k, v))

    case FList | FSet | FArray =>
      fresh(out a, ref s)
      r := TSort(form_sort(form), List(a))
  end
  match expected
    case Some((t, _)) =>
      match zonk_type(s.sub, t)
        case TSort(name, _) if name == form_sort(form) =>
          unify(in r, t, ref s)
        case _ =>
          skip
      end

    case None =>
      skip
  end

// the type of a form, its own or the one expected, against which it is checked
procedure fitted(
  in  pos: Pos,
      expected: Option[(Type, Str)],
      r: Type,
  out typ: Type,
  ref s: State
) :=
  match expected
    case Some((t, what)) =>
      expect(in pos, what, t, r, ref s)
      typ := t

    case None =>
      typ := r
  end

// the sort of the container of a form
function form_sort(form: Form): Name :=
  match form
    case FList =>
      Name(library_module("list"), "List")

    case FSet =>
      Name(library_module("set"), "Set")

    case FMap =>
      Name(library_module("map"), "Map")

    case FArray =>
      Name(library_module("array"), "Array")
  end

// the elements of a form, each of the type a, where a pair of key and value is a tuple
procedure yields(
  in  env: Env,
      form: Form,
      elems: List[Yield],
      a: Type,
  out typed_elems: List[Yield],
  ref s: State
) :=
  let what := "an element of " ++ form_name(form)
  typed_elems := List()
  for y in elems do
    match y
      case YVal(value) =>
        var typed_value: At[Expr]
        check(in env, value, a, what, out typed_value, ref s)
        typed_elems := typed_elems ++ List(YVal(typed_value))

      case YPair(key, value) =>
        var k: Type, v: Type, typed_key: At[Expr], typed_value: At[Expr]
        fresh(out k, ref s)
        fresh(out v, ref s)
        expect(in key.pos, what, a, TTuple(List(k, v)), ref s)
        check(in env, key, k, what, out typed_key, ref s)
        check(in env, value, v, what, out typed_value, ref s)
        typed_elems := typed_elems ++ List(YPair(typed_key, typed_value))
    end
  end

// the rest of a form, the container of the type r that it adds its elements to
procedure form_rest(
  in  env: Env,
      form: Form,
      rest: Option[At[Expr]],
      r: Type,
  out typed_rest: Option[At[Expr]],
  ref s: State
) :=
  match rest
    case Some(e) =>
      var typed_e: At[Expr]
      check(in env, e, r, "the rest of " ++ form_name(form), out typed_e, ref s)
      typed_rest := Some(typed_e)

    case None =>
      typed_rest := None
  end

// the generators gens of a form and its element elem, of the type a, in the scope of their patterns, where the folds of
// the generators build a container of the type acc, and a guard is a condition; a generator whose container has no fold
// stands for the form, and the generators after it stay as written, which its error blocks from a run
procedure generators(
  in  env: Env,
      form: Form,
      gens: List[Gen],
      elem: Yield,
      a: Type,
      acc: Type,
  out typed_gens: List[Gen],
      typed_elem: Yield,
  ref s: State
) :=
  match gens
    case List() =>
      var ys: List[Yield]
      yields(in env, form, List(elem), a, out ys, ref s)
      typed_gens := List()
      match ys
        case List(y; _) =>
          typed_elem := y
        case List() =>
          typed_elem := elem
      end

    case List(GIf(cond); more) =>
      var c: At[Expr], gs: List[Gen]
      check(in env, cond, TBool(), "the guard", out c, ref s)
      generators(in env, form, more, elem, a, acc, out gs, typed_elem, ref s)
      typed_gens := List(GIf(c); gs)

    case List(g; more) =>
      var c: At[Expr], u: Type, item: Option[Type]
      infer(in env, gen_container(g), out c, u, ref s)
      solve(ref s)
      fold_items(in u, if form == FList or form == FArray then "foldr" else "foldl", acc, out item, ref s)
      match item
        case Some(t) =>
          var typed_pat: At[Pat], xs: List[Var], gs: List[Gen]
          typed_pattern(in gen_pattern(g), t, out typed_pat, xs, ref s)
          unhidden(in env, xs, ref s)
          generators(in bind(xs) ++ env, form, more, elem, a, acc, out gs, typed_elem, ref s)
          solve(ref s)
          coverage(in t, List((typed_pat, true)), List(gen_pattern(g)), ref s)
          typed_gens := List(typed_gen(g, typed_pat, c, u); gs)

        case None =>
          typed_gens := List(with_over(g, c, TError); more), typed_elem := elem
      end
  end

// the pattern of a generator, a pair of key and value of k => v
function gen_pattern(g: Gen): At[Pat] :=
  match g
    case GPair(key, value, _, _) =>
      AOk(key.pos, span_over(key, value), PTuple(List(key, value)))

    case GVal(pat, _, _) =>
      pat

    case GIf(cond) =>
      AOk(cond.pos, cond.span, PWild)
  end

// g with its checked pattern pat over the checked container c of the type u
function typed_gen(g: Gen, pat: At[Pat], c: At[Expr], u: Type): Gen :=
  match (g, pat.that)
    case (GPair(_, _, _, _), PTuple(List(k, v))) =>
      GPair(k, v, c, u)
    case _ =>
      GVal(pat, c, u)
  end

// g over the container c of the type typ
function with_over(g: Gen, c: At[Expr], typ: Type): Gen :=
  match g
    case GVal(p, _, _) =>
      GVal(p, c, typ)

    case GPair(k, v, _, _) =>
      GPair(k, v, c, typ)

    case GIf(_) =>
      g
  end

// expr against expected, if known, else inferred
procedure infer_body(
  in  env: Env,
      expr: At[Expr],
      expected: Option[(Type, Str)],
  out typed_expr: At[Expr],
      typ: Type,
  ref s: State
) :=
  match expected
    case Some((t, what)) =>
      check(in env, expr, t, what, out typed_expr, ref s)
      typ := t

    case None =>
      infer(in env, expr, out typed_expr, typ, ref s)
  end

function yielded_exprs(y: Yield): List[At[Expr]] :=
  match y
    case YVal(value) =>
      List(value)
    case YPair(key, value) =>
      List(key, value)
  end

// the types of the n components of a tuple of the type expected, if known
function component_types(s: State, expected: Option[(Type, Str)], n: Int): Option[List[Type]] :=
  match expected
    case Some((t, _)) =>
      match zonk_type(s.sub, t)
        case TTuple(ts) if size(ts) == n =>
          Some(ts)
        case _ =>
          None
      end

    case None =>
      None
  end

// the error e of a program at the innermost part around it, s.at, which infer, statement, and binders set, after which the
// checker continues with a fallback
procedure report(in e: TypeError, ref s: State) :=
  s := s with clashes := s.clashes + 1
  if not reaches_error(s, e) then
    s := s with errors := s.errors ++ List(within(s, at_use(s.at, unparsed_use(s.unparsed, e))))
  end

// e as the parts around it read it, the innermost first
function within(s: State, e: TypeError): TypeError :=
  foldl(s.within, e, lambda x, w => as_within(w, x))

function as_within(w: Within, e: TypeError): TypeError :=
  match w
    case InCall(name) =>
      argument_hint(name, e)
  end

// the errors that the part at pos takes, those reported since there were before that no part inside it took, and none for
// a part at Pos(0, 0), of code that the parser did not read, whose errors the part around it or the command takes
procedure take_errors(
  in  pos: Pos,
      before: Int,
  out errors: List[Diagnostic],
  ref s: State
) :=
  if pos == Pos(0, 0) then
    errors := List()
  else
    let own := List(for (i, e) in zip(range(before, size(s.errors)), drop(before, s.errors)) if not contains(i, s.taken) yield (i, e))
    errors := List(for (_, e) in own yield with_module(type_diagnostic(e), s.module)), s := s with taken := s.taken ++ Set(for (i, _) in own yield i)
  end

// d of a part of the module m, which a run reaches without the command around it (require_checked of ulang/run/run.u)
function with_module(d: Diagnostic, m: Path): Diagnostic :=
  d with module := or_else(d.module, Some(m))

// x at pos with its errors, if it has some
function checked_at[A](pos: Pos, span: Span, x: A, errors: List[Diagnostic]): At[A] :=
  if errors == List() then AOk(pos, span, x) else AErr(pos, span, x, errors)

// whether e is of a type that a part that does not parse reaches, TError, which needs no error of its own
function reaches_error(s: State, e: TypeError): Bool :=
  exists(error_types(e), lambda t => has_error_type(zonk_type(s.sub, t)))

// the types that e names
function error_types(e: TypeError): List[Type] :=
  match e
    case Located(_, _, error) =>
      error_types(error)

    case Hinted(error, _) =>
      error_types(error)

    case CannotUnify(left, right) =>
      List(left, right)

    case Mismatch(expected_type, found_type, _) =>
      List(expected_type, found_type)

    case NoOverload(_, typ) =>
      List(typ)

    case UnknownFieldType(_, typ) =>
      List(typ)

    case UnknownContainer(typ) =>
      List(typ)

    case NoFold(typ, _) =>
      List(typ)

    case UnknownException(typ) =>
      List(typ)

    case NotAnException(typ) =>
      List(typ)

    case _ =>
      List()
  end

function has_error_type(t: Type): Bool :=
  match t
    case TError =>
      true

    case TSort(_, args) =>
      exists(args, has_error_type)

    case TFun(args, res) =>
      exists(List(res; args), has_error_type)

    case TTuple(args) =>
      exists(args, has_error_type)

    case TProc(ins, outs, refs, _) =>
      exists(ins ++ outs ++ refs, has_error_type)

    case THole | TMeta(_) | TParam(_) =>
      false
  end

// the first error that s reported
procedure reported(in s: State) :=
  match s.errors
    case List(e; _) =>
      raise e
    case List() =>
      skip
  end

// e at pos, unless it has a position already, where Located without a module is in the module of the command, which
// located adds
function at_use(pos: Pos, e: TypeError): TypeError :=
  match e
    case Located(_, _, _) =>
      e
    case _ =>
      if pos == Pos(0, 0) then e else Located(None, pos, e)
  end

// the raises of a procedure type as written, as the set of the exceptions, where unknowns and sets stay
procedure normalized_raises(in raised: Raises, out r: Raises, ref s: State) :=
  match raised
    case RWritten(types) =>
      var us: List[Type]
      normalizes(in types, out us, ref s)
      exceptions(in us, ref s)
      r := RSet(Set(for u in us for name in exception_name(u) yield name))

    case _ =>
      r := raised
  end

// raises NotAnException unless each of types is a datatype without type parameters
procedure exceptions(in types: List[Type], ref s: State) :=
  for t in types do
    match t
      case TSort(name, List()) if is_data(s.sig, name) =>
        skip
      case _ =>
        report(in NotAnException(t), ref s)
    end
  end

// the type of the items of a container of the type u, by the fold of its module, whose function takes the item before
// the accumulator for foldr and after it for foldl, of the type acc, and for a map the key and the value, its item a pair
// of them, as ulang/expand/expand.u applies it; None if the module declares no such fold or the type is not known, which
// is reported
procedure fold_items(
  in  u: Type,
      fold: Id,
      acc: Type,
  out item: Option[Type],
  ref s: State
) :=
  let w := zonk_type(s.sub, u)
  match w
    case TSort(Name(m, _), _) if m != List() =>
      match List(for sc in schemes_of(s.sig, Name(m, fold)) if is_fold(sc.typ, w) yield sc)
        case List(sc; _) =>
          var t: Type
          instantiate(in sc, out t, ref s)
          match t
            case TFun(List(c, base, TFun(args, step)), result) =>
              unify(in c, w, ref s)
              unify(in base, acc, ref s)
              unify(in step, acc, ref s)
              unify(in result, acc, ref s)
              match (if fold == "foldr" then
                take(size(args) - 1, args)
              else
                drop(1, args), m == library_module("map"))
                case (List(x), false) =>
                  item := Some(x)

                case (List(k, v), true) =>
                  item := Some(TTuple(List(k, v)))

                case _ =>
                  report(in NoFold(w, fold), ref s)
                  item := None
              end

            // is_fold selects the schemes of this shape
            case _ =>
              item := None
          end

        case List() =>
          report(in NoFold(w, fold), ref s)
          item := None
      end

    case _ =>
      report(in UnknownContainer(w), ref s)
      item := None
  end

// whether a scheme is a fold over the container w, which takes the type of w first, since a module may declare the folds of
// one of its types and not of the others, as the prelude declares those of Str and not of Int
function is_fold(t: Type, w: Type): Bool :=
  match (t, w)
    case (TFun(List(TSort(name, _), _, TFun(_, _)), _), TSort(name_, _)) =>
      name == name_
    case _ =>
      false
  end

function gen_container(g: Gen): At[Expr] :=
  match g
    case GVal(_, c, _) =>
      c

    case GPair(_, _, c, _) =>
      c

    case GIf(c) =>
      c
  end

// a pattern that is a variable, which a name of a constructor or pattern alias is not, as binders resolves it
function is_pvar(s: State, p: At[Pat]): Bool :=
  match p.that
    case PVar(x) =>
      x.name.path == List() and overloads(s, x.name, lambda n => is_pattern_name(s.sig, n)) == List()
    case _ =>
      false
  end

// the variables of patterns that are all variables
function variables_of(s: State, pats: List[At[Pat]]): Option[List[At[Var]]] :=
  if forall(pats, lambda p => is_pvar(s, p)) then
    map_option(pattern_vars(pats), lambda xs => List(for (p, x) in zip(pats, xs) yield AOk(p.pos, p.span, x)))
  else
    None

// overloaded names are resolved by their number of arguments and the types of the arguments and the result,
// where the arguments are inferred first, and a call that no candidate fits by its arity has the type TError, so that its
// uses make no follow-ups
procedure application(
  in  env: Env,
      fun: At[Expr],
      args: List[At[Expr]],
      expected: Option[(Type, Str)],
  out typed_expr: Expr,
      t: Type,
  ref s: State
) :=
  match fun
    case AOk(_, _, EName(name, typ)) =>
      let cs: List[(Name, Scheme)] := candidates(s, env, name)
      if size(cs) > 1 then
        var ts: List[Type], typed_args: List[At[Expr]], w: Type, x: Var
        infers_first(in env, args, out typed_args, ts, ref s)
        fresh(out t, ref s)
        normalize(in typ, out w, ref s)
        unify(in w, TFun(ts, t), ref s)
        if with_arity(cs, size(args)) == List() then
          report(in WrongArity(name, size(args)), ref s)
          unify(in t, TError, ref s)
          x := Var(name, TError)
        else
          use_name(in name, with_arity(cs, size(args)), w, out x, ref s)
        end
        infers_lambdas(in env, args, ts, ref typed_args, s)
        typed_expr := EApp(fun with that := EVar(x), typed_args)
      else
        match (get(name, env), hidden_functions(s, env, name, size(args)))
          // the variable is not read, so that no Unassigned follows, and the call has the type TError
          // of the functions, those that the arguments fit are named, else all
          case (Some(l), List(f; more)) =>
            var ts: List[Type], typed_args: List[At[Expr]], r: Type, ok: List[((Name, Scheme), State)]
            infers_first(in env, args, out typed_args, ts, ref s)
            infers_lambdas(in env, args, ts, ref typed_args, s)
            fresh(out r, ref s)
            trials(in List(f; more), TFun(ts, r), s, out ok)
            report(in Hinted(CannotUnify(zonk_type(s.sub, l.typ), TFun(ts, r)), hiding_hint(name, if ok == List() then
              firsts(List(f; more))
            else
              List(for ((m, _), _) in ok yield m))), ref s)
            fresh(out t, ref s)
            unify(in t, TError, ref s)
            typed_expr := EApp(fun with that := EVar(Var(name, l.typ)), typed_args)

          case _ =>
            let outer := s.within
            var typed_args: List[At[Expr]], typed_fun: At[Expr], u: Type
            s := s with within := List(InCall(name); outer)
            infer(in env, fun, out typed_fun, u, ref s)
            apply(in env, u, args, expected, out typed_args, t, ref s)
            typed_expr := EApp(typed_fun, typed_args), s := s with within := outer
        end
      end

    case AOk(_, _, ELam(_, _)) =>
      var typed_fun: At[Expr], typed_args: List[At[Expr]], ts: List[Type]
      infers(in env, args, out typed_args, ts, ref s)
      fresh(out t, ref s)
      infer_lambda(in env, fun, TFun(ts, t), out typed_fun, ref s)
      typed_expr := EApp(typed_fun, typed_args)

    // also a callee that does not parse, of the type TError
    case _ =>
      var typed_fun: At[Expr], u: Type, typed_args: List[At[Expr]]
      infer(in env, fun, out typed_fun, u, ref s)
      apply(in env, u, args, expected, out typed_args, t, ref s)
      typed_expr := EApp(typed_fun, typed_args)
  end

// the functions of n of k arguments that a variable n of env hides, if its type is no function of k arguments, so that a
// call of it likely means one of them, as lines(text) where an out lines: List[Str] hides lines of prelude/str
function hidden_functions(s: State, env: Env, n: Name, k: Int): List[(Name, Scheme)] :=
  match get(n, env)
    case Some(l) if not is_applicable(zonk_type(s.sub, l.typ), k) =>
      List(for (f, sc) in with_arity(candidates(s, List(), n), k) if is_fun(s.sig, f))
    case _ =>
      List()
  end

// whether a value of typ may be applied to k arguments, also where its type is not yet known
function is_applicable(typ: Type, k: Int): Bool :=
  match typ
    case TFun(ps, _) =>
      size(ps) == k

    case TMeta(_) | TError =>
      true

    case _ =>
      false
  end

// the hint of a call of a variable n that hides the functions funs of its name
function hiding_hint(n: Name, funs: List[Name]): Str :=
  example hiding_hint(unqualified("lines"), List(Name(List("prelude", "str"), "lines"))) == "the variable lines hides the function prelude.str.lines, so rename the variable to call it"
  "the variable " ++ n.base ++ " hides the function" ++ (if size(funs) > 1 then "s " else " ") ++ join(" and ", List(for f in funs yield format_name(f))) ++ ", so rename the variable to call " ++ (if size(funs) > 1 then "them" else "it")

// the accessor T.f, or for the suffix .f:= the updater T.f:=, applied to expr and the further arguments, of the type T of
// expr, of the module of T, where an unknown type of expr is an error, at pos of the access
procedure field_access(
  in  env: Env,
      pos: Pos,
      span: Span,
      suffix: Id,
      expr: At[Expr],
      rest: List[At[Expr]],
  out typed_expr: Expr,
      t: Type,
  ref s: State
) :=
  var c: At[Expr], u: Type, w: Type, typed_rest: List[At[Expr]], us: List[Type], x: Var
  infer(in env, expr, out c, u, ref s)
  infers(in env, rest, out typed_rest, us, ref s)
  fresh(out t, ref s)
  fresh(out w, ref s)
  unify(in w, TFun(List(u; us), t), ref s)
  solve(ref s)
  match zonk_type(s.sub, u)
    case TSort(Name(m, base), _) if m != List() =>
      let accessor: Name := Owned(m, List(base), slice(suffix, 1, size(suffix)))
      match schemes_of(s.sig, accessor)
        case List(sc) if is_visible(s, accessor) =>
          use(in accessor, w, sc, out x, ref s)

        case _ =>
          report(in continued_update(suffix, expr, UnknownField(accessor)), ref s)
          x := Var(accessor, w)
      end

    case TMeta(_) =>
      report(in UnknownFieldOwner(suffix), ref s)
      x := Var(unqualified(suffix), w)

    case v =>
      report(in UnknownFieldType(suffix, v), ref s)
      x := Var(unqualified(suffix), w)
  end
  typed_expr := EApp(AOk(pos, span, EVar(x)), List(c; typed_rest))

// e of an unknown field of the update by suffix .f:= of the update expr, with the hint that the comma before f continued the
// update, where the source likely meant an assignment of a variable f
function continued_update(suffix: Id, expr: At[Expr], e: TypeError): TypeError :=
  match expr
    case AOk(_, _, EUpdate(_, _, _)) if ends_with(suffix, ":=") =>
      Hinted(e, "a comma after with continues the update, so an assignment of " ++ slice(suffix, 1, size(suffix) - 2) ++ " takes a statement of its own")
    case _ =>
      e
  end

procedure apply(
  in  env: Env,
      f: Type,
      args: List[At[Expr]],
      expected: Option[(Type, Str)],
  out typed_args: List[At[Expr]],
      r: Type,
  ref s: State
) :=
  var fitting := false
  fresh(out r, ref s)
  match (zonk_type(s.sub, f), expected)
    case (TFun(ps, res), Some((t, _))) if size(ps) == size(args) =>
      fits(in res, t, s, out fitting)
    case _ =>
      skip
  end
  match (zonk_type(s.sub, f), expected)
    // of an unknown function, whose arguments are still checked
    case (TError, _) =>
      var ts: List[Type]
      infers_first(in env, args, out typed_args, ts, ref s)
      infers_lambdas(in env, args, ts, ref typed_args, s)
      unify(in r, TError, ref s)

    case (TFun(ps, res), Some((t, _))) if fitting =>
      unify(in res, t, ref s)
      unify(in res, r, ref s)
      checks_args(in env, args, ps, out typed_args, ref s)

    case (TFun(ps, res), _) if size(ps) == size(args) =>
      var ts: List[Type]
      infers_first(in env, args, out typed_args, ts, ref s)
      for ((a, p), (t, i)) in zip(zip(args, ps), numbered(ts)) do
        expect(in a.pos, "argument " ++ show(i + 1) ++ " of the call", p, t, ref s)
      end
      unify(in res, r, ref s)
      infers_lambdas(in env, args, ts, ref typed_args, s)

    // of a value that no function type fits, whose result is TError, so that its uses make no follow-ups
    case _ =>
      var ts: List[Type]
      var applicable: Bool
      infers_first(in env, args, out typed_args, ts, ref s)
      fits(in f, TFun(ts, r), s, out applicable)
      unify(in f, TFun(ts, r), ref s)
      infers_lambdas(in env, args, ts, ref typed_args, s)
      if not applicable then
        unify(in r, TError, ref s)
      end
  end

// whether u unifies with t, tried on a copy of s
procedure fits(in u: Type, t: Type, s: State, out ok: Bool) :=
  var trial := s
  unify(in u, t, ref trial)
  ok := trial.clashes == s.clashes

// the arguments checked against the types of the formals ps, the lambdas last, since they take the types of their formals
// from the other arguments
procedure checks_args(
  in  env: Env,
      args: List[At[Expr]],
      ps: List[Type],
  out typed_args: List[At[Expr]],
  ref s: State
) :=
  var typed: Map[Int, At[Expr]] := Map(), x: At[Expr]
  for ((a, p), i) in zip(zip(args, ps), range(0, size(args))) if not is_lambda(a) do
    check(in env, a, p, "argument " ++ show(i + 1) ++ " of the call", out x, ref s)
    typed := put(i, x, typed)
  end
  for ((a, p), i) in zip(zip(args, ps), range(0, size(args))) if is_lambda(a) do
    check(in env, a, p, "argument " ++ show(i + 1) ++ " of the call", out x, ref s)
    typed := put(i, x, typed)
  end
  typed_args := List(for (a, i) in zip(args, range(0, size(args))) yield value_or(get(i, typed), a))

// the arguments in order, except the lambdas, which get an unknown type and wait until the type of the function is
// known, so that the formals of a lambda have the types that the function expects, see infers_lambdas
procedure infers_first(
  in  env: Env,
      exprs: List[At[Expr]],
  out typed_exprs: List[At[Expr]],
      ts: List[Type],
  ref s: State
) :=
  var typed_expr: At[Expr], t: Type
  typed_exprs := List(), ts := List()
  for expr in exprs do
    if is_lambda(expr) then
      fresh(out t, ref s)
      typed_expr := expr
    else
      infer(in env, expr, out typed_expr, t, ref s)
    end
    typed_exprs := typed_exprs ++ List(typed_expr), ts := ts ++ List(t)
  end

// a lambda x, p => e of the formal types ts, with a pattern p that is no variable, whose variables e sees as those of a
// case, checked for exhaustiveness as the pattern of a let, where the checked lambda keeps p, annotated by its type,
// which the expansion of ulang/expand/expand.u matches against a formal of that type
procedure lambda_patterns(
  in  env: Env,
      pats: List[At[Pat]],
      ts: List[Type],
      body: At[Expr],
  out res: Expr,
      typ: Type,
  ref s: State
) :=
  var xs: List[Var], ys: List[Var] := List(), typed_pats: List[At[Pat]] := List(), b: At[Expr], u: Type
  formals(in "formal", List(for (p, t) in zip(pats, ts) if is_pvar(s, p) for x in formal_var(p, t) yield x), out xs, ref s)
  unhidden(in env, xs, ref s)
  for (p, t) in zip(pats, ts) if not is_pvar(s, p) do
    var typed_pat: At[Pat], zs: List[Var]
    binders(in p, t, out typed_pat, zs, ref s)
    typed_pats := typed_pats ++ List(AOk(p.pos, p.span, PAnnotated(typed_pat, t))), ys := ys ++ zs
  end
  unique(in "pattern variable", List(for y in ys yield y.name), ref s)
  unhidden(in bind(xs) ++ env, ys, ref s)
  infer(in bind(ys) ++ bind(xs) ++ env, body, out b, u, ref s)
  solve(ref s)
  for (p, typed_pat) in zip(List(for p in pats if not is_pvar(s, p)), typed_pats) do
    match typed_pat.that
      case PAnnotated(inner, t) =>
        coverage(in t, List((inner, true)), List(p), ref s)
      case _ =>
        skip
    end
  end
  let checked := lambda_formals(s, pats, xs, typed_pats)
  res := ELam(checked, b), typ := TFun(List(for p in checked yield formal_type(p.that)), u)

// the checked formals of pats, where xs are those that are variables and typed_pats the others, in their order
function lambda_formals(s: State, pats: List[At[Pat]], xs: List[Var], typed_pats: List[At[Pat]]): List[At[Pat]] :=
  match (pats, xs, typed_pats)
    case (List(p; more), List(x; xs_), _) if is_pvar(s, p) =>
      List(
        AOk(p.pos, p.span, PVar(x)); lambda_formals(s, more, xs_, typed_pats))

    case (List(_; more), _, List(q; qs)) =>
      List(q; lambda_formals(s, more, xs, qs))

    case _ =>
      List()
  end

// the formal of a lambda that is the variable p, of the type t
function formal_var(p: At[Pat], t: Type): List[At[Var]] :=
  match p.that
    case PVar(x) =>
      List(AOk(p.pos, p.span, Var(x.name, t)))
    case _ =>
      List()
  end

// the type of a checked formal of a lambda, a variable or an annotated pattern
function formal_type(pat: Pat): Type :=
  match pat
    case PVar(x) =>
      x.typ

    case PAnnotated(_, t) =>
      t

    case _ =>
      THole
  end

// the formals of a lambda of variables, typed by the types ps of the function that it is an argument for, where untyped
function typed_formals(expr: Expr, ps: List[Type]): Expr :=
  match expr
    case ELam(formals, body) =>
      ELam(List(for (pat, t) in zip(formals, ps) yield typed_formal(pat, t)), body)
    case _ =>
      expr
  end

function typed_formal(pat: At[Pat], t: Type): At[Pat] :=
  match pat.that
    case PVar(x) if x.typ == THole =>
      pat with that := PVar(Var(x.name, t))
    case _ =>
      pat
  end

function is_lambda(e: At[Expr]): Bool :=
  match e
    case AOk(_, _, ELam(_, _)) =>
      true
    case _ =>
      false
  end

// the lambdas among exprs, whose types are those in types, inferred with the formals that have no type typed by the
// parameters of the function type there, if it is known, where res are the other exprs as infers_first typed them
procedure infers_lambdas(
  in  env: Env,
      exprs: List[At[Expr]],
      types: List[Type],
  ref res: List[At[Expr]],
      s: State
) :=
  var found: List[At[Expr]] := List()
  for ((expr, typed_expr), t) in zip(zip(exprs, res), types) do
    if is_lambda(expr) then
      var typed_lambda: At[Expr]
      infer_lambda(in env, expr, t, out typed_lambda, ref s)
      found := found ++ List(typed_lambda)
    else
      found := found ++ List(typed_expr)
    end
  end
  res := found

procedure infer_lambda(
  in  env: Env,
      expr: At[Expr],
      t: Type,
  out typed_expr: At[Expr],
  ref s: State
) :=
  var u: Type
  match (expr.that, zonk_type(s.sub, t))
    case (ELam(formals, _), TFun(ps, _)) if size(ps) == size(formals) and variables_of(s, formals) != None =>
      infer(in env, expr with that := typed_formals(expr.that, ps), out typed_expr, u, ref s)

    case (ELam(formals, body), TFun(ps, _)) if size(ps) == size(formals) =>
      let outer := s.at, before := size(s.errors)
      var x: Expr, errors: List[Diagnostic]
      s := s with at := expr.pos
      lambda_patterns(in env, formals, ps, body, out x, u, ref s)
      take_errors(in expr.pos, before, out errors, ref s)
      typed_expr := checked_at(expr.pos, expr.span, x, errors), s := s with at := outer

    case _ =>
      infer(in env, expr, out typed_expr, u, ref s)
  end
  unify(in u, t, ref s)

// expr of the type t, where what names it in a mismatch
procedure check(
  in  env: Env,
      expr: At[Expr],
      t: Type,
      what: Str,
  out typed_expr: At[Expr],
  ref s: State
) :=
  if is_lambda(expr) then
    infer_lambda(in env, expr, t, out typed_expr, ref s)
  else
    var u: Type
    infer_expected(in env, expr, Some((t, what)), out typed_expr, u, ref s)
    expect(in expr.pos, what, t, u, ref s)
  end

// the type u of the part at pos, which what names, is t, else the mismatch of the whole types at the part, instead of
// the parts of the types that do not unify
procedure expect(in pos: Pos, what: Str, t: Type, u: Type, ref s: State) :=
  let before := s.errors, outer := s.at
  s := s with at := pos
  unify_toward(in Into, u, t, ref s)
  if exists(drop(size(before), s.errors), is_unify_error) then
    s := s with errors := before ++ List(
      within(s, at_use(pos, Mismatch(zonk_type(s.sub, t), zonk_type(s.sub, u), what))))
  end
  s := s with at := outer

// e with the hint of a mismatch of an argument of name, ++ for + of strings
function argument_hint(name: Name, e: TypeError): TypeError :=
  match e
    case Located(m, pos, Mismatch(TInt(), TStr(), what)) if name.base == "+" =>
      Located(m, pos, Hinted(Mismatch(TInt(), TStr(), what), "strings join by ++, and + adds integers"))
    case _ =>
      e
  end

function is_unify_error(e: TypeError): Bool :=
  match e
    case Located(_, _, CannotUnify(_, _)) =>
      true

    case CannotUnify(_, _) =>
      true

    case _ =>
      false
  end

// the expressions of what, checked against the types ts, as many
procedure checks(
  in  env: Env,
      what: Str,
      exprs: List[At[Expr]],
      ts: List[Type],
  out typed_exprs: List[At[Expr]],
  ref s: State
) :=
  match (exprs, ts)
    case (List(expr; more), List(t; ts_)) =>
      var typed_expr: At[Expr], rest: List[At[Expr]]
      check(in env, expr, t, what, out typed_expr, ref s)
      checks(in env, what, more, ts_, out rest, ref s)
      typed_exprs := List(typed_expr; rest)

    case (List(), List()) =>
      typed_exprs := List()

    // the expressions as they are, of no types
    case _ =>
      report(in CountMismatch(what, "values", size(ts), size(exprs)), ref s)
      typed_exprs := exprs
  end

procedure infers(
  in  env: Env,
      exprs: List[At[Expr]],
  out typed_exprs: List[At[Expr]],
      ts: List[Type],
  ref s: State
) :=
  var typed_expr: At[Expr], t: Type
  typed_exprs := List(), ts := List()
  for expr in exprs do
    infer(in env, expr, out typed_expr, t, ref s)
    typed_exprs := typed_exprs ++ List(typed_expr), ts := ts ++ List(t)
  end

procedure expr_branches(
  in  env: Env,
      cases: List[At[Branch[At[Expr]]]],
      t: Type,
      r: Type,
  out typed_cases: List[At[Branch[At[Expr]]]],
  ref s: State
) :=
  match cases
    case List() =>
      typed_cases := List()

    case List(AOk(pos, span, Branch(pat, g, body)); more) =>
      var typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: At[Expr], rest: List[At[Branch[At[Expr]]]]
      typed_pattern(in pat, t, out typed_pat, xs, ref s)
      unhidden(in env, xs, ref s)
      guard(in bind(xs) ++ env, g, out typed_guard, ref s)
      check(in bind(xs) ++ env, body, r, "the case", out typed_body, ref s)
      expr_branches(in env, more, t, r, out rest, ref s)
      typed_cases := List(AOk(pos, span, Branch(typed_pat, typed_guard, typed_body)); rest)

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

procedure guard(
  in  env: Env,
      g: Option[At[Expr]],
  out typed_guard: Option[At[Expr]],
  ref s: State
) :=
  match g
    case Some(expr) =>
      var typed_expr: At[Expr]
      check(in env, expr, TBool(), "the guard", out typed_expr, ref s)
      typed_guard := Some(typed_expr)

    case None =>
      typed_guard := None
  end

// guarded cases neither cover values for exhaustiveness nor make later cases unreachable, and the patterns as written,
// one per case, name an unreachable case as its source does, with its pattern aliases
procedure coverage(
  in  t: Type,
      cs: List[(At[Pat], Bool)],
      written: List[At[Pat]],
  ref s: State
) :=
  if zonk_type(s.sub, t) != TError then
    coverage_known(in t, cs, written, ref s)
  end

// coverage of a type that no error reaches, which says which values there are, where a missing value is named by the
// pattern aliases that the module sees
procedure coverage_known(
  in  t: Type,
      cs: List[(At[Pat], Bool)],
      written: List[At[Pat]],
  ref s: State
) :=
  let expanded := List(for (p, open) in cs yield (alias_free(s.sig, p), open))
  reachable(in t, List(), List(for ((p, open), w) in zip(expanded, written) yield (p, w, open)), ref s)
  match missing(s.sig, s.sub, List(for p in unguarded(expanded) yield List(p)), List(t))
    case Some(List(w; _)) =>
      report(in NotExhaustive(with_aliases(visible_aliases(s), w)), ref s)
    case _ =>
      skip
  end

function visible_aliases(s: State): List[(Name, PatAlias)] :=
  List(for k => alias in s.sig.pat_aliases if is_visible(s, k) and pattern_size(alias.pat.that) > 0 yield (k, alias))

// the witness with each part that an alias matches written as that alias, the outermost first, preferring the alias whose
// pattern has the most constructors and literals
function with_aliases(aliases: List[(Name, PatAlias)], pat: Pat): Pat :=
  match best_alias(aliases, pat, None)
    case Some((k, alias, bound, _)) =>
      PApp(k, List(for x in alias.formals yield nowhere(with_aliases(aliases, value_or(get(x.name, bound), PWild)))))
    case None =>
      with_aliases_inside(aliases, pat)
  end

function with_aliases_inside(aliases: List[(Name, PatAlias)], pat: Pat): Pat :=
  match pat
    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield map_at(a, lambda p => with_aliases(aliases, p))))

    case PTuple(args) =>
      PTuple(List(for a in args yield map_at(a, lambda p => with_aliases(aliases, p))))

    case POr(alts) =>
      POr(List(for a in alts yield map_at(a, lambda p => with_aliases(aliases, p))))

    case PAnnotated(inner, typ) =>
      PAnnotated(map_at(inner, lambda p => with_aliases(aliases, p)), typ)

    case PWild | PLit(_) | PVar(_) =>
      pat
  end

function best_alias(aliases: List[(Name, PatAlias)], pat: Pat, best: Option[(Name, PatAlias, List[(Name, Pat)], Int)]): Option[(Name, PatAlias, List[(Name, Pat)], Int)] :=
  match aliases
    case List() =>
      best

    case List((k, alias); rest) =>
      match alias_match(alias.pat.that, pat)
        case Some(bound) if pattern_size(alias.pat.that) > value_or(map_option(best, lambda (_, _, _, n) => n), 0) =>
          best_alias(rest, pat, Some((k, alias, bound, pattern_size(alias.pat.that))))
        case _ =>
          best_alias(rest, pat, best)
      end
  end

// the parts of pat that the variables of the pattern p of an alias bind, if p matches every value that pat matches
function alias_match(p: Pat, pat: Pat): Option[List[(Name, Pat)]] :=
  match (p, pat)
    case (PVar(x), _) =>
      Some(List((x.name, pat)))

    case (PWild, _) =>
      Some(List())

    case (PAnnotated(inner, _), _) =>
      alias_match(inner.that, pat)

    case (_, PAnnotated(inner, _)) =>
      alias_match(p, inner.that)

    case (POr(alts), _) =>
      find_map(alts, lambda a => alias_match(a.that, pat))

    case (PLit(a), PLit(b)) =>
      if a == b then Some(List()) else None

    case (PApp(k, ps), PApp(k_, qs)) =>
      if k == k_ then alias_matches(ps, qs) else None

    case (PTuple(ps), PTuple(qs)) =>
      alias_matches(ps, qs)

    case _ =>
      None
  end

function alias_matches(ps: List[At[Pat]], qs: List[At[Pat]]): Option[List[(Name, Pat)]] :=
  match (ps, qs)
    case (List(), List()) =>
      Some(List())

    case (List(p; ps_), List(q; qs_)) =>
      match (alias_match(p.that, q.that), alias_matches(ps_, qs_))
        case (Some(bound), Some(more)) =>
          Some(bound ++ more)
        case _ =>
          None
      end

    case _ =>
      None
  end

// the number of constructors and literals of a pattern, by which the alias that says most is chosen
function pattern_size(pat: Pat): Int :=
  match pat
    case PApp(_, args) =>
      1 + foldl(args, 0, lambda n, a => n + pattern_size(a.that))

    case PTuple(args) =>
      foldl(args, 0, lambda n, a => n + pattern_size(a.that))

    case POr(alts) =>
      foldl(alts, 0, lambda n, a => max(n, pattern_size(a.that)))

    case PAnnotated(inner, _) =>
      pattern_size(inner.that)

    case PLit(_) =>
      1

    case PWild | PVar(_) =>
      0
  end

function unguarded(cs: List[(At[Pat], Bool)]): List[Pat] :=
  List(for (p, g) in cs if g yield p.that)

// the typed pattern of each case with the pattern as written, which names it in the error, where an alias whose
// pattern has alternatives names each of them
procedure reachable(
  in  t: Type,
      before: List[Pat],
      cs: List[(At[Pat], At[Pat], Bool)],
  ref s: State
) :=
  match cs
    case List() =>
      skip

    // each alternative against the cases before and the alternatives before it
    case List((AOk(_, _, POr(alts)), written, open); rest) =>
      let sources := written_alternatives(written, size(alts))
      reachable(in t, before, List(for (a, w) in zip(alts, sources) yield (a, w, open)) ++ rest, ref s)

    case List((p, written, open); rest) =>
      if not is_useful(s.sig, s.sub, List(for q in before yield List(q)), List(p.that), List(t)) then
        report(in at_use(p.pos, Unreachable(written.that)), ref s)
      end
      if open then
        reachable(in t, before ++ List(p.that), rest, ref s)
      else
        reachable(in t, before, rest, ref s)
      end
  end

// the alternatives of a pattern as written, which match those of its typed pattern unless an alias expanded to them, which
// then names each
function written_alternatives(written: At[Pat], n: Int): List[At[Pat]] :=
  match written.that
    case POr(alts) if size(alts) == n =>
      alts

    case PAnnotated(inner, _) =>
      written_alternatives(inner, n)

    case _ =>
      replicate(n, written)
  end

procedure typed_pattern(
  in  pat: At[Pat],
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  binders(in pat, t, out typed_pat, xs, ref s)
  unique(in "pattern variable", List(for x in xs yield x.name), ref s)

// a pattern at its position, where an error inside is reported at the innermost position, and a pattern alias is expanded
// at the position of its use
procedure binders(
  in  pat: At[Pat],
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  match pat
    case AOk(pos, span, node) =>
      let outer := s.at
      s := s with at := pos
      pattern_binders(in pos, span, node, t, out typed_pat, xs, ref s)
      s := s with at := outer

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

procedure pattern_binders(
  in  pos: Pos,
      span: Span,
      pat: Pat,
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  match pat
    case PWild =>
      typed_pat := AOk(pos, span, pat), xs := List()

    case PLit(lit) =>
      unify(in literal(lit), t, ref s)
      typed_pat := AOk(pos, span, PLit(checked_lit(lit))), xs := List()

    // a qualified name is a constructor or an alias, never a variable
    case PName(name, typ) =>
      if name.path != List() or overloads(s, name, lambda n => is_pattern_name(s.sig, n)) != List() then
        pattern_binders(in pos, span, PApp(name, List()), t, out typed_pat, xs, ref s)
      else
        var u: Type
        normalize(in typ, out u, ref s)
        unify(in u, t, ref s)
        typed_pat := AOk(pos, span, PName(name, u)), xs := List(Var(name, u))
        if contains(name.base, qualifiers(s)) then
          report(in at_use(pos, QualifierLocal(name)), ref s)
        end
      end

    // a pattern of an unknown constructor is _, which binds nothing
    case PApp(constr, args) =>
      var k: Option[Name], head: Option[PatHead]
      match overloads(s, constr, lambda n => is_pattern_name(s.sig, n))
        case List(k_) =>
          k := Some(k_)

        case List() =>
          report(in UnknownConstructor(constr), ref s)
          k := None

        case ks =>
          pattern_constructor(in constr, ks, size(args), t, out k, ref s)
      end
      head := match k
        case Some(c) =>
          pat_head(s.sig, c)
        case None =>
          None
      end
      match (k, head)
        case (Some(c), Some(h)) =>
          constructor_binders(in pos, span, c, h, args, t, out typed_pat, xs, ref s)

        case (Some(_), None) =>
          report(in UnknownConstructor(constr), ref s)
          typed_pat := AOk(pos, span, PWild), xs := List()

        // a constructor that does not parse binds the variables of its arguments, of unknown types
        case (None, _) if contains(constr.base, s.unparsed) =>
          var ts: List[Type]
          fresh_list(in args, out ts, ref s)
          binder_list(in args, ts, out _, xs, ref s)
          typed_pat := AOk(pos, span, PWild)

        // reported where k was resolved
        case (None, _) =>
          typed_pat := AOk(pos, span, PWild), xs := List()
      end

    case PTuple(args) =>
      var qs: List[At[Pat]], ts: List[Type]
      fresh_list(in args, out ts, ref s)
      unify(in TTuple(ts), t, ref s)
      binder_list(in args, ts, out qs, xs, ref s)
      typed_pat := AOk(pos, span, PTuple(qs))

    // the annotation is unified before the pattern is checked, so that it resolves what the pattern holds, and the
    // checked pattern does not keep it
    case PAnnotated(inner, typ) =>
      var u: Type
      normalize(in typ, out u, ref s)
      unify(in u, t, ref s)
      binders(in inner, u, out typed_pat, xs, ref s)

    // each alternative matches t and binds the variables of the first, with their types, which the case sees
    case POr(alts) =>
      var typed_alts: List[At[Pat]] := List(), first: Option[List[Var]] := None
      for alt in alts do
        var typed_alt: At[Pat], ys: List[Var]
        binders(in alt, t, out typed_alt, ys, ref s)
        typed_alts := typed_alts ++ List(typed_alt)
        match first
          case None =>
            first := Some(ys)
          case Some(zs) =>
            same_variables(in alt.pos, zs, ys, ref s)
        end
      end
      typed_pat := AOk(pos, span, POr(typed_alts)), xs := value_or(first, List())
  end

// the pattern of a handler of type typ, where the alternatives at the top may match exceptions of different types: each
// is annotated by its type, which expanded_handlers of ulang/syntax/syntax.u makes the type of its handler, and the
// handler has the type THole, so that its readers take its alternatives apart first
procedure handler_pattern(
  in  pat: At[Pat],
      typ: Type,
  out u: Type,
      typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  match pat
    case AOk(pos, span, POr(alts)) if typ == THole =>
      var typed_alts: List[At[Pat]] := List(), first: Option[List[Var]] := None
      for alt in alts do
        var t: Type, typed_alt: At[Pat], ys: List[Var]
        normalize(in THole, out t, ref s)
        binders(in alt, t, out typed_alt, ys, ref s)
        typed_alts := typed_alts ++ List(AOk(alt.pos, alt.span, PAnnotated(typed_alt, t)))
        match first
          case None =>
            first := Some(ys)
          case Some(zs) =>
            same_variables(in alt.pos, zs, ys, ref s)
        end
      end
      u := THole, typed_pat := AOk(pos, span, POr(typed_alts)), xs := value_or(first, List())
      unique(in "pattern variable", List(for x in xs yield x.name), ref s)

    case _ =>
      normalize(in typ, out u, ref s)
      typed_pattern(in pat, u, out typed_pat, xs, ref s)
  end

// the variables ys of an alternative at pos against those of the first, xs, with the same types
procedure same_variables(
  in  pos: Pos,
      xs: List[Var],
      ys: List[Var],
  ref s: State
) :=
  let outer := s.at
  s := s with at := pos
  for x in xs do
    match find(ys, lambda y => y.name == x.name)
      case Some(y) =>
        unify(in y.typ, x.typ, ref s)
      case None =>
        report(in OrVariables(x.name, false), ref s)
    end
  end
  for y in ys if not exists(xs, lambda x => x.name == y.name) do
    report(in OrVariables(y.name, true), ref s)
  end
  s := s with at := outer

// the constructor or pattern alias k with its head applied to the patterns args, matching t
procedure constructor_binders(
  in  pos: Pos,
      span: Span,
      k: Name,
      head: PatHead,
      args: List[At[Pat]],
      t: Type,
  out typed_pat: At[Pat],
      xs: List[Var],
  ref s: State
) :=
  var m: List[(Type, Type)], qs: List[At[Pat]]
  same_length(in head.what ++ " " ++ k.base, "arguments", size(head.args), size(args), ref s)
  instance(in head.params, out m, ref s)
  unify(in subst(head.typ, m), t, ref s)
  binder_list(in args, List(for a in head.args yield subst(a, m)), out qs, xs, ref s)
  typed_pat := AOk(pos, span, PApp(k, qs))
  match pat_alias_of(s.sig, k)
    case Some(alias) =>
      pattern_aliased(in k, alias, ref s)
    case None =>
      skip
  end

// the one of the constructors ks with k arguments whose datatype fits t, where open uses are solved first if
// several fit, since the variables of the pattern need their types, and None after the error if none or several fit
procedure pattern_constructor(
  in  n: Name,
      ks: List[Name],
      k: Int,
      t: Type,
  out c: Option[Name],
  ref s: State
) :=
  var ok: List[((Name, Scheme), State)]
  trials(in results(s.sig, ks, k), t, s, out ok)
  if size(ok) > 1 then
    solve(ref s)
    trials(in results(s.sig, ks, k), t, s, out ok)
  end
  match ok
    case List(((c_, _), _)) =>
      c := Some(c_)

    case List() =>
      report(in NoOverload(n, zonk_type(s.sub, t)), ref s)
      c := None

    case _ =>
      report(in Ambiguous(n, firsts(ok)), ref s)
      c := None
  end

// the constructors and pattern aliases of ks with k arguments, each with the scheme of the type that it matches
function results(sig: Sig, ks: List[Name], k: Int): List[(Name, Scheme)] :=
  match ks
    case List() =>
      List()

    case List(n; rest) =>
      match pat_head(sig, n)
        case Some(head) if size(head.args) == k =>
          List((n, Scheme(head.params, head.typ)); results(sig, rest, k))
        case _ =>
          results(sig, rest, k)
      end
  end

// the head of a pattern, a constructor or a pattern alias, named by what it is, with the params of its declaration, the
// types of its arguments, and the type that it matches
data PatHead :=
  case PatHead(what: Str, params: List[Type], args: List[Type], typ: Type)

function pat_head(sig: Sig, n: Name): Option[PatHead] :=
  match (constr_of(sig, n), pat_alias_of(sig, n))
    case (Some(decl), _) =>
      Some(PatHead("constructor", decl.params, decl.fields, decl.typ))

    case (None, Some(alias)) =>
      Some(PatHead("pattern alias", alias.params, List(for x in alias.formals yield x.typ), alias.typ))

    case (None, None) =>
      None
  end

procedure binder_list(
  in  pats: List[At[Pat]],
      ts: List[Type],
  out qs: List[At[Pat]],
      xs: List[Var],
  ref s: State
) :=
  match (pats, ts)
    case (List(p; more), List(t; ts_)) =>
      var q: At[Pat], ys: List[Var], rest: List[At[Pat]], zs: List[Var]
      binders(in p, t, out q, ys, ref s)
      binder_list(in more, ts_, out rest, zs, ref s)
      qs := List(q; rest), xs := ys ++ zs

    case (List(), List()) =>
      qs := List(), xs := List()

    // the components as _ of the expected types, which bind nothing
    case _ =>
      report(in CountMismatch("the pattern", "components", size(ts), size(pats)), ref s)
      qs := List(for _ in ts yield nowhere(PWild)), xs := List()
  end

procedure variable(
  in  env: Env,
      assignable: List[Name],
      x: Var,
  out y: Var,
  ref s: State
) :=
  match x
    case Var(name, typ) =>
      match get(name, env)
        case Some(l) =>
          var u: Type
          if not contains(name, assignable) then
            report(in NotAssignable(name), ref s)
          end
          normalize(in typ, out u, ref s)
          unify(in l.typ, u, ref s)
          y := Var(name, l.typ)

        case None =>
          report(in unknown_variable(s, name), ref s)
          y := Var(name, TError)
      end
  end

// the outs of a call, where an out _, which the checked call keeps, gets the type of its out, which nothing reads
procedure out_variables(
  in  env: Env,
      assignable: List[Name],
      xs: List[Var],
  out ys: List[Var],
  ref s: State
) :=
  map_state(in xs, lambda in x: Var, out y: Var, ref r: State =>
    if is_dropped(x) then
      var u: Type
      fresh(out u, ref r)
      y := Var(x.name, u)
    else
      variable(in env, assignable, x, out y, ref r)
    end
  end, out ys, ref s)

procedure variables(
  in  env: Env,
      assignable: List[Name],
      xs: List[Var],
  out ys: List[Var],
  ref s: State
) :=
  map_state(in xs, lambda in x: Var, out y: Var, ref r: State =>
    variable(in env, assignable, x, out y, ref r)
  end, out ys, ref s)

// env tells which variables are assigned on every path to x, and after it
procedure statement(
  in  assignable: List[Name],
      stmt: At[Stmt],
  out y: At[Stmt],
  ref env: Env,
      s: State
) :=
  match stmt
    case AOk(pos, span, node) =>
      let outer := s.at, before := size(s.errors)
      var x: Stmt, errors: List[Diagnostic]
      s := s with at := pos
      statement_node(in assignable, pos, span, node, out x, ref env, s)
      take_errors(in pos, before, out errors, ref s)
      y := checked_at(pos, span, x, errors), s := s with at := outer

    // reported by the parser, which may assign every variable, so that no reads after it are errors
    case AUnparsed(_, _, _, _) =>
      y := stmt, env := assigned(env, firsts(env))

    // the checker makes error nodes of the parts that the parser read, which it checks once
    case AErr(_, _, _, _) =>
      raise Unexpected("error node")
  end

procedure statement_node(
  in  assignable: List[Name],
      pos: Pos,
      span: Span,
      stmt: Stmt,
  out y: Stmt,
  ref env: Env,
      s: State
) :=
  match stmt
    case SSkip =>
      y := stmt

    // one after another, so that each value reads the variables that those before it assign
    case SAssign(upd) =>
      var typed: Buffer[(Var, At[Expr])] := empty()
      unique(in "assignment to", List(for x in firsts(upd) yield x.name), ref s)
      for (x, expr) in upd do
        var typed_var: Var, typed_expr: At[Expr]
        variable(in env, assignable, x, out typed_var, ref s)
        check(in env, expr, typed_var.typ, "the assignment", out typed_expr, ref s)
        typed := typed ++ List((typed_var, typed_expr))
        env := assigned(env, List(typed_var.name))
      end
      y := SAssign(List(for a in typed))

    // the locals of the parser are SLocal statements, each declaring its variables for the statements after it in the
    // block, which the checked program keeps as written
    case SBlock(locals, stmts) =>
      local_block(in assignable, locals, stmts, out y, ref env, s)

    // the declarations one after another, each in the scope of those before it, which declare their variables in env for
    // the statements after it in its block, which local_block checks, where a let binds what nothing assigns after, and a
    // pattern that is no variable is irrefutable, checked for exhaustiveness as the cases of a match
    case SLocal(mutable, decls) =>
      var typed_decls: List[(At[Pat], Option[At[Expr]])] := List(), covered: List[(At[Pat], Type, At[Pat])] := List()
      for (pat, init) in decls do
        match (declared_var(s, pat), init)
          case (Some(x), Some(value)) =>
            var xs: List[Var], typed_values: List[At[Expr]]
            formals(in "local", List(x), out xs, ref s)
            unhidden_at(in x.pos, env, xs, ref s)
            checks(in env, "the assignment", List(value), List(for z in xs yield z.typ), out typed_values, ref s)
            typed_decls := typed_decls ++ List(for (z, e) in zip(xs, typed_values) yield (AOk(x.pos, x.span, PVar(z)), Some(e))), env := bind(xs) ++ env

          case (Some(x), None) =>
            var xs: List[Var]
            formals(in "local", List(x), out xs, ref s)
            unhidden_at(in x.pos, env, xs, ref s)
            typed_decls := typed_decls ++ List(for z in xs yield (AOk(x.pos, x.span, PVar(z)), None)), env := unassigned(xs) ++ env

          case (None, Some(value)) =>
            var t: Type, typed_value: At[Expr], typed_pat: At[Pat], xs: List[Var]
            infer(in env, value, out typed_value, t, ref s)
            typed_pattern(in pat, t, out typed_pat, xs, ref s)
            unhidden_at(in pat.pos, env, xs, ref s)
            typed_decls := typed_decls ++ List((typed_pat, Some(typed_value))), covered := covered ++ List((typed_pat, t, pat)), env := bind(xs) ++ env

          // the parser gives a value to every declaration that is no variable
          case (None, None) =>
            raise Unexpected("local of a pattern without a value")
        end
      end
      solve(ref s)
      for (typed_pat, t, pat) in covered do
        covered_at(in pat, typed_pat, t, ref s)
      end
      y := SLocal(mutable, typed_decls)

    case SIf(cond, left, right) =>
      var c: At[Expr], l: At[Stmt], r: At[Stmt], other: Env
      check(in env, cond, TBool(), "the condition of if", out c, ref s)
      other := env
      statement(in assignable, left, out l, ref env, s)
      statement(in assignable, right, out r, ref other, s)
      y := SIf(c, l, r), env := joined(env, other)

    // the scope of the loop, which the invariant of a claim of the procedure sees
    case SWhile(cond, body) =>
      var c: At[Expr], l: At[Stmt], inner: Env
      s := s with loops := s.loops ++ List((pos, env))
      check(in env, cond, TBool(), "the condition of while", out c, ref s)
      inner := env
      statement(in assignable, body, out l, ref inner, s)
      y := SWhile(c, l), s := s with loop_assigned := s.loop_assigned ++ newly_assigned(env, inner)

    // a procedure that a variable holds and the refs are read
    case SCall(proc, ins, outs, refs) =>
      call_proc(in env, assignable, proc, ins, outs, refs, out y, ref s)
      readables(in env, List(proc; List(for x in refs yield x.name)), ref s)
      env := assigned(env, List(for x in outs ++ refs yield x.name))

    case SMatch(arg, cases) =>
      var c: At[Expr], t: Type, bs: List[At[Branch[At[Stmt]]]]
      infer(in env, arg, out c, t, ref s)
      stmt_branches(in assignable, cases, t, out bs, ref env, s)
      solve(ref s)
      coverage(in t, List(for br in bs yield case_of(br)), firsts(List(for br in cases yield case_of(br))), ref s)
      y := SMatch(c, bs)

    case SAssert(cond) =>
      var c: At[Expr]
      check(in env, cond, TBool(), "the assertion", out c, ref s)
      y := SAssert(c)
      if is_parsed(c) and c.that == ELit(LBool(false)) then
        env := unreachable(env)
      end

    // the variables after the body are those before, as at the start of a handler, since it raises if the test passes
    // the variables of the pattern are those of the guard, without which they would be unread
    case SAssertRaises(typ, pat, g, body) =>
      var u: Type, p: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], b: At[Stmt], inner: Env := env
      handler_pattern(in pat, typ, out u, p, xs, ref s)
      match xs
        case List(x; _) if g == None =>
          report(in RaisesVariables(x.name), ref s)
        case _ =>
          skip
      end
      unhidden(in env, xs, ref s)
      guard(in bind(xs) ++ env, g, out typed_guard, ref s)
      statement(in assignable, body, out b, ref inner, s)
      y := SAssertRaises(u, p, typed_guard, b)

    case SRaise(value, typ) =>
      var c: At[Expr], t: Type, u: Type
      infer(in env, value, out c, t, ref s)
      normalize(in typ, out u, ref s)
      unify(in t, u, ref s)
      y := SRaise(c, t), env := unreachable(env)

    case STry(body, catches) =>
      var l: At[Stmt], hs: List[At[Catch]], other: Env := env
      statement(in assignable, body, out l, ref env, s)
      handler_list(in assignable, catches, out hs, ref other, s)
      y := STry(l, hs), env := joined(env, other)

    // the pattern over each item, irrefutable, whose variables the body sees, which may not run, as of a while, and which
    // the checked program keeps with the type of the container, with the guard checked in the scope of the body
    case SFor(gens, body) =>
      var over: At[Expr], t: Type, u: Type, typed_pat: At[Pat], xs: List[Var], typed_body: At[Stmt], inner: Env, typed_guard: Option[At[Expr]]
      items(in env, loop_container(pos, span, gens), out over, t, u, ref s)
      typed_pattern(in loop_pattern(pos, span, gens), t, out typed_pat, xs, ref s)
      solve(ref s)
      coverage(in t, List((typed_pat, true)), List(loop_pattern(pos, span, gens)), ref s)
      unhidden(in env, xs, ref s)
      inner := bind(xs) ++ env
      match loop_guard(gens)
        case Some(cond) =>
          var c: At[Expr]
          check(in inner, cond, TBool(), "the condition of if", out c, ref s)
          typed_guard := Some(c)

        case None =>
          typed_guard := None
      end
      statement(in assignable -- List(for x in xs yield x.name), body, out typed_body, ref inner, s)
      y := SFor(loop_gens(gens, typed_pat, over, u) ++ List(for c in typed_guard yield GIf(c)), typed_body)
  end

// the checked container c, of the type u, whose items are of the type t, its elements if it is a list, and else those of
// its fold, where a map gives its pairs, where u is TError if the container has no fold
procedure items(
  in  env: Env,
      c: At[Expr],
  out typed_c: At[Expr],
      t: Type,
      u: Type,
  ref s: State
) :=
  var w: Type
  infer(in env, c, out typed_c, u, ref s)
  solve(ref s)
  w := zonk_type(s.sub, u)
  match w
    case TList(elem) =>
      t := elem

    // the items of the fold of a list, which the for statement walks, as ulang/expand/expand.u builds it
    case _ =>
      var item: Option[Type], acc: Type
      fresh(out acc, ref s)
      fold_items(in u, "foldr", acc, out item, ref s)
      match item
        case Some(x) =>
          unify(in acc, TList(x), ref s)
          t := x

        case None =>
          fresh(out t, ref s)
          u := TError
      end
  end

// the guard of the generator of a for statement
function loop_guard(gens: List[Gen]): Option[At[Expr]] :=
  match gens
    case List(_, GIf(cond)) =>
      Some(cond)
    case _ =>
      None
  end

// the generator of a for statement over the checked container over of the type u, with its checked pattern pat, a pair of
// key and value over a map
function loop_gens(gens: List[Gen], pat: At[Pat], over: At[Expr], u: Type): List[Gen] :=
  match (gens, pat.that)
    case (List(GPair(_, _, _, _); _), PTuple(List(k, v))) =>
      List(GPair(k, v, over, u))
    case _ =>
      List(GVal(pat, over, u))
  end

// the container of the generator of a for statement at pos, which the parser makes of one generator and an optional guard
function loop_container(pos: Pos, span: Span, gens: List[Gen]): At[Expr] :=
  match gens
    case List(g; _) =>
      gen_container(g)
    case List() =>
      AOk(pos, span, ETuple(List()))
  end

// the pattern of the generator of a for statement at pos, a pair of key and value over a map
function loop_pattern(pos: Pos, span: Span, gens: List[Gen]): At[Pat] :=
  match gens
    case List(GVal(pat, _, _); _) =>
      pat

    case List(GPair(key, value, _, _); _) =>
      AOk(key.pos, span_over(key, value), PTuple(List(key, value)))

    case _ =>
      AOk(pos, span, PWild)
  end

// the variables that the leading assignments of a block assign one at a time, as local x := e does
function initialized(xs: List[At[Stmt]]): List[Name] :=
  match xs
    case List(AOk(_, _, SAssign(List((x, _)))); rest) =>
      List(x.name; initialized(rest))

    case List(AOk(_, _, SCall(_, _, outs, _)); _) =>
      List(for x in outs yield x.name)

    case _ =>
      List()
  end

// the locals without a type are initialized
procedure untyped(in xs: List[At[Var]], inits: List[Name], ref s: State) :=
  match xs
    case List() =>
      skip

    case List(x; rest) =>
      if has_holes(x.that.typ) and not contains(x.that.name, inits) then
        report(in at_use(decl_pos(s.at, x.pos), Hinted(MissingType(x.that.name), "only the call right after the declaration gives a local without a value its type, so declare each before its call or write its type")), ref s)
      end
      untyped(in rest, inits, ref s)
  end

// the block of locals and stmts with SLocal statements, each of which declares its variables for the statements after it,
// where those of a var are assignable there, and a local without a value and a type gets it from the statements right
// after its declaration, by initialized
procedure local_block(
  in  assignable: List[Name],
      locals: List[At[Var]],
      stmts: List[At[Stmt]],
  out y: Stmt,
  ref env: Env,
      s: State
) :=
  var ys: List[Var], inner: Env, names: List[Name], xs: List[At[Stmt]] := List(), rest := stmts
  untyped(in locals, initialized(stmts), ref s)
  formals(in "local", locals, out ys, ref s)
  unhidden(in env, ys, ref s)
  inner := unassigned(ys) ++ env, names := List(for x in ys yield x.name) ++ assignable
  while rest != List() do
    match rest
      case List(stmt; after) =>
        let before := inner
        var typed_stmt: At[Stmt]
        statement(in names, stmt, out typed_stmt, ref inner, s)
        match stmt
          case AOk(_, _, SLocal(mutable, decls)) =>
            let declared := List(for (pat, init) in decls if init == None for x in declared_var(s, pat) yield x)
            untyped(in declared, initialized(after), ref s)
            if mutable then
              names := firsts(take(size(inner) - size(before), inner)) ++ names
            end

          case _ =>
            skip
        end
        xs := xs ++ List(typed_stmt), rest := after

      case List() =>
        skip
    end
  end
  y := SBlock(retyped(locals, ys), xs), env := drop(size(inner) - size(env), inner)

function declared_var(s: State, pat: At[Pat]): Option[At[Var]] :=
  match pat.that
    case PVar(x) if is_pvar(s, pat) =>
      Some(AOk(pat.pos, pat.span, x))

    case PAnnotated(inner, typ) =>
      map_option(declared_var(s, inner), lambda x => x with that := Var(x.that.name, typ))

    case _ =>
      None
  end

// the procedures of the program hide the builtin ones
// a variable of a procedure type hides the procedures of that name
procedure call_proc(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match get(p, env)
    case Some(l) =>
      call_variable(in env, assignable, p, l.typ, ins, outs, refs, out stmt, ref s)
    case None =>
      call_declared(in env, assignable, p, ins, outs, refs, out stmt, ref s)
  end

procedure call_variable(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      typ: Type,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  var is: List[Type], os: List[Type], rs: List[Type], typed_ins: List[At[Expr]], typed_outs: List[Var], typed_refs: List[Var]
  fresh_list(in ins, out is, ref s)
  fresh_list(in outs, out os, ref s)
  fresh_list(in refs, out rs, ref s)
  unify(in typ, TProc(is, os, rs, RPending), ref s)
  unique(in "out or ref", List(for y in outs ++ refs if not is_dropped(y) yield y.name), ref s)
  checks(in env, "procedure " ++ p.base, ins, is, out typed_ins, ref s)
  out_variables(in env, assignable, outs, out typed_outs, ref s)
  variables(in env, assignable, refs, out typed_refs, ref s)
  unifies_toward(in From, List(for y in typed_outs yield y.typ), os, ref s)
  unifies(in List(for y in typed_refs yield y.typ), rs, ref s)
  stmt := SCall(p, typed_ins, typed_outs, typed_refs)

procedure call_declared(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match overloads(s, p, lambda q => is_proc(s.sig, q))
    case List(q) =>
      declared_call(in env, assignable, p, q, ins, outs, refs, out stmt, ref s)

    case List() =>
      declared_call(in env, assignable, p, p, ins, outs, refs, out stmt, ref s)

    case qs =>
      overloaded_call(in env, assignable, p, qs, ins, outs, refs, out stmt, ref s)
  end

// a call of one of the procedures qs, by the types of its arguments, where the arguments are inferred first
procedure overloaded_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      qs: List[Name],
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  var typed_ins: List[At[Expr]], is: List[Type], typed_outs: List[Var], typed_refs: List[Var], m: Name
  unique(in "out or ref", List(for x in outs ++ refs if not is_dropped(x) yield x.name), ref s)
  infers(in env, ins, out typed_ins, is, ref s)
  out_variables(in env, assignable, outs, out typed_outs, ref s)
  variables(in env, assignable, refs, out typed_refs, ref s)
  choose(in p, List(for q in qs yield (q, proc_scheme(s.sig, q))), TProc(is, List(for x in typed_outs yield x.typ), List(for x in typed_refs yield x.typ), RPending), out m, ref s)
  stmt := SCall(m, typed_ins, typed_outs, typed_refs)

procedure declared_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      q: Name,
      ins: List[At[Expr]],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match proc_of(s.sig, q)
    case Some(proc) =>
      var m: List[(Type, Type)], typed_ins: List[At[Expr]], typed_outs: List[Var], typed_refs: List[Var]
      instance(in proc.params, out m, ref s)
      same_length(in "procedure " ++ q.base, "ins", size(proc.ins), size(ins), ref s)
      same_length(in "procedure " ++ q.base, "outs", size(proc.outs), size(outs), ref s)
      same_length(in "procedure " ++ q.base, "refs", size(proc.refs), size(refs), ref s)
      unique(in "out or ref", List(for x in outs ++ refs if not is_dropped(x) yield x.name), ref s)
      checks(in env, "procedure " ++ q.base, ins, List(for t in proc.ins yield subst(t, m)), out typed_ins, ref s)
      out_variables(in env, assignable, outs, out typed_outs, ref s)
      variables(in env, assignable, refs, out typed_refs, ref s)
      unifies_toward(in From, List(for x in typed_outs yield x.typ), List(for t in proc.outs yield subst(t, m)), ref s)
      unifies(in List(for x in typed_refs yield x.typ), List(for t in proc.refs yield subst(t, m)), ref s)
      stmt := SCall(q, typed_ins, typed_outs, typed_refs)

    // a call that does nothing, of an unknown procedure
    case None =>
      report(in UnknownProcedure(p), ref s)
      stmt := SSkip
  end

// env joins what the cases assign, where a match that no case fits raises
procedure stmt_branches(
  in  assignable: List[Name],
      cases: List[At[Branch[At[Stmt]]]],
      t: Type,
  out typed_cases: List[At[Branch[At[Stmt]]]],
  ref env: Env,
      s: State
) :=
  match cases
    case List() =>
      typed_cases := List(), env := unreachable(env)

    case List(AOk(pos, span, Branch(pat, g, body)); more) =>
      var typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: At[Stmt], rest: List[At[Branch[At[Stmt]]]], inner: Env
      typed_pattern(in pat, t, out typed_pat, xs, ref s)
      unhidden(in env, xs, ref s)
      inner := bind(xs) ++ env
      guard(in inner, g, out typed_guard, ref s)
      statement(in assignable -- List(for x in xs yield x.name), body, out typed_body, ref inner, s)
      stmt_branches(in assignable, more, t, out rest, ref env, s)
      typed_cases := List(AOk(pos, span, Branch(typed_pat, typed_guard, typed_body)); rest), env := joined(drop(size(xs), inner), env)

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

// handlers start from the variables before the try, which an exception restores
procedure handler_list(
  in  assignable: List[Name],
      handlers: List[At[Catch]],
  out typed_handlers: List[At[Catch]],
  ref env: Env,
      s: State
) :=
  match handlers
    case List() =>
      typed_handlers := List(), env := unreachable(env)

    case List(AOk(pos, span, Catch(typ, pat, g, body)); more) =>
      var u: Type, typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: At[Stmt], rest: List[At[Catch]], inner: Env
      handler_pattern(in pat, typ, out u, typed_pat, xs, ref s)
      unhidden(in env, xs, ref s)
      inner := bind(xs) ++ env
      guard(in inner, g, out typed_guard, ref s)
      statement(in assignable -- List(for x in xs yield x.name), body, out typed_body, ref inner, s)
      handler_list(in assignable, more, out rest, ref env, s)
      typed_handlers := List(AOk(pos, span, Catch(u, typed_pat, typed_guard, typed_body)); rest), env := joined(drop(size(xs), inner), env)

    // the parser makes no error nodes yet
    case _ =>
      raise Unexpected("error node")
  end

procedure declare_name(in sig: Sig, n: Name) :=
  if is_fun(sig, n) or is_proc(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n) or builtin_schemes(unqualified(n.base)) != List() then
    raise AlreadyDefined(n)
  end

// functions of the same name must differ in their number of arguments, while they may overload builtins
procedure overload(in sig: Sig, n: Name, k: Int) :=
  if is_proc(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n) or has_arity(schemes_of(sig, n), k) then
    raise AlreadyDefined(n)
  end

procedure declare_sort(in sig: Sig, n: Name) :=
  if n.base == "->" or is_type_alias(sig, n) or is_data(sig, n) then
    raise SortDefined(n)
  end

// the type parameters of ts are declared, where an unknown is the fallback of an error reported before
procedure closed(in n: Name, ps: List[Id], ts: List[Type], ref s: State) :=
  let undeclared := List(for v in distinct(List(for t in ts for v in free(t) yield v)) -- params(ps) if not is_meta(v))
  if undeclared != List() then
    report(in UndeclaredParams(n, undeclared), ref s)
  end

function is_meta(t: Type): Bool :=
  match t
    case TMeta(_) =>
      true
    case _ =>
      false
  end

// datatypes may be mutually recursive, so they are known before any sort is checked
procedure declare_datas(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(name, params, _) =>
        s := enter(s, m)
        declare_sort(in s.sig, name)
        s := with_sig(s, with_data(s.sig, name, size(params)))

      case _ =>
        skip
    end
  end

procedure declare_sorts(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CSort(name, params, typ) =>
        var u: Type
        s := enter(s, m)
        declare_sort(in s.sig, name)
        unique_ids(in "type parameter", params, ref s)
        known(in typ, name, out u, ref s)
        closed(in name, params, List(u), ref s)
        s := with_sig(s, with_type_alias(s.sig, name, TypeAlias(params, u)))

      case _ =>
        skip
    end
  end

procedure declare_constrs(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(n, params, constrs) =>
        s := enter(s, m)
        unique_ids(in "type parameter", params, ref s)
        s := with_sig(s, with_members(s.sig, n, List(for k in parts(constrs) yield k.name)))
        declare_constructors(in n, params, constrs, ref s)
        declare_fields(in n, params, datatype_fields(s.sig, params, parts(constrs)), ref s)

      case _ =>
        skip
    end
  end

// each constructor at its position
procedure declare_constructors(
  in  n: Name,
      ps: List[Id],
      ks: List[At[Constr]],
  ref s: State
) :=
  for k in ks do
    try
      s := s with at := k.pos
      declare_constructor(in n, ps, k.that, ref s)
    catch
      case e =>
        raise at_use(k.pos, e)
    end
  end

procedure declare_constructor(in n: Name, ps: List[Id], k: Constr, ref s: State) :=
  var ts: List[Type]
  declare_name(in s.sig, k.name)
  knowns(in List(for field in k.fields yield field.typ), k.name, out ts, ref s)
  closed(in n, ps, ts, ref s)
  s := with_sig(s, with_constr(s.sig, k.name, ConstrSig(params(ps), ts, TSort(n, params(ps)))))

// the accessor T.f and the updater T.f:= of each field f of the datatype T, which have no definitions, since the
// interpreter and the compiler implement them by the positions of the fields (fields of Defs)
procedure declare_fields(
  in  n: Name,
      ps: List[Id],
      fields: List[(Id, Type)],
  ref s: State
) :=
  let t := TSort(n, params(ps))
  for (f, u) in fields do
    s := with_sig(s, with_fun(with_fun(s.sig, accessor_name(n, f), Scheme(params(ps), TFun(List(t), u))), updater_name(n, f), Scheme(params(ps), TFun(List(t, u), t))))
  end

// each field of the constructors once, with its type as the constructor that declares it first has it, which is that of
// the others, since the parser rejects a field with different types
function datatype_fields(sig: Sig, ps: List[Id], ks: List[Constr]): List[(Id, Type)] :=
  first_fields(List(for k in ks for p in zip(List(for field in k.fields yield field.name), constr_fields(sig, k.name, params(ps))) yield p))

function first_fields(fields: List[(Id, Type)]): List[(Id, Type)] :=
  match fields
    case List() =>
      List()
    case List((f, u); rest) =>
      List((f, u); first_fields(List(for p in rest if first(p) != f)))
  end

procedure declare_funs(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CFun(name, ps, formals, typ, _, _) =>
        var xs: List[Var], r: Type
        s := enter(s, m)
        overload(in s.sig, name, size(formals))
        unique_ids(in "type parameter", ps, ref s)
        signature(in formals, out xs, ref s)
        known(in typ, name, out r, ref s)
        closed(in name, ps, List(TFun(List(for x in xs yield x.typ), r)), ref s)
        s := with_sig(s, with_fun(s.sig, name, Scheme(params(ps), TFun(List(for x in xs yield x.typ), r))))

      case _ =>
        skip
    end
  end

// each alias after the constructors and the aliases before it, so that aliases do not recur, with the function of the
// same name that builds its values where its pattern has no _
procedure declare_pat_aliases(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CPatAlias(name, ps, formals, typ, pat) =>
        var xs: List[Var], r: Type, checked: At[Pat], ys: List[Var]
        s := enter(s, m)
        declare_name(in s.sig, name)
        unique_ids(in "type parameter", ps, ref s)
        signature(in formals, out xs, ref s)
        known(in typ, name, out r, ref s)
        closed(in name, ps, List(TFun(List(for x in xs yield x.typ), r)), ref s)
        typed_pattern(in pat, r, out checked, ys, ref s)
        if Set(for y in ys yield y.name) != Set(for x in xs yield x.name) then
          report(in AliasVariables(name), ref s)
        end
        for y in ys do
          unify(in y.typ, value_or(map_option(find(xs, lambda x => x.name == y.name), lambda x => x.typ), y.typ), ref s)
        end
        solve(ref s)
        s := with_sig(s, with_pat_alias(s.sig, name, PatAlias(params(ps), xs, r, alias_free(s.sig, zonk_pat(s, checked)))))
        if pattern_expr(pat) != None then
          s := with_sig(s, with_fun(s.sig, name, Scheme(params(ps), TFun(List(for x in xs yield x.typ), r))))
        end

      case _ =>
        skip
    end
  end

// the proof of a lemma over its formals and the locals of the proof, see ideas/verification.md, section 4: the steps in their order,
// each adding its local to env, then the split, whose cases are proofs with the variables of their patterns
procedure check_proof(
  in  formals: List[Var],
      outs: List[Name],
      proof: Proof,
  out typed_proof: Proof,
  ref env: Env,
      s: State
) :=
  var steps: Buffer[At[Step]] := empty(), split: Option[At[Split]] := None
  for step in proof.steps do
    var typed_step: Step, errors: List[Diagnostic]
    let outer := s.at, before := size(s.errors)
    s := s with at := step.pos
    proof_step(in outs, step.that, out typed_step, ref env, s)
    take_errors(in step.pos, before, out errors, ref s)
    steps := steps ++ List(checked_at(step.pos, step.span, typed_step, errors)), s := s with at := outer
  end
  match proof.split
    case Some(placed) =>
      var typed_split: Split, errors: List[Diagnostic]
      let outer := s.at, before := size(s.errors)
      s := s with at := placed.pos
      proof_split(in formals, outs, placed.that, out typed_split, ref env, s)
      take_errors(in placed.pos, before, out errors, ref s)
      split := Some(checked_at(placed.pos, placed.span, typed_split, errors)), s := s with at := outer

    case None =>
      skip
  end
  typed_proof := Proof(List(for step in steps), split)

// a step, where a local with a value is a definition and one without a witness that an out of a call binds, a call is of
// a lemma of the module, and an assignment gives the witnesses of the outs of the lemma, each once
procedure proof_step(
  in  assignable: List[Name],
      step: Step,
  out typed_step: Step,
  ref env: Env,
      s: State
) :=
  match step
    case StepLocal(x, Some(e)) =>
      var c: At[Expr], y: Var
      if x.that.typ == THole then
        var t: Type
        infer(in env, e, out c, t, ref s)
        y := Var(x.that.name, t)
      else
        var ys: List[Var]
        formals(in "local", List(x), out ys, ref s)
        y := at(0, from_list(ys))
        check(in env, e, y.typ, "the local " ++ x.that.name.base, out c, ref s)
      end
      unhidden(in env, List(y), ref s)
      env := bind(List(y)) ++ env, typed_step := StepLocal(map_at(x, lambda _ => y), Some(c))

    case StepLocal(x, None) =>
      var ys: List[Var]
      untyped(in List(x), List(), ref s)
      formals(in "local", List(x), out ys, ref s)
      unhidden(in env, ys, ref s)
      env := List(for y in ys yield (y.name, Local(y.typ, false))) ++ env, typed_step := StepLocal(map_at(x, lambda _ => at(0, from_list(ys))), None)

    case StepCall(name, ins, outs) =>
      let qualified := in_module(s.module, name)
      var typed_ins: List[At[Expr]] := ins, typed_outs: List[Var] := outs
      match lemma_of(s.sig, qualified)
        case Some(lemma_sig) if lemma_sig.claim =>
          report(in ClaimCalled(name), ref s)

        case Some(lemma_sig) =>
          var m: List[(Type, Type)]
          instance(in lemma_sig.params, out m, ref s)
          if size(ins) != size(lemma_sig.formals) then
            report(in CountMismatch("lemma " ++ name.base, "arguments", size(lemma_sig.formals), size(ins)), ref s)
          else
            checks(in env, "lemma " ++ name.base, ins, List(for t in lemma_sig.formals yield subst(t, m)), out typed_ins, ref s)
          end
          if size(outs) != size(lemma_sig.outs) then
            report(in CountMismatch("lemma " ++ name.base, "outs", size(lemma_sig.outs), size(outs)), ref s)
          else
            variables(in env, unbound(env), outs, out typed_outs, ref s)
            unifies(in List(for y in typed_outs yield y.typ), List(for t in lemma_sig.outs yield subst(t, m)), ref s)
            env := assigned(env, List(for y in outs yield y.name))
          end

        case None =>
          report(in UnknownLemma(name), ref s)
      end
      typed_step := StepCall(qualified, typed_ins, typed_outs)

    case StepAssert(cond) =>
      var c: At[Expr]
      check(in env, cond, TBool(), "the assertion", out c, ref s)
      typed_step := StepAssert(c)

    // claim_proof checks those of claims
    case StepInvariant(_) =>
      report(in InvariantOutsideClaim, ref s)
      typed_step := step

    case StepAssign(upd) =>
      var ys: List[Var], exprs: List[At[Expr]]
      unique(in "assignment to", List(for x in firsts(upd) yield x.name), ref s)
      variables(in env, List(for o in assignable if contains(o, unbound(env)) yield o), firsts(upd), out ys, ref s)
      checks(in env, "the assignment", seconds(upd), List(for y in ys yield y.typ), out exprs, ref s)
      typed_step := StepAssign(zip(ys, exprs)), env := assigned(env, List(for y in ys yield y.name))
  end

// the variables of env that are not assigned yet, the witnesses of a proof and the outs of its lemma
function unbound(env: Env): List[Name] :=
  List(for (n, l) in env if not l.assigned yield n)

// a split of a proof, where induction is on a formal of a datatype of the lemma
procedure proof_split(
  in  formals: List[Var],
      outs: List[Name],
      split: Split,
  out typed_split: Split,
  ref env: Env,
      s: State
) :=
  match split
    case SplitInduction(x, cases) =>
      var t: Type, typed_cases: List[At[Branch[Proof]]]
      match List(for f in formals if f.name == x.name and (is_datatype_type(s, f.typ) or zonk_type(s.sub, f.typ) == TInt()) yield f.typ)
        case List(u; _) =>
          t := u

        case List() =>
          report(in NotInducible(x.name), ref s)
          fresh(out t, ref s)
      end
      proof_cases(in formals, outs, cases, t, out typed_cases, ref env, s)
      typed_split := SplitInduction(Var(x.name, t), typed_cases)

    case SplitMatch(arg, cases) =>
      var c: At[Expr], t: Type, typed_cases: List[At[Branch[Proof]]]
      infer(in env, arg, out c, t, ref s)
      proof_cases(in formals, outs, cases, t, out typed_cases, ref env, s)
      typed_split := SplitMatch(c, typed_cases)

    case SplitIf(cond, left, right) =>
      var c: At[Expr], l: Proof, r: Option[Proof] := None, inner := env, other := env
      check(in env, cond, TBool(), "the condition", out c, ref s)
      check_proof(in formals, outs, left, out l, ref inner, s)
      match right
        case Some(p) =>
          var q: Proof
          check_proof(in formals, outs, p, out q, ref other, s)
          r := Some(q)

        case None =>
          skip
      end
      typed_split := SplitIf(c, l, r), env := joined(outer_part(inner, env), outer_part(other, env))
  end

// a type of a datatype with constructors, which builtin types such as Int have none of
// the variables of env in inner, the environment of a block inside, which adds its own in front
function outer_part(inner: Env, env: Env): Env :=
  drop(size(inner) - size(env), inner)

function is_datatype_type(s: State, t: Type): Bool :=
  match zonk_type(s.sub, t)
    case TSort(name, _) =>
      value_or(members_of(s.sig, name), List()) != List()
    case _ =>
      false
  end

// the cases of a split, each a proof with the variables of its pattern, from env, after which a variable is assigned if
// every case assigns it, and the cases that are not written count as paths that do not
procedure proof_cases(
  in  formals: List[Var],
      outs: List[Name],
      cases: List[At[Branch[Proof]]],
      t: Type,
  out typed_cases: List[At[Branch[Proof]]],
  ref env: Env,
      s: State
) :=
  var found: Buffer[At[Branch[Proof]]] := empty(), after := unreachable(env)
  for placed in cases do
    var typed_pat: At[Pat], xs: List[Var], typed_guard: Option[At[Expr]], typed_body: Proof, inner: Env
    typed_pattern(in placed.that.pat, t, out typed_pat, xs, ref s)
    unhidden(in env, xs, ref s)
    inner := bind(xs) ++ env
    guard(in inner, placed.that.guard, out typed_guard, ref s)
    check_proof(in formals, outs, placed.that.body, out typed_body, ref inner, s)
    found := found ++ List(
      AOk(placed.pos, placed.span, Branch(typed_pat, typed_guard, typed_body))), after := joined(after, outer_part(inner, env))
  end
  typed_cases := List(for c in found)
  if not covers_all(s.sig, zonk_type(s.sub, t), List(for c in found if c.that.guard == None yield strip_pat(c.that.pat).that)) then
    after := joined(after, env)
  end
  env := after

// lemmas have names of their own, apart from the values, which they may share
procedure declare_lemmas(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CLemma(name, ps, formals, outs, claim, _) =>
        var xs: List[Var], ys: List[Var]
        s := enter(s, m)
        if lemma_of(s.sig, name) != None then
          raise AlreadyDefined(name)
        end
        unique_ids(in "type parameter", ps, ref s)
        signature(in formals ++ outs, out xs, ref s)
        closed(in name, ps, List(for x in xs yield x.typ), ref s)
        ys := drop(size(formals), xs), xs := take(size(formals), xs)
        s := with_sig(s, with_lemma(s.sig, name, LemmaSig(params(ps), List(for x in xs yield x.typ), List(for y in ys yield y.typ), is_claim(claim))))

      case _ =>
        skip
    end
  end

function is_claim(claim: Claim): Bool :=
  match claim
    case ClaimCorrect(_, _, _) =>
      true
    case ClaimHolds(_, _) =>
      false
  end

procedure declare_procs(in cs: List[(Path, Cmd)], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CProc(name, ps, ins, outs, refs, raised, _, _) =>
        var xs: List[Var], ts: List[Type], typed_raised: List[Type]
        s := enter(s, m)
        declare_name(in s.sig, name)
        unique_ids(in "type parameter", ps, ref s)
        signature(in ins ++ outs ++ refs, out xs, ref s)
        normalizes(in raised, out typed_raised, ref s)
        exceptions(in typed_raised, ref s)
        ts := List(for x in xs yield x.typ)
        closed(in name, ps, ts, ref s)
        s := match split_at(size(ins), ts)
          case (in_types, others) =>
            match split_at(size(outs), others)
              case (out_types, ref_types) =>
                with_sig(s, with_proc(s.sig, name, ProcSig(params(ps), in_types, out_types, ref_types, typed_raised)))
            end
        end

      case _ =>
        skip
    end
  end

procedure command(in cmd: Cmd, out typed_cmd: Cmd, ref s: State) :=
  match cmd
    case CFun(name, params, formals, typ, _, body) =>
      var xs: List[Var], r: Type, b: At[Expr]
      signature(in formals, out xs, ref s)
      known(in typ, name, out r, ref s)
      check(in bind(xs), body, r, "the result of " ++ name.base, out b, ref s)
      typed_cmd := CFun(name, params, retyped(formals, xs), r, no_spec(), b)

    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      var is: List[Var], os: List[Var], rs: List[Var], typed_raised: List[Type], y: At[Stmt], env: Env, typed_spec: Spec
      signature(in ins, out is, ref s)
      signature(in outs, out os, ref s)
      signature(in refs, out rs, ref s)
      normalizes(in raised, out typed_raised, ref s)
      env := bind(is) ++ unassigned(os) ++ bind(rs)
      contract(in is, os, rs, spec, out typed_spec, ref s)
      statement(in List(for x in os ++ rs yield x.name), stmt, out y, ref env, s)
      outputs(in name, os, env, ref s)
      typed_cmd := CProc(name, params, retyped(ins, is), retyped(outs, os), retyped(refs, rs), typed_raised, typed_spec, y)

    // a test with formals runs as the test over their enumerated values that the tester generates of it
    // (enumerated_tests of ulang/test/generate.u)
    case CTest(name, formals, stmt) =>
      var xs: List[Var], y: At[Stmt], env: Env
      signature(in formals, out xs, ref s)
      env := bind(xs)
      statement(in List(), stmt, out y, ref env, s)
      typed_cmd := CTest(name, retyped(formals, xs), y)

    case CData(name, params, constrs) =>
      typed_cmd := CData(name, params, List(for k in constrs yield map_at(k, lambda c => resolved_fields(s.sig, c))))

    case CLemma(name, params, ins, outs, ClaimHolds(assms, concl), proof) =>
      var xs: List[Var], ys: List[Var], checked: List[At[Expr]] := List(), c: At[Expr], typed_proof: Option[Proof] := None
      signature(in ins, out xs, ref s)
      signature(in outs, out ys, ref s)
      for a in assms do
        var b: At[Expr]
        check(in bind(xs), a, TBool(), "the assumption", out b, ref s)
        checked := checked ++ List(b)
      end
      check(in bind(xs ++ ys), concl, TBool(), "the conclusion", out c, ref s)
      match proof
        case Some(p) =>
          var env := bind(xs) ++ unassigned(ys), q: Proof
          check_proof(in xs, List(for y in ys yield y.name), p, out q, ref env, s)
          outputs(in name, ys, env, ref s)
          typed_proof := Some(q)

        case None =>
          skip
      end
      typed_cmd := CLemma(name, params, retyped(ins, xs), retyped(outs, ys), ClaimHolds(checked, c), typed_proof)

    // the call of the claim assigns the outs of the lemma, and the invariants are over the scopes of the loops
    case CLemma(name, params, ins, outs, ClaimCorrect(proc, args, call_outs), proof) =>
      var xs: List[Var], ys: List[Var], env: Env, y: Stmt, claim: Claim := ClaimCorrect(proc, args, call_outs), typed_proof: Option[Proof] := None
      signature(in ins, out xs, ref s)
      signature(in outs, out ys, ref s)
      env := bind(xs) ++ unassigned(ys)
      call_declared(in env, List(for x in ys yield x.name), proc, args, call_outs, List(), out y, ref s)
      solve(ref s)
      match y
        case SCall(q, typed_ins, typed_outs, _) =>
          if List(for x in typed_outs yield x.name) != List(for x in ys yield x.name) then
            report(in ClaimOuts(name), ref s)
          end
          claim := ClaimCorrect(q, typed_ins, typed_outs)
          match (get(settled(s, q), s.scopes), proof)
            case (Some(scopes), Some(p)) =>
              var typed: Proof
              claim_proof(in name, scopes, p, out typed, ref s)
              typed_proof := Some(typed)

            // without a proof, the invariant of every loop is true
            case (Some(_), None) =>
              skip

            case (None, _) =>
              report(in ClaimOrder(proc), ref s)
          end

        // call_declared reported the unknown procedure
        case _ =>
          skip
      end
      typed_cmd := CLemma(name, params, retyped(ins, xs), retyped(outs, ys), claim, typed_proof)

    // type aliases and notations, which the checked program keeps as written
    case CSort(_, _, _) | CNotation(_, _, _) =>
      typed_cmd := cmd

    // signatures and abstract types, which is_definition leaves out, and pattern aliases, which definition_of makes
    // functions of
    case CAbstract(_, _) | CSig | CPatAlias(_, _, _, _, _) =>
      raise Unexpected("a declaration without a definition")
  end

// the contract of a procedure, the requires over its ins and refs, the ensures over all its formals
procedure contract(
  in  ins: List[Var],
      outs: List[Var],
      refs: List[Var],
      spec: Spec,
  out typed_spec: Spec,
  ref s: State
) :=
  var pre: Buffer[At[Expr]] := empty(), post: Option[At[Expr]] := None
  for a in spec.pre do
    var b: At[Expr]
    check(in bind(ins ++ refs), a, TBool(), "the requires", out b, ref s)
    pre := pre ++ List(b)
  end
  match spec.post
    case Some(e) =>
      var c: At[Expr]
      check(in bind(ins ++ outs ++ refs), e, TBool(), "the ensures", out c, ref s)
      post := Some(c)

    case None =>
      skip
  end
  typed_spec := Spec(List(for a in pre), post, spec.examples)

// the proof of the claim name, its invariants, each over the scope of its loop, the first of scopes for the first
procedure claim_proof(
  in  name: Name,
      scopes: List[Env],
      proof: Proof,
  out typed_proof: Proof,
  ref s: State
) :=
  var invariants: Buffer[At[Step]] := empty()
  let written := List(for step in proof.steps if is_invariant(step.that) yield step)
  if proof.split != None or size(written) != size(proof.steps) then
    report(in ClaimStep(name), ref s)
  end
  if size(written) != size(scopes) then
    report(in CountMismatch("the proof of " ++ name.base, "invariants", size(scopes), size(written)), ref s)
  end
  for (step, env) in zip(written, scopes) do
    match step.that
      case StepInvariant(cond) =>
        var c: At[Expr]
        let outer := s.at
        s := s with at := step.pos
        check(in env, cond, TBool(), "the invariant", out c, ref s)
        invariants := invariants ++ List(AOk(step.pos, step.span, StepInvariant(c))), s := s with at := outer

      // written has only invariants
      case _ =>
        skip
    end
  end
  typed_proof := Proof(List(for step in invariants), None)

function is_invariant(step: Step): Bool :=
  match step
    case StepInvariant(_) =>
      true
    case _ =>
      false
  end

// the constructor k with the types of its fields resolved, as declare_constructors declared them
function resolved_fields(sig: Sig, k: Constr): Constr :=
  match constr_of(sig, k.name)
    case Some(constr) =>
      k with fields := List(for (field, typ) in zip(k.fields, constr.fields) yield field with typ := typ)
    case None =>
      k
  end

procedure commands(
  in  cmds: List[(Path, Cmd)],
  out typed_cmds: List[Cmd],
  ref s: State
) :=
  match cmds
    case List() =>
      typed_cmds := List()

    case List((m, cmd); more) =>
      var typed_cmd: Cmd, zonked: Cmd, rest: List[Cmd]
      s := enter(s, m) with loops := List()
      command(in cmd, out typed_cmd, ref s)
      settle(ref s)
      s := with_scopes(s, typed_cmd)
      zonked := zonk_cmd(s, typed_cmd)
      // a command with parts that do not parse keeps them as error nodes in its checked body, which a run reaches only on a
      // path through them, while the types that they reach are TError, so an unknown exception there is a follow-up
      if not s.partial or part_errors(cmd) == List() then
        match unknown_in_cmd(zonked)
          case Some((pos, t)) =>
            s := s with errors := s.errors ++ List(at_use(pos, UnknownException(t)))
          case None =>
            skip
        end
      end
      commands(in more, out rest, ref s)
      typed_cmds := List(zonked; rest)
  end

// s with the scopes of the loops of the checked procedure cmd, one per while of its body in the order of the source, as
// the invariants of its claims are written, with their types, which the next command, after enter, no longer knows
function with_scopes(s: State, cmd: Cmd): State :=
  match cmd
    case CProc(name, _, _, _, _, _, _, stmt) =>
      let scopes := Map(for (pos, env) in s.loops yield pos => List(for (n, l) in env yield (n, l with typ := zonk_type(s.sub, l.typ)))) in
      s with scopes := put(name, List(for pos in loop_positions(stmt) for env in get(pos, scopes) yield env), s.scopes)

    case _ =>
      s
  end

// tests are chosen by name, so a name of a test of module d is not repeated, where the error is at the second test
procedure unique_tests(in d: Mod, ref s: State) :=
  var seen: Set[Id] := empty(), found := false
  for (pos, (_, cmd)) in decls_of(d) do
    match cmd
      case CTest(name, _, _) =>
        if contains(name.base, seen) and not found then
          found := true
          s := s with errors := s.errors ++ List(Located(Some(d.name), pos, Duplicate("declaration", name.base)))
        end
        seen := seen ++ Set(name.base)

      case _ =>
        skip
    end
  end

// only abstract types declare equalities, since matching tells the values of other datatypes apart by their constructors,
// and the orders and equalities of exported datatypes are exported, since they change what the builtins do for importers
procedure check_orders(
  in  cmds: List[Cmd],
      abstract: List[Name],
      hidden: Set[Name],
      hidden_sorts: List[Name]
) :=
  match cmds
    case List() =>
      skip

    case List(c; rest) =>
      match (c, order_of(c))
        case (_, Some((HookEquality, t))) if not contains(t, abstract) =>
          raise VisibleEquality(t)

        case (CFun(name, _, formals, _, _, _), None) =>
          match hook_of(name.base, size(formals))
            case Some(hook) =>
              raise MisshapenHook(name, hook)
            case None =>
              check_orders(in rest, abstract, hidden, hidden_sorts)
          end

        case (CFun(name, _, _, _, _, _), Some((_, t))) if contains(name, hidden) and not contains(t, hidden_sorts) =>
          raise UnexportedOrder(name, t)

        case _ =>
          check_orders(in rest, abstract, hidden, hidden_sorts)
      end
  end

// the commands of ds without signatures and abstract types, which only the checks of sections need
function is_definition(d: (Path, Cmd)): Bool :=
  match d
    case (_, CFunSig(_, _, _, _, _)) =>
      false

    case (_, CProcSig(_, _, _, _, _, _, _)) =>
      false

    case (_, CAbstract(_, _)) =>
      false

    case _ =>
      true
  end

// the signatures and types of the builtin section of d as definitions to declare, whose definitions the interpreter and the
// runtime give, where a type is a datatype without constructors, whose values the interpreter and the runtime make
function natives(d: Mod): List[(Path, Cmd)] :=
  List(for c in commands_of(d.builtins) yield (d.name, native(qualify(d.name, c))))

function native(cmd: Cmd): Cmd :=
  match cmd
    case CFunSig(name, params, formals, typ, _) =>
      CFun(name, params, formals, typ, no_spec(), nowhere(ELit(LUnit)))

    case CProcSig(name, params, ins, outs, refs, raised, _) =>
      CProc(name, params, ins, outs, refs, raised, no_spec(), nowhere(SSkip))

    case CAbstract(name, params) =>
      CData(name, params, List())

    case _ =>
      cmd
  end

function abstract_types(ds: List[(Path, Cmd)]): List[Name] :=
  match ds
    case List() =>
      List()

    case List((_, CAbstract(name, _)); rest) =>
      List(name; abstract_types(rest))

    case List(_; rest) =>
      abstract_types(rest)
  end

// the declarations of an implementation section that the export section does not export, with the constructors and fields
// of abstract types
function private_names(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  List(for c in im for n in private_in(c, ex) yield n)

function private_in(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CFun(name, _, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then List() else List(name)

    case CProc(name, _, _, _, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then List() else List(name)

    case CData(t, _, constrs) =>
      let members := List(for k in parts(constrs) yield k.name) ++ List(for f in field_names(parts(constrs)) for n in List(accessor_name(t, f), updater_name(t, f)) yield n) in
      if exists(ex, lambda e => abstracts(e, t)) then
        members
      else
        List(t; members)

    case CSort(name, _, _) =>
      List(name)

    case CPatAlias(name, _, _, _, _) =>
      List(name)

    case CLemma(name, _, _, _, _, _) =>
      List(name)

    case CTest(_, _, _) =>
      List()

    // notations, signatures, and abstract types, which enter_section of ulang/parse/parse.u keeps out of implementation sections
    case CNotation(_, _, _) | CSig | CAbstract(_, _) =>
      List()
  end

// the sorts of an implementation section that the export section does not export, not even as abstract types
function private_sorts(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  List(for c in im for n in private_sort(c, ex) yield n)

function private_sort(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CData(name, _, _) =>
      if exists(ex, lambda e => abstracts(e, name)) then List() else List(name)

    case CSort(name, _, _) =>
      List(name)

    case _ =>
      List()
  end

function signs(e: Cmd, n: Name): Bool :=
  match e
    case CFunSig(name, _, _, _, _) =>
      name == n

    case CProcSig(name, _, _, _, _, _, _) =>
      name == n

    case _ =>
      false
  end

function abstracts(e: Cmd, t: Name): Bool :=
  match e
    case CAbstract(name, _) =>
      name == t
    case _ =>
      false
  end

// the function n of k arguments, the procedure n, and the datatype n
function defines_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFun(name, _, formals, _, _, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

function defines_proc(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, _, _, _, _, _, _) =>
      name == n
    case _ =>
      false
  end

function defines_data(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CData(name, _, _) =>
      name == n
    case _ =>
      false
  end

function signs_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFunSig(name, _, formals, _, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

// the signatures of ex, each of which the implementation section im defines once and exactly as written, where an error
// is at the second signature of a name, at the definition that differs, or at the signature without a definition
procedure check_signatures(in ex: List[(Pos, Cmd)], im: List[(Pos, Cmd)]) :=
  match ex
    case List() =>
      skip

    case List((pos, CFunSig(name, params, formals, typ, _)); rest) =>
      once(in name, List(for (p, e) in rest if signs_fun(e, name, size(formals)) yield p))
      match List(for (p, c) in im if defines_fun(c, name, size(formals)) yield (p, c))
        case List((p, CFun(_, params_, formals_, typ_, _, _))) =>
          mismatch(in name, p, List(
            DifferingParams(params, params_),
            DifferingFormals("formals", vars(formals), vars(formals_)),
            DifferingResult(typ, typ_)))

        case _ =>
          raise Located(None, pos, MissingDefinition(name))
      end
      check_signatures(in rest, im)

    case List((pos, CProcSig(name, params, ins, outs, refs, raised, _)); rest) =>
      once(in name, List(for (p, e) in rest if signs(e, name) yield p))
      match List(for (p, c) in im if defines_proc(c, name) yield (p, c))
        case List((p, CProc(_, params_, ins_, outs_, refs_, raised_, _, _))) =>
          let parts := List(
            DifferingParams(params, params_),
            DifferingFormals("ins", vars(ins), vars(ins_)),
            DifferingFormals("outs", vars(outs), vars(outs_)),
            DifferingFormals("refs", vars(refs), vars(refs_)),
            DifferingRaises(raised, raised_))
          mismatch(in name, p, parts)

        case _ =>
          raise Located(None, pos, MissingDefinition(name))
      end
      check_signatures(in rest, im)

    case List((pos, CAbstract(name, params)); rest) =>
      match List(for (p, c) in im if defines_data(c, name) yield (p, c))
        case List((p, CData(_, params_, _))) =>
          mismatch(in name, p, List(DifferingParams(params, params_)))
        case _ =>
          raise Located(None, pos, MissingDefinition(name))
      end
      check_signatures(in rest, im)

    case List(_; rest) =>
      check_signatures(in rest, im)
  end

// the definition of name at pos agrees with its signature in each of parts, else the first part that differs is the error
procedure mismatch(in name: Name, pos: Pos, parts: List[Differing]) :=
  for part in find(parts, differs) do
    raise Located(None, pos, SignatureMismatch(name, part))
  end

function differs(part: Differing): Bool :=
  match part
    case DifferingParams(params, params_) =>
      params != params_

    case DifferingFormals(_, formals, formals_) =>
      formals != formals_

    case DifferingResult(typ, typ_) =>
      typ != typ_

    case DifferingRaises(raised, raised_) =>
      raised != raised_
  end

// the signature name is not repeated at the positions others
procedure once(in name: Name, others: List[Pos]) :=
  for p in take(1, others) do
    raise Located(None, p, AlreadyDefined(name))
  end

// a function of the implementation section that is exported is exported with each of its numbers of arguments
procedure check_arities(in im: List[(Pos, Cmd)], ex: List[Cmd]) :=
  for (pos, cmd) in im do
    match cmd
      case CFun(name, _, formals, _, _, _) =>
        if exists(ex, lambda e => signs(e, name)) and not exists(ex, lambda e => signs_fun(e, name, size(formals))) then
          raise Located(None, pos, PartlyExported(name))
        end

      case _ =>
        skip
    end
  end

// the exported pattern aliases of cs expand to constructors that importers see
procedure exported_aliases(
  in  cs: List[(Path, Cmd)],
      hidden: Set[Name],
      s: State
) :=
  for (_, cmd) in cs do
    match cmd
      case CPatAlias(name, _, _, _, _) if not contains(name, hidden) =>
        for k in pattern_constrs(value_or(map_option(pat_alias_of(s.sig, name), lambda alias => alias.pat.that), PWild)) if contains(k, hidden) do
          raise PrivateConstructor(name, k)
        end

      case _ =>
        skip
    end
  end

function pattern_constrs(pat: Pat): List[Name] :=
  match pat
    case PApp(constr, args) =>
      List(constr; List(for a in args for k in pattern_constrs(a.that) yield k))

    case PTuple(args) =>
      List(for a in args for k in pattern_constrs(a.that) yield k)

    case POr(alts) =>
      List(for a in alts for k in pattern_constrs(a.that) yield k)

    case PAnnotated(inner, _) =>
      pattern_constrs(inner.that)

    case PWild | PLit(_) | PVar(_) =>
      List()
  end

// the types of the export section name only sorts that importers can name, not the private sorts of the module
procedure check_exposed(
  in  m: Path,
      ex: List[(Pos, Cmd)],
      hidden_sorts: List[Name]
) :=
  match ex
    case List() =>
      skip

    case List((pos, c); rest) =>
      match exposed(c)
        case Some((n, ts)) =>
          let found: List[Name] := List(for u in ts for t in sorts_in(u) if contains(own_name(m, t), hidden_sorts) yield own_name(m, t))
          match found
            case List(t; _) =>
              raise Located(None, pos, PrivateType(n, t))
            case List() =>
              skip
          end

        case None =>
          skip
      end
      check_exposed(in m, rest, hidden_sorts)
  end

// a name as written in module m, where an unqualified name of a sort of m is one of its own
function own_name(m: Path, n: Name): Name :=
  if n.path == List() then in_module(m, n) else n

// the declaration of an export section with the types that it shows to importers
function exposed(cmd: Cmd): Option[(Name, List[Type])] :=
  match cmd
    case CFunSig(name, _, formals, typ, _) =>
      Some((name, List(for x in formals yield x.that.typ) ++ List(typ)))

    case CProcSig(name, _, ins, outs, refs, raised, _) =>
      Some((name, List(for x in ins ++ outs ++ refs yield x.that.typ) ++ raised))

    case CData(name, _, constrs) =>
      Some((name, List(for k in parts(constrs) for field in k.fields yield field.typ)))

    case CSort(name, _, typ) =>
      Some((name, List(typ)))

    case CPatAlias(name, _, formals, typ, _) =>
      Some((name, List(for x in formals yield x.that.typ) ++ List(typ)))

    // abstract types and notations, and definitions and tests, which enter_section of ulang/parse/parse.u keeps out of export
    // sections
    case _ =>
      None
  end

// the sections of module d, whose signatures its definitions repeat, and whose exports name no private sorts
procedure check_sections(in d: Mod) :=
  let ex := placed_cmds(d.name, d.exported), im := placed_cmds(d.name, d.implemented)
  check_signatures(in ex, im)
  check_arities(in im, seconds(ex))
  check_exposed(in d.name, ex, private_sorts(seconds(ex), seconds(im)))

// the declarations and sorts that module d keeps private, which are all of a module without an export section
procedure private_of(in d: Mod, out hidden: Set[Name], hidden_sorts: List[Name]) :=
  let ex := exported_cmds(d), im := implemented_cmds(d)
  hidden := Set(for x in private_names(ex, im)), hidden_sorts := private_sorts(ex, im)

// the commands of docs of the module m with qualified names, at their declarations
function placed_cmds(m: Path, docs: List[At[Cmd]]): List[(Pos, Cmd)] :=
  List(for c in docs if is_parsed(c) yield (c.pos, qualify(m, c.that)))

function exported_cmds(d: Mod): List[Cmd] :=
  List(for c in commands_of(d.exported) yield qualify(d.name, c))

function implemented_cmds(d: Mod): List[Cmd] :=
  List(for c in commands_of(d.implemented) yield qualify(d.name, c))

// the commands of the program with qualified names, where each package and each program is checked once, after the
// modules it imports
procedure check_program(
  in  source: Source,
  out q: Prog
) raises TypeError, InternalError :=
  var errors: List[TypeError]
  check_all(in source, no_tests, out q, errors)
  for e in take(1, errors) do
    raise e
  end

procedure check_all(
  in  source: Source,
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError :=
  var checks := no_checks()
  check_source(in source, empty(), false, generate, out q, errors, ref checks)

data Checks :=
  case Checks(packages: Map[Path, CheckedPackage])

// the checked commands of a package, by their modules, and the signature that it shows to the packages after it
data CheckedPackage :=
  case CheckedPackage(cmds: List[(Path, At[Cmd])], shown: Sig)

function no_checks(): Checks :=
  Checks(empty())

procedure check_cached(
  in  source: Source,
      unparsed: Set[Id],
      partial: Bool,
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError],
  ref checks: Checks
) raises InternalError :=
  check_source(in source, unparsed, partial, generate, out q, errors, ref checks)

procedure check_partial(
  in  source: Source,
      unparsed: Set[Id],
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError]
) raises InternalError :=
  var checks := no_checks()
  check_source(in source, unparsed, true, generate, out q, errors, ref checks)

function is_seen(c: Checked, m: Path, d: Name): Bool :=
  is_visible(start(m, c.table) with hidden := c.hidden, d)

function no_tests(c: Checked): List[(Pos, (Path, Cmd))] :=
  List()

// the checked program of source, where partial tells whether it has parts that do not parse, which only then are looked for
procedure check_source(
  in  source: Source,
      unparsed: Set[Id],
      partial: Bool,
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out q: Prog,
      errors: List[TypeError],
  ref checks: Checks
) raises InternalError :=
  var sig: Sig := empty(), imports: List[(Path, List[Path])] := List(), cmds: List[(Path, At[Cmd])] := List(), checked: List[(Path, At[Cmd])], shown: Sig, found: List[TypeError], loose: List[TypeError] := List(), found_loose: List[TypeError], placed: List[At[Cmd]], lines: List[(Path, At[Path])], raised := false
  errors := List()
  let own := module_dir(source.main)
  // a package after one with errors is checked against its signature, whose definitions with errors are error nodes, and
  // none after one whose check raised, which leaves no signature; only packages checked after no errors are cached
  for mods in units(source.mods, source.packages) if not raised do
    let id := package_of(mods)
    match get(id, checks.packages)
      case Some(done) if id != own =>
        sig := union(sig, done.shown), imports := imports ++ List(for d in mods yield (d.name, seen_modules(d, source.packages))), cmds := cmds ++ done.cmds

      case _ =>
        try
          check_package(in mods, source.packages, sig, imports, unparsed, partial, exists(mods, lambda d => d.name == source.main), generate, out checked, shown, found, found_loose)
          if id != own and errors == List() and found == List() and found_loose == List() and not partial then
            checks := checks with packages := put(id, CheckedPackage(checked, shown), checks.packages)
          end
          sig := union(sig, shown), imports := imports ++ List(for d in mods yield (d.name, seen_modules(d, source.packages))), cmds := cmds ++ checked, errors := errors ++ found, loose := loose ++ found_loose
        catch
          case e =>
            cmds := cmds ++ List(for d in mods for (m, c) in written_of(d.name, d.exported ++ d.implemented) yield (m, unchecked(c))), errors := errors ++ List(e), loose := loose ++ List(e), raised := true
        end
    end
  end
  errors := distinct(List(for e in errors yield in_main(source.main, e)))
  with_errors(in source.main, cmds ++ builtins_of(source), List(for d in source.mods for i in d.imports yield (d.name, i)), distinct(List(for e in loose yield in_main(source.main, e))), out placed, lines)
  q := Prog(take(size(cmds), placed), drop(size(cmds), placed), lines, source.main)

// the package of the modules mods of one package, by the directory of the first
function package_of(mods: List[Mod]): Path :=
  match mods
    case List(d; _) =>
      module_dir(d.name)
    case List() =>
      List()
  end

// a command of a package whose check failed, as written, which is an error node without errors of its own, so that no run
// takes it for checked code (rejected of ulang/syntax/syntax.u), while the error of the package stands on its command
function unchecked(cmd: At[Cmd]): At[Cmd] :=
  match cmd
    case AOk(pos, span, that) =>
      AErr(pos, span, that, List())
    case _ =>
      cmd
  end

// the commands of the builtin sections of source
function builtins_of(source: Source): List[(Path, At[Cmd])] :=
  List(for d in source.mods for c in written_of(d.name, d.builtins) yield c)

// cmds, each with the errors whose position it contains, as the last command of their module that starts at or before it,
// and imports, the imports of each module, each with the errors at its line, which no command contains
procedure with_errors(
  in  main: Path,
      cmds: List[(Path, At[Cmd])],
      imports: List[(Path, At[Path])],
      errors: List[TypeError],
  out placed: List[At[Cmd]],
      lines: List[(Path, At[Path])]
) raises InternalError :=
  var on: Map[Int, List[Diagnostic]] := empty(), at_import: Map[Int, List[Diagnostic]] := empty()
  let indexed := zip(range(0, size(cmds)), cmds), numbered_imports := zip(range(0, size(imports)), imports)
  for e in errors do
    let m := error_module(main, e), pos := error_pos(e)
    // before the commands of its module, which a generated command at Pos(0, 0) would take
    match find(numbered_imports, lambda (_, (n, i)) => n == m and i.pos == pos and pos != Pos(0, 0))
      case Some((i, _)) =>
        at_import := put(i, value_or(get(i, at_import), List()) ++ List(type_diagnostic(e) with module := Some(m)), at_import)

      case None =>
        match container(indexed, m, pos, None)
          case Some(i) =>
            on := put(i, value_or(get(i, on), List()) ++ List(type_diagnostic(e)), on)
          case None =>
            raise Unexpected("an error outside the commands and imports of its module, " ++ show(e))
        end
    end
  end
  placed := List(for (i, (_, cmd)) in indexed yield with_diagnostics(cmd, value_or(get(i, on), List())))
  lines := List(for (i, (m, line)) in numbered_imports yield (m, with_import_errors(line, value_or(get(i, at_import), List()))))

// the import line with the errors ds, if any
function with_import_errors(line: At[Path], ds: List[Diagnostic]): At[Path] :=
  match (line, ds)
    case (_, List()) =>
      line

    case (AOk(pos, span, that), _) =>
      AErr(pos, span, that, ds)

    case (AErr(pos, span, that, errors), _) =>
      AErr(pos, span, that, errors ++ ds)

    // the parser places every import that it reads
    case (AUnparsed(_, _, _, _), _) =>
      line
  end

// the module of the error e, main for one without a module, and for one without a position, of code that the parser did
// not read, at Pos(0, 0) as its commands
function error_module(main: Path, e: TypeError): Path :=
  match e
    case Located(Some(m), _, _) =>
      m
    case _ =>
      main
  end

function error_pos(e: TypeError): Pos :=
  match e
    case Located(_, pos, _) =>
      pos
    case _ =>
      Pos(0, 0)
  end

// the index of the last command of module m in cmds that starts at or before pos, after found
function container(cmds: List[(Int, (Path, At[Cmd]))], m: Path, pos: Pos, found: Option[(Int, Pos)]): Option[Int] :=
  match cmds
    case List() =>
      map_option(found, first)

    case List((i, (n, cmd)); rest) =>
      if n == m and cmd.pos <= pos and forall(found, lambda (_, p) => p <= cmd.pos) then
        container(rest, m, pos, Some((i, cmd.pos)))
      else
        container(rest, m, pos, found)
  end

// cmd with the errors ds, if there are any
function with_diagnostics(cmd: At[Cmd], ds: List[Diagnostic]): At[Cmd] :=
  match (cmd, ds)
    case (_, List()) =>
      cmd

    case (AOk(pos, span, that), _) =>
      AErr(pos, span, that, ds)

    case (AErr(pos, span, that, errors), _) =>
      AErr(pos, span, that, errors ++ ds)

    // without_unparsed of ulang/parse/parse.u leaves no command that does not parse to the checker
    case (AUnparsed(_, _, _, _), _) =>
      cmd
  end

// the errors that checking found in q, of its imports, then of its commands and their parts, by position within each
// command, without those of parsing, which are the source's
function diagnostics(q: Prog): List[Diagnostic] :=
  distinct(List(for (_, line) in q.imports for d in import_errors(line) yield in_main_module(q.main, d)) ++ List(for cmd in q.cmds ++ q.builtins for d in command_diagnostics(q.main, cmd) yield d))

function import_errors(line: At[Path]): List[Diagnostic] :=
  match line
    case AErr(_, _, _, errors) =>
      errors
    case _ =>
      List()
  end

function code_free_diagnostics(q: Prog): List[Diagnostic] :=
  List(for cmd in q.cmds for d in placed_diagnostics(q.main, cmd, code_free_errors(cmd)) yield d)

// the errors of cmd by position
function command_diagnostics(main: Path, cmd: At[Cmd]): List[Diagnostic] :=
  placed_diagnostics(main, cmd, cmd_errors(cmd))

// the errors of cmd by position, where an error of a part without a module is of the module of cmd, and one of main has
// none
function placed_diagnostics(main: Path, cmd: At[Cmd], errors: List[Diagnostic]): List[Diagnostic] :=
  let m := if is_parsed(cmd) then cmd_module(cmd.that) else None in
  let ds := List(for d in errors if d.kind != ParseKind yield in_main_module(main, d with module := or_else(d.module, m))) in
  List(for (_, _, d) in sort(List(for (i, d) in zip(range(0, size(ds)), ds) yield (d.pos, i, d))) yield d)

function in_main_module(main: Path, d: Diagnostic): Diagnostic :=
  if d.module == Some(main) then d with module := None else d

function has_errors(q: Prog): Bool :=
  exists(diagnostics(q), lambda d => d.kind != ProofKind)

// whether e stops the definitions after the declarations, as all errors do but the uses of declarations that do not parse,
// which have no type that could mislead the checking of the definitions
function is_blocking(e: TypeError): Bool :=
  match e
    case Located(_, _, error) =>
      is_blocking(error)

    case UnparsedDeclaration(_) =>
      false

    case _ =>
      true
  end

// e as the use of a declaration of unparsed that does not parse, if it is an unknown name of one
function unparsed_use(unparsed: Set[Id], e: TypeError): TypeError :=
  match e
    case Located(m, pos, error) =>
      Located(m, pos, unparsed_use(unparsed, error))

    case Hinted(UnknownVariable(name), _) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownVariable(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownSort(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownConstructor(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case UnknownProcedure(name) if contains(name.base, unparsed) =>
      UnparsedDeclaration(name)

    case _ =>
      e
  end

// e without the module if it is the main one
function in_main(main: Path, e: TypeError): TypeError :=
  match e
    case Located(Some(m), pos, error) if m == main =>
      Located(None, pos, error)
    case _ =>
      e
  end

// the modules in the order of mods, where the members of a package, which follow each other, are checked together, and
// a module of no package, which only the fixtures of tests make, on its own
function units(mods: List[Mod], packages: List[Package]): List[List[Mod]] :=
  match mods
    case List() =>
      List()

    case List(d; rest) =>
      match find(packages, lambda p => contains(d.name, p.members))
        case Some(p) =>
          let unit := take_members(mods, p.members) in
          List(unit; units(drop(size(unit), mods), packages))

        case None =>
          List(List(d); units(rest, packages))
      end
  end

function take_members(mods: List[Mod], members: List[Path]): List[Mod] :=
  match mods
    case List(d; rest) if contains(d.name, members) =>
      List(d; take_members(rest, members))
    case _ =>
      List()
  end

// the commands of the members mods of a package, or of a program alone, and the signature that they show their importers,
// checked together after the declarations before of the modules that imports lists, where the declarations that other
// modules keep private are unknown, since before has only their signatures, and those that members keep private are hidden
// from the other members, and where the definitions are checked only after declarations without errors, whose uses would
// only repeat them
procedure check_package(
  in  mods: List[Mod],
      packages: List[Package],
      before: Sig,
      imports: List[(Path, List[Path])],
      unparsed: Set[Id],
      partial: Bool,
      judged: Bool,
      generate: Checked -> List[(Pos, (Path, Cmd))],
  out cmds: List[(Path, At[Cmd])],
      shown: Sig,
      errors: List[TypeError],
      loose: List[TypeError]
) :=
  let own := List(for d in mods yield (d.name, seen_modules(d, packages))), members := List(for d in mods yield d.name), placed := List(for d in mods for p in decls_of(d) yield p)
  var s: State, decls: List[(Path, Cmd)], defined: List[(Path, At[Cmd])], tested: List[(Path, At[Cmd])] := List(), enumerated: List[(Path, At[Cmd])] := List(), hidden: Set[Name] := empty(), hidden_sorts: List[Name] := List()
  let builtins := List(for d in mods for c in natives(d) yield c)
  var private: Set[Name], private_sorts: List[Name], exceptions: Exceptions
  for d in mods do
    private_of(in d, out private, private_sorts)
    hidden := hidden ++ private, hidden_sorts := hidden_sorts ++ private_sorts
  end
  s := State(before, empty(), 0, first_member(members), List(), visibility(imports ++ own, first_member(members)), List(), empty(), hidden, Set(for x in hidden_sorts), Pos(0, 0), List(), unparsed, partial, List(), empty(), List(), empty(), empty(), empty(), 0, empty(), None, empty(), 0), decls := seconds(placed)
  each_placed(in declare_datas, placed, ref s)
  declare_datas(in builtins, ref s)
  each_placed(in declare_sorts, alias_order(List(for p in placed if alias_names(p) != None), List()), ref s)
  each_placed(in declare_constrs, placed, ref s)
  s := with_sig(s, with_variances(s.sig, List(for n => _ in s.sig.datas if exists(name_module(n), lambda m => contains(m, members)) yield n)))
  each_placed(in declare_pat_aliases, placed, ref s)
  each_placed(in declare_funs, placed, ref s)
  each_placed(in declare_procs, placed, ref s)
  each_placed(in declare_lemmas, placed, ref s)
  declare_funs(in builtins, ref s)
  declare_procs(in builtins, ref s)
  for d in mods do
    try
      check_sections(in d)
    catch
      case e =>
        s := s with errors := s.errors ++ List(located(d.name, Pos(0, 0), e))
    end
  end
  each_placed(in lambda in cs: List[(Path, Cmd)], ref t: State =>
    exported_aliases(in cs, hidden, t)
  end, placed, ref s)
  for d in mods do
    unique_tests(in d, ref s)
  end
  for (p, (m, name)) in List(for (p, (m, cmd)) in placed for name in contract_on_definition(placed, cmd) yield (p, (m, name))) do
    s := s with errors := s.errors ++ List(Located(Some(m), p, ContractOnDefinition(name)))
  end
  let definable := not exists(s.errors, is_blocking)
  if definable then
    placed_commands(in with_contracts(placed_definitions(placed), placed), lambda in checked: List[Cmd] =>
      check_orders(in checked, abstract_types(decls), hidden, hidden_sorts)
    end, out defined, ref s)
  else
    defined := List()
  end
  // the generated tests only of a package without errors, while the examples of each definition that checks are checked
  // with the errors of the others, since a change that breaks a definition may make an example stale, too
  let clean := s.errors == List()
  let generated := if clean then
    generate(Checked(placed, defined, abstract_types(decls), s.sig, s.table, s.hidden))
  else
    List()
  if definable then
    let failed := failed_owners(defined)
    for d in mods do
      examples_placed(in d, ref s)
    end
    example_commands(in List(for d in mods for x in example_tests(d) if not contains(x.owner, failed) yield x), out tested, ref s)
  end
  if clean then
    each_placed(in declare_funs, generated, ref s)
    placed_commands(in generated, lambda in _: List[Cmd] =>
      skip
    end, out enumerated, ref s)
  end
  // without definitions, as after an error of the declarations, the definitions as written have unresolved names, which no
  // run may take for checked code
  let written := List(for d in mods for (m, c) in written_of(d.name, d.exported ++ d.implemented) yield (m, if defined == List() and is_checked(m, c) then unchecked(c) else c))
  cmds := List(for (m, c) in with_definitions(written, defined) for x in with_alias(s.sig, c) yield (m, x)) ++ tested ++ enumerated, shown := exported(restrict(s.sig, members), hidden, Set(for x in hidden_sorts)), errors := s.errors, loose := List(for (i, e) in zip(range(0, size(s.errors)), s.errors) if not contains(i, s.taken) yield e)
  exceptions := raises_errors(List(for (_, c) in defined ++ tested if cmd_errors(c) == List() yield c.that), s.sig, hidden, List(for b in s.bounds))
  let solving := s with sub := empty(), chosen := empty(), solved := Some(exceptions.solved)
  errors := errors ++ exceptions.errors, cmds := List(for (m, c) in cmds yield (m, map_at(c, lambda cmd => with_inferred(if cmd_errors(c) == List() then zonk_cmd(solving, cmd) else cmd, exceptions.inferred))))
  loose := loose ++ drop(size(s.errors), errors)
  // only for a source that parses, since an import may be used by what does not parse, and a module may have no command
  if judged and not partial and errors == List() then
    let unused := unused_imports(mods, packages, cmds, s.aliased ++ alias_uses(s.sig, members))
    errors := unused, loose := loose ++ unused
  end

// the imports of the modules mods of a package of which their checked commands cmds use nothing, by the modules of
// their resolved names and of the aliases that they use, which aliased pairs with the modules that use them; judged only
// for the package of the loaded file, whose members have their tests, which may need an import alone, and only for the
// imports that the parser read, not those of the fixtures of tests at Pos(0, 0)
function unused_imports(mods: List[Mod], packages: List[Package], cmds: List[(Path, At[Cmd])], aliased: Set[(Path, Path)]): List[TypeError] :=
  List(for d in mods if d.imports != List() for e in unused_of(d, packages, uses_of(d.name, cmds, aliased)) yield e)

// the imports of d of which the modules used do not use a member
function unused_of(d: Mod, packages: List[Package], used: Set[Path]): List[TypeError] :=
  List(for i in d.imports if i.pos != Pos(0, 0) and not uses_package(used, i.that, packages) yield Located(Some(d.name), i.pos, UnusedImport(i.that)))

// the modules that the resolved patterns of the pattern aliases of the members use, paired with the module of each alias,
// since an alias with _ has no definition, whose walk would find them
function alias_uses(sig: Sig, members: List[Path]): Set[(Path, Path)] :=
  Set(for n => alias in sig.pat_aliases for d in name_module(n) if contains(d, members) for m in pat_modules(alias.pat) yield (d, m))

function uses_of(m: Path, cmds: List[(Path, At[Cmd])], aliased: Set[(Path, Path)]): Set[Path] :=
  Set(for (n, c) in cmds if n == m for x in used_modules(c.that) yield x) ++ Set(for (n, a) in aliased if n == m yield a)

function uses_package(used: Set[Path], p: Path, packages: List[Package]): Bool :=
  exists(packages, lambda k => k.id == p and exists(k.members, lambda x => contains(x, used)))

// cmd with the raises inferred of it if it is a private procedure without raises, which the checked program keeps
function with_inferred(cmd: Cmd, inferred: Map[Name, List[Type]]): Cmd :=
  match cmd
    case CProc(name, params, ins, outs, refs, List(), spec, stmt) =>
      CProc(name, params, ins, outs, refs, value_or(get(name, inferred), List()), spec, stmt)
    case _ =>
      cmd
  end

// an example of the function or procedure owner, translated into the test cmd, at the position pos in module, where an
// example of the export section is checked as an importer of module sees it
data ExampleTest :=
  case ExampleTest(pos: Pos, module: Path, owner: Name, exported: Bool, cmd: Cmd)

// the examples on definitions in implementation of functions and procedures that export declares, as errors of s
procedure examples_placed(in d: Mod, ref s: State) :=
  let declared := List(for c in d.exported ++ d.builtins for o in example_owner(qualify(d.name, c.that)) yield o)
  for x in example_tests(d) if not x.exported and contains(x.owner, declared) do
    s := s with errors := s.errors ++ List(Located(Some(d.name), x.pos, ExampleOnDefinition(x.owner)))
  end

// the functions and procedures whose definitions have errors, whose examples would be follow-ups of them, also of an
// overload of the same name in its module
function failed_owners(defined: List[(Path, At[Cmd])]): Set[Name] :=
  Set(for (_, c) in defined if is_parsed(c) if cmd_errors(c) != List() for n in example_owner(c.that) yield n)

// the name of a function or procedure, of which examples may be given
function example_owner(cmd: Cmd): Option[Name] :=
  match cmd
    case CFun(name, _, _, _, _, _) =>
      Some(name)

    case CFunSig(name, _, _, _, _) =>
      Some(name)

    case CProc(name, _, _, _, _, _, _, _) =>
      Some(name)

    case CProcSig(name, _, _, _, _, _, _) =>
      Some(name)

    case CNoSpec =>
      None
  end

// the spec of a function or procedure, empty for other commands
function spec_of(cmd: Cmd): Spec :=
  match cmd
    case CFun(_, _, _, _, spec, _) =>
      spec

    case CFunSig(_, _, _, _, spec) =>
      spec

    case CProc(_, _, _, _, _, _, spec, _) =>
      spec

    case CProcSig(_, _, _, _, _, _, spec) =>
      spec

    case CNoSpec =>
      no_spec()
  end

// the tests of the examples of module d, named f.example.N with N from 1 for each base name f in the order of the source,
// which users cannot write
function example_tests(d: Mod): List[ExampleTest] :=
  numbered_examples(d.name, List(for c in d.exported ++ d.builtins yield (true, c.that)) ++ List(for c in d.implemented yield (false, c.that)), empty())

function numbered_examples(m: Path, cmds: List[(Bool, Cmd)], counts: Map[Id, Int]): List[ExampleTest] :=
  match cmds
    case List() =>
      List()

    case List((exported, cmd); more) =>
      match example_owner(qualify(m, cmd))
        case Some(owner) =>
          let n := value_or(get(owner.base, counts), 0), examples := spec_of(cmd).examples in
          List(for (i, x) in zip(range(n + 1, n + 1 + size(examples)), examples) yield example_test(m, x.pos, owner, exported, i, x)) ++ numbered_examples(m, more, put(owner.base, n + size(examples), counts))

        case None =>
          numbered_examples(m, more, counts)
      end
  end

function example_test(m: Path, pos: Pos, owner: Name, exported: Bool, n: Int, x: At[Example]): ExampleTest :=
  ExampleTest(pos, m, owner, exported, CTest(Owned(m, List(owner.base, "example"), show(n)), List(), example_body(pos, x)))

// the body of the test of the example x, which raises the error of a part that does not parse
function example_body(pos: Pos, x: At[Example]): At[Stmt] :=
  match example_error(x)
    case Some(error) =>
      AOk(pos, x.span, SRaise(nowhere(ELit(LStr("the example does not parse: " ++ error.message ++ " at " ++ show(error.pos.line) ++ "." ++ show(error.pos.col)))), THole))
    case None =>
      example_stmt(pos, x.span, x.that)
  end

// the body of the test of the example x, which is checked as written, in the scope of its module, so that its names take
// the declarations that overloading chooses, also another one than the owner, which the convention, an example applies
// its function, rules out; the statement is at the example at pos, where the checks of the exceptions report what its
// assert raises cannot catch, and the other parts that the source does not have are at Pos(0, 0), so that their errors
// are located at the example too
function example_stmt(pos: Pos, span: Span, x: Example): At[Stmt] :=
  match x
    case XHolds(expr) =>
      AOk(pos, span, SAssert(expr))

    case XRaises(expr, pat) =>
      let value := Var(generated_name("value"), THole) in
      AOk(pos, span, SAssertRaises(THole, pat, None, nowhere(block(List(value), List(nowhere(SAssign(List((value, expr)))))))))

    case XCall(proc, ins, outs, refs) =>
      let out_vars := generated_vars("out", size(outs)), ref_vars := generated_vars("ref", size(refs)) in
      AOk(pos, span, block(out_vars ++ ref_vars, initial_refs(ref_vars, firsts(refs)) ++ List(nowhere(SCall(proc, ins, out_vars, ref_vars))) ++ expected_values(out_vars ++ ref_vars, outs ++ seconds(refs))))

    case XCallRaises(proc, ins, blanks, befores, pat) =>
      let out_vars := generated_vars("out", blanks), ref_vars := generated_vars("ref", size(befores)) in
      AOk(pos, span, SAssertRaises(THole, pat, None, nowhere(block(out_vars ++ ref_vars, initial_refs(ref_vars, befores) ++ List(nowhere(SCall(proc, ins, out_vars, ref_vars)))))))
  end

function generated_vars(base: Id, n: Int): List[Var] :=
  List(for i in range(1, n + 1) yield Var(generated_name(base ++ show(i)), THole))

// one assignment per ref, so that the block infers their types
function initial_refs(xs: List[Var], befores: List[At[Expr]]): List[At[Stmt]] :=
  List(for (x, before) in zip(xs, befores) yield nowhere(SAssign(List((x, before)))))

// assert (a, …) == (b, …) of the variables and the expected values, or assert a == b of one, or nothing of none
function expected_values(actual: List[Var], expected: List[At[Expr]]): List[At[Stmt]] :=
  match (actual, expected)
    case (List(), _) =>
      List()

    case (List(a), List(e)) =>
      List(nowhere(SAssert(generated_op("==", List(nowhere(EVar(a)), e)))))

    case _ =>
      List(
        nowhere(SAssert(generated_op("==", List(
          nowhere(ETuple(List(for a in actual yield nowhere(EVar(a))))),
          nowhere(ETuple(expected)))))))
  end

// the tests of the examples, each checked in its module, or as an importer of its module sees it if it is exported, by
// a module of its own, which sees what the module sees and the module itself, with their errors located at the examples
procedure example_commands(
  in  xs: List[ExampleTest],
  out cmds: List[(Path, At[Cmd])],
  ref s: State
) :=
  cmds := List()
  for x in xs do
    var errors: List[Diagnostic]
    let before := size(s.errors), bounds := s.bounds
    var one: List[Cmd] := List(x.cmd)
    let viewer := if x.exported then List("(example)") ++ x.module else x.module
    s := s with table := List((viewer, List(x.module; sees(x.module, s.table))); s.table)
    try
      commands(in List((viewer, x.cmd)), out one, ref s)
    catch
      case e =>
        s := s with errors := s.errors ++ List(e)
    end
    s := without_bounds(placed_errors(s, before, (x.module, x.cmd), x.pos), before, bounds)
    take_errors(in x.pos, before, out errors, ref s)
    cmds := cmds ++ List(for c in one yield (x.module, checked_at(x.pos, span_at(x.pos), c, errors)))
  end

// the type aliases of a package, each after those that it names, since an alias is expanded where it is declared, and
// members name each other's aliases in any order, where aliases that name each other stay in their order
function alias_order(pending: List[(Pos, (Path, Cmd))], done: List[(Pos, (Path, Cmd))]): List[(Pos, (Path, Cmd))] :=
  match find(pending, lambda p => not exists(pending, lambda q => q != p and names_alias(p, q)))
    case Some(p) =>
      alias_order(remove(p, pending), done ++ List(p))
    case None =>
      done ++ pending
  end

// whether the alias p names the alias q, by its name as written
function names_alias(p: (Pos, (Path, Cmd)), q: (Pos, (Path, Cmd))): Bool :=
  match (alias_names(p), alias_names(q))
    case (Some((_, named)), Some((name, _))) =>
      contains(name, named)
    case _ =>
      false
  end

// the name of the type alias of a placed command and the names of the sorts that it names, if it is one
function alias_names(p: (Pos, (Path, Cmd))): Option[(Id, List[Id])] :=
  match p
    case (_, (_, CSort(name, _, typ))) =>
      Some((name.base, List(for n in sorts_in(typ) yield n.base)))
    case _ =>
      None
  end

function first_member(members: List[Path]): Path :=
  match members
    case List(m; _) =>
      m
    case List() =>
      List()
  end

// the commands of module d with qualified names, with the module of each, and their positions
function decls_of(d: Mod): List[(Pos, (Path, Cmd))] :=
  List(for c in placed_of(d) yield (c.pos, (d.name, qualify(d.name, c.that))))

// the contracts of the signatures of procedures of placed, by name and arity
function declared_contracts(placed: List[(Pos, (Path, Cmd))]): Map[(Name, Int), Spec] :=
  Map(for (_, (_, cmd)) in placed for (key, spec) in signature_contract(cmd) yield key => spec)

function signature_contract(cmd: Cmd): Option[((Name, Int), Spec)] :=
  match cmd
    case CProcSig(name, _, ins, outs, refs, _, spec) =>
      Some(((name, size(ins) + size(outs) + size(refs)), spec))
    case _ =>
      None
  end

// the definitions with the contracts of their signatures in export, which they do not repeat
function with_contracts(defined: List[(Pos, (Path, Cmd))], placed: List[(Pos, (Path, Cmd))]): List[(Pos, (Path, Cmd))] :=
  let declared := declared_contracts(placed) in
  List(for (p, (m, cmd)) in defined yield (p, (m, contracted(declared, cmd))))

function contracted(declared: Map[(Name, Int), Spec], cmd: Cmd): Cmd :=
  match cmd
    case CProc(name, params, ins, outs, refs, raised, spec, stmt) =>
      match get((name, size(ins) + size(outs) + size(refs)), declared)
        case Some(sig) =>
          CProc(name, params, ins, outs, refs, raised, Spec(sig.pre, sig.post, spec.examples), stmt)
        case None =>
          cmd
      end

    case _ =>
      cmd
  end

// the name of a definition of a procedure that export declares, if it has a contract, which belongs to the signature
function contract_on_definition(placed: List[(Pos, (Path, Cmd))], cmd: Cmd): Option[Name] :=
  match cmd
    case CProc(name, _, ins, outs, refs, _, spec, _) if spec.pre != List() or spec.post != None =>
      if get((name, size(ins) + size(outs) + size(refs)), declared_contracts(placed)) != None then
        Some(name)
      else
        None

    case _ =>
      None
  end

// the definitions to check, where a pattern alias is the function that builds its values, if it has one
function placed_definitions(placed: List[(Pos, (Path, Cmd))]): List[(Pos, (Path, Cmd))] :=
  List(for (p, (m, cmd)) in placed for c in definition_of(cmd) if is_definition((m, c)) yield (p, (m, c)))

function definition_of(cmd: Cmd): List[Cmd] :=
  match cmd
    case CPatAlias(name, params, formals, typ, pat) =>
      match pattern_expr(pat)
        case Some(body) =>
          List(CFun(name, params, formals, typ, no_spec(), body))
        case None =>
          List()
      end

    case _ =>
      List(cmd)
  end

// the declarations of a phase, one by one, where an error is located at the declaration that raises it
procedure each_placed(
  in  phase: (in List[(Path, Cmd)], ref State) raises TypeError, InternalError,
      placed: List[(Pos, (Path, Cmd))],
  ref s: State
) :=
  match placed
    case List() =>
      skip

    case List((p, d); rest) =>
      let before := size(s.errors)
      try
        phase(in List(d), ref s)
      catch
        case e =>
          s := s with errors := s.errors ++ List(e)
      end
      s := placed_errors(s, before, d, p)
      each_placed(in phase, rest, ref s)
  end

// the commands of the definitions, checked one by one and then by after, each at its declaration, where an error is located
// at the definition that raises it, which stays as written if checking it raises
// s with the bounds as before a command if it reported errors after the first before, since the raises pass skips such a
// command, and so its bounds
function without_bounds(s: State, before: Int, bounds: Buffer[Bound]): State :=
  if size(s.errors) > before then s with bounds := bounds else s

procedure placed_commands(
  in  placed: List[(Pos, (Path, Cmd))],
      after: (in List[Cmd]) raises TypeError,
  out cmds: List[(Path, At[Cmd])],
  ref s: State
) :=
  match placed
    case List() =>
      cmds := List()

    case List((p, d); more) =>
      let before := size(s.errors), bounds := s.bounds
      var one: List[Cmd] := List(second(d)), rest: List[(Path, At[Cmd])], errors: List[Diagnostic]
      try
        commands(in List(d), out one, ref s)
        if size(s.errors) == before then
          after(in one)
        end
      catch
        case e =>
          s := s with errors := s.errors ++ List(e)
      end
      s := without_bounds(placed_errors(s, before, d, p), before, bounds)
      take_errors(in p, before, out errors, ref s)
      placed_commands(in more, after, out rest, ref s)
      cmds := List(for c in one yield (first(d), checked_at(p, span_at(p), c, errors))) ++ rest
  end

// the commands of the export and implementation sections of the modules, each at its declaration, with the checked
// definitions in place of those that placed_definitions gives, in their order, as written where they are not checked
// the command cmd, where a pattern alias has the pattern that checking resolved, and the function of an alias, which its
// definition replaced, has the alias after it
function with_alias(sig: Sig, cmd: At[Cmd]): List[At[Cmd]] :=
  match cmd.that
    case CPatAlias(name, params, formals, _, _) =>
      match pat_alias_of(sig, name)
        case Some(alias) =>
          List(
            cmd with that := CPatAlias(name, params, retyped(formals, alias.formals), alias.typ, alias.pat))

        case None =>
          List(cmd)
      end

    case CFun(name, params, formals, _, _, _) =>
      match pat_alias_of(sig, name)
        case Some(alias) =>
          List(
            cmd,
            AOk(cmd.pos, cmd.span, CPatAlias(name, params, retyped(formals, alias.formals), alias.typ, alias.pat)))

        case None =>
          List(cmd)
      end

    case _ =>
      List(cmd)
  end

function with_definitions(written: List[(Path, At[Cmd])], defined: List[(Path, At[Cmd])]): List[(Path, At[Cmd])] :=
  match (written, defined)
    case (List((m, cmd); rest), List((n, d); more)) if is_checked(m, cmd) =>
      List((n, d with span := cmd.span); with_definitions(rest, more))

    case (List(c; rest), _) =>
      List(c; with_definitions(rest, defined))

    case (List(), _) =>
      List()
  end

// whether placed_definitions gives a definition of cmd of module m
function is_checked(m: Path, cmd: At[Cmd]): Bool :=
  match cmd
    case AOk(_, _, that) =>
      is_definition((m, that)) and definition_of(that) != List()

    case AErr(_, _, that, _) =>
      is_definition((m, that)) and definition_of(that) != List()

    case AUnparsed(_, _, _, _) =>
      false
  end

// the commands of docs of the module m with qualified names, at their declarations
function written_of(m: Path, docs: List[At[Cmd]]): List[(Path, At[Cmd])] :=
  List(for c in docs for x in qualified_at(m, c) yield (m, x))

// without_unparsed of ulang/parse/parse.u leaves no command that does not parse to the checker
function qualified_at(m: Path, cmd: At[Cmd]): Option[At[Cmd]] :=
  match cmd
    case AOk(pos, span, that) =>
      Some(AOk(pos, span, qualify(m, that)))

    case AErr(pos, span, that, errors) =>
      Some(AErr(pos, span, qualify(m, that), errors))

    case AUnparsed(_, _, _, _) =>
      None
  end

// s with the errors after the first before located at the declaration d at position p, which raised or reported them
function placed_errors(s: State, before: Int, d: (Path, Cmd), p: Pos): State :=
  s with errors := take(before, s.errors) ++ List(for e in drop(before, s.errors) yield located(first(d), p, e))

// the error e of a declaration of module m at position p, if the parser read it
function located(m: Path, p: Pos, e: TypeError): TypeError :=
  match e
    case Located(None, q, error) =>
      Located(Some(m), q, error)
    case _ =>
      if p == Pos(0, 0) then e else Located(Some(m), p, e)
  end

// the type of expr without a program
procedure type_of(in expr: At[Expr], out t: Type) :=
  var s := start(List("main"), List()), u: Type
  infer(in List(), expr, out _, u, ref s)
  settle(ref s)
  reported(in s)
  t := zonk_type(s.sub, u)

// lambda xs => body, at Pos(0, 0), as code that the parser did not read
function lambda_at(xs: List[Var], body: At[Expr]): At[Expr] :=
  nowhere(lambda_of(Pos(0, 0), span_at(Pos(0, 0)), xs, body))

// let id := lambda x => x in (id(1), id(arg)), whose id is not generalized
function let_id(arg: At[Expr]): At[Expr] :=
  nowhere(ELet(List(
    (pat_var("id"), lambda_at(List(Var(unqualified("x"), THole)), expr_var("x")))), nowhere(ETuple(List(expr_app("id", List(expr_int(1))), expr_app("id", List(arg)))))))

test inference() :=
  var t: Type
  type_of(in expr_app("<", List(expr_int(1), expr_int(2))), out t)
  assert t == TBool()
  type_of(in let_id(expr_int(2)), out t)
  assert t == TTuple(List(TInt(), TInt()))
  assert raises Mismatch(TInt(), TBool(), "argument 1 of the call") do
    type_of(in let_id(nowhere(ELit(LBool(true)))), out t)
  end
  assert raises InfiniteType(_, _) do
    type_of(in lambda_at(List(Var(unqualified("f"), THole)), expr_app("f", List(expr_var("f")))), out t)
  end
  assert raises Mismatch(_, _, _) do
    type_of(in expr_app("<", List(expr_int(1), nowhere(ELit(LBool(true))))), out t)
  end
  assert raises UnknownVariable(Name(List(), "x")) do
    type_of(in expr_app("x", List()), out t)
  end

// a case of a match at Pos(0, 0), without a doc
function case_at[A](pat: At[Pat], body: A): At[Branch[A]] :=
  nowhere(Branch(pat, None, body))

test elaboration() :=
  var q: Prog
  check_program(in with_lists(List(
    CTest(unqualified("r"), List(), nowhere(block(List(Var(unqualified("n"), THole)), List(
      nowhere(SAssign(List(
        (Var(unqualified("n"), THole), expr_app("len", List(expr_app("Cons", List(expr_int(1), expr_var("Nil"))))))))))))))), out q)
  match definitions(q)
    case List(
      _,
      CFun(_, _, _, _, _, AOk(_, _, EMatch(_, List(AOk(_, _, Branch(pat, _, _)); _)))),
      CTest(_, List(), AOk(_, _, SBlock(_, List(AOk(_, _, SAssign(List((_, AOk(_, _, ECall(_, _, _, typ, _))))))))))) =>
      assert pat.that == PNil()
      assert typ == TFun(List(TList(TInt())), TInt())

    case _ =>
      assert false
  end

test coverage() :=
  assert raises NotExhaustive(PCons(AOk(_, _, PWild), AOk(_, _, PWild))) do
    check_program(in with_lists(List(
      CFun(unqualified("f"), List(), unplaced_vars(List(Var(unqualified("xs"), type_plain_list(TInt())))), TInt(), no_spec(), nowhere(EMatch(expr_var("xs"), List(case_at(pat_var("Nil"), expr_int(0)))))))), out _)
  end
  assert raises Unreachable(PVar(Var(Name(List(), "Nil"), THole))) do
    check_program(in with_lists(List(
      CFun(unqualified("f"), List(), unplaced_vars(List(Var(unqualified("xs"), type_plain_list(TInt())))), TInt(), no_spec(), nowhere(EMatch(expr_var("xs"), List(
        case_at(nowhere(PWild), expr_int(0)),
        case_at(pat_var("Nil"), expr_int(1)))))))), out _)
  end

test statements() :=
  assert raises NotAssignable(Name(List(), "n")) do
    check_program(in program_of(List(
      CProc(unqualified("inc"), List(), List(), List(), unplaced_vars(List(Var(unqualified("k"), TInt()))), List(), no_spec(), nowhere(block(List(), List(
        nowhere(SAssign(List(
          (Var(unqualified("k"), THole), expr_app("+", List(expr_var("k"), expr_int(1))))))))))),
      CProc(unqualified("p"), List(), unplaced_vars(List(Var(unqualified("n"), TInt()))), List(), List(), List(), no_spec(), nowhere(block(List(), List(
        nowhere(SCall(unqualified("inc"), List(), List(), List(Var(unqualified("n"), THole)))))))))), out _)
  end
  assert raises UnknownException(TList(_)) do
    check_program(in with_lists(List(
      CTest(unqualified("t"), List(), nowhere(block(List(), List(nowhere(SRaise(expr_var("Nil"), THole)))))))), out _)
  end

function tsort(n: Id): Type :=
  TSort(unqualified(n), List())

function var_of(n: Id, t: Type): Var :=
  Var(unqualified(n), t)

function fun_cmd(n: Id, xs: List[Var], r: Type, b: At[Expr]): Cmd :=
  CFun(unqualified(n), List(), unplaced_vars(xs), r, no_spec(), b)

function constr_at(n: Id, fields: List[Field]): At[Constr] :=
  nowhere(Constr(unqualified(n), fields))

// the modules bag and box, which both export a function size, a constructor Leaf, a procedure fill, and a field x,
// and that the program imports
function bags(): List[Mod] :=
  List(
    sectioned(List("bag"), List(
      CData(unqualified("Bag"), List(), List(
        constr_at("Bag", List(Field("n", TInt()))),
        constr_at("Leaf", List(Field("n", TInt()))))),
      CData(unqualified("Pt"), List(), List(constr_at("Pt", List(Field("x", TInt()))))),
      fun_cmd("size", List(var_of("b", tsort("Bag"))), TInt(), expr_int(1)),
      fun_cmd("compare", List(var_of("a", tsort("Bag")), var_of("b", tsort("Bag"))), TInt(), expr_int(0)),
      CProc(unqualified("fill"), List(), List(), unplaced_vars(List(var_of("b", tsort("Bag")))), List(), List(), no_spec(), nowhere(SAssign(List((var_of("b", THole), expr_app("Bag", List(expr_int(0)))))))))),
    sectioned(List("box"), List(
      CData(unqualified("Box"), List(), List(
        constr_at("Box", List(Field("s", TStr()))),
        constr_at("Leaf", List(Field("s", TStr()))))),
      CData(unqualified("Qt"), List(), List(constr_at("Qt", List(Field("x", TStr()))))),
      fun_cmd("size", List(var_of("b", tsort("Box"))), TInt(), expr_int(2)),
      CProc(unqualified("fill"), List(), List(), unplaced_vars(List(var_of("b", tsort("Box")))), List(), List(), no_spec(), nowhere(SAssign(List((var_of("b", THole), expr_app("Box", List(nowhere(ELit(LStr("")))))))))))))

// the module of cmds with sections, as the parser gives it: the datatypes and the signatures of the definitions exported,
// and the definitions implemented
function sectioned(name: Path, cmds: List[Cmd]): Mod :=
  Mod(name, List(), unplaced(List(for c in cmds yield signature_of(c))), List(), unplaced(List(for c in cmds if signature_of(c) != c)), List())

function signature_of(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, _, _) =>
      CFunSig(name, params, formals, typ, no_spec())

    case CProc(name, params, ins, outs, refs, raised, _, _) =>
      CProcSig(name, params, ins, outs, refs, raised, no_spec())

    case _ =>
      cmd
  end

// the program of the commands cmds of the module main, which imports bag and box, each a package of its own
function with_bags(cmds: List[Cmd]): Source :=
  Source(List(natives_prelude(); bags()) ++ List(
    Mod(List("main"), List(nowhere(List("bag")), nowhere(List("box"))), List(), List(), unplaced(cmds), List())), List(
    Package(List("prelude"), List(library_module("prelude"))),
    Package(List("bag"), List(List("bag"))),
    Package(List("box"), List(List("box")))), List("main"))

function in_bag(n: Id): Name :=
  Name(List("bag"), n)

function in_box(n: Id): Name :=
  Name(List("box"), n)

// the body of the last function of the checked program with_bags([cmd])
procedure body_of(in cmd: Cmd, out b: Expr) :=
  var q: Prog
  check_program(in with_bags(List(cmd)), out q)
  match reverse(definitions(q))
    case List(CFun(_, _, _, _, _, body); _) =>
      b := body.that
    case _ =>
      assert false
  end

// size(Bag(1)) + size(Box("x"))
test by_arguments() :=
  var b: Expr
  body_of(in fun_cmd("f", List(), TInt(), expr_app("+", List(
    expr_app("size", List(expr_app("Bag", List(expr_int(1))))),
    expr_app("size", List(expr_app("Box", List(nowhere(ELit(LStr("x")))))))))), out b)
  match b
    case EApp(_, List(AOk(_, _, ECall(_, _, m, _, _)), AOk(_, _, ECall(_, _, n, _, _)))) =>
      assert (m, n) == (in_bag("size"), in_box("size"))
    case _ =>
      assert false
  end

// (lambda x => size(x))(Box("x")), where size(x) stays open until the lambda is applied
test deferred() :=
  var b: Expr
  body_of(in fun_cmd("f", List(), TInt(), nowhere(EApp(lambda_at(List(var_of("x", THole)), expr_app("size", List(expr_var("x")))), List(expr_app("Box", List(nowhere(ELit(LStr("x"))))))))), out b)
  match b
    case EApp(AOk(_, _, ELam(_, AOk(_, _, ECall(_, _, name, typ, _)))), _) =>
      assert name == in_box("size")
      assert typ == TFun(List(TSort(in_box("Box"), List())), TInt())

    case _ =>
      assert false
  end

// size as a value of the declared result type Box -> Int
test by_result() :=
  var b: Expr
  body_of(in fun_cmd("f", List(), TFun(List(tsort("Box")), TInt()), expr_var("size")), out b)
  assert b == EName(in_box("size"), TFun(List(TSort(in_box("Box"), List())), TInt()))

// Leaf("s") constructs a Box, and the case Leaf(n) of a Bag is of bag
test constructors() :=
  var b: Expr
  body_of(in fun_cmd("f", List(), tsort("Box"), expr_app("Leaf", List(nowhere(ELit(LStr("s")))))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == in_box("Leaf")
    case _ =>
      assert false
  end
  body_of(in fun_cmd("g", List(var_of("b", tsort("Bag"))), TInt(), nowhere(EMatch(expr_var("b"), List(
    case_at(nowhere(PApp(unqualified("Leaf"), List(pat_var("n")))), expr_var("n")),
    case_at(nowhere(PApp(unqualified("Bag"), List(pat_var("n")))), expr_var("n")))))), out b)
  match b
    case EMatch(_, List(AOk(_, _, Branch(AOk(_, _, PApp(constr, _)), _, _)); _)) =>
      assert constr == in_bag("Leaf")
    case _ =>
      assert false
  end

// call fill(out b) for a local b: Box
test procedures() :=
  var q: Prog
  check_program(in with_bags(List(
    CProc(unqualified("p"), List(), List(), List(), List(), List(), no_spec(), nowhere(block(List(var_of("b", tsort("Box"))), List(
      nowhere(SCall(unqualified("fill"), List(), List(var_of("b", THole)), List())))))))), out q)
  match reverse(definitions(q))
    case List(
      CProc(_, _, _, _, _, _, _, AOk(_, _, SBlock(_, List(AOk(_, _, SCall(proc, _, _, _)))))); _) =>
      assert proc == in_box("fill")

    case _ =>
      assert false
  end

// (lambda p => p.x)(Pt(3)), where the type of p is not known at the access
test fields() :=
  var b: Expr
  body_of(in fun_cmd("f", List(), TInt(), nowhere(EApp(lambda_at(List(var_of("p", THole)), nowhere(EField(expr_var("p"), "x"))), List(expr_app("Pt", List(expr_int(3))))))), out b)
  match b
    case EApp(AOk(_, _, ELam(_, AOk(_, _, ECall(_, _, name, _, _)))), _) =>
      assert name == accessor_name(in_bag("Pt"), "x")
    case _ =>
      assert false
  end

// compare and == are the builtins, also of bags, whose compare of bag the builtin reaches through the type, and of type
// parameters
test builtins() :=
  var b: Expr
  body_of(in fun_cmd("f", List(), TInt(), expr_app("compare", List(expr_app("Bag", List(expr_int(1))), expr_app("Bag", List(expr_int(2)))))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == unqualified("compare")
    case _ =>
      assert false
  end
  body_of(in fun_cmd("g", List(), TBool(), expr_app("==", List(expr_int(1), expr_int(2)))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  body_of(in CFun(unqualified("h"), List("A"), unplaced_vars(List(var_of("x", TParam("A")))), TBool(), no_spec(), expr_app("==", List(expr_var("x"), expr_var("x")))), out b)
  match b
    case ECall(_, _, name, _, _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  body_of(in fun_cmd("k", List(), TBool(), nowhere(ELet(List(
    (pat_var("e"), lambda_at(List(var_of("x", THole)), expr_app("==", List(expr_var("x"), expr_var("x")))))), nowhere(ELit(LBool(true)))))), out b)
  match b
    case ELet(List((_, AOk(_, _, ELam(_, AOk(_, _, ECall(_, _, name, _, _)))))), _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end

// a local variable hides all declarations of its name
test locals() :=
  var b: Expr
  body_of(in fun_cmd("f", List(var_of("size", TInt())), TInt(), expr_var("size")), out b)
  assert b == EName(unqualified("size"), TInt())

test errors() :=
  assert raises NoOverload(Name(List(), "size"), _) do
    body_of(in fun_cmd("f", List(), TInt(), expr_app("size", List(expr_int(1)))), out _)
  end
  assert raises Ambiguous(Name(List(), "size"), List(_, _)) do
    body_of(in fun_cmd("f", List(), TBool(), nowhere(ELet(List(
      (pat_var("h"), lambda_at(List(var_of("x", THole)), expr_app("size", List(expr_var("x")))))), nowhere(ELit(LBool(true)))))), out _)
  end
  assert raises WrongArity(Name(List(), "size"), 2) do
    body_of(in fun_cmd("f", List(), TInt(), expr_app("size", List(expr_int(1), expr_int(2)))), out _)
  end
