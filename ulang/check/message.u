// the messages of type errors

import "ulang/syntax"
import "ulang/format"

export

// the message of e, with the position of the command that raised it, and the module if it is not the main module
function located_message(e: TypeError): Str

// e as a diagnostic, whose code is the constructor of the error, with the types expected and found of a mismatch
function type_diagnostic(e: TypeError): Diagnostic

implementation

function located_message(e: TypeError): Str :=
  match e
    case Located(None, pos, error) =>
      type_message(error) ++ at_pos(pos)

    case Located(Some(m), pos, error) =>
      type_message(error) ++ " in " ++ m ++ at_pos(pos)

    case _ =>
      type_message(e)
  end

function type_diagnostic(e: TypeError): Diagnostic :=
  match e
    case Located(m, pos, error) =>
      Diagnostic(TypeKind, error_code(error), m, pos, type_message(error), type_details(error))
    case _ =>
      Diagnostic(TypeKind, error_code(e), None, Pos(0, 0), type_message(e), type_details(e))
  end

// the constructor of e, as show writes it
function error_code(e: TypeError): Str :=
  let text := show(e) in
  match index_of('(', chars(text))
    case Some(i) =>
      slice(text, 0, i)
    case None =>
      text
  end

function type_details(e: TypeError): List[Str * Str] :=
  match e
    case Mismatch(expected_type, found_type, _) =>
      zip(List("expected", "found"), format_types_apart(List(expected_type, found_type)))

    case CannotUnify(left, right) =>
      zip(List("left", "right"), format_types_apart(List(left, right)))

    case _ =>
      List()
  end

// a candidate of an ambiguous name with its type, if known, which tells overloads of one module apart
function candidate_text(c: Name * Scheme): Str :=
  match c
    case (m, sc) =>
      if sc.typ == THole then
        format_name(m)
      else
        format_name(m) ++ ": " ++ format_type(sc.typ)
  end

function container_message(typ: Type): Str :=
  "the type " ++ format_type(typ) ++ " of the container of a generator is not known there, which an annotation can give"

function sort_module(typ: Type): Str :=
  match typ
    case TSort(Name(Some(m), _), _) =>
      m
    case _ =>
      "its module"
  end

function count_message(owner: Str, unit: Str, k: Int, actual: Int): Str :=
  (if owner == "" then "expected " else owner ++ " expects ") ++ show(k) ++ " " ++ unit ++ ", got " ++ show(actual)

function type_message(e: TypeError): Str :=
  match e
    case UnknownSort(name) =>
      "unknown sort " ++ name.base

    case SortArity(name, expected, actual) =>
      "sort " ++ name.base ++ " expects " ++ show(expected) ++ " arguments, got " ++ show(actual)

    case SortDefined(name) =>
      "sort " ++ name.base ++ " is already defined"

    case MissingType(name) =>
      "missing type for " ++ name.base

    case UndeclaredParams(name, types) =>
      name.base ++ " has undeclared type parameters " ++ format_types(types)

    case CannotUnify(left, right) =>
      "cannot unify " ++ join(" and ", format_types_apart(List(left, right)))

    case Mismatch(expected_type, found_type, what) =>
      match format_types_apart(List(expected_type, found_type))
        case List(expected, found) =>
          "expected " ++ expected ++ " but found " ++ found ++ " in " ++ what
        case _ =>
          "mismatch in " ++ what
      end

    case InfiniteType(meta, typ) =>
      "infinite type " ++ join(" = ", format_types_apart(List(meta, typ)))

    case UnknownVariable(name) =>
      "unknown variable " ++ name.base

    case NoOverload(name, typ) =>
      "no declaration of " ++ name.base ++ " has the type " ++ format_type(typ)

    case WrongArity(name, arity) =>
      name.base ++ " does not take " ++ show(arity) ++ " arguments"

    case AlreadyDefined(name) =>
      name.base ++ " is already defined"

    case Duplicate(what, item) =>
      "duplicate " ++ what ++ " " ++ item

    case Ambiguous(name, candidates) =>
      name.base ++ " is ambiguous: " ++ join(", ", List(for c in candidates yield candidate_text(c)))

    case UnknownField(name) =>
      field_message(split(name.base, '.'))

    case UnknownFieldType(field, typ) =>
      "the type " ++ format_type(typ) ++ " of the value of " ++ field ++ " is not known"

    case UnknownFieldOwner(field) =>
      "the type of the value of " ++ field ++ " is not known there, which an annotation can give"

    case UnknownContainer(typ) =>
      container_message(typ)

    case NoFold(typ, fold) =>
      format_type(typ) ++ " is no container: " ++ sort_module(typ) ++ " declares no " ++ fold

    case CountMismatch(owner, unit, k, actual) =>
      count_message(owner, unit, k, actual)

    case UnknownConstructor(name) =>
      "unknown constructor " ++ name.base

    case NotExhaustive(pat) =>
      "match is not exhaustive, missing " ++ format_pat(pat)

    case Unreachable(pat) =>
      "unreachable case " ++ format_pat(pat)

    case NotAssignable(name) =>
      name.base ++ " is not assignable"

    case UnknownProcedure(name) =>
      "unknown procedure " ++ name.base

    case UnknownException(typ) =>
      "the type " ++ format_type(typ) ++ " of an exception is not fully known"

    case TestParams(test_name) =>
      "test " ++ test_name ++ " takes parameters"

    case ForeignExample(name) =>
      "an example of " ++ name.base ++ " does not apply " ++ name.base

    case ExampleOnDefinition(name) =>
      "the examples of " ++ name.base ++ " belong to its signature in export"

    case Unassigned(name) =>
      name.base ++ " is not assigned on every path"

    case OutputUnassigned(x, proc) =>
      "output " ++ x.base ++ " of " ++ proc.base ++ " is not assigned on every path"

    case MissingDefinition(name) =>
      name.base ++ " is exported but not defined"

    case SignatureMismatch(name) =>
      "the definition of " ++ name.base ++ " differs from its signature"

    case PartlyExported(name) =>
      name.base ++ " is exported, but not with each of its numbers of arguments"

    case PrivateType(name, sort) =>
      "the signature of " ++ name.base ++ " names the private type " ++ sort.base

    case HiddenLocal(name) =>
      name.base ++ " hides a local of the same name"

    case VisibleEquality(sort) =>
      sort.base ++ " declares ==, which only abstract types may"

    case MisshapenHook(_, hook) =>
      hook_message(hook)

    case UnexportedOrder(fun, sort) =>
      fun.base ++ " of the exported type " ++ sort.base ++ " is not exported"

    case AliasVariables(name) =>
      "the variables of the pattern alias " ++ name.base ++ " are not its formals, each once"

    case RaisesVariables(name) =>
      "the pattern of assert raises binds " ++ name.base ++ ", which only _ may stand for"

    case PatternOnly(name) =>
      "the pattern alias " ++ name.base ++ " has _ and builds no value"

    case PrivateConstructor(name, constr) =>
      "the exported pattern alias " ++ name.base ++ " matches the private constructor " ++ constr.base

    case Located(_, _, error) =>
      type_message(error)
  end

function hook_message(hook: Hook): Str :=
  let values := if hook_arity(hook) == 1 then "one value" else "two values" in
  hook_name(hook) ++ " must take " ++ values ++ " T[A, …] of a datatype T of its module, with distinct type parameters, and give " ++ format_type(hook_result(hook))

// the accessor T.f, or the updater T.f:=, of an unknown field f
function field_message(parts: List[Str]): Str :=
  match parts
    case List("", f) =>
      "unknown field " ++ without_update(f)

    case List(t, f) =>
      "unknown field " ++ without_update(f) ++ " of " ++ t

    case _ =>
      "unknown field " ++ join(".", parts)
  end

function without_update(f: Str): Str :=
  if size(f) > 2 and ends_with(f, ":=") then slice(f, 0, size(f) - 2) else f

// the messages of the type errors, one of each kind, as a run of the cases of ulang/test/errors/ gave them
test messages() :=
  assert located_message(Located(None, Pos(1, 1), AliasVariables(Name(Some("ulang/test/errors/pattern-alias-variables"), "Pair")))) == "the variables of the pattern alias Pair are not its formals, each once at 1.1"
  assert located_message(AlreadyDefined(Name(Some("ulang/test/errors/duplicate-signature"), "f"))) == "f is already defined"
  assert located_message(Located(None, Pos(6, 1), Ambiguous(Name(None, "helper"), List(
    (Name(Some("ulang/test/modules/left/left"), "helper"), Scheme(List(), TFun(List(TSort(Name(Some("prelude/prelude"), "Int"), List())), TSort(Name(Some("prelude/prelude"), "Int"), List())))),
    (Name(Some("ulang/test/errors/own-name"), "helper"), Scheme(List(), TFun(List(TSort(Name(Some("prelude/prelude"), "Int"), List())), TSort(Name(Some("prelude/prelude"), "Int"), List())))))))) == "helper is ambiguous: ulang/test/modules/left/left.helper: Int -> Int, ulang/test/errors/own-name.helper: Int -> Int at 6.1"
  assert located_message(Located(None, Pos(1, 1), CannotUnify(TParam("A"), TParam("B")))) == "cannot unify A and B at 1.1"
  assert type_message(Mismatch(TBool(), TInt(), "the condition of if")) == "expected Bool but found Int in the condition of if"
  assert type_diagnostic(Located(Some("m"), Pos(2, 3), Mismatch(TBool(), TInt(), "the guard"))) == Diagnostic(TypeKind, "Mismatch", Some("m"), Pos(2, 3), "expected Bool but found Int in the guard", List(("expected", "Bool"), ("found", "Int")))
  assert located_message(Located(None, Pos(4, 1), CountMismatch("procedure p", "ins", 1, 2))) == "procedure p expects 1 ins, got 2 at 4.1"
  assert located_message(Duplicate("declaration", "a")) == "duplicate declaration a"
  assert located_message(Located(None, Pos(4, 1), HiddenLocal(Name(None, "m")))) == "m hides a local of the same name at 4.1"
  assert located_message(Located(None, Pos(4, 1), MisshapenHook(Name(Some("ulang/test/errors/misshapen-hook"), "show"), HookShow))) == "show must take one value T[A, …] of a datatype T of its module, with distinct type parameters, and give Str at 4.1"
  assert located_message(MissingDefinition(Name(Some("ulang/test/errors/abstract-undefined"), "T"))) == "T is exported but not defined"
  assert located_message(Located(None, Pos(1, 1), MissingType(Name(None, "x")))) == "missing type for x at 1.1"
  assert located_message(Located(None, Pos(1, 1), NoFold(TSort(Name(Some("prelude/prelude"), "Int"), List()), "foldr"))) == "Int is no container: prelude/prelude declares no foldr at 1.1"
  assert located_message(Located(None, Pos(1, 1), NotAssignable(Name(None, "k")))) == "k is not assignable at 1.1"
  assert located_message(Located(None, Pos(1, 1), NotExhaustive(PWild))) == "match is not exhaustive, missing _ at 1.1"
  assert located_message(Located(None, Pos(1, 1), OutputUnassigned(Name(None, "y"), Name(None, "lambda")))) == "output y of lambda is not assigned on every path at 1.1"
  assert located_message(PartlyExported(Name(Some("ulang/test/errors/partly-exported"), "f"))) == "f is exported, but not with each of its numbers of arguments"
  assert located_message(Located(None, Pos(4, 1), PatternOnly(Name(None, "First")))) == "the pattern alias First has _ and builds no value at 4.1"
  assert located_message(Located(None, Pos(7, 1), PrivateConstructor(Name(Some("ulang/test/errors/pattern-alias-abstract"), "Small"), Name(Some("ulang/test/errors/pattern-alias-abstract"), "Box")))) == "the exported pattern alias Small matches the private constructor Box at 7.1"
  assert located_message(PrivateType(Name(Some("ulang/test/errors/private-type"), "f"), Name(Some("ulang/test/errors/private-type"), "Hidden"))) == "the signature of f names the private type Hidden"
  assert located_message(Located(None, Pos(1, 1), RaisesVariables(Name(None, "n")))) == "the pattern of assert raises binds n, which only _ may stand for at 1.1"
  assert located_message(SignatureMismatch(Name(Some("ulang/test/errors/abstract-arity"), "T"))) == "the definition of T differs from its signature"
  assert located_message(Located(None, Pos(1, 1), SortArity(Name(Some("prelude/prelude"), "Int"), 0, 1))) == "sort Int expects 0 arguments, got 1 at 1.1"
  assert located_message(Located(None, Pos(1, 1), TestParams("sorted"))) == "test sorted takes parameters at 1.1"
  assert located_message(Located(None, Pos(2, 3), ForeignExample(Name(Some("m"), "size")))) == "an example of size does not apply size at 2.3"
  assert located_message(Located(None, Pos(2, 3), ExampleOnDefinition(Name(Some("m"), "f")))) == "the examples of f belong to its signature in export at 2.3"
  assert located_message(Located(None, Pos(1, 1), Unassigned(Name(None, "x")))) == "x is not assigned on every path at 1.1"
  assert located_message(Located(None, Pos(15, 1), UnexportedOrder(Name(Some("ulang/test/errors/unexported-order"), "compare"), Name(Some("ulang/test/errors/unexported-order"), "T")))) == "compare of the exported type T is not exported at 15.1"
  assert located_message(Located(None, Pos(1, 1), UnknownConstructor(Name(None, "f")))) == "unknown constructor f at 1.1"
  assert located_message(Located(None, Pos(1, 1), UnknownException(TMeta(2)))) == "the type ?2 of an exception is not fully known at 1.1"
  assert located_message(Located(None, Pos(4, 1), UnknownField(Name(Some("ulang/test/errors/unknown-field"), "Point.z")))) == "unknown field z of Point at 4.1"
  assert located_message(Located(None, Pos(1, 1), UnknownFieldOwner(".x"))) == "the type of the value of .x is not known there, which an annotation can give at 1.1"
  assert located_message(Located(None, Pos(1, 1), UnknownProcedure(Name(None, "r")))) == "unknown procedure r at 1.1"
  assert located_message(Located(None, Pos(1, 1), UnknownSort(Name(None, "A")))) == "unknown sort A at 1.1"
  assert located_message(Located(None, Pos(1, 1), UnknownVariable(Name(None, "y")))) == "unknown variable y at 1.1"
  assert located_message(Located(None, Pos(1, 1), Unreachable(PWild))) == "unreachable case _ at 1.1"
  assert located_message(Located(None, Pos(4, 1), VisibleEquality(Name(Some("ulang/test/errors/visible-equality"), "Pair")))) == "Pair declares ==, which only abstract types may at 4.1"
  assert located_message(Located(None, Pos(7, 1), WrongArity(Name(None, "f"), 3))) == "f does not take 3 arguments at 7.1"
