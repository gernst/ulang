// the exceptions of procedures, after a package is checked: what each part may raise, where a raise of a value of a
// datatype raises its type, a call raises the raises of the procedure, as written, or inferred for a private procedure
// without raises, and a try removes the types that its unguarded handlers cover, while the exceptions of builtins
// (unchecked_exceptions of ulang/syntax/builtins.u) are not counted; a procedure with raises, exported, or without
// formals, an entry of run and compile, raises none that they omit, so that no checked exception escapes an entry unless
// its raises declare it, and a procedure value raises none that its type omits, which the place of its use gives it, where the
// raises of the types of values that inference left unknown are the least that their bounds allow

import "ulang/syntax"

export

// the first error of the exceptions of each of the checked commands cmds of a package, whose private names are hidden, at
// its position in the module of the command, and the raises of the private procedures without raises, as inferred
// and the solutions of the unknowns of raises, the least that their bounds allow, where one without a bound is none
data Exceptions :=
  case Exceptions(errors: List[TypeError], inferred: Map[Name, List[Type]], solved: Map[Int, Set[Name]])

// what a procedure value of the raises sub may raise, a value of the raises sup may raise too, as unify of
// ulang/check/check.u records it at pos of module where one of them is not a set
data Bound :=
  case Bound(module: Id, pos: Pos, sub: Raises, sup: Raises)

function raises_errors(cmds: List[Cmd], sig: Sig, hidden: Set[Name], bounds: List[Bound]): Exceptions

// the datatype of an exception, where the checker ensures that written raises are exceptions
function exception_name(t: Type): Option[Name]

implementation

// the datatypes that a part may raise, each at its first raise or call, the errors of the parts inside it, and the
// exceptions that its procedure values give the unknowns of their types
data Flow :=
  case Flow(raised: Map[Name, Pos], errors: List[(Pos, TypeError)], lower: Map[Int, Map[Name, Origin]])

// where an exception entered the solution of an unknown: at the use of the procedure name as a value or a raise in a
// lambda, or at a bound, which names none
data Origin :=
  case Origin(module: Option[Id], pos: Pos, name: Option[Name])

// the raises of the procedures of the package, written or inferred so far, the types of the locals in scope, the
// solutions of the unknowns so far, and the module of the command
data Scope :=
  case Scope(sig: Sig, procs: Map[Name, Set[Name]], locals: Map[Name, Type], solved: Map[Int, Map[Name, Origin]], module: Option[Id])

function raises_errors(cmds: List[Cmd], sig: Sig, hidden: Set[Name], bounds: List[Bound]): Exceptions :=
  let inferred := inferred_procs(cmds, hidden) in
  let scope := infer_procs(cmds, bounds, Scope(sig, written_procs(cmds, inferred), empty(), empty(), None), inferred) in
  let errors := List(for cmd in cmds for (pos, e) in take(1, sort(cmd_errors(in_module(scope, cmd), cmd, inferred))) yield Located(cmd_module(cmd), pos, e)) in
  Exceptions(errors ++ distinct(List(for b in bounds for e in exceeded(scope.solved, b) yield e)), Map(for name in inferred yield name => List(for t in proc_raises(scope, name) yield TSort(t, List()))), Map(for id => _ in scope.solved yield id => raised_set(scope.solved, RUnknown(id))))

function in_module(scope: Scope, cmd: Cmd): Scope :=
  scope with module := cmd_module(cmd)

// the private procedures with formals and without raises, whose raises are inferred
function inferred_procs(cmds: List[Cmd], hidden: Set[Name]): Set[Name] :=
  Set(for cmd in cmds for name in inferred_name(cmd, hidden) yield name)

function inferred_name(cmd: Cmd, hidden: Set[Name]): Option[Name] :=
  match cmd
    case CProc(name, _, ins, outs, refs, List(), _, _) if contains(name, hidden) and ins ++ outs ++ refs != List() =>
      Some(name)
    case _ =>
      None
  end

// the procedures of cmds with their raises as written, and the inferred ones without any yet
function written_procs(cmds: List[Cmd], inferred: Set[Name]): Map[Name, Set[Name]] :=
  Map(for cmd in cmds for (name, raised) in proc_raised(cmd) yield name => if contains(name, inferred) then empty() else exception_names(raised))

function proc_raised(cmd: Cmd): Option[(Name, List[Type])] :=
  match cmd
    case CProc(name, _, _, _, _, raised, _, _) =>
      Some((name, raised))
    case _ =>
      None
  end

// the least raises of the inferred procedures and the least solutions of the unknowns, from none, by the raises of the
// bodies and the bounds until none grows, which ends, since they only grow, and there are finitely many datatypes
function infer_procs(cmds: List[Cmd], bounds: List[Bound], scope: Scope, inferred: Set[Name]): Scope :=
  let (round, lower) := infer_round(cmds, scope, inferred, empty()) in
  let next := round with solved := solve(bounds, lower) in
  if next.procs == scope.procs and next.solved == scope.solved then
    scope
  else
    infer_procs(cmds, bounds, next, inferred)

// the raises of each inferred procedure in turn, where each body sees those of the procedures before it in this round,
// and what the procedure values of all commands give the unknowns of their types, added to lower
function infer_round(cmds: List[Cmd], scope: Scope, inferred: Set[Name], lower: Map[Int, Map[Name, Origin]]): (Scope, Map[Int, Map[Name, Origin]]) :=
  match cmds
    case List() =>
      (scope, lower)

    case List(cmd; rest) =>
      let flow := cmd_flow(in_module(scope, cmd), cmd) in
      match inferred_name(cmd, inferred)
        case Some(name) =>
          infer_round(rest, scope with procs := put(name, keys(flow.raised), scope.procs), inferred, joined(lower, flow.lower))
        case None =>
          infer_round(rest, scope, inferred, joined(lower, flow.lower))
      end
  end

// the least solutions of the unknowns that include lower and satisfy the bounds whose sup is an unknown
function solve(bounds: List[Bound], solved: Map[Int, Map[Name, Origin]]): Map[Int, Map[Name, Origin]] :=
  let next := foldl(bounds, solved, lambda acc, b => propagated(acc, b)) in
  if next == solved then solved else solve(bounds, next)

function propagated(solved: Map[Int, Map[Name, Origin]], b: Bound): Map[Int, Map[Name, Origin]] :=
  match b.sup
    case RUnknown(id) =>
      joined(solved, Map(id => bound_atoms(solved, b)))
    case _ =>
      solved
  end

// the exceptions of the sub of b, with their origins, where those of a set entered at b
function bound_atoms(solved: Map[Int, Map[Name, Origin]], b: Bound): Map[Name, Origin] :=
  match b.sub
    case RUnknown(id) =>
      value_or(get(id, solved), empty())
    case raised =>
      Map(for t in raised_set(empty(), raised) yield t => Origin(Some(b.module), b.pos, None))
  end

// the solutions of both, where the first origin of an exception stays
function joined(a: Map[Int, Map[Name, Origin]], b: Map[Int, Map[Name, Origin]]): Map[Int, Map[Name, Origin]] :=
  foldl(b, a, lambda acc, id, atoms => put(id, atoms ++ value_or(get(id, acc), empty()), acc))

// the exceptions of the solution of the sub of b that its sup, a set, omits, each at its origin
function exceeded(solved: Map[Int, Map[Name, Origin]], b: Bound): List[TypeError] :=
  match b.sup
    case RSet(allowed) =>
      List(for t => origin in bound_atoms(solved, b) if not contains(t, allowed) yield omitted_raise(origin, t))
    case _ =>
      List()
  end

function omitted_raise(origin: Origin, t: Name): TypeError :=
  match origin.name
    case Some(name) =>
      Located(origin.module, origin.pos, UntypedRaise(name, TSort(t, List())))
    case None =>
      Located(origin.module, origin.pos, WiderRaise(TSort(t, List())))
  end

function keys(raised: Map[Name, Pos]): Set[Name] :=
  Set(for t => _ in raised yield t)

// the errors of cmd, with the raises of a procedure that its raises omit, unless they are inferred
function cmd_errors(scope: Scope, cmd: Cmd, inferred: Set[Name]): List[(Pos, TypeError)] :=
  let flow := cmd_flow(scope, cmd) in
  match cmd
    case CProc(name, _, _, _, _, _, _, _) if not contains(name, inferred) =>
      flow.errors ++ omitted(name, flow.raised, proc_raises(scope, name))
    case _ =>
      flow.errors
  end

function omitted(name: Name, raised: Map[Name, Pos], allowed: Set[Name]): List[(Pos, TypeError)] :=
  List(for t => pos in raised if not contains(t, allowed) yield (pos, UndeclaredRaise(name, TSort(t, List()))))

function cmd_flow(scope: Scope, cmd: Cmd): Flow :=
  match cmd
    case CProc(_, _, ins, outs, refs, _, _, stmt) =>
      stmt_flow(bound(scope, vars(ins ++ outs ++ refs)), stmt)

    case CFun(_, _, formals, _, _, body) =>
      expr_flow(bound(scope, vars(formals)), body)

    case CTest(_, _, stmt) =>
      stmt_flow(scope, stmt)

    case CLemma(_, _, _, _, _, _) =>
      none()

    case CSort(_, _, _) =>
      none()

    case CData(_, _, _) =>
      none()

    case CFunSig(_, _, _, _, _) =>
      none()

    case CProcSig(_, _, _, _, _, _, _) =>
      none()

    case CAbstract(_, _) =>
      none()

    case CPatAlias(_, _, _, _, _) =>
      none()

    case CNotation(_, _, _) =>
      none()
  end

function none(): Flow :=
  Flow(empty(), List(), empty())

function errors_flow(errors: List[(Pos, TypeError)]): Flow :=
  Flow(empty(), errors, empty())

// the flows of parts one after another, where the first raise of a type counts
function flows(fs: List[Flow]): Flow :=
  foldl(fs, none(), lambda acc, f => Flow(f.raised ++ acc.raised, acc.errors ++ f.errors, joined(acc.lower, f.lower)))

// flow after the parts of expr, which raise nothing
function with_expr(flow: Flow, expr: Flow): Flow :=
  Flow(flow.raised, expr.errors ++ flow.errors, joined(expr.lower, flow.lower))

function bound(scope: Scope, xs: List[Var]): Scope :=
  scope with locals := scope.locals ++ Map(for x in xs yield x.name => x.typ)

// the raises of the procedure q of the package or of another, where an unknown one is none
function proc_raises(scope: Scope, q: Name): Set[Name] :=
  match get(q, scope.procs)
    case Some(raised) =>
      raised

    case None =>
      match proc_of(scope.sig, q)
        case Some(proc) =>
          exception_names(proc.raised)
        case None =>
          empty()
      end
  end

// the raises of a call of p, a local of a procedure type or a declared procedure, which the checker resolves
function call_raises(scope: Scope, p: Name): Set[Name] :=
  if p.module == None then
    match get(p, scope.locals)
      case Some(TProc(_, _, _, raised)) =>
        raised_set(scope.solved, raised)
      case _ =>
        empty()
    end
  else
    proc_raises(scope, p)

// the exceptions of the raises of a procedure type, of an unknown its solution so far
function raised_set(solved: Map[Int, Map[Name, Origin]], raised: Raises): Set[Name] :=
  match raised
    case RWritten(types) =>
      exception_names(types)

    case RSet(names) =>
      Set(for t in names if not contains(t, unchecked_exceptions()) yield t)

    case RUnknown(id) =>
      Set(for t => _ in value_or(get(id, solved), empty()) yield t)

    // the checker numbers every pending unknown of a checked command
    case RPending =>
      empty()
  end

function exception_names(types: List[Type]): Set[Name] :=
  Set(for t in types for name in exception_name(t) if not contains(name, unchecked_exceptions()) yield name)

// the datatype of an exception, where the checker ensures that written raises are exceptions
function exception_name(t: Type): Option[Name] :=
  match t
    case TSort(name, List()) =>
      Some(name)
    case _ =>
      None
  end

// whether t is a datatype without type parameters, whose values raise may raise
function is_exception(sig: Sig, t: Type): Bool :=
  match t
    case TSort(name, List()) =>
      is_data(sig, name)
    case _ =>
      false
  end

// whether t is an exception that raises count
function is_tracked(sig: Sig, t: Type): Bool :=
  is_exception(sig, t) and not exists(exception_name(t), lambda name => contains(name, unchecked_exceptions()))

function stmt_flow(scope: Scope, stmt: At[Stmt]): Flow :=
  match stmt
    case AOk(pos, _, that) =>
      part_flow(scope, pos, that)

    case AErr(pos, _, that, _) =>
      part_flow(scope, pos, that)

    case AUnparsed(_, _, _, _) =>
      none()
  end

function stmts_flow(scope: Scope, stmts: List[At[Stmt]]): Flow :=
  flows(List(for stmt in stmts yield stmt_flow(scope, stmt)))

function part_flow(scope: Scope, pos: Pos, stmt: Stmt): Flow :=
  match stmt
    case SSkip =>
      none()

    case SAssign(upd) =>
      exprs_flow(scope, List(for (_, e) in upd yield e))

    case SBlock(locals, stmts) =>
      stmts_flow(bound(scope, vars(locals)), stmts)

    // the checker gives no SLocal
    case SLocal(_, _) =>
      none()

    case SIf(cond, left, right) =>
      with_expr(stmts_flow(scope, List(left, right)), expr_flow(scope, cond))

    case SWhile(cond, body) =>
      with_expr(stmt_flow(scope, body), expr_flow(scope, cond))

    case SCall(proc, ins, _, _) =>
      with_expr(Flow(Map(for t in call_raises(scope, proc) yield t => pos), List(), empty()), exprs_flow(scope, ins))

    case SMatch(arg, cases) =>
      with_expr(flows(List(for br in parts(cases) yield branch_flow(scope, br.pat, br.guard, br.body))), expr_flow(scope, arg))

    case SAssert(cond) =>
      expr_flow(scope, cond)

    case SAssertRaises(typ, pat, body) =>
      handled(scope, stmt_flow(scope, body), List((pos, Catch(typ, pat, None, nowhere(SSkip)))))

    case SRaise(value, typ) =>
      with_expr(Flow(Map(for name in exception_name(typ) if is_tracked(scope.sig, typ) yield name => pos), if is_exception(scope.sig, typ) then
        List()
      else
        List((pos, NotAnException(typ))), empty()), expr_flow(scope, value))

    case STry(body, catches) =>
      handled(scope, stmt_flow(scope, body), List(for c in catches yield (c.pos, c.that)))

    case SFor(gens, body) =>
      gens_flow(scope, gens, lambda inner => stmt_flow(inner, body))
  end

// the flow of a case: its pattern binds, then its guard and body
function branch_flow(scope: Scope, pat: At[Pat], guard: Option[At[Expr]], body: At[Stmt]): Flow :=
  let inner := bound(scope, pattern_variables(pat)) in
  with_expr(stmt_flow(inner, body), flows(List(for g in guard yield expr_flow(inner, g))))

// the flow of the body of generators, in the scope of what they bind, after the errors of their containers and guards
function gens_flow(scope: Scope, gens: List[Gen], body: Scope -> Flow): Flow :=
  match gens
    case List() =>
      body(scope)

    case List(GVal(pat, over); rest) =>
      with_expr(gens_flow(bound(scope, pattern_variables(pat)), rest, body), expr_flow(scope, over))

    case List(GPair(key, value, over); rest) =>
      with_expr(gens_flow(bound(scope, pattern_variables(key) ++ pattern_variables(value)), rest, body), expr_flow(scope, over))

    case List(GIf(cond); rest) =>
      with_expr(gens_flow(scope, rest, body), expr_flow(scope, cond))
  end

// what the body of a try raises that its handlers do not catch, where the unguarded handlers of a type that cover it catch
// all of it, _ catches all, and the others let the exceptions that they do not match through, and what the handlers raise
// the types that the handlers cover and the handlers that nothing reaches by their alternatives, of their own types, and
// the flows of their bodies once per handler
function handled(scope: Scope, body: Flow, catches: List[(Pos, Catch)]): Flow :=
  let split := List(for (p, c) in catches for a in handler_alternatives(p, c) yield a) in
  let caught := List(for (_, c) in split if c.guard == None yield (c.typ, c.pat.that)) in
  let left := Map(for t => p in body.raised if not catches_all(scope.sig, TSort(t, List()), caught) yield t => p) in
  let never := List(for (p, c) in split if c.pat.that != PWild and is_tracked(scope.sig, c.typ) and not contains_key(body.raised, c.typ) yield (p, NeverRaised(c.typ))) in
  let handlers := flows(List(for (_, c) in catches yield branch_flow(scope, c.pat, c.guard, c.body))) in
  Flow(handlers.raised ++ left, body.errors ++ never ++ handlers.errors, joined(body.lower, handlers.lower))

// the handlers of the alternatives of the handler c at p, each at its alternative, with its type, if c has alternatives
// at the top, see handler_pattern of ulang/check/check.u
function handler_alternatives(p: Pos, c: Catch): List[(Pos, Catch)] :=
  match c.pat.that
    case POr(_) =>
      List(for d in expanded_handlers(List(nowhere(c))) yield (d.that.pat.pos, d.that))
    case _ =>
      List((p, c))
  end

function catches_all(sig: Sig, t: Type, caught: List[(Type, Pat)]): Bool :=
  exists(caught, lambda (_, pat) => pat == PWild) or covers_all(sig, t, List(for (u, pat) in caught if u == t yield pat))

function contains_key(raised: Map[Name, Pos], t: Type): Bool :=
  match exception_name(t)
    case Some(name) =>
      get(name, raised) != None
    case None =>
      false
  end

// the variables that pat binds, with their types
function pattern_variables(pat: At[Pat]): List[Var] :=
  match pat.that
    case PVar(v) =>
      List(v)

    case PApp(_, args) =>
      List(for a in args for v in pattern_variables(a) yield v)

    case PTuple(args) =>
      List(for a in args for v in pattern_variables(a) yield v)

    case PAnnotated(inner, _) =>
      pattern_variables(inner)

    // those of the first alternative, which all bind
    case POr(alts) =>
      List(for a in take(1, alts) for v in pattern_variables(a) yield v)

    case PWild =>
      List()

    case PLit(_) =>
      List()
  end

function exprs_flow(scope: Scope, exprs: List[At[Expr]]): Flow :=
  flows(List(for e in exprs yield expr_flow(scope, e)))

// the errors of procedure values in expr, which raise nothing themselves, and what they give the unknowns of their types
function expr_flow(scope: Scope, expr: At[Expr]): Flow :=
  match expr
    case AOk(pos, _, that) =>
      part_expr_flow(scope, pos, that)

    case AErr(pos, _, that, _) =>
      part_expr_flow(scope, pos, that)

    case AUnparsed(_, _, _, _) =>
      none()
  end

function part_expr_flow(scope: Scope, pos: Pos, expr: Expr): Flow :=
  match expr
    case ELit(_) =>
      none()

    case EVar(v) =>
      match v.typ
        case TProc(_, _, _, allowed) if v.name.module != None and is_proc(scope.sig, v.name) =>
          value_flow(Origin(scope.module, pos, Some(v.name)), Map(for t in proc_raises(scope, v.name) yield t => pos), allowed)
        case _ =>
          none()
      end

    case EApp(fun, args) =>
      exprs_flow(scope, List(fun; args))

    case EField(base, _) =>
      expr_flow(scope, base)

    case EUpdate(base, _, value) =>
      exprs_flow(scope, List(base, value))

    case ELam(formals, body) =>
      expr_flow(bound(scope, List(for p in formals for v in pattern_variables(p) yield v)), body)

    case EProc(ins, outs, refs, raised, stmt) =>
      let flow := stmt_flow(bound(scope, vars(ins ++ outs ++ refs)), stmt) in
      with_expr(value_flow(Origin(scope.module, pos, Some(Name(None, "lambda"))), flow.raised, raised), flow with raised := empty())

    case ELet(bindings, body) =>
      with_expr(expr_flow(bound(scope, List(for (p, _) in bindings for v in pattern_variables(p) yield v)), body), exprs_flow(scope, List(for (_, e) in bindings yield e)))

    case EIte(cond, then_expr, else_expr) =>
      exprs_flow(scope, List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      flows(List(
        expr_flow(scope, arg); List(for br in parts(cases) yield case_flow(scope, br))))

    case ETuple(args) =>
      exprs_flow(scope, args)

    case EForm(_, elems, rest) =>
      flows(List(for y in elems yield yield_flow(scope, y)) ++ List(for r in rest yield expr_flow(scope, r)))

    case EFor(_, gens, elem, rest) =>
      flows(List(
        gens_flow(scope, gens, lambda inner => yield_flow(inner, elem)); List(for r in rest yield expr_flow(scope, r))))
  end

function case_flow(scope: Scope, br: Branch[At[Expr]]): Flow :=
  let inner := bound(scope, pattern_variables(br.pat)) in
  flows(List(for g in br.guard yield expr_flow(inner, g)) ++ List(expr_flow(inner, br.body)))

function yield_flow(scope: Scope, elem: Yield): Flow :=
  match elem
    case YVal(value) =>
      expr_flow(scope, value)
    case YPair(key, value) =>
      exprs_flow(scope, List(key, value))
  end

// a procedure value from origin that raises raised, each at its position, where a lambda keeps the position of each
// raise, whose type allows the raises allowed: those that a set omits, or what they give an unknown
function value_flow(origin: Origin, raised: Map[Name, Pos], allowed: Raises): Flow :=
  match allowed
    case RSet(names) =>
      errors_flow(List(for t => p in raised if not contains(t, names) yield (p, UntypedRaise(value_or(origin.name, Name(None, "lambda")), TSort(t, List())))))

    case RUnknown(id) =>
      Flow(empty(), List(), Map(id => Map(for t => p in raised yield t => origin with pos := p)))

    // normalize of ulang/check/check.u makes the raises of every type a set or an unknown, and the checker numbers every
    // pending one
    case RWritten(_) =>
      none()

    case RPending =>
      none()
  end
