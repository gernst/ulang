// the type checker of ulang, which checks and elaborates programs of ulang/syntax.u in signatures of ulang/sig.u,
// where the state is passed by reference, and errors are values of TypeError instead of messages,
// and which overloads names across modules: the declarations of a name in all visible modules are its candidates,
// and each use resolves to the one whose type fits, at once if only one fits, or else at the end of the command,
// when the uses that are still open are solved together

export

data TypeError :=
  case UnknownSort(name: Name)
  case SortArity(name: Name, expected: Int, actual: Int)
  case SortDefined(name: Name)
  case MissingType(name: Name)
  case UndeclaredParams(name: Name, types: List[Type])
  case CannotUnify(left: Type, right: Type)
  case InfiniteType(meta: Type, typ: Type)
  case UnknownVariable(name: Name)
  case NoOverload(name: Name, typ: Type)
  case WrongArity(name: Name, arity: Int)
  case AlreadyDefined(name: Name)
  case Duplicate(what: Str, item: Str)
  case Ambiguous(name: Name, candidates: List[Name * Scheme])
  case UnknownField(name: Name)
  case UnknownFieldType(field: Id, typ: Type)
  case UnknownFieldOwner(field: Id)
  // a container of a generator whose type, which chooses the folds, is not known at the generator
  case UnknownContainer(typ: Type)
  // a container of a generator whose type is of a module that declares no fold of three arguments, the one that the form
  // takes
  case NoFold(typ: Type, fold: Id)
  case CountMismatch(owner: Str, unit: Str, expected: Int, actual: Int)
  case UnknownConstructor(name: Name)
  case NotExhaustive(pat: Pat)
  case Unreachable(pat: Pat)
  case NotAssignable(name: Name)
  case UnknownProcedure(name: Name)
  case UnknownException(typ: Type)
  case TestParams(test_name: Id)
  case Unassigned(name: Name)
  case OutputUnassigned(output: Name, proc: Name)
  case MissingDefinition(name: Name)
  case SignatureMismatch(name: Name)
  case PartlyExported(name: Name)
  case PrivateType(name: Name, sort: Name)
  // a formal, local, pattern variable, or formal of a lambda of the name of a local around it
  case HiddenLocal(name: Name)
  case VisibleEquality(sort: Name)
  // show, compare, or == of other values than those of a datatype of its module, see order_of of defs.u
  case MisshapenHook(name: Name, hook: Hook)
  case UnexportedOrder(fun: Name, sort: Name)
  // a pattern alias whose variables are not exactly its formals
  case AliasVariables(name: Name)
  // a pattern alias with _, which matches but builds no value
  case PatternOnly(name: Name)
  // an exported pattern alias of a constructor that importers do not see
  case PrivateConstructor(name: Name, constr: Name)
  // an error of the command at the position of an imported module, or of the main module for None
  case Located(module: Option[Id], pos: Pos, error: TypeError)

procedure check_program(in source: Source, out q: Prog)

implementation

// the types of unknowns by their index
type Subst :=
  Map[Int, Type]

type Env :=
  List[Name * Local]

data Local :=
  case Local(scheme: Scheme, assigned: Bool)

// a use of an overloaded name that more than one candidate fits, by the placeholder id that stands for it
data Pending :=
  case Pending(id: Name, name: Name, cands: List[Name * Scheme], typ: Type)

// where hidden and hidden_sorts are the private declarations and sorts of the members of the package being checked, which
// the other members do not see, while sig has only the exports of the modules checked before
data State :=
  case State(sig: Sig, sub: Subst, count: Int, module: Id, visible: List[Id], table: List[Id * List[Id]], pending: List[Pending], chosen: Map[Name, Name], hidden: Set[Name], hidden_sorts: Set[Name])

// the constructor of a pattern, where literals count as constructors without arguments
data Head :=
  case HCon(constr: Name)
  case HLit(lit: Lit)

// the head of tuples, which have no module
pattern HTuple(): Head :=
  HCon(Name(None, ","))

function with_sig(s: State, sig: Sig): State :=
  s with sig := sig

// the state for checking a declaration of module m, where the substitution starts empty and unknowns are numbered
// from 1 again, since unknowns do not outlive the command that introduces them
function enter(s: State, m: Id): State :=
  s with sub := empty(), count := 0, module := m, visible := sees(m, s.table), pending := List(), chosen := empty()

function sees(m: Id, vs: List[Id * List[Id]]): List[Id] :=
  value_or(get(m, vs), List(m))

function start(main: Id, vs: List[Id * List[Id]]): State :=
  State(empty(), empty(), 0, main, sees(main, vs), vs, List(), empty(), empty(), empty())

function in_module(m: Id, n: Name): Name :=
  Name(Some(m), n.base)

function qualify(m: Id, cmd: Cmd): Cmd :=
  match cmd
    case CSort(name, params, typ) =>
      CSort(in_module(m, name), params, typ)

    case CData(name, params, constrs) =>
      CData(in_module(m, name), params, List(for k in constrs yield qualify_constr(m, k)))

    case CFun(name, params, formals, typ, body) =>
      CFun(in_module(m, name), params, formals, typ, body)

    case CProc(name, params, ins, outs, refs, stmt) =>
      CProc(in_module(m, name), params, ins, outs, refs, stmt)

    case CFunSig(name, params, formals, typ) =>
      CFunSig(in_module(m, name), params, formals, typ)

    case CProcSig(name, params, ins, outs, refs) =>
      CProcSig(in_module(m, name), params, ins, outs, refs)

    case CAbstract(name, params) =>
      CAbstract(in_module(m, name), params)

    case CPatAlias(name, params, formals, typ, pat) =>
      CPatAlias(in_module(m, name), params, formals, typ, pat)

    case CNotation(_, _, _) =>
      cmd

    case CTest(_, _, _) =>
      cmd
  end

function qualify_constr(m: Id, k: Constr): Constr :=
  k with name := in_module(m, k.name)

// each module sees itself and its direct imports, which include the implicit ones and the members of its package, for the
// imports of each module
function visibility(imports: List[Id * List[Id]], main: Id): List[Id * List[Id]] :=
  List(for m in distinct(List(main) ++ firsts(imports)) yield (m, distinct(List(m) ++ imports_of(imports, m))))

function imports_of(imports: List[Id * List[Id]], m: Id): List[Id] :=
  value_or(get(m, imports), List())

// the declarations named n of a kind that the module sees, where its own declarations hide those of other modules
// and declared tells whether a name is a declaration of that kind
function visible_names(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  let ds := List(for d in names_of(s.sig, n.base) if declared(d)) in
  match n
    case Name(Some(_), _) =>
      if contains(n, ds) then List(n) else List()

    case Name(None, base) =>
      if contains(Name(Some(s.module), base), ds) then
        List(Name(Some(s.module), base))
      else
        List(for d in ds if is_visible_sort(s, d))
  end

// the declarations named n of a kind in all modules that the module sees, its own included, whose types decide
// among them
function overloads(s: State, n: Name, declared: Name -> Bool): List[Name] :=
  match n
    case Name(Some(_), _) =>
      List(for d in names_of(s.sig, n.base) if declared(d) and d == n)
    case _ =>
      List(for d in names_of(s.sig, n.base) if declared(d) and is_visible(s, d))
  end

// whether the module sees the declaration d, which is its own, or of a module that it sees and not private to it
function is_visible(s: State, d: Name): Bool :=
  match d.module
    case Some(m) =>
      m == s.module or contains(m, s.visible) and not contains(d, s.hidden)
    case None =>
      false
  end

function is_visible_sort(s: State, d: Name): Bool :=
  match d.module
    case Some(m) =>
      m == s.module or contains(m, s.visible) and not contains(d, s.hidden_sorts)
    case None =>
      false
  end

function params(ps: List[Id]): List[Type] :=
  List(for p in ps yield TParam(p))

function literal(v: Lit): Type :=
  match v
    case LUnit =>
      TTuple(List())

    case LBool(_) =>
      TBool()

    case LInt(_) =>
      TInt()

    case LStr(_) =>
      TStr()

    case LChar(_) =>
      TChar()
  end

function logic(): Scheme :=
  Scheme(List(), TFun(List(TBool(), TBool()), TBool()))

// only what cannot be defined in the prelude, which are names without a module
function builtin_schemes(n: Name): List[Scheme] :=
  match n
    case Name(None, base) =>
      builtin_scheme(base)
    case _ =>
      List()
  end

function builtin_scheme(b: Id): List[Scheme] :=
  let a := TParam("A") in
  match b
    case "<" =>
      List(Scheme(List(a), TFun(List(a, a), TBool())))

    case "and" =>
      List(logic())

    case "or" =>
      List(logic())

    case _ =>
      List(for hook in hooks() if hook_name(hook) == b yield hook_scheme(hook))
  end

function is_meta(t: Type): Bool :=
  match t
    case TMeta(_) =>
      true
    case _ =>
      false
  end

// the Params and Metas in t
function free(t: Type): List[Type] :=
  match t
    case TParam(_) =>
      List(t)

    case TMeta(_) =>
      List(t)

    case THole =>
      List()

    case TSort(_, args) =>
      distinct(List(for a in args for v in free(a) yield v))

    case TFun(args, res) =>
      distinct(List(for a in args ++ List(res) for v in free(a) yield v))

    case TProc(ins, outs, refs) =>
      distinct(List(for a in ins ++ outs ++ refs for v in free(a) yield v))

    case TTuple(types) =>
      distinct(List(for a in types for v in free(a) yield v))
  end

function has_holes(t: Type): Bool :=
  match t
    case THole =>
      true

    case TSort(_, args) =>
      exists(args, has_holes)

    case TFun(args, res) =>
      exists(args, has_holes) or has_holes(res)

    case TProc(ins, outs, refs) =>
      exists(ins ++ outs ++ refs, has_holes)

    case TTuple(types) =>
      exists(types, has_holes)

    case _ =>
      false
  end

function subst(t: Type, m: List[Type * Type]): Type :=
  match t
    case TSort(name, args) =>
      TSort(name, List(for a in args yield subst(a, m)))

    case TFun(args, res) =>
      TFun(List(for a in args yield subst(a, m)), subst(res, m))

    case TProc(ins, outs, refs) =>
      TProc(List(for a in ins yield subst(a, m)), List(for a in outs yield subst(a, m)), List(for a in refs yield subst(a, m)))

    case TTuple(types) =>
      TTuple(List(for a in types yield subst(a, m)))

    case _ =>
      match get(t, m)
        case Some(u) =>
          u
        case None =>
          t
      end
  end

function resolve(su: Subst, t: Type): Type :=
  match t
    case TMeta(meta) =>
      match get(meta, su)
        case Some(u) =>
          resolve(su, u)
        case None =>
          t
      end

    case _ =>
      t
  end

function occurs(su: Subst, i: Int, t: Type): Bool :=
  match resolve(su, t)
    case TMeta(meta) =>
      i == meta

    case TSort(_, args) =>
      exists(args, lambda a => occurs(su, i, a))

    case TFun(args, res) =>
      exists(args, lambda a => occurs(su, i, a)) or occurs(su, i, res)

    case TProc(ins, outs, refs) =>
      exists(ins ++ outs ++ refs, lambda a => occurs(su, i, a))

    case TTuple(types) =>
      exists(types, lambda a => occurs(su, i, a))

    case _ =>
      false
  end

function constructor_scheme(constr: ConstrSig): Scheme :=
  Scheme(constr.params, if constr.fields == List() then
    constr.typ
  else
    TFun(constr.fields, constr.typ))

function constructor_of(sig: Sig, k: Name): Scheme :=
  match constr_of(sig, k)
    case Some(constr) =>
      constructor_scheme(constr)
    case None =>
      Scheme(List(), TTuple(List()))
  end

// the meanings of n with their names, where local variables hide functions, constructors, and builtins, and declared hooks
// are no candidates, since the builtins reach them through the type of their arguments
function candidates(s: State, env: Env, n: Name): List[Name * Scheme] :=
  match get(n, env)
    case Some(l) =>
      List((n, l.scheme))
    case None =>
      List(for f in overloads(s, n, lambda f => is_fun(s.sig, f)) for sc in schemes_of(s.sig, f) if not is_hook(f, arity(sc.typ)) yield (f, sc)) ++ List(for k in overloads(s, n, lambda k => is_constr(s.sig, k)) yield (k, constructor_of(s.sig, k))) ++ List(for p in overloads(s, n, lambda p => is_proc(s.sig, p)) yield (p, proc_scheme(s.sig, p))) ++ List(for sc in builtin_schemes(n) yield (n, sc))
  end

// f with k arguments is the order, the equality, or the text of the values of a datatype, see order_of of defs.u
// constructors and pattern aliases, the names that patterns apply
function is_pattern_name(sig: Sig, n: Name): Bool :=
  is_constr(sig, n) or is_pat_alias(sig, n)

function is_hook(f: Name, k: Int): Bool :=
  hook_of(f.base, k) != None

// a procedure is a value of its type (in A, out B, ref C)
function proc_scheme(sig: Sig, p: Name): Scheme :=
  match proc_of(sig, p)
    case Some(proc) =>
      Scheme(proc.params, TProc(proc.ins, proc.outs, proc.refs))
    case None =>
      Scheme(List(), THole)
  end

function with_arity(cs: List[Name * Scheme], k: Int): List[Name * Scheme] :=
  List(for (n, sc) in cs if arity(sc.typ) == k)

function has_arity(scs: List[Scheme], k: Int): Bool :=
  exists(scs, lambda sc => arity(sc.typ) == k)

function bind(xs: List[Var]): Env :=
  List(for x in xs yield (x.name, Local(Scheme(List(), x.typ), true)))

// no local of xs hides one of env, except those of the translations, whose names users cannot write, such as (acc) and
// (item), which nest
procedure unhidden(in env: Env, xs: List[Var]) :=
  for x in xs if not starts_with(x.name.base, "(") and get(x.name, env) != None do
    raise HiddenLocal(x.name)
  end

function unassigned(xs: List[Var]): Env :=
  List(for x in xs yield (x.name, Local(Scheme(List(), x.typ), false)))

// env after assignments to xs, which are the innermost variables of their names
function assigned(env: Env, xs: List[Name]): Env :=
  match (env, xs)
    case (_, List()) =>
      env

    case (List(), _) =>
      List()

    case (List((n, l); rest), _) =>
      if contains(n, xs) then
        List((n, l with assigned := true); assigned(rest, xs -- List(n)))
      else
        List((n, l); assigned(rest, xs))
  end

// the variables that both paths assign, where env and other have the same variables
function joined(env: Env, other: Env): Env :=
  match (env, other)
    case (List((n, l); rest), List((_, k); more)) =>
      List(
        (n, l with assigned := l.assigned and k.assigned); joined(rest, more))

    case _ =>
      List()
  end

// the variables after a raise, where no path continues, which joins with others as if it assigned all of them
function unreachable(env: Env): Env :=
  List(for (n, l) in env yield (n, l with assigned := true))

procedure readable(in env: Env, n: Name) :=
  match get(n, env)
    case Some(Local(_, false)) =>
      raise Unassigned(n)
    case _ =>
      skip
  end

procedure readables(in env: Env, ns: List[Name]) :=
  for n in ns do
    call readable(in env, n)
  end

// the outs os of procedure p must be assigned at the end of its body
procedure outputs(in p: Name, os: List[Var], env: Env) :=
  match os
    case List() =>
      skip

    case List(o; more) =>
      match get(o.name, env)
        case Some(Local(_, false)) =>
          raise OutputUnassigned(o.name, p)
        case _ =>
          skip
      end
      call outputs(in p, more, env)
  end

// the unknowns of the types of env, which a let cannot generalize
function fixed(su: Subst, env: Env): List[Type] :=
  List(for (_, l) in env for a in free(zonk_type(su, l.scheme.typ)) -- l.scheme.params yield a)

function generalize(su: Subst, env: Env, t: Type): Scheme :=
  let fx := fixed(su, env), u := zonk_type(su, t) in
  Scheme(List(for m in free(u) if is_meta(m) and not contains(m, fx)), u)

// the unknowns of open uses of overloaded names stay fixed, too, since their declarations are not chosen yet
function generalized(s: State, env: Env, xs: List[Var]): Env :=
  let waiting := List(for p in s.pending yield (p.id, Local(Scheme(List(), p.typ), true))) in
  List(for x in xs yield (x.name, Local(generalize(s.sub, waiting ++ env, x.typ), true)))

// the pattern of a case, and whether it has no guard, such that it may cover values
function case_of[A](b: Branch[A]): Pat * Bool :=
  match b
    case Branch(_, pat, guard, _) =>
      (pat, guard == None)
  end

function zonk_guard(s: State, g: Option[Expr]): Option[Expr] :=
  map_option(g, lambda e => zonk_expr(s, e))

function zonk_type(su: Subst, t: Type): Type :=
  match resolve(su, t)
    case TSort(name, args) =>
      TSort(name, List(for a in args yield zonk_type(su, a)))

    case TFun(args, res) =>
      TFun(List(for a in args yield zonk_type(su, a)), zonk_type(su, res))

    case TProc(ins, outs, refs) =>
      TProc(List(for a in ins yield zonk_type(su, a)), List(for a in outs yield zonk_type(su, a)), List(for a in refs yield zonk_type(su, a)))

    case TTuple(types) =>
      TTuple(List(for a in types yield zonk_type(su, a)))

    case u =>
      u
  end

// the declaration chosen for an overloaded name, which stands for it until the end of the command
function settled(s: State, n: Name): Name :=
  match n.module
    case Some("?") =>
      match get(n, s.chosen)
        case Some(m) =>
          m
        case None =>
          n
      end

    case _ =>
      n
  end

function zonk_var(s: State, x: Var): Var :=
  Var(settled(s, x.name), zonk_type(s.sub, x.typ))

function zonk_vars(s: State, xs: List[Var]): List[Var] :=
  List(for x in xs yield zonk_var(s, x))

function zonk_expr(s: State, expr: Expr): Expr :=
  match expr
    case ELit(_) =>
      expr

    case EVar(var) =>
      EVar(zonk_var(s, var))

    case EApp(fun, args) =>
      EApp(zonk_expr(s, fun), List(for a in args yield zonk_expr(s, a)))

    case EField(base, field) =>
      EField(zonk_expr(s, base), field)

    case EUpdate(base, field, value) =>
      EUpdate(zonk_expr(s, base), field, zonk_expr(s, value))

    case ELam(formals, body) =>
      ELam(zonk_vars(s, formals), zonk_expr(s, body))

    case EProc(ins, outs, refs, stmt) =>
      EProc(zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, stmt))

    case ELet(bindings, body) =>
      ELet(List(for (p, e) in bindings yield (zonk_pat(s, p), zonk_expr(s, e))), zonk_expr(s, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(zonk_expr(s, cond), zonk_expr(s, then_expr), zonk_expr(s, else_expr))

    case EMatch(arg, cases) =>
      EMatch(zonk_expr(s, arg), List(for b in cases yield zonk_expr_branch(s, b)))

    case ETuple(args) =>
      ETuple(List(for arg in args yield zonk_expr(s, arg)))

    case ERaise(value, typ) =>
      ERaise(zonk_expr(s, value), zonk_type(s.sub, typ))

    case EForm(_, _, _) =>
      expr

    case EFor(_, _, _, _) =>
      expr
  end

function zonk_expr_branch(s: State, b: Branch[Expr]): Branch[Expr] :=
  match b
    case Branch(doc, pat, guard, body) =>
      Branch(doc, zonk_pat(s, pat), zonk_guard(s, guard), zonk_expr(s, body))
  end

function zonk_pat(s: State, pat: Pat): Pat :=
  match pat
    case PVar(var) =>
      PVar(zonk_var(s, var))

    case PApp(constr, args) =>
      PApp(constr, List(for a in args yield zonk_pat(s, a)))

    case PTuple(args) =>
      PTuple(List(for q in args yield zonk_pat(s, q)))

    case _ =>
      pat
  end

function zonk_binding(s: State, p: Var * Expr): Var * Expr :=
  match p
    case (x, e) =>
      (zonk_var(s, x), zonk_expr(s, e))
  end

function zonk_stmt(s: State, stmt: Stmt): Stmt :=
  match stmt
    case SSkip =>
      stmt

    case SAssign(upd) =>
      SAssign(List(for p in upd yield zonk_binding(s, p)))

    case SBlock(locals, stmts) =>
      SBlock(zonk_vars(s, locals), List(for y in stmts yield zonk_stmt(s, y)))

    case SIf(cond, left, right) =>
      SIf(zonk_expr(s, cond), zonk_stmt(s, left), zonk_stmt(s, right))

    case SWhile(cond, body) =>
      SWhile(zonk_expr(s, cond), zonk_stmt(s, body))

    case SCall(proc, ins, outs, refs) =>
      SCall(settled(s, proc), List(for e in ins yield zonk_expr(s, e)), zonk_vars(s, outs), zonk_vars(s, refs))

    case SMatch(arg, cases) =>
      SMatch(zonk_expr(s, arg), List(for b in cases yield zonk_stmt_branch(s, b)))

    case SAssert(cond) =>
      SAssert(zonk_expr(s, cond))

    case SRaise(value, typ) =>
      SRaise(zonk_expr(s, value), zonk_type(s.sub, typ))

    case STry(body, catches) =>
      STry(zonk_stmt(s, body), List(for h in catches yield zonk_handler(s, h)))
  end

function zonk_stmt_branch(s: State, b: Branch[Stmt]): Branch[Stmt] :=
  match b
    case Branch(doc, pat, guard, body) =>
      Branch(doc, zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_handler(s: State, h: Catch): Catch :=
  match h
    case Catch(doc, typ, pat, guard, body) =>
      Catch(doc, zonk_type(s.sub, typ), zonk_pat(s, pat), zonk_guard(s, guard), zonk_stmt(s, body))
  end

function zonk_cmd(s: State, cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, body) =>
      CFun(name, params, zonk_vars(s, formals), zonk_type(s.sub, typ), zonk_expr(s, body))

    case CProc(name, params, ins, outs, refs, stmt) =>
      CProc(name, params, zonk_vars(s, ins), zonk_vars(s, outs), zonk_vars(s, refs), zonk_stmt(s, stmt))

    case CTest(test_name, vars, stmt) =>
      CTest(test_name, vars, zonk_stmt(s, stmt))

    case _ =>
      cmd
  end

// exceptions are told apart by their types at runtime, which must therefore be known after checking
function unknown_type(t: Type): Option[Type] :=
  if free(t) == List() then None else Some(t)

// the type of an exception that is not known, also of those raised in expressions
function unknown_in(stmt: Stmt): Option[Type] :=
  match stmt
    case SAssign(upd) =>
      unknown_in_exprs(seconds(upd))

    case SBlock(_, stmts) =>
      unknown_in_all(stmts)

    case SIf(cond, left, right) =>
      or_else(unknown_in_expr(cond), or_else(unknown_in(left), unknown_in(right)))

    case SWhile(cond, body) =>
      or_else(unknown_in_expr(cond), unknown_in(body))

    case SCall(_, ins, _, _) =>
      unknown_in_exprs(ins)

    case SMatch(arg, cases) =>
      or_else(unknown_in_expr(arg), unknown_in_branches(cases))

    case SAssert(cond) =>
      unknown_in_expr(cond)

    case SRaise(value, typ) =>
      or_else(unknown_type(typ), unknown_in_expr(value))

    case STry(body, catches) =>
      or_else(unknown_in(body), unknown_in_handlers(catches))

    case SSkip =>
      None
  end

function unknown_in_expr(expr: Expr): Option[Type] :=
  match expr
    case ERaise(value, typ) =>
      or_else(unknown_type(typ), unknown_in_expr(value))

    case EApp(fun, args) =>
      unknown_in_exprs(List(fun; args))

    case EField(base, _) =>
      unknown_in_expr(base)

    case EUpdate(base, _, value) =>
      unknown_in_exprs(List(base, value))

    case ELam(_, body) =>
      unknown_in_expr(body)

    case EProc(_, _, _, stmt) =>
      unknown_in(stmt)

    case ELet(bindings, body) =>
      unknown_in_exprs(seconds(bindings) ++ List(body))

    case EIte(cond, then_expr, else_expr) =>
      unknown_in_exprs(List(cond, then_expr, else_expr))

    case EMatch(arg, cases) =>
      unknown_in_exprs(List(arg; List(for b in cases for e in branch_exprs(b) yield e)))

    case ETuple(args) =>
      unknown_in_exprs(args)

    // literals and variables, and forms, which the checker has translated
    case _ =>
      None
  end

function unknown_in_exprs(exprs: List[Expr]): Option[Type] :=
  find_map(exprs, unknown_in_expr)

function branch_exprs(b: Branch[Expr]): List[Expr] :=
  match b
    case Branch(_, _, Some(g), body) =>
      List(g, body)
    case Branch(_, _, None, body) =>
      List(body)
  end

function unknown_in_all(xs: List[Stmt]): Option[Type] :=
  find_map(xs, unknown_in)

function unknown_in_branches(bs: List[Branch[Stmt]]): Option[Type] :=
  find_map(bs, unknown_in_branch)

function unknown_in_branch(b: Branch[Stmt]): Option[Type] :=
  match b
    case Branch(_, _, guard, body) =>
      or_else(unknown_in_guard(guard), unknown_in(body))
  end

// handlers of _ catch exceptions of any type
function unknown_in_handlers(hs: List[Catch]): Option[Type] :=
  find_map(hs, unknown_in_handler)

function unknown_in_handler(h: Catch): Option[Type] :=
  match h
    case Catch(_, typ, pat, guard, body) =>
      let caught := if pat == PWild then None else unknown_type(typ) in
      or_else(caught, or_else(unknown_in_guard(guard), unknown_in(body)))
  end

function unknown_in_guard(guard: Option[Expr]): Option[Type] :=
  match guard
    case Some(g) =>
      unknown_in_expr(g)
    case None =>
      None
  end

function unknown_in_cmd(cmd: Cmd): Option[Type] :=
  match cmd
    case CFun(_, _, _, _, body) =>
      unknown_in_expr(body)

    case CProc(_, _, _, _, _, stmt) =>
      unknown_in(stmt)

    case CTest(_, _, stmt) =>
      unknown_in(stmt)

    case _ =>
      None
  end

function head_of(pat: Pat): Option[Head * List[Pat]] :=
  match pat
    case PApp(constr, args) =>
      Some((HCon(constr), args))

    case PTuple(args) =>
      Some((HTuple(), args))

    case PLit(lit) =>
      Some((HLit(lit), List()))

    case _ =>
      None
  end

// the constructors in the first column
function heads(rows: List[List[Pat]]): List[Head] :=
  match rows
    case List() =>
      List()

    case List(List(p; _); rest) =>
      match head_of(p)
        case Some((h, _)) =>
          List(h; heads(rest))
        case None =>
          heads(rest)
      end

    case List(List(); rest) =>
      heads(rest)
  end

// the argument types of constructor k of a datatype with type arguments args
function constr_fields(sig: Sig, k: Name, args: List[Type]): List[Type] :=
  match constr_of(sig, k)
    case Some(constr) =>
      List(for a in constr.fields yield subst(a, zip(constr.params, args)))
    case None =>
      List()
  end

// all constructors of t with their argument types, if there are finitely many
function constructors_of(sig: Sig, su: Subst, t: Type): Option[List[Head * List[Type]]] :=
  match zonk_type(su, t)
    case TBool() =>
      Some(List((HLit(LBool(true)), List()), (HLit(LBool(false)), List())))

    case TTuple(types) =>
      Some(List((HTuple(), types)))

    case TSort(name, args) =>
      match members_of(sig, name)
        case Some(ks) =>
          Some(List(for k in ks yield (HCon(k), constr_fields(sig, k, args))))
        case None =>
          None
      end

    case _ =>
      None
  end

function fields_of(sig: Sig, su: Subst, t: Type, h: Head): List[Type] :=
  match constructors_of(sig, su, t)
    case Some(ks) =>
      value_or(get(h, ks), List())
    case None =>
      List()
  end

function covers(hs: List[Head], ks: List[Head * List[Type]]): Bool :=
  forall(ks, lambda (h, _) => contains(h, hs))

// the rows whose first pattern has no constructor, without it
function defaults(rows: List[List[Pat]]): List[List[Pat]] :=
  match rows
    case List() =>
      List()

    case List(List(p; ps); rest) =>
      match head_of(p)
        case Some(_) =>
          defaults(rest)
        case None =>
          List(ps; defaults(rest))
      end

    case List(List(); rest) =>
      defaults(rest)
  end

function specialize(rows: List[List[Pat]], h: Head, n: Int): List[List[Pat]] :=
  match rows
    case List() =>
      List()

    case List(List(p; ps); rest) =>
      match head_of(p)
        case Some((g, args)) =>
          if g == h then
            List(args ++ ps; specialize(rest, h, n))
          else
            specialize(rest, h, n)

        case None =>
          List(replicate(n, PWild) ++ ps; specialize(rest, h, n))
      end

    case List(List(); rest) =>
      specialize(rest, h, n)
  end

// some values of types ts match q but no row
function is_useful(sig: Sig, su: Subst, rows: List[List[Pat]], q: List[Pat], ts: List[Type]): Bool :=
  match (q, ts)
    case (List(), _) =>
      rows == List()

    case (List(p; ps), List(t; rest)) =>
      match head_of(p)
        case Some((h, args)) =>
          is_useful(sig, su, specialize(rows, h, size(args)), args ++ ps, fields_of(sig, su, t, h) ++ rest)

        case None =>
          match constructors_of(sig, su, t)
            case Some(ks) =>
              if covers(heads(rows), ks) then
                is_useful_in(sig, su, rows, ks, ps, rest)
              else
                is_useful(sig, su, defaults(rows), ps, rest)

            case None =>
              is_useful(sig, su, defaults(rows), ps, rest)
          end
      end

    case (List(_; _), List()) =>
      false
  end

function is_useful_in(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], pats: List[Pat], rest: List[Type]): Bool :=
  exists(ks, lambda (h, args) => is_useful(sig, su, specialize(rows, h, size(args)), replicate(size(args), PWild) ++ pats, args ++ rest))

function witness(h: Head, args: List[Pat]): Pat :=
  match h
    case HTuple() =>
      PTuple(args)

    case HCon(constr) =>
      PApp(constr, args)

    case HLit(lit) =>
      PLit(lit)
  end

// values of types ts, as patterns, that no row matches
function missing(sig: Sig, su: Subst, rows: List[List[Pat]], ts: List[Type]): Option[List[Pat]] :=
  match ts
    case List() =>
      if rows == List() then Some(List()) else None
    case List(t; rest) =>
      missing_in(sig, su, rows, heads(rows), constructors_of(sig, su, t), rest)
  end

// hs are the constructors in the first column, cs are all constructors of its type if there are finitely many
function missing_in(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match cs
    case Some(ks) =>
      if covers(hs, ks) then
        first_missing(sig, su, rows, ks, rest)
      else
        other_missing(sig, su, rows, hs, cs, rest)

    case None =>
      other_missing(sig, su, rows, hs, cs, rest)
  end

function first_missing(sig: Sig, su: Subst, rows: List[List[Pat]], ks: List[Head * List[Type]], rest: List[Type]): Option[List[Pat]] :=
  match ks
    case List() =>
      None

    case List((h, args); more) =>
      match missing(sig, su, specialize(rows, h, size(args)), args ++ rest)
        case Some(ws) =>
          match split_at(size(args), ws)
            case (found, others) =>
              Some(List(witness(h, found); others))
          end

        case None =>
          first_missing(sig, su, rows, more, rest)
      end
  end

function other_missing(sig: Sig, su: Subst, rows: List[List[Pat]], hs: List[Head], cs: Option[List[Head * List[Type]]], rest: List[Type]): Option[List[Pat]] :=
  match missing(sig, su, defaults(rows), rest)
    case Some(ws) =>
      Some(List(uncovered(hs, cs); ws))
    case None =>
      None
  end

// a value of the first column that hs do not cover
function uncovered(hs: List[Head], cs: Option[List[Head * List[Type]]]): Pat :=
  match cs
    case Some(ks) =>
      if hs == List() then PWild else first_uncovered(hs, ks)
    case None =>
      PWild
  end

function first_uncovered(hs: List[Head], ks: List[Head * List[Type]]): Pat :=
  match ks
    case List() =>
      PWild

    case List((h, args); rest) =>
      if contains(h, hs) then
        first_uncovered(hs, rest)
      else
        witness(h, replicate(size(args), PWild))
  end

procedure fresh(out t: Type, ref s: State) :=
  assign t := TMeta(s.count + 1), s := s with count := s.count + 1

procedure bind_meta(in i: Int, t: Type, ref s: State) :=
  if occurs(s.sub, i, t) then
    raise InfiniteType(TMeta(i), zonk_type(s.sub, t))
  end
  assign s := s with sub := put(i, t, s.sub)

procedure unify(in t1: Type, t2: Type, ref s: State) :=
  local a := resolve(s.sub, t1), b := resolve(s.sub, t2)
  match (a, b)
    case (TMeta(i), TMeta(j)) =>
      if i != j then
        call bind_meta(in i, b, ref s)
      end

    case (TMeta(meta), _) =>
      call bind_meta(in meta, b, ref s)

    case (_, TMeta(meta)) =>
      call bind_meta(in meta, a, ref s)

    case (TParam(x), TParam(y)) =>
      if x != y then
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TSort(f, xs), TSort(g, ys)) =>
      if f == g and size(xs) == size(ys) then
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TFun(xs, r1), TFun(ys, r2)) =>
      if size(xs) == size(ys) then
        call unifies(in xs ++ List(r1), ys ++ List(r2), ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TTuple(xs), TTuple(ys)) =>
      if size(xs) == size(ys) then
        call unifies(in xs, ys, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case (TProc(xs, ys, zs), TProc(us, vs, ws)) =>
      if size(xs) == size(us) and size(ys) == size(vs) and size(zs) == size(ws) then
        call unifies(in xs ++ ys ++ zs, us ++ vs ++ ws, ref s)
      else
        raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
      end

    case _ =>
      raise CannotUnify(zonk_type(s.sub, t1), zonk_type(s.sub, t2))
  end

procedure unifies(in xs: List[Type], ys: List[Type], ref s: State) :=
  match (xs, ys)
    case (List(x; xs1), List(y; ys1)) =>
      call unify(in x, y, ref s)
      call unifies(in xs1, ys1, ref s)

    case (List(), List()) =>
      skip

    case _ =>
      raise CountMismatch("", "values", size(xs), size(ys))
  end

procedure fresh_list[A](in xs: List[A], out ts: List[Type], ref s: State) :=
  local t: Type
  assign ts := List()
  for _ in xs do
    call   fresh(out t, ref s)
    assign ts := ts ++ List(t)
  end

procedure instance(in ps: List[Type], out m: List[Type * Type], ref s: State) :=
  local t: Type
  assign m := List()
  for p in ps do
    call   fresh(out t, ref s)
    assign m := m ++ List((p, t))
  end

procedure instantiate(in sc: Scheme, out t: Type, ref s: State) :=
  local m: List[Type * Type]
  call   instance(in sc.params, out m, ref s)
  assign t := subst(zonk_type(s.sub, sc.typ), m)

// the names ns, which must be distinct, of what they are, e.g. formals
procedure unique(in what: Str, ns: List[Name]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(what, n.base)
    case None =>
      skip
  end

procedure unique_ids(in what: Str, ns: List[Id]) :=
  match repeated(ns)
    case Some(n) =>
      raise Duplicate(what, n)
    case None =>
      skip
  end

// the number n of the units of owner, which expects m of them, e.g. the arguments of a constructor
procedure same_length(in owner: Str, unit: Str, m: Int, n: Int) :=
  if m != n then
    raise CountMismatch(owner, unit, m, n)
  end

procedure arguments(in n: Name, k: Int, args: List[Type]) :=
  if size(args) != k then
    raise SortArity(n, k, size(args))
  end

// expands type definitions and replaces holes by fresh unknowns
procedure normalize(in t: Type, out u: Type, ref s: State) :=
  match t
    case THole =>
      call fresh(out u, ref s)

    case TParam(_) =>
      assign u := t

    case TMeta(_) =>
      assign u := t

    case TFun(args, res) =>
      local us: List[Type], v: Type
      call   normalizes(in args, out us, ref s)
      call   normalize(in res, out v, ref s)
      assign u := TFun(us, v)

    case TTuple(types) =>
      local us: List[Type]
      call   normalizes(in types, out us, ref s)
      assign u := TTuple(us)

    case TProc(ins, outs, refs) =>
      local us: List[Type]
      call   normalizes(in ins ++ outs ++ refs, out us, ref s)
      assign u := match split_at(size(ins), us)
        case (in_types, others) =>
          match split_at(size(outs), others)
            case (out_types, ref_types) =>
              TProc(in_types, out_types, ref_types)
          end
      end

    case TSort(name, args) =>
      match visible_names(s, name, lambda n => is_sort(s.sig, n))
        case List(m) =>
          call normalize_sort(in m, args, out u, ref s)

        case List() =>
          raise UnknownSort(name)

        case ms =>
          raise Ambiguous(name, List(for m in ms yield (m, Scheme(List(), THole))))
      end
  end

procedure normalize_sort(
  in  n: Name,
      args: List[Type],
  out u: Type,
  ref s: State
) :=
  match data_of(s.sig, n)
    case Some(k) =>
      local us: List[Type]
      call   arguments(in n, k, args)
      call   normalizes(in args, out us, ref s)
      assign u := TSort(n, us)

    case None =>
      local us: List[Type]
      match type_alias_of(s.sig, n)
        case Some(alias) =>
          call   arguments(in n, size(alias.params), args)
          call   normalizes(in args, out us, ref s)
          assign u := subst(alias.typ, zip(params(alias.params), us))

        case None =>
          raise UnknownSort(n)
      end
  end

// step applied to each of xs in order, threading the state
procedure map_state[A, B](
  in  xs: List[A],
      step: (in A, out B, ref State),
  out ys: List[B],
  ref s: State
) :=
  local y: B, found: Buffer[B] := empty()
  for x in xs do
    call   step(in x, out y, ref s)
    assign found := found ++ List(y)
  end
  assign ys := List(for z in found)

procedure normalizes(in ts: List[Type], out us: List[Type], ref s: State) :=
  call map_state(in ts, normalize, out us, ref s)

procedure known(in t: Type, what: Name, out u: Type, ref s: State) :=
  if has_holes(t) then
    raise MissingType(what)
  end
  call normalize(in t, out u, ref s)

procedure knowns(
  in  ts: List[Type],
      what: Name,
  out us: List[Type],
  ref s: State
) :=
  call map_state(in ts, lambda in t: Type, out u: Type, ref r: State =>
    call known(in t, what, out u, ref r)
  end, out us, ref s)

// the variables of a lambda, a let, or locals, which are what, e.g. formals
procedure formals(in what: Str, xs: List[Var], out ys: List[Var], ref s: State) :=
  call unique(in what, List(for x in xs yield x.name))
  call normalize_vars(in xs, out ys, ref s)

procedure normalize_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call map_state(in xs, normalize_var, out ys, ref s)

procedure normalize_var(in x: Var, out y: Var, ref s: State) :=
  local u: Type
  call   normalize(in x.typ, out u, ref s)
  assign y := Var(x.name, u)

// the parameters and locals, which have types
procedure signature(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call unique(in "formal", List(for x in xs yield x.name))
  call known_vars(in xs, out ys, ref s)

procedure known_vars(in xs: List[Var], out ys: List[Var], ref s: State) :=
  call map_state(in xs, known_var, out ys, ref s)

procedure known_var(in x: Var, out y: Var, ref s: State) :=
  local u: Type
  call   known(in x.typ, x.name, out u, ref s)
  assign y := Var(x.name, u)

// a use of n elaborated with an instance of sc, where w is normalized
procedure use(in n: Name, w: Type, sc: Scheme, out x: Var, ref s: State) :=
  local u: Type
  call   instantiate(in sc, out u, ref s)
  call   unify(in u, w, ref s)
  assign x := Var(n, u)

// a use of n of type w, which is normalized, as the one of the candidates cs that fits w
procedure use_name(
  in  n: Name,
      cs: List[Name * Scheme],
      w: Type,
  out x: Var,
  ref s: State
) :=
  match cs
    case List() if overloads(s, n, lambda a => is_pat_alias(s.sig, a)) != List() =>
      raise PatternOnly(n)

    case List() =>
      raise UnknownVariable(n)

    case List((m1, sc)) =>
      call use(in m1, w, sc, out x, ref s)

    case _ =>
      local m: Name
      call   choose(in n, cs, w, out m, ref s)
      assign x := Var(m, w)
  end

// the one of the candidates cs that fits w, or a placeholder for the use if several fit, which stays open
procedure choose(
  in  n: Name,
      cs: List[Name * Scheme],
      w: Type,
  out m: Name,
  ref s: State
) :=
  local ok: List[(Name * Scheme) * State]
  call trials(in cs, w, s, out ok)
  match ok
    case List() =>
      raise NoOverload(n, zonk_type(s.sub, w))

    case List(((m1, _), s1)) =>
      assign m := m1, s := s1

    case _ =>
      assign m := Name(Some("?"), show(s.count + 1))
      assign s := s with count := s.count + 1, pending := s.pending ++ List(Pending(m, n, firsts(ok), w))
  end

// the candidates that fit w, each with the state after unifying its instance with w
procedure trials(
  in  cs: List[Name * Scheme],
      w: Type,
      s: State,
  out ok: List[(Name * Scheme) * State]
) :=
  local u: State, failed: Option[TypeError]
  assign ok := List()
  for (m, sc) in cs do
    assign u := s, failed := None
    try
      call trial(in sc, w, ref u)
    catch
      case e =>
        assign failed := Some(e)
    end
    if failed == None then
      assign ok := ok ++ List(((m, sc), u))
    end
  end

procedure trial(in sc: Scheme, w: Type, ref s: State) :=
  local u: Type
  call instantiate(in sc, out u, ref s)
  call unify(in u, w, ref s)

// the open uses, until none can be decided, where each is decided once one of its candidates fits
procedure solve(ref s: State) :=
  local changed := true, ps: List[Pending]
  while changed do
    assign ps := s.pending, changed := false
    assign s := s with pending := List()
    call   revisit(in ps, ref changed, s)
  end

procedure revisit(in ps: List[Pending], ref changed: Bool, s: State) :=
  match ps
    case List() =>
      skip

    case List(p; rest) =>
      local ok: List[(Name * Scheme) * State]
      call trials(in p.cands, p.typ, s, out ok)
      match ok
        case List() =>
          raise NoOverload(p.name, zonk_type(s.sub, p.typ))

        case List(((m, _), s1)) =>
          assign s := s1 with chosen := put(p.id, m, s1.chosen)
          assign changed := true

        case _ =>
          assign s := s with pending := s.pending ++ List(p with cands := firsts(ok))
          if size(ok) < size(p.cands) then
            assign changed := true
          end
      end
      call revisit(in rest, ref changed, s)
  end

// the uses of a command, each of which must be decided by its types alone, so that a use means the one candidate that fits
// it, whatever the order in which the uses are solved
procedure settle(ref s: State) :=
  call solve(ref s)
  match s.pending
    case List(p; _) =>
      raise Ambiguous(p.name, p.cands)
    case List() =>
      skip
  end

procedure infer(in env: Env, expr: Expr, out res: Expr, typ: Type, ref s: State) :=
  match expr
    case ELit(lit) =>
      assign res := expr, typ := literal(lit)

    case EName(name, a) =>
      local z: Var, w: Type
      call   normalize(in a, out w, ref s)
      call   use_name(in name, candidates(s, env, name), w, out z, ref s)
      call   readable(in env, name)
      assign res := EVar(z), typ := z.typ

    case EApp(fun, args) =>
      call application(in env, fun, args, out res, typ, ref s)

    case EField(base, field) =>
      call field_access(in env, "." ++ field, base, List(), out res, typ, ref s)

    case EUpdate(base, field, value) =>
      call field_access(in env, "." ++ field ++ ":=", base, List(value), out res, typ, ref s)

    case ELam(bound, body) =>
      local xs: List[Var], b: Expr, u: Type
      call   formals(in "formal", bound, out xs, ref s)
      call   unhidden(in env, xs)
      call   infer(in bind(xs) ++ env, body, out b, u, ref s)
      assign res := ELam(xs, b), typ := TFun(List(for x in xs yield x.typ), u)

    // the body sees the variables around it, but assigns only the outs and refs of the lambda
    case EProc(ins, outs, refs, stmt) =>
      local xs: List[Var], ys: List[Var], zs: List[Var], y: Stmt, inner: Env
      call   unique(in "formal", List(for x in ins ++ outs ++ refs yield x.name))
      call   formals(in "formal", ins, out xs, ref s)
      call   formals(in "formal", outs, out ys, ref s)
      call   formals(in "formal", refs, out zs, ref s)
      call   unhidden(in env, xs ++ ys ++ zs)
      assign inner := bind(xs) ++ unassigned(ys) ++ bind(zs) ++ env
      call   statement(in List(for x in ys ++ zs yield x.name), stmt, out y, ref inner, s)
      call   outputs(in unqualified("lambda"), ys, inner)
      assign res := EProc(xs, ys, zs, y), typ := TProc(List(for x in xs yield x.typ), List(for x in ys yield x.typ), List(for x in zs yield x.typ))

    case ELet(bound, body) =>
      match pattern_vars(firsts(bound))
        case Some(vars) =>
          local xs: List[Var], b: Expr, u: Type, exprs: List[Expr]
          call   formals(in "binding", vars, out xs, ref s)
          call   unhidden(in env, xs)
          call   checks(in env, "the bindings", seconds(bound), List(for x in xs yield x.typ), out exprs, ref s)
          call   solve(ref s)
          call   infer(in generalized(s, env, xs) ++ env, body, out b, u, ref s)
          assign res := ELet(zip(List(for x in xs yield PVar(x)), exprs), b), typ := u

        // other patterns are irrefutable, checked for exhaustiveness as the cases of a match, and do not generalize
        case None =>
          local ts: List[Type], exprs: List[Expr], pats: List[Pat] := List(), xs: List[Var] := List(), b: Expr
          call fresh_list(in bound, out ts, ref s)
          call checks(in env, "the bindings", seconds(bound), ts, out exprs, ref s)
          for (pat, t) in zip(firsts(bound), ts) do
            local p1: Pat, ys: List[Var]
            call   binders(in pat, t, out p1, ys, ref s)
            assign pats := pats ++ List(p1), xs := xs ++ ys
          end
          call unique(in "pattern variable", List(for x in xs yield x.name))
          call unhidden(in env, xs)
          call infer(in bind(xs) ++ env, body, out b, typ, ref s)
          call solve(ref s)
          for (pat, t) in zip(pats, ts) do
            call coverage(in s, t, List((pat, true)))
          end
          assign res := ELet(zip(pats, exprs), b)
      end

    case EIte(cond, then_expr, else_expr) =>
      local b: Expr, c: Expr, l: Expr, u: Type
      call   check(in env, cond, TBool(), out c, ref s)
      call   infer(in env, then_expr, out l, u, ref s)
      call   check(in env, else_expr, u, out b, ref s)
      assign res := EIte(c, l, b), typ := u

    case ETuple(items) =>
      local exprs: List[Expr], ts: List[Type]
      call   infers(in env, items, out exprs, ts, ref s)
      assign res := ETuple(exprs), typ := TTuple(ts)

    // the exception, whose type must be known after checking, and the expression of any type
    case ERaise(value, raised) =>
      local c: Expr, u: Type, w: Type
      call   infer(in env, value, out c, u, ref s)
      call   normalize(in raised, out w, ref s)
      call   unify(in u, w, ref s)
      call   fresh(out typ, ref s)
      assign res := ERaise(c, u)

    case EMatch(arg, cases) =>
      local c: Expr, u: Type, bs: List[Branch[Expr]]
      call   fresh(out typ, ref s)
      call   infer(in env, arg, out c, u, ref s)
      call   expr_branches(in env, cases, u, typ, out bs, ref s)
      call   solve(ref s)
      call   coverage(in s, u, List(for br in bs yield case_of(br)))
      assign res := EMatch(c, bs)

    // forms as the builders of the module of their name, and their generators as the folds of the modules of the
    // containers, which the checked program keeps
    case EForm(form, elems, rest) =>
      call infer(in env, form_expr(form, elems, rest), out res, typ, ref s)

    case EFor(FArray, gens, elem, None) =>
      call infer(in env, ECall(library_name("array", "from_list"), THole, List(EFor(FList, gens, elem, None))), out res, typ, ref s)

    case EFor(form, List(), elem, rest) =>
      call infer(in env, step_expr(form, elem, base_expr(form, rest)), out res, typ, ref s)

    case EFor(form, List(GIf(cond); more), elem, rest) =>
      call infer(in env, EIte(cond, EFor(form, more, elem, rest), base_expr(form, rest)), out res, typ, ref s)

    case EFor(form, List(g; more), elem, rest) =>
      call generator(in env, form, g, more, elem, rest, out res, typ, ref s)
  end

// the fold of the module of the type of the container of generator g, which must be known after the container, applied to
// the container, the base of the form, and the function of a step, whose body adds the elements of the generators after g
procedure generator(
  in  env: Env,
      form: Form,
      g: Gen,
      more: List[Gen],
      elem: Yield,
      rest: Option[Expr],
  out e1: Expr,
      t: Type,
  ref s: State
) :=
  local c: Expr, u: Type, f1: Expr, x: Var, w: Type
  call   infer(in env, gen_container(g), out c, u, ref s)
  call   solve(ref s)
  assign x := Var(unqualified("(container)"), u), w := zonk_type(s.sub, u)
  match w
    case TSort(Name(Some(m), _), targs) =>
      if not declares_fold(s.sig, m, fold_name(form)) then
        raise NoFold(w, fold_name(form))
      end
      call infer(in bind(List(x)) ++ env, fold_expr(form, m, targs, g, EVar(x), EFor(form, more, elem, Some(EVar(form_acc()))), base_expr(form, rest)), out f1, t, ref s)

    case _ =>
      raise UnknownContainer(w)
  end
  match f1
    case EApp(f, List(_; args)) =>
      assign e1 := EApp(f, List(c; args))
    case _ =>
      assign e1 := f1
  end

// foldr for lists, which come out in the order of the container, and foldl for the others
function fold_name(form: Form): Id :=
  if form == FList then "foldr" else "foldl"

function declares_fold(sig: Sig, m: Id, fold: Id): Bool :=
  exists(schemes_of(sig, Name(Some(m), fold)), lambda sc => match sc.typ
    case TFun(args, _) =>
      size(args) == 3
    case _ =>
      false
  end)

function form_app(m: Id, f: Id, args: List[Expr]): Expr :=
  ECall(Name(Some(m), f), THole, args)

// the accumulator of the folds, which users cannot name
function form_acc(): Var :=
  Var(unqualified("(acc)"), THole)

// the container that a form adds its elements to, its rest or else the empty one
function base_expr(form: Form, rest: Option[Expr]): Expr :=
  match (rest, form)
    case (Some(r), _) =>
      r

    case (None, FList) =>
      ENil(THole)

    case (None, FSet) =>
      form_app(library_module("set"), "empty", List())

    case (None, _) =>
      form_app(library_module("map"), "empty", List())
  end

// base with elem added, which comes first in a list, and whose key counts in a map
function step_expr(form: Form, elem: Yield, base: Expr): Expr :=
  match (form, elem)
    case (FMap, YPair(k, v)) =>
      form_app(library_module("map"), "put", List(k, v, base))

    case (FMap, YVal(e)) =>
      form_app(library_module("map"), "put", List(
        ECall(library_name("prelude", "first"), THole, List(e)),
        ECall(library_name("prelude", "second"), THole, List(e)),
        base))

    case (FSet, YVal(e)) =>
      form_app(library_module("set"), "insert", List(e, base))

    case (_, YVal(e)) =>
      ECons(THole, e, base)

    case (_, YPair(k, v)) =>
      ECons(THole, ETuple(List(k, v)), base)
  end

// List(a, b; r) is Cons(a, Cons(b, r)), Set(a, b; r) is insert(a, insert(b, r)), Map(k => v, l => w; r) is
// put(l, w, put(k, v, r)), so that the last entry of a key counts, and Array(a, b) is from_list(List(a, b))
function form_expr(form: Form, elems: List[Yield], rest: Option[Expr]): Expr :=
  match form
    case FArray =>
      form_app(library_module("array"), "from_list", List(form_expr(FList, elems, None)))

    case FMap =>
      foldl(elems, base_expr(form, rest), lambda acc, e => step_expr(form, e, acc))

    case _ =>
      foldr(elems, base_expr(form, rest), lambda e, acc => step_expr(form, e, acc))
  end

function gen_container(g: Gen): Expr :=
  match g
    case GVal(_, c) =>
      c

    case GPair(_, _, c) =>
      c

    case GIf(c) =>
      c
  end

// the fold of module m over container c into base, by foldr for lists, so that prepending keeps the order, and else by foldl,
// so that the steps run in the order of the generators, whose function binds the pattern of g and computes body, where a
// pattern that is no variable is matched, and the fold of a map takes key and value
function fold_expr(form: Form, m: Id, targs: List[Type], g: Gen, c: Expr, body: Expr, base: Expr): Expr :=
  let fold := fold_name(form), acc := form_acc() in
  match g
    case GPair(k, v, _) =>
      let kx := formal_of(k, "(key)", key_type(targs)), vx := formal_of(v, "(value)", value_type(targs)) in
      form_app(m, fold, List(
        c,
        base,
        ELam(if fold == "foldr" then List(kx, vx, acc) else List(acc, kx, vx), matched(List((kx, k), (vx, v)), body))))

    case GVal(p, _) if m == library_module("map") =>
      let kx := Var(unqualified("(key)"), key_type(targs)), vx := Var(unqualified("(value)"), value_type(targs)) in
      form_app(m, fold, List(
        c,
        base,
        ELam(if fold == "foldr" then List(kx, vx, acc) else List(acc, kx, vx), EMatch(ETuple(List(EVar(kx), EVar(vx))), List(Branch("", p, None, body))))))

    case GVal(p, _) =>
      let x := formal_of(p, "(element)", key_type(targs)) in
      form_app(m, fold, List(
        c,
        base,
        ELam(if fold == "foldr" then List(x, acc) else List(acc, x), matched(List((x, p)), body))))

    case GIf(_) =>
      body
  end

// the types of the first and second type argument of a container, which are those of the elements, or keys and values
function key_type(targs: List[Type]): Type :=
  match targs
    case List(t; _) =>
      t
    case List() =>
      THole
  end

function value_type(targs: List[Type]): Type :=
  match targs
    case List(_, t; _) =>
      t
    case _ =>
      THole
  end

// the variable of a pattern that is one, and else a formal that users cannot name
function formal_of(p: Pat, name: Id, typ: Type): Var :=
  match p
    case PVar(x) =>
      Var(x.name, typ)
    case _ =>
      Var(unqualified(name), typ)
  end

// body under a match of the formals against the patterns that are not variables
function matched(pairs: List[Var * Pat], body: Expr): Expr :=
  match List(for q in pairs if not is_pvar(second(q)))
    case List() =>
      body

    case List((x, p)) =>
      EMatch(EVar(x), List(Branch("", p, None, body)))

    case ps =>
      EMatch(ETuple(List(for q in ps yield EVar(first(q)))), List(Branch("", PTuple(seconds(ps)), None, body)))
  end

function is_pvar(p: Pat): Bool :=
  match p
    case PVar(_) =>
      true
    case _ =>
      false
  end

// overloaded names are resolved by their number of arguments and the types of the arguments and the result,
// where the arguments are inferred first
procedure application(
  in  env: Env,
      f: Expr,
      args: List[Expr],
  out e1: Expr,
      t: Type,
  ref s: State
) :=
  match f
    case EName(name, typ) =>
      local cs: List[Name * Scheme] := candidates(s, env, name), x: Var, f1: Expr, u: Type, w: Type, args1: List[Expr], ts: List[Type]
      if size(cs) > 1 then
        call infers_first(in env, args, out args1, ts, ref s)
        call fresh(out t, ref s)
        call normalize(in typ, out w, ref s)
        call unify(in w, TFun(ts, t), ref s)
        if with_arity(cs, size(args)) == List() then
          raise WrongArity(name, size(args))
        end
        call   use_name(in name, with_arity(cs, size(args)), w, out x, ref s)
        call   infers_lambdas(in env, args, ts, ref args1, s)
        assign e1 := EApp(EVar(x), args1)
      else
        call   infer(in env, f, out f1, u, ref s)
        call   apply(in env, u, args, out args1, t, ref s)
        assign e1 := EApp(f1, args1)
      end

    case ELam(_, _) =>
      local f1: Expr, args1: List[Expr], ts: List[Type]
      call   infers(in env, args, out args1, ts, ref s)
      call   fresh(out t, ref s)
      call   infer_lambda(in env, f, TFun(ts, t), out f1, ref s)
      assign e1 := EApp(f1, args1)

    case _ =>
      local f1: Expr, u: Type, args1: List[Expr]
      call   infer(in env, f, out f1, u, ref s)
      call   apply(in env, u, args, out args1, t, ref s)
      assign e1 := EApp(f1, args1)
  end

// the accessor T.f, or for the suffix .f:= the updater T.f:=, applied to e and the further arguments, of the type T of e,
// of the module of T, where an unknown type of e is an error
procedure field_access(
  in  env: Env,
      suffix: Id,
      expr: Expr,
      rest: List[Expr],
  out e1: Expr,
      t: Type,
  ref s: State
) :=
  local c: Expr, u: Type, w: Type, rest1: List[Expr], us: List[Type], x: Var
  call infer(in env, expr, out c, u, ref s)
  call infers(in env, rest, out rest1, us, ref s)
  call fresh(out t, ref s)
  call fresh(out w, ref s)
  call unify(in w, TFun(List(u; us), t), ref s)
  call solve(ref s)
  match zonk_type(s.sub, u)
    case TSort(Name(Some(m), base), _) =>
      local acc: Name := Name(Some(m), base ++ suffix)
      match schemes_of(s.sig, acc)
        case List(sc) if is_visible(s, acc) =>
          call use(in acc, w, sc, out x, ref s)
        case _ =>
          raise UnknownField(acc)
      end

    case TMeta(_) =>
      raise UnknownFieldOwner(suffix)

    case v =>
      raise UnknownFieldType(suffix, v)
  end
  assign e1 := EApp(EVar(x), List(c; rest1))

procedure apply(
  in  env: Env,
      f: Type,
      args: List[Expr],
  out args1: List[Expr],
      r: Type,
  ref s: State
) :=
  local ts: List[Type]
  call fresh(out r, ref s)
  call infers_first(in env, args, out args1, ts, ref s)
  call unify(in f, TFun(ts, r), ref s)
  call infers_lambdas(in env, args, ts, ref args1, s)

// the arguments in order, except the lambdas, which get an unknown type and wait until the type of the function is
// known, so that the formals of a lambda have the types that the function expects, see infers_lambdas
procedure infers_first(
  in  env: Env,
      exprs: List[Expr],
  out es1: List[Expr],
      ts: List[Type],
  ref s: State
) :=
  local e1: Expr, t: Type
  assign es1 := List(), ts := List()
  for e in exprs do
    if is_lambda(e) then
      call   fresh(out t, ref s)
      assign e1 := e
    else
      call infer(in env, e, out e1, t, ref s)
    end
    assign es1 := es1 ++ List(e1), ts := ts ++ List(t)
  end

function is_lambda(e: Expr): Bool :=
  match e
    case ELam(_, _) =>
      true
    case _ =>
      false
  end

// the lambdas among exprs, whose types are those in ts, inferred with the formals that have no type typed by the parameters
// of the function type there, if it is known
procedure infers_lambdas(
  in  env: Env,
      exprs: List[Expr],
      types: List[Type],
  ref res: List[Expr],
      s: State
) :=
  local found: List[Expr] := List(), e2: Expr
  for ((e, e1), t) in zip(zip(exprs, res), types) do
    if is_lambda(e) then
      call infer_lambda(in env, e, t, out e2, ref s)
    else
      assign e2 := e1
    end
    assign found := found ++ List(e2)
  end
  assign res := found

procedure infer_lambda(
  in  env: Env,
      e: Expr,
      t: Type,
  out e1: Expr,
  ref s: State
) :=
  local u: Type
  match (e, zonk_type(s.sub, t))
    case (ELam(formals, body), TFun(ps, _)) if size(ps) == size(formals) =>
      call infer(in env, ELam(List(for (x, p) in zip(formals, ps) yield if x.typ == THole then Var(x.name, p) else x), body), out e1, u, ref s)
    case _ =>
      call infer(in env, e, out e1, u, ref s)
  end
  call unify(in u, t, ref s)

procedure check(in env: Env, expr: Expr, t: Type, out e1: Expr, ref s: State) :=
  local u: Type
  if is_lambda(expr) then
    call infer_lambda(in env, expr, t, out e1, ref s)
  else
    call infer(in env, expr, out e1, u, ref s)
    call unify(in u, t, ref s)
  end

// the expressions of what, checked against the types ts, as many
procedure checks(
  in  env: Env,
      what: Str,
      exprs: List[Expr],
      ts: List[Type],
  out es1: List[Expr],
  ref s: State
) :=
  match (exprs, ts)
    case (List(e; more), List(t; ts1)) =>
      local e1: Expr, rest: List[Expr]
      call   check(in env, e, t, out e1, ref s)
      call   checks(in env, what, more, ts1, out rest, ref s)
      assign es1 := List(e1; rest)

    case (List(), List()) =>
      assign es1 := List()

    case _ =>
      raise CountMismatch(what, "values", size(ts), size(exprs))
  end

procedure infers(
  in  env: Env,
      exprs: List[Expr],
  out es1: List[Expr],
      ts: List[Type],
  ref s: State
) :=
  local e1: Expr, t: Type
  assign es1 := List(), ts := List()
  for e in exprs do
    call   infer(in env, e, out e1, t, ref s)
    assign es1 := es1 ++ List(e1), ts := ts ++ List(t)
  end

procedure expr_branches(
  in  env: Env,
      cases: List[Branch[Expr]],
      t: Type,
      r: Type,
  out cases1: List[Branch[Expr]],
  ref s: State
) :=
  match cases
    case List() =>
      assign cases1 := List()

    case List(Branch(doc, pat, g, body); more) =>
      local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Expr, rest: List[Branch[Expr]]
      call   typed_pattern(in pat, t, out p1, xs, ref s)
      call   unhidden(in env, xs)
      call   guard(in bind(xs) ++ env, g, out g1, ref s)
      call   check(in bind(xs) ++ env, body, r, out b1, ref s)
      call   expr_branches(in env, more, t, r, out rest, ref s)
      assign cases1 := List(Branch(doc, p1, g1, b1); rest)
  end

procedure guard(
  in  env: Env,
      g: Option[Expr],
  out g1: Option[Expr],
  ref s: State
) :=
  match g
    case Some(e) =>
      local e1: Expr
      call   check(in env, e, TBool(), out e1, ref s)
      assign g1 := Some(e1)

    case None =>
      assign g1 := None
  end

// guarded cases neither cover values for exhaustiveness nor make later cases unreachable
procedure coverage(in s: State, t: Type, cs: List[Pat * Bool]) :=
  call reachable(in s, t, List(), cs)
  match missing(s.sig, s.sub, List(for p in unguarded(cs) yield List(p)), List(t))
    case Some(List(w; _)) =>
      raise NotExhaustive(w)
    case _ =>
      skip
  end

function unguarded(cs: List[Pat * Bool]): List[Pat] :=
  List(for (p, g) in cs if g yield p)

procedure reachable(
  in  s: State,
      t: Type,
      before: List[Pat],
      cs: List[Pat * Bool]
) :=
  match cs
    case List() =>
      skip

    case List((p, open); rest) =>
      if not is_useful(s.sig, s.sub, List(for q in before yield List(q)), List(p), List(t)) then
        raise Unreachable(p)
      end
      if open then
        call reachable(in s, t, before ++ List(p), rest)
      else
        call reachable(in s, t, before, rest)
      end
  end

procedure typed_pattern(
  in  pat: Pat,
      t: Type,
  out p1: Pat,
      xs: List[Var],
  ref s: State
) :=
  call binders(in pat, t, out p1, xs, ref s)
  call unique(in "pattern variable", List(for x in xs yield x.name))

procedure binders(
  in  pat: Pat,
      t: Type,
  out p1: Pat,
      xs: List[Var],
  ref s: State
) :=
  match pat
    case PWild =>
      assign p1 := pat, xs := List()

    case PLit(lit) =>
      call   unify(in literal(lit), t, ref s)
      assign p1 := pat, xs := List()

    case PName(name, typ) =>
      local u: Type
      if overloads(s, name, lambda n => is_pattern_name(s.sig, n)) != List() then
        call binders(in PApp(name, List()), t, out p1, xs, ref s)
      else
        call   normalize(in typ, out u, ref s)
        call   unify(in u, t, ref s)
        assign p1 := PName(name, u), xs := List(Var(name, u))
      end

    case PApp(constr, args) =>
      local m: List[Type * Type], qs: List[Pat], k: Name
      match overloads(s, constr, lambda n => is_pattern_name(s.sig, n))
        case List(k1) =>
          assign k := k1

        case List() =>
          raise UnknownConstructor(constr)

        case ks =>
          call pattern_constructor(in constr, ks, size(args), t, out k, ref s)
      end
      match pat_head(s.sig, k)
        case Some(head) =>
          call same_length(in head.what ++ " " ++ k.base, "arguments", size(head.args), size(args))
          call instance(in head.params, out m, ref s)
          call unify(in subst(head.typ, m), t, ref s)
          call binder_list(in args, List(for a in head.args yield subst(a, m)), out qs, xs, ref s)
          match pat_alias_of(s.sig, k)
            case Some(alias) =>
              assign p1 := subst_pat(alias.pat, zip(List(for x in alias.formals yield x.name), qs))
            case None =>
              assign p1 := PApp(k, qs)
          end

        case None =>
          raise UnknownConstructor(constr)
      end

    case PTuple(args) =>
      local qs: List[Pat], ts: List[Type]
      call   fresh_list(in args, out ts, ref s)
      call   unify(in TTuple(ts), t, ref s)
      call   binder_list(in args, ts, out qs, xs, ref s)
      assign p1 := PTuple(qs)
  end

// the one of the constructors ks with k arguments whose datatype fits t, where open uses are solved first if
// several fit, since the variables of the pattern need their types
procedure pattern_constructor(
  in  n: Name,
      ks: List[Name],
      k: Int,
      t: Type,
  out c: Name,
  ref s: State
) :=
  local ok: List[(Name * Scheme) * State]
  call trials(in results(s.sig, ks, k), t, s, out ok)
  if size(ok) > 1 then
    call solve(ref s)
    call trials(in results(s.sig, ks, k), t, s, out ok)
  end
  match ok
    case List(((c1, _), _)) =>
      assign c := c1

    case List() =>
      raise NoOverload(n, zonk_type(s.sub, t))

    case _ =>
      raise Ambiguous(n, firsts(ok))
  end

// the constructors and pattern aliases of ks with k arguments, each with the scheme of the type that it matches
function results(sig: Sig, ks: List[Name], k: Int): List[Name * Scheme] :=
  match ks
    case List() =>
      List()

    case List(n; rest) =>
      match pat_head(sig, n)
        case Some(head) if size(head.args) == k =>
          List((n, Scheme(head.params, head.typ)); results(sig, rest, k))
        case _ =>
          results(sig, rest, k)
      end
  end

// the head of a pattern, a constructor or a pattern alias, named by what it is, with the params of its declaration, the
// types of its arguments, and the type that it matches
data PatHead :=
  case PatHead(what: Str, params: List[Type], args: List[Type], typ: Type)

function pat_head(sig: Sig, n: Name): Option[PatHead] :=
  match (constr_of(sig, n), pat_alias_of(sig, n))
    case (Some(decl), _) =>
      Some(PatHead("constructor", decl.params, decl.fields, decl.typ))

    case (None, Some(alias)) =>
      Some(PatHead("pattern alias", alias.params, List(for x in alias.formals yield x.typ), alias.typ))

    case (None, None) =>
      None
  end

procedure binder_list(
  in  pats: List[Pat],
      ts: List[Type],
  out qs: List[Pat],
      xs: List[Var],
  ref s: State
) :=
  match (pats, ts)
    case (List(p; more), List(t; ts1)) =>
      local q: Pat, ys: List[Var], rest: List[Pat], zs: List[Var]
      call   binders(in p, t, out q, ys, ref s)
      call   binder_list(in more, ts1, out rest, zs, ref s)
      assign qs := List(q; rest), xs := ys ++ zs

    case (List(), List()) =>
      assign qs := List(), xs := List()

    case _ =>
      raise CountMismatch("the pattern", "components", size(ts), size(pats))
  end

procedure variable(
  in  env: Env,
      assignable: List[Name],
      x: Var,
  out y: Var,
  ref s: State
) :=
  match x
    case Var(name, typ) =>
      local u: Type
      if not contains(name, assignable) then
        raise NotAssignable(name)
      end
      match get(name, env)
        case Some(l) =>
          call   normalize(in typ, out u, ref s)
          call   unify(in l.scheme.typ, u, ref s)
          assign y := Var(name, l.scheme.typ)

        case None =>
          raise UnknownVariable(name)
      end
  end

procedure variables(
  in  env: Env,
      assignable: List[Name],
      xs: List[Var],
  out ys: List[Var],
  ref s: State
) :=
  call map_state(in xs, lambda in x: Var, out y: Var, ref r: State =>
    call variable(in env, assignable, x, out y, ref r)
  end, out ys, ref s)

// env tells which variables are assigned on every path to x, and after it
procedure statement(
  in  assignable: List[Name],
      stmt: Stmt,
  out y: Stmt,
  ref env: Env,
      s: State
) :=
  match stmt
    case SSkip =>
      assign y := stmt

    case SAssign(upd) =>
      local ys: List[Var], exprs: List[Expr]
      call   unique(in "assignment to", List(for x in firsts(upd) yield x.name))
      call   variables(in env, assignable, firsts(upd), out ys, ref s)
      call   checks(in env, "the assignment", seconds(upd), List(for x in ys yield x.typ), out exprs, ref s)
      assign y := SAssign(zip(ys, exprs)), env := assigned(env, List(for x in ys yield x.name))

    // the types of locals that are initialized at the start of the block may be inferred
    case SBlock(locals, stmts) =>
      local ys: List[Var], xs: List[Stmt], inner: Env
      call   untyped(in locals, initialized(stmts))
      call   formals(in "local", locals, out ys, ref s)
      call   unhidden(in env, ys)
      assign inner := unassigned(ys) ++ env
      call   statements(in List(for x in ys yield x.name) ++ assignable, stmts, out xs, ref inner, s)
      assign y := SBlock(ys, xs), env := drop(size(ys), inner)

    case SIf(cond, left, right) =>
      local c: Expr, l: Stmt, r: Stmt, other: Env
      call   check(in env, cond, TBool(), out c, ref s)
      assign other := env
      call   statement(in assignable, left, out l, ref env, s)
      call   statement(in assignable, right, out r, ref other, s)
      assign y := SIf(c, l, r), env := joined(env, other)

    case SWhile(cond, body) =>
      local c: Expr, l: Stmt, inner: Env
      call   check(in env, cond, TBool(), out c, ref s)
      assign inner := env
      call   statement(in assignable, body, out l, ref inner, s)
      assign y := SWhile(c, l)

    // a procedure that a variable holds and the refs are read
    case SCall(proc, ins, outs, refs) =>
      call   call_proc(in env, assignable, proc, ins, outs, refs, out y, ref s)
      call   readables(in env, List(proc; List(for x in refs yield x.name)))
      assign env := assigned(env, List(for x in outs ++ refs yield x.name))

    case SMatch(arg, cases) =>
      local c: Expr, t: Type, bs: List[Branch[Stmt]]
      call   infer(in env, arg, out c, t, ref s)
      call   stmt_branches(in assignable, cases, t, out bs, ref env, s)
      call   solve(ref s)
      call   coverage(in s, t, List(for br in bs yield case_of(br)))
      assign y := SMatch(c, bs)

    case SAssert(cond) =>
      local c: Expr
      call   check(in env, cond, TBool(), out c, ref s)
      assign y := SAssert(c)
      if c == ELit(LBool(false)) then
        assign env := unreachable(env)
      end

    case SRaise(value, typ) =>
      local c: Expr, t: Type, u: Type
      call   infer(in env, value, out c, t, ref s)
      call   normalize(in typ, out u, ref s)
      call   unify(in t, u, ref s)
      assign y := SRaise(c, t), env := unreachable(env)

    case STry(body, catches) =>
      local l: Stmt, hs: List[Catch], other: Env := env
      call   statement(in assignable, body, out l, ref env, s)
      call   handler_list(in assignable, catches, out hs, ref other, s)
      assign y := STry(l, hs), env := joined(env, other)
  end

// the variables that the leading assignments of a block assign one at a time, as local x := e does
function initialized(xs: List[Stmt]): List[Name] :=
  match xs
    case List(SAssign(List((x, _))); rest) =>
      List(x.name; initialized(rest))
    case _ =>
      List()
  end

// the locals without a type are initialized
procedure untyped(in xs: List[Var], inits: List[Name]) :=
  match xs
    case List() =>
      skip

    case List(Var(name, typ); rest) =>
      if has_holes(typ) and not contains(name, inits) then
        raise MissingType(name)
      end
      call untyped(in rest, inits)
  end

procedure statements(
  in  assignable: List[Name],
      xs: List[Stmt],
  out ys: List[Stmt],
  ref env: Env,
      s: State
) :=
  local stmt: Stmt
  assign ys := List()
  for x in xs do
    call   statement(in assignable, x, out stmt, ref env, s)
    assign ys := ys ++ List(stmt)
  end

// the procedures of the program hide the builtin ones
// a variable of a procedure type hides the procedures of that name
procedure call_proc(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match get(p, env)
    case Some(l) =>
      call call_variable(in env, assignable, p, l.scheme, ins, outs, refs, out stmt, ref s)
    case None =>
      call call_declared(in env, assignable, p, ins, outs, refs, out stmt, ref s)
  end

procedure call_variable(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      sc: Scheme,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  local x: Var, w: Type, is: List[Type], os: List[Type], rs: List[Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]
  call   fresh(out w, ref s)
  call   use(in p, w, sc, out x, ref s)
  call   fresh_list(in ins, out is, ref s)
  call   fresh_list(in outs, out os, ref s)
  call   fresh_list(in refs, out rs, ref s)
  call   unify(in x.typ, TProc(is, os, rs), ref s)
  call   unique(in "out or ref", List(for y in outs ++ refs yield y.name))
  call   checks(in env, "procedure " ++ p.base, ins, is, out ins1, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   unifies(in List(for y in outs1 ++ refs1 yield y.typ), os ++ rs, ref s)
  assign stmt := SCall(p, ins1, outs1, refs1)

procedure call_declared(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match overloads(s, p, lambda q => is_proc(s.sig, q))
    case List(q) =>
      call declared_call(in env, assignable, p, q, ins, outs, refs, out stmt, ref s)

    case List() =>
      call declared_call(in env, assignable, p, p, ins, outs, refs, out stmt, ref s)

    case qs =>
      call overloaded_call(in env, assignable, p, qs, ins, outs, refs, out stmt, ref s)
  end

// a call of one of the procedures qs, by the types of its arguments, where the arguments are inferred first
procedure overloaded_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      qs: List[Name],
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  local ins1: List[Expr], is: List[Type], outs1: List[Var], refs1: List[Var], m: Name
  call   unique(in "out or ref", List(for x in outs ++ refs yield x.name))
  call   infers(in env, ins, out ins1, is, ref s)
  call   variables(in env, assignable, outs, out outs1, ref s)
  call   variables(in env, assignable, refs, out refs1, ref s)
  call   choose(in p, List(for q in qs yield (q, proc_scheme(s.sig, q))), TProc(is, List(for x in outs1 yield x.typ), List(for x in refs1 yield x.typ)), out m, ref s)
  assign stmt := SCall(m, ins1, outs1, refs1)

procedure declared_call(
  in  env: Env,
      assignable: List[Name],
      p: Name,
      q: Name,
      ins: List[Expr],
      outs: List[Var],
      refs: List[Var],
  out stmt: Stmt,
  ref s: State
) :=
  match proc_of(s.sig, q)
    case Some(proc) =>
      local m: List[Type * Type], ins1: List[Expr], outs1: List[Var], refs1: List[Var]
      call   instance(in proc.params, out m, ref s)
      call   same_length(in "procedure " ++ q.base, "ins", size(proc.ins), size(ins))
      call   same_length(in "procedure " ++ q.base, "outs", size(proc.outs), size(outs))
      call   same_length(in "procedure " ++ q.base, "refs", size(proc.refs), size(refs))
      call   unique(in "out or ref", List(for x in outs ++ refs yield x.name))
      call   checks(in env, "procedure " ++ q.base, ins, List(for t in proc.ins yield subst(t, m)), out ins1, ref s)
      call   variables(in env, assignable, outs, out outs1, ref s)
      call   variables(in env, assignable, refs, out refs1, ref s)
      call   unifies(in List(for x in outs1 ++ refs1 yield x.typ), List(for t in proc.outs ++ proc.refs yield subst(t, m)), ref s)
      assign stmt := SCall(q, ins1, outs1, refs1)

    case None =>
      raise UnknownProcedure(p)
  end

// env joins what the cases assign, where a match that no case fits raises
procedure stmt_branches(
  in  assignable: List[Name],
      cases: List[Branch[Stmt]],
      t: Type,
  out cases1: List[Branch[Stmt]],
  ref env: Env,
      s: State
) :=
  match cases
    case List() =>
      assign cases1 := List(), env := unreachable(env)

    case List(Branch(doc, pat, g, body); more) =>
      local p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Branch[Stmt]], inner: Env
      call   typed_pattern(in pat, t, out p1, xs, ref s)
      call   unhidden(in env, xs)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out g1, ref s)
      call   statement(in assignable -- List(for x in xs yield x.name), body, out b1, ref inner, s)
      call   stmt_branches(in assignable, more, t, out rest, ref env, s)
      assign cases1 := List(Branch(doc, p1, g1, b1); rest), env := joined(drop(size(xs), inner), env)
  end

// handlers start from the variables before the try, which an exception restores
procedure handler_list(
  in  assignable: List[Name],
      hs: List[Catch],
  out hs1: List[Catch],
  ref env: Env,
      s: State
) :=
  match hs
    case List() =>
      assign hs1 := List(), env := unreachable(env)

    case List(Catch(doc, typ, pat, g, body); more) =>
      local u: Type, p1: Pat, xs: List[Var], g1: Option[Expr], b1: Stmt, rest: List[Catch], inner: Env
      call   normalize(in typ, out u, ref s)
      call   typed_pattern(in pat, u, out p1, xs, ref s)
      call   unhidden(in env, xs)
      assign inner := bind(xs) ++ env
      call   guard(in inner, g, out g1, ref s)
      call   statement(in assignable -- List(for x in xs yield x.name), body, out b1, ref inner, s)
      call   handler_list(in assignable, more, out rest, ref env, s)
      assign hs1 := List(Catch(doc, u, p1, g1, b1); rest), env := joined(drop(size(xs), inner), env)
  end

procedure declare_name(in sig: Sig, n: Name) :=
  if is_fun(sig, n) or is_proc(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n) or builtin_schemes(unqualified(n.base)) != List() then
    raise AlreadyDefined(n)
  end

// functions of the same name must differ in their number of arguments, while they may overload builtins
procedure overload(in sig: Sig, n: Name, k: Int) :=
  if is_proc(sig, n) or is_constr(sig, n) or is_pat_alias(sig, n) or has_arity(schemes_of(sig, n), k) then
    raise AlreadyDefined(n)
  end

procedure declare_sort(in sig: Sig, n: Name) :=
  if n.base == "->" or is_type_alias(sig, n) or is_data(sig, n) then
    raise SortDefined(n)
  end

procedure closed(in n: Name, ps: List[Id], ts: List[Type]) :=
  local undeclared := distinct(List(for t in ts for v in free(t) yield v)) -- params(ps)
  if undeclared != List() then
    raise UndeclaredParams(n, undeclared)
  end

// datatypes may be mutually recursive, so they are known before any sort is checked
procedure declare_datas(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(name, params, _) =>
        assign s := enter(s, m)
        call   declare_sort(in s.sig, name)
        assign s := with_sig(s, with_data(s.sig, name, size(params)))

      case _ =>
        skip
    end
  end

procedure declare_sorts(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CSort(name, params, typ) =>
        local u: Type
        assign s := enter(s, m)
        call   declare_sort(in s.sig, name)
        call   unique_ids(in "type parameter", params)
        call   known(in typ, name, out u, ref s)
        call   closed(in name, params, List(u))
        assign s := with_sig(s, with_type_alias(s.sig, name, TypeAlias(params, u)))

      case _ =>
        skip
    end
  end

procedure declare_constrs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CData(n, params, constrs) =>
        assign s := enter(s, m)
        call   unique_ids(in "type parameter", params)
        assign s := with_sig(s, with_members(s.sig, n, List(for k in constrs yield k.name)))
        call   declare_constructors(in n, params, constrs, ref s)
        call   declare_fields(in n, params, datatype_fields(s.sig, params, constrs), ref s)

      case _ =>
        skip
    end
  end

procedure declare_constructors(
  in  n: Name,
      ps: List[Id],
      ks: List[Constr],
  ref s: State
) :=
  local ts: List[Type]
  for Constr(_, name, fields) in ks do
    call   declare_name(in s.sig, name)
    call   knowns(in List(for field in fields yield field.typ), name, out ts, ref s)
    call   closed(in n, ps, ts)
    assign s := with_sig(s, with_constr(s.sig, name, ConstrSig(params(ps), ts, TSort(n, params(ps)))))
  end

// the accessor T.f and the updater T.f:= of each field f of the datatype T, which have no definitions, since the
// interpreter and the compiler implement them by the positions of the fields (fields of Defs)
procedure declare_fields(
  in  n: Name,
      ps: List[Id],
      fields: List[Id * Type],
  ref s: State
) :=
  local t := TSort(n, params(ps))
  for (f, u) in fields do
    assign s := with_sig(s, with_fun(with_fun(s.sig, accessor_name(n, f), Scheme(params(ps), TFun(List(t), u))), updater_name(n, f), Scheme(params(ps), TFun(List(t, u), t))))
  end

// each field of the constructors once, with its type as the constructor that declares it first has it, which is that of
// the others, since the parser rejects a field with different types
function datatype_fields(sig: Sig, ps: List[Id], ks: List[Constr]): List[Id * Type] :=
  first_fields(List(for k in ks for p in zip(List(for field in k.fields yield field.name), constr_fields(sig, k.name, params(ps))) yield p))

function first_fields(fields: List[Id * Type]): List[Id * Type] :=
  match fields
    case List() =>
      List()
    case List((f, u); rest) =>
      List((f, u); first_fields(List(for p in rest if first(p) != f)))
  end

procedure declare_funs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CFun(name, ps, formals, typ, _) =>
        local xs: List[Var], r: Type
        assign s := enter(s, m)
        call   overload(in s.sig, name, size(formals))
        call   unique_ids(in "type parameter", ps)
        call   unique(in "formal", List(for x in formals yield x.name))
        call   signature(in formals, out xs, ref s)
        call   known(in typ, name, out r, ref s)
        call   closed(in name, ps, List(TFun(List(for x in xs yield x.typ), r)))
        assign s := with_sig(s, with_fun(s.sig, name, Scheme(params(ps), TFun(List(for x in xs yield x.typ), r))))

      case _ =>
        skip
    end
  end

// each alias after the constructors and the aliases before it, so that aliases do not recur, with the function of the
// same name that builds its values where its pattern has no _
procedure declare_pat_aliases(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CPatAlias(name, ps, formals, typ, pat) =>
        local xs: List[Var], r: Type, checked: Pat, ys: List[Var]
        assign s := enter(s, m)
        call   declare_name(in s.sig, name)
        call   unique_ids(in "type parameter", ps)
        call   signature(in formals, out xs, ref s)
        call   known(in typ, name, out r, ref s)
        call   closed(in name, ps, List(TFun(List(for x in xs yield x.typ), r)))
        call   typed_pattern(in pat, r, out checked, ys, ref s)
        if Set(for y in ys yield y.name) != Set(for x in xs yield x.name) then
          raise AliasVariables(name)
        end
        for y in ys do
          call unify(in y.typ, value_or(map_option(find(xs, lambda x => x.name == y.name), lambda x => x.typ), y.typ), ref s)
        end
        call   solve(ref s)
        assign s := with_sig(s, with_pat_alias(s.sig, name, PatAlias(params(ps), xs, r, zonk_pat(s, checked))))
        if pattern_expr(pat) != None then
          assign s := with_sig(s, with_fun(s.sig, name, Scheme(params(ps), TFun(List(for x in xs yield x.typ), r))))
        end

      case _ =>
        skip
    end
  end

procedure declare_procs(in cs: List[Id * Cmd], ref s: State) :=
  for (m, cmd) in cs do
    match cmd
      case CProc(name, ps, ins, outs, refs, _) =>
        local xs: List[Var], ts: List[Type]
        assign s := enter(s, m)
        call   declare_name(in s.sig, name)
        call   unique_ids(in "type parameter", ps)
        call   signature(in ins ++ outs ++ refs, out xs, ref s)
        assign ts := List(for x in xs yield x.typ)
        call   closed(in name, ps, ts)
        assign s := match split_at(size(ins), ts)
          case (in_types, others) =>
            match split_at(size(outs), others)
              case (out_types, ref_types) =>
                with_sig(s, with_proc(s.sig, name, ProcSig(params(ps), in_types, out_types, ref_types)))
            end
        end

      case _ =>
        skip
    end
  end

procedure command(in cmd: Cmd, out c1: Cmd, ref s: State) :=
  match cmd
    case CFun(name, params, formals, typ, body) =>
      local xs: List[Var], r: Type, b: Expr
      call   signature(in formals, out xs, ref s)
      call   known(in typ, name, out r, ref s)
      call   check(in bind(xs), body, r, out b, ref s)
      assign c1 := CFun(name, params, xs, r, b)

    case CProc(name, params, ins, outs, refs, stmt) =>
      local is: List[Var], os: List[Var], rs: List[Var], y: Stmt, env: Env
      call   signature(in ins, out is, ref s)
      call   signature(in outs, out os, ref s)
      call   signature(in refs, out rs, ref s)
      assign env := bind(is) ++ unassigned(os) ++ bind(rs)
      call   statement(in List(for x in os ++ rs yield x.name), stmt, out y, ref env, s)
      call   outputs(in name, os, env)
      assign c1 := CProc(name, params, is, os, rs, y)

    case CTest(test_name, List(), stmt) =>
      local y: Stmt, env: Env := List()
      call   statement(in List(), stmt, out y, ref env, s)
      assign c1 := CTest(test_name, List(), y)

    case CTest(test_name, _, _) =>
      raise TestParams(test_name)

    case _ =>
      assign c1 := cmd
  end

procedure commands(in cs: List[Id * Cmd], out cs1: List[Cmd], ref s: State) :=
  match cs
    case List() =>
      assign cs1 := List()

    case List((m, c); more) =>
      local c1: Cmd, c2: Cmd, rest: List[Cmd]
      assign s := enter(s, m)
      call   command(in c, out c1, ref s)
      call   settle(ref s)
      assign c2 := zonk_cmd(s, c1)
      match unknown_in_cmd(c2)
        case Some(t) =>
          raise UnknownException(t)
        case None =>
          skip
      end
      call   commands(in more, out rest, ref s)
      assign cs1 := List(c2; rest)
  end

// tests are chosen by name
function block_names(cs: List[Id * Cmd]): List[Id] :=
  match cs
    case List() =>
      List()

    case List((_, CTest(test_name, _, _)); more) =>
      List(test_name; block_names(more))

    case List(_; more) =>
      block_names(more)
  end

// only abstract types declare equalities, since matching tells the values of other datatypes apart by their constructors,
// and the orders and equalities of exported datatypes are exported, since they change what the builtins do for importers
procedure check_orders(
  in  cmds: List[Cmd],
      abstract: List[Name],
      hidden: Set[Name],
      hidden_sorts: List[Name]
) :=
  match cmds
    case List() =>
      skip

    case List(c; rest) =>
      match (c, order_of(c))
        case (_, Some((HookEquality, t))) if not contains(t, abstract) =>
          raise VisibleEquality(t)

        case (CFun(name, _, formals, _, _), None) =>
          match hook_of(name.base, size(formals))
            case Some(hook) =>
              raise MisshapenHook(name, hook)
            case None =>
              call check_orders(in rest, abstract, hidden, hidden_sorts)
          end

        case (CFun(name, _, _, _, _), Some((_, t))) if contains(name, hidden) and not contains(t, hidden_sorts) =>
          raise UnexportedOrder(name, t)

        case _ =>
          call check_orders(in rest, abstract, hidden, hidden_sorts)
      end
  end

// the order and equality of the abstract types of ds that their modules do not declare, which raise Unordered for a type
// with an equality, and Incomparable for a type without, since the structure of an abstract type is no order; all of them
// are private, check_package hides them from importers, so nothing that other modules use may be added here
function synthesized(ds: List[Id * Cmd], cmds: List[Cmd], natives: List[Name]): List[Id * Cmd] :=
  let compares := ordered(cmds, HookCompare) ++ natives, equalities := ordered(cmds, HookEquality) in
  List(for c in ds for e in synthesized_for(c, compares, equalities) yield e)

function synthesized_for(d: Id * Cmd, compares: List[Name], equalities: List[Name]): List[Id * Cmd] :=
  match d
    case (m, CAbstract(name, params)) =>
      if contains(name, compares) then
        List()
      else if contains(name, equalities) then
        List((m, failing(name, params, HookCompare, "Unordered")))
      else
        List(
          (m, failing(name, params, HookCompare, "Incomparable")),
          (m, failing(name, params, HookEquality, "Incomparable")))

    case _ =>
      List()
  end

function failing(t: Name, ps: List[Id], hook: Hook, e: Id): Cmd :=
  let a := TSort(t, params(ps)) in
  CFun(Name(t.module, t.base ++ "." ++ hook_name(hook)), ps, List(Var(unqualified("a"), a), Var(unqualified("b"), a)), hook_result(hook), ERaise(ECall(library_name("prelude", e), THole, List(ELit(LStr(format_name(t))))), THole))

// the commands of ds without signatures and abstract types, which only the checks of sections need
function is_definition(d: Id * Cmd): Bool :=
  match d
    case (_, CFunSig(_, _, _, _)) =>
      false

    case (_, CProcSig(_, _, _, _, _)) =>
      false

    case (_, CAbstract(_, _)) =>
      false

    case _ =>
      true
  end

function definitions(ds: List[Id * Cmd]): List[Id * Cmd] :=
  List(for d in ds if is_definition(d))

// the signatures and types of the builtin section of d as definitions to declare, whose definitions the interpreter and the
// runtime give, where a type is a datatype without constructors, whose values the interpreter and the runtime make
function natives(d: Mod): List[Id * Cmd] :=
  List(for c in commands_of(d.builtins) yield (d.name, native(qualify(d.name, c))))

function native(cmd: Cmd): Cmd :=
  match cmd
    case CFunSig(name, params, formals, typ) =>
      CFun(name, params, formals, typ, ELit(LUnit))

    case CProcSig(name, params, ins, outs, refs) =>
      CProc(name, params, ins, outs, refs, SSkip)

    case CAbstract(name, params) =>
      CData(name, params, List())

    case _ =>
      cmd
  end

// the types of the builtin sections of ds, which the interpreter and the runtime order, equate, and show
function native_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case List() =>
      List()

    case List((_, CData(name, _, _)); rest) =>
      List(name; native_types(rest))

    case List(_; rest) =>
      native_types(rest)
  end

function qualified_name(cmd: Cmd): Name :=
  match cmd
    case CFun(name, _, _, _, _) =>
      name
    case _ =>
      unqualified("")
  end

function abstract_types(ds: List[Id * Cmd]): List[Name] :=
  match ds
    case List() =>
      List()

    case List((_, CAbstract(name, _)); rest) =>
      List(name; abstract_types(rest))

    case List(_; rest) =>
      abstract_types(rest)
  end

// the declarations of an implementation section that the export section does not export, with the constructors and fields
// of abstract types
function private_names(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  List(for c in im for n in private_in(c, ex) yield n)

function private_in(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CFun(name, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then List() else List(name)

    case CProc(name, _, _, _, _, _) =>
      if exists(ex, lambda e => signs(e, name)) then List() else List(name)

    case CData(t, _, constrs) =>
      let members := List(for k in constrs yield k.name) ++ List(for f in field_names(constrs) for n in List(accessor_name(t, f), updater_name(t, f)) yield n) in
      if exists(ex, lambda e => abstracts(e, t)) then
        members
      else
        List(t; members)

    case CSort(name, _, _) =>
      List(name)

    case CPatAlias(name, _, _, _, _) =>
      List(name)

    case CTest(_, _, _) =>
      List()

    // notations, signatures, and abstract types, which enter_section of ulang/parse.u keeps out of implementation sections
    case _ =>
      List()
  end

// the sorts of an implementation section that the export section does not export, not even as abstract types
function private_sorts(ex: List[Cmd], im: List[Cmd]): List[Name] :=
  List(for c in im for n in private_sort(c, ex) yield n)

function private_sort(cmd: Cmd, ex: List[Cmd]): List[Name] :=
  match cmd
    case CData(name, _, _) =>
      if exists(ex, lambda e => abstracts(e, name)) then List() else List(name)

    case CSort(name, _, _) =>
      List(name)

    case _ =>
      List()
  end

function signs(e: Cmd, n: Name): Bool :=
  match e
    case CFunSig(name, _, _, _) =>
      name == n

    case CProcSig(name, _, _, _, _) =>
      name == n

    case _ =>
      false
  end

function abstracts(e: Cmd, t: Name): Bool :=
  match e
    case CAbstract(name, _) =>
      name == t
    case _ =>
      false
  end

// the function n of k arguments, the procedure n, and the datatype n
function defines_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFun(name, _, formals, _, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

function defines_proc(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CProc(name, _, _, _, _, _) =>
      name == n
    case _ =>
      false
  end

function defines_data(cmd: Cmd, n: Name): Bool :=
  match cmd
    case CData(name, _, _) =>
      name == n
    case _ =>
      false
  end

function signs_fun(cmd: Cmd, n: Name, k: Int): Bool :=
  match cmd
    case CFunSig(name, _, formals, _) =>
      name == n and size(formals) == k
    case _ =>
      false
  end

// the signatures of ex, each of which the implementation section im defines once and exactly as written
procedure check_signatures(in ex: List[Cmd], im: List[Cmd]) :=
  match ex
    case List() =>
      skip

    case List(CFunSig(name, params, formals, typ); rest) =>
      if exists(rest, lambda e => signs_fun(e, name, size(formals))) then
        raise AlreadyDefined(name)
      end
      match List(for c in im if defines_fun(c, name, size(formals)))
        case List(CFun(_, ps1, xs1, r1, _)) =>
          if ps1 != params or xs1 != formals or r1 != typ then
            raise SignatureMismatch(name)
          end

        case _ =>
          raise MissingDefinition(name)
      end
      call check_signatures(in rest, im)

    case List(CProcSig(name, params, ins, outs, refs); rest) =>
      if exists(rest, lambda e => signs(e, name)) then
        raise AlreadyDefined(name)
      end
      match List(for c in im if defines_proc(c, name))
        case List(CProc(_, ps1, ins1, outs1, refs1, _)) =>
          if ps1 != params or ins1 != ins or outs1 != outs or refs1 != refs then
            raise SignatureMismatch(name)
          end

        case _ =>
          raise MissingDefinition(name)
      end
      call check_signatures(in rest, im)

    case List(CAbstract(name, params); rest) =>
      match List(for c in im if defines_data(c, name))
        case List(CData(_, ps1, _)) =>
          if ps1 != params then
            raise SignatureMismatch(name)
          end

        case _ =>
          raise MissingDefinition(name)
      end
      call check_signatures(in rest, im)

    case List(_; rest) =>
      call check_signatures(in rest, im)
  end

// a function of the implementation section that is exported is exported with each of its numbers of arguments
procedure check_arities(in im: List[Cmd], ex: List[Cmd]) :=
  for cmd in im do
    match cmd
      case CFun(name, _, formals, _, _) =>
        if exists(ex, lambda e => signs(e, name)) and not exists(ex, lambda e => signs_fun(e, name, size(formals))) then
          raise PartlyExported(name)
        end

      case _ =>
        skip
    end
  end

// the exported pattern aliases of cs expand to constructors that importers see
procedure exported_aliases(in cs: List[Id * Cmd], hidden: Set[Name], s: State) :=
  for (_, cmd) in cs do
    match cmd
      case CPatAlias(name, _, _, _, _) if not contains(name, hidden) =>
        for k in pattern_constrs(value_or(map_option(pat_alias_of(s.sig, name), lambda alias => alias.pat), PWild)) if contains(k, hidden) do
          raise PrivateConstructor(name, k)
        end

      case _ =>
        skip
    end
  end

function pattern_constrs(pat: Pat): List[Name] :=
  match pat
    case PApp(constr, args) =>
      List(constr; List(for a in args for k in pattern_constrs(a) yield k))

    case PTuple(args) =>
      List(for a in args for k in pattern_constrs(a) yield k)

    case _ =>
      List()
  end

// the types of the export section name only sorts that importers can name, not the private sorts of the module
procedure check_exposed(in m: Id, ex: List[Cmd], hidden_sorts: List[Name]) :=
  match ex
    case List() =>
      skip

    case List(c; rest) =>
      local found: List[Name]
      match exposed(c)
        case Some((n, ts)) =>
          assign found := List(for u in ts for t in sorts_in(u) if contains(own_name(m, t), hidden_sorts) yield own_name(m, t))
          match found
            case List(t; _) =>
              raise PrivateType(n, t)
            case List() =>
              skip
          end

        case None =>
          skip
      end
      call check_exposed(in m, rest, hidden_sorts)
  end

// a name as written in module m, where an unqualified name of a sort of m is one of its own
function own_name(m: Id, n: Name): Name :=
  if n.module == None then in_module(m, n) else n

// the declaration of an export section with the types that it shows to importers
function exposed(cmd: Cmd): Option[Name * List[Type]] :=
  match cmd
    case CFunSig(name, _, formals, typ) =>
      Some((name, List(for x in formals yield x.typ) ++ List(typ)))

    case CProcSig(name, _, ins, outs, refs) =>
      Some((name, List(for x in ins ++ outs ++ refs yield x.typ)))

    case CData(name, _, constrs) =>
      Some((name, List(for k in constrs for field in k.fields yield field.typ)))

    case CSort(name, _, typ) =>
      Some((name, List(typ)))

    case CPatAlias(name, _, formals, typ, _) =>
      Some((name, List(for x in formals yield x.typ) ++ List(typ)))

    // abstract types and notations, and definitions and tests, which enter_section of ulang/parse.u keeps out of export
    // sections
    case _ =>
      None
  end

// the sections of module d, whose signatures its definitions repeat, and whose exports name no private sorts
procedure check_sections(in d: Mod) :=
  local ex := exported_cmds(d), im := implemented_cmds(d)
  call check_signatures(in ex, im)
  call check_arities(in im, ex)
  call check_exposed(in d.name, ex, private_sorts(ex, im))

// the declarations and sorts that module d keeps private, which are all of a module without an export section
procedure private_of(in d: Mod, out hidden: Set[Name], hidden_sorts: List[Name]) :=
  local ex := exported_cmds(d), im := implemented_cmds(d)
  assign hidden := Set(for x in private_names(ex, im)), hidden_sorts := private_sorts(ex, im)

function exported_cmds(d: Mod): List[Cmd] :=
  List(for c in commands_of(d.exported) yield qualify(d.name, c))

function implemented_cmds(d: Mod): List[Cmd] :=
  List(for c in commands_of(d.implemented) yield qualify(d.name, c))

// the commands of the program with qualified names, where each package and each program is checked once, after the
// modules it imports
procedure check_program(in source: Source, out q: Prog) :=
  local sig: Sig := empty(), imports: List[Id * List[Id]] := List(), cmds: List[Cmd] := List(), checked: List[Cmd], shown: Sig
  try
    for mods in units(source.mods, source.packages) do
      call   check_package(in mods, source.packages, sig, imports, out checked, shown)
      assign sig := union(sig, shown), imports := imports ++ List(for d in mods yield (d.name, seen_modules(d, source.packages))), cmds := cmds ++ checked
    end
  catch
    case Located(Some(m), pos, error) if m == source.main =>
      raise Located(None, pos, error)
  end
  assign q := Prog(cmds)

// the modules in the order of mods, where the members of a package, which follow each other, are checked together, and
// each other module, a program, on its own
function units(mods: List[Mod], packages: List[Package]): List[List[Mod]] :=
  match mods
    case List() =>
      List()

    case List(d; rest) =>
      match find(packages, lambda p => contains(d.name, p.members))
        case Some(p) =>
          let unit := take_members(mods, p.members) in
          List(unit; units(drop(size(unit), mods), packages))

        case None =>
          List(List(d); units(rest, packages))
      end
  end

function take_members(mods: List[Mod], members: List[Id]): List[Mod] :=
  match mods
    case List(d; rest) if contains(d.name, members) =>
      List(d; take_members(rest, members))
    case _ =>
      List()
  end

// the commands of the members mods of a package, or of a program alone, and the signature that they show their importers,
// checked together after the declarations before of the modules that imports lists, where the declarations that other
// modules keep private are unknown, since before has only their signatures, and those that members keep private are hidden
// from the other members
procedure check_package(
  in  mods: List[Mod],
      packages: List[Package],
      before: Sig,
      imports: List[Id * List[Id]],
  out cmds: List[Cmd],
      shown: Sig
) :=
  local own := List(for d in mods yield (d.name, seen_modules(d, packages))), members := List(for d in mods yield d.name), placed := List(for d in mods for p in decls_of(d) yield p), s: State, decls: List[Id * Cmd], defined: List[Cmd], hidden: Set[Name] := empty(), hidden_sorts: List[Name] := List(), extra: List[Id * Cmd], more: List[Cmd], builtins := List(for d in mods for c in natives(d) yield c), private: Set[Name], private_sorts: List[Name]
  for d in mods do
    call   private_of(in d, out private, private_sorts)
    assign hidden := hidden ++ private, hidden_sorts := hidden_sorts ++ private_sorts
  end
  assign s := State(before, empty(), 0, first_member(members), List(), visibility(imports ++ own, first_member(members)), List(), empty(), hidden, Set(for x in hidden_sorts)), decls := seconds(placed)
  call   each_placed(in declare_datas, placed, ref s)
  call   declare_datas(in builtins, ref s)
  call   each_placed(in declare_sorts, alias_order(List(for p in placed if alias_names(p) != None), List()), ref s)
  call   each_placed(in declare_constrs, placed, ref s)
  call   each_placed(in declare_pat_aliases, placed, ref s)
  call   each_placed(in declare_funs, placed, ref s)
  call   each_placed(in declare_procs, placed, ref s)
  call   declare_funs(in builtins, ref s)
  call   declare_procs(in builtins, ref s)
  for d in mods do
    call check_sections(in d)
  end
  call each_placed(in lambda in cs: List[Id * Cmd], ref t: State =>
    call exported_aliases(in cs, hidden, t)
  end, placed, ref s)
  for d in mods do
    call unique_ids(in "declaration", block_names(decls_of_mod(d)))
  end
  call   placed_commands(in placed_definitions(placed), lambda in checked: List[Cmd] =>
    call check_orders(in checked, abstract_types(decls), hidden, hidden_sorts)
  end, out defined, ref s)
  assign extra := synthesized(decls, defined, native_types(builtins))
  call   declare_funs(in extra, ref s)
  call   commands(in extra, out more, ref s)
  assign hidden := hidden ++ Set(for c in more yield qualified_name(c))
  assign cmds := defined ++ more, shown := exported(restrict(s.sig, members), hidden, Set(for x in hidden_sorts))

// the type aliases of a package, each after those that it names, since an alias is expanded where it is declared, and
// members name each other's aliases in any order, where aliases that name each other stay in their order
function alias_order(pending: List[Pos * (Id * Cmd)], done: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  match find(pending, lambda p => not exists(pending, lambda q => q != p and names_alias(p, q)))
    case Some(p) =>
      alias_order(remove(p, pending), done ++ List(p))
    case None =>
      done ++ pending
  end

// whether the alias p names the alias q, by its name as written
function names_alias(p: Pos * (Id * Cmd), q: Pos * (Id * Cmd)): Bool :=
  match (alias_names(p), alias_names(q))
    case (Some((_, named)), Some((name, _))) =>
      contains(name, named)
    case _ =>
      false
  end

// the name of the type alias of a placed command and the names of the sorts that it names, if it is one
function alias_names(p: Pos * (Id * Cmd)): Option[Id * List[Id]] :=
  match p
    case (_, (_, CSort(name, _, typ))) =>
      Some((name.base, List(for n in sorts_in(typ) yield n.base)))
    case _ =>
      None
  end

function first_member(members: List[Id]): Id :=
  match members
    case List(m; _) =>
      m
    case List() =>
      ""
  end

function decls_of_mod(d: Mod): List[Id * Cmd] :=
  seconds(decls_of(d))

// the commands of module d with qualified names, with the module of each, and their positions
function decls_of(d: Mod): List[Pos * (Id * Cmd)] :=
  List(for top in placed_of(d) yield (top.pos, (d.name, qualify(d.name, top.cmd))))

// the definitions to check, where a pattern alias is the function that builds its values, if it has one
function placed_definitions(placed: List[Pos * (Id * Cmd)]): List[Pos * (Id * Cmd)] :=
  List(for (p, (m, cmd)) in placed for c in definition_of(cmd) if is_definition((m, c)) yield (p, (m, c)))

function definition_of(cmd: Cmd): List[Cmd] :=
  match cmd
    case CPatAlias(name, params, formals, typ, pat) =>
      match pattern_expr(pat)
        case Some(body) =>
          List(CFun(name, params, formals, typ, body))
        case None =>
          List()
      end

    case _ =>
      List(cmd)
  end

// the declarations of a phase, one by one, where an error is located at the declaration that raises it
procedure each_placed(
  in  phase: (in List[Id * Cmd], ref State),
      placed: List[Pos * (Id * Cmd)],
  ref s: State
) :=
  match placed
    case List() =>
      skip

    case List((p, d); rest) =>
      try
        call phase(in List(d), ref s)
      catch
        case e =>
          raise located(d, p, e)
      end
      call each_placed(in phase, rest, ref s)
  end

// the commands of the definitions, checked one by one and then by after, where an error is located at the definition that
// raises it
procedure placed_commands(
  in  placed: List[Pos * (Id * Cmd)],
      after: (in List[Cmd]),
  out cmds: List[Cmd],
  ref s: State
) :=
  match placed
    case List() =>
      assign cmds := List()

    case List((p, d); more) =>
      local one: List[Cmd], rest: List[Cmd]
      try
        call commands(in List(d), out one, ref s)
        call after(in one)
      catch
        case e =>
          raise located(d, p, e)
      end
      call   placed_commands(in more, after, out rest, ref s)
      assign cmds := one ++ rest
  end

// the error e of declaration d of a module at position p, if the parser read it
function located(d: Id * Cmd, p: Pos, e: TypeError): TypeError :=
  match d
    case (m, _) =>
      if p == Pos(0, 0) then e else Located(Some(m), p, e)
  end

// the type of expr without a program
procedure type_of(in expr: Expr, out t: Type) :=
  local s := start("main", List()), e1: Expr, u: Type
  call   infer(in List(), expr, out e1, u, ref s)
  call   settle(ref s)
  assign t := zonk_type(s.sub, u)

test inference() :=
  local t: Type
  call type_of(in expr_app("<", List(expr_int(1), expr_int(2))), out t)
  assert t == TBool()
  call type_of(in ELet(List(
    (PVar(Var(unqualified("id"), THole)), ELam(List(Var(unqualified("x"), THole)), expr_var("x")))), ETuple(List(
    expr_app("id", List(expr_int(1))),
    expr_app("id", List(ELit(LBool(true))))))), out t)
  assert t == TTuple(List(TInt(), TBool()))
  try
    call type_of(in ELam(List(Var(unqualified("f"), THole)), expr_app("f", List(expr_var("f")))), out t)
    assert false
  catch
    case InfiniteType(_, _) =>
      skip
  end
  try
    call type_of(in expr_app("<", List(expr_int(1), ELit(LBool(true)))), out t)
    assert false
  catch
    case CannotUnify(left, right) =>
      assert (left, right) == (TInt(), TBool())
  end
  try
    call type_of(in expr_app("x", List()), out t)
    assert false
  catch
    case UnknownVariable(name) =>
      assert name == unqualified("x")
  end

test elaboration() :=
  local q: Prog
  call check_program(in with_lists(List(
    CTest("r", List(), SBlock(List(Var(unqualified("n"), THole)), List(
      SAssign(List(
        (Var(unqualified("n"), THole), expr_app("len", List(expr_app("Cons", List(expr_int(1), expr_var("Nil"))))))))))))), out q)
  match q
    case Prog(List(
      _,
      CFun(_, _, _, _, EMatch(_, List(Branch(_, pat, _, _); _))),
      CTest(_, List(), SBlock(_, List(SAssign(List((_, ECall(_, typ, _))))))))) =>
      assert pat == PNil()
      assert typ == TFun(List(TList(TInt())), TInt())

    case _ =>
      assert false
  end

test coverage() :=
  local q: Prog
  try
    call check_program(in with_lists(List(
      CFun(unqualified("f"), List(), List(Var(unqualified("xs"), type_plain_list(TInt()))), TInt(), EMatch(expr_var("xs"), List(Branch("", pat_var("Nil"), None, expr_int(0))))))), out q)
    assert false
  catch
    case NotExhaustive(pat) =>
      assert pat == PCons(PWild, PWild)
  end
  try
    call check_program(in with_lists(List(
      CFun(unqualified("f"), List(), List(Var(unqualified("xs"), type_plain_list(TInt()))), TInt(), EMatch(expr_var("xs"), List(
        Branch("", PWild, None, expr_int(0)),
        Branch("", pat_var("Nil"), None, expr_int(1))))))), out q)
    assert false
  catch
    case Unreachable(pat) =>
      assert pat == PNil()
  end

test statements() :=
  local q: Prog
  try
    call check_program(in program_of(List(
      CProc(unqualified("inc"), List(), List(), List(), List(Var(unqualified("k"), TInt())), SBlock(List(), List(
        SAssign(List(
          (Var(unqualified("k"), THole), expr_app("+", List(expr_var("k"), expr_int(1))))))))),
      CProc(unqualified("p"), List(), List(Var(unqualified("n"), TInt())), List(), List(), SBlock(List(), List(
        SCall(unqualified("inc"), List(), List(), List(Var(unqualified("n"), THole)))))))), out q)
    assert false
  catch
    case NotAssignable(name) =>
      assert name == unqualified("n")
  end
  try
    call check_program(in with_lists(List(
      CTest("t", List(), SBlock(List(), List(SRaise(expr_var("Nil"), THole)))))), out q)
    assert false
  catch
    case UnknownException(TList(_)) =>
      skip
  end

function tsort(n: Id): Type :=
  TSort(unqualified(n), List())

function var_of(n: Id, t: Type): Var :=
  Var(unqualified(n), t)

function fun_cmd(n: Id, xs: List[Var], r: Type, b: Expr): Cmd :=
  CFun(unqualified(n), List(), xs, r, b)

// the modules bag and box, which both export a function size, a constructor Leaf, a procedure fill, and a field x,
// and that the program imports
function bags(): List[Mod] :=
  List(
    sectioned("bag", List(
      CData(unqualified("Bag"), List(), List(
        Constr("", unqualified("Bag"), List(Field("n", TInt()))),
        Constr("", unqualified("Leaf"), List(Field("n", TInt()))))),
      CData(unqualified("Pt"), List(), List(Constr("", unqualified("Pt"), List(Field("x", TInt()))))),
      fun_cmd("size", List(var_of("b", tsort("Bag"))), TInt(), expr_int(1)),
      fun_cmd("compare", List(var_of("a", tsort("Bag")), var_of("b", tsort("Bag"))), TInt(), expr_int(0)),
      CProc(unqualified("fill"), List(), List(), List(var_of("b", tsort("Bag"))), List(), SAssign(List((var_of("b", THole), expr_app("Bag", List(expr_int(0))))))))),
    sectioned("box", List(
      CData(unqualified("Box"), List(), List(
        Constr("", unqualified("Box"), List(Field("s", TStr()))),
        Constr("", unqualified("Leaf"), List(Field("s", TStr()))))),
      CData(unqualified("Qt"), List(), List(Constr("", unqualified("Qt"), List(Field("x", TStr()))))),
      fun_cmd("size", List(var_of("b", tsort("Box"))), TInt(), expr_int(2)),
      CProc(unqualified("fill"), List(), List(), List(var_of("b", tsort("Box"))), List(), SAssign(List((var_of("b", THole), expr_app("Box", List(ELit(LStr("")))))))))))

// the module of cmds with sections, as the parser gives it: the datatypes and the signatures of the definitions exported,
// and the definitions implemented
function sectioned(name: Id, cmds: List[Cmd]): Mod :=
  Mod(name, "", List(), unplaced(List(for c in cmds yield signature_of(c))), List(), unplaced(List(for c in cmds if signature_of(c) != c)))

function signature_of(cmd: Cmd): Cmd :=
  match cmd
    case CFun(name, params, formals, typ, _) =>
      CFunSig(name, params, formals, typ)

    case CProc(name, params, ins, outs, refs, _) =>
      CProcSig(name, params, ins, outs, refs)

    case _ =>
      cmd
  end

// the program of the commands cmds of the module main, which imports bag and box, each a package of its own
function with_bags(cmds: List[Cmd]): Source :=
  Source(List(natives_prelude(); bags()) ++ List(Mod("main", "", List("bag", "box"), List(), List(), unplaced(cmds))), List(Package("bag", List("bag")), Package("box", List("box"))), "main")

function in_bag(n: Id): Name :=
  Name(Some("bag"), n)

function in_box(n: Id): Name :=
  Name(Some("box"), n)

// the body of the last function of the checked program with_bags([cmd])
procedure body_of(in cmd: Cmd, out b: Expr) :=
  local q: Prog
  call check_program(in with_bags(List(cmd)), out q)
  match reverse(q.cmds)
    case List(CFun(_, _, _, _, body); _) =>
      assign b := body
    case _ =>
      assert false
  end

// size(Bag(1)) + size(Box("x"))
test by_arguments() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), expr_app("+", List(
    expr_app("size", List(expr_app("Bag", List(expr_int(1))))),
    expr_app("size", List(expr_app("Box", List(ELit(LStr("x"))))))))), out b)
  match b
    case EApp(_, List(ECall(m, _, _), ECall(n, _, _))) =>
      assert (m, n) == (in_bag("size"), in_box("size"))
    case _ =>
      assert false
  end

// (lambda x => size(x))(Box("x")), where size(x) stays open until the lambda is applied
test deferred() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), EApp(ELam(List(var_of("x", THole)), expr_app("size", List(expr_var("x")))), List(expr_app("Box", List(ELit(LStr("x"))))))), out b)
  match b
    case EApp(ELam(_, ECall(name, typ, _)), _) =>
      assert name == in_box("size")
      assert typ == TFun(List(TSort(in_box("Box"), List())), TInt())

    case _ =>
      assert false
  end

// size as a value of the declared result type Box -> Int
test by_result() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TFun(List(tsort("Box")), TInt()), expr_var("size")), out b)
  assert b == EName(in_box("size"), TFun(List(TSort(in_box("Box"), List())), TInt()))

// Leaf("s") constructs a Box, and the case Leaf(n) of a Bag is of bag
test constructors() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), tsort("Box"), expr_app("Leaf", List(ELit(LStr("s"))))), out b)
  match b
    case ECall(name, _, _) =>
      assert name == in_box("Leaf")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("g", List(var_of("b", tsort("Bag"))), TInt(), EMatch(expr_var("b"), List(
    Branch("", PApp(unqualified("Leaf"), List(pat_var("n"))), None, expr_var("n")),
    Branch("", PApp(unqualified("Bag"), List(pat_var("n"))), None, expr_var("n"))))), out b)
  match b
    case EMatch(_, List(Branch(_, PApp(constr, _), _, _); _)) =>
      assert constr == in_bag("Leaf")
    case _ =>
      assert false
  end

// call fill(out b) for a local b: Box
test procedures() :=
  local q: Prog
  call check_program(in with_bags(List(
    CProc(unqualified("p"), List(), List(), List(), List(), SBlock(List(var_of("b", tsort("Box"))), List(SCall(unqualified("fill"), List(), List(var_of("b", THole)), List())))))), out q)
  match reverse(q.cmds)
    case List(CProc(_, _, _, _, _, SBlock(_, List(SCall(proc, _, _, _)))); _) =>
      assert proc == in_box("fill")
    case _ =>
      assert false
  end

// (lambda p => p.x)(Pt(3)), where the type of p is not known at the access
test fields() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), EApp(ELam(List(var_of("p", THole)), EField(expr_var("p"), "x")), List(expr_app("Pt", List(expr_int(3)))))), out b)
  match b
    case EApp(ELam(_, ECall(name, _, _)), _) =>
      assert name == in_bag("Pt.x")
    case _ =>
      assert false
  end

// compare and == are the builtins, also of bags, whose compare of bag the builtin reaches through the type, and of type
// parameters
test builtins() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(), TInt(), expr_app("compare", List(expr_app("Bag", List(expr_int(1))), expr_app("Bag", List(expr_int(2)))))), out b)
  match b
    case ECall(name, _, _) =>
      assert name == unqualified("compare")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("g", List(), TBool(), expr_app("==", List(expr_int(1), expr_int(2)))), out b)
  match b
    case ECall(name, _, _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  call body_of(in CFun(unqualified("h"), List("A"), List(var_of("x", TParam("A"))), TBool(), expr_app("==", List(expr_var("x"), expr_var("x")))), out b)
  match b
    case ECall(name, _, _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end
  call body_of(in fun_cmd("k", List(), TBool(), ELet(List(
    (PVar(var_of("e", THole)), ELam(List(var_of("x", THole)), expr_app("==", List(expr_var("x"), expr_var("x")))))), ELit(LBool(true)))), out b)
  match b
    case ELet(List((_, ELam(_, ECall(name, _, _)))), _) =>
      assert name == unqualified("==")
    case _ =>
      assert false
  end

// a local variable hides all declarations of its name
test locals() :=
  local b: Expr
  call body_of(in fun_cmd("f", List(var_of("size", TInt())), TInt(), expr_var("size")), out b)
  assert b == EName(unqualified("size"), TInt())

test errors() :=
  local b: Expr
  try
    call body_of(in fun_cmd("f", List(), TInt(), expr_app("size", List(expr_int(1)))), out b)
    assert false
  catch
    case NoOverload(name, _) =>
      assert name == unqualified("size")
  end
  try
    call body_of(in fun_cmd("f", List(), TBool(), ELet(List(
      (PVar(var_of("h", THole)), ELam(List(var_of("x", THole)), expr_app("size", List(expr_var("x")))))), ELit(LBool(true)))), out b)
    assert false
  catch
    case Ambiguous(name, candidates) =>
      assert name == unqualified("size")
      assert size(candidates) == 2
  end
  try
    call body_of(in fun_cmd("f", List(), TInt(), expr_app("size", List(expr_int(1), expr_int(2)))), out b)
    assert false
  catch
    case WrongArity(name, arity) =>
      assert (name, arity) == (unqualified("size"), 2)
  end
