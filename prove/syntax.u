// the terms of the prover, independent of the syntax of ulang/, see prove.md, which is not versioned
//
// Variables are de Bruijn indices for the binders inside a term (ELam, EMatch, and Seq and Concl of simp.u),
// and de Bruijn levels for the variables of the opened sequents, counted from the root.
// A list of binders binds from left to right, the last one is EBound(0).

export

// names as in ulang/syntax.u, with the module that declares them, which is None for locals and builtins
type Id :=
  Str

data Name :=
  case Name(module: Option[Id], base: Id)

data Val :=
  case VUnit
  case VBool(bool: Bool)
  case VInt(num: Int)
  case VStr(text: Str)
  case VChar(char: Char)

// TParam indexes the type parameters of the enclosing function or lemma
data Type :=
  case TParam(index: Int)
  case TSort(name: Name, args: List[Type])
  case TFun(args: List[Type], res: Type)

// bound variables, whose names are only for printing
data Var :=
  case Var(name: Id, typ: Type)

data Term :=
  case EBound(index: Int)
  case ELevel(level: Int)
  case EConst(lit: Val)
  case EFun(name: Name)
  // of any head, a symbol, a variable, or a lambda, where tuples are constructors as well
  case EApp(fun: Term, args: List[Term])
  case ELam(formals: List[Var], body: Term)
  case EIte(cond: Term, then_expr: Term, else_expr: Term)
  case EMatch(arg: Term, cases: List[TermBranch])
  // c + k1·t1 + … + kn·tn, canonical: the ti sorted by compare and distinct, no ki == 0, no ti a Sum or a Const,
  // and neither c alone (a Const) nor 0 + 1·t (just t)
  case ESum(constant: Int, summands: List[Summand])
  case ERaise(value: Term, typ: Type)

// factor·term in a sum
data Summand :=
  case Summand(term: Term, factor: Int)

// the variables of the pattern bind in the guard and the body, from left to right
data TermBranch :=
  case TermBranch(pat: Pat, guard: Option[Term], body: Term)

// tuples are constructors, as in Term
data Pat :=
  case PWild
  case PLit(lit: Val)
  case PVar(var: Var)
  case PApp(constr: Name, pats: List[Pat])

// a linear sum k + k1·t1 + … as it is computed with, which sum_term makes canonical
data Lin :=
  case Lin(k: Int, summands: List[Summand])

// a function by its formals, which bind in the body, and whether it calls itself
data Def :=
  case Def(recursive: Bool, formals: List[Var], body: Term)

// a constructor by its datatype and its fields, where a field of the datatype itself is recursive
data ConstrDecl :=
  case ConstrDecl(datatype: Name, fields: List[Var])

// the symbols of a program: the definitions of functions, the constructors, the datatypes with their constructors
// in order, and the rank of each symbol in the order of declarations, the precedence of the term order
data Decls :=
  case Decls(defs: Map[Name, Def], constrs: Map[Name, ConstrDecl], datatypes: Map[Name, List[Name]], ranks: Map[Name, Int])

data Rebind :=
  // the count outermost binders at depth become the levels from depth on
  case Open(depth: Int, count: Int)
  // the levels become binders, the first one outermost
  case Close(levels: List[Int])
  // indices of the binders around the term are increased by n
  case Shift(n: Int)

// the applications of the builtins without a module, as the simplifier matches them; terms read from checked programs
// will carry Some("prelude") for the operators of the prelude
pattern Not(a: Term): Term :=
  EApp(EFun(Name(None, "not")), List(a))

pattern And(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "and")), List(a, b))

pattern Or(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "or")), List(a, b))

pattern Implies(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "==>")), List(a, b))

pattern Eq(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "==")), List(a, b))

pattern Less(a: Term, b: Term): Term :=
  EApp(EFun(Name(None, "<")), List(a, b))

pattern Forall(formals: List[Var], body: Term): Term :=
  EApp(EFun(Name(None, "forall")), List(ELam(formals, body)))

pattern Exists(formals: List[Var], body: Term): Term :=
  EApp(EFun(Name(None, "exists")), List(ELam(formals, body)))

function sym(base: Id): Term

function app(f: Id, args: List[Term]): Term

function bool_term(b: Bool): Term

function int_term(n: Int): Term

function empty_decls(): Decls

function is_constr(decls: Decls, f: Name): Bool

function constr_head(decls: Decls, e: Term): Option[Name * List[Term]]

function rebind(op: Rebind, c: Int, e: Term): Term

function binders(p: Pat): Int

function pattern_vars(p: Pat): List[Var]

function shift(n: Int, e: Term): Term

function subst(c: Int, t: Term, e: Term): Term

function beta(args: List[Term], e: Term): Term

function replace(a: Term, b: Term, e: Term): Term

function occurs(a: Term, e: Term): Bool

function loose(c: Int, e: Term): List[Int]

function lin_of(e: Term): Lin

function lin_add(a: Lin, b: Lin): Lin

function lin_scale(n: Int, a: Lin): Lin

function lin_sub(a: Lin, b: Lin): Lin

function sum_term(a: Lin): Term

function is_greater(decls: Decls, s: Term, t: Term): Bool

function print_term(names: List[Id], e: Term): Str

implementation

function sym(base: Id): Term :=
  EFun(Name(None, base))

function app(f: Id, args: List[Term]): Term :=
  EApp(sym(f), args)

function bool_term(b: Bool): Term :=
  EConst(VBool(b))

function int_term(n: Int): Term :=
  EConst(VInt(n))

function empty_decls(): Decls :=
  Decls(empty(), empty(), empty(), empty())

function is_constr(decls: Decls, f: Name): Bool :=
  contains(f, decls.constrs)

// the constructor and the arguments of a constructor term
function constr_head(decls: Decls, e: Term): Option[Name * List[Term]] :=
  match e
    case EFun(name) if is_constr(decls, name) =>
      Some((name, List()))

    case EApp(EFun(name), args) if is_constr(decls, name) =>
      Some((name, args))

    case _ =>
      None
  end

function rebind(op: Rebind, c: Int, e: Term): Term :=
  match e
    case EBound(index) =>
      rebind_bound(op, c, index)

    case ELevel(level) =>
      rebind_level(op, c, level)

    case EApp(fun, args) =>
      EApp(rebind(op, c, fun), List(for a in args yield rebind(op, c, a)))

    case ELam(formals, body) =>
      ELam(formals, rebind(op, c + size(formals), body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(rebind(op, c, cond), rebind(op, c, then_expr), rebind(op, c, else_expr))

    case EMatch(expr, cases) =>
      EMatch(rebind(op, c, expr), List(for br in cases yield rebind_branch(op, c, br)))

    // rebuilt, since opening and closing change the order of the atoms
    case ESum(constant, summands) =>
      sum_term(rebind_summands(op, c, summands, Lin(constant, List())))

    case ERaise(expr, typ) =>
      ERaise(rebind(op, c, expr), typ)

    case _ =>
      e
  end

function rebind_bound(op: Rebind, c: Int, i: Int): Term :=
  if i < c then
    EBound(i)
  else
    match op
      case Open(depth, count) =>
        if i - c < count then
          ELevel(depth + count - 1 - (i - c))
        else
          EBound(i - count)

      case Close(levels) =>
        EBound(i + size(levels))

      case Shift(n) =>
        EBound(i + n)
    end

function rebind_level(op: Rebind, c: Int, l: Int): Term :=
  match op
    case Close(levels) =>
      match index_of(l, levels)
        case Some(j) =>
          EBound(c + size(levels) - 1 - j)
        case None =>
          ELevel(l)
      end

    case _ =>
      ELevel(l)
  end

function rebind_summands(op: Rebind, c: Int, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      rebind_summands(op, c, rest, lin_add(acc, lin_scale(summand.factor, lin_of(rebind(op, c, summand.term)))))
  end

function rebind_branch(op: Rebind, c: Int, br: TermBranch): TermBranch :=
  match br
    case TermBranch(pat, guard, body) =>
      let inner := c + binders(pat) in
      match guard
        case Some(h) =>
          TermBranch(pat, Some(rebind(op, inner, h)), rebind(op, inner, body))
        case None =>
          TermBranch(pat, None, rebind(op, inner, body))
      end
  end

function binders(p: Pat): Int :=
  size(pattern_vars(p))

function pattern_vars(p: Pat): List[Var] :=
  match p
    case PVar(var) =>
      List(var)

    case PApp(_, pats) =>
      List(for q in pats for x in pattern_vars(q) yield x)

    case _ =>
      List()
  end

function shift(n: Int, e: Term): Term :=
  if n == 0 then e else rebind(Shift(n), 0, e)

// e with the binder c replaced by t, whose own free indices are those around e, and the binders above c moved down
function subst(c: Int, t: Term, e: Term): Term :=
  match e
    case EBound(index) =>
      if index == c then
        shift(c, t)
      else if index > c then
        EBound(index - 1)
      else
        e

    case EApp(fun, args) =>
      EApp(subst(c, t, fun), List(for a in args yield subst(c, t, a)))

    case ELam(formals, body) =>
      ELam(formals, subst(c + size(formals), t, body))

    case EIte(cond, then_expr, else_expr) =>
      EIte(subst(c, t, cond), subst(c, t, then_expr), subst(c, t, else_expr))

    case EMatch(expr, cases) =>
      EMatch(subst(c, t, expr), List(for br in cases yield subst_branch(c, t, br)))

    case ESum(constant, summands) =>
      sum_term(subst_summands(c, t, summands, Lin(constant, List())))

    case ERaise(expr, typ) =>
      ERaise(subst(c, t, expr), typ)

    case _ =>
      e
  end

function subst_summands(c: Int, t: Term, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      subst_summands(c, t, rest, lin_add(acc, lin_scale(summand.factor, lin_of(subst(c, t, summand.term)))))
  end

function subst_branch(c: Int, t: Term, br: TermBranch): TermBranch :=
  match br
    case TermBranch(pat, guard, body) =>
      let inner := c + binders(pat) in
      match guard
        case Some(h) =>
          TermBranch(pat, Some(subst(inner, t, h)), subst(inner, t, body))
        case None =>
          TermBranch(pat, None, subst(inner, t, body))
      end
  end

// the body of as many binders as there are arguments, applied to them, where the last argument is EBound(0)
function beta(args: List[Term], e: Term): Term :=
  match reverse(args)
    case List() =>
      e
    case List(a; rest) =>
      beta(reverse(rest), subst(0, shift(size(rest), a), e))
  end

// e with every occurrence of a replaced by b, where a and b have no free indices
function replace(a: Term, b: Term, e: Term): Term :=
  if e == a then
    b
  else
    match e
      case EApp(fun, args) =>
        EApp(replace(a, b, fun), List(for x in args yield replace(a, b, x)))

      case ELam(formals, body) =>
        ELam(formals, replace(a, b, body))

      case EIte(cond, then_expr, else_expr) =>
        EIte(replace(a, b, cond), replace(a, b, then_expr), replace(a, b, else_expr))

      case EMatch(expr, cases) =>
        EMatch(replace(a, b, expr), List(for br in cases yield replace_branch(a, b, br)))

      case ESum(constant, summands) =>
        sum_term(replace_summands(a, b, summands, Lin(constant, List())))

      case ERaise(expr, typ) =>
        ERaise(replace(a, b, expr), typ)

      case _ =>
        e
    end

function replace_summands(a: Term, b: Term, summands: List[Summand], acc: Lin): Lin :=
  match summands
    case List() =>
      acc
    case List(summand; rest) =>
      replace_summands(a, b, rest, lin_add(acc, lin_scale(summand.factor, lin_of(replace(a, b, summand.term)))))
  end

function replace_branch(a: Term, b: Term, br: TermBranch): TermBranch :=
  match br
    case TermBranch(pat, guard, body) =>
      match guard
        case Some(h) =>
          TermBranch(pat, Some(replace(a, b, h)), replace(a, b, body))
        case None =>
          TermBranch(pat, None, replace(a, b, body))
      end
  end

function occurs(a: Term, e: Term): Bool :=
  if e == a then
    true
  else
    match e
      case EApp(fun, args) =>
        occurs(a, fun) or exists(args, lambda x => occurs(a, x))

      case ELam(_, body) =>
        occurs(a, body)

      case EIte(cond, then_expr, else_expr) =>
        occurs(a, cond) or occurs(a, then_expr) or occurs(a, else_expr)

      case EMatch(expr, cases) =>
        occurs(a, expr) or exists(cases, lambda br => occurs_branch(a, br))

      case ESum(_, summands) =>
        exists(summands, lambda summand => occurs(a, summand.term))

      case ERaise(expr, _) =>
        occurs(a, expr)

      case _ =>
        false
    end

function occurs_branch(a: Term, br: TermBranch): Bool :=
  match br
    case TermBranch(_, Some(h), body) =>
      occurs(a, h) or occurs(a, body)
    case TermBranch(_, None, body) =>
      occurs(a, body)
  end

// the free indices of e below c binders, relative to them
function loose(c: Int, e: Term): List[Int] :=
  match e
    case EBound(index) =>
      if index >= c then List(index - c) else List()

    case EApp(fun, args) =>
      loose(c, fun) ++ List(for a in args for i in loose(c, a) yield i)

    case ELam(formals, body) =>
      loose(c + size(formals), body)

    case EIte(cond, then_expr, else_expr) =>
      loose(c, cond) ++ loose(c, then_expr) ++ loose(c, else_expr)

    case EMatch(expr, cases) =>
      loose(c, expr) ++ List(for br in cases for i in loose_branch(c, br) yield i)

    case ESum(_, summands) =>
      List(for summand in summands for i in loose(c, summand.term) yield i)

    case ERaise(expr, _) =>
      loose(c, expr)

    case _ =>
      List()
  end

function loose_branch(c: Int, br: TermBranch): List[Int] :=
  match br
    case TermBranch(pat, guard, body) =>
      let inner := c + binders(pat) in
      match guard
        case Some(h) =>
          loose(inner, h) ++ loose(inner, body)
        case None =>
          loose(inner, body)
      end
  end

function lin_of(e: Term): Lin :=
  match e
    case ESum(constant, summands) =>
      Lin(constant, summands)

    case EConst(VInt(num)) =>
      Lin(num, List())

    case _ =>
      Lin(0, List(Summand(e, 1)))
  end

function lin_add(a: Lin, b: Lin): Lin :=
  Lin(a.k + b.k, merge_summands(a.summands, b.summands))

function merge_summands(ts: List[Summand], us: List[Summand]): List[Summand] :=
  match (ts, us)
    case (List(), _) =>
      us

    case (_, List()) =>
      ts

    case (List(t; ts1), List(u; us1)) =>
      match compare(t.term, u.term)
        case -1 =>
          List(t; merge_summands(ts1, us))

        case 1 =>
          List(u; merge_summands(ts, us1))

        case _ =>
          if t.factor + u.factor == 0 then
            merge_summands(ts1, us1)
          else
            List(t with factor := t.factor + u.factor; merge_summands(ts1, us1))
      end
  end

function lin_scale(n: Int, a: Lin): Lin :=
  if n == 0 then
    Lin(0, List())
  else
    Lin(n * a.k, List(for summand in a.summands yield summand with factor := n * summand.factor))

function lin_sub(a: Lin, b: Lin): Lin :=
  lin_add(a, lin_scale(-1, b))

function sum_term(a: Lin): Term :=
  match a
    case Lin(k, List()) =>
      int_term(k)

    case Lin(0, List(Summand(t, 1))) =>
      t

    case Lin(k, summands) =>
      ESum(k, summands)
  end

function is_greater(decls: Decls, s: Term, t: Term): Bool :=
  if s == t then
    false
  else
    match (s, t)
      case (_, EBound(_)) =>
        occurs(t, s)

      case (EBound(_), _) =>
        false

      case _ =>
        if exists(args_of(s), lambda a => a == t or is_greater(decls, a, t)) then
          true
        else
          let c := compare(head_key(decls, s), head_key(decls, t)) in
          if c > 0 then
            dominates(decls, s, args_of(t))
          else if c == 0 then
            is_lex_greater(decls, args_of(s), args_of(t)) and dominates(decls, s, args_of(t))
          else
            false
    end

function dominates(decls: Decls, s: Term, ts: List[Term]): Bool :=
  forall(ts, lambda t => is_greater(decls, s, t))

function is_lex_greater(decls: Decls, ss: List[Term], ts: List[Term]): Bool :=
  match (ss, ts)
    case (List(s; ss1), List(t; ts1)) =>
      if s == t then
        is_lex_greater(decls, ss1, ts1)
      else
        is_greater(decls, s, t)

    case _ =>
      false
  end

function head_key(decls: Decls, e: Term): Int * Int :=
  match e
    case EConst(_) =>
      (0, 0)

    case ELevel(level) =>
      (1, level)

    case ESum(_, _) =>
      (2, 0)

    case EFun(name) =>
      (3, rank(decls, name))

    case EApp(EFun(name), _) =>
      (3, rank(decls, name))

    case EApp(_, _) =>
      (4, 0)

    case EIte(_, _, _) =>
      (5, 0)

    case EMatch(_, _) =>
      (6, 0)

    case _ =>
      (7, 0)
  end

function rank(decls: Decls, f: Name): Int :=
  value_or(get(f, decls.ranks), -1)

function args_of(e: Term): List[Term] :=
  match e
    case EApp(EFun(_), args) =>
      args

    case EApp(fun, args) =>
      List(fun; args)

    case ESum(_, summands) =>
      List(for summand in summands yield summand.term)

    case EIte(cond, then_expr, else_expr) =>
      List(cond, then_expr, else_expr)

    case EMatch(expr, _) =>
      List(expr)

    case ERaise(expr, _) =>
      List(expr)

    case _ =>
      List()
  end

function infix_ops(): List[Id] :=
  List("==>", "or", "and", "==", "<", "++", "+", "-", "*", "/", "%")

function print_term(names: List[Id], e: Term): Str :=
  print_in(names, List(), e)

function print_in(names: List[Id], bound: List[Id], e: Term): Str :=
  match e
    case EBound(index) =>
      if index < size(bound) then
        at(index, from_list(bound))
      else
        "#" ++ show(index)

    case ELevel(level) =>
      if level < size(names) then
        at(level, from_list(names))
      else
        "@" ++ show(level)

    case EConst(lit) =>
      print_val(lit)

    case EFun(Name(_, "Nil")) =>
      "[]"

    case EFun(Name(_, base)) =>
      base

    case EApp(EFun(Name(_, "Cons")), List(a, b)) =>
      "[" ++ print_in(names, bound, a) ++ "; " ++ print_in(names, bound, b) ++ "]"

    case EApp(EFun(Name(_, "not")), List(a)) =>
      "not " ++ print_arg(names, bound, a)

    case EApp(EFun(Name(_, "forall")), List(ELam(formals, body))) =>
      "forall " ++ print_binders(formals) ++ " => " ++ print_in(names, bound_names(formals, bound), body)

    case EApp(EFun(Name(_, "exists")), List(ELam(formals, body))) =>
      "exists " ++ print_binders(formals) ++ " => " ++ print_in(names, bound_names(formals, bound), body)

    case EApp(EFun(Name(_, base)), List(a, b)) if contains(base, infix_ops()) =>
      print_arg(names, bound, a) ++ " " ++ base ++ " " ++ print_arg(names, bound, b)

    case EApp(fun, args) =>
      print_arg(names, bound, fun) ++ "(" ++ join(", ", List(for a in args yield print_in(names, bound, a))) ++ ")"

    case ELam(formals, body) =>
      "lambda " ++ print_binders(formals) ++ " => " ++ print_in(names, bound_names(formals, bound), body)

    case EIte(cond, then_expr, else_expr) =>
      "if " ++ print_in(names, bound, cond) ++ " then " ++ print_in(names, bound, then_expr) ++ " else " ++ print_in(names, bound, else_expr)

    case EMatch(expr, cases) =>
      "match " ++ print_in(names, bound, expr) ++ join("", List(for br in cases yield print_branch(names, bound, br))) ++ " end"

    case ESum(constant, summands) =>
      print_sum(names, bound, constant, summands)

    case ERaise(expr, _) =>
      "raise " ++ print_arg(names, bound, expr)
  end

function bound_names(xs: List[Var], bound: List[Id]): List[Id] :=
  reverse(List(for x in xs yield x.name)) ++ bound

function print_binders(xs: List[Var]): Str :=
  join(", ", List(for x in xs yield x.name))

function print_arg(names: List[Id], bound: List[Id], e: Term): Str :=
  match e
    case EApp(EFun(Name(_, base)), List(_, _)) if contains(base, infix_ops()) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case EApp(EFun(Name(_, base)), List(_)) if base == "not" or base == "forall" or base == "exists" =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case ESum(_, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case EIte(_, _, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case ELam(_, _) =>
      "(" ++ print_in(names, bound, e) ++ ")"

    case EConst(VInt(num)) if num < 0 =>
      "(" ++ show(num) ++ ")"

    case _ =>
      print_in(names, bound, e)
  end

function print_branch(names: List[Id], bound: List[Id], br: TermBranch): Str :=
  match br
    case TermBranch(pat, g, body) =>
      let inner := bound_names(pattern_vars(pat), bound) in
      let guard := match g
        case Some(h) =>
          " if " ++ print_in(names, inner, h)
        case None =>
          ""
      end in
      " case " ++ print_pat(pat) ++ guard ++ " => " ++ print_in(names, inner, body)
  end

function print_pat(p: Pat): Str :=
  match p
    case PWild =>
      "_"

    case PLit(lit) =>
      print_val(lit)

    case PVar(var) =>
      var.name

    case PApp(Name(_, "Nil"), List()) =>
      "[]"

    case PApp(Name(_, "Cons"), List(a, b)) =>
      "[" ++ print_pat(a) ++ "; " ++ print_pat(b) ++ "]"

    case PApp(Name(_, base), List()) =>
      base

    case PApp(Name(_, base), pats) =>
      base ++ "(" ++ join(", ", List(for q in pats yield print_pat(q))) ++ ")"
  end

// the atoms first, as written, then the constant
function print_sum(names: List[Id], bound: List[Id], k: Int, ts: List[Summand]): Str :=
  let first_summand := match ts
    case List(Summand(t, n); _) =>
      if n == 1 then
        print_arg(names, bound, t)
      else if n == -1 then
        "-" ++ print_arg(names, bound, t)
      else
        show(n) ++ " * " ++ print_arg(names, bound, t)

    case List() =>
      show(k)
  end in
  let rest := match ts
    case List(_; more) =>
      join("", List(for summand in more yield print_summand(names, bound, summand)))
    case List() =>
      ""
  end in
  let constant := if ts == List() or k == 0 then
    ""
  else if k > 0 then
    " + " ++ show(k)
  else
    " - " ++ show(0 - k) in
  first_summand ++ rest ++ constant

function print_summand(names: List[Id], bound: List[Id], summand: Summand): Str :=
  let t := summand.term, n := summand.factor in
  if n == 1 then
    " + " ++ print_arg(names, bound, t)
  else if n == -1 then
    " - " ++ print_arg(names, bound, t)
  else if n > 0 then
    " + " ++ show(n) ++ " * " ++ print_arg(names, bound, t)
  else
    " - " ++ show(0 - n) ++ " * " ++ print_arg(names, bound, t)

function print_val(v: Val): Str :=
  match v
    case VUnit =>
      "()"

    case VBool(bool) =>
      show(bool)

    case VInt(num) =>
      show(num)

    case VStr(text) =>
      quote(text)

    case VChar(char) =>
      show(char)
  end
