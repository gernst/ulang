// a reader of terms and declarations in the syntax of ulang, for the tests of the prover until self/prove.u translates
// checked programs: definitions of functions and datatypes, and formulas with quantifiers, where the connectives and
// comparisons of the prelude are read as the builtins of the prover, a != b as not (a == b) and a <= b as not (b < a)

import "map.u"
import "syntax.u"

export

data ReadError :=
  case ReadError(message: Str)

procedure read_expr(in text: Str, out e: Expr)

// the declarations of text after those of decls
procedure read_decls(in decls: Decls, text: Str, out result: Decls)

implementation

data Tok :=
  case TInt(num: Int)
  case TName(name: Str)
  case TSym(op: Str)
  case TPunct(char: Char)
  case TEnd

function is_symbol(c: Char): Bool :=
  contains(c, "=<>!+-*/%:|&^~.")

function is_name_char(c: Char): Bool :=
  is_letter(c) or is_digit(c) or c == '_' or c == '\''

function scan_end(text: Str, i: Int, p: Char -> Bool): Int :=
  if i < size(text) and p(at(i, text)) then scan_end(text, i + 1, p) else i

procedure lex(in text: Str, out toks: List[Tok]) :=
  local i := 0, j := 0, c := ' ', rev: List[Tok] := list()
  while i < size(text)
    assign c := at(i, text)
    if is_space(c)
      assign i := i + 1
    else
      if is_digit(c)
        assign j := scan_end(text, i, is_digit)
        match number(slice(text, i, j))
          case Some(n) =>
            assign rev := list(TInt(n); rev)
          case None =>
            raise ReadError("invalid number")
        end
        assign i := j
      else
        if is_letter(c) or c == '_'
          assign j := scan_end(text, i, is_name_char)
          assign rev := list(TName(slice(text, i, j)); rev), i := j
        else
          if is_symbol(c)
            assign j := scan_end(text, i, is_symbol)
            assign rev := list(TSym(slice(text, i, j)); rev), i := j
          else
            if contains(c, "()[],;")
              assign rev := list(TPunct(c); rev), i := i + 1
            else
              raise ReadError("unexpected character " ++ show(c))
            end
          end
        end
      end
    end
  end
  assign toks := reverse(rev)

function head_tok(toks: List[Tok]): Tok :=
  match toks
    case list(t; _) =>
      t
    case list() =>
      TEnd
  end

function second_tok(toks: List[Tok]): Tok :=
  match toks
    case list(_, t; _) =>
      t
    case _ =>
      TEnd
  end

procedure advance(ref toks: List[Tok]) :=
  match toks
    case list(_; rest) =>
      assign toks := rest
    case list() =>
      skip
  end

procedure expect(in t: Tok, ref toks: List[Tok]) :=
  if head_tok(toks) == t
    call advance(ref toks)
  else
    raise ReadError(show(t) ++ " expected but " ++ show(head_tok(toks)) ++ " found")
  end

procedure parse_name(out x: Id, ref toks: List[Tok]) :=
  match head_tok(toks)
    case TName(name) =>
      assign x := name
      call   advance(ref toks)

    case t =>
      raise ReadError("name expected but " ++ show(t) ++ " found")
  end

function is_upper(x: Id): Bool :=
  let c := at(0, x) in ord(c) >= 65 and ord(c) <= 90

function unknown_type(): Type :=
  TSort(Name(None, "?"), list())

function infix_prec(t: Tok): Int :=
  match t
    case TSym("==>") =>
      1

    case TName("or") =>
      2

    case TName("and") =>
      3

    case TSym(op) if contains(op, list("==", "!=", "<", "<=", ">", ">=")) =>
      5

    case TSym("++") =>
      6

    case TSym(op) if op == "+" or op == "-" =>
      7

    case TSym(op) if op == "*" or op == "/" or op == "%" =>
      8

    case _ =>
      0
  end

function op_name(t: Tok): Id :=
  match t
    case TSym(op) =>
      op

    case TName(name) =>
      name

    case _ =>
      ""
  end

function binop(op: Id, a: Expr, b: Expr): Expr :=
  match op
    case "!=" =>
      app("not", list(app("==", list(a, b))))

    case "<=" =>
      app("not", list(app("<", list(b, a))))

    case ">" =>
      app("<", list(b, a))

    case ">=" =>
      app("not", list(app("<", list(a, b))))

    case _ =>
      app(op, list(a, b))
  end

function negate(a: Expr): Expr :=
  match a
    case EConst(VInt(num)) =>
      int_expr(0 - num)
    case _ =>
      app("-", list(int_expr(0), a))
  end

procedure parse_expr(in env: List[Id], out e: Expr, ref toks: List[Tok]) :=
  call parse_binary(in env, 1, out e, ref toks)

// operators of at least the precedence min, where ==> and ++ are right associative
procedure parse_binary(
  in  env: List[Id],
      min: Int,
  out e: Expr,
  ref toks: List[Tok]
) :=
  local op := "", prec := 0, rhs: Expr
  call parse_prefix(in env, out e, ref toks)
  while infix_prec(head_tok(toks)) >= min and infix_prec(head_tok(toks)) > 0
    assign op := op_name(head_tok(toks)), prec := infix_prec(head_tok(toks))
    call   advance(ref toks)
    call   parse_binary(in env, if op == "==>" or op == "++" then prec else prec + 1, out rhs, ref toks)
    assign e := binop(op, e, rhs)
  end

procedure parse_prefix(in env: List[Id], out e: Expr, ref toks: List[Tok]) :=
  local a: Expr
  match head_tok(toks)
    case TName("not") =>
      call   advance(ref toks)
      call   parse_binary(in env, 5, out a, ref toks)
      assign e := app("not", list(a))

    case TSym("-") =>
      call   advance(ref toks)
      call   parse_binary(in env, 9, out a, ref toks)
      assign e := negate(a)

    case _ =>
      call parse_app(in env, out e, ref toks)
  end

procedure parse_app(in env: List[Id], out e: Expr, ref toks: List[Tok]) :=
  local args: List[Expr]
  call parse_atom(in env, out e, ref toks)
  while head_tok(toks) == TPunct('(')
    call   advance(ref toks)
    call   parse_exprs(in env, ')', out args, ref toks)
    assign e := EApp(e, args)
  end

// expressions separated by commas up to the closing character
procedure parse_exprs(
  in  env: List[Id],
      close: Char,
  out es: List[Expr],
  ref toks: List[Tok]
) :=
  local e: Expr, rev: List[Expr] := list()
  if head_tok(toks) != TPunct(close)
    call   parse_expr(in env, out e, ref toks)
    assign rev := list(e)
    while head_tok(toks) == TPunct(',')
      call   advance(ref toks)
      call   parse_expr(in env, out e, ref toks)
      assign rev := list(e; rev)
    end
  end
  call   expect(in TPunct(close), ref toks)
  assign es := reverse(rev)

procedure parse_atom(in env: List[Id], out e: Expr, ref toks: List[Tok]) :=
  local a: Expr, b: Expr, c: Expr, x := "", xs: List[Var], es: List[Expr], bs: List[Branch]
  match head_tok(toks)
    case TInt(num) =>
      call   advance(ref toks)
      assign e := int_expr(num)

    case TName("true") =>
      call   advance(ref toks)
      assign e := bool_expr(true)

    case TName("false") =>
      call   advance(ref toks)
      assign e := bool_expr(false)

    case TName("if") =>
      call   advance(ref toks)
      call   parse_expr(in env, out c, ref toks)
      call   expect(in TName("then"), ref toks)
      call   parse_expr(in env, out a, ref toks)
      call   expect(in TName("else"), ref toks)
      call   parse_expr(in env, out b, ref toks)
      assign e := EIte(c, a, b)

    case TName("let") =>
      call   advance(ref toks)
      call   parse_name(out x, ref toks)
      call   expect(in TSym(":="), ref toks)
      call   parse_expr(in env, out a, ref toks)
      call   expect(in TName("in"), ref toks)
      call   parse_expr(in list(x; env), out b, ref toks)
      assign e := subst(0, a, b)

    case TName("match") =>
      call   advance(ref toks)
      call   parse_expr(in env, out a, ref toks)
      call   parse_cases(in env, out bs, ref toks)
      assign e := EMatch(a, bs)

    case TName(q) if q == "forall" or q == "exists" or q == "lambda" =>
      call   advance(ref toks)
      call   parse_binders(out xs, ref toks)
      call   expect(in TSym("=>"), ref toks)
      call   parse_expr(in reverse(list(for y in xs yield y.name)) ++ env, out b, ref toks)
      assign e := if q == "lambda" then ELam(xs, b) else app(q, list(ELam(xs, b)))

    case TName(name) =>
      call   advance(ref toks)
      assign e := lookup(name, env)

    case TPunct('(') =>
      call advance(ref toks)
      call parse_expr(in env, out e, ref toks)
      call expect(in TPunct(')'), ref toks)

    case TPunct('[') =>
      call advance(ref toks)
      if head_tok(toks) == TPunct(']')
        call   advance(ref toks)
        assign e := sym("Nil")
      else
        call parse_expr(in env, out a, ref toks)
        if head_tok(toks) == TPunct(';')
          call   advance(ref toks)
          call   parse_expr(in env, out b, ref toks)
          call   expect(in TPunct(']'), ref toks)
          assign e := app("Cons", list(a, b))
        else
          if head_tok(toks) == TPunct(',')
            call   advance(ref toks)
            call   parse_exprs(in env, ']', out es, ref toks)
            assign e := list_expr(list(a; es))
          else
            call   expect(in TPunct(']'), ref toks)
            assign e := app("Cons", list(a, sym("Nil")))
          end
        end
      end

    case t =>
      raise ReadError("expression expected but " ++ show(t) ++ " found")
  end

function lookup(x: Id, env: List[Id]): Expr :=
  match index_of(x, env)
    case Some(i) =>
      EBound(i)
    case None =>
      sym(x)
  end

function list_expr(es: List[Expr]): Expr :=
  match es
    case list() =>
      sym("Nil")
    case list(e; rest) =>
      app("Cons", list(e, list_expr(rest)))
  end

// names with optional types, separated by commas
procedure parse_binders(out xs: List[Var], ref toks: List[Tok]) :=
  local x := "", t: Type, rev: List[Var] := list()
  call   parse_binder(out x, t, ref toks)
  assign rev := list(Var(x, t))
  while head_tok(toks) == TPunct(',')
    call   advance(ref toks)
    call   parse_binder(out x, t, ref toks)
    assign rev := list(Var(x, t); rev)
  end
  assign xs := reverse(rev)

procedure parse_binder(out x: Id, t: Type, ref toks: List[Tok]) :=
  call parse_name(out x, ref toks)
  if head_tok(toks) == TSym(":")
    call advance(ref toks)
    call parse_type(out t, ref toks)
  else
    assign t := unknown_type()
  end

// a type, where single capitals are type parameters
procedure parse_type(out t: Type, ref toks: List[Tok]) :=
  local x := "", ts: List[Type] := list(), u: Type
  call parse_name(out x, ref toks)
  if head_tok(toks) == TPunct('[')
    call   advance(ref toks)
    call   parse_type(out u, ref toks)
    assign ts := list(u)
    while head_tok(toks) == TPunct(',')
      call   advance(ref toks)
      call   parse_type(out u, ref toks)
      assign ts := ts ++ list(u)
    end
    call expect(in TPunct(']'), ref toks)
  end
  if size(x) == 1 and is_upper(x)
    assign t := TParam(ord(at(0, x)) - 65)
  else
    assign t := TSort(Name(None, x), ts)
  end

procedure parse_cases(
  in  env: List[Id],
  out bs: List[Branch],
  ref toks: List[Tok]
) :=
  local p: Pat, g: Option[Expr], h: Expr, b: Expr, inner: List[Id], rev: List[Branch] := list()
  while head_tok(toks) == TName("case")
    call   advance(ref toks)
    call   parse_pattern(out p, ref toks)
    assign inner := reverse(list(for x in pattern_vars(p) yield x.name)) ++ env, g := None
    if head_tok(toks) == TName("if")
      call   advance(ref toks)
      call   parse_expr(in inner, out h, ref toks)
      assign g := Some(h)
    end
    call   expect(in TSym("=>"), ref toks)
    call   parse_expr(in inner, out b, ref toks)
    assign rev := list(Branch(p, g, b); rev)
  end
  call   expect(in TName("end"), ref toks)
  assign bs := reverse(rev)

procedure parse_pattern(out p: Pat, ref toks: List[Tok]) :=
  local x := "", ps: List[Pat], q: Pat, r: Pat
  match head_tok(toks)
    case TName("_") =>
      call   advance(ref toks)
      assign p := PWild

    case TInt(num) =>
      call   advance(ref toks)
      assign p := PLit(VInt(num))

    case TSym("-") =>
      call advance(ref toks)
      match head_tok(toks)
        case TInt(num) =>
          call   advance(ref toks)
          assign p := PLit(VInt(0 - num))

        case t =>
          raise ReadError("number expected but " ++ show(t) ++ " found")
      end

    case TName("true") =>
      call   advance(ref toks)
      assign p := PLit(VBool(true))

    case TName("false") =>
      call   advance(ref toks)
      assign p := PLit(VBool(false))

    case TName(name) =>
      call advance(ref toks)
      if not is_upper(name)
        assign p := PVar(Var(name, unknown_type()))
      else
        if head_tok(toks) == TPunct('(')
          call   advance(ref toks)
          call   parse_patterns(in ')', out ps, ref toks)
          assign p := PApp(Name(None, name), ps)
        else
          assign p := PApp(Name(None, name), list())
        end
      end

    case TPunct('[') =>
      call advance(ref toks)
      if head_tok(toks) == TPunct(']')
        call   advance(ref toks)
        assign p := PApp(Name(None, "Nil"), list())
      else
        call parse_pattern(out q, ref toks)
        if head_tok(toks) == TPunct(';')
          call   advance(ref toks)
          call   parse_pattern(out r, ref toks)
          call   expect(in TPunct(']'), ref toks)
          assign p := PApp(Name(None, "Cons"), list(q, r))
        else
          if head_tok(toks) == TPunct(',')
            call   advance(ref toks)
            call   parse_patterns(in ']', out ps, ref toks)
            assign p := list_pattern(list(q; ps))
          else
            call   expect(in TPunct(']'), ref toks)
            assign p := list_pattern(list(q))
          end
        end
      end

    case t =>
      raise ReadError("pattern expected but " ++ show(t) ++ " found")
  end

procedure parse_patterns(in close: Char, out ps: List[Pat], ref toks: List[Tok]) :=
  local p: Pat, rev: List[Pat] := list()
  if head_tok(toks) != TPunct(close)
    call   parse_pattern(out p, ref toks)
    assign rev := list(p)
    while head_tok(toks) == TPunct(',')
      call   advance(ref toks)
      call   parse_pattern(out p, ref toks)
      assign rev := list(p; rev)
    end
  end
  call   expect(in TPunct(close), ref toks)
  assign ps := reverse(rev)

function list_pattern(ps: List[Pat]): Pat :=
  match ps
    case list() =>
      PApp(Name(None, "Nil"), list())
    case list(p; rest) =>
      PApp(Name(None, "Cons"), list(p, list_pattern(rest)))
  end

procedure read_expr(in text: Str, out e: Expr) :=
  local toks: List[Tok]
  call lex(in text, out toks)
  call parse_expr(in list(), out e, ref toks)
  if toks != list()
    raise ReadError("unexpected " ++ show(head_tok(toks)))
  end

procedure read_decls(in decls: Decls, text: Str, out result: Decls) :=
  local toks: List[Tok]
  call   lex(in text, out toks)
  assign result := decls
  while toks != list()
    match head_tok(toks)
      case TName("function") =>
        call advance(ref toks)
        call parse_function(ref result, toks)

      case TName("data") =>
        call advance(ref toks)
        call parse_data(ref result, toks)

      case t =>
        raise ReadError("declaration expected but " ++ show(t) ++ " found")
    end
  end

procedure parse_function(ref decls: Decls, toks: List[Tok]) :=
  local f := "", xs: List[Var] := list(), t: Type, body: Expr, name: Name
  match head_tok(toks)
    case TSym(op) =>
      assign f := op
      call   advance(ref toks)

    case _ =>
      call parse_name(out f, ref toks)
  end
  call expect(in TPunct('('), ref toks)
  if head_tok(toks) != TPunct(')')
    call parse_binders(out xs, ref toks)
  end
  call expect(in TPunct(')'), ref toks)
  if head_tok(toks) == TSym(":")
    call advance(ref toks)
    call parse_type(out t, ref toks)
  end
  call   expect(in TSym(":="), ref toks)
  call   parse_expr(in reverse(list(for x in xs yield x.name)), out body, ref toks)
  assign name := Name(None, f)
  assign decls := decls with defs := put(name, Def(occurs(EFun(name), body), xs, body), decls.defs), ranks := put(name, size(decls.ranks), decls.ranks)

procedure parse_data(ref decls: Decls, toks: List[Tok]) :=
  local d := "", c := "", u: Type, fields: List[Var], cs: List[Name] := list(), name: Name, rank := 0
  call parse_name(out d, ref toks)
  if head_tok(toks) == TPunct('[')
    call advance(ref toks)
    while head_tok(toks) != TPunct(']') and head_tok(toks) != TEnd
      call advance(ref toks)
    end
    call expect(in TPunct(']'), ref toks)
  end
  call   expect(in TSym(":="), ref toks)
  assign name := Name(None, d), rank := size(decls.ranks)
  while head_tok(toks) == TSym("|")
    call   advance(ref toks)
    call   parse_name(out c, ref toks)
    assign fields := list()
    if head_tok(toks) == TPunct('(')
      call advance(ref toks)
      call parse_fields(in name, out fields, ref toks)
    end
    assign cs := cs ++ list(Name(None, c))
    assign decls := decls with ctors := put(Name(None, c), Ctor(name, fields), decls.ctors), ranks := put(Name(None, c), rank, decls.ranks)
  end
  assign decls := decls with datatypes := put(name, cs, decls.datatypes)

// fields name: T or T, where those without a name are named by their types, x for parameters and xs for the datatype
procedure parse_fields(
  in  datatype: Name,
  out fields: List[Var],
  ref toks: List[Tok]
) :=
  local x := "", t: Type, rev: List[Var] := list()
  while head_tok(toks) != TPunct(')')
    if second_tok(toks) == TSym(":")
      call parse_name(out x, ref toks)
      call advance(ref toks)
      call parse_type(out t, ref toks)
    else
      call   parse_type(out t, ref toks)
      assign x := field_name(datatype, t)
    end
    assign rev := list(Var(x, t); rev)
    if head_tok(toks) == TPunct(',')
      call advance(ref toks)
    end
  end
  call   advance(ref toks)
  assign fields := reverse(rev)

function field_name(datatype: Name, t: Type): Id :=
  match t
    case TSort(name, _) if name == datatype =>
      "xs"

    case TSort(Name(_, base), _) =>
      str(list(chr(ord(at(0, base)) + 32)))

    case _ =>
      "x"
  end
