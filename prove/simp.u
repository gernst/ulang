// contextual simplification of sequents, see Simplification in prove.md, which is not versioned
//
// Every part of a sequent is replaced by one that is equivalent to it in its context, for all values of the
// variables bound around it. Hence simplifying never turns a provable goal into an unprovable one, and the same
// steps apply to assumptions and conclusions alike: polarity only decides what true and false mean for the
// sequent around them, which conjoin and disjoin handle, and which facts the context gains, by assume and refute.
//
// The traversal goes down the sequent and carries the context:
// - the variables of the sequents above, as de Bruijn levels, onto which a sequent opens its own binders on entry,
//   so that terms of outer sequents and the facts about them stay valid inside, and which it closes again on exit,
// - facts: the assumptions before, the conjuncts before in a conclusion, and the negated conclusions before,
//   where siblings only see those before them, since each seeing all others would simplify A and A to true and true.
//
// Ground facts are equations solved into a substitution of atoms, where constructors are injective, distinct, and
// acyclic, and linear sums are solved for an atom, and inequalities over sums, decided by Fourier–Motzkin, which stand
// for the CC(X) of the plan until it is a union-find. Facts with variables are rewrite rules.

import "syntax.u"
import "map.u"

export

// nested sequents:
//   forall fixed. A1 and … and Ak ==> (exists vars1. C11 and … and C1m) or …
// where the fixed variables bind in the assumptions and conclusions, and the variables of a conclusion in its body.
// Normal forms have no connectives, quantifiers, or literals as atoms: false is Seq(Nil, Nil, Nil),
// true is Seq(Nil, Nil, [Concl(Nil, Nil)]), and not A is Seq(Nil, [A], Nil).
data Seq :=
  case Atom(expr: Expr)
  case Seq(fixed: List[Var], assms: List[Seq], concls: List[Concl])

data Concl :=
  case Concl(vars: List[Var], body: List[Seq])

function true_seq(): Seq
function false_seq(): Seq
function simplify(decls: Decls, s: Seq): Seq

// the cases of structural induction on the fixed variable at position p of the goal s, each with the hypotheses for
// the recursive fields of its constructor, which are the goal for them, for all values of the other fixed variables
function induction(decls: Decls, s: Seq, p: Int): Seq

function print_seq(s: Seq): Str

implementation

// a fact with variables, which rewrites instances of lhs to rhs if the instances of the conditions simplify to true
data Rule :=
  case Rule(vars: List[Var], conds: List[Seq], lhs: Expr, rhs: Expr)

// the variables of the opened sequents, the last one first, such that level l is at depth - 1 - l, the solved
// equations from atoms to their values, the inequalities t >= 0, the rules, whether the facts are inconsistent, and
// the limits of internal splits, of nested unfolding and rewriting, and of trial merges that decide equations
data Ctx :=
  case Ctx(decls: Decls, vars: List[Var], eqs: Map[Expr, Expr], ineqs: List[Lin], rules: List[Rule], inconsistent: Bool,
        splits: Int, unfolds: Int, probes: Int)

// a simplified conjunction with the context after it, or Refuted if a conjunct is false
data Conj :=
  case Conj(ctx: Ctx, seqs: List[Seq])
  case Refuted

// a simplified disjunction, or Proven if a disjunct is true
data Disj :=
  case Disj(concls: List[Concl])
  case Proven

data PatMatch :=
  case Matched(exprs: List[Expr])
  case Failed
  case Stuck

data Split :=
  case SplitIf(cond: Expr)
  case SplitMatch(expr: Expr, datatype: Name)

function true_seq(): Seq :=
  Seq(list(), list(), list(Concl(list(), list())))

function false_seq(): Seq :=
  Seq(list(), list(), list())

function new_ctx(decls: Decls): Ctx :=
  Ctx(decls, list(), empty(), list(), list(), false, 3, 0, 2)

function max_unfolds(): Int :=
  64

function depth(ctx: Ctx): Int :=
  size(ctx.vars)

function enter(ctx: Ctx, xs: List[Var]): Ctx :=
  ctx with vars := reverse(xs) ++ ctx.vars

// the variables of the levels from d on
function vars_from(ctx: Ctx, d: Int): List[Var] :=
  reverse(take(depth(ctx) - d, ctx.vars))

function contradiction(ctx: Ctx): Ctx :=
  ctx with inconsistent := true

function simplify(decls: Decls, s: Seq): Seq :=
  simp_seq(new_ctx(decls), s)

// opening, closing, and substitution of sequents, as of terms

function rebind_seq(op: Rebind, c: Int, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      Atom(rebind(op, c, expr))

    case Seq(fixed, assms, concls) =>
      let inner := c + size(fixed) in
      Seq(fixed, list(for a in assms yield rebind_seq(op, inner, a)), list(for d in concls yield rebind_concl(op, inner, d)))
  end

function rebind_concl(op: Rebind, c: Int, d: Concl): Concl :=
  match d
    case Concl(vars, body) =>
      Concl(vars, list(for s in body yield rebind_seq(op, c + size(vars), s)))
  end

function replace_seq(a: Expr, b: Expr, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      Atom(replace(a, b, expr))

    case Seq(fixed, assms, concls) =>
      Seq(fixed, list(for x in assms yield replace_seq(a, b, x)), list(for d in concls yield replace_concl(a, b, d)))
  end

function replace_concl(a: Expr, b: Expr, d: Concl): Concl :=
  match d
    case Concl(vars, body) =>
      Concl(vars, list(for s in body yield replace_seq(a, b, s)))
  end

function subst_seq(c: Int, t: Expr, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      Atom(subst(c, t, expr))

    case Seq(fixed, assms, concls) =>
      let inner := c + size(fixed) in
      Seq(fixed, list(for a in assms yield subst_seq(inner, t, a)), list(for d in concls yield subst_concl(inner, t, d)))
  end

function subst_concl(c: Int, t: Expr, d: Concl): Concl :=
  match d
    case Concl(vars, body) =>
      Concl(vars, list(for s in body yield subst_seq(c + size(vars), t, s)))
  end

function beta_seq(args: List[Expr], s: Seq): Seq :=
  match reverse(args)
    case list() =>
      s

    case list(a; rest) =>
      beta_seq(reverse(rest), subst_seq(0, shift(size(rest), a), s))
  end

function loose_seq(c: Int, s: Seq): List[Int] :=
  match s
    case Atom(expr) =>
      loose(c, expr)

    case Seq(fixed, assms, concls) =>
      let inner := c + size(fixed) in
      list(for a in assms for i in loose_seq(inner, a) yield i) ++ list(for d in concls for i in loose_concl(inner, d) yield i)
  end

function loose_concl(c: Int, d: Concl): List[Int] :=
  match d
    case Concl(vars, body) =>
      list(for s in body for i in loose_seq(c + size(vars), s) yield i)
  end

// normalization of the connectives and quantifiers of a formula into the structure of sequents

function to_seq(e: Expr): Seq :=
  match e
    case EConst(VBool(true)) =>
      true_seq()

    case EConst(VBool(false)) =>
      false_seq()

    case EApp(EFun(Name(None, "not")), list(a)) =>
      Seq(list(), list(to_seq(a)), list())

    case EApp(EFun(Name(None, "and")), list(a, b)) =>
      Seq(list(), list(), list(Concl(list(), list(to_seq(a), to_seq(b)))))

    case EApp(EFun(Name(None, "or")), list(a, b)) =>
      Seq(list(), list(), list(Concl(list(), list(to_seq(a))), Concl(list(), list(to_seq(b)))))

    case EApp(EFun(Name(None, "==>")), list(a, b)) =>
      Seq(list(), list(to_seq(a)), list(Concl(list(), list(to_seq(b)))))

    case EApp(EFun(Name(None, "forall")), list(ELam(formals, body))) =>
      Seq(formals, list(), list(Concl(list(), list(to_seq(body)))))

    case EApp(EFun(Name(None, "exists")), list(ELam(formals, body))) =>
      Seq(list(), list(), list(Concl(formals, list(to_seq(body)))))

    case EIte(cond, then_expr, else_expr) =>
      let t := to_seq(cond) in
      Seq(list(), list(), list(Concl(list(), list(Seq(list(), list(t), list(Concl(list(), list(to_seq(then_expr))))), Seq(list(), list(Seq(list(), list(t), list())), list(Concl(list(), list(to_seq(else_expr)))))))))

    case _ =>
      Atom(e)
  end

// a sequent equivalent to s in the context, where s has no free indices
function simp_seq(ctx: Ctx, s: Seq): Seq :=
  match s
    case Atom(expr) =>
      let t := simp_expr(ctx, expr) in
      let n := to_seq(t) in
      match n
        case Atom(_) =>
          n

        case _ =>
          simp_seq(ctx, n)
      end

    case Seq(fixed, assms, concls) =>
      simp_sequent(ctx, fixed, assms, concls)
  end

// its binders are opened, its assumptions simplified as a conjunction, which may add binders, its conclusions in the
// context of all assumptions, and the result closed again, or else split on a condition if all cases are closed
function simp_sequent(ctx: Ctx, xs: List[Var], assms: List[Seq], concls: List[Concl]): Seq :=
  let d := depth(ctx), k := size(xs) in
  let cs := list(for c in concls yield rebind_concl(Open(d, k), 0, c)) in
  match conjoin(enter(ctx, xs), list(for a in assms yield rebind_seq(Open(d, k), 0, a)))
    case Refuted =>
      true_seq()

    case Conj(after, seqs) =>
      match one_point(d, seqs)
        case Some((l, t, rest)) =>
          let levels := list(for m in range(d, depth(after)) if m != l) in
          simp_seq(ctx, Seq(list(for m in levels yield at(m - d, vars_from(after, d))),
                            list(for b in rest yield rebind_seq(Close(levels), 0, replace_seq(ELevel(l), t, b))),
                            list(for c in cs yield rebind_concl(Close(levels), 0, replace_concl(ELevel(l), t, c)))))

        case None =>
          match disjoin(after, cs)
            case Proven =>
              true_seq()

            case Disj(concls) =>
              let levels := range(d, depth(after)), ys := vars_from(after, d) in
              let closed := list(for b in seqs yield rebind_seq(Close(levels), 0, b)), ends := list(for c in concls yield rebind_concl(Close(levels), 0, c)) in
              let result := sequent(ys, closed, ends) in
              split_on(ctx, levels, ys, closed, ends, split_candidate(ctx.decls, seqs, concls), result)
          end
      end
  end

// a sequent that only wraps a single conjunct is that conjunct, not not A is A, and a single conclusion that is a sequent without
// existential variables is merged, since A ==> (forall y. B ==> C) is forall y. A and B ==> C
function sequent(xs: List[Var], assms: List[Seq], concls: List[Concl]): Seq :=
  match (xs, assms, concls)
    case (list(), list(), list(Concl(list(), list(s)))) =>
      s

    case (list(), list(Seq(list(), list(s), list())), list()) =>
      s

    case (_, _, list(Concl(list(), list(Seq(fixed, bs, concls))))) =>
      Seq(xs ++ fixed, list(for a in assms yield rebind_seq(Shift(size(fixed)), 0, a)) ++ bs, concls)

    case _ =>
      Seq(xs, assms, concls)
  end

// an equation of a variable of the levels from d on with a term without it, by which it is eliminated
function one_point(d: Int, ss: List[Seq]): Option[Int * Expr * List[Seq]] :=
  match ss
    case list() =>
      None

    case list(s; rest) =>
      match equation_of(d, s)
        case Some((l, t)) =>
          Some((l, t, rest))

        case None =>
          match one_point(d, rest)
            case Some((l, t, more)) =>
              Some((l, t, list(s; more)))

            case None =>
              None
          end
      end
  end

function equation_of(d: Int, s: Seq): Option[Int * Expr] :=
  match s
    case Atom(EApp(EFun(Name(None, "==")), list(ELevel(level), t))) if level >= d and not occurs(ELevel(level), t) =>
      Some((level, t))

    case Atom(EApp(EFun(Name(None, "==")), list(t, ELevel(level)))) if level >= d and not occurs(ELevel(level), t) =>
      Some((level, t))

    case _ =>
      None
  end

// each conjunct in the context of those before it, since A and B is A and (A ==> B), where true conjuncts are dropped,
// for assumptions and the bodies of conclusions alike, and conjunctions and existentials among them are spliced in,
// whose variables become levels after those of the context
function conjoin(ctx: Ctx, ss: List[Seq]): Conj :=
  match ss
    case list() =>
      Conj(ctx, list())

    case list(s; rest) =>
      let t := simp_seq(ctx, s) in
      match t
        case Seq(list(), list(), list(Concl(list(), list()))) =>
          conjoin(ctx, rest)

        case Seq(list(), list(), list()) =>
          Refuted

        case Seq(list(), list(), list(Concl(vars, body))) =>
          let d := depth(ctx) in
          conjoin(enter(ctx, vars), list(for b in body yield rebind_seq(Open(d, size(vars)), 0, b)) ++ rest)

        case _ =>
          let next := assume(ctx, t) in
          if next.inconsistent then
            Refuted
          else
            match conjoin(next, rest)
              case Conj(ctx, seqs) =>
                Conj(ctx, list(t; seqs))

              case Refuted =>
                Refuted
            end
      end
  end

// each disjunct in the context of the negations of those before it, where false disjuncts are dropped
function disjoin(ctx: Ctx, cs: List[Concl]): Disj :=
  match cs
    case list() =>
      Disj(list())

    case list(c; rest) =>
      match simp_concl(ctx, c)
        case None =>
          disjoin(ctx, rest)

        case Some(Concl(_, list())) =>
          Proven

        case Some(Concl(list(), list(Seq(list(), list(), concls)))) =>
          disjoin(ctx, concls ++ rest)

        case Some(d) =>
          let next := refute(ctx, d) in
          if next.inconsistent then
            Proven
          else
            match disjoin(next, rest)
              case Disj(concls) =>
                Disj(list(d; concls))

              case Proven =>
                Proven
            end
      end
  end

// the conclusion, or None if it is false, whose existential variables are opened like fixed ones, which is sound
// since simplification is an equivalence for all their values, but they are never instantiated here, except by
// the one-point rule
function simp_concl(ctx: Ctx, c: Concl): Option[Concl] :=
  match c
    case Concl(vars, body) =>
      let d := depth(ctx), k := size(vars) in
      match conjoin(enter(ctx, vars), list(for s in body yield rebind_seq(Open(d, k), 0, s)))
        case Refuted =>
          None

        case Conj(after, seqs) =>
          match one_point(d, seqs)
            case Some((l, t, rest)) =>
              let levels := list(for m in range(d, depth(after)) if m != l) in
              simp_concl(ctx, Concl(list(for m in levels yield at(m - d, vars_from(after, d))),
                                    list(for s in rest yield rebind_seq(Close(levels), 0, replace_seq(ELevel(l), t, s)))))

            case None =>
              let levels := range(d, depth(after)) in
              Some(Concl(vars_from(after, d), list(for t in seqs yield rebind_seq(Close(levels), 0, t))))
          end
      end
  end

// the context with s known to be true: atoms and their negations are facts, and sequents with a single atomic
// conclusion rules, while other ground sequents, which would be clauses, are not used yet
function assume(ctx: Ctx, s: Seq): Ctx :=
  match s
    case Atom(expr) =>
      assume_expr(ctx, expr, true)

    case Seq(list(), list(Atom(expr)), list()) =>
      assume_expr(ctx, expr, false)

    case Seq(fixed, assms, list(Concl(list(), list(Atom(expr))))) =>
      add_rule(ctx, fixed, assms, expr, true)

    case Seq(fixed, assms, list(Concl(list(), list(Seq(list(), list(Atom(expr)), list()))))) =>
      add_rule(ctx, fixed, assms, expr, false)

    // forall xs. A1 and … and Ak ==> false, as the rule Ak == false under the others
    case Seq(fixed, list(a; more), list()) =>
      match reverse(list(a; more))
        case list(Atom(expr); conds) =>
          add_rule(ctx, fixed, reverse(conds), expr, false)

        case _ =>
          ctx
      end

    case _ =>
      ctx
  end

// the context with c known to be false, for the conclusions after it, since A ==> C1 or C2 is A and not C1 ==> C2,
// where the negation of an existential is a rule
function refute(ctx: Ctx, c: Concl): Ctx :=
  match c
    case Concl(list(), list(Atom(expr))) =>
      assume_expr(ctx, expr, false)

    case Concl(list(), list(Seq(list(), list(Atom(expr)), list()))) =>
      assume_expr(ctx, expr, true)

    case Concl(vars, list(Atom(expr))) =>
      add_rule(ctx, vars, list(), expr, false)

    case _ =>
      ctx
  end

function add_rule(ctx: Ctx, xs: List[Var], conds: List[Seq], e: Expr, b: Bool): Ctx :=
  let rule := match e
      case EApp(EFun(Name(None, "==")), list(l, r)) if b =>
        if greater(ctx.decls, l, r) then Rule(xs, conds, l, r)
        else if greater(ctx.decls, r, l) then Rule(xs, conds, r, l)
        else Rule(xs, conds, e, bool_expr(true))

      case _ =>
        Rule(xs, conds, e, bool_expr(b))
    end in
  if valid_rule(rule) then ctx with rules := list(rule; ctx.rules) else ctx

// the variables of the right side and of the conditions occur in the left side, which is not a variable
function valid_rule(r: Rule): Bool :=
  match r.lhs
    case EBound(_) =>
      false

    case EConst(_) =>
      false

    case _ =>
      let bound := loose(0, r.lhs) in
      forall(loose(0, r.rhs) ++ list(for c in r.conds for k in loose_seq(0, c) yield k), lambda i => contains(i, bound))
  end

// facts about atoms

function assume_expr(ctx: Ctx, e: Expr, b: Bool): Ctx :=
  if ctx.inconsistent then
    ctx
  else
    match e
      case EConst(VBool(bool)) =>
        if bool == b then ctx else contradiction(ctx)

      case EApp(EFun(Name(None, "not")), list(a)) =>
        assume_expr(ctx, a, not b)

      case EApp(EFun(Name(None, "and")), list(x, y)) if b =>
        assume_expr(assume_expr(ctx, x, true), y, true)

      case EApp(EFun(Name(None, "or")), list(x, y)) if not b =>
        assume_expr(assume_expr(ctx, x, false), y, false)

      case EApp(EFun(Name(None, "==")), list(x, y)) if b =>
        merge(ctx, x, y, 20)

      case EApp(EFun(Name(None, "<")), list(x, y)) =>
        if b then add_ineq(ctx, lin_add(lin_sub(lin_of(y), lin_of(x)), Lin(-1, list())))
        else add_ineq(ctx, lin_sub(lin_of(x), lin_of(y)))

      case _ =>
        merge(ctx, e, bool_expr(b), 20)
    end

function is_value(decls: Decls, e: Expr): Bool :=
  match e
    case EConst(_) =>
      true

    case _ =>
      ctor_head(decls, e) != None
  end

function is_sum(e: Expr): Bool :=
  match e
    case ESum(_, _) =>
      true

    case _ =>
      false
  end

// whether a occurs in v below constructors only, such that a == v has no solution
function occurs_ctor(decls: Decls, a: Expr, v: Expr): Bool :=
  if a == v then
    true
  else
    match ctor_head(decls, v)
      case Some((_, args)) =>
        exists(args, lambda x => occurs_ctor(decls, a, x))

      case None =>
        false
    end

// the context with a == b for canonical a and b, solved by the theories into equations of atoms with their values
function merge(ctx: Ctx, a: Expr, b: Expr, fuel: Int): Ctx :=
  if fuel <= 0 or ctx.inconsistent or a == b then
    ctx
  else if is_sum(a) or is_sum(b) then
    merge_lin(ctx, lin_sub(lin_of(a), lin_of(b)), fuel)
  else
    match (ctor_head(ctx.decls, a), ctor_head(ctx.decls, b))
      case (Some((f, xs)), Some((g, ys))) =>
        if f == g and size(xs) == size(ys) then merge_all(ctx, xs, ys, fuel) else contradiction(ctx)

      case _ =>
        if is_value(ctx.decls, a) and is_value(ctx.decls, b) then
          contradiction(ctx)
        else if is_value(ctx.decls, b) then
          if occurs_ctor(ctx.decls, a, b) then contradiction(ctx) else add_pair(ctx, a, b, fuel)
        else if is_value(ctx.decls, a) then
          if occurs_ctor(ctx.decls, b, a) then contradiction(ctx) else add_pair(ctx, b, a, fuel)
        else if greater(ctx.decls, a, b) then
          add_pair(ctx, a, b, fuel)
        else if greater(ctx.decls, b, a) then
          add_pair(ctx, b, a, fuel)
        else if compare(a, b) > 0 then
          add_pair(ctx, a, b, fuel)
        else
          add_pair(ctx, b, a, fuel)
    end

function merge_all(ctx: Ctx, xs: List[Expr], ys: List[Expr], fuel: Int): Ctx :=
  match (xs, ys)
    case (list(x; xs1), list(y; ys1)) =>
      merge_all(merge(ctx, simp_expr(ctx, x), simp_expr(ctx, y), fuel - 1), xs1, ys1, fuel)

    case _ =>
      ctx
  end

// the context with d == 0, solved for its greatest atom with a coefficient 1 or -1, or else kept as the equation
// of its atoms, divided by their greatest common divisor, with the constant
function merge_lin(ctx: Ctx, d: Lin, fuel: Int): Ctx :=
  match d
    case Lin(k, list()) =>
      if k == 0 then ctx else contradiction(ctx)

    case Lin(k, terms) =>
      match greatest_unit(ctx.decls, terms, None)
        case Some((t, n)) =>
          let rest := lin_sub(d, Lin(0, list((t, n)))) in
          add_pair(ctx, t, sum_expr(if n == 1 then lin_scale(-1, rest) else rest), fuel)

        case None =>
          let g := gcd_all(terms) in
          if k % g != 0 then contradiction(ctx)
          else add_pair(ctx, sum_expr(Lin(0, list(for p in terms yield (first(p), second(p) / g)))), int_expr(0 - k / g), fuel)
      end
  end

function greatest_unit(decls: Decls, ts: List[Expr * Int], best: Option[Expr * Int]): Option[Expr * Int] :=
  match ts
    case list() =>
      best

    case list((t, n); rest) =>
      if n != 1 and n != -1 then
        greatest_unit(decls, rest, best)
      else
        match best
          case Some((u, _)) if not greater(decls, t, u) =>
            greatest_unit(decls, rest, best)

          case _ =>
            greatest_unit(decls, rest, Some((t, n)))
        end
  end

function gcd_all(ts: List[Expr * Int]): Int :=
  match ts
    case list() =>
      0

    case list((_, n); rest) =>
      gcd(n, gcd_all(rest))
  end

// the context with the atom l solved to r, where the equations and inequalities that mention l are solved again
function add_pair(ctx: Ctx, l: Expr, r: Expr, fuel: Int): Ctx :=
  let old := list(for x in ctx.eqs) in
  let changed := list(for p in old if occurs(l, first(p)) or occurs(l, second(p))) in
  let eqs := remove_keys(changed, ctx.eqs) in
  let base := ctx with eqs := put(l, r, eqs), ineqs := list() in
  let next := remerge(base, list(for p in changed yield (replace(l, r, first(p)), replace(l, r, second(p)))), fuel - 1) in
  readd_ineqs(next, ctx.ineqs)

function remove_keys(ps: List[Expr * Expr], eqs: Map[Expr, Expr]): Map[Expr, Expr] :=
  match ps
    case list() =>
      eqs

    case list((k, _); rest) =>
      remove_keys(rest, remove(k, eqs))
  end

function remerge(ctx: Ctx, ps: List[Expr * Expr], fuel: Int): Ctx :=
  match ps
    case list() =>
      ctx

    case list((a, b); rest) =>
      remerge(merge(ctx, simp_expr(ctx, a), simp_expr(ctx, b), fuel), rest, fuel)
  end

function readd_ineqs(ctx: Ctx, ls: List[Lin]): Ctx :=
  match ls
    case list() =>
      ctx

    case list(l; rest) =>
      readd_ineqs(add_ineq(ctx, lin_of(simp_expr(ctx, sum_expr(l)))), rest)
  end

// inequalities t >= 0 over the integers

function floor_div(a: Int, b: Int): Int :=
  if a >= 0 then a / b else 0 - (0 - a + b - 1) / b

function tighten(t: Lin): Lin :=
  let g := gcd_all(t.terms) in
  if g <= 1 then t else Lin(floor_div(t.k, g), list(for p in t.terms yield (first(p), second(p) / g)))

// t < 0, that is -t - 1 >= 0
function negated(t: Lin): Lin :=
  lin_add(lin_scale(-1, t), Lin(-1, list()))

function coefficient(x: Expr, t: Lin): Int :=
  match list(for p in t.terms if first(p) == x yield second(p))
    case list(n; _) =>
      n

    case list() =>
      0
  end

// whether the inequalities have no integer solution, by Fourier–Motzkin with tightening, which may miss some
function fm_unsat(cs: List[Lin], fuel: Int): Bool :=
  if exists(cs, lambda c => c.terms == list() and c.k < 0) then
    true
  else
    match list(for c in cs if c.terms != list())
      case list() =>
        false

      case list(c; more) =>
        if fuel <= 0 or size(more) > 60 then
          false
        else
          let rest := list(c; more), x := first(at(0, c.terms)) in
          let pos := list(for t in rest if coefficient(x, t) > 0), neg := list(for t in rest if coefficient(x, t) < 0) in
          let none := list(for t in rest if coefficient(x, t) == 0) in
          fm_unsat(none ++ list(for p in pos for n in neg yield combine(x, p, n)), fuel - 1)
    end

function combine(x: Expr, p: Lin, n: Lin): Lin :=
  tighten(lin_add(lin_scale(0 - coefficient(x, n), p), lin_scale(coefficient(x, p), n)))

function entailed(ctx: Ctx, t: Lin): Bool :=
  ctx.inconsistent or fm_unsat(list(tighten(negated(t)); ctx.ineqs ++ bounds(ctx, t)), 20)

// the instances of rules p < q without conditions, for the atoms of t and of the inequalities, with a single atom
// p - q that binds all variables of the rule
function bounds(ctx: Ctx, t: Lin): List[Lin] :=
  let atoms := list(for p in t.terms yield first(p)) ++ list(for l in ctx.ineqs for p in l.terms yield first(p)) in
  list(for a in atoms for r in ctx.rules for b in bound_of(r, a) yield b)

function bound_of(r: Rule, a: Expr): List[Lin] :=
  match (r.conds, r.lhs, r.rhs)
    case (list(), EApp(EFun(Name(None, "<")), list(p, q)), EConst(VBool(bool))) =>
      match lin_sub(lin_of(p), lin_of(q))
        case Lin(_, list((atom, _))) =>
          match match_term(size(r.vars), atom, a, empty())
            case Some(sub) =>
              let n := size(r.vars) in
              let args := list(for i in range(0, n) yield lookup_index(n - 1 - i, sub)) in
              let d := lin_sub(lin_of(beta(args, q)), lin_of(beta(args, p))) in
              if bool then list(lin_add(d, Lin(-1, list()))) else list(lin_scale(-1, d))

            case None =>
              list()
          end

        case _ =>
          list()
      end

    case _ =>
      list()
  end

function add_ineq(ctx: Ctx, d: Lin): Ctx :=
  if ctx.inconsistent then
    ctx
  else
    let t := tighten(d) in
    match t
      case Lin(k, list()) =>
        if k >= 0 then ctx else contradiction(ctx)

      case _ =>
        if entailed(ctx, t) then
          ctx
        else if fm_unsat(list(t; ctx.ineqs), 20) then
          contradiction(ctx)
        else
          let next := ctx with ineqs := list(t; ctx.ineqs) in
          if entailed(next, lin_scale(-1, t)) then merge_lin(next, t, 10) else next
    end

// terms

// a term equal to e in the context, in normal form: the subterms are simplified here, the branches of an if under its
// condition and its negation, and a function for each kind of term combines the results, where binders are left alone
function simp_expr(ctx: Ctx, e: Expr): Expr :=
  match e
    case EApp(fun, args) =>
      let g := simp_expr(ctx, fun), bs := list(for a in args yield simp_expr(ctx, a)) in
      simp_app(ctx, g, bs)

    case EIte(cond, then_expr, else_expr) =>
      let t := simp_expr(ctx, cond) in
      match t
        case EConst(VBool(true)) =>
          simp_expr(ctx, then_expr)

        case EConst(VBool(false)) =>
          simp_expr(ctx, else_expr)

        case _ =>
          let u := simp_expr(assume_expr(ctx, t, true), then_expr), v := simp_expr(assume_expr(ctx, t, false), else_expr) in
          simp_ite(t, u, v)
      end

    case EMatch(expr, cases) =>
      let t := simp_expr(ctx, expr) in
      match select(ctx, t, cases)
        case Some(b) =>
          simp_expr(ctx, b)

        case None =>
          EMatch(t, cases)
      end

    case ESum(constant, terms) =>
      rewrite(ctx, sum_expr(simp_terms(ctx, terms, Lin(constant, list()))))

    case EFun(name) =>
      match get(name, ctx.decls.defs)
        case Some(d) =>
          unfold(ctx, e, d, list())

        case None =>
          rewrite(ctx, e)
      end

    case ELevel(_) =>
      rewrite(ctx, e)

    case ERaise(expr, typ) =>
      ERaise(simp_expr(ctx, expr), typ)

    case _ =>
      e
  end

function simp_terms(ctx: Ctx, ts: List[Expr * Int], acc: Lin): Lin :=
  match ts
    case list() =>
      acc

    case list((t, n); rest) =>
      simp_terms(ctx, rest, lin_add(acc, lin_scale(n, lin_of(simp_expr(ctx, t)))))
  end

function simp_ite(c: Expr, a: Expr, b: Expr): Expr :=
  if a == b then
    a
  else
    match (a, b)
      case (EConst(VBool(true)), EConst(VBool(false))) =>
        c

      case (EConst(VBool(false)), EConst(VBool(true))) =>
        app("not", list(c))

      case _ =>
        EIte(c, a, b)
    end

function builtins(): List[Id] :=
  list("+", "-", "*", "/", "%", "==", "<", "not", "and", "or", "==>")

function simp_app(ctx: Ctx, f: Expr, args: List[Expr]): Expr :=
  match f
    case ELam(formals, body) if size(formals) == size(args) =>
      simp_expr(ctx, beta(args, body))

    case EFun(Name(None, base)) if contains(base, builtins()) =>
      simp_builtin(ctx, base, args)

    case EFun(name) =>
      match get(name, ctx.decls.defs)
        case Some(d) =>
          unfold(ctx, EApp(f, args), d, args)

        case None =>
          rewrite(ctx, EApp(f, args))
      end

    case _ =>
      rewrite(ctx, EApp(f, args))
  end

function simp_builtin(ctx: Ctx, op: Id, args: List[Expr]): Expr :=
  match (op, args)
    case ("+", list(a, b)) =>
      rewrite(ctx, sum_expr(lin_add(lin_of(a), lin_of(b))))

    case ("-", list(a, b)) =>
      rewrite(ctx, sum_expr(lin_sub(lin_of(a), lin_of(b))))

    case ("*", list(EConst(VInt(num)), b)) =>
      rewrite(ctx, sum_expr(lin_scale(num, lin_of(b))))

    case ("*", list(a, EConst(VInt(num)))) =>
      rewrite(ctx, sum_expr(lin_scale(num, lin_of(a))))

    case ("*", list(a, b)) =>
      rewrite(ctx, app("*", ordered(a, b)))

    case ("/", list(EConst(VInt(m)), EConst(VInt(n)))) if n != 0 =>
      int_expr(m / n)

    case ("%", list(EConst(VInt(m)), EConst(VInt(n)))) if n != 0 =>
      int_expr(m % n)

    case ("==", list(a, b)) =>
      simp_eq(ctx, a, b)

    case ("<", list(a, b)) =>
      simp_less(ctx, a, b)

    case ("not", list(EConst(VBool(bool)))) =>
      bool_expr(not bool)

    case ("not", list(EApp(EFun(Name(None, "not")), list(a)))) =>
      a

    case ("and", list(a, b)) =>
      if a == bool_expr(false) or b == bool_expr(false) then bool_expr(false)
      else if a == bool_expr(true) or a == b then b
      else if b == bool_expr(true) then a
      else rewrite(ctx, app("and", list(a, b)))

    case ("or", list(a, b)) =>
      if a == bool_expr(true) or b == bool_expr(true) then bool_expr(true)
      else if a == bool_expr(false) or a == b then b
      else if b == bool_expr(false) then a
      else rewrite(ctx, app("or", list(a, b)))

    case ("==>", list(a, b)) =>
      if a == bool_expr(false) or b == bool_expr(true) or a == b then bool_expr(true)
      else if a == bool_expr(true) then b
      else if b == bool_expr(false) then simp_builtin(ctx, "not", list(a))
      else rewrite(ctx, app("==>", list(a, b)))

    case _ =>
      rewrite(ctx, app(op, args))
  end

// the sides of an equation, the greater in the term order first
function oriented(decls: Decls, a: Expr, b: Expr): List[Expr] :=
  if greater(decls, b, a) then list(b, a)
  else if greater(decls, a, b) then list(a, b)
  else ordered(a, b)

function ordered(a: Expr, b: Expr): List[Expr] :=
  if compare(a, b) > 0 then list(b, a) else list(a, b)

// true if equal in normal form, false if assuming it is inconsistent, as for distinct constructors
function simp_eq(ctx: Ctx, a: Expr, b: Expr): Expr :=
  if a == b then
    bool_expr(true)
  else if ctx.probes > 0 and merge(ctx with probes := ctx.probes - 1, a, b, 5).inconsistent then
    bool_expr(false)
  else
    rewrite(ctx, app("==", oriented(ctx.decls, a, b)))

function simp_less(ctx: Ctx, a: Expr, b: Expr): Expr :=
  let d := lin_sub(lin_of(b), lin_of(a)) in
  match d
    case Lin(k, list()) =>
      bool_expr(k >= 1)

    case _ =>
      if entailed(ctx, lin_add(d, Lin(-1, list()))) then bool_expr(true)
      else if entailed(ctx, lin_scale(-1, d)) then bool_expr(false)
      else rewrite(ctx, app("<", list(a, b)))
  end

// the application of a function to its arguments, unfolded always if it is not recursive, and else where the match or
// if of its body is decided, which terminates since functions do
function unfold(ctx: Ctx, t: Expr, d: Def, args: List[Expr]): Expr :=
  if size(d.formals) != size(args) or ctx.unfolds > max_unfolds() then
    rewrite(ctx, t)
  else
    let body := beta(args, d.body), inner := ctx with unfolds := ctx.unfolds + 1 in
    if not d.recursive then
      simp_expr(inner, body)
    else
      match body
        case EMatch(expr, cases) =>
          match select(inner, simp_expr(inner, expr), cases)
            case Some(b) =>
              simp_expr(inner, b)

            case None =>
              rewrite(ctx, t)
          end

        case EIte(cond, then_expr, else_expr) =>
          match simp_expr(inner, cond)
            case EConst(VBool(true)) =>
              simp_expr(inner, then_expr)

            case EConst(VBool(false)) =>
              simp_expr(inner, else_expr)

            case _ =>
              rewrite(ctx, t)
          end

        case _ =>
          rewrite(ctx, t)
      end

// the body of the first branch that matches t, with the values of its variables, or None if that is not decided
function select(ctx: Ctx, t: Expr, bs: List[Branch]): Option[Expr] :=
  match bs
    case list() =>
      None

    case list(Branch(pat, guard, body); rest) =>
      match match_pat(ctx.decls, pat, t)
        case Failed =>
          select(ctx, t, rest)

        case Stuck =>
          None

        case Matched(exprs) =>
          match guard
            case None =>
              Some(beta(exprs, body))

            case Some(h) =>
              match simp_expr(ctx, beta(exprs, h))
                case EConst(VBool(true)) =>
                  Some(beta(exprs, body))

                case EConst(VBool(false)) =>
                  select(ctx, t, rest)

                case _ =>
                  None
              end
          end
      end
  end

function match_pat(decls: Decls, p: Pat, t: Expr): PatMatch :=
  match p
    case PWild =>
      Matched(list())

    case PVar(_) =>
      Matched(list(t))

    case PLit(lit) =>
      match t
        case EConst(w) =>
          if lit == w then Matched(list()) else Failed

        case _ =>
          Stuck
      end

    case PApp(constr, pats) =>
      match ctor_head(decls, t)
        case Some((f, args)) =>
          if f == constr and size(pats) == size(args) then match_pats(decls, pats, args) else Failed

        case None =>
          Stuck
      end
  end

function match_pats(decls: Decls, ps: List[Pat], ts: List[Expr]): PatMatch :=
  match (ps, ts)
    case (list(p; ps1), list(t; ts1)) =>
      match (match_pat(decls, p, t), match_pats(decls, ps1, ts1))
        case (Failed, _) =>
          Failed

        case (_, Failed) =>
          Failed

        case (Matched(xs), Matched(ys)) =>
          Matched(xs ++ ys)

        case _ =>
          Stuck
      end

    case _ =>
      Matched(list())
  end

// the value of a canonical atom by the equations, or else by the first rule that applies
function rewrite(ctx: Ctx, t: Expr): Expr :=
  match get(t, ctx.eqs)
    case Some(v) =>
      v

    case None =>
      if ctx.unfolds > max_unfolds() then t else apply_rules(ctx, ctx.rules, t)
  end

function apply_rules(ctx: Ctx, rules: List[Rule], t: Expr): Expr :=
  match rules
    case list() =>
      t

    case list(r; rest) =>
      match instance(ctx, r, t)
        case Some(u) =>
          u

        case None =>
          apply_rules(ctx, rest, t)
      end
  end

function instance(ctx: Ctx, r: Rule, t: Expr): Option[Expr] :=
  let n := size(r.vars) in
  match match_term(n, r.lhs, t, empty())
    case Some(sub) =>
      let args := list(for i in range(0, n) yield lookup_index(n - 1 - i, sub)), inner := ctx with unfolds := ctx.unfolds + 1 in
      if forall(r.conds, lambda c => simp_seq(inner, beta_seq(args, c)) == true_seq()) then
        Some(simp_expr(inner, beta(args, r.rhs)))
      else
        None

    case None =>
      None
  end

function lookup_index(i: Int, sub: Map[Int, Expr]): Expr :=
  match get(i, sub)
    case Some(e) =>
      e

    case None =>
      EBound(i)
  end

// the values of the variables below n of the pattern p such that it is t, first order
function match_term(n: Int, p: Expr, t: Expr, sub: Map[Int, Expr]): Option[Map[Int, Expr]] :=
  match (p, t)
    case (EBound(index), _) if index < n =>
      match get(index, sub)
        case Some(u) =>
          if u == t then Some(sub) else None

        case None =>
          Some(put(index, t, sub))
      end

    case (EApp(f, ps), EApp(g, ts)) if size(ps) == size(ts) =>
      match_terms(n, list(f; ps), list(g; ts), sub)

    case (ESum(k, ps), ESum(m, ts)) if k == m and size(ps) == size(ts) =>
      if list(for q in ps yield second(q)) == list(for q in ts yield second(q)) then match_terms(n, list(for q in ps yield first(q)), list(for q in ts yield first(q)), sub)
      else None

    case _ =>
      if p == t then Some(sub) else None
  end

function match_terms(n: Int, ps: List[Expr], ts: List[Expr], sub: Map[Int, Expr]): Option[Map[Int, Expr]] :=
  match (ps, ts)
    case (list(p; ps1), list(t; ts1)) =>
      match match_term(n, p, t, sub)
        case Some(next) =>
          match_terms(n, ps1, ts1, next)

        case None =>
          None
      end

    case _ =>
      Some(sub)
  end

// internal splits on a condition or the value of a match that is not decided, kept only if all cases are closed

function split_on(ctx: Ctx, levels: List[Int], ys: List[Var], assms: List[Seq], concls: List[Concl], cand: Option[Split], result: Seq): Seq :=
  if ctx.splits <= 0 then
    result
  else
    match cand
      case None =>
        result

      case Some(SplitIf(cond)) =>
        let t := Atom(rebind(Close(levels), 0, cond)), inner := ctx with splits := ctx.splits - 1 in
        if simp_seq(inner, Seq(ys, list(t; assms), concls)) == true_seq()
            and simp_seq(inner, Seq(ys, list(Seq(list(), list(t), list()); assms), concls)) == true_seq() then
          true_seq()
        else
          result

      case Some(SplitMatch(expr, datatype)) =>
        let t := rebind(Close(levels), 0, expr), inner := ctx with splits := ctx.splits - 1 in
        match get(datatype, ctx.decls.datatypes)
          case Some(cs) =>
            if forall(cs, lambda c => simp_seq(inner, split_case(ctx.decls, ys, assms, concls, t, c)) == true_seq()) then
              true_seq()
            else
              result

          case None =>
            result
        end
    end

// the case of the constructor c for the value t, with the fields of c as fixed variables outside the others
function split_case(decls: Decls, ys: List[Var], assms: List[Seq], concls: List[Concl], t: Expr, c: Name): Seq :=
  match get(c, decls.ctors)
    case Some(Ctor(_, fields)) =>
      let k := size(ys), n := size(fields) in
      let value := if n == 0 then EFun(c) else EApp(EFun(c), list(for i in range(0, n) yield EBound(k + n - 1 - i))) in
      Seq(fields ++ ys, list(Atom(app("==", list(t, value))); assms), concls)

    case None =>
      Seq(ys, assms, concls)
  end

function split_candidate(decls: Decls, ss: List[Seq], cs: List[Concl]): Option[Split] :=
  or_else(first_of(list(for s in ss yield candidate_seq(decls, s))), first_of(list(for c in cs yield candidate_concl(decls, c))))

function first_of(os: List[Option[Split]]): Option[Split] :=
  match os
    case list() =>
      None

    case list(Some(s); _) =>
      Some(s)

    case list(None; rest) =>
      first_of(rest)
  end

function candidate_seq(decls: Decls, s: Seq): Option[Split] :=
  match s
    case Atom(expr) =>
      candidate(decls, expr)

    case Seq(_, assms, concls) =>
      split_candidate(decls, assms, concls)
  end

function candidate_concl(decls: Decls, c: Concl): Option[Split] :=
  first_of(list(for s in c.body yield candidate_seq(decls, s)))

function candidate(decls: Decls, e: Expr): Option[Split] :=
  match e
    case EIte(cond, then_expr, else_expr) =>
      or_else(candidate(decls, cond), if loose(0, cond) == list() then Some(SplitIf(positive(cond))) else or_else(candidate(decls, then_expr), candidate(decls, else_expr)))

    case EMatch(expr, cases) =>
      match (loose(0, expr), datatype_of(decls, cases))
        case (list(), Some(t)) =>
          or_else(candidate(decls, expr), Some(SplitMatch(expr, t)))

        case _ =>
          candidate(decls, expr)
      end

    case EApp(fun, args) =>
      first_of(list(for a in list(fun; args) yield candidate(decls, a)))

    case ESum(_, terms) =>
      first_of(list(for p in terms yield candidate(decls, first(p))))

    case _ =>
      None
  end

function positive(c: Expr): Expr :=
  match c
    case EApp(EFun(Name(None, "not")), list(a)) =>
      positive(a)

    case _ =>
      c
  end

function datatype_of(decls: Decls, bs: List[Branch]): Option[Name] :=
  match bs
    case list() =>
      None

    case list(Branch(PApp(constr, _), _, _); rest) =>
      match get(constr, decls.ctors)
        case Some(ctor) =>
          Some(ctor.datatype)

        case None =>
          datatype_of(decls, rest)
      end

    case list(_; rest) =>
      datatype_of(decls, rest)
  end

// induction

function induction(decls: Decls, s: Seq, p: Int): Seq :=
  match normal(s)
    case Seq(fixed, assms, concls) if p < size(fixed) =>
      match at(p, fixed).typ
        case TSort(name, _) =>
          match get(name, decls.datatypes)
            case Some(cs) =>
              let k := size(fixed) in
              let as0 := list(for a in assms yield rebind_seq(Open(0, k), 0, a)), cs0 := list(for c in concls yield rebind_concl(Open(0, k), 0, c)) in
              Seq(list(), list(), list(Concl(list(), list(for c in cs yield induction_case(decls, name, fixed, p, as0, cs0, c)))))

            case None =>
              s
          end

        case _ =>
          s
      end

    case _ =>
      s
  end

// formulas as sequents, at the top only
function normal(s: Seq): Seq :=
  match s
    case Atom(expr) =>
      to_seq(expr)

    case _ =>
      s
  end

function induction_case(decls: Decls, t: Name, xs: List[Var], p: Int, as0: List[Seq], cs0: List[Concl], c: Name): Seq :=
  match get(c, decls.ctors)
    case Some(Ctor(_, fs)) =>
      let k := size(xs), n := size(fs) in
      let fields := list(for i in range(0, n) yield ELevel(k + i)) in
      let value := if n == 0 then EFun(c) else EApp(EFun(c), fields) in
      let v := ELevel(p), others := list(for l in range(0, k) if l != p) in
      let vars := list(for l in others yield at(l, xs)) in
      let ihs := list(for i in range(0, n) if is_recursive(t, at(i, fs)) yield hypothesis(vars, others, v, ELevel(k + i), as0, cs0)) in
      let levels := others ++ range(k, k + n) in
      Seq(vars ++ fs, list(for h in ihs ++ list(for a in as0 yield replace_seq(v, value, a)) yield rebind_seq(Close(levels), 0, h)),
          list(for d in cs0 yield rebind_concl(Close(levels), 0, replace_concl(v, value, d))))

    case None =>
      false_seq()
  end

function is_recursive(t: Name, field: Var): Bool :=
  match field.typ
    case TSort(name, _) =>
      name == t

    case _ =>
      false
  end

function hypothesis(vars: List[Var], others: List[Int], v: Expr, y: Expr, as0: List[Seq], cs0: List[Concl]): Seq :=
  Seq(vars, list(for a in as0 yield rebind_seq(Close(others), 0, replace_seq(v, y, a))),
      list(for d in cs0 yield rebind_concl(Close(others), 0, replace_concl(v, y, d))))

// printing, where the binders are opened with names distinct from those around them

function print_seq(s: Seq): Str :=
  print_open(list(), s)

function fresh(names: List[Id], x: Id): Id :=
  if contains(x, names) then fresh(names, x ++ "'") else x

function fresh_all(names: List[Id], xs: List[Var]): List[Id] :=
  match xs
    case list() =>
      list()

    case list(x; rest) =>
      let y := fresh(names, x.name) in
      list(y; fresh_all(names ++ list(y), rest))
  end

function print_open(names: List[Id], s: Seq): Str :=
  match s
    case Atom(expr) =>
      print_expr(names, expr)

    case Seq(list(), list(), list(Concl(list(), list()))) =>
      "true"

    case Seq(list(), list(), list()) =>
      "false"

    case Seq(list(), list(a), list()) =>
      "not " ++ print_part(names, a)

    case Seq(fixed, assms, concls) =>
      let ys := fresh_all(names, fixed), d := size(names), k := size(fixed) in
      let inner := names ++ ys in
      let binder := if fixed == list() then "" else "forall " ++ join(", ", ys) ++ " => " in
      let premises := join(" and ", list(for a in assms yield print_part(inner, rebind_seq(Open(d, k), 0, a)))) in
      let ends := if concls == list() then "false"
          else join(" or ", list(for c in concls yield print_concl(inner, size(concls) > 1, rebind_concl(Open(d, k), 0, c)))) in
      binder ++ (if assms == list() then ends else premises ++ " ==> " ++ ends)
  end

function print_part(names: List[Id], s: Seq): Str :=
  match s
    case Atom(_) =>
      print_open(names, s)

    case _ =>
      "(" ++ print_open(names, s) ++ ")"
  end

function print_concl(names: List[Id], several: Bool, c: Concl): Str :=
  match c
    case Concl(vars, body) =>
      let ys := fresh_all(names, vars), d := size(names), k := size(vars) in
      let inner := names ++ ys in
      let parts := list(for s in body yield rebind_seq(Open(d, k), 0, s)) in
      let text := if parts == list() then "true"
          else if size(parts) == 1 and vars == list() and not several then print_open(inner, at(0, parts))
          else join(" and ", list(for t in parts yield print_part(inner, t))) in
      if vars == list() then (if several and size(parts) > 1 then "(" ++ text ++ ")" else text)
      else "(exists " ++ join(", ", ys) ++ " => " ++ text ++ ")"
  end
