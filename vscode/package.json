{
  "name": "ulang",
  "displayName": "ulang",
  "description": "Syntax highlighting for ulang",
  "version": "0.1.0",
  "publisher": "ulang",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "ulang",
        "aliases": ["ulang"],
        "extensions": [".u"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ulang",
        "scopeName": "source.ulang",
        "path": "./syntaxes/ulang.tmLanguage.json"
      }
    ]
  }
}
