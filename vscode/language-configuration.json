{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(.*:=|run|try|catch|(else )?if\\b.*|while\\b.*|match\\b.*|case\\b.*=>|else)\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(end|else|case|catch)\\b"
  }
}
