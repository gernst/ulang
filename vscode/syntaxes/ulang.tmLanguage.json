{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ulang",
  "scopeName": "source.ulang",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#local"
    },
    {
      "include": "#notation"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#constructor"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.ulang",
      "match": "//.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.ulang",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.ulang",
          "match": "(')(?:([^'\\\\])|(\\\\[\"'\\\\ntr])|(\\\\.))(')",
          "captures": {
            "3": {
              "name": "constant.character.escape.ulang"
            },
            "4": {
              "name": "invalid.illegal.escape.ulang"
            }
          }
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "begin": "\\b(function|procedure)\\s+([A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&|:^~?@#$]+)",
          "end": ":=|$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ulang"
            },
            "2": {
              "name": "entity.name.function.ulang"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#type"
            },
            {
              "include": "#operator"
            }
          ],
          "endCaptures": {
            "0": {
              "name": "keyword.operator.ulang"
            }
          }
        },
        {
          "begin": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ulang"
            },
            "2": {
              "name": "entity.name.type.ulang"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#type"
            },
            {
              "include": "#operator"
            }
          ]
        },
        {
          "begin": "\\b(data)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ulang"
            },
            "2": {
              "name": "entity.name.type.ulang"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "match": "(:=|\\|)\\s*([A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&^~?@#$:]+)",
              "captures": {
                "1": {
                  "name": "keyword.operator.ulang"
                },
                "2": {
                  "name": "entity.name.function.constructor.ulang"
                }
              }
            },
            {
              "include": "#type"
            },
            {
              "include": "#operator"
            }
          ]
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.ulang"
            },
            "2": {
              "name": "entity.name.namespace.ulang"
            }
          }
        },
        {
          "match": "^(test|run)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.ulang"
            },
            "2": {
              "name": "entity.name.function.ulang"
            }
          }
        }
      ]
    },
    "notation": {
      "match": "\\b(infix|prefix|postfix)\\b(?:\\s+(left|right)\\b)?\\s+([0-9]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration.ulang"
        },
        "2": {
          "name": "keyword.declaration.ulang"
        },
        "3": {
          "name": "constant.numeric.ulang"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.ulang",
          "match": "\\b(if|then|else|while|match|case|end|let|in|lambda|for|call|assign|skip|assert|raise|try|catch|out|ref)\\b"
        },
        {
          "name": "keyword.other.ulang",
          "match": "\\b(eval|run|test)\\b"
        },
        {
          "name": "keyword.operator.word.ulang",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.ulang",
          "match": "\\b(true|false)\\b|\\(\\s*\\)"
        },
        {
          "name": "constant.numeric.ulang",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "variable.language.wildcard.ulang",
          "match": "\\b_\\b"
        }
      ]
    },
    "type": {
      "name": "entity.name.type.ulang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operator": {
      "name": "keyword.operator.ulang",
      "match": "[-+*/%<>=!&|:^~?@#$]+"
    },
    "local": {
      "begin": "\\b(local)\\b",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.ulang"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#type"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "constructor": {
      "name": "entity.name.function.constructor.ulang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.ulang",
          "match": "\\\\[\"'\\\\ntr]"
        },
        {
          "name": "invalid.illegal.escape.ulang",
          "match": "\\\\."
        }
      ]
    }
  }
}
