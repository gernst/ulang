{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ulang",
  "scopeName": "source.ulang",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#access"
    },
    {
      "include": "#update"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#local"
    },
    {
      "include": "#notation"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#constructor"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.ulang",
      "match": "//.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.ulang",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.ulang",
          "match": "(')(?:([^'\\\\])|(\\\\[\"'\\\\ntr])|(\\\\.))(')",
          "captures": {
            "3": {
              "name": "constant.character.escape.ulang"
            },
            "4": {
              "name": "invalid.illegal.escape.ulang"
            }
          }
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "begin": "\\b(function|procedure|pattern|lemma)\\s+([A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&|:^~?@#$]+)",
          "end": ":=|$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ulang"
            },
            "2": {
              "name": "entity.name.function.ulang"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#type"
            },
            {
              "include": "#operator"
            }
          ],
          "endCaptures": {
            "0": {
              "name": "keyword.operator.ulang"
            }
          }
        },
        {
          "begin": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ulang"
            },
            "2": {
              "name": "entity.name.type.ulang"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#type"
            },
            {
              "include": "#operator"
            }
          ]
        },
        {
          "begin": "\\b(data)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ulang"
            },
            "2": {
              "name": "entity.name.type.ulang"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!=)",
              "captures": {
                "1": {
                  "name": "variable.other.member.ulang"
                },
                "2": {
                  "name": "keyword.operator.ulang"
                }
              }
            },
            {
              "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&^~?@#$:]+)",
              "captures": {
                "1": {
                  "name": "keyword.control.ulang"
                },
                "2": {
                  "name": "entity.name.function.constructor.ulang"
                }
              }
            },
            {
              "include": "#type"
            },
            {
              "include": "#operator"
            }
          ]
        },
        {
          "match": "^(export|builtin|implementation)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.section.ulang"
            }
          }
        },
        {
          "match": "\\b(import)\\s+(\"[A-Za-z0-9_/]+\")",
          "captures": {
            "1": {
              "name": "keyword.control.import.ulang"
            },
            "2": {
              "name": "entity.name.namespace.ulang"
            }
          }
        },
        {
          "match": "^(test)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.ulang"
            },
            "2": {
              "name": "entity.name.function.ulang"
            }
          }
        }
      ]
    },
    "notation": {
      "match": "\\b(infix|prefix|postfix)\\b(?:\\s+(left|right)\\b)?\\s+([0-9]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration.ulang"
        },
        "2": {
          "name": "keyword.declaration.ulang"
        },
        "3": {
          "name": "constant.numeric.ulang"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.ulang",
          "match": "\\b(if|then|else|while|match|case|end|let|in|lambda|for|do|yield|call|assign|skip|assert|raises|raise|try|catch|out|ref|with)\\b"
        },
        {
          "name": "keyword.other.ulang",
          "match": "\\b(test|pattern|requires|ensures)\\b"
        },
        {
          "name": "keyword.other.ulang",
          "match": "\\b(List|Set|Map|Array)(?=\\s*\\()"
        },
        {
          "name": "keyword.control.ulang",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.ulang",
          "match": "\\b(true|false)\\b|\\(\\s*\\)"
        },
        {
          "name": "constant.numeric.ulang",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "variable.language.wildcard.ulang",
          "match": "\\b_\\b"
        }
      ]
    },
    "type": {
      "name": "entity.name.type.ulang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operator": {
      "name": "keyword.operator.ulang",
      "match": "[-+*/%<>=!&|:^~?@#$]+"
    },
    "local": {
      "begin": "\\b(local)\\b",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.ulang"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": ":=",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.ulang"
            }
          },
          "end": "(?=,\\s*[a-z_][A-Za-z0-9_]*\\s*:)|$",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#string"
            },
            {
              "include": "#access"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#constant"
            },
            {
              "include": "#constructor"
            },
            {
              "include": "#operator"
            }
          ]
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#type"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "constructor": {
      "name": "entity.name.function.constructor.ulang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.ulang",
          "match": "\\\\[\"'\\\\ntr]"
        },
        {
          "name": "invalid.illegal.escape.ulang",
          "match": "\\\\."
        }
      ]
    },
    "access": {
      "match": "(?<=[\\w)\\]])(\\.)([a-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "punctuation.accessor.ulang"
        },
        "2": {
          "name": "variable.other.member.ulang"
        }
      }
    },
    "update": {
      "comment": "e with f := a, g := b, where the fields until the end of the line are members",
      "begin": "\\b(with)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ulang"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#access"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:=)",
          "captures": {
            "1": {
              "name": "variable.other.member.ulang"
            },
            "2": {
              "name": "keyword.operator.ulang"
            }
          }
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#constructor"
        },
        {
          "include": "#operator"
        }
      ]
    }
  }
}
