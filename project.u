// the project ulang: the language, its compiler and interpreter, its library, its tests, and the prover, where the cases
// of ulang/test/errors/, the scripts of ulang/refactor/test/, and the loads of ulang/test/declared/ read the library
// each, which the interpreter does too slowly

function project(): Project :=
  Project(List("ulang/test/errors", "ulang/refactor/test", "ulang/test/declared"))
